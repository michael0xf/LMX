# A numeric field of a named Structure -- size_t, int, unsigned or ulong (l2_nsf_kind 0/7/8/9) --
# gets its own cell holding its literal, the same way for every width: an owned cell, or on an
# eternal branch a cell from the branch profile.  D-15 registered kinds 7/8/9 but built no cell, so
# the field's slot stayed empty and its literal was lost.  Any other kind emits nothing here.
fn: l2_emit_ns_num_cell (int: k; int: oi; int: fx) int
    const: @(char newf) 0
    const: @(char store) 0
    const: @(char ctype) 0
    const: @(char tcode) 0
    []: char lit 48
    lit[0]: '\0'
    if: l2_nsf_kind[fx] = 0
        newf: "lmx_size_new_owned"
        store: "lmx_size_store_known"
        ctype: "c.size_t"
        tcode: "c.LMX_TYPE_SIZE_T"
        if: c.sprintf(lit, "%zuU", l2_nsf_val[fx]) < 0
            return: 1
        ---
    if: l2_nsf_kind[fx] = 7
        newf: "lmx_int_new_owned"
        store: "lmx_int_store_known"
        ctype: "c.int"
        tcode: "c.LMX_TYPE_INT"
        if: c.sprintf(lit, "%d", (cast: (int) l2_nsf_val[fx])) < 0
            return: 1
        ---
    if: l2_nsf_kind[fx] = 8
        newf: "lmx_unsigned_new_owned"
        store: "lmx_unsigned_store_known"
        ctype: "c.unsigned"
        tcode: "c.LMX_TYPE_UNSIGNED"
        if: c.sprintf(lit, "%uU", (cast: (unsigned) l2_nsf_val[fx])) < 0
            return: 1
        ---
    if: l2_nsf_kind[fx] = 9
        newf: "lmx_ulong_new_owned"
        store: "lmx_ulong_store_known"
        # c.sizeof passes its operand to C as written: C has no `ulong`, and the two words
        # of `unsigned long` are two operands once P0 parses `c.sizeof(...)` as a Frame.
        # A ulong local (declared with the profile locals) names the size in one word.
        ctype: "l2_ulong_probe"
        tcode: "c.LMX_TYPE_ULONG"
        if: c.sprintf(lit, "%zuU", l2_nsf_val[fx]) < 0
            return: 1
        ---
    if: newf = 0
        return: 0
    if: l2_ns_eternal[k] < 0 && c.fprintf(l2_out, "        l2_entry_slot: lmx_arena_ref_cell(l2_nsp[%d], %uU)\n        if: l2_entry_slot = 0\n            return: 1\n        l2_entry_slot[0]: %s(l2_program_arena)\n        if: l2_entry_slot[0] = 0\n            return: 1\n        if: %s(l2_entry_slot[0], %s) != 0\n            return: 1\n", k, (cast: (unsigned) oi), newf, store, lit) < 0
        return: 1
    if: l2_ns_eternal[k] >= 0 && c.fprintf(l2_out, "        l2_entry_slot: lmx_arena_ref_cell(l2_nsp[%d], %uU)\n        if: l2_entry_slot = 0\n            return: 1\n        l2_entry_slot[0]: lmx_arena_take_profiled(l2_program_arena, c.sizeof(%s), c.LMX_KIND_PRIMITIVE, %s, l2_eprofile%u)\n        if: l2_entry_slot[0] = 0\n            return: 1\n        if: %s(l2_entry_slot[0], %s) != 0\n            return: 1\n", k, (cast: (unsigned) oi), ctype, tcode, (cast: (unsigned) l2_ns_eternal[k]), store, lit) < 0
        return: 1
return: 0

# Rank of a unit-level declaration among unit-level declarations: nested
# entries interleave in the table but are not unit children.
fn: l2_ns_rank (int: ni) int
    int: i 0
    int: r 0
    while: i < ni
        if: l2_ns_parent[i] < 0 && l2_ns_eternal[i] < 0 && l2_ns_local[i] < 0
            r: r + 1
        i: i + 1
    ---
return: r

fn: l2_ns_top_count () int
    int: i 0
    int: r 0
    while: i < l2_ns_n
        if: l2_ns_parent[i] < 0 && l2_ns_eternal[i] < 0 && l2_ns_local[i] < 0
            r: r + 1
        i: i + 1
    ---
return: r

# Field index of a nested entry inside its parent, found by the field that
# refers to it; -1 for a unit-level entry.
fn: l2_ns_field_in_parent (int: ni) int
    int: par
    int: k 0
    int: slotix 0
    par: l2_ns_parent[ni]
    if: par < 0
        return: 0 - 1
    # Fields of one Structure are not contiguous: a nested body pushes its own
    # fields in between. Walk the whole table and count only this owner.
    slotix: 0
    while: k < l2_nsf_n
        if: l2_nsf_owner[k] = par
            if: l2_nsf_kind[k] = 2 && l2_nsf_ref[k] = ni
                return: l2_nsf_slot(k)
            ---
            slotix: slotix + 1
        ---
        k: k + 1
    ---
return: 0 - 1


fn: l2_text_eq (const: @(LmP0Text text); const: @(char s)) int
    size_t: n
    if: text = 0 || s = 0
        return: 0
    n: strlen(s)
    if: text\data = 0
        return: n = 0U
return: text\length = n && memcmp(text\data, s, n) = 0

fn: l2_ignored (const: @(LmP0Node node)) int
    if: node = 0
        return: 1
    if: node\kind = c.LM_P0_NODE_DISABLED
        return: 1
    if: (node\flags & (c.LM_P0_NODE_INACTIVE | c.LM_P0_NODE_MIX)) != 0U
        return: 1
return: 0

# A diagnostic kept for later (the quiet record, l2_m_why): a copy of its whole length -- plain malloc,
# outside l2_xmalloc's counted allocations (a kept reason is not the translation's storage); 0 when there
# is no room, and the reason is then not said.
fn: l2_msg_copy (const: @(char s)) @: char
    @: char p
    size_t: n
    if: s = 0
        return: 0
    n: strlen(s)
    p: (cast: (@: char) malloc(n + 1U))
    if: p = 0
        return: 0
    memcpy((cast: (@: void) p), s, n + 1U)
return: p

fn: l2_msg_drop (@: char p) @: char
    if: p != 0
        free((cast: (@: void) p))
return: 0

fn: l2_msg_text (const: @(char p)) const: @: char
    if: p = 0
        return: ""
return: p

# Whether node x is n or stands in n's tree: a frame's body and trailer, a Structure's fields and trailer.
fn: l2_node_in (const: @(LmP0Node n); const: @(LmP0Node x)) int
    if: n = 0 || x = 0
        return: 0
    if: n = x
        return: 1
    if: n\as = 0
        return: 0
    if: n\kind = c.LM_P0_NODE_FRAME && n\as\frame != 0
        if: l2_struct_has(n\as\frame\body, x) != 0
            return: 1
        if: n\as\frame\trailer != 0
            return: l2_struct_has(n\as\frame\trailer\body, x)
        return: 0
    if: n\kind = c.LM_P0_NODE_STRUCTURE
        return: l2_struct_has(n\as\structure, x)
return: 0

fn: l2_struct_has (const: @(LmP0Structure s); const: @(LmP0Node x)) int
    @: LmP0Field f
    if: s = 0
        return: 0
    f: s\first_field
    while: f != 0
        if: l2_node_in(f\value, x) != 0
            return: 1
        f: f\next
    ---
    if: s\trailer != 0
        return: l2_struct_has(s\trailer\body, x)
return: 0

# Cached head topology belongs to its source statement, including heads parsed
# from another cached body. This compiler provenance does not alter the AST.
fn: l2_head_source_node (const: @(LmP0Node node)) const: @: LmP0Node
    @: L2HeadExpression expression
    int: found 1
    while: node != 0 && found != 0
        found: 0
        expression: l2_head_expressions
        while: expression != 0 && found = 0
            if: l2_node_in(lm_p0_document_root(expression\document), node) != 0
                node: expression\source
                found: 1
            expression: expression\allocated_next
        ---
    ---
return: node

fn: l2_error (const: @(char path); const: @(LmP0Node node); const: @(char msg)) int
    size_t: line 1U
    size_t: column 1U
    int: k 0
    const: @(LmP0Node owner) l2_head_source_node(node)
    # A method's body tried for the walk (l2_rw_quiet, -193 T4a) is refused silently: it only gets
    # no frames.  The first such refusal is kept for a note (l2_rw_methods_count).
    if: l2_rw_quiet != 0 && l2_rw_quiet_msg = 0
        l2_rw_quiet_msg: l2_msg_copy(msg)
        if: node != 0 && node\span != 0
            l2_rw_quiet_line: node\span\line
            l2_rw_quiet_col: node\span\column
        ---
    ---
    if: l2_rw_quiet != 0
        return: 1
    # A node read from a program part is said in that part (§10): the file of a diagnostic is the file its node
    # was read from, whichever pass says it -- one handed the source's path included.
    while: owner != 0 && l2_part_doc != 0 && k < l2_part_n
        if: l2_part_doc[k] != 0 && l2_node_in(lm_p0_document_root(l2_part_doc[k]), owner) != 0
            path: l2_part_path[k]
        k: k + 1
    ---
    if: node != 0 && node\span != 0
        line: node\span\line
        column: node\span\column
    if: path = 0
        path: ""
    c.fprintf(l1_stderr(), "l2trans error: %s:%zu:%zu: %s\n", path, line, column, msg)
    l2_diag_n: l2_diag_n + 1
    if: node != 0 && node\kind = c.LM_P0_NODE_ATOM && node\as != 0 && node\as\atom != 0
        c.fprintf(l1_stderr(), "l2trans detail: atom=%.*s\n", (cast: (int) node\as\atom\length), node\as\atom\data)
    if: node != 0 && node\kind = c.LM_P0_NODE_FRAME && node\as != 0 && node\as\frame != 0 && node\as\frame\head != 0
        c.fprintf(l1_stderr(), "l2trans detail: frame=%.*s\n", (cast: (int) node\as\frame\head\length), node\as\frame\head\data)
return: 1

fn: l2_alloc_or (const: @(char path); const: @(LmP0Node at); const: @(char fallback)) int
    if: l2_alloc_err = 2
        return: l2_error(path, at, "size overflow")
    if: l2_alloc_err != 0
        return: l2_error(path, at, "out of memory")
return: l2_error(path, at, fallback)

# A use of a conversion table, or of a converter source, that cannot be read: the file's own diagnostic,
# when its reading gave one (l2_cv_said), is the one line; else it is said here, where it was needed.
fn: l2_cv_refused (const: @(char path); const: @(LmP0Node at); const: @(char msg)) int
    if: l2_cv_said != 0
        return: 1
return: l2_error(path, at, msg)


# A refusal after a pass that may already have said why: nothing more when a diagnostic came since d0
# (l2_diag_n), else l2_alloc_or's words.
fn: l2_said_or (const: @(char path); const: @(LmP0Node at); int: d0; const: @(char fallback)) int
    if: l2_diag_n != d0
        return: 1
return: l2_alloc_or(path, at, fallback)

fn: l2_xmalloc (size_t: n) @: void
    @: void p
    if: n = 0U
        return: 0
    if: l2_fail_left > 0
        l2_fail_left: l2_fail_left - 1
        if: l2_fail_left = 0
            l2_alloc_err: 1
            l2_alloc_fail_at: l2_alloc_n + 1
            l2_alloc_fail_kind: l2_alloc_kind
            return: 0
        ---
    p: malloc(n)
    if: p = 0
        l2_alloc_err: 1
        l2_alloc_fail_at: l2_alloc_n + 1
        l2_alloc_fail_kind: l2_alloc_kind
        return: 0
    l2_alloc_n: l2_alloc_n + 1
    l2_alloc_live: l2_alloc_live + 1
return: p

fn: l2_xfree (@: void p) int
    if: p = 0
        return: 0
    free(p)
    l2_free_n: l2_free_n + 1
    if: l2_alloc_live > 0
        l2_alloc_live: l2_alloc_live - 1
return: 0

fn: l2_prep_drop (@: L2Tx acts; @: L2Tx hides) int
    if: acts != 0
        l2_xfree((cast: (@: void) acts))
    if: hides != 0
        l2_xfree((cast: (@: void) hides))
return: 1

# The text of actual i of a call (l2_emit_call's block: the records, then their slots).
fn: l2_act_tx (@: L2Tx base; int: i) @: L2Tx
    if: base = 0 || i < 0
        return: 0
return: base + i

fn: l2_release () int
    int: i 0
    unsigned: s 0U
    if: l2_msend_cap > 64
        l2_msend_free()
    l2_msend_at: 0
    l2_msend_owner: 0
    l2_msend_inputs: 0
    l2_msend_count: 0
    l2_msend_off: 0
    l2_msend_has_ref: 0
    l2_msend_cap: 0
    l2_msend_n: 0
    if: l2_msend_fcap > 1024
        l2_xfree((cast: (@: void) l2_msend_kind))
        l2_xfree((cast: (@: void) l2_msend_text))
    l2_msend_kind: 0
    l2_msend_text: 0
    l2_msend_fcap: 0
    l2_msend_nfield: 0
    if: l2_lp_cap > 64
        l2_xfree((cast: (@: void) l2_lpk))
        l2_xfree((cast: (@: void) l2_lpp))
    l2_lpk: 0
    l2_lpp: 0
    l2_lp_cap: 0
    l2_lp_n: 0
    if: l2_pad_cap > 64
        l2_xfree((cast: (@: void) l2_padb))
        l2_xfree((cast: (@: void) l2_padi))
    l2_padb: 0
    l2_padi: 0
    l2_pad_cap: 0
    l2_pad_n: 0
    if: l2_rw_pcap > 64
        l2_xfree((cast: (@: void) l2_rw_pcf))
        l2_xfree((cast: (@: void) l2_rw_pid))
    l2_rw_pcf: 0
    l2_rw_pid: 0
    l2_rw_pcap: 0
    l2_rw_pn: 0
    while: i < l2_tbx_n
        l2_xfree((cast: (@: void) l2_tbx_name[i]))
        l2_tbx_name[i]: 0
        i: i + 1
    l2_tbx_n: 0
    l2_tbc_n: 0
    l2_tb_n: 0
    if: l2_tbx_cap > 4096
        l2_xfree((cast: (@: void) l2_tbx_arg))
        l2_xfree((cast: (@: void) l2_tbx_name))
    l2_tbx_arg: 0
    l2_tbx_name: 0
    l2_tbx_cap: 0
    if: l2_tbc_cap > 128
        l2_xfree((cast: (@: void) l2_tbc_name))
    l2_tbc_name: 0
    l2_tbc_cap: 0
    if: l2_tb_cap > 8
        l2_tb_free()
    l2_tb_name: 0
    l2_tb_cols: 0
    l2_tb_call: 0
    l2_tb_path: 0
    l2_tb_name_at: 0
    l2_tb_col0: 0
    l2_tb_ncol: 0
    l2_tb_cell0: 0
    l2_tb_nrow: 0
    l2_tb_cap: 0
    lm_p0_document_destroy(l2_tb_sig)
    l2_tb_sig: 0
    i: 0
    free((cast: (@: void) l2_m_walkable))
    l2_m_walkable: 0
    while: i < l2_m_cap
        l2_free_method(i)
        i: i + 1
    l2_meth_free()
    while: s < l2_intern_n
        if: l2_it_n[s] != 0
            l2_xfree((cast: (@: void) l2_it_n[s]))
        if: l2_it_nl[s] != 0
            l2_xfree((cast: (@: void) l2_it_nl[s]))
        if: l2_it_ty[s] != 0
            l2_xfree((cast: (@: void) l2_it_ty[s]))
        if: l2_it_hn[s] != 0
            l2_xfree((cast: (@: void) l2_it_hn[s]))
        if: l2_it_hnl[s] != 0
            l2_xfree((cast: (@: void) l2_it_hnl[s]))
        if: l2_it_hty[s] != 0
            l2_xfree((cast: (@: void) l2_it_hty[s]))
        l2_it_n[s]: 0
        l2_it_nl[s]: 0
        l2_it_ty[s]: 0
        l2_it_hn[s]: 0
        l2_it_hnl[s]: 0
        l2_it_hty[s]: 0
        s: s + 1U
    if: l2_it_ar != 0
        l2_xfree((cast: (@: void) l2_it_ar))
    if: l2_it_dyn != 0
        l2_xfree((cast: (@: void) l2_it_dyn))
    if: l2_it_ret != 0
        l2_xfree((cast: (@: void) l2_it_ret))
    if: l2_it_throws != 0
        l2_xfree((cast: (@: void) l2_it_throws))
    if: l2_it_tmi != 0
        l2_xfree((cast: (@: void) l2_it_tmi))
    if: l2_it_n != 0
        l2_xfree((cast: (@: void) l2_it_n))
    if: l2_it_nl != 0
        l2_xfree((cast: (@: void) l2_it_nl))
    if: l2_it_ty != 0
        l2_xfree((cast: (@: void) l2_it_ty))
    if: l2_it_hn != 0
        l2_xfree((cast: (@: void) l2_it_hn))
    if: l2_it_hnl != 0
        l2_xfree((cast: (@: void) l2_it_hnl))
    if: l2_it_hty != 0
        l2_xfree((cast: (@: void) l2_it_hty))
    if: l2_m_throws != 0
        l2_xfree((cast: (@: void) l2_m_throws))
    if: l2_pap_model != 0
        l2_xfree((cast: (@: void) l2_pap_model))
    l2_pap_model: 0
    if: l2_mad_model != 0
        l2_xfree((cast: (@: void) l2_mad_model))
    if: l2_mad_host != 0
        l2_xfree((cast: (@: void) l2_mad_host))
    l2_mad_model: 0
    l2_mad_host: 0
    l2_mad_cap: 0
    l2_mad_need_call: 0
    if: l2_mcap_model != 0
        l2_xfree((cast: (@: void) l2_mcap_model))
    if: l2_mcap_name != 0
        i: 0
        while: i < l2_mcap_n
            l2_xfree((cast: (@: void) l2_mcap_name[i]))
            i: i + 1
        ---
        l2_xfree((cast: (@: void) l2_mcap_name))
    if: l2_mcap_ty != 0
        l2_xfree((cast: (@: void) l2_mcap_ty))
    l2_mcap_model: 0
    l2_mcap_name: 0
    l2_mcap_ty: 0
    l2_mcap_n: 0
    l2_mcap_room: 0
    l2_t7_n: 0
    l2_t7_walk: 0
    l2_t7b_n: 0
    l2_t7h_n: 0
    l2_it_ar: 0
    l2_it_dyn: 0
    l2_it_ret: 0
    l2_it_throws: 0
    l2_it_tmi: 0
    l2_it_n: 0
    l2_it_nl: 0
    l2_it_ty: 0
    l2_it_hn: 0
    l2_it_hnl: 0
    l2_it_hty: 0
    l2_m_throws: 0
    l2_intern_n: 0U
    l2_intern_cap: 0U
    l2_own_free()
    l2_application_free()
    l2_scope_free()
    l2_wait_free()
    l2_indent_free()
    l2_pub_free()
    l2_for_free()
    l2_pd_free()
    l2_def_free()
    l2_cnt_free()
    l2_inc_free()
    l2_foreign_free()
    l2_xfree((cast: (@: void) l2_lmx_name_cache))
    l2_xfree((cast: (@: void) l2_sender_name_cache))
    l2_xfree((cast: (@: void) l2_payload_name_cache))
    l2_lmx_name_cache: 0
    l2_sender_name_cache: 0
    l2_payload_name_cache: 0
    l2_xfree((cast: (@: void) l2_cf_omi))
    l2_xfree((cast: (@: void) l2_cf_fk))
    l2_xfree((cast: (@: void) l2_cf_req))
    l2_cf_omi: 0
    l2_cf_fk: 0
    l2_cf_req: 0
    l2_cf_n: 0
    l2_cf_cap: 0
    i: 0
    while: i < l2_ltx_n
        l2_xfree((cast: (@: void) l2_ltx[i]))
        i: i + 1
    ---
    l2_xfree((cast: (@: void) l2_ltx))
    l2_ltx: 0
    l2_ltx_n: 0
    l2_ltx_cap: 0
    l2_xfree((cast: (@: void) l2_hr_at))
    l2_xfree((cast: (@: void) l2_hr_mi))
    l2_xfree((cast: (@: void) l2_hr_val))
    l2_hr_at: 0
    l2_hr_mi: 0
    l2_hr_val: 0
    l2_hr_n: 0
    l2_hr_cap: 0
    l2_xfree((cast: (@: void) l2_rb_at))
    l2_xfree((cast: (@: void) l2_rb_model))
    l2_xfree((cast: (@: void) l2_rb_meth))
    l2_xfree((cast: (@: void) l2_rb_own))
    l2_rb_at: 0
    l2_rb_model: 0
    l2_rb_meth: 0
    l2_rb_own: 0
    l2_rb_n: 0
    l2_rb_cap: 0
    l2_xfree((cast: (@: void) l2_urm_at))
    l2_xfree((cast: (@: void) l2_urm_val))
    l2_urm_at: 0
    l2_urm_val: 0
    l2_urm_n: 0
    l2_urm_cap: 0
    l2_flow_free()
    l2_e_free()
return: 0

fn: l2_e_free () int
    if: l2_e_fields != 0
        l2_xfree((cast: (@: void) l2_e_fields))
    if: l2_e_struct != 0
        l2_xfree((cast: (@: void) l2_e_struct))
    if: l2_e_as != 0
        l2_xfree((cast: (@: void) l2_e_as))
    if: l2_e_node != 0
        l2_xfree((cast: (@: void) l2_e_node))
    l2_e_fields: 0
    l2_e_struct: 0
    l2_e_as: 0
    l2_e_node: 0
    l2_e: 0 - 1
    l2_e_n: 0
    l2_vis_on: 0
return: 0

# Is source offset `at` visible from the code being read? A node without a span
# is the translator's own and always visible.
fn: l2_vis_ok (const: @(LmP0Node at)) int
    if: l2_vis_on = 0 || at = 0 || at\span = 0
        return: 1
    # A method of a program part reads another unit (§8): places of two files do not compare, and nothing the
    # source declares is visible from it by its place.
    if: l2_vis_on = 2
        return: 0
return: at\span\offset <= l2_vis_at

# Read everything below as seen from the source position of `at`.
fn: l2_vis_from (const: @(LmP0Node at)) int
    l2_vis_on: 0
    if: at != 0 && at\span != 0
        l2_vis_on: 1
        l2_vis_at: at\span\offset
    ---
return: 0

# A method reads the unit from its header: what is declared above the method is
# visible in its whole body. E reads the unit statement by statement.
fn: l2_vis_method (int: mi) int
    int: ns
    l2_here_at_method(mi, 0)
    l2_here_source_mi: mi
    l2_vis_on: 0
    if: mi >= 0 && mi != l2_e && mi < l2_m_n && l2_m_node[mi] != 0
        l2_vis_from(l2_m_node[mi])
    ---
    # A named Structure's code reads the unit from the Structure's declaration, as a method's from its header: an
    # ordinary declaration is visible forward and down from where it stands, a later one is not (docs
    # #declaration-visibility) -- a name the code reads that only a later declaration spells is a free name.
    if: mi >= 0 && mi != l2_e && mi < l2_m_n && l2_m_node[mi] = 0
        ns: l2_m_nsof(mi)
        if: ns >= 0 && l2_ns_at[ns] != 0
            l2_vis_from(l2_ns_at[ns])
        ---
    ---
    # Code of a program part -- a method a part gave (§8), its root's procedure (§10): nothing of the source is
    # visible from it by its place (l2_vis_ok).
    if: l2_m_code_file(mi) >= 0
        l2_vis_on: 2
return: 0

fn: l2_vis_stmt (int: mi; const: @(LmP0Node stmt)) int
    l2_here_at_method(mi, stmt)
    if: mi >= 0 && mi = l2_e
        l2_vis_from(stmt)
    ---
return: 0

# Is own row oi a unit field as seen from method mi -- reached through the unit,
# not through mi's own occurrence -- and visible from where mi is being read?
# E's top-level own fields are the unit fields; inside E they are E's own.  For a
# method of a program part, its unit's fields are its part's root's (§10),
# reached through its node.
fn: l2_own_unit_seen (int: oi; int: mi) int
    int: k
    @: LmP0Node source
    if: oi < 0 || oi >= l2_own_n || l2_own_host[oi] != 0
        return: 0
    if: l2_own_mi[oi] = mi
        return: 0
    # §10: a method of a program part sees its part's root's fields -- own fields of that root's procedure, in
    # the root's slots -- declared above it in the part, as a method of the source sees the unit's fields.
    k: l2_m_code_file(mi)
    if: k >= 0 && l2_part_ns[k] >= 0 && l2_ns_proc[l2_part_ns[k]] >= 0 && l2_own_mi[oi] = l2_ns_proc[l2_part_ns[k]]
        source: l2_callable_source_node(mi)
        if: l2_own_decl[oi] = 0 || l2_own_decl[oi]\span = 0 || source = 0 || source\span = 0
            return: 1
        return: (cast: (int) (l2_own_decl[oi]\span\offset <= source\span\offset))
    if: l2_e < 0 || l2_own_mi[oi] != l2_e || mi = l2_e
        return: 0
    # Code of a program part -- a method a part gave, its root's procedure -- is another unit's (§8, §10): the
    # source's fields are not in its scope -- a name it reads that it does not declare is a free name, bound
    # by its callers or unresolved.
    if: k >= 0
        return: 0
return: l2_vis_ok(l2_own_decl[oi])

# Unit children that hold callable occurrences: one per method except E, whose
# occurrence is the unit itself.
fn: l2_occ_n () int
    if: l2_e >= 0
        return: l2_e
return: l2_m_n

fn: l2_mul_ok (size_t: n; size_t: sz) int
    if: sz = 0U
        return: 1
    if: n > ((cast: (size_t) -1) / sz)
        return: 0
return: 1

fn: l2_mul3_ok (size_t: a; size_t: b; size_t: c) int
    size_t: p
    if: l2_mul_ok(a, b) = 0
        return: 0
    p: a * b
    if: l2_mul_ok(p, c) = 0
        return: 0
return: 1

fn: l2_own_off (int: mi; int: oi) size_t
    size_t: base
    size_t: cap
    size_t: idx
    if: mi < 0 || oi < 0 || l2_own_cap <= 0 || l2_m_cap <= 0 || mi >= l2_m_cap || oi >= l2_own_cap
        return: (cast: (size_t) -1)
    cap: (cast: (size_t) l2_own_cap)
    if: l2_mul_ok((cast: (size_t) mi), cap) = 0
        return: (cast: (size_t) -1)
    base: (cast: (size_t) mi) * cap
    idx: (cast: (size_t) oi)
    if: base + idx < base
        return: (cast: (size_t) -1)
return: base + idx

fn: l2_own_free () int
    if: l2_own_name != 0
        l2_xfree((cast: (@: void) l2_own_name))
    if: l2_own_ty != 0
        l2_xfree((cast: (@: void) l2_own_ty))
    if: l2_own_bseq != 0
        l2_xfree((cast: (@: void) l2_own_bseq))
    if: l2_own_mi != 0
        l2_xfree((cast: (@: void) l2_own_mi))
    if: l2_own_host != 0
        l2_xfree((cast: (@: void) l2_own_host))
    if: l2_own_decl != 0
        l2_xfree((cast: (@: void) l2_own_decl))
    if: l2_own_fid != 0
        l2_xfree((cast: (@: void) l2_own_fid))
    if: l2_own_fchild != 0
        l2_xfree((cast: (@: void) l2_own_fchild))
    if: l2_own_uchild != 0
        l2_xfree((cast: (@: void) l2_own_uchild))
    if: l2_m_uses != 0
        l2_xfree((cast: (@: void) l2_m_uses))
    if: l2_m_alias != 0
        l2_xfree((cast: (@: void) l2_m_alias))
    if: l2_m_pre != 0
        l2_xfree((cast: (@: void) l2_m_pre))
    if: l2_own_count != 0
        l2_xfree((cast: (@: void) l2_own_count))
    l2_own_count: 0
    l2_own_name: 0
    l2_own_ty: 0
    l2_own_bseq: 0
    l2_own_mi: 0
    l2_own_host: 0
    l2_own_decl: 0
    l2_own_fid: 0
    l2_own_fchild: 0
    l2_own_uchild: 0
    l2_m_uses: 0
    l2_m_alias: 0
    l2_m_pre: 0
    l2_own_n: 0
    l2_own_cap: 0
return: 0

fn: l2_own_reserve (int: need) int
    size_t: cap
    size_t: need_u
    size_t: rows
    size_t: psz
    size_t: nb
    size_t: ni
    size_t: nmeta
    size_t: oldcap
    size_t: off
    size_t: noff
    int: mi
    int: oi
    @@: LmP0Text nn 0
    @@: LmP0Text nc 0
    @: int nt 0
    @: int nl 0
    @: int nmi 0
    @@: LmP0Node nh 0
    @@: LmP0Node nd 0
    @: int nfid 0
    @: int nfch 0
    @: int nuch 0
    @: int nu 0
    @: int na 0
    @: int np 0
    if: need < 0
        return: 1
    if: need <= l2_own_cap
        return: 0
    if: need > c.INT_MAX
        l2_alloc_err: 2
        return: 1
    need_u: (cast: (size_t) need)
    cap: (cast: (size_t) l2_own_cap)
    if: cap < 1U
        cap: 4U
    while: cap < need_u
        if: cap > ((cast: (size_t) -1) / 2U)
            l2_alloc_err: 2
            return: 1
        cap: cap * 2U
    if: cap > (cast: (size_t) c.INT_MAX) && need_u > (cast: (size_t) c.INT_MAX)
        l2_alloc_err: 2
        return: 1
    if: cap > (cast: (size_t) c.INT_MAX)
        cap: need_u
    rows: 1U
    if: l2_m_cap > 0
        rows: (cast: (size_t) l2_m_cap)
    if: l2_mul_ok(rows, cap) = 0
        l2_alloc_err: 2
        return: 1
    nmeta: rows * cap
    psz: c.sizeof(@: char)
    if: l2_mul_ok(cap, psz) = 0
        l2_alloc_err: 2
        return: 1
    if: l2_mul_ok(cap, c.sizeof(c.int)) = 0
        l2_alloc_err: 2
        return: 1
    if: l2_mul_ok(nmeta, c.sizeof(c.int)) = 0
        l2_alloc_err: 2
        return: 1
    nb: cap * psz
    ni: cap * c.sizeof(c.int)
    l2_alloc_kind: 5
    nn: (cast: (@@: LmP0Text) l2_xmalloc(nb))
    nc: (cast: (@@: LmP0Text) l2_xmalloc(nb))
    nt: (cast: (@: int) l2_xmalloc(ni))
    nl: (cast: (@: int) l2_xmalloc(ni))
    nmi: (cast: (@: int) l2_xmalloc(ni))
    nh: (cast: (@@: LmP0Node) l2_xmalloc(nb))
    nd: (cast: (@@: LmP0Node) l2_xmalloc(nb))
    nfid: (cast: (@: int) l2_xmalloc(ni))
    nfch: (cast: (@: int) l2_xmalloc(ni))
    nuch: (cast: (@: int) l2_xmalloc(ni))
    nu: (cast: (@: int) l2_xmalloc(nmeta * c.sizeof(c.int)))
    na: (cast: (@: int) l2_xmalloc(nmeta * c.sizeof(c.int)))
    np: (cast: (@: int) l2_xmalloc(nmeta * c.sizeof(c.int)))
    if: nn = 0 || nc = 0 || nt = 0 || nl = 0 || nmi = 0 || nh = 0 || nd = 0 || nfid = 0 || nfch = 0 || nuch = 0 || nu = 0 || na = 0 || np = 0
        if: nc != 0
            l2_xfree((cast: (@: void) nc))
        if: nn != 0
            l2_xfree((cast: (@: void) nn))
        if: nt != 0
            l2_xfree((cast: (@: void) nt))
        if: nl != 0
            l2_xfree((cast: (@: void) nl))
        if: nmi != 0
            l2_xfree((cast: (@: void) nmi))
        if: nh != 0
            l2_xfree((cast: (@: void) nh))
        if: nd != 0
            l2_xfree((cast: (@: void) nd))
        if: nfid != 0
            l2_xfree((cast: (@: void) nfid))
        if: nfch != 0
            l2_xfree((cast: (@: void) nfch))
        if: nuch != 0
            l2_xfree((cast: (@: void) nuch))
        if: nu != 0
            l2_xfree((cast: (@: void) nu))
        if: na != 0
            l2_xfree((cast: (@: void) na))
        if: np != 0
            l2_xfree((cast: (@: void) np))
        return: 1
    memset((cast: (@: void) nn), 0, nb)
    memset((cast: (@: void) nc), 0, nb)
    memset((cast: (@: void) nt), 0, ni)
    memset((cast: (@: void) nl), 0, ni)
    memset((cast: (@: void) nh), 0, nb)
    memset((cast: (@: void) nd), 0, nb)
    oi: 0
    while: oi < (cast: (int) cap)
        nmi[oi]: -1
        nfid[oi]: -1
        nfch[oi]: -1
        nuch[oi]: -1
        oi: oi + 1
    memset((cast: (@: void) nu), 0, nmeta * c.sizeof(c.int))
    memset((cast: (@: void) np), 0, nmeta * c.sizeof(c.int))
    mi: 0
    while: mi < (cast: (int) rows)
        oi: 0
        while: oi < (cast: (int) cap)
            off: (cast: (size_t) mi) * cap
            off: off + (cast: (size_t) oi)
            na[off]: -1
            oi: oi + 1
        mi: mi + 1
    oldcap: (cast: (size_t) l2_own_cap)
    if: oldcap != 0U && l2_own_name != 0
        oi: 0
        while: oi < l2_own_n
            nn[oi]: l2_own_name[oi]
            nc[oi]: l2_own_count[oi]
            nt[oi]: l2_own_ty[oi]
            nl[oi]: l2_own_bseq[oi]
            nmi[oi]: l2_own_mi[oi]
            nh[oi]: l2_own_host[oi]
            nd[oi]: l2_own_decl[oi]
            nfid[oi]: l2_own_fid[oi]
            nfch[oi]: l2_own_fchild[oi]
            nuch[oi]: l2_own_uchild[oi]
            oi: oi + 1
        mi: 0
        while: mi < l2_m_cap
            oi: 0
            while: oi < l2_own_n
                off: (cast: (size_t) mi) * oldcap
                off: off + (cast: (size_t) oi)
                noff: (cast: (size_t) mi) * cap
                noff: noff + (cast: (size_t) oi)
                nu[noff]: l2_m_uses[off]
                na[noff]: l2_m_alias[off]
                np[noff]: l2_m_pre[off]
                oi: oi + 1
            mi: mi + 1
        l2_xfree((cast: (@: void) l2_own_name))
        l2_xfree((cast: (@: void) l2_own_count))
        l2_xfree((cast: (@: void) l2_own_ty))
        l2_xfree((cast: (@: void) l2_own_bseq))
        l2_xfree((cast: (@: void) l2_own_mi))
        l2_xfree((cast: (@: void) l2_own_host))
        l2_xfree((cast: (@: void) l2_own_decl))
        l2_xfree((cast: (@: void) l2_own_fid))
        l2_xfree((cast: (@: void) l2_own_fchild))
        l2_xfree((cast: (@: void) l2_own_uchild))
        l2_xfree((cast: (@: void) l2_m_uses))
        l2_xfree((cast: (@: void) l2_m_alias))
        l2_xfree((cast: (@: void) l2_m_pre))
    l2_own_name: nn
    l2_own_count: nc
    l2_own_ty: nt
    l2_own_bseq: nl
    l2_own_mi: nmi
    l2_own_host: nh
    l2_own_decl: nd
    l2_own_fid: nfid
    l2_own_fchild: nfch
    l2_own_uchild: nuch
    l2_m_uses: nu
    l2_m_alias: na
    l2_m_pre: np
    l2_own_cap: (cast: (int) cap)
return: 0

fn: l2_edge_off (int: a; int: b) size_t
    size_t: cap
    size_t: base
    if: a < 0 || b < 0 || l2_m_cap <= 0 || a >= l2_m_cap || b >= l2_m_cap
        return: (cast: (size_t) -1)
    cap: (cast: (size_t) l2_m_cap)
    if: l2_mul_ok((cast: (size_t) a), cap) = 0
        return: (cast: (size_t) -1)
    base: (cast: (size_t) a) * cap
    if: base + (cast: (size_t) b) < base
        return: (cast: (size_t) -1)
return: base + (cast: (size_t) b)

fn: l2_slot_off (int: mi; int: si) size_t
    size_t: base
    if: mi < 0 || si < 0 || si >= l2_slot_cap || l2_m_cap <= 0 || mi >= l2_m_cap
        return: (cast: (size_t) -1)
    if: l2_mul_ok((cast: (size_t) mi), (cast: (size_t) l2_slot_cap)) = 0
        return: (cast: (size_t) -1)
    base: (cast: (size_t) mi) * (cast: (size_t) l2_slot_cap)
    if: base + (cast: (size_t) si) < base
        return: (cast: (size_t) -1)
return: base + (cast: (size_t) si)

# Grow the per-method address-slot matrix transactionally. Four is only the
# first allocation size; source semantics have no slot-count limit.
fn: l2_slot_reserve (int: need) int
    size_t: cap
    size_t: oldcap
    size_t: rows
    size_t: count
    size_t: psz
    size_t: off
    size_t: noff
    @@: LmP0Text names 0
    @: int types 0
    int: i
    int: j
    if: need < 0 || l2_m_cap <= 0
        return: 1
    if: need <= l2_slot_cap
        return: 0
    cap: (cast: (size_t) l2_slot_cap)
    if: cap < 1U
        cap: 4U
    while: cap < (cast: (size_t) need)
        if: cap > ((cast: (size_t) -1) / 2U)
            l2_alloc_err: 2
            return: 1
        cap: cap * 2U
    if: cap > (cast: (size_t) c.INT_MAX)
        cap: (cast: (size_t) need)
    rows: (cast: (size_t) l2_m_cap)
    if: l2_mul_ok(rows, cap) = 0
        l2_alloc_err: 2
        return: 1
    count: rows * cap
    psz: c.sizeof(@: char)
    if: l2_mul_ok(count, psz) = 0 || l2_mul_ok(count, c.sizeof(c.int)) = 0
        l2_alloc_err: 2
        return: 1
    l2_alloc_kind: 6
    names: (cast: (@@: LmP0Text) l2_xmalloc(count * psz))
    types: (cast: (@: int) l2_xmalloc(count * c.sizeof(c.int)))
    if: names = 0 || types = 0
        if: names != 0
            l2_xfree((cast: (@: void) names))
        if: types != 0
            l2_xfree((cast: (@: void) types))
        return: 1
    memset((cast: (@: void) names), 0, count * psz)
    memset((cast: (@: void) types), 0, count * c.sizeof(c.int))
    oldcap: (cast: (size_t) l2_slot_cap)
    i: 0
    # A method being collected occupies row l2_m_n until collection finishes,
    # so copy every allocated row rather than only committed methods.
    while: i < l2_m_cap
        j: 0
        while: j < l2_m_sn[i]
            off: (cast: (size_t) i) * oldcap + (cast: (size_t) j)
            noff: (cast: (size_t) i) * cap + (cast: (size_t) j)
            names[noff]: l2_sn[off]
            types[noff]: l2_st[off]
            j: j + 1
        i: i + 1
    if: l2_sn != 0
        l2_xfree((cast: (@: void) l2_sn))
    if: l2_st != 0
        l2_xfree((cast: (@: void) l2_st))
    l2_sn: names
    l2_st: types
    l2_slot_cap: (cast: (int) cap)
return: 0

fn: l2_meth_free () int
    if: l2_m_name != 0
        l2_xfree((cast: (@: void) l2_m_name))
    if: l2_m_f0 != 0
        l2_xfree((cast: (@: void) l2_m_f0))
    if: l2_m_f1 != 0
        l2_xfree((cast: (@: void) l2_m_f1))
    if: l2_m_node != 0
        l2_xfree((cast: (@: void) l2_m_node))
    if: l2_m_body != 0
        l2_xfree((cast: (@: void) l2_m_body))
    if: l2_m_sig != 0
        l2_xfree((cast: (@: void) l2_m_sig))
    if: l2_m_arity != 0
        l2_xfree((cast: (@: void) l2_m_arity))
    if: l2_m_dyn != 0
        l2_xfree((cast: (@: void) l2_m_dyn))
    if: l2_m_ret != 0
        l2_xfree((cast: (@: void) l2_m_ret))
    if: l2_m_value_used != 0
        l2_xfree((cast: (@: void) l2_m_value_used))
    if: l2_m_own != 0
        l2_xfree((cast: (@: void) l2_m_own))
    if: l2_m_sn != 0
        l2_xfree((cast: (@: void) l2_m_sn))
    if: l2_m_hcap != 0
        l2_xfree((cast: (@: void) l2_m_hcap))
    if: l2_m_fcap != 0
        l2_xfree((cast: (@: void) l2_m_fcap))
    if: l2_m_dn != 0
        l2_xfree((cast: (@: void) l2_m_dn))
    if: l2_m_dt != 0
        l2_xfree((cast: (@: void) l2_m_dt))
    if: l2_m_fn != 0
        l2_xfree((cast: (@: void) l2_m_fn))
    if: l2_m_ft != 0
        l2_xfree((cast: (@: void) l2_m_ft))
    if: l2_m_edge != 0
        l2_xfree((cast: (@: void) l2_m_edge))
    if: l2_sn != 0
        l2_xfree((cast: (@: void) l2_sn))
    if: l2_st != 0
        l2_xfree((cast: (@: void) l2_st))
    l2_m_name: 0
    l2_m_f0: 0
    l2_m_f1: 0
    l2_m_node: 0
    l2_m_body: 0
    l2_m_sig: 0
    l2_m_arity: 0
    l2_m_dyn: 0
    l2_m_ret: 0
    l2_m_value_used: 0
    l2_m_own: 0
    l2_m_sn: 0
    l2_m_hcap: 0
    l2_m_fcap: 0
    l2_m_dn: 0
    l2_m_dt: 0
    l2_m_fn: 0
    l2_m_ft: 0
    l2_m_edge: 0
    l2_sn: 0
    l2_st: 0
    l2_slot_cap: 0
    l2_m_n: 0
    l2_m_cap: 0
return: 0

fn: l2_meth_reserve (int: need) int
    size_t: cap
    size_t: need_u
    size_t: psz
    size_t: nb
    size_t: ni
    size_t: nu
    size_t: nedge_n
    size_t: nslot
    size_t: oldcap
    size_t: slotcap
    size_t: off
    size_t: noff
    size_t: oc
    int: i
    int: j
    @@: LmP0Text nname 0
    @@: LmP0Text nf0 0
    @@: LmP0Text nf1 0
    @@: LmP0Node nnode 0
    @@: LmP0Node nbody 0
    @: unsigned nsig 0
    @: int narity 0
    @: int ndyn 0
    @: int nret 0
    @: int nown 0
    @: int nsn 0
    @: int nhcap 0
    @: int nfcap 0
    @@: void ndn 0
    @@: int ndt 0
    @@: void nfn 0
    @@: int nft 0
    @: int nedge 0
    @@: LmP0Text nslots 0
    @: int nst 0
    @: int nuses 0
    @: int nalias 0
    @: int npre 0
    if: need < 0
        return: 1
    if: need <= l2_m_cap
        return: 0
    if: need > c.INT_MAX
        l2_alloc_err: 2
        return: 1
    need_u: (cast: (size_t) need)
    cap: (cast: (size_t) l2_m_cap)
    if: cap < 1U
        cap: 4U
    while: cap < need_u
        if: cap > ((cast: (size_t) -1) / 2U)
            l2_alloc_err: 2
            return: 1
        cap: cap * 2U
    if: cap > (cast: (size_t) c.INT_MAX) && need_u > (cast: (size_t) c.INT_MAX)
        l2_alloc_err: 2
        return: 1
    if: cap > (cast: (size_t) c.INT_MAX)
        cap: need_u
    psz: c.sizeof(@: char)
    if: l2_mul_ok(cap, psz) = 0
        l2_alloc_err: 2
        return: 1
    if: l2_mul_ok(cap, c.sizeof(c.int)) = 0
        l2_alloc_err: 2
        return: 1
    if: l2_mul_ok(cap, c.sizeof(c.unsigned)) = 0
        l2_alloc_err: 2
        return: 1
    if: l2_mul_ok(cap, cap) = 0
        l2_alloc_err: 2
        return: 1
    nedge_n: cap * cap
    if: l2_mul_ok(nedge_n, c.sizeof(c.int)) = 0
        l2_alloc_err: 2
        return: 1
    slotcap: (cast: (size_t) l2_slot_cap)
    if: slotcap < 1U
        slotcap: 4U
    if: l2_mul_ok(cap, slotcap) = 0
        l2_alloc_err: 2
        return: 1
    nslot: cap * slotcap
    if: l2_mul_ok(nslot, psz) = 0
        l2_alloc_err: 2
        return: 1
    if: l2_mul_ok(nslot, c.sizeof(c.int)) = 0
        l2_alloc_err: 2
        return: 1
    nb: cap * psz
    ni: cap * c.sizeof(c.int)
    nu: cap * c.sizeof(c.unsigned)
    l2_alloc_kind: 6
    nname: (cast: (@@: LmP0Text) l2_xmalloc(nb))
    nf0: (cast: (@@: LmP0Text) l2_xmalloc(nb))
    nf1: (cast: (@@: LmP0Text) l2_xmalloc(nb))
    nnode: (cast: (@@: LmP0Node) l2_xmalloc(nb))
    nbody: (cast: (@@: LmP0Node) l2_xmalloc(nb))
    nsig: (cast: (@: unsigned) l2_xmalloc(nu))
    narity: (cast: (@: int) l2_xmalloc(ni))
    ndyn: (cast: (@: int) l2_xmalloc(ni))
    nret: (cast: (@: int) l2_xmalloc(ni))
    nown: (cast: (@: int) l2_xmalloc(ni))
    nsn: (cast: (@: int) l2_xmalloc(ni))
    nhcap: (cast: (@: int) l2_xmalloc(ni))
    nfcap: (cast: (@: int) l2_xmalloc(ni))
    ndn: (cast: (@@: void) l2_xmalloc(nb))
    ndt: (cast: (@@: int) l2_xmalloc(nb))
    nfn: (cast: (@@: void) l2_xmalloc(nb))
    nft: (cast: (@@: int) l2_xmalloc(nb))
    nedge: (cast: (@: int) l2_xmalloc(nedge_n * c.sizeof(c.int)))
    nslots: (cast: (@@: LmP0Text) l2_xmalloc(nslot * psz))
    nst: (cast: (@: int) l2_xmalloc(nslot * c.sizeof(c.int)))
    if: nname = 0 || nf0 = 0 || nf1 = 0 || nnode = 0 || nbody = 0 || nsig = 0 || narity = 0 || ndyn = 0 || nret = 0 || nown = 0 || nsn = 0 || nhcap = 0 || nfcap = 0 || ndn = 0 || ndt = 0 || nfn = 0 || nft = 0 || nedge = 0 || nslots = 0 || nst = 0
        if: nname != 0
            l2_xfree((cast: (@: void) nname))
        if: nf0 != 0
            l2_xfree((cast: (@: void) nf0))
        if: nf1 != 0
            l2_xfree((cast: (@: void) nf1))
        if: nnode != 0
            l2_xfree((cast: (@: void) nnode))
        if: nbody != 0
            l2_xfree((cast: (@: void) nbody))
        if: nsig != 0
            l2_xfree((cast: (@: void) nsig))
        if: narity != 0
            l2_xfree((cast: (@: void) narity))
        if: ndyn != 0
            l2_xfree((cast: (@: void) ndyn))
        if: nret != 0
            l2_xfree((cast: (@: void) nret))
        if: nown != 0
            l2_xfree((cast: (@: void) nown))
        if: nsn != 0
            l2_xfree((cast: (@: void) nsn))
        if: nhcap != 0
            l2_xfree((cast: (@: void) nhcap))
        if: nfcap != 0
            l2_xfree((cast: (@: void) nfcap))
        if: ndn != 0
            l2_xfree((cast: (@: void) ndn))
        if: ndt != 0
            l2_xfree((cast: (@: void) ndt))
        if: nfn != 0
            l2_xfree((cast: (@: void) nfn))
        if: nft != 0
            l2_xfree((cast: (@: void) nft))
        if: nedge != 0
            l2_xfree((cast: (@: void) nedge))
        if: nslots != 0
            l2_xfree((cast: (@: void) nslots))
        if: nst != 0
            l2_xfree((cast: (@: void) nst))
        return: 1
    memset((cast: (@: void) nname), 0, nb)
    memset((cast: (@: void) nf0), 0, nb)
    memset((cast: (@: void) nf1), 0, nb)
    memset((cast: (@: void) nnode), 0, nb)
    memset((cast: (@: void) nbody), 0, nb)
    memset((cast: (@: void) nsig), 0, nu)
    memset((cast: (@: void) narity), 0, ni)
    memset((cast: (@: void) ndyn), 0, ni)
    memset((cast: (@: void) nret), 0, ni)
    memset((cast: (@: void) nown), 0, ni)
    memset((cast: (@: void) nsn), 0, ni)
    memset((cast: (@: void) nhcap), 0, ni)
    memset((cast: (@: void) nfcap), 0, ni)
    memset((cast: (@: void) ndn), 0, nb)
    memset((cast: (@: void) ndt), 0, nb)
    memset((cast: (@: void) nfn), 0, nb)
    memset((cast: (@: void) nft), 0, nb)
    memset((cast: (@: void) nedge), 0, nedge_n * c.sizeof(c.int))
    memset((cast: (@: void) nslots), 0, nslot * psz)
    memset((cast: (@: void) nst), 0, nslot * c.sizeof(c.int))
    oldcap: (cast: (size_t) l2_m_cap)
    i: 0
    while: i < l2_m_n
        nname[i]: l2_m_name[i]
        nf0[i]: l2_m_f0[i]
        nf1[i]: l2_m_f1[i]
        nnode[i]: l2_m_node[i]
        nbody[i]: l2_m_body[i]
        nsig[i]: l2_m_sig[i]
        narity[i]: l2_m_arity[i]
        ndyn[i]: l2_m_dyn[i]
        nret[i]: l2_m_ret[i]
        nown[i]: l2_m_own[i]
        nsn[i]: l2_m_sn[i]
        nhcap[i]: l2_m_hcap[i]
        nfcap[i]: l2_m_fcap[i]
        ndn[i]: l2_m_dn[i]
        ndt[i]: l2_m_dt[i]
        nfn[i]: l2_m_fn[i]
        nft[i]: l2_m_ft[i]
        i: i + 1
    i: 0
    while: i < l2_m_n
        j: 0
        while: j < l2_m_n
            off: (cast: (size_t) i) * oldcap
            off: off + (cast: (size_t) j)
            noff: (cast: (size_t) i) * cap
            noff: noff + (cast: (size_t) j)
            nedge[noff]: l2_m_edge[off]
            j: j + 1
        i: i + 1
    i: 0
    while: i < l2_m_n
        j: 0
        while: j < l2_m_sn[i]
            off: (cast: (size_t) i) * (cast: (size_t) l2_slot_cap)
            off: off + (cast: (size_t) j)
            noff: (cast: (size_t) i) * slotcap
            noff: noff + (cast: (size_t) j)
            nslots[noff]: l2_sn[off]
            nst[noff]: l2_st[off]
            j: j + 1
        i: i + 1
    oc: (cast: (size_t) l2_own_cap)
    if: oc != 0U && l2_m_uses != 0
        if: l2_mul3_ok(cap, oc, c.sizeof(c.int)) = 0
            l2_alloc_err: 2
            l2_xfree((cast: (@: void) nname))
            l2_xfree((cast: (@: void) nf0))
            l2_xfree((cast: (@: void) nf1))
            l2_xfree((cast: (@: void) nnode))
            l2_xfree((cast: (@: void) nbody))
            l2_xfree((cast: (@: void) nsig))
            l2_xfree((cast: (@: void) narity))
            l2_xfree((cast: (@: void) ndyn))
            l2_xfree((cast: (@: void) nret))
            l2_xfree((cast: (@: void) nown))
            l2_xfree((cast: (@: void) nsn))
            l2_xfree((cast: (@: void) nhcap))
            l2_xfree((cast: (@: void) nfcap))
            l2_xfree((cast: (@: void) ndn))
            l2_xfree((cast: (@: void) ndt))
            l2_xfree((cast: (@: void) nfn))
            l2_xfree((cast: (@: void) nft))
            l2_xfree((cast: (@: void) nedge))
            l2_xfree((cast: (@: void) nslots))
            l2_xfree((cast: (@: void) nst))
            return: 1
        nuses: (cast: (@: int) l2_xmalloc(cap * oc * c.sizeof(c.int)))
        nalias: (cast: (@: int) l2_xmalloc(cap * oc * c.sizeof(c.int)))
        npre: (cast: (@: int) l2_xmalloc(cap * oc * c.sizeof(c.int)))
        if: nuses = 0 || nalias = 0 || npre = 0
            if: nuses != 0
                l2_xfree((cast: (@: void) nuses))
            if: nalias != 0
                l2_xfree((cast: (@: void) nalias))
            if: npre != 0
                l2_xfree((cast: (@: void) npre))
            l2_xfree((cast: (@: void) nname))
            l2_xfree((cast: (@: void) nf0))
            l2_xfree((cast: (@: void) nf1))
            l2_xfree((cast: (@: void) nnode))
            l2_xfree((cast: (@: void) nbody))
            l2_xfree((cast: (@: void) nsig))
            l2_xfree((cast: (@: void) narity))
            l2_xfree((cast: (@: void) ndyn))
            l2_xfree((cast: (@: void) nret))
            l2_xfree((cast: (@: void) nown))
            l2_xfree((cast: (@: void) nsn))
            l2_xfree((cast: (@: void) nhcap))
            l2_xfree((cast: (@: void) nfcap))
            l2_xfree((cast: (@: void) ndn))
            l2_xfree((cast: (@: void) ndt))
            l2_xfree((cast: (@: void) nfn))
            l2_xfree((cast: (@: void) nft))
            l2_xfree((cast: (@: void) nedge))
            l2_xfree((cast: (@: void) nslots))
            l2_xfree((cast: (@: void) nst))
            return: 1
        memset((cast: (@: void) nuses), 0, cap * oc * c.sizeof(c.int))
        memset((cast: (@: void) npre), 0, cap * oc * c.sizeof(c.int))
        i: 0
        while: i < (cast: (int) cap)
            j: 0
            while: j < l2_own_cap
                noff: (cast: (size_t) i) * oc
                noff: noff + (cast: (size_t) j)
                nalias[noff]: -1
                j: j + 1
            i: i + 1
        i: 0
        while: i < (cast: (int) oldcap)
            j: 0
            while: j < l2_own_n
                off: (cast: (size_t) i) * oc
                off: off + (cast: (size_t) j)
                noff: (cast: (size_t) i) * oc
                noff: noff + (cast: (size_t) j)
                nuses[noff]: l2_m_uses[off]
                nalias[noff]: l2_m_alias[off]
                npre[noff]: l2_m_pre[off]
                j: j + 1
            i: i + 1
        l2_xfree((cast: (@: void) l2_m_uses))
        l2_xfree((cast: (@: void) l2_m_alias))
        l2_xfree((cast: (@: void) l2_m_pre))
        l2_m_uses: nuses
        l2_m_alias: nalias
        l2_m_pre: npre
        ---
    if: l2_m_name != 0
        l2_xfree((cast: (@: void) l2_m_name))
    if: l2_m_f0 != 0
        l2_xfree((cast: (@: void) l2_m_f0))
    if: l2_m_f1 != 0
        l2_xfree((cast: (@: void) l2_m_f1))
    if: l2_m_node != 0
        l2_xfree((cast: (@: void) l2_m_node))
    if: l2_m_body != 0
        l2_xfree((cast: (@: void) l2_m_body))
    if: l2_m_sig != 0
        l2_xfree((cast: (@: void) l2_m_sig))
    if: l2_m_arity != 0
        l2_xfree((cast: (@: void) l2_m_arity))
    if: l2_m_dyn != 0
        l2_xfree((cast: (@: void) l2_m_dyn))
    if: l2_m_ret != 0
        l2_xfree((cast: (@: void) l2_m_ret))
    if: l2_m_own != 0
        l2_xfree((cast: (@: void) l2_m_own))
    if: l2_m_sn != 0
        l2_xfree((cast: (@: void) l2_m_sn))
    if: l2_m_hcap != 0
        l2_xfree((cast: (@: void) l2_m_hcap))
    if: l2_m_fcap != 0
        l2_xfree((cast: (@: void) l2_m_fcap))
    if: l2_m_dn != 0
        l2_xfree((cast: (@: void) l2_m_dn))
    if: l2_m_dt != 0
        l2_xfree((cast: (@: void) l2_m_dt))
    if: l2_m_fn != 0
        l2_xfree((cast: (@: void) l2_m_fn))
    if: l2_m_ft != 0
        l2_xfree((cast: (@: void) l2_m_ft))
    if: l2_m_edge != 0
        l2_xfree((cast: (@: void) l2_m_edge))
    if: l2_sn != 0
        l2_xfree((cast: (@: void) l2_sn))
    if: l2_st != 0
        l2_xfree((cast: (@: void) l2_st))
    l2_m_name: nname
    l2_m_f0: nf0
    l2_m_f1: nf1
    l2_m_node: nnode
    l2_m_body: nbody
    l2_m_sig: nsig
    l2_m_arity: narity
    l2_m_dyn: ndyn
    l2_m_ret: nret
    l2_m_own: nown
    l2_m_sn: nsn
    l2_m_hcap: nhcap
    l2_m_fcap: nfcap
    l2_m_dn: ndn
    l2_m_dt: ndt
    l2_m_fn: nfn
    l2_m_ft: nft
    l2_m_edge: nedge
    l2_sn: nslots
    l2_st: nst
    l2_slot_cap: (cast: (int) slotcap)
    l2_m_cap: (cast: (int) cap)
return: 0

fn: l2_free_method (int: mi) int
    int: k 0
    if: mi < 0 || l2_m_cap <= 0 || mi >= l2_m_cap
        return: 0
    if: l2_m_fn[mi] != 0
        l2_xfree((cast: (@: void) l2_m_fn[mi]))
    if: l2_m_ft[mi] != 0
        l2_xfree((cast: (@: void) l2_m_ft[mi]))
    if: l2_m_dn[mi] != 0
        while: k < l2_m_dyn[mi]
            l2_xfree((cast: (@: void) l2_dn(mi, k)))
            k: k + 1
        l2_xfree((cast: (@: void) l2_m_dn[mi]))
    if: l2_m_dt[mi] != 0
        l2_xfree((cast: (@: void) l2_m_dt[mi]))
    l2_m_fn[mi]: 0
    l2_m_ft[mi]: 0
    l2_m_dn[mi]: 0
    l2_m_dt[mi]: 0
    l2_m_fcap[mi]: 0
    l2_m_hcap[mi]: 0
    l2_m_arity[mi]: 0
    l2_m_dyn[mi]: 0
return: 0

fn: l2_formals_alloc (int: mi; int: ar) int
    size_t: nb
    size_t: ni
    size_t: psz
    if: mi < 0 || ar < 0
        return: 1
    psz: c.sizeof(@: char)
    if: l2_mul_ok((cast: (size_t) ar), psz) = 0
        l2_alloc_err: 2
        return: 1
    if: l2_mul_ok((cast: (size_t) ar), c.sizeof(c.int)) = 0
        l2_alloc_err: 2
        return: 1
    nb: (cast: (size_t) ar) * psz
    ni: (cast: (size_t) ar) * c.sizeof(c.int)
    l2_m_fn[mi]: 0
    l2_m_ft[mi]: 0
    l2_m_fcap[mi]: 0
    if: ar = 0
        return: 0
    l2_alloc_kind: 1
    l2_m_fn[mi]: (cast: (@@: LmP0Text) l2_xmalloc(nb))
    l2_m_ft[mi]: (cast: (@: int) l2_xmalloc(ni))
    if: l2_m_fn[mi] = 0 || l2_m_ft[mi] = 0
        l2_free_method(mi)
        return: 1
    memset((cast: (@: void) l2_m_fn[mi]), 0, nb)
    memset((cast: (@: void) l2_m_ft[mi]), 0, ni)
    l2_m_fcap[mi]: ar
return: 0

fn: l2_hidden_reserve (int: mi; int: need) int
    size_t: cap
    size_t: need_u
    int: i
    size_t: nb
    size_t: ni
    size_t: psz
    @@: LmP0Text nn 0
    @: int nt 0
    @@: LmP0Text on
    @: int ot
    if: mi < 0 || need < 0
        return: 1
    if: need <= l2_m_hcap[mi]
        return: 0
    need_u: (cast: (size_t) need)
    cap: (cast: (size_t) l2_m_hcap[mi])
    if: cap < 1U
        cap: 4U
    while: cap < need_u
        if: cap > ((cast: (size_t) -1) / 2U)
            l2_alloc_err: 2
            return: 1
        cap: cap * 2U
    if: cap > (cast: (size_t) c.INT_MAX) && need_u > (cast: (size_t) c.INT_MAX)
        l2_alloc_err: 2
        return: 1
    if: cap > (cast: (size_t) c.INT_MAX)
        cap: need_u
        ---
    psz: c.sizeof(@: char)
    if: l2_mul_ok((cast: (size_t) cap), psz) = 0
        l2_alloc_err: 2
        return: 1
    if: l2_mul_ok((cast: (size_t) cap), c.sizeof(c.int)) = 0
        l2_alloc_err: 2
        return: 1
    nb: cap * psz
    ni: cap * c.sizeof(c.int)
    l2_alloc_kind: 2
    nn: (cast: (@@: LmP0Text) l2_xmalloc(nb))
    nt: (cast: (@: int) l2_xmalloc(ni))
    if: nn = 0 || nt = 0
        if: nn != 0
            l2_xfree((cast: (@: void) nn))
        if: nt != 0
            l2_xfree((cast: (@: void) nt))
        return: 1
    memset((cast: (@: void) nn), 0, nb)
    memset((cast: (@: void) nt), 0, ni)
    on: l2_m_dn[mi]
    ot: l2_m_dt[mi]
    i: 0
    while: i < l2_m_dyn[mi]
        nn[i]: on[i]
        nt[i]: ot[i]
        i: i + 1
    if: on != 0
        l2_xfree((cast: (@: void) on))
    if: ot != 0
        l2_xfree((cast: (@: void) ot))
    l2_m_dn[mi]: nn
    l2_m_dt[mi]: nt
    l2_m_hcap[mi]: (cast: (int) cap)
return: 0

fn: l2_fn (int: mi; int: k) @: LmP0Text
    @@: LmP0Text row
    if: mi < 0 || k < 0 || l2_m_fn[mi] = 0
        return: 0
    row: (cast: (@@: LmP0Text) l2_m_fn[mi])
return: row[k]

fn: l2_ft (int: mi; int: k) int
    @: int row
    if: mi < 0 || k < 0 || l2_m_ft[mi] = 0
        return: 0
    row: l2_m_ft[mi]
return: row[k]

fn: l2_dn (int: mi; int: k) @: LmP0Text
    @@: LmP0Text row
    if: mi < 0 || k < 0 || l2_m_dn[mi] = 0
        return: 0
    row: (cast: (@@: LmP0Text) l2_m_dn[mi])
return: row[k]

fn: l2_dt (int: mi; int: k) int
    @: int row
    if: mi < 0 || k < 0 || l2_m_dt[mi] = 0
        return: 0
    row: l2_m_dt[mi]
return: row[k]

fn: l2_fn_set (int: mi; int: k; @: LmP0Text v) int
    @@: LmP0Text row
    if: mi < 0 || k < 0 || l2_m_fn[mi] = 0
        return: 1
    row: (cast: (@@: LmP0Text) l2_m_fn[mi])
    row[k]: v
return: 0

fn: l2_ft_set (int: mi; int: k; int: v) int
    @: int row
    if: mi < 0 || k < 0 || l2_m_ft[mi] = 0
        return: 1
    row: l2_m_ft[mi]
    row[k]: v
return: 0

fn: l2_dn_set (int: mi; int: k; @: LmP0Text v) int
    @@: LmP0Text row
    if: mi < 0 || k < 0 || l2_m_dn[mi] = 0
        return: 1
    row: (cast: (@@: LmP0Text) l2_m_dn[mi])
    row[k]: v
return: 0

fn: l2_dt_set (int: mi; int: k; int: v) int
    @: int row
    if: mi < 0 || k < 0 || l2_m_dt[mi] = 0
        return: 1
    row: l2_m_dt[mi]
    row[k]: v
return: 0

fn: l2_path_is_lm2 (const: @(char path)) int
    size_t: n
    if: path = 0
        return: 0
    n: strlen(path)
    if: n < 4U
        return: 0
    if: path[n - 4U] != 46
        return: 0
    if: path[n - 3U] != 108 && path[n - 3U] != 76
        return: 0
    if: path[n - 2U] != 109 && path[n - 2U] != 77
        return: 0
    if: path[n - 1U] != 50
        return: 0
return: 1

fn: l2_next_active (@: LmP0Field field) @: LmP0Field
    while: field != 0 && l2_ignored(field\value)
        field: field\next
return: field

fn: l2_count_active (const: @(LmP0Structure body)) int
    @: LmP0Field field
    int: n 0
    if: body = 0
        return: 0
    field: l2_next_active(body\first_field)
    while: field != 0
        n: n + 1
        field: l2_next_active(field\next)
return: n

fn: l2_write_sym (@: FILE out; int: i) int
    if: out = 0
        return: 1
    if: l2_library_mode != 0 && c.fprintf(out, "l2_u%08X%08X_m%d", l2_module_hash_a, l2_module_hash_b, i) < 0
        return: 1
    if: l2_library_mode = 0 && c.fprintf(out, "l2_m%d", i) < 0
        return: 1
return: 0

fn: l2_digits (const: @(LmP0Text text)) int
    size_t: i
    if: text = 0 || text\data = 0 || text\length = 0U
        return: 0
    if: text\length > 1U && text\data[0] = 48
        return: 0
    i: 0U
    while: i < text\length
        if: text\data[i] < 48 || text\data[i] > 57
            return: 0
        i: i + 1U
return: 1

fn: l2_num (const: @(LmP0Text text)) int
    size_t: n
    size_t: i
    if: text = 0 || text\data = 0 || text\length = 0U
        return: 0
    n: text\length
    if: text\data[n - 1U] = 85 || text\data[n - 1U] = 117
        n: n - 1U
    if: n = 0U
        return: 0
    if: n > 2U && text\data[0] = 48 && (text\data[1] = 120 || text\data[1] = 88)
        i: 2U
        while: i < n
            if: (text\data[i] < 48 || text\data[i] > 57) && (text\data[i] < 65 || text\data[i] > 70) && (text\data[i] < 97 || text\data[i] > 102)
                return: 0
            i: i + 1U
        ---
        return: 1
    ---
    if: n > 1U && text\data[0] = 48
        return: 0
    i: 0U
    while: i < n
        if: text\data[i] < 48 || text\data[i] > 57
            return: 0
        i: i + 1U
return: 1

# Every character of `text`, with an optional U suffix, is an octal digit.
fn: l2_octal_digits (const: @(LmP0Text text)) int
    size_t: n
    size_t: i 0U
    if: text = 0 || text\data = 0 || text\length = 0U
        return: 0
    n: text\length
    if: text\data[n - 1U] = 85 || text\data[n - 1U] = 117
        n: n - 1U
    if: n = 0U
        return: 0
    while: i < n
        if: text\data[i] < 48 || text\data[i] > 55
            return: 0
        i: i + 1U
return: 1

fn: l2_signed_num (const: @(LmP0Text text)) int
    size_t: i 1U
    if: text = 0 || text\data = 0 || text\length < 2U || text\data[0] != 45
        return: 0
    if: text\length > 2U && text\data[1] = 48
        return: 0
    while: i < text\length
        if: text\data[i] < 48 || text\data[i] > 57
            return: 0
        i: i + 1U
return: 1

fn: l2_int_fits (const: @(LmP0Text text)) int
    size_t: i
    int: acc 0
    int: d 0
    int: q
    int: r
    if: l2_digits(text) = 0
        return: 0
    q: c.INT_MAX / 10
    r: c.INT_MAX % 10
    i: 0U
    while: i < text\length
        d: text\data[i] - 48
        if: acc > q
            return: 0
        if: acc = q && d > r
            return: 0
        acc: acc * 10 + d
        i: i + 1U
return: 1

# 1 = bits holds the int (a leading minus is part of the literal, D-19). 2 = an int literal
# that does not fit. 0 = not an int literal. INT_MIN is the one magnitude past INT_MAX.
fn: l2_int_literal_bits (const: @(LmP0Text text); @: size_t out_bits) int
    size_t: i 1U
    size_t: acc 0U
    size_t: d 0U
    size_t: lim
    int: v 0
    if: text = 0 || out_bits = 0
        return: 0
    if: l2_num(text) != 0
        if: l2_int_fits(text) = 0
            return: 2
        \out_bits: l2_literal_value(text)
        return: 1
    if: l2_signed_num(text) = 0
        return: 0
    lim: (cast: (size_t) c.INT_MAX) + 1U
    while: i < text\length
        d: (cast: (size_t) (text\data[i] - 48))
        if: acc > (lim - d) / 10U
            return: 2
        acc: acc * 10U + d
        i: i + 1U
    ---
    if: acc > lim
        return: 2
    if: acc = lim
        v: 0 - c.INT_MAX - 1
    else:
        v: 0 - (cast: (int) acc)
    ---
    \out_bits: (cast: (size_t) v)
return: 1

# ONE LITERAL-RANGE RULE. Kind 0=int 1=char 2=size_t 3=unsigned 4=ulong; kind<0 skips.
fn: l2_lit_kind_from_ft (int: ft) int
    if: ft = 0
        return: 0
    if: ft = 1
        return: 1
    if: ft = 2
        return: 2
    if: ft = 34
        return: 3
    if: ft = 36
        return: 4
return: 0 - 1

fn: l2_lit_kind_from_own (int: oty) int
    # Own/loc storage uses 0 for int (same hole as dynamic inputs).
    if: oty = 0 || oty = 3
        return: 0
    if: oty = 1
        return: 1
    if: oty = 2
        return: 2
    if: oty = 6
        return: 3
    if: oty = 36
        return: 4
return: 0 - 1

fn: l2_lit_kind_from_ret (int: mret) int
    if: mret = 0
        return: 0
    if: mret = 1
        return: 1
    if: mret = 2
        return: 2
    if: mret = 33
        return: 3
    if: mret = 36
        return: 4
return: 0 - 1

fn: l2_u32_fits (const: @(LmP0Text text)) int
    size_t: i 0U
    size_t: stop
    unsigned: acc 0U
    unsigned: d 0U
    unsigned: q
    unsigned: r
    if: text = 0 || text\data = 0 || text\length = 0U
        return: 0
    stop: text\length
    if: text\data[stop - 1U] = 85 || text\data[stop - 1U] = 117
        stop: stop - 1U
    if: stop = 0U
        return: 0
    if: stop > 1U && text\data[0] = 48
        return: 0
    q: (cast: (unsigned) -1) / 10U
    r: (cast: (unsigned) -1) % 10U
    while: i < stop
        if: text\data[i] < 48 || text\data[i] > 57
            return: 0
        d: (cast: (unsigned) (text\data[i] - 48))
        if: acc > q
            return: 0
        if: acc = q && d > r
            return: 0
        acc: acc * 10U + d
        i: i + 1U
return: 1

fn: l2_char_digit_fits (const: @(LmP0Text text)) int
    size_t: bits 0U
    int: value
    if: l2_int_literal_bits(text, @ bits) != 1
        return: 0
    value: (cast: (int) bits)
return: (cast: (int) (value >= c.CHAR_MIN && value <= c.CHAR_MAX))

fn: l2_size_t_fits_text (const: @(LmP0Text text)) int
    size_t: i 0U
    size_t: stop
    size_t: acc 0U
    size_t: d 0U
    size_t: q
    size_t: r
    if: text = 0 || text\data = 0 || text\length = 0U
        return: 0
    stop: text\length
    if: text\data[stop - 1U] = 85 || text\data[stop - 1U] = 117
        stop: stop - 1U
    if: stop = 0U
        return: 0
    if: stop > 1U && text\data[0] = 48
        return: 0
    q: ((cast: (size_t) -1) / 10U)
    r: ((cast: (size_t) -1) % 10U)
    while: i < stop
        if: text\data[i] < 48 || text\data[i] > 57
            return: 0
        d: (cast: (size_t) (text\data[i] - 48))
        if: acc > q
            return: 0
        if: acc = q && d > r
            return: 0
        acc: acc * 10U + d
        i: i + 1U
return: 1

fn: l2_literal_fits_kind (const: @(LmP0Text text); int: kind) int
    if: kind < 0 || text = 0
        return: 1
    if: kind = 0
        return: l2_int_fits(text)
    if: kind = 1
        return: l2_char_digit_fits(text)
    if: kind = 2
        return: l2_size_t_fits_text(text)
    if: kind = 3
        return: l2_u32_fits(text)
    if: kind = 4
        return: l2_u32_fits(text)
return: 1

fn: l2_check_literal_kind (const: @(LmP0Text text); int: kind; const: @(char path); const: @(LmP0Node at)) int
    size_t: bits 0U
    int: st 0
    if: kind < 0 || text = 0
        return: 0
    if: kind = 0
        st: l2_int_literal_bits(text, @ bits)
        if: st = 2
            return: l2_error(path, at, "literal not representable as int")
        if: st = 1
            return: 0
    ---
    if: kind = 1
        st: l2_int_literal_bits(text, @ bits)
        if: st = 0
            return: 0
        if: st = 2 || l2_char_digit_fits(text) = 0
            return: l2_error(path, at, "literal not representable as char")
        return: 0
    if: kind = 0
        if: l2_digits(text) = 0
            return: 0
        ---
    ---
    if: kind = 2 || kind = 3 || kind = 4
        if: text\data = 0 || text\length = 0U || text\data[0] < 48 || text\data[0] > 57
            return: 0
        ---
    ---
    if: l2_literal_fits_kind(text, kind) != 0
        return: 0
    if: kind = 0
        return: l2_error(path, at, "literal not representable as int")
    if: kind = 1
        return: l2_error(path, at, "literal not representable as char")
    if: kind = 2
        return: l2_error(path, at, "literal not representable as size_t")
    if: kind = 3
        return: l2_error(path, at, "literal not representable as unsigned")
    if: kind = 4
        return: l2_error(path, at, "literal not representable as ulong")
return: l2_error(path, at, "literal not representable as type")


# ONE RETURN-LITERAL RULE FOR EVERY CALLABLE.  A decimal literal returned from a callable whose
# result is int must be representable as int -- the entry E included, which is an ordinary method.
fn: l2_check_return_literal (int: mi; const: @(LmP0Structure body); const: @(char path); const: @(LmP0Node at)) int
    @: LmP0Field arg
    int: kind 0
    if: body = 0 || l2_count_active(body) != 1
        return: 0
    kind: l2_lit_kind_from_ret(l2_m_ret[mi])
    if: kind < 0
        return: 0
    arg: l2_next_active(body\first_field)
    if: arg = 0 || arg\value = 0 || arg\value\kind != c.LM_P0_NODE_ATOM
        return: 0
return: l2_check_literal_kind(arg\value\as\atom, kind, path, at)

# The condition of the postcondition loop an anonymous block is -- its `until:` trailer's Structure -- or 0.  Book §13:
# «Закрывающий `until` задаёт проверку после тела»: the body at least once, then the condition, the loop ending when it
# holds; the block is an ordinary control body of the enclosing activation (the author, Q54; OPUS-Q54-TRAILER).
fn: l2_block_until (const: @(LmP0Node stmt)) @: LmP0Structure
    if: stmt = 0 || stmt\kind != c.LM_P0_NODE_STRUCTURE || stmt\as = 0 || stmt\as\structure = 0 || stmt\as\structure\trailer = 0
        return: 0
    if: stmt\as\structure\trailer\spelling = 0 || l2_text_eq(stmt\as\structure\trailer\spelling, "until") = 0
        return: 0
return: stmt\as\structure\trailer\body

fn: l2_end_named (const: @(LmP0Frame frame); const: @(char name)) int
    @: LmP0Field field
    if: frame = 0 || frame\trailer = 0
        return: 0
    if: l2_text_eq(frame\trailer\spelling, "end") = 0
        return: 0
    if: frame\trailer\body = 0
        return: 0
    field: l2_next_active(frame\trailer\body\first_field)
    if: field = 0 || l2_next_active(field\next) != 0
        return: 0
    if: field\value = 0 || field\value\kind != c.LM_P0_NODE_ATOM
        return: 0
return: l2_text_eq(field\value\as\atom, name)

fn: l2_fn_close (const: @(LmP0Frame frame); const: @(LmP0Text name); const: @(char head)) int
    @: LmP0Field field
    @: LmP0Text actual
    if: frame = 0
        return: 1
    if: frame\trailer = 0
        return: 0
    if: l2_text_eq(frame\trailer\spelling, "return")
        return: 0
    if: l2_text_eq(frame\trailer\spelling, "end") = 0
        return: 1
    if: frame\trailer\body = 0
        return: 1
    field: l2_next_active(frame\trailer\body\first_field)
    if: field = 0 || l2_next_active(field\next) != 0
        return: 1
    if: field\value = 0 || field\value\kind != c.LM_P0_NODE_ATOM
        return: 1
    actual: field\value\as\atom
    if: name != 0 && l2_text_same(actual, name)
        return: 0
    if: head != 0 && l2_text_eq(actual, head)
        return: 0
return: 1

fn: l2_ret_tr (const: @(LmP0Frame frame)) @: LmP0Structure
    if: frame = 0 || frame\trailer = 0 || frame\trailer\spelling = 0
        return: 0
    if: l2_text_eq(frame\trailer\spelling, "return") = 0
        return: 0
return: frame\trailer\body

fn: l2_check_ret_tr (int: mi; const: @(char path); const: @(LmP0Structure body); const: @(LmP0Node at)) int
    int: n
    if: body = 0
        return: 0
    n: l2_count_active(body)
    if: body\trailer != 0
        return: l2_error(path, at, "unsupported trailer")
    if: l2_m_ret[mi] = 8 && n != 0
        return: l2_error(path, at, "unsupported body")
    if: l2_m_ret[mi] != 8 && n = 0
        return: l2_error(path, at, "unsupported body")
    if: l2_check_return_literal(mi, body, path, at) != 0
        return: 1
    if: l2_check_ret_convert(mi, body, path) != 0
        return: 1
    # Callers are not in this body. The Consumer is the required descriptor.
    if: l2_nsty_get(mi, 0 - 1) >= 0 && n > 0 && l2_admit_return(mi, body\first_field, n, path, at) != 0
        return: 1
    # The value is checked as any value is, a Structure result's too (the D-108 gate for a return): a call
    # in it records its edges -- of the throw closure and of D-105 -- and meets the static rule of §14.
    if: n != 0 && l2_check_fields(body\first_field, n, mi, path, at) != 0
        return: 1
    if: n != 0 && l2_d105_note_return(mi, body\first_field, n, at) != 0
        return: 1
return: 0

# A source return without a value follows the resolved native ABI: a direct
# void body returns nothing; a throwing body returns its success status.
# Publication, polling and cleanup remain at the caller's existing boundary.
fn: l2_emit_empty_return (int: mi; const: @(char ind)) int
    if: l2_m_throws != 0 && l2_m_throws[mi] != 0
        return: (cast: (int) (c.fprintf(l2_out, "%sreturn: 0\n", ind) < 0))
return: (cast: (int) (c.fprintf(l2_out, "%sreturn\n", ind) < 0))

fn: l2_emit_ret_tr (int: mi; const: @(char ind); const: @(LmP0Structure body)) int
    L2ReferenceSource: source
    int: n
    int: pret 2
    if: body = 0 || ind = 0
        return: 0
    n: l2_count_active(body)
    l2_reference_source(body\first_field, n, mi, @ source)
    # In a throwing callable the return is the status, and a trailer, like a `return:` in the
    # body, returns 0: its value goes to the normal output.  A value is never a status.
    if: l2_m_ret[mi] = 8
        if: n != 0
            return: 1
        # §7b: a return is an exit -- what is marked is published before it (book §14).
        if: l2_emit_publish(ind) != 0
            return: 1
        return: l2_emit_empty_return(mi, ind)
    if: n = 0
        return: 1
    if: l2_nsty_get(mi, 0 - 1) >= 0
        pret: l2_emit_return_path(mi, body\first_field, n, ind, body\first_field\value)
        if: pret = 1
            return: 1
        ---
    if: pret = 2
        pret: l2_emit_ret_convert(mi, body, body\first_field\value, ind, l2_tok)
        if: pret = 1
            return: 1
        ---
    if: pret = 2 && l2_eval_fields(body\first_field, n, mi, ind, l2_tok) != 0
        return: 1
    # D-105 native: a result admitted by name records its value before it leaves (l2_d105_emit_admit).  A dynamic
    # candidate -- a value of opaque type (RECEPTION-EDGE-DEBTS (f)), a formal, an own reference, a call's result --
    # is refused there as this method's implicit `implements` (DUPLICATE-STOP).
    if: l2_input_model(mi, -1) >= 0 && (l2_return_opaque(body\first_field, n, mi) != 0 || l2_d105_dynamic(@ source) != 0) && l2_emit_model_admit(mi, l2_input_model(mi, -1), @ source, l2_tok\data, ind, 1, 0, -1, mi, mi, -1) != 0
        return: 1
    if: l2_input_model(mi, -1) >= 0 && l2_return_opaque(body\first_field, n, mi) = 0 && l2_d105_dynamic(@ source) = 0 && l2_emit_model_admit(mi, l2_input_model(mi, -1), @ source, l2_tok\data, ind, 1, 0, -1, -1, -1, -1) != 0
        return: 1
    # §7b: the value is evaluated above; what is marked is published before the return (book §14).
    if: l2_emit_publish(ind) != 0
        return: 1
    if: (l2_m_throws = 0 || l2_m_throws[mi] = 0) && c.fprintf(l2_out, "%sreturn: %s\n", ind, l2_tok\data) < 0
        return: 1
    if: l2_m_throws != 0 && l2_m_throws[mi] != 0 && c.fprintf(l2_out, "%sl2_out_result[0]: %s\n%sreturn: 0\n", ind, l2_tok\data, ind) < 0
        return: 1
return: 0

fn: l2_frame_head (const: @(LmP0Node node); const: @(char name)) int
    if: node = 0 || node\kind != c.LM_P0_NODE_FRAME || node\as = 0 || node\as\frame = 0
        return: 0
return: l2_text_eq(node\as\frame\head, name)

fn: l2_empty_struct (const: @(LmP0Node node)) int
    if: node = 0 || node\kind != c.LM_P0_NODE_STRUCTURE || node\as = 0
        return: 0
return: l2_count_active(node\as\structure) = 0

fn: l2_triple_fence_n (const: @(LmP0Text t)) size_t
    int: q
    if: t = 0 || t\data = 0 || t\length < 6U
        return: 0U
    q: (cast: (int) t\data[0])
    if: q != 34 && q != 39
        return: 0U
    if: t\data[1] != t\data[0] || t\data[2] != t\data[0]
        return: 0U
    if: t\data[t\length - 1U] != t\data[0] || t\data[t\length - 2U] != t\data[0] || t\data[t\length - 3U] != t\data[0]
        return: 0U
return: 3U

fn: l2_triple_q (const: @(LmP0Text t)) int
    if: l2_triple_fence_n(t) = 0U
        return: 0
return: (cast: (int) t\data[0])

fn: l2_quoted (const: @(LmP0Text t)) int
    if: t = 0 || t\data = 0 || t\length < 2U
        return: 0
    if: l2_triple_q(t) != 0
        return: 1
    if: t\data[0] != 34 || t\data[t\length - 1U] != 34
        return: 0
    if: t\length >= 6U && t\data[1] = 34 && t\data[2] = 34
        return: 0
return: 1

fn: l2_decode_triple_body (const: @(LmP0Text t); @@: char outp; @: size_t outn) int
    @: char buf 0
    size_t: nfen
    size_t: n
    size_t: i 0U
    size_t: o 0U
    size_t: run
    size_t: emitn
    size_t: k
    char: qch
    if: outp = 0 || outn = 0
        return: 1
    \outp: 0
    \outn: 0U
    nfen: l2_triple_fence_n(t)
    if: nfen = 0U || t = 0 || t\data = 0
        return: 1
    n: t\length - nfen - nfen
    if: n = 0U
        return: 0
    buf: (cast: (@: char) l2_xmalloc(n + 1U))
    if: buf = 0
        return: 1
    qch: t\data[0]
    while: i < n
        if: t\data[nfen + i] = qch
            run: 0U
            while: i + run < n && t\data[nfen + i + run] = qch
                run: run + 1U
            emitn: run
            if: run >= 4U
                emitn: run - 1U
            k: 0U
            while: k < emitn
                buf[o]: qch
                o: o + 1U
                k: k + 1U
            i: i + run
            continue
        buf[o]: t\data[nfen + i]
        o: o + 1U
        i: i + 1U
    buf[o]: 0
    \outp: buf
    \outn: o
return: 0

fn: l2_fmt_l1_string (@: char dest; size_t: cap; const: @(char data); size_t: n) int
    size_t: i 0U
    size_t: o 0U
    int: ch
    size_t: need
    if: dest = 0 || cap < 3U
        return: 1
    dest[o]: 34
    o: o + 1U
    while: i < n
        if: data = 0
            return: 1
        ch: (cast: (int) data[i])
        if: ch < 0
            ch: ch + 256
        need: 1U
        if: ch = 34 || ch = 92 || ch = 10 || ch = 13 || ch = 63
            need: 2U
        else:
            if: ch < 32 || ch > 126
                need: 4U
            ---
        ---
        if: o + need + 2U > cap
            return: 1
        if: ch = 34
            dest[o]: 92
            dest[o + 1U]: 34
            o: o + 2U
            i: i + 1U
            continue
        if: ch = 92
            dest[o]: 92
            dest[o + 1U]: 92
            o: o + 2U
            i: i + 1U
            continue
        if: ch = 10
            dest[o]: 92
            dest[o + 1U]: 110
            o: o + 2U
            i: i + 1U
            continue
        if: ch = 13
            dest[o]: 92
            dest[o + 1U]: 114
            o: o + 2U
            i: i + 1U
            continue
        if: ch = 63
            dest[o]: 92
            dest[o + 1U]: 63
            o: o + 2U
            i: i + 1U
            continue
        if: ch < 32 || ch > 126
            dest[o]: 92
            dest[o + 1U]: (cast: (char) (48 + (ch / 64)))
            dest[o + 2U]: (cast: (char) (48 + ((ch / 8) % 8)))
            dest[o + 3U]: (cast: (char) (48 + (ch % 8)))
            o: o + 4U
            i: i + 1U
            continue
        dest[o]: (cast: (char) ch)
        o: o + 1U
        i: i + 1U
    dest[o]: 34
    dest[o + 1U]: 0
return: 0

fn: l2_write_text (@: FILE out; const: @(LmP0Text t)) int
    if: out = 0 || t = 0 || t\data = 0
        return: 1
    if: t\length = 0U
        return: 0
    if: c.fwrite(t\data, 1U, t\length, out) != t\length
        return: 1
return: 0

fn: l2_unit_from_root (const: @(LmP0Node root); const: @(char path); @@: LmP0Structure out_unit) int
    if: out_unit = 0
        return: l2_error(path, root, "internal: missing unit slot")
    \out_unit: 0
    if: root = 0 || root\kind != c.LM_P0_NODE_STRUCTURE || root\as = 0 || root\as\structure = 0
        return: l2_error(path, root, "unsupported body")
    # The selected input profile belongs to the file, not a source name.
    # Keep the parser's actual root and all of its children, including a
    # single ordinary named Structure whose spelling happens to be L2.
    \out_unit: root\as\structure
return: 0

# The currently implemented root method producers. Classification and the
# pre-registration census share this predicate. fm's producer is still absent;
# implementing it must extend this one predicate, not just the name census.
fn: l2_root_method_head (const: @(LmP0Text head)) int
return: (cast: (int) (l2_text_eq(head, "fn") || l2_text_eq(head, "sub")))

# Only declarations at this lexical root export a method name. Do not descend
# into method or ordinary named-Structure bodies. This is a source census,
# not signature collection or a runtime name registry.
fn: l2_root_names_method (const: @(LmP0Structure root); const: @(LmP0Text name)) int
    @: LmP0Field field
    @: LmP0Node item
    @: LmP0Text nm
    if: root = 0 || name = 0
        return: 0
    field: l2_next_active(root\first_field)
    while: field != 0
        item: field\value
        if: l2_root_method_head(l2_app_head(item)) != 0
            nm: l2_os_fn_name(item)
            if: nm != 0 && l2_text_same(nm, name) != 0
                return: 1
            ---
        ---
        field: l2_next_active(field\next)
    ---
return: 0

# A program's already parsed parts export methods exactly as its source does.
# COUNT and FILL must recognize those names before any signatures are collected.
# Ordinary named Structures and reference bindings remain forward-only.
fn: l2_unit_names_method (const: @(LmP0Text name)) int
    int: k 0
    const: @: LmP0Node node
    const: @: LmP0Structure root
    if: name = 0
        return: 0
    if: l2_root_names_method(l2_cur_unit, name) != 0
        return: 1
    if: l2_ruse_unit != l2_cur_unit && l2_root_names_method(l2_ruse_unit, name) != 0
        return: 1
    while: l2_part_doc != 0 && k < l2_part_n
        node: lm_p0_document_root(l2_part_doc[k])
        if: node != 0 && node\kind = c.LM_P0_NODE_STRUCTURE && node\as != 0
            root: node\as\structure
            if: root != l2_cur_unit && root != l2_ruse_unit && l2_root_names_method(root, name) != 0
                return: 1
            ---
        ---
        k: k + 1
    ---
return: 0

# A declaration at a program part's root that the program does not take from a part yet (§10: a part gives
# its methods, its source tables, and its root's fields and statements) -- refused in the words of the
# mechanism it waits for, its registration from a part, and nothing else.
fn: l2_part_refused (const: @(char path); const: @(LmP0Node item); int: role) int
    []: char msg 240
    const: @: char what "a named Structure"
    const: @: char why "the program registers the named Structures of its source only"
    if: role = 2
        what: "a qualified branch"
        why: "the program registers the qualified branches of its source only"
    if: role = 3
        what: "the os block"
        why: "the program reads the os block of its source only"
    if: role = 4
        what: "a directive"
        why: "the program reads the directives of its source only"
    c.snprintf(msg, 240U, "%s in a program part is not supported yet (%s)", what, why)
return: l2_error(path, item, msg)

# The language's receivers that head a statement (L2 spec, the statement forms): a found callable is invoked first
# (book §9, :559), so a head that is one of them is never a declaration's.  The other words of the language -- `fn`,
# `if`, `while`, `for`, `return`, `const`, `sizeof`, a type word, the C door -- are no name already (l2_ident,
# l2_prim_type_word, l2_is_known).
fn: l2_receiver_word (const: @(LmP0Text t)) int
return: (cast: (int) (l2_text_eq(t, "sendMessage") || l2_text_eq(t, "receiveMessage") || l2_text_eq(t, "merge") || l2_text_eq(t, "table") || l2_text_eq(t, "catch") || l2_text_eq(t, "throw") || l2_text_eq(t, "throws") || l2_text_eq(t, "until") || l2_text_eq(t, "end") || l2_text_eq(t, "sub") || l2_text_eq(t, "fm") || l2_text_eq(t, "synchronized") || l2_text_eq(t, "length") || l2_text_eq(t, "cast")))

# The parser has already made the complete tail a Structure. An absent head
# retains that body, including a lone atom/literal or an expression span.
# This neither infers a primitive variable nor executes/resolves the body.
# Result-receiving call/receiver contracts are classified separately by callers.
fn: l2_retained_body (const: @(LmP0Frame fr)) int
return: (cast: (int) (fr != 0 && fr\body != 0))

# Whether head t, at unit item `item`, resolves to nothing (book §9 :559: the declaration route is the one left when
# neither a callable nor a non-callable binding is found): no method -- visible both ways (l2_unit_names_method) --,
# no field the unit declares, no C door or declared function, no primitive type word, no word of the language, and
# no named Structure an earlier item of the unit declared -- that is a binding, whose `f()` or `f:` + Structure is the
# assignment with admission (:561).  Read from the source's order, never from what is registered yet: every pass that
# classifies the unit's items -- a count before the named Structures exist, a fill after -- gets one answer.
fn: l2_head_absent (const: @(LmP0Text t); const: @(LmP0Node item)) int
    @: LmP0Field f
    @: LmP0Text got
    if: t = 0 || l2_ident(t) = 0 || l2_unit_names_method(t) != 0 || l2_site_method(0 - 1, t) >= 0
        return: 0
    if: l2_unit_declares(t, item) != 0 || l2_is_known(t) != 0 || l2_predef_receiver(t) != 0 || (l2_prim_type_word(t) != 0 && l2_ns_find(t) < 0) || l2_head_word(t) != 0
        return: 0
    if: l2_cur_unit = 0
        return: 1
    f: l2_next_active(l2_cur_unit\first_field)
    while: f != 0 && f\value != item
        # The receiver `@: t f(a)` of a factory's result above the item declares t (l2_receiver_frame): `t: 3 4`
        # below it applies t.  A method above the receiver has no binding of t (unit_held_call_above_unknown_head).
        if: l2_receiver_frame(f\value, @ got) != 0 && l2_text_same(got, t) != 0
            return: 0
        # An earlier frame headed t binds t, whatever its tail is written as: its definition (the first written
        # occurrence of an unknown head), merge's construction or a reference binding (data).  A definition below
        # makes no head above it known: an ordinary named Structure is visible from its place on
        # (docs/LMX_semantics.en.md#declaration-visibility; the author, 2026-10-07).
        if: f\value != 0 && f\value\kind = c.LM_P0_NODE_FRAME && f\value\as != 0 && f\value\as\frame != 0 && f\value\as\frame\head != 0 && l2_text_same(f\value\as\frame\head, t) != 0 && l2_retained_body(f\value\as\frame) != 0
            return: 0
        f: l2_next_active(f\next)
    ---
return: 1

# K03 S5 (Codex K03-S5-DEFINITION-TAIL-20261007-03; docs/LMX_semantics.en.md#construction): 1 when the frame's first
# item is merge's application -- the atom or its Frame (l2_app_head), the word read by the defined set -- whose own
# construction contract makes the outer name the result: `b: merge: A C`, `b: merge(A C)`.  No other receiver gives an
# absent outer name a result: its application, bare, empty or with arguments, is an item of the retained body under
# its ordinary statement contract (l2_check_word_stmt), and a known word never names a nested Structure.
fn: l2_merge_construction (const: @(LmP0Frame fr)) int
    @: LmP0Field f
    @: LmP0Text h
    if: fr = 0 || fr\body = 0
        return: 0
    f: l2_next_active(fr\body\first_field)
    if: f = 0 || f\value = 0
        return: 0
    h: l2_app_head(f\value)
    if: h = 0 || l2_head_word(h) = 0 || l2_text_eq(h, "merge") = 0
        return: 0
return: 1

# K03 NS-ROLES-1 (Codex K03-S5-MIGRATION-20261007-06 (b); docs/LMX_semantics.en.md:666, :834; L2_spec_en.md:206): the
# registry of the reference bindings `b: A` the collection found (l2_ref_bind_site): the word of A's model, or 0.
fn: l2_rb_find (const: @(LmP0Node stmt)) @: LmP0Text
    int: i 0
    if: stmt = 0
        return: 0
    while: i < l2_rb_n
        if: l2_rb_at[i] = stmt
            return: l2_rb_model[i]
        i: i + 1
    ---
return: 0

# The method whose occurrence the kept binding stmt holds (`b: tick`), or -1: a Structure's binding, or no binding.
fn: l2_rb_meth_of (const: @(LmP0Node stmt)) int
    int: i 0
    if: stmt = 0
        return: -1
    while: i < l2_rb_n
        if: l2_rb_at[i] = stmt
            return: l2_rb_meth[i]
        i: i + 1
    ---
return: -1

# Keep statement stmt as a reference binding: to a Structure whose model is named by word model (meth -1), or to the
# occurrence of method meth (model the word written for it).  0, or 1 without memory.
fn: l2_rb_add (const: @(LmP0Node stmt); const: @(LmP0Text model); int: meth) int
    int: want
    @: void grown
    if: stmt = 0 || model = 0 || l2_rb_find(stmt) != 0
        return: 0
    if: l2_rb_n >= l2_rb_cap
        want: l2_cap_next(l2_rb_cap, l2_rb_n + 1)
        if: want < 0
            return: 1
        grown: l2_vec_grow((cast: (@: void) l2_rb_at), l2_rb_n, want, c.sizeof(@: LmP0Node))
        if: grown = 0
            return: 1
        l2_rb_at: (cast: (@@: LmP0Node) grown)
        grown: l2_vec_grow((cast: (@: void) l2_rb_model), l2_rb_n, want, c.sizeof(@: LmP0Text))
        if: grown = 0
            return: 1
        l2_rb_model: (cast: (@@: LmP0Text) grown)
        grown: l2_vec_grow((cast: (@: void) l2_rb_meth), l2_rb_n, want, c.sizeof(c.int))
        if: grown = 0
            return: 1
        l2_rb_meth: (cast: (@: int) grown)
        grown: l2_vec_grow((cast: (@: void) l2_rb_own), l2_rb_n, want, c.sizeof(c.int))
        if: grown = 0
            return: 1
        l2_rb_own: (cast: (@: int) grown)
        l2_rb_cap: want
    ---
    l2_rb_at[l2_rb_n]: (cast: (@: LmP0Node) stmt)
    l2_rb_model[l2_rb_n]: (cast: (@: LmP0Text) model)
    l2_rb_meth[l2_rb_n]: meth
    l2_rb_own[l2_rb_n]: -1
    l2_rb_n: l2_rb_n + 1
return: 0

# K03 NS-ROLES-1c: keep statement stmt as a reference binding to the merge result own field `own` holds, its declared
# type the word `model` (a Structure reference).  0, or 1 without memory.
fn: l2_rb_add_own (const: @(LmP0Node stmt); const: @(LmP0Text model); int: own) int
    if: stmt = 0 || model = 0 || own < 0 || l2_rb_find(stmt) != 0
        return: 0
    if: l2_rb_add(stmt, model, -3) != 0
        return: 1
    l2_rb_own[l2_rb_n - 1]: own
return: 0

# The own field of the merge result the kept binding stmt holds (NS-ROLES-1c), or -1.
fn: l2_rb_own_of (const: @(LmP0Node stmt)) int
    int: i 0
    if: stmt = 0
        return: -1
    while: i < l2_rb_n
        if: l2_rb_at[i] = stmt
            return: l2_rb_own[i]
        i: i + 1
    ---
return: -1

# The declaration of a kept reference binding `b: A`: b as the reference `@: M b A` declares it, M the word of A's
# model (l2_rb_find) -- one declaration for every reader (l2_declaration), made once.
fn: l2_rb_declaration (const: @(LmP0Node node)) @: L2Declaration
    @: L2Declaration result l2_declarations
    @: L2TypeContract leaf
    @: LmP0Text word l2_rb_find(node)
    # A binding to a method's occurrence (NS-ROLES-1b) has no model to take: its row is a reference cell
    # (l2_own_decl_ty) and its store the occurrence (l2_emit_stmts, l2_rw_stmt_content).
    if: l2_rb_meth_of(node) >= 0
        return: 0
    while: result != 0
        if: result\source = node && result\contract != 0 && result\contract\kind = 2
            return: result
        result: result\allocated_next
    ---
    if: word = 0 || node\as = 0 || node\as\frame = 0 || node\as\frame\body = 0
        return: 0
    leaf: l2_contract_new(0, 0, word, 0)
    if: leaf = 0
        return: 0
    result: (cast: (@: L2Declaration) l2_xmalloc(c.sizeof(c.L2Declaration)))
    if: result = 0
        return: 0
    result\source: (cast: (@: LmP0Node) node)
    result\contract: l2_contract_new(2, 1, 0, leaf)
    result\name: node\as\frame\head
    result\candidate: l2_next_active(node\as\frame\body\first_field)
    result\candidate_count: 1
    result\extent: 0
    result\allocated_next: l2_declarations
    l2_declarations: result
    if: result\contract = 0
        return: 0
return: result

# The one atom A of a frame `b: A` -- its body exactly one active field, an identifier atom that is no word of the
# language (a word there is S5's: an item of a retained body) -- or 0.
fn: l2_ref_tail_atom (const: @(LmP0Frame fr)) @: LmP0Text
    @: LmP0Field f
    if: fr = 0 || fr\body = 0 || fr\body\trailer != 0 || l2_count_active(fr\body) != 1
        return: 0
    f: l2_next_active(fr\body\first_field)
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM || f\value\as = 0 || f\value\as\atom = 0 || l2_ident(f\value\as\atom) = 0 || l2_head_word(f\value\as\atom) != 0
        return: 0
return: f\value\as\atom

# Whether root item `item` is an item of the unit itself (not a statement of a block).
fn: l2_unit_item (const: @(LmP0Node item)) int
    @: LmP0Field f
    if: l2_cur_unit = 0 || item = 0
        return: 0
    f: l2_next_active(l2_cur_unit\first_field)
    while: f != 0
        if: f\value = item
            return: 1
        f: l2_next_active(f\next)
    ---
return: 0

# A qualified branch's root named t under the qualifier chain of node n (`independent: const: immutable: (): t`), or 0.
# The root only: a Structure nested in the root's body is a field of it, no definition of the unit.
fn: l2_tree_branch_root (const: @(LmP0Node n); const: @(LmP0Text t)) int
    @: LmP0Field f
    if: n = 0 || n\kind != c.LM_P0_NODE_FRAME || n\as = 0 || n\as\frame = 0 || n\as\frame\body = 0
        return: 0
    f: l2_next_active(n\as\frame\body\first_field)
    if: l2_frame_head(n, "()") != 0
        return: (cast: (int) (f != 0 && f\value != 0 && f\value\kind = c.LM_P0_NODE_ATOM && f\value\as != 0 && l2_text_same(f\value\as\atom, t) != 0))
    if: l2_frame_head(n, "independent") = 0 && l2_frame_head(n, "const") = 0 && l2_frame_head(n, "immutable") = 0
        return: 0
    while: f != 0
        if: l2_tree_branch_root(f\value, t) != 0
            return: 1
        f: l2_next_active(f\next)
    ---
return: 0

# Whether an item of the unit above `stop` defines a qualified branch whose root is named t -- an ordinary named
# Structure, visible from its place on as l2_unit_defines_struct's is.
fn: l2_unit_defines_branch (const: @(LmP0Text t); const: @(LmP0Node stop)) int
    @: LmP0Field f
    if: l2_cur_unit = 0 || t = 0
        return: 0
    f: l2_next_active(l2_cur_unit\first_field)
    while: f != 0 && f\value != stop
        if: l2_frame_head(f\value, "independent") != 0 && l2_tree_branch_root(f\value, t) != 0
            return: 1
        f: l2_next_active(f\next)
    ---
return: 0

# Whether a unit item above `item` binds a as a Structure value, read from the source in order (a value is visible
# forward only): a reference binding `a: A` (l2_unit_ref_bind), merge's construction `a: merge: ...`, a typed
# reference `@: T a ...` of a Structure T the unit defines, or the receiver of a call's result `@: a f(x)`.
fn: l2_unit_value_above (const: @(LmP0Text a); const: @(LmP0Node item)) int
    @: LmP0Field f
    @: LmP0Node it
    @: LmP0Field g
    @: LmP0Field h
    @: LmP0Text got
    if: l2_cur_unit = 0 || a = 0
        return: 0
    f: l2_next_active(l2_cur_unit\first_field)
    while: f != 0 && f\value != item
        it: f\value
        if: l2_receiver_frame(it, @ got) != 0 && l2_text_same(got, a) != 0
            return: 1
        if: it != 0 && it\kind = c.LM_P0_NODE_FRAME && it\as != 0 && it\as\frame != 0 && it\as\frame\head != 0 && it\as\frame\body != 0
            if: l2_text_same(it\as\frame\head, a) != 0 && l2_merge_construction(it\as\frame) != 0
                return: 1
            if: l2_text_same(it\as\frame\head, a) != 0 && l2_ref_tail_atom(it\as\frame) != 0 && l2_unit_ref_bind(it\as\frame, it) != 0 && l2_head_absent(a, it) != 0
                return: 1
            if: l2_address_depth(it\as\frame\head) = 1
                g: l2_next_active(it\as\frame\body\first_field)
                h: 0
                if: g != 0
                    h: l2_next_active(g\next)
                if: g != 0 && h != 0 && g\value != 0 && h\value != 0 && g\value\kind = c.LM_P0_NODE_ATOM && h\value\kind = c.LM_P0_NODE_ATOM && g\value\as != 0 && h\value\as != 0 && l2_text_same(h\value\as\atom, a) != 0 && l2_unit_defines_struct(g\value\as\atom, it) != 0
                    return: 1
                ---
            ---
        ---
        f: l2_next_active(f\next)
    ---
return: 0

# The memo of l2_unit_ref_bind: the index of item's answer, or -1.
fn: l2_urm_find (const: @(LmP0Node item)) int
    int: i 0
    while: i < l2_urm_n
        if: l2_urm_at[i] = item
            return: i
        i: i + 1
    ---
return: -1

# A new answer, -1 (being found), for item; its index, or -1 without memory (the answer is then found again).
fn: l2_urm_add (const: @(LmP0Node item)) int
    int: want
    @: void grown
    if: l2_urm_n >= l2_urm_cap
        want: l2_cap_next(l2_urm_cap, l2_urm_n + 1)
        if: want < 0
            return: -1
        grown: l2_vec_grow((cast: (@: void) l2_urm_at), l2_urm_n, want, c.sizeof(@: LmP0Node))
        if: grown = 0
            return: -1
        l2_urm_at: (cast: (@@: LmP0Node) grown)
        grown: l2_vec_grow((cast: (@: void) l2_urm_val), l2_urm_n, want, c.sizeof(c.int))
        if: grown = 0
            return: -1
        l2_urm_val: (cast: (@: int) grown)
        l2_urm_cap: want
    ---
    l2_urm_at[l2_urm_n]: (cast: (@: LmP0Node) item)
    l2_urm_val[l2_urm_n]: -1
    l2_urm_n: l2_urm_n + 1
return: l2_urm_n - 1

# K03 NS-ROLES-1 (docs/LMX_semantics.en.md:666; Codex K03-S5-ALIAS-VISIBILITY-20261007-07 Q2): whether root item
# `item`, its head resolving to nothing, is the reference binding `b: A` -- its tail one atom A the unit names as a
# callable definition, above or below (a named Structure it defines, a qualified branch's root, a method: visible both
# ways -- a method's whole occurrence, Codex -07 Q1), or as a Structure value bound above it (l2_unit_value_above).
# Read from the source, as the unit role is, before anything is registered, and once per item: while it is being found
# the item counts as no binding -- a definition -- so a cycle `x: y` / `y: x` has one answer, the first item's in
# source order.
fn: l2_unit_ref_bind (const: @(LmP0Frame fr); const: @(LmP0Node item)) int
    @: LmP0Text a l2_ref_tail_atom(fr)
    int: m
    int: got 0
    if: a = 0 || item = 0
        return: 0
    m: l2_urm_find(item)
    if: m >= 0
        return: (cast: (int) (l2_urm_val[m] = 1))
    m: l2_urm_add(item)
    if: l2_unit_names_method(a) != 0 || l2_unit_defines_struct(a, item) != 0 || l2_unit_defines_branch(a, item) != 0 || l2_unit_value_above(a, item) != 0
        got: 1
    if: m >= 0
        l2_urm_val[m]: got
return: got

# What one unit item is: 1 a method, 2 a qualified branch, 3 the os block, 4 a
# directive, 5 a named Structure, 0 a statement of the entry E.  A named
# Structure is a frame whose head resolves to nothing and whose tail is a
# Structure (l2_head_absent, l2_retained_body) -- however it is closed;
# every other frame -- `Model: m` (Model's call), `x: 5` (a value), `f(1)` (a
# call), `R: merge: A B` (a receiver's value) -- is a statement.
fn: l2_unit_role (const: @(LmP0Node item)) int
    const: @: LmP0Frame fr
    @: LmP0Text ah l2_app_head(item)
    # K03 S5: the item's application -- the atom or its Frame (l2_app_head) -- decides: `fn` and `fn()`, `os` and `os()`,
    # `include` and `include()` are one item each, meeting one contract.
    if: l2_root_method_head(ah) != 0
        return: 1
    if: l2_text_eq(ah, "independent") != 0
        return: 2
    if: l2_text_eq(ah, "os") != 0
        return: 3
    if: l2_unit_word(ah) != 0
        return: 4
    if: item = 0 || item\kind != c.LM_P0_NODE_FRAME || item\as = 0 || item\as\frame = 0 || item\as\frame\body = 0
        return: 0
    fr: item\as\frame
    if: l2_ident(fr\head) = 0 || l2_unit_names_method(fr\head) != 0
        return: 0
    # General resolution (book §9, docs/LMX_semantics.ru.md :559-:565; the author, Q54): a head that resolves to
    # nothing, with a Structure tail, declares a named Structure -- whatever closes the frame: `end: Name`, a bare
    # `return`, `until:` and a dedent are P0's boundaries, never the declaration, and no return is required.
    if: l2_unimpl_numeric(item) != 0
        return: 0
    # An absent head declares a named Structure with its written tail -- a Structure, identifier atoms or a literal
    # (`x: 7`) alike: the language has no var (docs/LMX_semantics.en.md#resolved-head-consumption).
    # merge's construction is the statement even when that tail is nonempty: `R: merge: A B` (l2_merge_construction).
    # A tail that begins with a known method declares the Structure too and calls nothing,
    # in every spelling (Q58): `add5: makeAdder 5` is a definition.  A factory's result is
    # received by `@: add5 makeAdder(5)` (the author, 2026-10-05; l2_receiver_call).
    if: l2_head_absent(fr\head, item) != 0 && l2_retained_body(fr) != 0
        if: l2_merge_construction(fr) != 0
            return: 0
        # K03 NS-ROLES-1: the reference binding `b: A` is a statement of E, no definition of b.
        if: l2_unit_ref_bind(fr, item) != 0
            return: 0
        return: 5
    ---
return: 0

# The words whose application declares a named Structure field (l2_take_ns_body): a number or char field, an
# array, an inline nested Structure, a callable field.
fn: l2_ns_field_word (const: @(LmP0Text h)) int
    if: h = 0
        return: 0
    if: l2_text_eq(h, "size_t") || l2_text_eq(h, "int") || l2_text_eq(h, "unsigned") || l2_text_eq(h, "ulong") || l2_text_eq(h, "char")
        return: 1
return: (cast: (int) (l2_text_eq(h, "[]") || l2_text_eq(h, "()") || l2_text_eq(h, "fn")))

# K03 S5: what the field declaration of word h applied to nothing lacks, said at node -- the refusals its Frame form
# gives for no argument (l2_take_ns_body).
fn: l2_ns_field_needs (const: @(char path); const: @(LmP0Node node); const: @(LmP0Text h)) int
    if: l2_text_eq(h, "fn")
        return: l2_error(path, node, "a callable field needs a method name")
    if: l2_text_eq(h, "[]")
        return: l2_error(path, node, "an array field needs a type, a name and a count")
    if: l2_text_eq(h, "()")
        return: l2_error(path, node, "a nested Structure needs a name and a body")
return: l2_error(path, node, "a named Structure field needs a name")

# Whether node, an item of a named Structure's body, declares a field by a word: a number or char field, an array,
# an inline nested Structure, a callable field, a reference `@: T x` -- the typed shapes l2_take_ns_body takes.  K03
# NS-ROLES-2 (Codex K03-NS-ROLES-2-20261007-20; docs/LMX_semantics.en.md#resolved-head-consumption): there is no
# `Name: field` shape -- with Name known at its place the item is Name's application, a statement of the body; with
# Name absent it is a definition or the binding `Name: A` (l2_ns_nested_def, l2_ns_bind_item).
fn: l2_ns_decl_first (const: @(LmP0Node node)) int
    if: node = 0 || node\kind != c.LM_P0_NODE_FRAME || node\as = 0 || node\as\frame = 0 || node\as\frame\head = 0 || node\as\frame\body = 0
        return: 0
    if: l2_ns_field_word(node\as\frame\head) != 0
        return: 1
return: (cast: (int) (l2_address_depth(node\as\frame\head) != 0))

# Whether the unit declares a field named name above stop (the whole unit when stop is 0) -- a frame
# whose first item is the atom name after a type word or an address.  A frame headed by such a name is an
# assignment to it, never a new named Structure, whatever its body looks like (l2_head_absent asks this,
# with the item it classifies as stop).  K03 NS-ROLES-3: `Model: name` is no declaration of name -- with Model
# existing it is Model's call (docs/LMX_semantics.en.md:668), a fresh instance is `name: merge: Model`.  Read from the source's order, as l2_head_absent is: `Model: Other`
# below a named Structure `Other:` is Model's call with it (OPUS-ROOT-CALL-20260930-17), and it declares
# nothing that could unmake the Structure above it.  A type word is a primitive word or a c.* name,
# never a named Structure -- l2_prim_type_word also answers for a registered one, and the answer must
# not depend on what is registered yet: the lexical pass's count walk and fill walk ask the same.
fn: l2_unit_declares (const: @(LmP0Text name); const: @(LmP0Node stop)) int
    @: LmP0Field field
    @: LmP0Node item
    @: LmP0Field first
    @: LmP0Text bound 0
    if: l2_cur_unit = 0 || name = 0
        return: 0
    field: l2_next_active(l2_cur_unit\first_field)
    while: field != 0 && (stop = 0 || field\value != stop)
        item: field\value
        # K03 NS-ROLES-1: a root reference binding `name: A` declares name (l2_unit_ref_bind).
        if: item != 0 && item\kind = c.LM_P0_NODE_FRAME && item\as != 0 && item\as\frame != 0 && item\as\frame\head != 0 && l2_text_same(item\as\frame\head, name) != 0 && l2_ref_tail_atom(item\as\frame) != 0 && l2_unit_ref_bind(item\as\frame, item) != 0 && l2_head_absent(name, item) != 0
            return: 1
        if: item != 0 && item\kind = c.LM_P0_NODE_FRAME && item\as != 0 && item\as\frame != 0 && item\as\frame\body != 0 && item\as\frame\head != 0 && l2_text_same(item\as\frame\head, name) = 0
            # K03 S5: receiveMessage declares the name it binds (its contract, l2_receive_msg_shape, one name or two).
            if: l2_receive_msg_shape(item, @ bound, 0) = 0 && l2_text_same(bound, name) != 0
                return: 1
            first: l2_next_active(item\as\frame\body\first_field)
            # A declaration's shape, not any frame whose first atom is the name: P0 splits a path
            # `got: Counter\n` into the atoms Counter, \, n.  A type word takes the name first; an address
            # `@: Type name` takes it second (L2: `Type` and `var` are two separate tail fields).
            if: l2_address_depth(item\as\frame\head) != 0 && first != 0
                first: l2_next_active(first\next)
            if: first != 0 && first\value != 0 && first\value\kind = c.LM_P0_NODE_ATOM && first\value\as != 0 && l2_text_same(first\value\as\atom, name) != 0
                if: (l2_prim_type_word(item\as\frame\head) != 0 && l2_ns_find(item\as\frame\head) < 0) || l2_predef_receiver(item\as\frame\head) != 0 || l2_address_depth(item\as\frame\head) != 0
                    return: 1
                ---
            ---
        ---
        field: l2_next_active(field\next)
    ---
return: 0

# Method row E: the unit statements collected by the lexical pass, in order,
# as the body of one ordinary METHOD with no name and no formals. Its own fields
# -- the unit fields -- are registered at their statements
# by the collector every method uses (l2_own_add(E, ...)), `m: merge: Model`
# included. E is the last row, so every method keeps its own row number.
fn: l2_make_entry (const: @(char path)) int
    int: sn 0
    int: k 0
    if: l2_m_n >= c.INT_MAX
        l2_alloc_err: 2
        return: l2_error(path, 0, "size overflow")
    if: l2_meth_reserve(l2_m_n + 1) != 0
        if: l2_alloc_err = 2
            return: l2_error(path, 0, "size overflow")
        return: l2_error(path, 0, "out of memory")
    l2_alloc_kind: 1
    l2_e_struct: (cast: (@: LmP0Structure) l2_xmalloc(c.sizeof(c.LmP0Structure)))
    l2_e_as: (cast: (@: LmP0NodeAs) l2_xmalloc(c.sizeof(c.LmP0NodeAs)))
    l2_e_node: (cast: (@: LmP0Node) l2_xmalloc(c.sizeof(c.LmP0Node)))
    if: l2_e_struct = 0 || l2_e_as = 0 || l2_e_node = 0
        return: l2_error(path, 0, "out of memory")
    memset((cast: (@: void) l2_e_struct), 0, c.sizeof(c.LmP0Structure))
    memset((cast: (@: void) l2_e_as), 0, c.sizeof(c.LmP0NodeAs))
    memset((cast: (@: void) l2_e_node), 0, c.sizeof(c.LmP0Node))
    if: l2_e_n > 0
        l2_e_struct\first_field: l2_e_fields
        l2_e_struct\last_field: l2_e_fields + (l2_e_n - 1)
    ---
    l2_e_struct\field_count: (cast: (size_t) l2_e_n)
    l2_e_as\structure: l2_e_struct
    l2_e_node\kind: c.LM_P0_NODE_STRUCTURE
    l2_e_node\as: l2_e_as
    if: l2_formals_alloc(l2_m_n, 0) != 0
        return: l2_error(path, 0, "out of memory")
    l2_m_name[l2_m_n]: 0
    l2_m_node[l2_m_n]: 0
    l2_m_body[l2_m_n]: l2_e_node
    l2_m_arity[l2_m_n]: 0
    l2_m_dyn[l2_m_n]: 0
    l2_m_f0[l2_m_n]: 0
    l2_m_f1[l2_m_n]: 0
    l2_m_ret[l2_m_n]: 8
    l2_m_sig[l2_m_n]: 0U
    l2_m_own[l2_m_n]: 0
    l2_m_sn[l2_m_n]: 0
    l2_e: l2_m_n
    if: l2_collect_decls(l2_e_struct, l2_e, path, 0, @ sn) != 0
        return: 1
    l2_m_sn[l2_e]: sn
    l2_m_n: l2_m_n + 1
    # A unit field is a name every later method may read, so it may not be the
    # name of a method (visible both ways) or of a named Structure or branch.
    while: k < l2_own_n
        if: l2_own_mi[k] = l2_e && l2_own_host[k] = 0 && l2_find_method(l2_own_name[k]) >= 0
            return: l2_error(path, l2_own_decl[k], "method collides with a unit field")
        if: l2_own_mi[k] = l2_e && l2_own_host[k] = 0 && (l2_ns_find(l2_own_name[k]) >= 0 || l2_ebr_find(l2_own_name[k]) >= 0)
            return: l2_error(path, l2_own_decl[k], "named Structure collides with a unit field")
        # §10: a field of a part's root is a unit field for the part's methods, and the program's methods are
        # visible from them.  (The source's named Structures are not: nothing of the source is.)
        if: l2_own_host[k] = 0 && l2_m_file(l2_own_mi[k]) >= 0 && l2_m_part(l2_own_mi[k]) < 0 && l2_find_method(l2_own_name[k]) >= 0
            return: l2_error(l2_method_src(l2_own_mi[k], path), l2_own_decl[k], "method collides with a unit field")
        k: k + 1
    ---
return: 0

# The body of named Structure ni's procedure when a `until` closes it (l2_ns_proc_add): a Structure of one field, an
# anonymous block whose Structure holds the named Structure's items and its `until:` trailer.  0, or 1 out of memory.
fn: l2_ns_loop_body (int: ni; @: LmP0NodeAs nas) int
    @: LmP0Structure blk_s
    @: LmP0NodeAs blk_as
    @: LmP0Node blk
    @: LmP0Field fld
    @: LmP0Structure outer
    blk_s: (cast: (@: LmP0Structure) l2_xmalloc(c.sizeof(c.LmP0Structure)))
    blk_as: (cast: (@: LmP0NodeAs) l2_xmalloc(c.sizeof(c.LmP0NodeAs)))
    blk: (cast: (@: LmP0Node) l2_xmalloc(c.sizeof(c.LmP0Node)))
    fld: (cast: (@: LmP0Field) l2_xmalloc(c.sizeof(c.LmP0Field)))
    outer: (cast: (@: LmP0Structure) l2_xmalloc(c.sizeof(c.LmP0Structure)))
    if: blk_s = 0 || blk_as = 0 || blk = 0 || fld = 0 || outer = 0
        l2_xfree((cast: (@: void) blk_s))
        l2_xfree((cast: (@: void) blk_as))
        l2_xfree((cast: (@: void) blk))
        l2_xfree((cast: (@: void) fld))
        l2_xfree((cast: (@: void) outer))
        return: 1
    memset((cast: (@: void) blk_s), 0, c.sizeof(c.LmP0Structure))
    memset((cast: (@: void) blk_as), 0, c.sizeof(c.LmP0NodeAs))
    memset((cast: (@: void) blk), 0, c.sizeof(c.LmP0Node))
    memset((cast: (@: void) fld), 0, c.sizeof(c.LmP0Field))
    memset((cast: (@: void) outer), 0, c.sizeof(c.LmP0Structure))
    blk_s\first_field: l2_ns_at[ni]\as\frame\body\first_field
    blk_s\last_field: l2_ns_at[ni]\as\frame\body\last_field
    blk_s\field_count: l2_ns_at[ni]\as\frame\body\field_count
    blk_s\trailer: l2_ns_at[ni]\as\frame\trailer
    blk_as\structure: blk_s
    blk\kind: c.LM_P0_NODE_STRUCTURE
    blk\as: blk_as
    blk\span: l2_ns_at[ni]\span
    fld\value: blk
    outer\first_field: fld
    outer\last_field: fld
    outer\field_count: 1U
    nas\structure: outer
return: 0

# Only the existing namespace-procedure adapter owns these P0-shaped shells.
# Its source fields/trailer are borrowed and must never be recursively freed.
fn: l2_ns_proc_body_free (int: ni; @: LmP0Node node) int
    @: LmP0Structure outer
    @: LmP0Field field
    @: LmP0Node block
    if: node = 0
        return: 0
    outer: node\as\structure
    if: outer != l2_ns_at[ni]\as\frame\body
        field: outer\first_field
        block: field\value
        l2_xfree((cast: (@: void) block\as\structure))
        l2_xfree((cast: (@: void) block\as))
        l2_xfree((cast: (@: void) block))
        l2_xfree((cast: (@: void) field))
        l2_xfree((cast: (@: void) outer))
    ---
    l2_xfree((cast: (@: void) node\as))
    l2_xfree((cast: (@: void) node))
return: 0

fn: l2_ns_procs_free () int
    int: ni 0
    int: mi
    while: ni < l2_ns_n
        mi: l2_ns_proc[ni]
        if: mi >= 0
            l2_ns_proc_body_free(ni, l2_m_body[mi])
            l2_m_body[mi]: 0
            l2_ns_proc[ni]: -1
        ---
        ni: ni + 1
    ---
return: 0

# steps/named-struct-exec.md §12 (the author, Q45: "Это просто процедура без аргументов и возвращаемого
# значения"): named Structure ni is a procedure without formals or result, as the entry E is
# (l2_make_entry) -- a method whose body is the Structure's body, head 0 (l2_m_head), its own fields the
# Structure's fields in the Structure's slots (l2_own_mslot); it runs over the Structure as its data.
# 0, or 1 said.
fn: l2_ns_proc_add (int: ni; const: @(char path)) int
    @: LmP0NodeAs nas
    @: LmP0Node node
    int: sn 0
    int: me
    int: k
    if: l2_ns_at[ni] = 0 || l2_ns_at[ni]\as = 0 || l2_ns_at[ni]\as\frame = 0 || l2_ns_at[ni]\as\frame\body = 0
        return: l2_error(path, l2_ns_at[ni], "internal: a named Structure's procedure has no body")
    if: l2_m_n >= c.INT_MAX
        l2_alloc_err: 2
        return: l2_error(path, l2_ns_at[ni], "size overflow")
    if: l2_meth_reserve(l2_m_n + 1) != 0
        return: l2_alloc_or(path, l2_ns_at[ni], "out of memory")
    nas: (cast: (@: LmP0NodeAs) l2_xmalloc(c.sizeof(c.LmP0NodeAs)))
    node: (cast: (@: LmP0Node) l2_xmalloc(c.sizeof(c.LmP0Node)))
    if: nas = 0 || node = 0
        l2_xfree((cast: (@: void) nas))
        l2_xfree((cast: (@: void) node))
        return: l2_alloc_or(path, l2_ns_at[ni], "out of memory")
    memset((cast: (@: void) nas), 0, c.sizeof(c.LmP0NodeAs))
    memset((cast: (@: void) node), 0, c.sizeof(c.LmP0Node))
    nas\structure: l2_ns_at[ni]\as\frame\body
    node\kind: c.LM_P0_NODE_STRUCTURE
    node\as: nas
    node\span: l2_ns_at[ni]\span
    # Closed by `until` (the author, Q54): the Structure's executable body is that postcondition loop -- the procedure's
    # body is one anonymous block over the Structure's items with the same `until` trailer, the general loop
    # (l2_block_until); declaring the Structure runs nothing, a call runs the loop.  Its fields stay the Structure's
    # (l2_collect_decls below reads the Structure's own body).
    if: l2_ns_at[ni]\as\frame\trailer != 0 && l2_ns_at[ni]\as\frame\trailer\spelling != 0 && l2_text_eq(l2_ns_at[ni]\as\frame\trailer\spelling, "until") != 0
        if: l2_ns_loop_body(ni, nas) != 0
            l2_ns_proc_body_free(ni, node)
            return: l2_alloc_or(path, l2_ns_at[ni], "out of memory")
        ---
    if: l2_formals_alloc(l2_m_n, 0) != 0
        l2_ns_proc_body_free(ni, node)
        return: l2_alloc_or(path, l2_ns_at[ni], "out of memory")
    me: l2_m_n
    l2_m_name[me]: 0
    l2_m_node[me]: 0
    l2_m_body[me]: node
    l2_m_arity[me]: 0
    l2_m_dyn[me]: 0
    l2_m_f0[me]: 0
    l2_m_f1[me]: 0
    l2_m_ret[me]: 8
    l2_m_sig[me]: 0U
    l2_m_own[me]: 0
    l2_m_sn[me]: 0
    l2_ns_proc[ni]: me
    # Publish the complete method row before collecting its declarations.
    l2_m_n: l2_m_n + 1
    if: l2_collect_decls(l2_ns_at[ni]\as\frame\body, me, path, 0, @ sn) != 0
        return: 1
    l2_m_sn[me]: sn
    # Every own row of the procedure is the Structure's data, one of its fields, or a computed output, which no field
    # is: its place is its own receiver occurrence (l2_own_mslot).
    k: 0
    while: k < l2_own_n
        if: l2_own_mi[k] = me && l2_own_host[k] = 0 && l2_own_mslot(k) < 0
            return: l2_error(path, l2_own_decl[k], "internal: a declaration of a named Structure's body is not a field of the Structure")
        k: k + 1
    ---
return: 0

# §12: whether the statements from `first` execute the unit-level named Structures -- by a bare atom, or by `t()` on
# the existing binding: one nullary call (book §9 after 55c1abc: `f` and `f()` call f) -- by its own name, marking each
# (l2_ns_exec_mark).  A syntactic reading, before any method is checked: the procedures are registered before the entry
# E (l2_occ_n).  It errs only toward a procedure no statement runs.  (K03 NS-ROLES-2: the root's `Model: v` declares no
# field v -- it is Model's call -- so a name v the root executes marks no Model.)
fn: l2_ns_exec_scan (@: LmP0Field first) int
    @: LmP0Field f
    @: LmP0Field g
    @: LmP0Node v
    @: LmP0Text t
    int: hit 0
    f: l2_next_active(first)
    while: f != 0
        v: f\value
        t: 0
        if: v != 0 && v\kind = c.LM_P0_NODE_ATOM && v\as != 0 && l2_discard_run(f) = 1
            t: v\as\atom
        if: l2_empty_call_shape(v) != 0
            t: v\as\frame\head
        if: t != 0 && l2_ns_exec_mark(t) != 0
            hit: 1
        if: v != 0 && v\kind = c.LM_P0_NODE_FRAME && v\as != 0 && v\as\frame != 0 && v\as\frame\body != 0
            g: l2_next_active(v\as\frame\body\first_field)
            while: g != 0
                if: g\value != 0 && g\value\kind = c.LM_P0_NODE_STRUCTURE && g\value\as != 0 && g\value\as\structure != 0 && l2_ns_exec_scan(g\value\as\structure\first_field) != 0
                    hit: 1
                g: l2_next_active(g\next)
            ---
            if: l2_frame_head(v, "else") != 0 && l2_ns_exec_scan(v\as\frame\body\first_field) != 0
                hit: 1
        ---
        if: v != 0 && v\kind = c.LM_P0_NODE_STRUCTURE && v\as != 0 && v\as\structure != 0 && l2_ns_exec_scan(v\as\structure\first_field) != 0
            hit: 1
        f: l2_next_active(f\next)
    ---
return: hit

# The named Structure a statement of l2_ns_exec_scan's executes by its name t, marked (l2_ns_exec).  1 when it marked
# one.  (The root's declaring `E()` is a unit item, l2_unit_role 5, never one of the statements scanned.)
fn: l2_ns_exec_mark (const: @(LmP0Text t)) int
    int: ni l2_ns_find(t)
    if: ni >= 0 && l2_ns_parent[ni] < 0 && l2_ns_eternal[ni] < 0 && l2_ns_exec[ni] = 0
        l2_ns_exec[ni]: 1
        return: 1
return: 0

# An original namespace definition has source content regardless of calledness.
# A synthesized host model's ns_at is not its defining head token. Part roots
# retain their explicit producer; they do not gain a name or a signature.
# Registration still scans executable calls, without executing a declaration.
fn: l2_ns_procs (const: @(char path)) int
    int: i
    int: more 1
    if: l2_e_n > 0
        l2_ns_exec_scan(l2_e_fields)
    i: 0
    while: i < l2_m_n
        if: l2_m_body[i] != 0 && l2_m_body[i]\as != 0 && l2_m_body[i]\as\structure != 0
            l2_ns_exec_scan(l2_m_body[i]\as\structure\first_field)
        i: i + 1
    ---
    # Qualified adapters still need their connected source producer. Ordinary
    # nested definitions retain the same original-body producer as their parent.
    i: 0
    while: i < l2_ns_n
        if: l2_ns_stmt[i] != 0 && (l2_ns_eternal[i] >= 0 || (l2_ns_parent[i] >= 0 && l2_ns_original_body(i) = 0))
            return: l2_error(path, l2_ns_stmt[i], "a statement in a nested or qualified named Structure is not supported yet")
        i: i + 1
    ---
    # §10: a part's root's procedure is registered whatever its body holds -- its own fields are the root's
    # fields a method of the part reads by name (l2_own_unit_seen) -- and no statement executes it: its entry
    # has no name, and each lookup that could name an entry compares a name (l2_ns_find, l2_ns_find_payload,
    # l2_path_root), so its l2_ns_exec stays 0.
    while: more != 0
        more: 0
        i: 0
        while: i < l2_ns_n
            if: l2_ns_proc[i] < 0 && l2_ns_original_body(i) != 0
                if: l2_ns_part(i) < 0 && l2_ns_proc_add(i, path) != 0
                    return: 1
                if: l2_ns_part(i) >= 0 && l2_ns_proc_add(i, l2_part_path[l2_ns_part(i)]) != 0
                    return: 1
                if: l2_ns_exec_scan(l2_ns_at[i]\as\frame\body\first_field) != 0
                    more: 1
                more: 1
            ---
            i: i + 1
        ---
    ---
return: 0

# Identify the original producer by P0 identity, independently of calledness
# or procedure registration. Parentage changes placement, not source identity.
fn: l2_ns_original_body (int: ni) @: LmP0Structure
    @: LmP0Node node
    if: ni < 0 || ni >= l2_ns_n || l2_ns_eternal[ni] >= 0
        return: 0
    node: l2_ns_at[ni]
    if: node = 0 || node\as = 0 || node\as\frame = 0 || node\as\frame\body = 0
        return: 0
    if: l2_ns_name[ni] != node\as\frame\head && l2_ns_part(ni) < 0
        return: 0
return: node\as\frame\body

# The original source producer reuses its existing namespace occurrence.
# A local constructor, qualified branch or synthetic UNTIL wrapper is a
# distinct producer until its connected migration, not a second source body.
fn: l2_ns_source_body (int: ni) @: LmP0Structure
    int: mi
    @: LmP0Node node
    if: l2_ns_original_body(ni) = 0
        return: 0
    mi: l2_ns_proc[ni]
    node: l2_ns_at[ni]
    if: mi < 0 || node = 0 || node\as = 0 || node\as\frame = 0 || node\as\frame\body = 0 || l2_m_body[mi] = 0 || l2_m_body[mi]\as = 0 || l2_m_body[mi]\as\structure != node\as\frame\body
        return: 0
return: node\as\frame\body

# Existing constructors record their original P0 child in the transient NSF
# row. Match that source identity, not a spelling or a later binding; a child
# already constructed by that row is not an executable redeclaration. Numeric
# and pointer cells still keep their initializer operations in the source body.
fn: l2_ns_constructed_row (int: mi; const: @(LmP0Node node)) int
    int: ni l2_m_nsof(mi)
    int: row 0
    int: found -1
    int: match
    @: LmP0Field field
    @: LmP0Structure body l2_ns_source_body(ni)
    if: body = 0 || node = 0 || node\as = 0
        return: -1
    field: l2_next_active(body\first_field)
    while: field != 0 && field\value != node
        field: l2_next_active(field\next)
    if: field = 0
        return: -1
    while: row < l2_nsf_n
        match: 0
        if: l2_nsf_owner[row] = ni && l2_nsf_source[row] = node
            if: l2_nsf_kind[row] = 2 || l2_nsf_kind[row] = 4 || l2_nsf_kind[row] = 5 || l2_nsf_kind[row] = 6 || (l2_nsf_kind[row] = 12 && l2_nsf_fname[row] = 0)
                match: 1
            ---
        ---
        if: match != 0
            if: found >= 0
                l2_error(l2_src, node, "internal: a source child has two constructor rows")
                return: -2
            found: row
        row: row + 1
    ---
return: found

# A part's root as a Structure of the program (§10): its fields and statements -- the items of its root that
# are neither methods nor source tables -- gathered into a body of their own, taken as a named Structure's
# body is (l2_take_ns_body) with no name.  The frame it hangs from is the translator's, with the root's
# place.  Nothing to gather, no entry; in a library, which executes no statements, a part's root may hold
# none, as the source's may not.
fn: l2_part_root (int: k) int
    const: @: LmP0Node rootn
    @: LmP0Field f
    @: LmP0Field copies 0
    @: LmP0Field cp 0
    @: LmP0Field last 0
    @: LmP0Node first 0
    @: LmP0Structure body 0
    @: LmP0Frame frame 0
    @: LmP0NodeAs as 0
    @: LmP0Node node 0
    int: n 0
    int: j 0
    rootn: lm_p0_document_root(l2_part_doc[k])
    if: rootn = 0 || rootn\kind != c.LM_P0_NODE_STRUCTURE || rootn\as = 0 || rootn\as\structure = 0
        return: 0
    f: l2_next_active(rootn\as\structure\first_field)
    while: f != 0
        if: l2_unit_role(f\value) = 0
            if: first = 0
                first: f\value
            n: n + 1
        f: l2_next_active(f\next)
    ---
    if: n = 0
        return: 0
    if: l2_library_mode != 0
        return: l2_error(l2_part_path[k], first, "a library unit executes no statements")
    copies: (cast: (@: LmP0Field) calloc((cast: (size_t) n), c.sizeof(c.LmP0Field)))
    body: (cast: (@: LmP0Structure) calloc(1U, c.sizeof(c.LmP0Structure)))
    frame: (cast: (@: LmP0Frame) calloc(1U, c.sizeof(c.LmP0Frame)))
    as: (cast: (@: LmP0NodeAs) calloc(1U, c.sizeof(c.LmP0NodeAs)))
    node: (cast: (@: LmP0Node) calloc(1U, c.sizeof(c.LmP0Node)))
    if: copies = 0 || body = 0 || frame = 0 || as = 0 || node = 0
        return: l2_error(l2_part_path[k], first, "out of memory")
    f: l2_next_active(rootn\as\structure\first_field)
    while: f != 0
        if: l2_unit_role(f\value) = 0
            cp: copies + j
            cp\value: f\value
            if: last != 0
                last\next: cp
            last: cp
            j: j + 1
        ---
        f: l2_next_active(f\next)
    ---
    body\first_field: copies
    body\last_field: copies + (n - 1)
    body\field_count: (cast: (size_t) n)
    frame\body: body
    as\frame: frame
    node\kind: c.LM_P0_NODE_FRAME
    node\as: as
    node\span: rootn\span
    l2_part_ns[k]: l2_ns_n
return: l2_take_ns_body(0, 0 - 1, body, node, l2_part_path[k])

# The part whose root is named-Structure entry ni (§10), or -1.
fn: l2_ns_part (int: ni) int
    int: k 0
    while: ni >= 0 && l2_part_ns != 0 && k < l2_part_n
        if: l2_part_ns[k] = ni
            return: k
        k: k + 1
    ---
return: 0 - 1

# The unit-level entry that holds entry ni: ni, or the entry its parents lead to.
fn: l2_ns_top (int: ni) int
    int: t ni
    while: t >= 0 && t < l2_ns_n && l2_ns_parent[t] >= 0
        t: l2_ns_parent[t]
    ---
return: t

# The program part whose code method mi is, or -1: a method a part gave (l2_m_part), or the procedure of a
# part's root (§10).
fn: l2_m_file (int: mi) int
    int: k
    k: l2_m_part(mi)
    if: k < 0
        k: l2_ns_part(l2_m_nsof(mi))
return: k

# Code origin is distinct from row classification and physical NODE ancestry.
# Local definitions keep their namespace parents before their local host;
# nested methods keep their source host. This projection is valid before
# source PLACE and introduces no runtime graph or name lookup.
fn: l2_m_code_file (int: mi) int
    int: k
    int: ni
    int: steps 0
    while: mi >= 0 && mi < l2_m_n && steps <= l2_m_n
        k: l2_m_file(mi)
        if: k >= 0
            return: k
        ni: l2_m_nsof(mi)
        if: ni >= 0
            ni: l2_ns_top(ni)
            k: l2_ns_part(ni)
            if: k >= 0
                return: k
            mi: l2_ns_local[ni]
            ---
        else:
            mi: l2_mad_host_of(mi)
            ---
        steps: steps + 1
return: -1

# The lexical parent of method mi's occurrence, as the builder names it: the unit, or for a method of a program
# part whose root is built, that root (§10).
fn: l2_m_lexparent (int: mi) const: @: char
    int: k
    k: l2_m_part(mi)
    if: k >= 0 && l2_part_ns[k] >= 0
        c.snprintf(l2_lexp_buf, 32U, "l2_nsp[%d]", l2_part_ns[k])
        return: l2_lexp_buf
return: "l2_entry_unit"

fn: l2_translate_unit (const: @(LmP0Structure unit); const: @(char path)) int
    @: LmP0Field field
    @: LmP0Node item
    @: LmP0Field ef
    @: LmP0Node first_stmt 0
    int: role
    int: i
    int: en 0
    l2_library_mode: l2_library_flag
    # A unit may be translated twice (Q33, l2_translate): every registry of the
    # unit starts empty, as in the first translation.
    l2_ns_n: 0
    l2_nsf_n: 0
    l2_nsty_n: 0
    l2_ebr_n: 0
    l2_mres_n: 0
    l2_addr_own_n: 0
    l2_mrs_n: 0
    l2_msrc_n: 0
    l2_bound_free()
    l2_cf_n: 0
    l2_cfl_n: 0
    l2_cfr_n: 0
    l2_dyr_n: 0
    l2_dyc_n: 0
    l2_dyp_n: 0
    l2_dyk_n: 0
    l2_anc_n: 0
    l2_anc_on: 0
    l2_lp_n: 0
    l2_pad_n: 0
    l2_pad_seq: 0
    l2_bseq_n: 0
    l2_letter_model_n: 0
    l2_m_n: 0
    l2_own_n: 0
    l2_own_free()
    l2_ruse_reset()
    l2_ruse_unit: unit
    l2_hres_reset()
    l2_application_free()
    l2_loop_depth: 0
    l2_scope_n: 0
    l2_scope_free()
    l2_wait_free()
    l2_indent_free()
    l2_pub_free()
    l2_for_free()
    l2_unit_base: 0
    l2_pd_free()
    l2_def_free()
    l2_inc_free()
    l2_os_node: 0
    l2_intern_n: 0U
    l2_src: path
    l2_cur_unit: 0
    l2_e_free()
    i: 0
    while: i < l2_m_cap
        l2_free_method(i)
        i: i + 1
    l2_meth_free()
    if: unit = 0
        return: l2_error(path, 0, "internal: missing unit")
    l2_cur_unit: unit
    if: unit\trailer != 0
        return: l2_error(path, 0, "unsupported trailer")
    # Directives establish the C/predef type vocabulary before anything else is
    # classified.
    field: l2_next_active(unit\first_field)
    while: field != 0
        item: field\value
        # K03 S5: a directive written bare is its application with no argument: its taker says what it lacks.
        if: l2_text_eq(l2_app_head(item), "predef") != 0 && l2_take_predef(item, path) != 0
            return: 1
        if: l2_text_eq(l2_app_head(item), "define") != 0 && l2_take_define(item, path) != 0
            return: 1
        if: l2_text_eq(l2_app_head(item), "include") != 0 && l2_take_include(item, path) != 0
            return: 1
        if: l2_text_eq(l2_app_head(item), "profile") != 0 && l2_take_profile(item, path) != 0
            return: 1
        field: l2_next_active(field\next)
    ---
    # ONE LEXICAL PASS in source order. Methods, named Structures, qualified
    # branches and the os block are declared where they stand, so whatever a
    # signature names must stand above it; every other item is a statement of
    # the entry E, kept in order. The first pass only counts E's statements.
    field: l2_next_active(unit\first_field)
    while: field != 0
        if: l2_unit_role(field\value) = 0
            l2_e_n: l2_e_n + 1
        field: l2_next_active(field\next)
    ---
    if: l2_e_n > 0
        l2_alloc_kind: 1
        if: l2_mul_ok((cast: (size_t) l2_e_n), c.sizeof(c.LmP0Field)) = 0
            l2_alloc_err: 2
            return: l2_error(path, 0, "size overflow")
        l2_e_fields: (cast: (@: LmP0Field) l2_xmalloc((cast: (size_t) l2_e_n) * c.sizeof(c.LmP0Field)))
        if: l2_e_fields = 0
            return: l2_error(path, 0, "out of memory")
        memset((cast: (@: void) l2_e_fields), 0, (cast: (size_t) l2_e_n) * c.sizeof(c.LmP0Field))
    ---
    ef: l2_e_fields
    field: l2_next_active(unit\first_field)
    while: field != 0
        item: field\value
        l2_q_at: item
        l2_q_path: path
        role: l2_unit_role(item)
        if: role = 1 && l2_collect_method(item, path, -1) != 0
            return: 1
        if: role = 2 && l2_take_eternal(item, path) != 0
            return: 1
        if: role = 3
            if: l2_os_node != 0
                return: l2_error(path, item, "unsupported body")
            if: l2_check_os(item, path) != 0
                return: 1
            l2_os_node: item
            if: l2_collect_os_methods(item, path) != 0
                return: 1
        ---
        if: role = 5 && l2_take_named(item, path) != 0
            return: 1
        if: role = 0
            # The count walk above sized E's statements; a walk that classifies more (the two disagreeing) would
            # write past them.
            if: en >= l2_e_n || l2_e_fields = 0
                return: l2_error(path, item, "internal: the unit's statements changed between the lexical pass's walks")
            en: en + 1
            if: first_stmt = 0
                first_stmt: item
            ef\value: item
            ef\next: 0
            if: ef != l2_e_fields + (l2_e_n - 1)
                ef\next: ef + 1
            ef: ef + 1
        ---
        field: l2_next_active(field\next)
    ---
    # The program's parts (§8, Q46): a part's methods are the program's, found by name as the source's are (a
    # conversion's receiver among them); its source tables were built at the start and are inactive.  §10: the
    # rest of its root -- its fields and statements -- is a Structure of the program with no name
    # (l2_part_root): its fields built with their initializers, its statements the body of its procedure,
    # which nothing executes; it is the lexical parent of the part's methods.  A part is read as the source
    # is, each item against its own root (l2_cur_unit: a method named there, a field declared there).  A named
    # Structure, a qualified branch, the os block, a directive at a part's root wait (l2_part_refused).
    i: 0
    while: i < l2_part_n
        l2_part_class: 1
        l2_part_m0[i]: l2_m_n
        l2_part_m1[i]: c.INT_MAX
        l2_part_ns[i]: 0 - 1
        field: 0
        if: lm_p0_document_root(l2_part_doc[i]) != 0 && lm_p0_document_root(l2_part_doc[i])\kind = c.LM_P0_NODE_STRUCTURE && lm_p0_document_root(l2_part_doc[i])\as != 0
            l2_cur_unit: lm_p0_document_root(l2_part_doc[i])\as\structure
            field: l2_next_active(l2_cur_unit\first_field)
        while: field != 0
            item: field\value
            l2_q_at: item
            l2_q_path: l2_part_path[i]
            role: l2_unit_role(item)
            if: role != 0 && role != 1
                l2_part_class: 0
                return: l2_part_refused(l2_part_path[i], item, role)
            if: role = 1 && l2_collect_method(item, l2_part_path[i], -1) != 0
                return: 1
            field: l2_next_active(field\next)
        l2_part_m1[i]: l2_m_n
        if: l2_part_root(i) != 0
            l2_part_class: 0
            return: 1
        l2_part_class: 0
        l2_cur_unit: unit
        i: i + 1
    ---
    if: l2_ns_resolve_refs(path, first_stmt) != 0
        return: 1
    # The library profile is methods only: nothing would ever execute a
    # statement, so one is refused rather than dropped.
    if: l2_library_mode != 0 && first_stmt != 0
        return: l2_error(path, first_stmt, "a library unit executes no statements")
    if: l2_library_mode != 0 && l2_m_n = 0
        return: l2_error(path, 0, "a library unit declares no method")
    # steps/named-struct-exec.md §12: the named Structures that are procedures are methods, registered
    # before the entry E, the last method (l2_occ_n).
    if: l2_library_mode = 0 && l2_ns_procs(path) != 0
        return: 1
    if: l2_library_mode = 0 && l2_make_entry(path) != 0
        return: 1
    l2_m_value_used: (cast: (@: int) calloc((cast: (size_t) l2_m_n), c.sizeof(c.int)))
    if: l2_m_value_used = 0
        return: l2_error(path, first_stmt, "out of memory")
    if: l2_library_mode != 0
        return: l2_parse_library(path)
return: l2_parse_unit(path)

fn: l2_parse_library (const: @(char path)) int
    int: i 0
    if: l2_bind_calls(path) != 0
        return: 1
    while: i < l2_m_n
        if: l2_m_body[i] != 0 && l2_m_body[i]\as != 0 && l2_merge_scan(l2_m_body[i]\as\structure, i) != 0
            return: 1
        i: i + 1
    i: 0
    if: l2_dyn_local(path) != 0
        return: 1
    l2_m_throws: (cast: (@: int) calloc((cast: (size_t) (l2_m_n + 1)), c.sizeof(c.int)))
    if: l2_m_throws = 0
        return: l2_error(path, 0, "out of memory")
    l2_d105_reset()
    while: i < l2_m_n
        if: l2_m_body[i] != 0 && l2_m_body[i]\as != 0
            l2_m_throws[i]: l2_body_throws(l2_m_body[i]\as\structure, i)
        i: i + 1
    ---
    i: 0
    while: i < l2_m_n
        if: l2_m_body[i] != 0 && l2_m_body[i]\as != 0 && l2_ml_rebuild(l2_m_body[i]\as\structure, i, path) != 0
            return: 1
        l2_cur_mi: i
        if: l2_m_body[i] != 0 && l2_m_body[i]\as != 0 && l2_check_body(l2_m_body[i]\as\structure, i, l2_method_src(i, path), 0) != 0
            return: 1
        if: l2_check_ret_tr(i, l2_method_src(i, path), l2_ret_tr(l2_callable_source_frame(i)), l2_callable_source_node(i)) != 0
            return: 1
        i: i + 1
    l2_cur_mi: 0 - 1
    if: l2_throws_close() != 0
        return: 1
    if: l2_dyn_close(path) != 0
        return: 1
    # steps/free-names.md M2/M3: the checks that waited for the dynamic inputs' types run now.
    if: l2_wait_run(path) != 0
        return: 1
    if: l2_copy_calls_verify(path) != 0
        return: 1
    if: l2_collect_asgn_binds(path) != 0
        return: 1
    i: 0
    while: i < l2_m_n
        if: l2_text_eq(l2_m_name[i], "l2_program_entry") || l2_text_eq(l2_m_name[i], "l2_program_build") || l2_text_eq(l2_m_name[i], "l2_program_thread") || l2_text_eq(l2_m_name[i], "l2_program_unit") || l2_text_eq(l2_m_name[i], "l2_program_graph") || l2_text_eq(l2_m_name[i], "l2_program_qualified_roots") || l2_text_eq(l2_m_name[i], "l2_program_qualified_count") || l2_text_eq(l2_m_name[i], "l2_program_qualified_at") || l2_text_eq(l2_m_name[i], "l2_library_open") || l2_text_eq(l2_m_name[i], "l2_library_runtime") || l2_text_eq(l2_m_name[i], "l2_library_root") || l2_text_eq(l2_m_name[i], "l2_library_opened") || l2_text_eq(l2_m_name[i], "l2_library_message") || l2_text_eq(l2_m_name[i], "l2_library_unit")
            return: l2_error(path, l2_m_node[i], "reserved library symbol")
        if: l2_m_dyn[i] != 0 || l2_m_throws[i] != 0
            return: l2_error(path, l2_m_node[i], "unsupported library ABI")
        l2_m_sig[i]: l2_intern_mi(i)
        if: l2_m_sig[i] = 0U && l2_alloc_err = 2
            return: l2_error(path, l2_m_node[i], "size overflow")
        if: l2_m_sig[i] = 0U
            return: l2_error(path, l2_m_node[i], "out of memory")
        i: i + 1
    if: l2_intern_prove(path, l2_m_node[0]) != 0
        return: 1
return: 0

fn: l2_translate (const: @(char in_path); const: @(char out_path)) int
    @: LmP0Document document 0
    const: @: LmP0Diagnostic diagnostic
    const: @: LmP0Node root
    @: LmP0Structure unit 0
    int: status
    size_t: path_i 0U
    L2Tx: tok_root
    int: d_emit 0
    finally:
        # Drop compiler-owned shells while their borrowed source is still live:
        # the procedures' bodies, then the binding's projections.
        l2_ns_procs_free()
        l2_bound_free()
        lm_p0_document_destroy(document)
        l2_tok: 0
    l2_tok: @ tok_root
    if: l2_tx_open(l2_tok, l2_tok_own, 1024U) != 0
        return: 1
    if: l2_path_is_lm2(in_path) = 0
        c.fprintf(l1_stderr(), "l2trans error: %s:1:1: expected a .lm2 source\n", in_path)
        return: 1
    l2_module_hash_a: 2166136261U
    l2_module_hash_b: 5381U
    while: in_path[path_i] != 0
        l2_module_hash_a: l2_module_hash_a * 16777619U + (cast: (unsigned) (cast: (uchar) in_path[path_i]))
        l2_module_hash_b: l2_module_hash_b * 65599U + (cast: (unsigned) (cast: (uchar) in_path[path_i])) + 1U
        path_i: path_i + 1U
    ---
    status: lm_p0_parse_file(in_path, @ document)
    if: status != 0
        diagnostic: lm_p0_document_diagnostic(document)
        if: diagnostic != 0
            c.fprintf(l1_stderr(), "l2trans parse error %d at %zu:%zu: %s\n", diagnostic\code, diagnostic\line, diagnostic\column, diagnostic\message)
            # A located P0 parse diagnostic already told the user what and
            # where; main's own no-located-diagnostic safety net (FABLE-
            # SONNET-EMPTY-STRUCT-20260923-132) only knows about l2_error's
            # OWN counter, so without this it fires a second, useless line
            # for every P0-level parse refusal (e.g. a hanging `f:`, P0
            # error 32) -- the same silent-diagnostic class closed for
            # l2_error call sites in -129 part 1, here for the parser's.
            l2_diag_n: l2_diag_n + 1
        else:
            # P0 failed without a diagnostic: the file could not be opened, read or held (P50, REVIEW
            # ee58ce4).  This line is the refusal, so it counts: the guard in main must not re-say it as
            # "internal: a refusal said nothing".
            c.fprintf(l1_stderr(), "l2trans parse error: %s: cannot read the source\n", in_path)
            l2_diag_n: l2_diag_n + 1
        return: 1
    # The program (steps/table-receiver.md §8, Q46): the source and the files named after it at the call.
    # Their source tables -- a `table:` with `source` first, wherever it stands in any of them -- are built
    # now, before anything is translated; a question of the translator asks them by name when it comes.
    root: lm_p0_document_root(document)
    if: l2_program_tables(root, in_path) != 0 || l2_parts_read() != 0
        return: 1
    if: l2_unit_from_root(root, in_path, @ unit) != 0
        return: 1
    if: l2_translate_unit(unit, in_path) != 0
        return: 1
    # A conversion's receiver is a method of the program from the start (Q33; §8): one translation, where a
    # receiver an edge noted was once taken by translating the source again.
    # A failed allocation the emission has said where it stood is not said again here (ALLOC-FAILURE-SAID-TWICE):
    # only what the emission left unsaid since it began.
    d_emit: l2_diag_n
    status: l2_emit_unit(out_path)
    if: status != 0
        if: l2_alloc_err != 0
            return: l2_said_or(in_path, 0, d_emit, "translation failed")
        return: 1
return: 0

fn: l2_ident_word (const: @(LmP0Text t)) int
    size_t: i
    unsigned: ch
    if: t = 0 || t\data = 0 || t\length = 0U
        return: 0
    ch: (cast: (unsigned) t\data[0])
    if: ch != 95U && (ch < 65U || ch > 90U) && (ch < 97U || ch > 122U)
        return: 0
    i: 1U
    while: i < t\length
        ch: (cast: (unsigned) t\data[i])
        if: ch != 95U && (ch < 65U || ch > 90U) && (ch < 97U || ch > 122U) && (ch < 48U || ch > 57U)
            return: 0
        i: i + 1U
return: 1

fn: l2_ident (const: @(LmP0Text t)) int
    if: l2_ident_word(t) = 0
        return: 0
    if: l2_text_eq(t, "fn") || l2_text_eq(t, "int") || l2_text_eq(t, "return") || l2_text_eq(t, "if") || l2_text_eq(t, "else") || l2_text_eq(t, "while") || l2_text_eq(t, "for") || l2_text_eq(t, "node")
        return: 0
return: 1

fn: l2_text_same (const: @(LmP0Text a); const: @(LmP0Text b)) int
    if: a = 0 || b = 0 || a\data = 0 || b\data = 0
        return: 0
    if: a\length != b\length
        return: 0
return: memcmp(a\data, b\data, a\length) = 0

# Translator intern of the full canonical contract: L2_SIG_V0 schema
# plus exact ordered formal-name bytes (declared cap 8, hidden cap 4). Method name is not interned.
# One table for the linked unit; not reset per method.
fn: l2_intern_reserve (unsigned: need) int
    size_t: cap
    size_t: need_u
    size_t: nbp
    size_t: nbi
    size_t: psz
    unsigned: i
    @: int nar 0
    @: int ndyn 0
    @: int nret 0
    @: int nthrows 0
    @: int ntmi 0
    @@: char nn 0
    @@: size_t nnl 0
    @@: int nty 0
    @@: char nhn 0
    @@: size_t nhnl 0
    @@: int nhty 0
    if: need <= l2_intern_cap
        return: 0
    need_u: (cast: (size_t) need)
    cap: (cast: (size_t) l2_intern_cap)
    if: cap < 1U
        cap: 4U
    while: cap < need_u
        if: cap > ((cast: (size_t) -1) / 2U)
            l2_alloc_err: 2
            return: 1
        cap: cap * 2U
    if: cap > (cast: (size_t) (cast: (unsigned) -1))
        cap: need_u
    psz: c.sizeof(@: char)
    if: l2_mul_ok(cap, psz) = 0 || l2_mul_ok(cap, c.sizeof(c.int)) = 0
        l2_alloc_err: 2
        return: 1
    nbp: cap * psz
    nbi: cap * c.sizeof(c.int)
    l2_alloc_kind: 7
    nar: (cast: (@: int) l2_xmalloc(nbi))
    ndyn: (cast: (@: int) l2_xmalloc(nbi))
    nret: (cast: (@: int) l2_xmalloc(nbi))
    nthrows: (cast: (@: int) l2_xmalloc(nbi))
    ntmi: (cast: (@: int) l2_xmalloc(nbi))
    nn: (cast: (@@: char) l2_xmalloc(nbp))
    nnl: (cast: (@@: size_t) l2_xmalloc(nbp))
    nty: (cast: (@@: int) l2_xmalloc(nbp))
    nhn: (cast: (@@: char) l2_xmalloc(nbp))
    nhnl: (cast: (@@: size_t) l2_xmalloc(nbp))
    nhty: (cast: (@@: int) l2_xmalloc(nbp))
    if: nar = 0 || ndyn = 0 || nret = 0 || nthrows = 0 || ntmi = 0 || nn = 0 || nnl = 0 || nty = 0 || nhn = 0 || nhnl = 0 || nhty = 0
        if: nar != 0
            l2_xfree((cast: (@: void) nar))
        if: ndyn != 0
            l2_xfree((cast: (@: void) ndyn))
        if: nret != 0
            l2_xfree((cast: (@: void) nret))
        if: nthrows != 0
            l2_xfree((cast: (@: void) nthrows))
        if: ntmi != 0
            l2_xfree((cast: (@: void) ntmi))
        if: nn != 0
            l2_xfree((cast: (@: void) nn))
        if: nnl != 0
            l2_xfree((cast: (@: void) nnl))
        if: nty != 0
            l2_xfree((cast: (@: void) nty))
        if: nhn != 0
            l2_xfree((cast: (@: void) nhn))
        if: nhnl != 0
            l2_xfree((cast: (@: void) nhnl))
        if: nhty != 0
            l2_xfree((cast: (@: void) nhty))
        return: 1
    memset((cast: (@: void) nar), 0, nbi)
    memset((cast: (@: void) ndyn), 0, nbi)
    memset((cast: (@: void) nret), 0, nbi)
    memset((cast: (@: void) nthrows), 0, nbi)
    memset((cast: (@: void) ntmi), 0, nbi)
    memset((cast: (@: void) nn), 0, nbp)
    memset((cast: (@: void) nnl), 0, nbp)
    memset((cast: (@: void) nty), 0, nbp)
    memset((cast: (@: void) nhn), 0, nbp)
    memset((cast: (@: void) nhnl), 0, nbp)
    memset((cast: (@: void) nhty), 0, nbp)
    i: 0U
    while: i < l2_intern_n
        nar[i]: l2_it_ar[i]
        ndyn[i]: l2_it_dyn[i]
        nret[i]: l2_it_ret[i]
        nthrows[i]: l2_it_throws[i]
        ntmi[i]: l2_it_tmi[i]
        nn[i]: l2_it_n[i]
        nnl[i]: l2_it_nl[i]
        nty[i]: l2_it_ty[i]
        nhn[i]: l2_it_hn[i]
        nhnl[i]: l2_it_hnl[i]
        nhty[i]: l2_it_hty[i]
        i: i + 1U
    if: l2_it_ar != 0
        l2_xfree((cast: (@: void) l2_it_ar))
    if: l2_it_dyn != 0
        l2_xfree((cast: (@: void) l2_it_dyn))
    if: l2_it_ret != 0
        l2_xfree((cast: (@: void) l2_it_ret))
    if: l2_it_throws != 0
        l2_xfree((cast: (@: void) l2_it_throws))
    if: l2_it_tmi != 0
        l2_xfree((cast: (@: void) l2_it_tmi))
    if: l2_it_n != 0
        l2_xfree((cast: (@: void) l2_it_n))
    if: l2_it_nl != 0
        l2_xfree((cast: (@: void) l2_it_nl))
    if: l2_it_ty != 0
        l2_xfree((cast: (@: void) l2_it_ty))
    if: l2_it_hn != 0
        l2_xfree((cast: (@: void) l2_it_hn))
    if: l2_it_hnl != 0
        l2_xfree((cast: (@: void) l2_it_hnl))
    if: l2_it_hty != 0
        l2_xfree((cast: (@: void) l2_it_hty))
    l2_it_ar: nar
    l2_it_dyn: ndyn
    l2_it_ret: nret
    l2_it_throws: nthrows
    l2_it_tmi: ntmi
    l2_it_n: nn
    l2_it_nl: nnl
    l2_it_ty: nty
    l2_it_hn: nhn
    l2_it_hnl: nhnl
    l2_it_hty: nhty
    l2_intern_cap: (cast: (unsigned) cap)
return: 0

fn: l2_intern_match (unsigned: s; int: ar; const: @(char n0); size_t: l0; int: t0; const: @(char n1); size_t: l1; int: t1; const: @(char n2); size_t: l2n; int: t2; const: @(char n3); size_t: l3; int: t3) int
    @@: char ns
    @: size_t nl
    @: int nt
    # The proof helper stores the ordinary int-return/no-throw contract.
    if: s >= l2_intern_n || l2_it_ar[s] != ar || l2_it_dyn[s] != 0 || l2_it_ret[s] != 0 || l2_it_throws[s] != 0
        return: 0
    ns: (cast: (@@: char) l2_it_n[s])
    nl: l2_it_nl[s]
    nt: l2_it_ty[s]
    if: ar >= 1 && (ns = 0 || nl = 0 || nt = 0 || t0 != nt[0] || l0 != nl[0] || memcmp(n0, ns[0], l0) != 0)
        return: 0
    if: ar >= 2 && (t1 != nt[1] || l1 != nl[1] || memcmp(n1, ns[1], l1) != 0)
        return: 0
    if: ar >= 3 && (t2 != nt[2] || l2n != nl[2] || memcmp(n2, ns[2], l2n) != 0)
        return: 0
    if: ar >= 4 && (t3 != nt[3] || l3 != nl[3] || memcmp(n3, ns[3], l3) != 0)
        return: 0
return: 1

fn: l2_intern_store (int: ar; const: @(char n0); size_t: l0; int: t0; const: @(char n1); size_t: l1; int: t1; const: @(char n2); size_t: l2n; int: t2; const: @(char n3); size_t: l3; int: t3) unsigned
    unsigned: i 0U
    unsigned: s
    size_t: psz
    @@: char ns 0
    @: size_t nl 0
    @: int nt 0
    while: i < l2_intern_n
        if: l2_intern_match(i, ar, n0, l0, t0, n1, l1, t1, n2, l2n, t2, n3, l3, t3)
            return: i + 1U
        i: i + 1U
    if: ar < 1 || ar > 4
        return: 0U
    if: l2_intern_n = (cast: (unsigned) -1)
        l2_alloc_err: 2
        return: 0U
    if: l2_intern_reserve(l2_intern_n + 1U) != 0
        return: 0U
    psz: c.sizeof(@: char)
    if: l2_mul_ok((cast: (size_t) ar), psz) = 0 || l2_mul_ok((cast: (size_t) ar), c.sizeof(c.size_t)) = 0 || l2_mul_ok((cast: (size_t) ar), c.sizeof(c.int)) = 0
        l2_alloc_err: 2
        return: 0U
    l2_alloc_kind: 3
    ns: (cast: (@@: char) l2_xmalloc((cast: (size_t) ar) * psz))
    nl: (cast: (@: size_t) l2_xmalloc((cast: (size_t) ar) * c.sizeof(c.size_t)))
    nt: (cast: (@: int) l2_xmalloc((cast: (size_t) ar) * c.sizeof(c.int)))
    if: ns = 0 || nl = 0 || nt = 0
        if: ns != 0
            l2_xfree((cast: (@: void) ns))
        if: nl != 0
            l2_xfree((cast: (@: void) nl))
        if: nt != 0
            l2_xfree((cast: (@: void) nt))
        return: 0U
    if: ar >= 1
        ns[0]: (cast: (@: char) n0)
        nl[0]: l0
        nt[0]: t0
    if: ar >= 2
        ns[1]: (cast: (@: char) n1)
        nl[1]: l1
        nt[1]: t1
    if: ar >= 3
        ns[2]: (cast: (@: char) n2)
        nl[2]: l2n
        nt[2]: t2
    if: ar >= 4
        ns[3]: (cast: (@: char) n3)
        nl[3]: l3
        nt[3]: t3
    s: l2_intern_n
    l2_it_ar[s]: ar
    l2_it_dyn[s]: 0
    l2_it_ret[s]: 0
    l2_it_throws[s]: 0
    l2_it_tmi[s]: 0 - 1
    l2_it_n[s]: (cast: (@: char) ns)
    l2_it_nl[s]: nl
    l2_it_ty[s]: nt
    l2_it_hn[s]: 0
    l2_it_hnl[s]: 0
    l2_it_hty[s]: 0
    l2_intern_n: l2_intern_n + 1U
return: l2_intern_n

fn: l2_intern_pair (const: @(char a); size_t: na; const: @(char b); size_t: nb) unsigned
return: l2_intern_store(2, a, na, 0, b, nb, 0, 0, 0U, 0, 0, 0U, 0)

fn: l2_intern_eq_mi (unsigned: s; int: mi) int
    int: k
    @: LmP0Text nm
    @@: char ns
    @: size_t nl
    @: int nt
    @@: char hs
    @: size_t hl
    @: int ht
    if: s >= l2_intern_n || mi < 0
        return: 0
    if: l2_it_ar[s] != l2_m_arity[mi] || l2_it_dyn[s] != l2_m_dyn[mi] || l2_it_ret[s] != l2_m_ret[mi] || l2_it_throws[s] != l2_m_throws[mi]
        return: 0
    if: l2_throws_same(l2_it_tmi[s], mi) = 0
        return: 0
    ns: (cast: (@@: char) l2_it_n[s])
    nl: l2_it_nl[s]
    nt: l2_it_ty[s]
    hs: (cast: (@@: char) l2_it_hn[s])
    hl: l2_it_hnl[s]
    ht: l2_it_hty[s]
    k: 0
    while: k < l2_m_arity[mi]
        nm: l2_fn(mi, k)
        if: nm = 0 || nm\data = 0 || ns = 0 || nl = 0 || nt = 0
            return: 0
        if: l2_ft(mi, k) != nt[k]
            return: 0
        if: nm\length != nl[k] || memcmp(nm\data, ns[k], nl[k]) != 0
            return: 0
        k: k + 1
    k: 0
    while: k < l2_m_dyn[mi]
        nm: l2_dn(mi, k)
        if: nm = 0 || nm\data = 0 || hs = 0 || hl = 0 || ht = 0
            return: 0
        if: l2_dt(mi, k) != ht[k]
            return: 0
        if: nm\length != hl[k] || memcmp(nm\data, hs[k], hl[k]) != 0
            return: 0
        k: k + 1
return: 1

fn: l2_intern_store_mi (int: mi) unsigned
    unsigned: i 0U
    unsigned: s
    int: k
    int: ar
    int: dyn
    size_t: psz
    @: LmP0Text nm
    @@: char ns 0
    @: size_t nl 0
    @: int nt 0
    @@: char hs 0
    @: size_t hl 0
    @: int ht 0
    while: i < l2_intern_n
        if: l2_intern_eq_mi(i, mi)
            return: i + 1U
        i: i + 1U
    if: l2_intern_n = (cast: (unsigned) -1)
        l2_alloc_err: 2
        return: 0U
    if: l2_intern_reserve(l2_intern_n + 1U) != 0
        return: 0U
    ar: l2_m_arity[mi]
    dyn: l2_m_dyn[mi]
    psz: c.sizeof(@: char)
    s: l2_intern_n
    l2_it_n[s]: 0
    l2_it_nl[s]: 0
    l2_it_ty[s]: 0
    l2_it_hn[s]: 0
    l2_it_hnl[s]: 0
    l2_it_hty[s]: 0
    if: ar > 0
        if: l2_mul_ok((cast: (size_t) ar), psz) = 0 || l2_mul_ok((cast: (size_t) ar), c.sizeof(c.size_t)) = 0 || l2_mul_ok((cast: (size_t) ar), c.sizeof(c.int)) = 0
            l2_alloc_err: 2
            return: 0U
        l2_alloc_kind: 3
        ns: (cast: (@@: char) l2_xmalloc((cast: (size_t) ar) * psz))
        nl: (cast: (@: size_t) l2_xmalloc((cast: (size_t) ar) * c.sizeof(c.size_t)))
        nt: (cast: (@: int) l2_xmalloc((cast: (size_t) ar) * c.sizeof(c.int)))
        if: ns = 0 || nl = 0 || nt = 0
            if: ns != 0
                l2_xfree((cast: (@: void) ns))
            if: nl != 0
                l2_xfree((cast: (@: void) nl))
            if: nt != 0
                l2_xfree((cast: (@: void) nt))
            return: 0U
        k: 0
        while: k < ar
            nm: l2_fn(mi, k)
            if: nm = 0 || nm\data = 0
                l2_xfree((cast: (@: void) ns))
                l2_xfree((cast: (@: void) nl))
                l2_xfree((cast: (@: void) nt))
                return: 0U
            ns[k]: (cast: (@: char) nm\data)
            nl[k]: nm\length
            nt[k]: l2_ft(mi, k)
            k: k + 1
        ---
    if: dyn > 0
        if: l2_mul_ok((cast: (size_t) dyn), psz) = 0 || l2_mul_ok((cast: (size_t) dyn), c.sizeof(c.size_t)) = 0 || l2_mul_ok((cast: (size_t) dyn), c.sizeof(c.int)) = 0
            l2_alloc_err: 2
            if: ns != 0
                l2_xfree((cast: (@: void) ns))
            if: nl != 0
                l2_xfree((cast: (@: void) nl))
            if: nt != 0
                l2_xfree((cast: (@: void) nt))
            return: 0U
        l2_alloc_kind: 3
        hs: (cast: (@@: char) l2_xmalloc((cast: (size_t) dyn) * psz))
        hl: (cast: (@: size_t) l2_xmalloc((cast: (size_t) dyn) * c.sizeof(c.size_t)))
        ht: (cast: (@: int) l2_xmalloc((cast: (size_t) dyn) * c.sizeof(c.int)))
        if: hs = 0 || hl = 0 || ht = 0
            if: ns != 0
                l2_xfree((cast: (@: void) ns))
            if: nl != 0
                l2_xfree((cast: (@: void) nl))
            if: nt != 0
                l2_xfree((cast: (@: void) nt))
            if: hs != 0
                l2_xfree((cast: (@: void) hs))
            if: hl != 0
                l2_xfree((cast: (@: void) hl))
            if: ht != 0
                l2_xfree((cast: (@: void) ht))
            return: 0U
        k: 0
        while: k < dyn
            nm: l2_dn(mi, k)
            if: nm = 0 || nm\data = 0
                l2_xfree((cast: (@: void) ns))
                l2_xfree((cast: (@: void) nl))
                l2_xfree((cast: (@: void) nt))
                l2_xfree((cast: (@: void) hs))
                l2_xfree((cast: (@: void) hl))
                l2_xfree((cast: (@: void) ht))
                return: 0U
            hs[k]: (cast: (@: char) nm\data)
            hl[k]: nm\length
            ht[k]: l2_dt(mi, k)
            k: k + 1
        ---
    l2_it_ar[s]: ar
    l2_it_dyn[s]: dyn
    l2_it_ret[s]: l2_m_ret[mi]
    l2_it_throws[s]: l2_m_throws[mi]
    l2_it_tmi[s]: mi
    l2_it_n[s]: (cast: (@: char) ns)
    l2_it_nl[s]: nl
    l2_it_ty[s]: nt
    l2_it_hn[s]: (cast: (@: char) hs)
    l2_it_hnl[s]: hl
    l2_it_hty[s]: ht
    l2_intern_n: l2_intern_n + 1U
return: l2_intern_n

fn: l2_intern_mi (int: mi) unsigned
    if: mi < 0
        return: 0U
return: l2_intern_store_mi(mi)

fn: l2_find_method (const: @(LmP0Text name)) int
    int: i 0
    while: i < l2_m_n
        if: l2_text_same(l2_m_name[i], name)
            return: i
        i: i + 1
return: -1

fn: l2_own_find (int: mi; const: @(LmP0Text t)) int
    int: i 0
    if: t = 0
        return: -1
    while: i < l2_own_n
        if: l2_own_mi[i] = mi && l2_text_same(l2_own_name[i], t) && l2_own_host[i] = 0
            return: i
        if: l2_own_mi[i] = mi && l2_text_same(l2_own_name[i], t) && l2_scope_has(l2_own_host[i])
            return: i
        i: i + 1
    ---
    # A unit field is an own field of the entry E, whose occurrence is the unit:
    # visible through the callable's node chain from below its declaration.
    # Prefer a method/body occurrence above; only then fall back to it.
    i: 0
    while: i < l2_own_n
        if: l2_own_unit_seen(i, mi) != 0 && l2_text_same(l2_own_name[i], t)
            return: i
        i: i + 1
return: -1

# The own row collected from this exact source statement, or -1.
fn: l2_own_find_decl (int: mi; const: @(LmP0Text t); const: @(LmP0Node at)) int
    int: i 0
    if: t = 0 || at = 0
        return: -1
    while: i < l2_own_n
        if: l2_own_decl[i] = at && l2_text_same(l2_own_name[i], t)
            if: l2_own_mi[i] = mi
                return: i
        ---
        i: i + 1
return: -1

# Source order is independent of the reservation order of own rows. A row
# index remains a storage identity; it is never a declaration ordinal.
fn: l2_own_source_after (int: row; int: previous) int
    const: @(LmP0Node source) l2_head_source_node(l2_own_decl[row])
    const: @(LmP0Node before) 0
    if: previous < 0
        return: 1
    before: l2_head_source_node(l2_own_decl[previous])
    if: source != 0 && source\span != 0 && before != 0 && before\span != 0 && source\span\offset != before\span\offset
        return: source\span\offset > before\span\offset
    # Generated/no-span bindings retain their stable existing identity order.
return: row > previous

# Bare binding preference is distinct from source occurrence numbering.
# Prefer the nearest active body, then the latest declaration in that body.
fn: l2_own_binding_after (int: row; int: previous) int
    int: i 0
    int: row_depth 0
    int: previous_depth 0
    if: previous < 0
        return: 1
    while: i < l2_scope_n
        if: l2_own_host[row] = l2_scope_at[i]
            row_depth: i + 1
        if: l2_own_host[previous] = l2_scope_at[i]
            previous_depth: i + 1
        i: i + 1
    if: row_depth != previous_depth
        return: row_depth > previous_depth
return: l2_own_source_after(row, previous)

# Offsets of a borrowed body and its target source are not comparable.
# Visibility keeps the existing source-method boundary; ranking compares
# declarations of the selected owner, not the position of a different file.
fn: l2_own_source_visible (int: row; int: mi; const: @(LmP0Node at)) int
    const: @(LmP0Node source) l2_head_source_node(l2_own_decl[row])
    at: l2_head_source_node(at)
return: at = 0 || at\span = 0 || (l2_here_mi = mi && l2_here_source_mi != mi) || source = 0 || source\span = 0 || source\span\offset <= at\span\offset

# Lexical occurrence N of a same-name own field in this method, or -1.
fn: l2_own_find_occ (int: mi; const: @(LmP0Text t); int: occ) int
    int: i 0
    int: j
    int: n 0
    if: t = 0 || occ < 0
        return: -1
    while: i < l2_own_n
        if: l2_text_same(l2_own_name[i], t)
            if: l2_own_mi[i] = mi && (l2_own_host[i] = 0 || l2_scope_has(l2_own_host[i]))
                n: 0
                j: 0
                while: j < l2_own_n
                    if: j != i && l2_own_mi[j] = mi && l2_text_same(l2_own_name[j], t) != 0 && (l2_own_host[j] = 0 || l2_scope_has(l2_own_host[j]) != 0) && l2_own_source_after(i, j) != 0
                        n: n + 1
                    j: j + 1
                if: n = occ
                    return: i
            ---
        ---
        i: i + 1
return: -1

# Latest same-name field by source order, retaining this path lookup's scope.
fn: l2_own_find_last (int: mi; const: @(LmP0Text t)) int
    int: i 0
    int: hit -1
    if: t = 0
        return: -1
    while: i < l2_own_n
        if: i != l2_own_excl && l2_text_same(l2_own_name[i], t)
            if: l2_own_mi[i] = mi && (l2_own_host[i] = 0 || l2_scope_has(l2_own_host[i]))
                if: l2_own_binding_after(i, hit) != 0
                    hit: i
        ---
        i: i + 1
    if: hit >= 0
        return: hit
    # A unit field is an own field of the entry E, whose occurrence is the
    # unit: visible through the callable's node chain from below its
    # declaration (FABLE-SONNET-UNIT-FIELD-WRITE-20260923-129, author's
    # backward-visibility norm, 2026-09-22 blog 857692c). l2_own_find already
    # falls back to it this same way; an assignment target needs the same
    # fallback its own-name lookup lacked -- no new mechanism, this function's
    # sibling already has it.
    i: 0
    while: i < l2_own_n
        if: i != l2_own_excl && l2_own_unit_seen(i, mi) != 0 && l2_text_same(l2_own_name[i], t)
            if: l2_own_source_after(i, hit) != 0
                hit: i
        ---
        i: i + 1
return: hit

# Head `\[N]name` — occurrence ordinal, not C `name[i]`. 0 = parsed, 1 = not this form, 2 = bad index.
# The lexical own binding at an explicit source site. Local offsets are only
# compared inside the same method/source part. Unit fallback keeps the method
# header's visibility, not the caller's position. Category is checked later.
fn: l2_own_at (int: mi; const: @(LmP0Text t); const: @(LmP0Node at)) int
    int: i 0
    int: hit -1
    if: t = 0
        return: -1
    while: i < l2_own_n
        if: i != l2_own_excl && l2_own_mi[i] = mi && l2_text_same(l2_own_name[i], t) != 0 && (l2_own_host[i] = 0 || l2_scope_has(l2_own_host[i]) != 0)
            if: l2_own_source_visible(i, mi, at) != 0 && l2_own_binding_after(i, hit) != 0
                hit: i
        ---
        i: i + 1
    if: hit >= 0
        return: hit
    i: 0
    while: i < l2_own_n
        if: i != l2_own_excl && l2_own_unit_seen(i, mi) != 0 && l2_text_same(l2_own_name[i], t) != 0
            if: l2_own_source_after(i, hit) != 0
                hit: i
        ---
        i: i + 1
return: hit

fn: l2_own_visible (int: mi; const: @(LmP0Text t)) int
    if: l2_here_mi = mi
        return: l2_own_at(mi, t, l2_here_node)
return: l2_own_at(mi, t, 0)

# A compiler view of the resolved storage place. It describes the existing
# own row; physical placement and runtime value evidence are separate.
fn: l2_storage_own_place (int: own; @: L2Address out) int
    if: own < 0 || own >= l2_own_n
        return: 1
    out\kind: 1
    out\index: own
    out\descriptor: l2_own_is_slot(own)
    out\model: l2_own_nsty_get(own)
    out\type: l2_ft_of_own(l2_own_ty[own])
    out\target: 0
    out\target_count: 0
    out\immutable: 0
    if: l2_own_is_array(l2_own_ty[own]) != 0
        out\descriptor: 1
        out\model: -1
        out\type: l2_array_desc_ty()
    ---
return: 0

# The defined receiver exposes its output through ordinary source-site
# binding resolution. CHECK, native lowering and the walker share this view;
# an effect analysis must consume it, not inspect receiver spelling itself.
fn: l2_receiver_output_place (const: @(LmP0Node stmt); int: mi; @: L2Address out) int
    @: LmP0Text name 0
    int: status l2_receive_msg_shape(stmt, @ name, 0)
    if: status != 0
        return: status
return: l2_storage_own_place(l2_own_output_at(mi, name, stmt), out)

fn: l2_occ_head (const: @(LmP0Text t); @: int out_occ; @@: LmP0Text out_name) int
    size_t: i 0U
    size_t: n
    unsigned: ch
    int: occ 0
    if: t = 0 || t\data = 0 || out_occ = 0 || out_name = 0
        return: 1
    n: t\length
    if: n < 5U || t\data[0] != 92 || t\data[1] != 91
        return: 1
    i: 2U
    if: i >= n || t\data[i] < 48 || t\data[i] > 57
        return: 2
    while: i < n && t\data[i] >= 48 && t\data[i] <= 57
        ch: (cast: (unsigned) t\data[i]) - 48U
        if: occ > (c.INT_MAX / 10) - (cast: (int) ch)
            return: 2
        occ: occ * 10 + (cast: (int) ch)
        i: i + 1U
    if: i >= n || t\data[i] != 93
        return: 2
    i: i + 1U
    if: i >= n
        return: 2
    \out_name: (cast: (@: LmP0Text) l2_xmalloc(c.sizeof(c.LmP0Text)))
    if: \out_name = 0
        return: 2
    \out_name\data: t\data + i
    \out_name\length: n - i
    \out_occ: occ
return: 0

fn: l2_own_host_at (int: mi; const: @(LmP0Text t); const: @(LmP0Node host); const: @(LmP0Node at)) int
    int: i 0
    int: hit -1
    if: mi < 0 || t = 0
        return: -1
    while: i < l2_own_n
        if: i != l2_own_excl && l2_own_mi[i] = mi && l2_own_host[i] = host && l2_text_same(l2_own_name[i], t) != 0 && l2_own_source_visible(i, mi, at) != 0 && l2_own_source_after(i, hit) != 0
            hit: i
        i: i + 1
return: hit

# A receiver output is either its own exact declaration occurrence or an
# explicitly typed receiving place in the same lexical body. An earlier
# computed output shadows older targets; it is not itself a typed target.
# There is no search through outer bodies or through a computed shadow.
fn: l2_own_output_at (int: mi; const: @(LmP0Text t); const: @(LmP0Node at)) int
    int: own l2_own_find_decl(mi, t, at)
    @: L2Declaration declaration
    if: own >= 0
        return: own
    own: l2_own_host_at(mi, t, l2_scope_host(), at)
    if: own < 0
        return: -1
    declaration: l2_declaration(l2_own_decl[own])
    if: declaration = 0 || l2_text_same(declaration\name, t) = 0 || l2_contract_own(declaration\contract) = 0
        return: -1
return: own

fn: l2_own_output_add (int: mi; const: @(LmP0Text t); int: ty; const: @(char path); const: @(LmP0Node at)) int
    int: own l2_own_output_at(mi, t, at)
    if: own < 0
        return: l2_own_add(mi, t, ty, path, at)
    if: l2_own_ty[own] != ty
        l2_error(path, at, "assignment value has incompatible type")
        return: -1
return: own

fn: l2_own_any (int: mi; const: @(LmP0Text t)) int
    int: i 0
    if: mi < 0 || t = 0
        return: -1
    while: i < l2_own_n
        if: l2_own_mi[i] = mi && l2_text_same(l2_own_name[i], t)
            return: i
        i: i + 1
return: -1

# A readable name for an l2_own_ty code (0 int, 1 char, 2 size_t, 3 unsigned, 36 ulong), for the
# Q24 conversion-refusal message below -- not l2_own_store_helper's C API function names.
fn: l2_own_ty_word (int: ty) @: char
    if: ty = 0
        return: "int"
    if: ty = 1
        return: "char"
    if: ty = 2
        return: "size_t"
    if: ty = 3
        return: "unsigned"
    if: ty = 36
        return: "ulong"
return: "?"

# Q24 = A (author, LMX_blog/2026-09-25.md; q24.md): a repeated declaration of one name in one
# body is a new occurrence, same mechanism the argument same-name-binding rule already uses.
# Same-type is unconditional (l2_own_add falls it through to occurrence creation). A DIFFERENT-
# typed repeat needs its initialiser value carried across types to seed the new occurrence's own
# cell (`char: x (x + 2)` from an int x) -- the author: "в трансляции так как в Си такое
# невозможно прямо", through the ported lingvamyxa_prev converters (S7), not a C cast and not
# implicit numeric widening. That port has not landed, so this is the located refusal instead.
fn: l2_conversion_refused_msg (@: char dest; int: from_ty; int: to_ty) int
    if: dest = 0
        return: 1
    if: c.snprintf(dest, 256U, "conversion %s -> %s: converters not ported yet (S7)", l2_own_ty_word(from_ty), l2_own_ty_word(to_ty)) < 0
        return: 1
return: 0

fn: l2_own_add (int: mi; const: @(LmP0Text t); int: ty; const: @(char path); const: @(LmP0Node at)) int
    int: i
    if: mi < 0 || t = 0
        if: l2_error(path, at, "incompatible entry signature") != 0
            return: -1
        return: -1
    if: l2_bind_admit(t, l2_bind_at(at, t), path) != 0
        return: -1
    i: l2_own_find_decl(mi, t, at)
    # Every caller reserves a declaration occurrence, never a bare store.
    # Only its exact source identity can reuse that occurrence. Receiver
    # output selection happens before reservation in l2_own_output_add.
    if: i >= 0 && l2_own_ty[i] != ty
        if: l2_error(path, at, "incompatible entry signature") != 0
            return: -1
        return: -1
    if: i >= 0
        if: l2_own_decl[i] = at && l2_own_nsty_set(i, l2_declaration_model(at, 0)) != 0
            return: -1
        return: i
    if: l2_own_n >= c.INT_MAX
        l2_alloc_err: 2
        if: l2_alloc_or(path, at, "unsupported body") != 0
            return: -1
        return: -1
    if: l2_own_reserve(l2_own_n + 1) != 0
        if: l2_alloc_or(path, at, "unsupported body") != 0
            return: -1
        return: -1
    if: l2_own_n >= l2_own_cap
        l2_alloc_err: 2
        if: l2_alloc_or(path, at, "unsupported body") != 0
            return: -1
        return: -1
    l2_own_name[l2_own_n]: (cast: (@: LmP0Text) t)
    l2_own_ty[l2_own_n]: ty
    l2_own_bseq[l2_own_n]: 0
    l2_own_mi[l2_own_n]: mi
    l2_own_host[l2_own_n]: l2_scope_host()
    l2_own_decl[l2_own_n]: (cast: (@: LmP0Node) at)
    l2_own_fid[l2_own_n]: -1
    l2_own_fchild[l2_own_n]: -1
    l2_own_uchild[l2_own_n]: -1
    l2_own_n: l2_own_n + 1
    if: l2_own_nsty_set(l2_own_n - 1, l2_declaration_model(at, 0)) != 0
        return: -1
return: l2_own_n - 1

fn: l2_pd_free () int
    if: l2_pd != 0
        l2_xfree((cast: (@: void) l2_pd))
    ---
    l2_pd: 0
    l2_pd_n: 0
    l2_pd_cap: 0
return: 0

fn: l2_def_free () int
    if: l2_def != 0
        l2_xfree((cast: (@: void) l2_def))
    ---
    l2_def: 0
    l2_def_n: 0
    l2_def_cap: 0
return: 0

fn: l2_inc_free () int
    if: l2_inc != 0
        l2_xfree((cast: (@: void) l2_inc))
    ---
    l2_inc: 0
    l2_inc_n: 0
    l2_inc_cap: 0
return: 0


fn: l2_ml_free () int
    if: l2_ml_nm != 0
        l2_xfree((cast: (@: void) l2_ml_nm))
    ---
    if: l2_ml_ty != 0
        l2_xfree((cast: (@: void) l2_ml_ty))
    ---
    if: l2_ml_rw != 0
        l2_xfree((cast: (@: void) l2_ml_rw))
    ---
    l2_ml_nm: 0
    l2_ml_ty: 0
    l2_ml_rw: 0
    l2_ml_n: 0
return: 0

fn: l2_ml_find (const: @(LmP0Text t)) int
    int: i 0
    if: t = 0 || l2_ml_nm = 0
        return: 0 - 1
    while: i < l2_ml_n
        if: l2_text_same(l2_ml_nm[i], t)
            return: i
        i: i + 1
    ---
return: 0 - 1

fn: l2_ml_array_head (const: @(LmP0Text t)) int
    int: i 0
    @: LmP0Text name
    if: t = 0 || l2_ml_nm = 0 || l2_ml_ty = 0
        return: 0 - 1
    while: i < l2_ml_n
        name: l2_ml_nm[i]
        if: l2_ml_ty[i] = 22 && name != 0 && t\length > name\length && t\data[name\length] = 91 && memcmp(name\data, t\data, name\length) = 0
            return: i
        i: i + 1
return: 0 - 1

fn: l2_ml_add (const: @(LmP0Text t); int: ty; const: @(char path); const: @(LmP0Node at)) int
    @@: LmP0Text nn
    @: int nt
    size_t: want
    if: l2_bind_admit(t, l2_bind_at(at, t), path) != 0
        return: 1
    want: (cast: (size_t) (l2_ml_n + 1))
    nn: (cast: (@@: LmP0Text) realloc((cast: (@: void) l2_ml_nm), want * c.sizeof(@: void)))
    if: nn = 0
        return: l2_error(path, at, "out of memory")
    l2_ml_nm: nn
    nt: (cast: (@: int) realloc((cast: (@: void) l2_ml_ty), want * c.sizeof(c.int)))
    if: nt = 0
        return: l2_error(path, at, "out of memory")
    l2_ml_ty: nt
    nt: (cast: (@: int) realloc((cast: (@: void) l2_ml_ns), want * c.sizeof(c.int)))
    if: nt = 0
        return: l2_error(path, at, "out of memory")
    l2_ml_ns: nt
    nt: (cast: (@: int) realloc((cast: (@: void) l2_ml_rw), want * c.sizeof(c.int)))
    if: nt = 0
        return: l2_error(path, at, "out of memory")
    l2_ml_rw: nt
    l2_ml_nm[l2_ml_n]: (cast: (@: LmP0Text) t)
    l2_ml_ty[l2_ml_n]: ty
    l2_ml_ns[l2_ml_n]: l2_declaration_model(at, 0)
    l2_ml_rw[l2_ml_n]: 0 - 1
    l2_ml_n: l2_ml_n + 1
return: 0

# The ONE deterministic collection of a method body's local declarations, so
# scan, check and emit see identical names and type codes. Descends into
# nested executable bodies because the other phases do.
fn: l2_ml_collect (const: @(LmP0Structure body); int: mi; const: @(char path)) int
    @: LmP0Field field
    @: LmP0Field inner
    @: LmP0Node stmt
    @: LmP0Text nm 0
    int: ty 0
    if: body = 0
        return: 0
    field: l2_next_active(body\first_field)
    while: field != 0
        stmt: field\value
        if: stmt != 0 && stmt\kind = c.LM_P0_NODE_STRUCTURE && stmt\as != 0 && stmt\as\structure != 0
            if: l2_ml_collect(stmt\as\structure, mi, path) != 0
                return: 1
            field: l2_next_active(field\next)
            continue
        # A source-declared pointer binding has a physical own cell; only
        # foreign by-value/function-pointer locals remain in this table.
        nm: 0
        if: l2_own_ref_decl(stmt, mi) >= 0 || l2_own_is_pointer(l2_own_decl_ty(stmt)) != 0 || l2_root_ref_row(stmt) >= 0
            field: l2_next_active(field\next)
            continue
        # A pointer or const local's type may name a definition that this
        # early pass has not registered yet; such locals are read once the
        # declarations exist.
        if: l2_ml_imported_only = 0
            if: l2_slot_decl_ty(stmt) = 0 && l2_ptr_local_ty(stmt, @ nm, @ ty) = 2
                return: l2_error(path, l2_next_active(stmt\as\frame\body\first_field)\value, "unknown type")
            if: l2_slot_decl_ty(stmt) = 0 && l2_ptr_local_ty(stmt, @ nm, @ ty) = 0 && l2_ml_find(nm) < 0 && l2_ml_add(nm, ty, path, stmt) != 0
                return: 1
            if: l2_const_local_ty(stmt, @ nm, @ ty) = 0 && l2_ml_find(nm) < 0 && l2_ml_add(nm, ty, path, stmt) != 0
                return: 1
            ---
        if: l2_fnptr_local(stmt, @ nm) = 0 && l2_ml_find(nm) < 0 && l2_ml_add(nm, 40, path, stmt) != 0
            return: 1
        if: l2_struct_local(stmt, @ nm) = 0 && l2_ml_find(nm) < 0 && l2_ml_add(nm, 41, path, stmt) != 0
            return: 1
        if: stmt != 0 && stmt\kind = c.LM_P0_NODE_FRAME && stmt\as != 0 && stmt\as\frame != 0 && stmt\as\frame\body != 0
            inner: l2_next_active(l2_call_actuals(stmt\as\frame\body))
            while: inner != 0
                if: inner\value != 0 && inner\value\kind = c.LM_P0_NODE_STRUCTURE && inner\value\as != 0 && l2_ml_collect(inner\value\as\structure, mi, path) != 0
                    return: 1
                inner: l2_next_active(inner\next)
            ---
        ---
        field: l2_next_active(field\next)
    ---
return: 0

# Clear, then collect. Separate from the recursive collector so a nested body
# cannot erase what its parent registered.
fn: l2_ml_rebuild (const: @(LmP0Structure body); int: mi; const: @(char path)) int
    l2_ml_free()
return: l2_ml_collect(body, mi, path)

fn: l2_pd_push (const: @(LmP0Text t); const: @(char path); const: @(LmP0Node at)) int
    int: cap
    size_t: nb
    size_t: psz
    @@: LmP0Text nn 0
    if: t = 0
        return: l2_error(path, at, "unsupported argument")
    cap: l2_pd_cap
    if: l2_pd_n >= cap
        if: cap < 1
            cap: 4
        ---
        if: cap > (c.INT_MAX / 2)
            return: l2_error(path, at, "size overflow")
        cap: cap * 2
        psz: c.sizeof(@: char)
        if: l2_mul_ok((cast: (size_t) cap), psz) = 0
            return: l2_error(path, at, "size overflow")
        nb: (cast: (size_t) cap) * psz
        nn: (cast: (@@: LmP0Text) l2_xmalloc(nb))
        if: nn = 0
            return: l2_error(path, at, "out of memory")
        memset((cast: (@: void) nn), 0, nb)
        if: l2_pd != 0 && l2_pd_n > 0
            memcpy((cast: (@: void) nn), (cast: (@: void) l2_pd), (cast: (size_t) l2_pd_n) * psz)
        ---
        if: l2_pd != 0
            l2_xfree((cast: (@: void) l2_pd))
        ---
        l2_pd: nn
        l2_pd_cap: cap
    ---
    l2_pd[l2_pd_n]: (cast: (@: LmP0Text) t)
    l2_pd_n: l2_pd_n + 1
return: 0

fn: l2_def_push (const: @(LmP0Node item); const: @(char path)) int
    int: cap
    size_t: nb
    size_t: psz
    @@: LmP0Node nn 0
    if: item = 0
        return: l2_error(path, item, "unsupported argument")
    cap: l2_def_cap
    if: l2_def_n >= cap
        if: cap < 1
            cap: 4
        ---
        if: cap > (c.INT_MAX / 2)
            return: l2_error(path, item, "size overflow")
        cap: cap * 2
        psz: c.sizeof(@: char)
        if: l2_mul_ok((cast: (size_t) cap), psz) = 0
            return: l2_error(path, item, "size overflow")
        nb: (cast: (size_t) cap) * psz
        nn: (cast: (@@: LmP0Node) l2_xmalloc(nb))
        if: nn = 0
            return: l2_error(path, item, "out of memory")
        memset((cast: (@: void) nn), 0, nb)
        if: l2_def != 0 && l2_def_n > 0
            memcpy((cast: (@: void) nn), (cast: (@: void) l2_def), (cast: (size_t) l2_def_n) * psz)
        ---
        if: l2_def != 0
            l2_xfree((cast: (@: void) l2_def))
        ---
        l2_def: nn
        l2_def_cap: cap
    ---
    l2_def[l2_def_n]: (cast: (@: LmP0Node) item)
    l2_def_n: l2_def_n + 1
return: 0

fn: l2_inc_push (const: @(LmP0Text t); const: @(char path); const: @(LmP0Node at)) int
    int: cap
    size_t: nb
    size_t: psz
    @@: LmP0Text nn 0
    if: t = 0
        return: l2_error(path, at, "unsupported argument")
    cap: l2_inc_cap
    if: l2_inc_n >= cap
        if: cap < 1
            cap: 4
        ---
        if: cap > (c.INT_MAX / 2)
            return: l2_error(path, at, "size overflow")
        cap: cap * 2
        psz: c.sizeof(@: char)
        if: l2_mul_ok((cast: (size_t) cap), psz) = 0
            return: l2_error(path, at, "size overflow")
        nb: (cast: (size_t) cap) * psz
        nn: (cast: (@@: LmP0Text) l2_xmalloc(nb))
        if: nn = 0
            return: l2_error(path, at, "out of memory")
        memset((cast: (@: void) nn), 0, nb)
        if: l2_inc != 0 && l2_inc_n > 0
            memcpy((cast: (@: void) nn), (cast: (@: void) l2_inc), (cast: (size_t) l2_inc_n) * psz)
        ---
        if: l2_inc != 0
            l2_xfree((cast: (@: void) l2_inc))
        ---
        l2_inc: nn
        l2_inc_cap: cap
    ---
    l2_inc[l2_inc_n]: (cast: (@: LmP0Text) t)
    l2_inc_n: l2_inc_n + 1
return: 0

fn: l2_take_predef (const: @(LmP0Node item); const: @(char path)) int
    @: LmP0Field f
    if: item = 0 || item\as = 0 || item\as\frame = 0 || item\as\frame\body = 0
        return: l2_error(path, item, "unsupported argument")
    if: l2_count_active(item\as\frame\body) != 1
        return: l2_error(path, item, "unsupported argument")
    f: l2_next_active(item\as\frame\body\first_field)
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM || l2_quoted(f\value\as\atom) = 0
        return: l2_error(path, item, "unsupported argument")
return: l2_pd_push(f\value\as\atom, path, item)

# `profile: runtime` is the one profile a unit may declare.
fn: l2_take_profile (const: @(LmP0Node item); const: @(char path)) int
    @: LmP0Field f
    if: item = 0 || item\as = 0 || item\as\frame = 0 || item\as\frame\body = 0 || l2_count_active(item\as\frame\body) != 1
        return: l2_error(path, item, "a profile names one profile")
    f: l2_next_active(item\as\frame\body\first_field)
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM || l2_text_eq(f\value\as\atom, "runtime") = 0
        return: l2_error(path, item, "unknown profile")
    l2_profile_runtime: 1
return: 0

fn: l2_take_define (const: @(LmP0Node item); const: @(char path)) int
    @: LmP0Field f
    int: n 0
    if: item = 0 || item\as = 0 || item\as\frame = 0 || item\as\frame\body = 0 || item\as\frame\trailer != 0 || item\as\frame\body\trailer != 0
        return: l2_error(path, item, "unsupported argument")
    f: l2_next_active(item\as\frame\body\first_field)
    while: f != 0
        if: f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM
            return: l2_error(path, item, "define accepts flat L1 tokens")
        n: n + 1
        f: l2_next_active(f\next)
    ---
    if: n < 2
        return: l2_error(path, item, "unsupported argument")
return: l2_def_push(item, path)

fn: l2_write_defines (@: FILE out) int
    int: i 0
    @: LmP0Field f
    if: out = 0
        return: 1
    while: i < l2_def_n
        if: fputs("define:", out) < 0
            return: 1
        f: l2_next_active(l2_def[i]\as\frame\body\first_field)
        while: f != 0
            if: fputs(" ", out) < 0 || l2_write_text(out, f\value\as\atom) != 0
                return: 1
            f: l2_next_active(f\next)
        ---
        if: fputs("\n", out) < 0
            return: 1
        i: i + 1
    ---
    if: l2_def_n != 0 && fputs("\n", out) < 0
        return: 1
return: 0

fn: l2_take_include (const: @(LmP0Node item); const: @(char path)) int
    @: LmP0Field f
    if: item = 0 || item\as = 0 || item\as\frame = 0 || item\as\frame\body = 0
        return: l2_error(path, item, "unsupported argument")
    f: l2_next_active(item\as\frame\body\first_field)
    if: f = 0
        return: l2_error(path, item, "unsupported argument")
    while: f != 0
        if: f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM || l2_quoted(f\value\as\atom) = 0
            return: l2_error(path, item, "unsupported argument")
        if: l2_inc_push(f\value\as\atom, path, item) != 0
            return: 1
        f: l2_next_active(f\next)
return: 0

fn: l2_foreign_truncate (int: count) int
    int: i count
    while: i < l2_foreign_n
        l2_xfree((cast: (@: void) l2_foreign_name[i]))
        l2_foreign_name[i]: 0
        i: i + 1
    l2_foreign_n: count
return: 0

fn: l2_foreign_free () int
    l2_foreign_truncate(0)
    if: l2_foreign_name != 0
        l2_xfree((cast: (@: void) l2_foreign_name))
    if: l2_foreign_depth != 0
        l2_xfree((cast: (@: void) l2_foreign_depth))
    if: l2_foreign_const != 0
        l2_xfree((cast: (@: void) l2_foreign_const))
    l2_foreign_name: 0
    l2_foreign_depth: 0
    l2_foreign_const: 0
    l2_foreign_n: 0
    l2_foreign_cap: 0
return: 0

# Does a predef'd header declare this name with fnptr:? The answer is the C
# ABI's, not ours: a function-pointer local can only be typed by a disposer the
# header already names.
fn: l2_predef_has_fnptr (const: @(LmP0Text name)) int
    int: r
    l2_want_fnptr: 1
    r: l2_predef_has_type(name)
    l2_want_fnptr: 0
    if: r = 0
        return: 0
    # struct: and fnptr: share the walk, so a name that is a STRUCT is not a
    # function pointer and must not be mistaken for one.
    if: l2_predef_has_type(name) != 0
        return: 0
return: 1

fn: l2_predef_file_has_type (const: @(LmP0Text name); const: @(LmP0Text quoted)) int
    size_t: n
    @: char path 0
    @: LmP0Document document 0
    const: @: LmP0Node root
    @: LmP0Field f
    @: LmP0Field first
    @: LmP0Node item
    @: LmP0Field inc
    @: LmP0Text q
    @: LmP0Text mapped 0
    @: char mapped_data 0
    int: found 0
    if: name = 0 || quoted = 0 || quoted\data = 0 || quoted\length < 2U || quoted\data[0] != 34 || quoted\data[quoted\length - 1U] != 34
        return: 0
    n: quoted\length - 2U
    path: (cast: (@: char) l2_xmalloc(n + 1U))
    if: path = 0
        return: 0
    memcpy(path, quoted\data + 1U, n)
    path[n]: 0
    if: lm_p0_parse_file(path, @ document) = 0 && document != 0
        root: lm_p0_document_root(document)
        if: root != 0 && root\kind = c.LM_P0_NODE_STRUCTURE && root\as != 0
            f: l2_next_active(root\as\structure\first_field)
            while: f != 0 && found = 0
                item: f\value
                if: (l2_frame_head(item, "struct") || (l2_want_fnptr != 0 && l2_frame_head(item, "fnptr"))) && item\as\frame\body != 0
                    first: l2_next_active(item\as\frame\body\first_field)
                    if: first != 0 && first\value != 0 && first\value\kind = c.LM_P0_NODE_ATOM && (l2_text_same(first\value\as\atom, name) || (name\length > 2U && name\data[0] = 99 && name\data[1] = 46 && first\value\as\atom\length = name\length - 2U && memcmp(first\value\as\atom\data, name\data + 2U, name\length - 2U) = 0))
                        found: 1
                    ---
                ---
                # A predef header may reuse another header's ABI declaration.
                # Follow that declared closure instead of forcing every L2 unit
                # to repeat aggregate layouts. Header cycles are invalid input,
                # just as they are for the downstream L1 predef walk.
                if: found = 0 && l2_frame_head(item, "predef") && item\as\frame\body != 0 && l2_count_active(item\as\frame\body) = 1
                    first: l2_next_active(item\as\frame\body\first_field)
                    if: first != 0 && first\value != 0 && first\value\kind = c.LM_P0_NODE_ATOM
                        found: l2_predef_file_has_type(name, first\value\as\atom)
                    ---
                ---
                # Generated L1 headers use foo.lm1.h while their source header
                # unit is foo.h.lm1. Follow that source edge too; pointer ABI
                # lookup needs no C layout parser and the downstream L1/C
                # compiler remains the final spelling check.
                if: found = 0 && l2_frame_head(item, "include") && item\as\frame\body != 0
                    inc: l2_next_active(item\as\frame\body\first_field)
                    while: inc != 0 && found = 0
                        if: inc\value != 0 && inc\value\kind = c.LM_P0_NODE_ATOM
                            q: inc\value\as\atom
                            if: q != 0 && q\data != 0 && q\length > 8U && q\data[0] = 34 && memcmp(q\data + q\length - 7U, ".lm1.h\"", 7U) = 0
                                mapped_data: (cast: (@: char) l2_xmalloc(q\length + 1U))
                                mapped: (cast: (@: LmP0Text) l2_xmalloc(c.sizeof(c.LmP0Text)))
                                if: mapped_data != 0 && mapped != 0
                                    memcpy(mapped_data, q\data, q\length)
                                    memcpy(mapped_data + q\length - 7U, ".h.lm1\"", 7U)
                                    mapped_data[q\length]: 0
                                    mapped\data: mapped_data
                                    mapped\length: q\length
                                    found: l2_predef_file_has_type(name, mapped)
                                    l2_xfree((cast: (@: void) mapped_data))
                                    l2_xfree((cast: (@: void) mapped))
                                    mapped_data: 0
                                    mapped: 0
                                ---
                                if: mapped_data != 0
                                    l2_xfree((cast: (@: void) mapped_data))
                                if: mapped != 0
                                    l2_xfree((cast: (@: void) mapped))
                                ---
                            ---
                        ---
                        inc: l2_next_active(inc\next)
                    ---
                ---
                f: l2_next_active(f\next)
            ---
        ---
        lm_p0_document_destroy(document)
    ---
    l2_xfree((cast: (@: void) path))
return: found

fn: l2_predef_has_type (const: @(LmP0Text name)) int
    int: i 0
    if: name = 0
        return: 0
    while: i < l2_pd_n
        if: l2_predef_file_has_type(name, l2_pd[i]) != 0
            return: 1
        i: i + 1
    ---
return: 0

# A storage type declared by an LMX predef is a present receiver, not an
# absent Structure head and not necessarily a callable. Use the existing
# structural predef lookup; c.* remains the unchecked raw C door.
fn: l2_predef_receiver (const: @(LmP0Text name)) int
    int: saved l2_want_fnptr
    int: found
    l2_want_fnptr: 1
    found: l2_predef_has_type(name)
    l2_want_fnptr: saved
return: found

# WHAT STOOD HERE AND IS GONE (FABLE-OPUS-GATE-CLEANUP-20260926-197 (a)): the C-header scans --
# l2_list_has_simple_typedef / l2_include_has_simple_typedef read the unit's quoted C includes for a
# `typedef`, l2_c_header_walk / l2_c_header_chain_has(_typedef) followed a predef header's plain C
# includes transitively.  That is a dictionary of C entities, which the raw-C door forbids (§7a,
# AUTHOR-C-RAW-DOOR-20260922-14): a type only C knows is spelled `c.Type`.  Measured before removal:
# no tracked .lm2 (1017, and the mixa corpus from its own directory) changes outcome without them.
# The LMX predef readers (l2_predef_has_function / _type / _fnptr, l2_predef_file_define) stay: they
# read DECLARATIONS of .h.lm1 headers, which is how a predef declares.

fn: l2_cnt_keep (const: @(LmP0Text src)) @: LmP0Text
    int: i 0
    int: cap
    size_t: psz
    size_t: nb
    size_t: len
    @@: LmP0Text nn 0
    @: LmP0Text kept 0
    @: char bytes 0
    if: src = 0 || src\data = 0 || src\length = 0U
        return: 0
    while: i < l2_cnt_n
        if: l2_text_same(l2_cnt[i], src)
            return: l2_cnt[i]
        i: i + 1
    ---
    cap: l2_cnt_cap
    if: l2_cnt_n >= cap
        if: cap < 1
            cap: 4
        ---
        if: cap > (c.INT_MAX / 2)
            return: 0
        cap: cap * 2
        psz: c.sizeof(@: char)
        if: l2_mul_ok((cast: (size_t) cap), psz) = 0
            return: 0
        nb: (cast: (size_t) cap) * psz
        nn: (cast: (@@: LmP0Text) l2_xmalloc(nb))
        if: nn = 0
            return: 0
        memset((cast: (@: void) nn), 0, nb)
        if: l2_cnt != 0 && l2_cnt_n > 0
            memcpy((cast: (@: void) nn), (cast: (@: void) l2_cnt), (cast: (size_t) l2_cnt_n) * psz)
        ---
        if: l2_cnt != 0
            l2_xfree((cast: (@: void) l2_cnt))
        ---
        l2_cnt: nn
        l2_cnt_cap: cap
    ---
    len: src\length
    bytes: (cast: (@: char) l2_xmalloc(len + 1U))
    kept: (cast: (@: LmP0Text) l2_xmalloc(c.sizeof(c.LmP0Text)))
    if: bytes = 0 || kept = 0
        if: bytes != 0
            l2_xfree((cast: (@: void) bytes))
        ---
        if: kept != 0
            l2_xfree((cast: (@: void) kept))
        ---
        return: 0
    ---
    memcpy(bytes, src\data, len)
    bytes[len]: 0
    kept\data: bytes
    kept\length: len
    l2_cnt[l2_cnt_n]: kept
    l2_cnt_n: l2_cnt_n + 1
return: kept

fn: l2_cnt_free () int
    int: i 0
    while: i < l2_cnt_n
        if: l2_cnt[i] != 0
            if: l2_cnt[i]\data != 0
                l2_xfree((cast: (@: void) l2_cnt[i]\data))
            ---
            l2_xfree((cast: (@: void) l2_cnt[i]))
        ---
        i: i + 1
    ---
    if: l2_cnt != 0
        l2_xfree((cast: (@: void) l2_cnt))
    ---
    l2_cnt: 0
    l2_cnt_n: 0
    l2_cnt_cap: 0
return: 0

# A top-level `define: NAME <literal>` in a predef'd .h.lm1, or in a .h.lm1 that
# one predefs (the same single-file predef closure l2_predef_file_has_type
# follows). The literal is kept, because this document is destroyed here.  With
# `any` the define may give any value (l2_define_name): its first value token is
# kept; without it only an own-array count literal answers (l2_define_count).
fn: l2_predef_file_define (const: @(LmP0Text name); const: @(LmP0Text quoted); int: any) @: LmP0Text
    size_t: n
    @: char path 0
    @: LmP0Document document 0
    const: @: LmP0Node root
    @: LmP0Field f
    @: LmP0Field first
    @: LmP0Field second
    @: LmP0Node item
    @: LmP0Text found 0
    if: name = 0 || quoted = 0 || quoted\data = 0 || quoted\length < 2U || quoted\data[0] != 34 || quoted\data[quoted\length - 1U] != 34
        return: 0
    n: quoted\length - 2U
    path: (cast: (@: char) l2_xmalloc(n + 1U))
    if: path = 0
        return: 0
    memcpy(path, quoted\data + 1U, n)
    path[n]: 0
    if: lm_p0_parse_file(path, @ document) = 0 && document != 0
        root: lm_p0_document_root(document)
        if: root != 0 && root\kind = c.LM_P0_NODE_STRUCTURE && root\as != 0
            f: l2_next_active(root\as\structure\first_field)
            while: f != 0 && found = 0
                item: f\value
                if: l2_frame_head(item, "define") && item\as\frame\body != 0 && (l2_count_active(item\as\frame\body) = 2 || (any != 0 && l2_count_active(item\as\frame\body) > 2))
                    first: l2_next_active(item\as\frame\body\first_field)
                    second: 0
                    if: first != 0
                        second: l2_next_active(first\next)
                    ---
                    if: first != 0 && first\value != 0 && first\value\kind = c.LM_P0_NODE_ATOM && l2_text_same(first\value\as\atom, name) && second != 0 && second\value != 0 && second\value\kind = c.LM_P0_NODE_ATOM && (any != 0 || l2_array_count_is(second\value\as\atom) != 0)
                        found: l2_cnt_keep(second\value\as\atom)
                    ---
                ---
                if: found = 0 && l2_frame_head(item, "predef") && item\as\frame\body != 0 && l2_count_active(item\as\frame\body) = 1
                    first: l2_next_active(item\as\frame\body\first_field)
                    if: first != 0 && first\value != 0 && first\value\kind = c.LM_P0_NODE_ATOM
                        found: l2_predef_file_define(name, first\value\as\atom, any)
                    ---
                ---
                f: l2_next_active(f\next)
            ---
        ---
        lm_p0_document_destroy(document)
    ---
    l2_xfree((cast: (@: void) path))
return: found

# An own-array count written as a name resolves to the literal its define: gives:
# the unit's own defines first -- those nodes live as long as the unit document
# the [] statement itself belongs to -- then the unit's predef chain. Only a
# literal value resolves; a define of another name stays refused.
fn: l2_define_count (const: @(LmP0Text name)) @: LmP0Text
    int: i 0
    @: LmP0Field first
    @: LmP0Field second
    @: LmP0Text r 0
    if: name = 0 || l2_ident(name) = 0
        return: 0
    while: i < l2_def_n
        if: l2_def[i] != 0 && l2_def[i]\as != 0 && l2_def[i]\as\frame != 0 && l2_def[i]\as\frame\body != 0 && l2_count_active(l2_def[i]\as\frame\body) = 2
            first: l2_next_active(l2_def[i]\as\frame\body\first_field)
            second: 0
            if: first != 0
                second: l2_next_active(first\next)
            ---
            if: first != 0 && first\value != 0 && first\value\kind = c.LM_P0_NODE_ATOM && l2_text_same(first\value\as\atom, name) && second != 0 && second\value != 0 && second\value\kind = c.LM_P0_NODE_ATOM && l2_array_count_is(second\value\as\atom) != 0
                return: second\value\as\atom
            ---
        ---
        i: i + 1
    ---
    i: 0
    while: i < l2_pd_n && r = 0
        r: l2_predef_file_define(name, l2_pd[i], 0)
        i: i + 1
    ---
return: r

# A `define:` of the unit or of its predef chain DECLARES its name (FABLE-OPUS-MERGE-PARTS-20260926-193
# T1b, Q6 = a): `define:` is L1 the translator passes through, and it reads these declarations
# already for own-array counts (l2_define_count).  An atom naming one is a declared constant, asked
# after every L2 name, whatever its spelling.  Any other name is unresolved (a located refusal); a
# name only C knows comes through the raw door, `c.NAME`.
fn: l2_define_name (const: @(LmP0Text name)) int
    int: i 0
    @: LmP0Field first
    if: name = 0 || l2_ident(name) = 0
        return: 0
    while: i < l2_def_n
        if: l2_def[i] != 0 && l2_def[i]\as != 0 && l2_def[i]\as\frame != 0 && l2_def[i]\as\frame\body != 0 && l2_count_active(l2_def[i]\as\frame\body) >= 2
            first: l2_next_active(l2_def[i]\as\frame\body\first_field)
            if: first != 0 && first\value != 0 && first\value\kind = c.LM_P0_NODE_ATOM && l2_text_same(first\value\as\atom, name)
                return: 1
            ---
        ---
        i: i + 1
    ---
    i: 0
    while: i < l2_pd_n
        if: l2_predef_file_define(name, l2_pd[i], 1) != 0
            return: 1
        i: i + 1
    ---
return: 0

# K03 (the author, 2026-10-06; docs/LMX_semantics.en.md#resolved-head-consumption): the written application at a node,
# as P0 wrote it and before any role -- a Frame's head with its argument Structure, an atom's text with no written
# argument.  A reader of an evaluation position asks it; a literal, a path, an operator or a quoted text is no head
# (l2_ident_word), and the C door's `c.name` is its own.  It classifies nothing, takes no neighbour and writes no node.
fn: l2_app_head (const: @(LmP0Node n)) @: LmP0Text
    if: n = 0 || n\as = 0
        return: 0
    if: n\kind = c.LM_P0_NODE_FRAME && n\as\frame != 0
        return: n\as\frame\head
    if: n\kind = c.LM_P0_NODE_ATOM && n\as\atom != 0 && (l2_ident_word(n\as\atom) != 0 || l2_c_stmt_door(n\as\atom) != 0)
        return: n\as\atom
return: 0

# The written arguments of that application: a Frame's body -- `H()`, `H: ()` and an empty block are one empty
# Structure in P0 -- or 0 for an atom, which writes none.  A consumer reads the actuals through it, so a bare head and
# its empty application reach one contract with no argument.
fn: l2_app_actuals (const: @(LmP0Node n)) @: LmP0Structure
    if: n = 0 || n\as = 0 || n\kind != c.LM_P0_NODE_FRAME || n\as\frame = 0
        return: 0
return: n\as\frame\body

# A receiver or word of the language (next_core_tasks_dictionary_v2.md :128), by its defined contract and never by
# whether its lowering exists (Codex K03-RESERVED-NAME-ANSWER-20261006-03): the receivers that head a statement
# (l2_receiver_word) and the words it names as the language's others -- the statement words (l2_ident refuses them as
# names; `break`, `continue`), `sizeof`, the primitive type words of l2_ptr_type_word's table; the receiving
# expressions `const`, `immutable`, `independent` (docs/LMX_semantics.en.md §10); the receivers `implements` (§7),
# `test` (§7, adopted) and `post` (§28: "an ordinary protocol receiver"); `external` (docs/L2_spec_en.md §18: it wraps
# one fn or sub); the C99 machine types (L2 §17: exactly their C99 meaning) -- the type keywords `short`, `long`,
# `float`, `double`, `signed`, `_Bool` beside the table's; the translator's unit instructions `predef`, `define`,
# `include`, `profile`, `prototype`, `os` (L2 §18 :273-275, docs/L1_spec_en.md :172-174).  A named Structure, the C
# door, a name a predef or a header declares, a table alias (`u8`) and an argument label (`source`, `ask`) are no words.
fn: l2_head_word (const: @(LmP0Text t)) int
    int: ty 0
    if: t = 0 || l2_ident_word(t) = 0
        return: 0
    if: l2_receiver_word(t) != 0 || l2_ident(t) = 0 || l2_text_eq(t, "break") || l2_text_eq(t, "continue") || l2_text_eq(t, "sizeof") || l2_text_eq(t, "const")
        return: 1
    if: l2_text_eq(t, "immutable") || l2_text_eq(t, "independent") || l2_text_eq(t, "implements") || l2_text_eq(t, "test") || l2_text_eq(t, "post") || l2_text_eq(t, "external")
        return: 1
    if: l2_text_eq(t, "short") || l2_text_eq(t, "long") || l2_text_eq(t, "float") || l2_text_eq(t, "double") || l2_text_eq(t, "signed") || l2_text_eq(t, "_Bool")
        return: 1
    if: l2_unit_word(t) != 0
        return: 1
return: (cast: (int) (l2_ptr_type_word(t, 1, @ ty) = 0 && ty > 0 && ty < 100))

# The translator's unit instructions (docs/L2_spec_en.md §18 :273-275, docs/L1_spec_en.md :172-174): read at the
# unit's root (l2_unit_role), words of the language everywhere (l2_head_word).
fn: l2_unit_word (const: @(LmP0Text t)) int
return: (cast: (int) (l2_text_eq(t, "predef") || l2_text_eq(t, "define") || l2_text_eq(t, "include") || l2_text_eq(t, "profile") || l2_text_eq(t, "prototype") || l2_text_eq(t, "os")))

# An exact identifier (grammar §5): the spelling between backticks.  When its value is a plain identifier it is the name
# that plain spelling is, and *out views the value; a value holding a backtick (a doubled one) is no plain identifier.
fn: l2_exact_ident (const: @(LmP0Text t); @: LmP0Text out) int
    if: t = 0 || t\data = 0 || out = 0 || t\length < 3U || t\data[0] != 96 || t\data[t\length - 1U] != 96
        return: 0
    out\data: t\data + 1U
    out\length: t\length - 2U
return: l2_ident_word(out)

# What a binding's shape reads in its name position -- a declaration's, a method's, a formal's, a named Structure
# field's, a qualified branch's, the name receiveMessage binds: any identifier, plain or exact (l2_exact_ident).  The
# shape reads the spelling only; whether the program may bind that name is the one admission's (l2_bind_admit).
fn: l2_bind_spelling (const: @(LmP0Text t)) int
    LmP0Text: v
    if: l2_ident_word(t) != 0
        return: 1
return: l2_exact_ident(t, @ v)

# RESERVED-NAME-BINDINGS (Codex K03-RESERVED-NAME-ANSWER-20261006-02; dictionary :128, CORE :648; grammar §5): the one
# admission of a name a program binds -- a field or a local at the root, in a method or in a nested or anonymous body,
# a method, a formal, a named Structure's field, a qualified branch, a slot, the name receiveMessage binds -- said at
# the name (at).  A word of the language (l2_head_word) cannot be bound, in either spelling: quoting escapes no
# reservation.  An exact spelling of any other name binds nothing yet: the translator keys a binding by its plain
# spelling.  0 admitted, 1 refused (said).
fn: l2_bind_admit (const: @(LmP0Text t); const: @(LmP0Node at); const: @(char path)) int
    LmP0Text: v
    if: t = 0 || t\data = 0
        return: l2_error(path, at, "a binding needs a name")
    if: l2_ident_word(t) != 0
        if: l2_head_word(t) != 0
            return: l2_bind_reserved(path, at, t)
        return: 0
    if: l2_exact_ident(t, @ v) != 0
        if: l2_head_word(@ v) != 0
            return: l2_bind_reserved(path, at, @ v)
        return: l2_error(path, at, "an exact identifier cannot name a binding yet")
return: l2_error(path, at, "a binding needs a name")

# The refusal of a binding named by word w of the language, said at at (l2_bind_admit).
fn: l2_bind_reserved (const: @(char path); const: @(LmP0Node at); const: @(LmP0Text w)) int
return: l2_error_name(path, at, "", w\data, w\length, " is a word of the language: a program cannot bind it")

# Where binding statement at writes the name t, for the admission's words: the atom of at's Frame -- or of a Frame
# within it, a qualified or typed declaration's -- whose text t is; else at itself.
fn: l2_bind_at (const: @(LmP0Node at); const: @(LmP0Text t)) const: @: LmP0Node
    @: LmP0Field f
    const: @: LmP0Node n
    if: at = 0 || t = 0 || at\kind != c.LM_P0_NODE_FRAME || at\as = 0 || at\as\frame = 0 || at\as\frame\body = 0
        return: at
    f: l2_next_active(at\as\frame\body\first_field)
    while: f != 0
        if: f\value != 0 && f\value\kind = c.LM_P0_NODE_ATOM && f\value\as != 0 && f\value\as\atom = t
            return: f\value
        if: f\value != 0 && f\value\kind = c.LM_P0_NODE_FRAME
            n: l2_bind_at(f\value, t)
            if: n != f\value
                return: n
            ---
        f: l2_next_active(f\next)
    ---
return: at

# K03: what head t names at its occurrence in method mi -- the one resolution every phase asks (the author: one
# namespace, the head/arguments model first, then the role).  The binding the site sees comes first and blocks every
# outer category of its name, as l2_call_head_method has it: an own field the site sees -- the method's own, or a field
# of the unit seen from a method --, a formal, an input the method already has, a slot, a body local, a name of its
# host's activation; then the unit's method (both ways, by name or path) or named Structure; then a word of the
# language; then a define, the C door or a declared function.  Read at the pass's current site (l2_here_at_method), as
# the readers it serves read it; it records nothing.  The answer, with *out_index the entry it found (-1 for none):
#  -1  no name -- a path, an operator, a literal: its own form, never looked up;
#   0  unknown -- nothing visible declares it (§9: in a definition position it defines a named Structure; §12: a value a
#      method reads by it is an input its callers give);
#   1  a receiver or word of the language (l2_head_word);
#   2  a method (l2_head_method);
#   3  a held callable: a callable formal, a callable local, a stored callable (l2_call_head_held);
#   4  a value: an own field, a formal, an input, a slot, a local;
#   5  a named Structure;
#   6  the C door or a declared function (l2_is_known);
#   7  a define.
# *out_outside is 1 when the binding found for a held callable or a value is not this activation's own -- a field of
# the unit a method sees, an input the method already has, its host's formal or field (Q52, §12): the activation's
# hidden input, whose value its caller gives; 0 otherwise.
fn: l2_head_resolve (int: mi; const: @(LmP0Text t); @: int out_index; @: int out_outside) int
    int: k
    int: h
    int: hk
    if: out_index != 0
        \out_index: -1
    if: out_outside != 0
        \out_outside: 0
    if: t = 0 || t\data = 0
        return: -1
    if: l2_c_stmt_door(t) != 0
        return: 6
    if: l2_ident_word(t) = 0
        return: -1
    if: mi >= 0
        k: l2_resolved_own(mi, t)
        if: k >= 0
            if: out_index != 0
                \out_index: k
            if: out_outside != 0 && l2_own_unit_seen(k, mi) != 0
                \out_outside: 1
            if: l2_own_decl[k] != 0 && (l2_mad_store_stmt(l2_own_decl[k]) != 0 || l2_rb_meth_of(l2_own_decl[k]) >= 0)
                return: 3
            return: 4
        k: l2_formal_find(mi, t)
        if: k >= 0
            if: out_index != 0
                \out_index: k
            if: l2_cf_get(mi, k) >= 0
                return: 3
            return: 4
        k: l2_dyn_find(mi, t)
        if: k >= 0
            if: out_index != 0
                \out_index: k
            if: out_outside != 0
                \out_outside: 1
            # K03 NS-ROLES-1b: the unit's binding `b: tick` seen from a method is a held callable there too.
            if: l2_call_alias_own(mi, t) >= 0
                return: 3
            return: 4
        k: l2_slot_find(mi, t)
        if: k >= 0
            if: out_index != 0
                \out_index: k
            return: 4
        k: l2_ml_find(t)
        if: k >= 0
            if: out_index != 0
                \out_index: k
            if: l2_ml_ty != 0 && l2_ml_ty[k] = 40
                return: 3
            return: 4
        h: l2_mad_host_of(mi)
        if: h >= 0
            hk: l2_formal_find(h, t)
            if: hk >= 0
                if: out_index != 0
                    \out_index: hk
                if: out_outside != 0
                    \out_outside: 1
                if: l2_cf_get(h, hk) >= 0
                    return: 3
                return: 4
            hk: l2_mad_host_own(h, t)
            if: hk >= 0
                if: out_index != 0
                    \out_index: hk
                if: out_outside != 0
                    \out_outside: 1
                if: l2_own_decl[hk] != 0 && l2_mad_store_stmt(l2_own_decl[hk]) != 0
                    return: 3
                return: 4
            ---
        ---
    ---
    k: l2_head_method(mi, t)
    if: k >= 0
        if: out_index != 0
            \out_index: k
        return: 2
    k: l2_ns_find(t)
    if: k >= 0
        if: out_index != 0
            \out_index: k
        return: 5
    # A receiver's name is the language's, never discovered from a predef or a C header (dictionary :454).
    if: l2_head_word(t) != 0
        return: 1
    if: l2_define_name(t) != 0
        return: 7
    if: l2_is_known(t) != 0
        return: 6
return: 0

# K03: the head of the application at statement stmt when the one resolution gives a word of the language at this site --
# an atom's text or a Frame's head, so a bare word and its empty application reach one contract -- or 0.  No program
# binds a word (l2_bind_admit), so the resolution finds the word wherever it is spelled.
fn: l2_stmt_word_head (const: @(LmP0Node stmt); int: mi) @: LmP0Text
    @: LmP0Text h
    if: stmt = 0 || (stmt\kind != c.LM_P0_NODE_FRAME && stmt\kind != c.LM_P0_NODE_ATOM)
        return: 0
    h: l2_app_head(stmt)
    if: h = 0 || l2_head_word(h) = 0 || l2_head_resolve(mi, h, 0, 0) != 1
        return: 0
return: h

# Whether statement stmt applies the word `word` of the language (l2_stmt_word_head).
fn: l2_stmt_word (const: @(LmP0Node stmt); int: mi; const: @(char word)) int
    @: LmP0Text h l2_app_head(stmt)
    if: h = 0 || l2_text_eq(h, word) = 0
        return: 0
return: (cast: (int) (l2_stmt_word_head(stmt, mi) != 0))
fn: l2_predef_file_has_function (const: @(LmP0Text name); const: @(LmP0Text quoted)) int
    size_t: n
    @: char path 0
    @: LmP0Document document 0
    const: @: LmP0Node root
    @: LmP0Field f
    @: LmP0Field pf
    @: LmP0Field nf
    @: LmP0Field first
    @: LmP0Node item
    @: LmP0Node decl
    int: found 0
    if: name = 0 || quoted = 0 || quoted\data = 0 || quoted\length < 2U || quoted\data[0] != 34 || quoted\data[quoted\length - 1U] != 34
        return: 0
    n: quoted\length - 2U
    path: (cast: (@: char) l2_xmalloc(n + 1U))
    if: path = 0
        return: 0
    memcpy(path, quoted\data + 1U, n)
    path[n]: 0
    if: lm_p0_parse_file(path, @ document) = 0 && document != 0
        root: lm_p0_document_root(document)
        if: root != 0 && root\kind = c.LM_P0_NODE_STRUCTURE && root\as != 0
            f: l2_next_active(root\as\structure\first_field)
            while: f != 0 && found = 0
                item: f\value
                if: l2_frame_head(item, "prototype") && item\as\frame\body != 0
                    pf: l2_next_active(item\as\frame\body\first_field)
                    while: pf != 0 && found = 0
                        decl: pf\value
                        if: (l2_frame_head(decl, "fn") || l2_frame_head(decl, "sub")) && decl\as\frame\body != 0
                            nf: l2_next_active(decl\as\frame\body\first_field)
                            if: nf != 0 && nf\value != 0 && nf\value\kind = c.LM_P0_NODE_ATOM && l2_text_same(nf\value\as\atom, name)
                                found: 1
                            ---
                        ---
                        pf: l2_next_active(pf\next)
                    ---
                ---
                if: found = 0 && l2_frame_head(item, "predef") && item\as\frame\body != 0 && l2_count_active(item\as\frame\body) = 1
                    first: l2_next_active(item\as\frame\body\first_field)
                    if: first != 0 && first\value != 0 && first\value\kind = c.LM_P0_NODE_ATOM
                        found: l2_predef_file_has_function(name, first\value\as\atom)
                    ---
                ---
                f: l2_next_active(f\next)
            ---
        ---
        lm_p0_document_destroy(document)
    ---
    l2_xfree((cast: (@: void) path))
return: found

# Functions declared by a predef header are external ABI leaves. They are not
# callable Structures owned by this unit, so calls go through the ordinary C
# seam while the generated predef header supplies the checked prototype.
fn: l2_predef_has_function (const: @(LmP0Text name)) int
    int: i 0
    if: name = 0
        return: 0
    while: i < l2_pd_n
        if: l2_predef_file_has_function(name, l2_pd[i]) != 0
            return: 1
        i: i + 1
    ---
return: 0

# FABLE-SONNET-TYPE-WORD-FOLD-20260924-162 commit 2 (steps/type-word-fold-
# inventory.md): the return-code word(+depth+const) -> code table, shared
# by l2_collect_method's real-method return type (its own structural
# validation -- body counts, "incompatible entry signature" vs "unknown
# type" -- stays there; only the word lookup moves here) and
# l2_ret_type_node below (for a predef'd prototype: declaration, which
# has no structural context of its own to preserve). depth=0 is a
# bare-value return (is_const never applies there); is_const only
# matters at depth=1 (l2_collect_method's own const: (@: T) case; no
# const @@: or deeper return exists in the corpus, measured). Returns
# 0 = found (out_ty set), 1 = word not recognized (not one of the known
# words at this depth/const combination, not a Structure name at
# depth=0, and l2_foreign_byvalue/l2_resolve_type_atom also refused).
fn: l2_ret_type_word (const: @(LmP0Text word); int: depth; int: is_const; @: int out_ty) int
    if: out_ty = 0 || word = 0
        return: 1
    \out_ty: 0
    if: depth = 0 && l2_text_eq(word, "int")
        \out_ty: 0
        return: 0
    if: depth = 0 && l2_text_eq(word, "char")
        \out_ty: 1
        return: 0
    if: depth = 0 && l2_text_eq(word, "size_t")
        \out_ty: 2
        return: 0
    if: depth = 0 && l2_text_eq(word, "unsigned")
        \out_ty: 33
        return: 0
    if: depth = 0 && l2_text_eq(word, "ulong")
        \out_ty: 36
        return: 0
    if: depth = 0 && l2_text_eq(word, "void")
        \out_ty: 8
        return: 0
    if: depth = 0 && l2_ns_find(word) >= 0
        \out_ty: l2_graph_ft()
        if: \out_ty != 0
            return: 0
        return: 1
    if: depth = 0
        \out_ty: l2_foreign_byvalue(word)
        if: \out_ty >= 100
            return: 0
        return: 1
    if: depth = 1 && is_const = 0 && l2_text_eq(word, "char")
        \out_ty: 3
        return: 0
    if: depth = 1 && is_const != 0 && l2_text_eq(word, "char")
        \out_ty: 35
        return: 0
    if: depth = 1 && is_const = 0 && l2_text_eq(word, "void")
        \out_ty: 16
        return: 0
    if: depth = 2 && is_const = 0 && l2_text_eq(word, "char")
        \out_ty: 32
        return: 0
    if: l2_resolve_type_atom(word, depth, is_const, out_ty) != 0
        return: 1
return: 0

# The full return-type NODE, structural parsing included (const: (@: T),
# depth>2, @:, @@:, bare atom) -- used where the caller has no structural
# validation of its own to reuse (l2_predef_file_result_ty, a predef'd
# prototype: declaration). l2_collect_method keeps its own structural
# parsing (for its per-case "incompatible entry signature" errors) and
# calls l2_ret_type_word directly once it already has word+depth+const.
fn: l2_ret_type_node (const: @(LmP0Node rt); @: int out_ty) int
    int: ft
    int: depth
    int: qualified
    LmP0Text: word
    if: out_ty = 0
        return: 1
    \out_ty: 8
    if: rt = 0
        return: 0
    if: l2_contract_formal(l2_contract_type(rt), @ ft) != 0
        return: 1
    ft: l2_formal_raw(ft)
    \out_ty: ft
    if: ft = 34
        \out_ty: 33
    if: ft = 12
        \out_ty: 3
    if: ft = 3
        \out_ty: 35
    if: ft = 17
        \out_ty: 32
    # Preserve the established return-code adapters; all other pointer types
    # use the same stable closed type interner as declarations and addresses.
    if: ft != 3 && ft != 12 && ft != 16 && ft != 17 && ft < 100 && l2_pointer_depth(ft) > 0
        if: l2_type_parts(ft, @ word, @ depth, @ qualified) != 0
            return: 1
        \out_ty: l2_foreign_intern(@ word, depth, qualified)
        if: \out_ty < 100
            return: 1
        ---
    ---
return: 0

fn: l2_predef_file_result_ty (const: @(LmP0Text name); const: @(LmP0Text quoted); @: int out_ty) int
    size_t: n
    @: char path 0
    @: LmP0Document document 0
    const: @: LmP0Node root
    @: LmP0Field f
    @: LmP0Field pf
    @: LmP0Field nf
    @: LmP0Field pp
    @: LmP0Field rtf
    @: LmP0Node rtnode
    @: LmP0Field first
    @: LmP0Node item
    @: LmP0Node decl
    int: found 0
    if: out_ty = 0
        return: 0
    if: name = 0 || quoted = 0 || quoted\data = 0 || quoted\length < 2U || quoted\data[0] != 34 || quoted\data[quoted\length - 1U] != 34
        return: 0
    n: quoted\length - 2U
    path: (cast: (@: char) l2_xmalloc(n + 1U))
    if: path = 0
        return: 0
    memcpy(path, quoted\data + 1U, n)
    path[n]: 0
    if: lm_p0_parse_file(path, @ document) = 0 && document != 0
        root: lm_p0_document_root(document)
        if: root != 0 && root\kind = c.LM_P0_NODE_STRUCTURE && root\as != 0
            f: l2_next_active(root\as\structure\first_field)
            while: f != 0 && found = 0
                item: f\value
                if: l2_frame_head(item, "prototype") && item\as\frame\body != 0
                    pf: l2_next_active(item\as\frame\body\first_field)
                    while: pf != 0 && found = 0
                        decl: pf\value
                        if: (l2_frame_head(decl, "fn") || l2_frame_head(decl, "sub")) && decl\as\frame\body != 0
                            nf: l2_next_active(decl\as\frame\body\first_field)
                            if: nf != 0 && nf\value != 0 && nf\value\kind = c.LM_P0_NODE_ATOM && l2_text_same(nf\value\as\atom, name)
                                pp: l2_next_active(nf\next)
                                rtf: 0
                                if: pp != 0
                                    rtf: l2_next_active(pp\next)
                                rtnode: 0
                                if: rtf != 0
                                    rtnode: rtf\value
                                # A `sub` has no result: the void code, so the one
                                # "no result" refusal applies.  A `fn` whose result type
                                # cannot be read is refused by the caller (D-88), never
                                # stood in for by the numeric-literal class.
                                found: 1
                                if: l2_frame_head(decl, "sub")
                                    \out_ty: 8
                                else:
                                    if: l2_ret_type_node(rtnode, out_ty) != 0
                                        found: 2
                                    ---
                                ---
                            ---
                        ---
                        pf: l2_next_active(pf\next)
                    ---
                ---
                if: found = 0 && l2_frame_head(item, "predef") && item\as\frame\body != 0 && l2_count_active(item\as\frame\body) = 1
                    first: l2_next_active(item\as\frame\body\first_field)
                    if: first != 0 && first\value != 0 && first\value\kind = c.LM_P0_NODE_ATOM
                        found: l2_predef_file_result_ty(name, first\value\as\atom, out_ty)
                    ---
                ---
                f: l2_next_active(f\next)
            ---
        ---
        lm_p0_document_destroy(document)
    ---
    l2_xfree((cast: (@: void) path))
return: found

fn: l2_predef_result_ty (const: @(LmP0Text name); @: int out_ty) int
    int: i 0
    if: name = 0 || out_ty = 0
        return: 0
    int: st
    while: i < l2_pd_n
        st: l2_predef_file_result_ty(name, l2_pd[i], out_ty)
        if: st = 1
            \out_ty: l2_result_value_ty(\out_ty)
        if: st != 0
            return: st
        i: i + 1
    ---
return: 0

fn: l2_address_depth (const: @(LmP0Text head)) int
    size_t: i 0U
    if: head = 0 || head\data = 0 || head\length = 0U || head\length > (cast: (size_t) c.INT_MAX)
        return: 0
    while: i < head\length
        if: head\data[i] != 64
            return: 0
        i: i + 1U
return: (cast: (int) head\length)

fn: l2_emit_address_marks (@: FILE out; int: depth) int
    int: i 0
    if: out = 0 || depth < 1
        return: 1
    while: i < depth
        if: c.fputc(64, out) = c.EOF
            return: 1
        i: i + 1
return: 0

fn: l2_foreign_intern (const: @(LmP0Text name); int: depth; int: is_const) int
    int: i 0
    int: cap
    size_t: nb
    LmP0Text: raw
    @: LmP0Text saved
    @@: LmP0Text nn 0
    @: int nd 0
    @: int nc 0
    if: l2_c_stmt_door(name) != 0
        raw.data: name\data + 2U
        raw.length: name\length - 2U
        name: @ raw
    if: name = 0 || l2_ident_word(name) = 0 || depth < 0
        return: 0 - 1
    # A foreign type is spelled as written (Stage B, Mikhail 2026-09-14): no
    # header is read to admit it, and the C compiler checks the spelling.
    while: i < l2_foreign_n
        if: l2_foreign_depth[i] = depth && l2_foreign_const[i] = is_const && l2_text_same(l2_foreign_name[i], name)
            return: 100 + i
        i: i + 1
    if: l2_foreign_n = c.INT_MAX - 100
        l2_alloc_err: 2
        return: 0 - 1
    if: l2_foreign_n >= l2_foreign_cap
        cap: l2_foreign_cap
        if: cap < 1
            cap: 4
        while: cap <= l2_foreign_n
            if: cap > c.INT_MAX / 2
                cap: l2_foreign_n + 1
            else:
                cap: cap * 2
            ---
        ---
        if: l2_mul_ok((cast: (size_t) cap), c.sizeof(@: char)) = 0 || l2_mul_ok((cast: (size_t) cap), c.sizeof(c.int)) = 0
            l2_alloc_err: 2
            return: 0 - 1
        nb: (cast: (size_t) cap) * c.sizeof(@: char)
        nn: (cast: (@@: LmP0Text) l2_xmalloc(nb))
        nd: (cast: (@: int) l2_xmalloc((cast: (size_t) cap) * c.sizeof(c.int)))
        nc: (cast: (@: int) l2_xmalloc((cast: (size_t) cap) * c.sizeof(c.int)))
        if: nn = 0 || nd = 0 || nc = 0
            if: nn != 0
                l2_xfree((cast: (@: void) nn))
            if: nd != 0
                l2_xfree((cast: (@: void) nd))
            if: nc != 0
                l2_xfree((cast: (@: void) nc))
            return: 0 - 1
        if: l2_foreign_n > 0
            memcpy((cast: (@: void) nn), (cast: (@: void) l2_foreign_name), (cast: (size_t) l2_foreign_n) * c.sizeof(@: char))
            memcpy((cast: (@: void) nd), (cast: (@: void) l2_foreign_depth), (cast: (size_t) l2_foreign_n) * c.sizeof(c.int))
            memcpy((cast: (@: void) nc), (cast: (@: void) l2_foreign_const), (cast: (size_t) l2_foreign_n) * c.sizeof(c.int))
        ---
        if: l2_foreign_name != 0
            l2_xfree((cast: (@: void) l2_foreign_name))
        if: l2_foreign_depth != 0
            l2_xfree((cast: (@: void) l2_foreign_depth))
        if: l2_foreign_const != 0
            l2_xfree((cast: (@: void) l2_foreign_const))
        l2_foreign_name: nn
        l2_foreign_depth: nd
        l2_foreign_const: nc
        l2_foreign_cap: cap
    ---
    # A new interned contract owns its text, including bytes from a predef
    # document that may be destroyed before this contract is emitted.
    saved: l2_text_clone(name)
    if: saved = 0
        return: -1
    l2_foreign_name[l2_foreign_n]: saved
    l2_foreign_depth[l2_foreign_n]: depth
    l2_foreign_const[l2_foreign_n]: is_const
    i: l2_foreign_n
    l2_foreign_n: l2_foreign_n + 1
    # Source-driven predef/include: the unit declares what runtime headers it needs.
    # Name/prefix triggers (LmP0*, c.lm_p0_set_diagnostic, per-name stdlib/string) are gone.
return: 100 + i

# A by-value foreign type `T` or `c.T` (Stage B), interned with depth 0. It is
# spelled as written without the c. prefix, and the C compiler checks it.
# Returns a foreign code >= 100, or less when the text is not a type name.
fn: l2_foreign_byvalue (const: @(LmP0Text t)) int
    if: t = 0 || t\data = 0
        return: 0 - 1
    if: t\length > 2U && t\data[0] = 99 && t\data[1] = 46
        return: l2_foreign_intern(t, 0, 0)
    ---
    # Bare foreign by-value names are refused (type-position rule, ticket 106 PART2).
return: 0 - 1

# Resolve a type-position atom at address depth for formals/returns/own fields.
# Reuse the value vocabulary for primitive pointees at any depth, then
# Structure/model -> Lmx projection; c.* raw door;
# else unknown (caller emits "unknown type"). Returns 0 and sets out_ty, or 2.
fn: l2_resolve_type_atom (const: @(LmP0Text atom); int: depth; int: is_const; @: int out_ty) int
    int: leaf
    if: out_ty = 0 || atom = 0
        return: 2
    \out_ty: 0
    if: depth < 1
        return: 2
    if: l2_ret_type_word(atom, 0, 0, @ leaf) = 0 && l2_prim_code_name(l2_result_value_ty(leaf)) != 0
        \out_ty: l2_foreign_intern(atom, depth, is_const)
        if: \out_ty >= 100
            return: 0
        return: 2
    # Lmx is the Structure/model projection type (CORE.md 3.1); it is not a foreign C name.
    if: l2_text_eq(atom, "Lmx")
        \out_ty: l2_foreign_intern(l2_lmx_text(), depth, is_const)
        if: \out_ty >= 100
            return: 0
        return: 2
    # A reference `@: T` to a named Structure is one level, `@: Lmx` (D-76): its value is the Structure
    # itself, the pointee its pointer cell holds -- the same value `@mo` gives and `T: mo`'s slot holds.
    if: l2_type_model(atom) >= 0
        \out_ty: l2_foreign_intern(l2_lmx_text(), depth, is_const)
        if: \out_ty >= 100
            return: 0
        return: 2
    if: l2_c_stmt_door(atom) != 0
        \out_ty: l2_foreign_intern(atom, depth, is_const)
        if: \out_ty >= 100
            return: 0
        return: 2
return: 2

fn: l2_emit_foreign_named (@: FILE out; int: ty; const: @(char prefix); const: @(LmP0Text name)) int
    int: i ty - 100
    if: out = 0 || i < 0 || i >= l2_foreign_n
        return: 1
    if: prefix != 0 && fputs(prefix, out) < 0
        return: 1
    if: l2_foreign_depth[i] = 0
        if: l2_write_text(out, l2_foreign_name[i]) != 0 || fputs(": ", out) < 0 || l2_write_text(out, name) != 0
            return: 1
        return: 0
    if: l2_foreign_const[i] != 0 && fputs("const: ", out) < 0
        return: 1
    if: l2_emit_address_marks(out, l2_foreign_depth[i]) != 0
        return: 1
    if: l2_foreign_const[i] != 0
        if: fputs("(", out) < 0
            return: 1
        ---
    else:
        if: fputs(": ", out) < 0
            return: 1
    ---
    if: l2_write_text(out, l2_foreign_name[i]) != 0
        return: 1
    if: fputs(" ", out) < 0 || l2_write_text(out, name) != 0
        return: 1
    if: l2_foreign_const[i] != 0 && fputs(")", out) < 0
        return: 1
return: 0

fn: l2_emit_foreign_temp (@: FILE out; int: ty; const: @(char ind); int: temp) int
    int: i ty - 100
    if: out = 0 || i < 0 || i >= l2_foreign_n
        return: 1
    if: fputs(ind, out) < 0
        return: 1
    # A const foreign pointer keeps its qualifier: `const: @(T l2_tN)`.
    if: l2_foreign_const[i] != 0
        if: l2_foreign_depth[i] < 1 || fputs("const: ", out) < 0 || l2_emit_address_marks(out, l2_foreign_depth[i]) != 0 || fputs("(", out) < 0 || l2_write_text(out, l2_foreign_name[i]) != 0 || c.fprintf(out, " l2_t%d)\n", temp) < 0
            return: 1
        return: 0
    if: l2_foreign_depth[i] = 0
        if: l2_write_text(out, l2_foreign_name[i]) != 0 || c.fprintf(out, ": l2_t%d\n", temp) < 0
            return: 1
        return: 0
    if: l2_emit_address_marks(out, l2_foreign_depth[i]) != 0 || fputs(": ", out) < 0
        return: 1
    if: l2_write_text(out, l2_foreign_name[i]) != 0
        return: 1
    if: c.fprintf(out, " l2_t%d\n", temp) < 0
        return: 1
return: 0

fn: l2_emit_foreign_return (@: FILE out; int: ty) int
    int: i ty - 100
    if: out = 0 || i < 0 || i >= l2_foreign_n
        return: 1
    # A const foreign pointer return: `) const: @(T)`.
    if: l2_foreign_const[i] != 0
        if: l2_foreign_depth[i] < 1 || fputs(") const: ", out) < 0 || l2_emit_address_marks(out, l2_foreign_depth[i]) != 0 || fputs("(", out) < 0 || l2_write_text(out, l2_foreign_name[i]) != 0 || fputs(")", out) < 0
            return: 1
        return: 0
    if: l2_foreign_depth[i] = 0
        if: fputs(") ", out) < 0
            return: 1
        return: l2_write_text(out, l2_foreign_name[i])
    if: fputs(") ", out) < 0 || l2_emit_address_marks(out, l2_foreign_depth[i]) != 0 || fputs(": ", out) < 0
        return: 1
return: l2_write_text(out, l2_foreign_name[i])

fn: l2_emit_foreign_formal (@: FILE out; int: ty; int: mi; int: fi; int: arg) int
    int: i ty - 100
    []: char ref_own 64
    L2Tx: ref_tx
    @: L2Tx ref l2_tx_local(@ ref_tx, ref_own, 64U)
    if: out = 0 || i < 0 || i >= l2_foreign_n
        return: 1
    if: arg != 0 && (ref = 0 || l2_tramp_ref(mi, fi, ref) != 0)
        return: 1
    # The trampoline input (l2_emit_formal): a foreign value is read from the typed storage its
    # reference addresses, through the typed pointer declared for it (arg 2).
    # A foreign pointer is loaded once from its pointer-value storage.
    if: arg = 2 && l2_foreign_depth[i] = 0
        if: fputs("    @: ", out) < 0 || l2_write_text(out, l2_foreign_name[i]) != 0 || c.fprintf(out, " l2_b%d (cast: (@: ", fi) < 0 || l2_write_text(out, l2_foreign_name[i]) != 0 || c.fprintf(out, ") %s)\n", ref\data) < 0
            return: 1
        ---
    if: arg = 2
        return: 0
    if: arg = 1 && l2_foreign_depth[i] = 0
        return: (cast: (int) (c.fprintf(out, ", \\l2_b%d", fi) < 0))
    if: arg = 1
        return: (cast: (int) (c.fprintf(out, ", lmx_pointer_value_known(%s)", ref\data) < 0))
    if: fputs("; ", out) < 0
        return: 1
    if: l2_foreign_depth[i] = 0
        if: l2_write_text(out, l2_foreign_name[i]) != 0 || c.fprintf(out, ": l2_p%d_%d", mi, fi) < 0
            return: 1
        return: 0
    if: l2_foreign_const[i] != 0 && fputs("const: ", out) < 0
        return: 1
    if: l2_emit_address_marks(out, l2_foreign_depth[i]) != 0
        return: 1
    if: l2_foreign_const[i] != 0
        if: fputs("(", out) < 0
            return: 1
        ---
    else:
        if: fputs(": ", out) < 0
            return: 1
    ---
    if: l2_write_text(out, l2_foreign_name[i]) != 0 || c.fprintf(out, " l2_p%d_%d", mi, fi) < 0
        return: 1
    if: l2_foreign_const[i] != 0 && fputs(")", out) < 0
        return: 1
return: 0

# A function-pointer local: TYPE: name, where TYPE is a fnptr: the predef'd
# header declares. It is an activation local, never an own field -- a function
# pointer is not a graph cell and has no business in one.
fn: l2_fnptr_local (const: @(LmP0Node stmt); @@: LmP0Text out_name) int
    @: LmP0Field f
    if: out_name = 0
        return: 1
    \out_name: 0
    if: stmt = 0 || stmt\kind != c.LM_P0_NODE_FRAME || stmt\as = 0 || stmt\as\frame = 0 || stmt\as\frame\head = 0 || stmt\as\frame\body = 0
        return: 1
    # A bare declaration, or a declaration with an initialiser. The
    # initialiser form is the only one this language can express, because a
    # later "d: value" statement is the same tree as the call "d(value)".
    if: l2_count_active(stmt\as\frame\body) < 1
        return: 1
    f: l2_next_active(stmt\as\frame\body\first_field)
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM || l2_bind_spelling(f\value\as\atom) = 0
        return: 1
    if: l2_predef_has_fnptr(stmt\as\frame\head) = 0
        return: 1
    \out_name: f\value\as\atom
return: 0

# A by-value local of a C struct the predef'd header declares: TYPE: name. It is
# ordinary C storage in the activation (spec 20.2.2), never an own field, and its
# address is taken with @ name. Only the bare declaration: a struct has no
# scalar initialiser here. Classification uses structural shape and resolved type/name, not form.
fn: l2_struct_local (const: @(LmP0Node stmt); @@: LmP0Text out_name) int
    @: LmP0Field f
    if: out_name = 0
        return: 1
    \out_name: 0
    if: stmt = 0 || stmt\kind != c.LM_P0_NODE_FRAME || stmt\as = 0 || stmt\as\frame = 0 || stmt\as\frame\head = 0 || stmt\as\frame\body = 0
        return: 1
    if: l2_count_active(stmt\as\frame\body) != 1
        return: 1
    f: l2_next_active(stmt\as\frame\body\first_field)
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM || l2_bind_spelling(f\value\as\atom) = 0
        return: 1
    if: l2_predef_has_type(stmt\as\frame\head) = 0 || l2_predef_has_fnptr(stmt\as\frame\head) != 0
        return: 1
    \out_name: f\value\as\atom
return: 0

# The one physical projection every nonprimitive Structure/model already
# uses (CORE.md 3.1, L2 spec 18.1): Lmx at one more address depth than the
# binding itself. Cached so repeated address-slot declarations over
# different Structure names still share one interned (name,depth) entry.
fn: l2_lmx_text () @: LmP0Text
    if: l2_lmx_name_cache = 0
        l2_lmx_name_cache: (cast: (@: LmP0Text) l2_xmalloc(c.sizeof(c.LmP0Text)))
        if: l2_lmx_name_cache = 0
            return: 0
        l2_lmx_name_cache\data: "Lmx"
        l2_lmx_name_cache\length: 3U
    ---
return: l2_lmx_name_cache

# A persistent owned Text is one block containing its view and bytes.
# Transient classification borrows a view; only an actual retained owner
# calls this copy, then releases that same block.
fn: l2_text_clone (const: @(LmP0Text t)) @: LmP0Text
    @: LmP0Text r
    @: char bytes
    size_t: length
    if: t = 0
        return: 0
    length: t\length
    if: length > (cast: (size_t) -1) - c.sizeof(c.LmP0Text) - 1U
        l2_alloc_err: 2
        return: 0
    r: (cast: (@: LmP0Text) l2_xmalloc(c.sizeof(c.LmP0Text) + length + 1U))
    if: r = 0
        return: 0
    bytes: (cast: (@: char) r) + c.sizeof(c.LmP0Text)
    r\data: bytes
    r\length: length
    memcpy(bytes, t\data, length)
    bytes[length]: 0
return: r

# FABLE-SONNET-TYPE-WORD-FOLD-20260924-162 commit 2 (steps/type-word-fold-
# inventory.md): the pointer-local word+depth -> code table, shared
# byte-identically (measured, commit 1) by l2_ptr_local_ty, l2_own_array_
# pointer_ty and l2_typed_formal's @:/@@: blocks -- one function instead
# of three copies. Callers already validated the SHAPE (a `@: T name` /
# `@@: T name`-like frame at a nonzero depth) before reaching here, so
# this only ever answers for the WORD: 0 = found (out_ty set); 2 = word
# not one of the six core words at this depth, not a known Structure
# name, not a c.* door name, OR recognized as an attempted Structure/
# foreign name but l2_foreign_intern itself failed (l2_ptr_local_ty's
# own exact convention -- verified against its original inline chain,
# which returns 2 here, never 1; 1 is reserved by its callers for the
# shape check, never produced by the word lookup itself).
fn: l2_ptr_type_word (const: @(LmP0Text word); int: depth; @: int out_ty) int
    if: out_ty = 0 || word = 0
        return: 2
    \out_ty: 0
    if: depth = 1 && l2_text_eq(word, "char")
        \out_ty: 12
        return: 0
    if: depth = 1 && l2_text_eq(word, "size_t")
        \out_ty: 9
        return: 0
    if: depth = 1 && l2_text_eq(word, "int")
        \out_ty: 11
        return: 0
    if: depth = 1 && l2_text_eq(word, "void")
        \out_ty: 16
        return: 0
    if: depth = 1 && l2_text_eq(word, "unsigned")
        \out_ty: 25
        return: 0
    if: depth = 1 && l2_text_eq(word, "ulong")
        \out_ty: 38
        return: 0
    if: depth = 2 && l2_text_eq(word, "char")
        \out_ty: 17
        return: 0
    if: depth = 2 && l2_text_eq(word, "size_t")
        \out_ty: 20
        return: 0
    if: depth = 2 && l2_text_eq(word, "int")
        \out_ty: 19
        return: 0
    if: depth = 2 && l2_text_eq(word, "void")
        \out_ty: 18
        return: 0
    if: depth = 2 && l2_text_eq(word, "unsigned")
        \out_ty: 24
        return: 0
    if: depth = 2 && l2_text_eq(word, "ulong")
        \out_ty: 39
        return: 0
    # `@: T` of a named Structure is one level, `@: Lmx` (D-76; l2_resolve_type_atom).
    if: l2_type_model(word) >= 0
        \out_ty: l2_foreign_intern(l2_lmx_text(), depth, 0)
        if: \out_ty >= 100
            return: 0
        return: 2
    if: l2_c_stmt_door(word) != 0
        \out_ty: l2_foreign_intern(word, depth, 0)
        if: \out_ty >= 100
            return: 0
        return: 2
return: 2

# The pointee word of a const pointer: char, depth 1.  It also held the kernel
# names LmxRoot, LmxMsg, L2ImmutQuery (and LmxMsgRuntime, LmxMsgCopy, declared
# nowhere) until §GATE G2 (steps/gate-measure-20260927.md): a kernel type is
# spelled through the c.* door; the letter model's sender keeps code 29,
# pushed by l2_letter_ns_for, not looked up here.  Folded out of l2_const_local_ty's own
# inline check (FABLE-SONNET-SEND-REF-20260925-172 commit 1, per -162's
# fold discipline): one table, codes unchanged (char=3, LmxRoot=28,
# LmxMsg=29, L2ImmutQuery=6), l2_const_local_ty
# and l2_typed_formal's const branch both call it instead of repeating it;
# a THIRD caller, the general reference field in l2_take_ns_body, needs the
# same words for a field like `@: LmxMsg sender`.  0 = recognized (out_ty
# set); 1 = not one of these five words.
fn: l2_kernel_ptr_word (const: @(LmP0Text word); @: int out_ty) int
    if: out_ty = 0 || word = 0
        return: 1
    \out_ty: 0
    if: l2_text_eq(word, "char")
        \out_ty: 3
        return: 0
return: 1

# Contract kinds are compiler operations, not arena type codes: 0 is an
# explicit leaf, 1 Array, 2 reference, 3 const, 4 immutable, 5 independent.
fn: l2_contract_new (int: kind; int: depth; const: @(LmP0Text word); @: L2TypeContract operand) @: L2TypeContract
    @: L2TypeContract result
    result: (cast: (@: L2TypeContract) l2_xmalloc(c.sizeof(c.L2TypeContract)))
    if: result = 0
        return: 0
    result\kind: kind
    result\depth: depth
    result\word: (cast: (@: LmP0Text) word)
    result\operand: operand
    result\allocated_next: l2_contracts
    l2_contracts: result
return: result

# Structural application view: every head and its ordered source operands survive.
# No receiver name, operand count, trailer or source form selects a new grammar.
fn: l2_application (const: @(LmP0Node node)) @: LmP0Frame
    if: node = 0 || node\kind != c.LM_P0_NODE_FRAME || node\as = 0
        return: 0
return: node\as\frame

fn: l2_application_free () int
    @: L2Declaration declaration
    @: L2TypeContract contract
    @: L2HeadExpression expression
    while: l2_declarations != 0
        declaration: l2_declarations
        l2_declarations: declaration\allocated_next
        l2_xfree((cast: (@: void) declaration))
    while: l2_contracts != 0
        contract: l2_contracts
        l2_contracts: contract\allocated_next
        l2_xfree((cast: (@: void) contract))
    while: l2_head_expressions != 0
        expression: l2_head_expressions
        l2_head_expressions: expression\allocated_next
        lm_p0_document_destroy(expression\document)
        l2_xfree((cast: (@: void) expression))
return: 0

# A type operand uses the same receiver tree. A transparent sole Structure
# operand does not add a constructor. Reference depth belongs to @ itself.
fn: l2_contract_type (const: @(LmP0Node node)) @: L2TypeContract
    @: LmP0Field field
    @: L2TypeContract operand
    int: kind
    int: depth
    if: node = 0 || node\as = 0
        return: 0
    if: node\kind = c.LM_P0_NODE_ATOM
        return: l2_contract_new(0, 0, node\as\atom, 0)
    if: node\kind = c.LM_P0_NODE_STRUCTURE
        if: node\as\structure = 0 || l2_count_active(node\as\structure) != 1
            return: 0
        return: l2_contract_type(l2_next_active(node\as\structure\first_field)\value)
    if: node\kind != c.LM_P0_NODE_FRAME || node\as\frame = 0 || node\as\frame\body = 0 || l2_count_active(node\as\frame\body) != 1
        return: 0
    kind: 0
    depth: l2_address_depth(node\as\frame\head)
    if: depth != 0
        kind: 2
    if: l2_frame_head(node, "[]") != 0
        kind: 1
    if: l2_frame_head(node, "const") != 0
        kind: 3
    if: l2_frame_head(node, "immutable") != 0
        kind: 4
    if: l2_frame_head(node, "independent") != 0
        kind: 5
    if: kind = 0
        return: 0
    field: l2_next_active(node\as\frame\body\first_field)
    operand: l2_contract_type(field\value)
    if: operand = 0
        return: 0
return: l2_contract_new(kind, depth, 0, operand)

# An explicit enclosing type receiver supplies the not-yet-specified operand
# of a constructor. This copies contract nodes, not source or runtime values.
fn: l2_contract_supply (@: L2TypeContract target; @: L2TypeContract supplied) @: L2TypeContract
    @: L2TypeContract operand
    if: target = 0
        return: supplied
    if: target\kind = 0
        return: 0
    operand: l2_contract_supply(target\operand, supplied)
    if: operand = 0
        return: 0
return: l2_contract_new(target\kind, target\depth, target\word, operand)

# 1 when no declaration is read from frame: the binding resolved it as a call, or resolved as
# one a Frame its reading passes through -- the single field of a Frame, when that is a Frame,
# as l2_declaration reads a nested declaration.
fn: l2_declaration_meets_call (const: @(LmP0Frame frame)) int
    @: LmP0Field first
    if: l2_bnd_n = 0
        return: 0
    while: frame != 0 && frame\body != 0
        if: l2_bound_find(frame\body) >= 0
            return: 1
        first: l2_next_active(frame\body\first_field)
        if: first = 0 || first\value = 0 || l2_next_active(first\next) != 0
            return: 0
        frame: l2_application(first\value)
    ---
return: 0

# Derive a receiving contract without choosing an operation. Lexical resolution
# decides whether the proposed binding is absent or names an existing value.
fn: l2_declaration (const: @(LmP0Node node)) @: L2Declaration
    @: L2Declaration result l2_declarations
    @: L2Declaration inner 0
    @: L2TypeContract contract 0
    @: LmP0Frame frame l2_application(node)
    @: LmP0Field first
    @: LmP0Field name_field 0
    @: LmP0Field candidate 0
    @: LmP0Text name 0
    @: LmP0Text extent 0
    int: count 0
    int: n
    int: kind 0
    int: depth
    # A Frame the binding resolved as a call has that role for every reader: it
    # declares nothing, and the Frames that name its actuals are not a type, a
    # name and a candidate.  The role is asked before the cache: a classification
    # made before the binding does not outlive it, nor does one read through it.
    if: l2_declaration_meets_call(frame) != 0
        return: 0
    # K03 NS-ROLES-1: a kept reference binding `b: A` declares b as `@: M b A` would (l2_rb_declaration).
    if: l2_rb_find(node) != 0
        return: l2_rb_declaration(node)
    while: result != 0
        if: result\source = node
            return: result
        result: result\allocated_next
    ---
    if: frame = 0
        return: 0
    if: frame\head = 0 || frame\body = 0 || frame\trailer != 0 || frame\body\trailer != 0
        return: 0
    first: l2_next_active(frame\body\first_field)
    n: l2_count_active(frame\body)
    if: first = 0 || first\value = 0 || n < 1
        return: 0
    depth: l2_address_depth(frame\head)
    if: depth != 0
        kind: 2
    if: l2_text_eq(frame\head, "[]") != 0
        kind: 1
    if: l2_text_eq(frame\head, "const") != 0
        kind: 3
    if: l2_text_eq(frame\head, "immutable") != 0
        kind: 4
    if: l2_text_eq(frame\head, "independent") != 0
        kind: 5
    if: n = 1 && first\value\kind = c.LM_P0_NODE_FRAME
        inner: l2_declaration(first\value)
        if: inner = 0
            return: 0
        name: inner\name
        candidate: inner\candidate
        count: inner\candidate_count
        extent: inner\extent
        if: kind != 0
            contract: l2_contract_new(kind, depth, 0, inner\contract)
        else:
            contract: l2_contract_new(0, 0, frame\head, 0)
            contract: l2_contract_supply(inner\contract, contract)
        ---
    else:
        if: kind >= 3
            return: 0
        if: kind = 2 || (kind = 1 && n = 3)
            contract: l2_contract_type(first\value)
            if: contract = 0
                return: 0
            contract: l2_contract_new(kind, depth, 0, contract)
            name_field: l2_next_active(first\next)
        else:
            name_field: first
            if: kind = 1
                contract: l2_contract_new(1, 0, 0, 0)
            else:
                contract: l2_contract_new(0, 0, frame\head, 0)
            ---
        ---
        if: name_field = 0 || name_field\value = 0 || name_field\value\kind != c.LM_P0_NODE_ATOM || name_field\value\as = 0 || l2_bind_spelling(name_field\value\as\atom) = 0
            return: 0
        name: name_field\value\as\atom
        candidate: l2_next_active(name_field\next)
        if: kind = 1 && n = 3
            if: candidate = 0 || candidate\value = 0 || candidate\value\kind != c.LM_P0_NODE_ATOM
                return: 0
            extent: candidate\value\as\atom
            candidate: 0
        ---
        name_field: candidate
        while: name_field != 0
            count: count + 1
            name_field: l2_next_active(name_field\next)
        ---
    ---
    if: contract = 0 || name = 0
        return: 0
    result: (cast: (@: L2Declaration) l2_xmalloc(c.sizeof(c.L2Declaration)))
    if: result = 0
        return: 0
    result\source: (cast: (@: LmP0Node) node)
    result\contract: contract
    result\name: name
    result\candidate: candidate
    result\candidate_count: count
    result\extent: extent
    result\allocated_next: l2_declarations
    l2_declarations: result
return: result

# Project an explicit non-Array contract onto the existing ABI vocabulary.
# Qualifiers and references are traversed generically, never by source form.
fn: l2_contract_leaf (@: L2TypeContract contract; @: int depth; @: int qualified) @: LmP0Text
    \depth: 0
    \qualified: 0
    while: contract != 0 && contract\kind != 0
        if: contract\kind = 2
            \depth: \depth + contract\depth
        else:
            if: contract\kind = 3
                \qualified: 1
            else:
                return: 0
            ---
        ---
        contract: contract\operand
    ---
    if: contract = 0
        return: 0
return: contract\word

fn: l2_contract_formal (@: L2TypeContract contract; @: int out_ty) int
    int: depth
    int: qualified
    int: resolved_depth
    int: resolved_qualified
    LmP0Text: resolved_word
    @: LmP0Text word l2_contract_leaf(contract, @ depth, @ qualified)
    if: word = 0
        return: 1
    if: depth != 0
        if: qualified != 0
            if: depth = 1 && l2_kernel_ptr_word(word, out_ty) = 0
                return: 0
            if: l2_ptr_type_word(word, depth, out_ty) = 0
                if: l2_type_parts(\out_ty, @ resolved_word, @ resolved_depth, @ resolved_qualified) != 0
                    return: 1
                \out_ty: l2_foreign_intern(@ resolved_word, resolved_depth, 1)
                if: \out_ty < 100
                    return: 1
                return: 0
            ---
            return: l2_resolve_type_atom(word, depth, 1, out_ty)
        ---
        if: l2_ptr_type_word(word, depth, out_ty) = 0
            return: 0
        return: l2_resolve_type_atom(word, depth, 0, out_ty)
    ---
    if: l2_type_model(word) >= 0 || l2_site_method(l2_here_mi, word) >= 0
        \out_ty: l2_graph_ft()
        if: \out_ty = 0
            return: 1
        return: 0
    if: l2_ret_type_word(word, 0, qualified, out_ty) != 0
        return: 1
    if: \out_ty = 33
        \out_ty: 34
return: 0

fn: l2_contract_own (@: L2TypeContract contract) int
    int: ty
    int: depth
    int: qualified
    @: LmP0Text word
    if: contract = 0
        return: 0
    if: contract\kind = 1
        if: contract\operand = 0
            return: 0
        if: contract\operand\kind = 2
            if: l2_contract_formal(contract\operand, @ ty) != 0
                return: 0
            return: l2_oc_parray(ty)
        ---
        if: contract\operand\kind != 0
            return: 0
        word: contract\operand\word
        if: l2_text_eq(word, "int") != 0
            return: 4
        if: l2_text_eq(word, "char") != 0
            return: 5
        if: l2_text_eq(word, "size_t") != 0
            return: 7
        if: l2_text_eq(word, "ulong") != 0
            return: 37
        return: 0
    ---
    word: l2_contract_leaf(contract, @ depth, @ qualified)
    if: word = 0
        return: 0
    if: depth > 0
        if: l2_contract_formal(contract, @ ty) != 0
            return: 0
        return: l2_own_ty_of_param(ty)
    if: qualified != 0
        return: 0
    if: l2_text_eq(word, "int") != 0
        return: 3
    if: l2_text_eq(word, "char") != 0
        return: 1
    if: l2_text_eq(word, "size_t") != 0
        return: 2
    if: l2_text_eq(word, "unsigned") != 0
        return: 6
    if: l2_text_eq(word, "ulong") != 0
        return: 36
return: 0

fn: l2_ptr_local_ty (const: @(LmP0Node stmt); @@: LmP0Text out_name; @: int out_ty) int
    @: L2Declaration application l2_declaration(stmt)
    if: out_name = 0 || out_ty = 0
        return: 1
    \out_name: 0
    \out_ty: 0
    if: application = 0 || application\contract\kind != 2
        return: 1
    \out_name: application\name
return: l2_contract_formal(application\contract, out_ty)

fn: l2_const_local_ty (const: @(LmP0Node stmt); @@: LmP0Text out_name; @: int out_ty) int
    @: L2Declaration application l2_declaration(stmt)
    int: depth
    int: qualified
    @: LmP0Text word
    if: out_name = 0 || out_ty = 0
        return: 1
    \out_name: 0
    \out_ty: 0
    if: application = 0 || application\contract\kind != 3
        return: 1
    word: l2_contract_leaf(application\contract, @ depth, @ qualified)
    if: word = 0 || depth = 0
        return: 1
    \out_name: application\name
return: l2_contract_formal(application\contract, out_ty)


# Return types whose zero is unsigned: size_t, unsigned, ulong (old LmxMsgAddr folded into unsigned). They part company
# only where the type is printed, never where a zero is produced.
fn: l2_ret_uns (int: mi) int
    if: mi < 0 || l2_m_ret = 0
        return: 0
    if: l2_m_ret[mi] = 2 || l2_m_ret[mi] = 33 || l2_m_ret[mi] = 36
        return: 1
return: 0

# WHAT STOOD HERE AND IS GONE (FABLE-SONNET-NAME-SPECIALS-20260924-155 commit 4):
# l2_array_local, the L2 c.array: [char name size] local-declarator special (plan
# §7a "L2 c.array (declarator, not a call)"). Measured (commit 1, steps/name-
# specials-inventory.md): zero current .lm2 fixtures use the L2-level form (all
# migrated to ordinary own-array locals, 17d54bc); its 5 call sites (l2_ml_collect,
# l2_check_fields, and l2_emit_loc_stmt's guard + its own emission arm) are deleted
# alongside it. c.array: in an L2 source is now just an ordinary c.* raw-door frame
# -- door text the C compiler checks, no L2-side recognition, no replacement syntax,
# no helper. The translator's own L1 buffers and the L1 it emits for a row of N
# cells use []: (author, 2026-09-26). @: T name remains one pointer.

fn: l2_check_os_fn (const: @(LmP0Node fn); const: @(char path)) int
    @: LmP0Field f
    @: LmP0Field p
    @: LmP0Field ty
    @: LmP0Field inner
    @: LmP0Structure tr
    @: LmP0Field r
    if: fn = 0 || l2_frame_head(fn, "fn") = 0 || fn\as = 0 || fn\as\frame = 0 || fn\as\frame\body = 0
        return: l2_error(path, fn, "unsupported body")
    if: l2_count_active(fn\as\frame\body) != 3
        return: l2_error(path, fn, "unsupported body")
    f: l2_next_active(fn\as\frame\body\first_field)
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM || l2_ident(f\value\as\atom) = 0
        return: l2_error(path, fn, "incompatible entry signature")
    p: l2_next_active(f\next)
    if: p = 0 || l2_empty_struct(p\value) = 0
        return: l2_error(path, fn, "incompatible entry signature")
    ty: l2_next_active(p\next)
    if: ty = 0 || ty\value = 0 || l2_frame_head(ty\value, "@") = 0 || ty\value\as = 0 || ty\value\as\frame = 0 || ty\value\as\frame\body = 0
        return: l2_error(path, fn, "incompatible entry signature")
    if: l2_count_active(ty\value\as\frame\body) != 1
        return: l2_error(path, fn, "incompatible entry signature")
    inner: l2_next_active(ty\value\as\frame\body\first_field)
    if: inner = 0 || inner\value = 0 || inner\value\kind != c.LM_P0_NODE_ATOM || l2_text_eq(inner\value\as\atom, "char") = 0
        return: l2_error(path, fn, "incompatible entry signature")
    tr: l2_ret_tr(fn\as\frame)
    if: tr = 0
        return: l2_error(path, fn, "unsupported body")
    if: l2_count_active(tr) != 1
        return: l2_error(path, fn, "unsupported argument")
    r: l2_next_active(tr\first_field)
    if: r = 0 || r\value = 0 || r\value\kind != c.LM_P0_NODE_ATOM || l2_quoted(r\value\as\atom) = 0
        return: l2_error(path, fn, "unsupported argument")
return: 0

fn: l2_os_fn_name (const: @(LmP0Node fn)) @: LmP0Text
    @: LmP0Field f
    if: fn = 0 || fn\as = 0 || fn\as\frame = 0 || fn\as\frame\body = 0
        return: 0
    f: l2_next_active(fn\as\frame\body\first_field)
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM
        return: 0
return: f\value\as\atom

fn: l2_os_branches_match (const: @(LmP0Structure first); const: @(LmP0Structure other); const: @(char path)) int
    @: LmP0Field a
    @: LmP0Field b
    @: LmP0Text an
    @: LmP0Text bn
    if: first = 0 || other = 0
        return: l2_error(path, 0, "unsupported body")
    a: l2_next_active(first\first_field)
    b: l2_next_active(other\first_field)
    while: a != 0 && b != 0
        an: l2_os_fn_name(a\value)
        bn: l2_os_fn_name(b\value)
        if: an = 0 || bn = 0 || l2_text_same(an, bn) = 0
            return: l2_error(path, b\value, "incompatible os branches")
        a: l2_next_active(a\next)
        b: l2_next_active(b\next)
    if: a != 0 || b != 0
        return: l2_error(path, 0, "incompatible os branches")
return: 0

fn: l2_check_os (const: @(LmP0Node item); const: @(char path)) int
    @: LmP0Field b
    @: LmP0Field f
    const: @: LmP0Structure first 0
    if: item = 0 || l2_frame_head(item, "os") = 0 || item\as = 0 || item\as\frame = 0 || item\as\frame\body = 0
        return: l2_error(path, item, "unsupported body")
    b: l2_next_active(item\as\frame\body\first_field)
    if: b = 0
        return: l2_error(path, item, "unsupported body")
    while: b != 0
        if: l2_frame_head(b\value, "win") = 0 && l2_frame_head(b\value, "default") = 0
            return: l2_error(path, b\value, "unsupported body")
        if: b\value\as = 0 || b\value\as\frame = 0 || b\value\as\frame\body = 0
            return: l2_error(path, b\value, "unsupported body")
        f: l2_next_active(b\value\as\frame\body\first_field)
        if: f = 0
            return: l2_error(path, b\value, "unsupported body")
        while: f != 0
            if: l2_check_os_fn(f\value, path) != 0
                return: 1
            f: l2_next_active(f\next)
        if: first = 0
            first: b\value\as\frame\body
        else:
            if: l2_os_branches_match(first, b\value\as\frame\body, path) != 0
                return: 1
            ---
        b: l2_next_active(b\next)
return: 0

fn: l2_collect_os_methods (const: @(LmP0Node item); const: @(char path)) int
    @: LmP0Field branch
    @: LmP0Field method
    if: item = 0 || item\as = 0 || item\as\frame = 0 || item\as\frame\body = 0
        return: l2_error(path, item, "unsupported body")
    branch: l2_next_active(item\as\frame\body\first_field)
    if: branch = 0 || branch\value = 0 || branch\value\as = 0 || branch\value\as\frame = 0 || branch\value\as\frame\body = 0
        return: l2_error(path, item, "unsupported body")
    method: l2_next_active(branch\value\as\frame\body\first_field)
    while: method != 0
        if: l2_collect_method(method\value, path, -1) != 0
            return: 1
        method: l2_next_active(method\next)
return: 0

fn: l2_method_is_os (int: mi) int
    @: LmP0Field branch
    @: LmP0Field method
    if: mi < 0 || mi >= l2_m_n || l2_os_node = 0 || l2_os_node\as = 0 || l2_os_node\as\frame = 0 || l2_os_node\as\frame\body = 0
        return: 0
    branch: l2_next_active(l2_os_node\as\frame\body\first_field)
    if: branch = 0 || branch\value = 0 || branch\value\as = 0 || branch\value\as\frame = 0 || branch\value\as\frame\body = 0
        return: 0
    method: l2_next_active(branch\value\as\frame\body\first_field)
    while: method != 0
        if: method\value = l2_m_node[mi]
            return: 1
        method: l2_next_active(method\next)
return: 0

fn: l2_emit_os_fn (@: FILE out; const: @(LmP0Node fn); const: @(char ind)) int
    @: LmP0Field f
    @: LmP0Structure tr
    @: LmP0Field r
    @: LmP0Text name
    int: mi
    if: out = 0 || fn = 0 || fn\as = 0 || fn\as\frame = 0 || fn\as\frame\body = 0
        return: 1
    f: l2_next_active(fn\as\frame\body\first_field)
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM
        return: 1
    name: f\value\as\atom
    mi: l2_find_method(name)
    if: mi < 0 || l2_method_is_os(mi) = 0
        return: 1
    if: fputs(ind, out) < 0
        return: 1
    if: fputs("fn: ", out) < 0
        return: 1
    if: l2_write_sym(out, mi) != 0
        return: 1
    if: l2_emit_sig(mi) != 0 || fputs("\n", out) < 0
        return: 1
    if: c.fprintf(out, "%s    if: self = 0\n%s        c.fprintf(c.stderr, \"lmx: invariant: a method was entered without its occurrence\\n\")\n%s        c.abort()\n", ind, ind, ind) < 0
        return: 1
    if: l2_emit_poll(mi, "            ") != 0
        return: 1
    tr: l2_ret_tr(fn\as\frame)
    if: tr = 0
        return: 1
    r: l2_next_active(tr\first_field)
    if: r = 0 || r\value = 0 || r\value\kind != c.LM_P0_NODE_ATOM
        return: 1
    if: c.fprintf(out, "%s    ", ind) < 0
        return: 1
    if: fputs("return: ", out) < 0
        return: 1
    if: l2_write_text(out, r\value\as\atom) != 0
        return: 1
    if: fputs("\n", out) < 0
        return: 1
    if: fputs(ind, out) < 0 || fputs("end: ", out) < 0 || l2_write_sym(out, mi) != 0 || fputs("\n", out) < 0
        return: 1
return: 0

fn: l2_emit_os (@: FILE out) int
    @: LmP0Field b
    @: LmP0Field f
    if: out = 0 || l2_os_node = 0 || l2_os_node\as = 0 || l2_os_node\as\frame = 0 || l2_os_node\as\frame\body = 0
        return: 0
    if: fputs("os:\n", out) < 0
        return: 1
    b: l2_next_active(l2_os_node\as\frame\body\first_field)
    while: b != 0
        if: l2_frame_head(b\value, "win") = 0 && l2_frame_head(b\value, "default") = 0
            return: 1
        if: fputs("    ", out) < 0
            return: 1
        if: l2_write_text(out, b\value\as\frame\head) != 0
            return: 1
        if: fputs(":\n", out) < 0
            return: 1
        if: b\value\as = 0 || b\value\as\frame = 0 || b\value\as\frame\body = 0
            return: 1
        f: l2_next_active(b\value\as\frame\body\first_field)
        while: f != 0
            if: l2_emit_os_fn(out, f\value, "        ") != 0
                return: 1
            f: l2_next_active(f\next)
        b: l2_next_active(b\next)
    if: fputs("end: os\n", out) < 0
        return: 1
return: 0

fn: l2_formal_find (int: mi; const: @(LmP0Text t)) int
    int: i 0
    if: mi < 0 || t = 0
        return: -1
    while: i < l2_m_arity[mi]
        if: l2_text_same(l2_fn(mi, i), t)
            return: i
        i: i + 1
return: -1

fn: l2_dyn_find (int: mi; const: @(LmP0Text t)) int
    int: i 0
    if: mi < 0 || t = 0
        return: -1
    while: i < l2_m_dyn[mi]
        if: l2_text_same(l2_dn(mi, i), t)
            return: i
        i: i + 1
return: -1

fn: l2_param_find (int: mi; const: @(LmP0Text t)) int
    int: fi
    int: di
    fi: l2_formal_find(mi, t)
    if: fi >= 0
        return: fi
    di: l2_dyn_find(mi, t)
    if: di >= 0
        return: l2_m_arity[mi] + di
return: -1

fn: l2_param_is (int: mi; const: @(LmP0Text t)) int
    if: mi < 0 || t = 0
        return: 0
    if: l2_formal_find(mi, t) >= 0
        return: 1
    if: l2_dyn_find(mi, t) >= 0
        return: 1
return: 0

fn: l2_param_ty (int: mi; const: @(LmP0Text t)) int
    int: fi
    int: di
    if: mi < 0 || t = 0
        return: 0
    fi: l2_formal_find(mi, t)
    if: fi >= 0
        return: l2_ft(mi, fi)
    di: l2_dyn_find(mi, t)
    if: di >= 0 && l2_dt(mi, di) != 0
        return: l2_ft_of_own(l2_own_of_dt(l2_dt(mi, di)))
return: 0

# Is this statement an assignment to its head?  mi is the method the statement stands in, or -1
# for a caller that has no site.
fn: l2_is_asgn (const: @(LmP0Node stmt); int: mi) int
    const: @: LmP0Text h
    int: fi 0
    if: stmt = 0 || stmt\kind != c.LM_P0_NODE_FRAME || stmt\as = 0 || stmt\as\frame = 0
        return: 0
    if: l2_own_decl_ty(stmt) != 0
        return: 0
    h: stmt\as\frame\head
    if: h = 0 || l2_ident(h) = 0
        return: 0
    # K03 S5: a word of the language heads no assignment: the statement is the word's application (l2_head_word).
    if: l2_head_word(h) != 0
        return: 0
    # The head's role at the statement's site is the one a call head has there
    # (l2_call_head_method).  A head that calls -- a method, or what a callable
    # formal carries -- is no assignment in any spelling.  A binding of the site
    # that is no callable is assigned to, though a method of the unit has its
    # name.  A caller with no site asks the unit's methods alone.
    if: mi >= 0 && l2_call_head_method(mi, h, @ fi) >= 0
        return: 0
    # So is a head that names a held callable of the site (l2_call_head_held);
    # the statement that stores the callable merge is that binding's own.
    if: mi >= 0 && l2_mad_declaring(stmt, mi) = 0 && l2_call_head_held(mi, h) >= 0
        return: 0
    if: mi < 0 && l2_site_method(0 - 1, h) >= 0
        return: 0
    if: l2_is_known(h) || l2_predef_receiver(h) != 0
        return: 0
    if: h\length >= 2U && h\data[0] = 99 && h\data[1] = 46
        return: 0
    if: stmt\as\frame\body = 0
        return: 0
return: 1

# A bare colon frame has two roles.  If its right-hand atom already denotes a
# value, the frame keeps the ordinary assignment spelling `target: value`.
# Otherwise a graph-valued receiver in the head declares that atom by making a
# full merge copy of the receiver.  Normalize the second role to the one
# existing merge form before free-name, throws, checking and emission run, so
# there is one branch-creation path and no emitter-only constructor shortcut.
fn: l2_colon_model (const: @(LmP0Text name)) int
    int: ni
    if: name = 0
        return: 0
    ni: l2_ns_find(name)
    if: ni >= 0 && l2_ns_parent[ni] < 0
        return: 1
    if: l2_ebr_find(name) >= 0 || l2_mres_find(l2_here_mi, name) >= 0
        return: 1
return: 0

# THE GRAPH REFERENCE -- a Structure or a callable held by reference -- in each code space (OWN-TYPE-CODE-BANDS).
# Its formal code is one named code of the formal space, as the Message reference's (l2_msg_ref_ty) is: formal tables
# -- formals, results, contracts, addresses -- hold it and nothing of another space.  Its own storage is the pointer
# own of the real source type `Lmx *`, and its dynamic-input code is that own's.  Each interns `Lmx *` where it is
# asked, as the one code before them did, so the foreign types keep their order; 0 (-1 for the own) when it cannot.
# l2_graph_code is the formal code alone: a reader compares with it and interns nothing.
fn: l2_graph_code () int
return: 42

fn: l2_graph_ft () int
    if: l2_foreign_intern(l2_lmx_text(), 1, 0) < 100
        return: 0
return: l2_graph_code()

fn: l2_graph_own () int
    int: ft l2_foreign_intern(l2_lmx_text(), 1, 0)
    if: ft < 100
        return: -1
return: l2_oc_pointer(ft)

fn: l2_graph_dt () int
    int: own l2_graph_own()
    if: own < 0
        return: 0
return: l2_dt_of_own(own)

# Whether own code oty holds a graph reference: a pointer whose formal type is one (an own code is never read as a
# formal one).
fn: l2_own_is_graph (int: oty) int
    if: l2_oc_is_pointer(oty) = 0
        return: 0
return: l2_colon_is_graph_ty(l2_oc_ft(oty))

fn: l2_colon_is_graph_ty (int: ty) int
    int: fi
    # A formal code: the graph code itself, or `Lmx *` written as a foreign type.
    if: ty = l2_graph_code()
        return: 1
    if: ty < 100
        return: 0
    fi: ty - 100
    if: fi < 0 || fi >= l2_foreign_n
        return: 0
    if: l2_foreign_depth[fi] != 1 || l2_foreign_const[fi] != 0
        return: 0
return: l2_text_eq(l2_foreign_name[fi], "Lmx")

# Layout collection sees every own slot before execution.  That is deliberately
# not the same thing as a binding existing at this colon.  Only formals and
# declarations already passed in this body make the tail an update value.
fn: l2_colon_bound_before (const: @(LmP0Structure body); const: @(LmP0Node stop); int: mi; const: @(LmP0Text name)) int
    @: LmP0Field f
    @: LmP0Text dn
    int: prior
    if: name = 0
        return: 0
    if: l2_param_find(mi, name) >= 0
        return: 1
    if: body != 0
        f: l2_next_active(body\first_field)
        while: f != 0 && f\value != stop
            # Every receiver/computed declaration has the same exact source
            # row. Already collected declarations establish a binding before
            # later statements, even before merge schemas have been built.
            prior: l2_own_by_decl(mi, f\value)
            if: prior >= 0 && l2_text_same(l2_own_name[prior], name) != 0
                return: 1
            if: l2_own_decl_ty(f\value) != 0
                dn: l2_own_decl_name(f\value)
                if: l2_text_same(dn, name)
                    return: 1
                ---
            # A field declared by a letter (`receiveMessage: name`) or the empty Structure (`name()`) is bound after its
            # statement as well.
            if: l2_receive_msg_shape(f\value, @ dn, 0) = 0 && l2_text_same(dn, name) != 0
                return: 1
            if: l2_empty_call_shape(f\value) != 0 && l2_text_same(f\value\as\frame\head, name) != 0
                return: 1
            f: l2_next_active(f\next)
        ---
    if: l2_ns_find(name) >= 0 || l2_ebr_find(name) >= 0 || l2_mres_find(mi, name) >= 0 || l2_find_method(name) >= 0 || l2_is_known(name)
        return: 1
return: 0

# Type codes here are the translator's existing formal/local codes.  Two
# negative codes are intrinsic literal classes: a numeric literal has no
# declared width yet, and a quoted literal is a character pointer value.
fn: l2_colon_bound_ty (int: mi; const: @(LmP0Text name); @: int out_ty) int
    int: i
    if: name = 0 || out_ty = 0
        return: 1
    i: l2_resolved_own(mi, name)
    if: i >= 0
        \out_ty: l2_value_ft_of_own(l2_own_ty[i])
        return: 0
    i: l2_formal_find(mi, name)
    if: i >= 0
        \out_ty: l2_ft(mi, i)
        return: 0
    if: l2_mad_host_of(mi) >= 0
        i: l2_formal_find(l2_mad_host_of(mi), name)
        if: i >= 0
            \out_ty: l2_ft(l2_mad_host_of(mi), i)
            return: 0
        # T6b: a field the host declares at method level is its activation too.
        i: l2_mad_host_own(l2_mad_host_of(mi), name)
        if: i >= 0
            \out_ty: l2_value_ft_of_own(l2_own_ty[i])
            return: 0
        ---
    i: l2_dyn_find(mi, name)
    if: i >= 0 && l2_dt(mi, i) != 0
        \out_ty: l2_ft_of_own(l2_own_of_dt(l2_dt(mi, i)))
        return: 0
    if: i >= 0
        return: 1
    i: l2_own_visible(mi, name)
    if: i >= 0
        \out_ty: l2_value_ft_of_own(l2_own_ty[i])
        return: 0
    i: l2_slot_find(mi, name)
    if: i >= 0
        \out_ty: l2_st[l2_slot_off(mi, i)]
        return: 0
    i: l2_ml_find(name)
    if: i >= 0
        \out_ty: l2_ml_ty[i]
        return: 0
    ---
return: 1

fn: l2_colon_simple_ty (const: @(LmP0Node value); int: mi; @: int out_ty) int
    int: m
    int: formal
    int: levels
    LmP0Text: base
    L2IndexedOperand: indexed_value
    @: L2IndexedOperand indexed @ indexed_value
    L2Address: address_value
    @: L2Address address @ address_value
    const: @: LmP0Text atom
    if: value = 0 || out_ty = 0 || value\as = 0
        return: 1
    if: l2_indexed_node(value, mi, indexed) = 0
        \out_ty: indexed\type
        return: 0
    if: l2_address_node(value, mi, address) = 0 && address\type >= 0
        \out_ty: address\type
        return: 0
    if: value\kind = c.LM_P0_NODE_ATOM
        atom: value\as\atom
        # A held callable's bare name received as its result has the type of that result.
        if: l2_held_result_site(value) != 0
            return: l2_mad_held_value_ty(l2_call_head_held(mi, atom), out_ty)
        # K03 S6: so has a binding `b: tick` (NS-ROLES-1b) named where a value is consumed: it is tick's call
        # (callable-first; l2_check_primary checks it), its value tick's result, as l2_native_cf_ty types it in an operand.
        if: l2_call_alias_own(mi, atom) >= 0
            return: l2_colon_ret_ty(l2_rb_meth_of(l2_own_decl[l2_call_alias_own(mi, atom)]), out_ty)
        if: l2_deref_word(atom, mi, @ base, @ levels, out_ty) = 0
            return: 0
        if: l2_num(atom) || l2_signed_num(atom) || (atom != 0 && atom\length >= 3U && atom\data[0] = 39 && atom\data[atom\length - 1U] = 39)
            \out_ty: -10
            return: 0
        if: l2_quoted(atom)
            \out_ty: -11
            return: 0
        if: l2_c_stmt_door(atom) != 0
            \out_ty: -12
            return: 0
        return: l2_colon_bound_ty(mi, atom, out_ty)
    if: value\kind != c.LM_P0_NODE_FRAME || value\as\frame = 0 || value\as\frame\head = 0
        return: 1
    # A prefix sign applied to a group: the group's own type, promoted as C
    # promotes it; a group that is a literal alone is a number literal. A
    # reference or a text under the sign has no type here: the kind rule says
    # what it is (l2_prefix_kind_refused).
    if: l2_prefix_frame(value) != 0
        m: l2_prefix_native_ty(l2_native_group_ty(value\as\frame\body\first_field, l2_count_active(value\as\frame\body), mi), value)
        if: m = 0 - 1 || m = 0 - 2
            \out_ty: -10
            return: 0
        if: m >= 0 && l2_prim_code_name(m) != 0
            \out_ty: m
            return: 0
        return: 1
    # sizeof: / length are operators whose result is size_t (storage bytes / element count).  Applied to nothing the
    # application has no value: its contract says why where it is checked (l2_check_word_value), not a conversion.
    if: l2_text_eq(value\as\frame\head, "sizeof") || l2_text_eq(value\as\frame\head, "length")
        if: l2_count_active(l2_app_actuals(value)) = 0
            return: 1
        \out_ty: 2
        return: 0
    ---
    if: l2_text_eq(value\as\frame\head, "cast") && value\as\frame\body != 0 && l2_count_active(value\as\frame\body) >= 2
        return: l2_cast_resolve(l2_next_active(value\as\frame\body\first_field)\value, out_ty, 0)
    ---
    # A call by name or through a callable field path (`Holder\viaPath(4U)`).
    m: l2_call_head_method(mi, value\as\frame\head, @ formal)
    # D-106: a callable formal of this method shadows a unit method of its name -- typed as when the
    # unit has no such method.
    if: m >= 0 && l2_head_is_callable_formal(mi, value\as\frame\head) != 0
        m: 0 - 1
    # A predef'd C function (l2_is_known: the c.* door, or a name the unit's
    # own predef: files declare) is an external ABI leaf, not an L2 method
    # l2_head_method can find. Assigning its result already works in every
    # non-assignment expression context (`if: lm_p0_parse_file(...) != 0`,
    # entry_parse_min.lm2), which needs no type at all; only this narrower
    # `target: call()` compatibility pre-check did not (Opus's finding 2,
    # FABLE-SONNET-DECL-PREPASS-20260923-137 part 3: "assignment value has
    # unknown type"). FABLE-SONNET-PREDEF-RESULT-TYPE-20260924-160 commit 2
    # (steps/predef-result-type-inventory.md): l2_predef_result_ty reads the
    # function's own prototype: declaration for its real return type (the
    # same file l2_is_known already re-parses for the yes/no check) -- a
    # predef'd function's result now carries its declared type, the same as
    # a real L2 method's would. A raw C result is opaque to L2 (-12), not a
    # numeric literal: its receiving C type checks the expression. No C-name
    # dictionary is inferred here.
    if: m < 0 && l2_is_known(value\as\frame\head) != 0
        # A predef function's result is its prototype's; an unreadable one is
        # an unknown type (D-88), distinct from the explicitly raw C door.
        int: rt
        rt: l2_predef_result_ty(value\as\frame\head, out_ty)
        if: rt = 2
            return: 1
        if: rt = 0 && (value\as\frame\head\length < 3U || value\as\frame\head\data[0] != 99 || value\as\frame\head\data[1] != 46)
            return: 1
        if: rt = 0
            \out_ty: -12
        return: 0
    if: m < 0 && l2_ml_find(value\as\frame\head) >= 0 && l2_ml_ty[l2_ml_find(value\as\frame\head)] = 40
        # The declared C function-pointer ABI checks this result at its
        # receiving C type. It is neither an unresolved name nor an int.
        \out_ty: -12
        return: 0
    # A held callable's call has the type of its header's result.
    if: m < 0 && l2_call_head_held(mi, value\as\frame\head) >= 0
        return: l2_mad_held_value_ty(l2_call_head_held(mi, value\as\frame\head), out_ty)
    if: m < 0
        return: 1
return: l2_colon_ret_ty(m, out_ty)

# A result's ABI spelling projected once into ordinary consumed-value codes.
# Parsing nested predefs keeps raw result codes until this common boundary.
fn: l2_result_value_ty (int: code) int
    if: code = 33
        return: 34
    if: code = 3
        return: 12
    if: code = 35
        return: 3
    if: code = 32
        return: 17
return: code

# The type method m's call gives as a value, in the codes an assignment's check compares.
fn: l2_colon_ret_ty (int: m; @: int out_ty) int
    # A named-Structure return holds the graph code; its value is spelled `Lmx *`, as l2_colon_bound_ty's own-field
    # branch gives it (l2_ft_of_own(l2_own_ty[i])) -- a call result's type must match it, or `target: b\value` from
    # `Model: fresh` two lines above stays the only working consumer of a Structure result
    # (FABLE-SONNET-DECL-PREPASS-20260923-137 part 2).
    \out_ty: l2_result_value_ty(l2_formal_raw(l2_m_ret[m]))
return: 0

# THE WHOLE VALUE OF AN ASSIGNMENT, TYPED (plan §7b "Локальные объявления и явная инициализация": the author's computed
# initialization `int: i` / `i: findValue`).  A callable named where a value is consumed gives its result -- bare, it
# runs with no arguments; the binding's kind decides, not the place (callable-first, FABLE-OPUS-RECEIVER-CONTRACT-
# 20260924-139; l2_check_primary) -- so its type is the result's, as its call gives it: a callable formal of this
# method, bare or called, by its contract (l2_colon_simple_ty types it bare as the formal, @: Lmx, and called not at
# all -- D-106), else a bare name bound to nothing by the unit method of that name.  Any other value:
# l2_colon_simple_ty's type.  A callable without a result gives 8, which the check refuses as no value.  The
# assignment's check (l2_colon_check_assignment) and its store's conversion (l2_convert_on_store) type the value alike.
fn: l2_colon_value_ty (const: @(LmP0Node value); int: mi; @: int out_ty) int
    const: @: LmP0Text t 0
    int: k
    int: formal
    if: value = 0 || value\as = 0 || out_ty = 0
        return: 1
    if: value\kind = c.LM_P0_NODE_ATOM
        t: value\as\atom
    if: value\kind = c.LM_P0_NODE_FRAME && value\as\frame != 0
        t: value\as\frame\head
    if: t != 0 && mi >= 0
        k: l2_call_head_method(mi, t, @ formal)
        if: k >= 0 && formal >= 0
            return: l2_colon_ret_ty(k, out_ty)
        ---
    if: l2_colon_simple_ty(value, mi, out_ty) = 0
        return: 0
    if: value\kind != c.LM_P0_NODE_ATOM || t = 0
        return: 1
    k: l2_call_head_method(mi, t, @ formal)
    if: k < 0
        return: 1
return: l2_colon_ret_ty(k, out_ty)

# Formal/value codes that name a primitive leaf. Pointer codes are not these
# names: mapping them would make `@: int` implement `@: char`.
fn: l2_prim_code_name (int: ty) @: char
    if: ty = 0
        return: "int"
    if: ty = 1
        return: "char"
    if: ty = 2
        return: "size_t"
    if: ty = 34
        return: "unsigned"
    if: ty = 36
        return: "ulong"
    if: ty = 8
        return: "void"
    return: 0

# The receiver `table` (Q41, Q43; steps/table-receiver.md §3, §5).  Its header, as data: its formals are
# read by the method-formal parser (l2_typed_formal), as any method's are, and a `table:` call's actuals
# are bound to them by l2_bind_actuals, as any call's are (REVIEW 7dad13b, answer 3).  Each formal takes
# an ordinary Structure (Q41).
fn: l2_table_header () const: @: char
return: "fn: table (@: Lmx source; @: Lmx name; @: Lmx columns; @: Lmx rows) Lmx"

# The receiver's formals, read once: 0, or 1 said.
fn: l2_table_formals () int
    @: LmP0Document sig 0
    const: @: LmP0Node root
    @: LmP0Field f
    @: LmP0Field p
    @: LmP0Text fa
    int: ty
    int: k 0
    int: fn0 l2_foreign_n
    finally:
        l2_foreign_truncate(fn0)
        lm_p0_document_destroy(sig)
    if: l2_tb_sig != 0
        return: 0
    # The header's types (`@: Lmx`) are the receiver's, not the unit's: reading them leaves the unit's
    # foreign types as they were -- an index of l2_foreign_intern is emitted (LMX_TYPE_POINTER_BASE + i),
    # and the tables are read before the unit, at the start of its translation.
    if: lm_p0_parse_string(l2_table_header(), @ sig) != 0 || sig = 0
        return: l2_error(l2_src, 0, "internal: the header of the receiver table does not parse")
    root: lm_p0_document_root(sig)
    f: 0
    if: root != 0 && root\kind = c.LM_P0_NODE_STRUCTURE && root\as != 0 && root\as\structure != 0
        f: l2_next_active(root\as\structure\first_field)
    if: f = 0 || l2_frame_head(f\value, "fn") = 0 || f\value\as\frame\body = 0
        return: l2_error(l2_src, 0, "internal: the header of the receiver table is not a method header")
    f: l2_next_active(f\value\as\frame\body\first_field)
    if: f != 0
        f: l2_next_active(f\next)
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_STRUCTURE || f\value\as = 0 || f\value\as\structure = 0 || l2_count_active(f\value\as\structure) != 4
        return: l2_error(l2_src, 0, "internal: the receiver table does not declare four formals")
    p: l2_next_active(f\value\as\structure\first_field)
    while: p != 0 && k < 4
        fa: 0
        ty: 0
        if: l2_typed_formal(p\value, l2_src, @ fa, @ ty) != 0
            return: 1
        l2_tb_formal[k]: fa
        k: k + 1
        p: l2_next_active(p\next)
    l2_tb_sig: sig
    sig: 0
return: 0

# Two names the same: a quoted spelling (`name`) is the same name as its plain one (l2_payload_eq).
fn: l2_payload_same (const: @(LmP0Text a); const: @(LmP0Text b)) int
    const: @(char ad)
    const: @(char bd)
    size_t: an
    size_t: bn
    if: a = 0 || b = 0 || a\data = 0 || b\data = 0
        return: 0
    ad: a\data
    an: a\length
    bd: b\data
    bn: b\length
    if: an >= 2U && ad[0] = 96 && ad[an - 1U] = 96
        ad: ad + 1U
        an: an - 2U
    if: bn >= 2U && bd[0] = 96 && bd[bn - 1U] = 96
        bd: bd + 1U
        bn: bn - 2U
    if: an != bn
        return: 0
return: memcmp(ad, bd, an) = 0

# The actuals of a call bound to its formals (book §10: "Positional actual arguments precede named
# ones").  Each actual is delimited as any actual is (l2_expr_span).  A positional one binds to the next
# formal; a named one -- a Frame whose head is a formal's name -- to that formal, its body the value.
# An argument given twice, an argument after a named one that names no formal or names none at all,
# more positional ones than formals, a formal left without one: refused, located, in the book's words.
# out_at[k] is formal k's first field; out_span[k] its span, 0 for a named one.  The receiver `table`
# binds by it (steps/table-receiver.md §5), and so does every call (l2_bind_calls).
fn: l2_bind_actuals (@: LmP0Field first; int: nf; @@: LmP0Text names; const: @(char callee); @@: LmP0Field out_at; @: int out_span; const: @(char path); const: @(LmP0Node at)) int
    @: LmP0Field f
    @: LmP0Frame fr
    @: LmP0Frame pf
    int: span
    int: k 0
    int: pos 0
    int: named 0
    while: k < nf
        out_at[k]: 0
        out_span[k]: 0
        k: k + 1
    f: l2_next_active(first)
    while: f != 0
        span: l2_expr_span(f)
        if: span < 1
            return: l2_error_words(path, f\value, "an actual of ", callee, strlen(callee), " is not an argument", 0, 0U, "", 0, 0U, "")
        fr: 0
        if: span = 1 && f\value\kind = c.LM_P0_NODE_FRAME && f\value\as != 0 && f\value\as\frame != 0 && f\value\as\frame\head != 0
            fr: f\value\as\frame
        k: 0
        while: fr != 0 && k < nf && l2_payload_same(fr\head, names[k]) = 0
            k: k + 1
        if: fr != 0 && k < nf
            # Given by position first (P51, REVIEW e682d71): a frame whose head names no formal -- a
            # misspelt name -- binds by position, so the words name it.
            if: out_at[k] != 0 && out_span[k] > 0
                pf: 0
                if: out_at[k]\value != 0 && out_at[k]\value\kind = c.LM_P0_NODE_FRAME && out_at[k]\value\as != 0
                    pf: out_at[k]\value\as\frame
                if: pf != 0 && pf\head != 0
                    return: l2_error_words(path, f\value, "the argument ", names[k]\data, names[k]\length, " of ", callee, strlen(callee), " is given by position (", pf\head\data, pf\head\length, ":) and again by name")
                ---
                return: l2_error_words(path, f\value, "the argument ", names[k]\data, names[k]\length, " of ", callee, strlen(callee), " is given by position and again by name", 0, 0U, "")
            if: out_at[k] != 0
                return: l2_error_words(path, f\value, "the argument ", names[k]\data, names[k]\length, " of ", callee, strlen(callee), " is given twice", 0, 0U, "")
            out_at[k]: f
            out_span[k]: 0
            named: 1
        else:
            if: named != 0 && fr != 0
                return: l2_error_words(path, f\value, "", fr\head\data, fr\head\length, " is not an argument of ", callee, strlen(callee), "", 0, 0U, "")
            if: named != 0
                return: l2_error_words(path, f\value, "a positional argument of ", callee, strlen(callee), " after a named one", 0, 0U, "", 0, 0U, "")
            if: pos >= nf
                return: l2_error_words(path, f\value, "more arguments than ", callee, strlen(callee), " has formals", 0, 0U, "", 0, 0U, "")
            out_at[pos]: f
            out_span[pos]: span
            pos: pos + 1
        ---
        f: l2_skip_span(f, span)
    k: 0
    while: k < nf
        if: out_at[k] = 0
            return: l2_error_words(path, at, "", callee, strlen(callee), " has no argument ", names[k]\data, names[k]\length, "", 0, 0U, "")
        k: k + 1
return: 0

# Book :1060 ("Positional actual arguments precede named ones ... A named argument's body is supplied as a
# structural value when that is the receiving expression's specified mode"): the actuals of every call are
# bound to its callee's formals by the one binding (l2_bind_actuals, as the receiver `table`'s are) before any
# pass reads them, and a call with a named one gets its projection in its formals' order -- each named
# argument's body is its formal's positional actual, `name: ()` the empty Structure -- beside its body,
# which stays as written (l2_call_actuals).  A call's callee is read as the
# checker reads it (l2_call_head_method): a callable formal of the caller, then a method by name or path.  P0
# gives `name(value)` and `name: value` one tree, so a frame among the actuals whose head names a formal of
# the callee is that formal's argument.  0, or 1 said.
fn: l2_bind_calls (const: @(char path)) int
    int: i 0
    while: i < l2_m_n
        l2_cur_mi: i
        l2_vis_method(i)
        if: l2_m_body[i] != 0 && l2_bind_node(l2_m_body[i], i, l2_method_src(i, path)) != 0
            return: 1
        if: l2_m_node[i] != 0 && l2_m_node[i]\kind = c.LM_P0_NODE_FRAME && l2_m_node[i]\as != 0 && l2_m_node[i]\as\frame != 0 && l2_bind_struct(l2_ret_tr(l2_m_node[i]\as\frame), i, l2_method_src(i, path)) != 0
            return: 1
        i: i + 1
    ---
    l2_cur_mi: 0 - 1
    l2_vis_on: 0
return: 0

# Binding replays the same source position, exclusion and registered hosts
# as CHECK/emission. Its traversal must not make a later own row visible at
# an earlier call or leak a hosted declaration outside its source body.
fn: l2_bind_node (const: @(LmP0Node n); int: mi; const: @(char path)) int
    L2SourceSite: saved
    int: status
    int: restored
    int: own
    if: n = 0 || n\as = 0 || (n\kind != c.LM_P0_NODE_STRUCTURE && n\kind != c.LM_P0_NODE_FRAME)
        return: 0
    if: l2_frame_head(n, "fn") != 0 || l2_frame_head(n, "sub") != 0
        return: 0
    # A registered named body is visited in its own method environment by
    # l2_bind_calls, never as executable contents of its defining host.
    if: l2_source_is_callable_definition(n) != 0
        return: 0
    if: l2_source_save(@ saved) != 0
        return: l2_alloc_or(path, n, "out of memory")
    l2_here_at_method(mi, n)
    own: l2_own_by_decl(mi, n)
    if: own >= 0
        l2_own_excl: own
    status: 0
    if: l2_for_find(n) >= 0 && l2_scope_has(n) = 0 && l2_scope_push(n) != 0
        status: l2_alloc_or(path, n, "out of memory")
    if: status = 0
        status: l2_bind_node_content(n, mi, path)
    restored: l2_source_restore(@ saved)
    l2_xfree((cast: (@: void) saved.scopes))
    if: restored != 0
        return: 1
return: status

# A nested method's body is its own: l2_bind_calls reads it separately.
fn: l2_bind_node_content (const: @(LmP0Node n); int: mi; const: @(char path)) int
    int: idx
    int: fi 0
    int: held
    int: status 0
    @: L2HeadExpression expression
    if: n = 0 || n\as = 0
        return: 0
    if: n\kind = c.LM_P0_NODE_STRUCTURE
        return: l2_bind_struct(n\as\structure, mi, path)
    if: n\kind != c.LM_P0_NODE_FRAME || n\as\frame = 0
        return: 0
    if: l2_frame_head(n, "fn") != 0 || l2_frame_head(n, "sub") != 0
        return: 0
    if: n\as\frame\head != 0 && n\as\frame\body != 0
        idx: l2_call_head_method(mi, n\as\frame\head, @ fi)
        if: idx >= 0 && idx != l2_e && l2_bind_call(n, idx, 0 - 1, path) != 0
            return: 1
        # A held callable is called by the formals of the header of its declared
        # callable type, where the check and both emissions read it as held
        # (l2_call_head_held).
        if: idx < 0
            held: l2_call_head_held(mi, n\as\frame\head)
            if: held >= 0 && l2_bind_call(n, 0 - 1, held, path) != 0
                return: 1
            ---
        ---
    ---
    # An indexed head, `row[i]: v`, is an expression of its own, parsed apart from
    # the body and kept by its statement (l2_head_expression): every reader of the
    # head takes that one tree, and its calls are bound here as any call's.
    expression: l2_head_expression(n, @ status)
    if: status = 2
        return: 1
    if: expression != 0 && l2_bind_struct(expression\body, mi, path) != 0
        return: 1
    # A frame's trailer holds no call to bind: a valued `return:` closes only an fn (P0), whose trailer
    # l2_bind_calls binds; every other trailer is a cutter, or an `until:` the check refuses (REVIEW 3ed919e, M55).
    if: l2_bind_struct(n\as\frame\body, mi, path) != 0
        return: 1
return: 0

fn: l2_bind_struct (const: @(LmP0Structure s); int: mi; const: @(char path)) int
    @: LmP0Field f
    int: bound
    if: s = 0
        return: 0
    # A body bound just now holds naming Frames among its fields.  Such a Frame is
    # the wrapper of an actual, not a call or a statement of the caller's scope: its
    # payload is what holds calls to bind.
    bound: l2_bound_find(s)
    f: l2_next_active(s\first_field)
    while: f != 0
        if: bound >= 0 && l2_bound_is_wrap(bound, f\value) != 0
            if: l2_bind_struct(f\value\as\frame\body, mi, path) != 0
                return: 1
            ---
        else:
            if: l2_bind_node(f\value, mi, path) != 0
                return: 1
            ---
        ---
        f: l2_next_active(f\next)
    ---
return: 0

# One Structure value around fields: a named argument's body that is not one actual as written.
fn: l2_bind_whole (@: LmP0Field first; int: cnt; const: @(LmP0Node at)) @: LmP0Node
    @: LmP0Field copies 0
    @: LmP0Field cp 0
    @: LmP0Field last 0
    @: LmP0Field f
    @: LmP0Structure body 0
    @: LmP0NodeAs as 0
    @: LmP0Node node 0
    int: j 0
    if: cnt > 0
        copies: (cast: (@: LmP0Field) l2_bound_alloc((cast: (size_t) cnt), c.sizeof(c.LmP0Field)))
    body: (cast: (@: LmP0Structure) l2_bound_alloc(1U, c.sizeof(c.LmP0Structure)))
    as: (cast: (@: LmP0NodeAs) l2_bound_alloc(1U, c.sizeof(c.LmP0NodeAs)))
    node: (cast: (@: LmP0Node) l2_bound_alloc(1U, c.sizeof(c.LmP0Node)))
    if: (cnt > 0 && copies = 0) || body = 0 || as = 0 || node = 0
        return: 0
    f: first
    while: j < cnt && f != 0
        cp: copies + j
        cp\value: f\value
        if: last != 0
            last\next: cp
        last: cp
        j: j + 1
        f: l2_next_active(f\next)
    ---
    if: cnt > 0
        body\first_field: copies
        body\last_field: copies + (cnt - 1)
    body\field_count: (cast: (size_t) cnt)
    as\structure: body
    node\kind: c.LM_P0_NODE_STRUCTURE
    node\as: as
    if: at != 0
        node\span: at\span
return: node

# The written-order record of a bound call body, or -1: a call with no named actual has none,
# and its written order is the order of its formals.
# Where body's record number stands in the index, or the empty place it would take.  The
# index is never full (l2_bound_add), so the search ends.
fn: l2_bound_place (const: @(LmP0Structure body)) size_t
    size_t: h (cast: (size_t) body)
    h: ((h >> 4) * 2654435761U) & (l2_bnd_index_size - 1U)
    while: l2_bnd_index[h] != 0 && l2_bnd_body[l2_bnd_index[h] - 1] != body
        h: (h + 1U) & (l2_bnd_index_size - 1U)
    ---
return: h

fn: l2_bound_find (const: @(LmP0Structure body)) int
    if: body = 0 || l2_bnd_index_size = 0U
        return: -1
return: l2_bnd_index[l2_bound_place(body)] - 1

# Twice the index, every record placed again.  0, or 1 with the index as it was.
fn: l2_bound_index_grow () int
    @: int grown
    @: int old l2_bnd_index
    size_t: old_size l2_bnd_index_size
    size_t: size l2_bnd_index_size * 2U
    int: i 0
    if: size < 64U
        size: 64U
    if: size < old_size || l2_mul_ok(size, c.sizeof(c.int)) = 0
        return: 1
    grown: (cast: (@: int) calloc(size, c.sizeof(c.int)))
    if: grown = 0
        return: 1
    l2_bnd_index: grown
    l2_bnd_index_size: size
    while: i < l2_bnd_n
        l2_bnd_index[l2_bound_place(l2_bnd_body[i])]: i + 1
        i: i + 1
    ---
    free((cast: (@: void) old))
return: 0

# The rank of formal k's actual among the actuals as written.
fn: l2_bound_rank (int: bi; int: k) int
    if: bi < 0 || bi >= l2_bnd_n || k < 0 || k >= l2_bnd_nf[bi]
        return: k
return: l2_bnd_rank[l2_bnd_off[bi] + k]

# The formal whose actual was written at that rank, or -1.
fn: l2_bound_formal (int: bi; int: rank) int
    int: k 0
    if: bi < 0 || bi >= l2_bnd_n
        return: rank
    while: k < l2_bnd_nf[bi]
        if: l2_bnd_rank[l2_bnd_off[bi] + k] = rank
            return: k
        k: k + 1
    ---
return: -1

# The Frame that named formal k's actual, or 0 for one given by position.
fn: l2_bound_wrap (int: bi; int: k) @: LmP0Node
    if: bi < 0 || bi >= l2_bnd_n || k < 0 || k >= l2_bnd_nf[bi]
        return: 0
return: l2_bnd_wrap[l2_bnd_off[bi] + k]

fn: l2_bound_add (const: @(LmP0Structure body); int: nf; @: int rank; @@: LmP0Node wrap) int
    @@: LmP0Structure gb
    @@: LmP0Node gw
    @@: LmP0Field gf
    @: int gi
    int: k 0
    size_t: want (cast: (size_t) (l2_bnd_n + 1))
    size_t: cells (cast: (size_t) (l2_bnd_cells + nf + 1))
    gb: (cast: (@@: LmP0Structure) realloc((cast: (@: void) l2_bnd_body), want * c.sizeof(@: void)))
    if: gb = 0
        return: 1
    l2_bnd_body: gb
    gi: (cast: (@: int) realloc((cast: (@: void) l2_bnd_off), want * c.sizeof(c.int)))
    if: gi = 0
        return: 1
    l2_bnd_off: gi
    gi: (cast: (@: int) realloc((cast: (@: void) l2_bnd_nf), want * c.sizeof(c.int)))
    if: gi = 0
        return: 1
    l2_bnd_nf: gi
    gi: (cast: (@: int) realloc((cast: (@: void) l2_bnd_rank), cells * c.sizeof(c.int)))
    if: gi = 0
        return: 1
    l2_bnd_rank: gi
    gw: (cast: (@@: LmP0Node) realloc((cast: (@: void) l2_bnd_wrap), cells * c.sizeof(@: void)))
    if: gw = 0
        return: 1
    l2_bnd_wrap: gw
    gf: (cast: (@@: LmP0Field) realloc((cast: (@: void) l2_bnd_first), want * c.sizeof(@: void)))
    if: gf = 0
        return: 1
    l2_bnd_first: gf
    gi: (cast: (@: int) realloc((cast: (@: void) l2_bnd_count), want * c.sizeof(c.int)))
    if: gi = 0
        return: 1
    l2_bnd_count: gi
    l2_bnd_first[l2_bnd_n]: 0
    l2_bnd_count[l2_bnd_n]: 0
    l2_bnd_body[l2_bnd_n]: (cast: (@: LmP0Structure) body)
    l2_bnd_off[l2_bnd_n]: l2_bnd_cells
    l2_bnd_nf[l2_bnd_n]: nf
    while: k < nf
        l2_bnd_rank[l2_bnd_cells + k]: rank[k]
        l2_bnd_wrap[l2_bnd_cells + k]: wrap[k]
        k: k + 1
    ---
    if: ((cast: (size_t) l2_bnd_n) + 1U) * 2U > l2_bnd_index_size && l2_bound_index_grow() != 0
        return: 1
    l2_bnd_index[l2_bound_place(body)]: l2_bnd_n + 1
    l2_bnd_cells: l2_bnd_cells + nf
    l2_bnd_n: l2_bnd_n + 1
return: 0

# Is this node one of the Frames that named an actual of bound call bi?
fn: l2_bound_is_wrap (int: bi; const: @(LmP0Node node)) int
    int: k 0
    if: bi < 0 || bi >= l2_bnd_n || node = 0
        return: 0
    while: k < l2_bnd_nf[bi]
        if: l2_bnd_wrap[l2_bnd_off[bi] + k] = node
            return: 1
        k: k + 1
    ---
return: 0

# THE VIEW OF A CALL BODY BY FORMAL COORDINATE (Codex, FABLE-CODEX-20261004-03).  The
# actuals of a call as one list in the order of its callee's formals: the projection of a
# body bound with named actuals, the body's own fields of any other.  A reader that takes
# the actuals by position asks for this view where it enters the body, and says so by
# calling it; a reader of the source reads the body itself.  The list is the compiler's,
# borrowed from the binding record: its fields are not the body's fields, and it holds no
# naming Frame.
fn: l2_call_actuals (const: @(LmP0Structure body)) @: LmP0Field
    int: bi l2_bound_find(body)
    if: body = 0
        return: 0
    if: bi >= 0
        return: l2_bnd_first[bi]
return: body\first_field

# The count of fields of that view.
fn: l2_call_actual_fields (const: @(LmP0Structure body)) int
    int: bi l2_bound_find(body)
    if: body = 0
        return: 0
    if: bi >= 0
        return: l2_bnd_count[bi]
return: l2_count_active(body)

# n zeroed elements of the binding's own memory, or 0.
fn: l2_bound_alloc (size_t: n; size_t: size) @: void
    @: void p
    @@: void grown
    int: cap
    if: n = 0U || size = 0U || l2_mul_ok(n, size) = 0
        return: 0
    if: l2_bnd_mem_n >= l2_bnd_mem_cap
        cap: l2_bnd_mem_cap * 2
        if: cap < 64
            cap: 64
        grown: (cast: (@@: void) realloc((cast: (@: void) l2_bnd_mem), (cast: (size_t) cap) * c.sizeof(@: void)))
        if: grown = 0
            return: 0
        l2_bnd_mem: grown
        l2_bnd_mem_cap: cap
    ---
    l2_alloc_kind: 5
    p: l2_xmalloc(n * size)
    if: p = 0
        return: 0
    memset(p, 0, n * size)
    l2_bnd_mem[l2_bnd_mem_n]: p
    l2_bnd_mem_n: l2_bnd_mem_n + 1
return: p

# The end of the binding: its memory and its record are released.  The source they borrowed
# from is untouched and still live.  Nothing after this may ask l2_call_actuals for a projection.
fn: l2_bound_free () int
    int: i 0
    while: i < l2_bnd_mem_n
        l2_xfree(l2_bnd_mem[i])
        i: i + 1
    ---
    free((cast: (@: void) l2_bnd_mem))
    l2_bnd_mem: 0
    l2_bnd_mem_n: 0
    l2_bnd_mem_cap: 0
    free((cast: (@: void) l2_bnd_body))
    free((cast: (@: void) l2_bnd_off))
    free((cast: (@: void) l2_bnd_nf))
    free((cast: (@: void) l2_bnd_rank))
    free((cast: (@: void) l2_bnd_wrap))
    free((cast: (@: void) l2_bnd_first))
    free((cast: (@: void) l2_bnd_count))
    free((cast: (@: void) l2_bnd_index))
    l2_bnd_index: 0
    l2_bnd_index_size: 0U
    l2_bnd_body: 0
    l2_bnd_off: 0
    l2_bnd_nf: 0
    l2_bnd_rank: 0
    l2_bnd_wrap: 0
    l2_bnd_first: 0
    l2_bnd_count: 0
    l2_bnd_n: 0
    l2_bnd_cells: 0
return: 0

# The first field of the k-th actual of a formal-ordered list, or 0.
fn: l2_actual_field (@: LmP0Field first; int: k) @: LmP0Field
    @: LmP0Field a l2_next_active(first)
    int: i 0
    int: span
    while: a != 0 && i < k
        span: l2_expr_span(a)
        if: span < 1
            return: 0
        a: l2_skip_span(a, span)
        i: i + 1
    ---
return: a

# Call node of callee idx, or of held callable `held` when idx is -1: its actuals bound (l2_bind_actuals)
# to the callee's formals -- a method's own, or those of the header of the held callable's declared type.
# A call with a named one gets a record with its projection in its formals' order, and its body is left
# as written.  One slot per formal of the callee: the language puts no bound on a callable's formals
# (REVIEW 394f6a9, P62).  A held callable whose header cannot be read is left to the check, which says
# so.  0, or 1 said.
fn: l2_bind_call (const: @(LmP0Node node); int: idx; int: held; const: @(char path)) int
return: l2_bind_call_at(node, l2_app_head(node), idx, held, path)

# The same binding, the call's written head given: the node's own (l2_app_head), or the path a path operand writes
# (K03 S6, l2_check_call_at) -- the words of a refused binding name it.
fn: l2_bind_call_at (const: @(LmP0Node node); @: LmP0Text head; int: idx; int: held; const: @(char path)) int
    int: nf
    int: k 0
    int: rc
    size_t: m
    size_t: psz
    @@: LmP0Field at 0
    @@: LmP0Text names 0
    @@: LmP0Field first 0
    @: int span 0
    @: int cnt 0
    if: idx >= 0
        nf: l2_m_arity[idx]
    else:
        nf: l2_mad_held_formals(held)
        if: nf < 0
            return: 0
    ---
    m: (cast: (size_t) nf) + 1U
    psz: c.sizeof(@: char)
    if: nf < 0 || l2_mul_ok(m, psz) = 0 || l2_mul_ok(m, c.sizeof(c.int)) = 0
        l2_alloc_err: 2
        return: l2_alloc_or(path, node, "out of memory")
    l2_alloc_kind: 5
    at: (cast: (@@: LmP0Field) l2_xmalloc(m * psz))
    l2_alloc_kind: 5
    names: (cast: (@@: LmP0Text) l2_xmalloc(m * psz))
    l2_alloc_kind: 5
    first: (cast: (@@: LmP0Field) l2_xmalloc(m * psz))
    l2_alloc_kind: 5
    span: (cast: (@: int) l2_xmalloc(m * c.sizeof(c.int)))
    l2_alloc_kind: 5
    cnt: (cast: (@: int) l2_xmalloc(m * c.sizeof(c.int)))
    rc: 1
    if: at != 0 && names != 0 && first != 0 && span != 0 && cnt != 0
        memset((cast: (@: void) at), 0, m * psz)
        memset((cast: (@: void) names), 0, m * psz)
        memset((cast: (@: void) first), 0, m * psz)
        memset((cast: (@: void) span), 0, m * c.sizeof(c.int))
        memset((cast: (@: void) cnt), 0, m * c.sizeof(c.int))
        while: k < nf
            if: idx >= 0
                names[k]: l2_fn(idx, k)
            else:
                names[k]: l2_mad_held_arg_name(held, k)
            k: k + 1
        ---
        rc: l2_bind_call_in(node, head, path, nf, at, span, names, first, cnt)
    else:
        rc: l2_alloc_or(path, node, "out of memory")
    if: at != 0
        l2_xfree((cast: (@: void) at))
    if: names != 0
        l2_xfree((cast: (@: void) names))
    if: first != 0
        l2_xfree((cast: (@: void) first))
    if: span != 0
        l2_xfree((cast: (@: void) span))
    if: cnt != 0
        l2_xfree((cast: (@: void) cnt))
return: rc

# The binding of l2_bind_call over its nf per-formal slots, the formals' names given.  0, or 1 said.
fn: l2_bind_call_in (const: @(LmP0Node node); @: LmP0Text head; const: @(char path); int: nf; @@: LmP0Field at; @: int span; @@: LmP0Text names; @@: LmP0Field first; @: int cnt) int
    @: LmP0Structure body
    []: char callee_own 160
    @: char callee 0
    @: LmP0Field f
    @: LmP0Field copies 0
    @: LmP0Field cp 0
    @: LmP0Field last 0
    @: LmP0Node whole
    int: k 0
    int: j
    int: n 0
    int: named 0
    int: again 1
    int: rounds 0
    int: s0
    @: int rank 0
    @@: LmP0Node wrap 0
    @: LmP0Text hd
    @: LmP0Field bfirst 0
    # K03: the written application (l2_app_head, l2_app_actuals): a bare head is bound as its empty application is.
    body: l2_app_actuals(node)
    hd: head
    if: hd = 0
        return: l2_error(path, node, "internal: a call has no head")
    # The callee's name whole, in memory of its own size: the words of a refused binding say it (FIXED-BLOCKS-AUDIT).
    callee: l2_text_room(hd\length + 1U, callee_own, 160U)
    if: callee = 0
        return: l2_alloc_or(path, node, "out of memory")
    memcpy(callee, hd\data, hd\length)
    callee[hd\length]: 0
    if: body != 0
        bfirst: body\first_field
    if: l2_bind_actuals(bfirst, nf, names, callee, at, span, path, node) != 0
        return: 1
    k: 0
    while: k < nf
        if: span[k] = 0
            named: 1
        k: k + 1
    ---
    # Every actual by position, in order: the call stands as written.
    if: named = 0
        return: 0
    # The written order: each formal's rank among the actuals as written, and the Frame
    # that named it.
    rank: (cast: (@: int) calloc((cast: (size_t) (nf + 1)), c.sizeof(c.int)))
    wrap: (cast: (@@: LmP0Node) calloc((cast: (size_t) (nf + 1)), c.sizeof(@: void)))
    if: rank = 0 || wrap = 0
        return: l2_error(path, node, "out of memory")
    f: l2_next_active(body\first_field)
    n: 0
    while: f != 0
        k: 0
        while: k < nf
            if: at[k] = f
                rank[k]: n
                if: span[k] = 0
                    wrap[k]: f\value
                ---
            ---
            k: k + 1
        ---
        n: n + 1
        f: l2_skip_span(f, l2_expr_span(f))
    ---
    k: l2_bound_add(body, nf, rank, wrap)
    free((cast: (@: void) rank))
    free((cast: (@: void) wrap))
    if: k != 0
        return: l2_error(path, node, "out of memory")
    # Each formal's actual: a positional one's fields as written; a named one's body -- no field is the
    # empty Structure (`name: ()`, P0 flattens its sole ()).
    k: 0
    while: k < nf
        if: span[k] > 0
            first[k]: at[k]
            cnt[k]: span[k]
        else:
            first[k]: l2_next_active(at[k]\value\as\frame\body\first_field)
            cnt[k]: l2_count_active(at[k]\value\as\frame\body)
            if: cnt[k] = 0
                whole: l2_bind_whole(0, 0, at[k]\value)
                if: whole = 0
                    return: l2_error(path, node, "out of memory")
                first[k]: (cast: (@: LmP0Field) l2_bound_alloc(1U, c.sizeof(c.LmP0Field)))
                if: first[k] = 0
                    return: l2_error(path, node, "out of memory")
                first[k]\value: whole
                cnt[k]: 1
            ---
        ---
        k: k + 1
    ---
    # A named argument's body is one value: read back as positional actuals, each must be one actual of its
    # own fields.  One that is several (`p: 1 2`) or joins its neighbour (`b: - 1` after `a: x`) is kept
    # whole, one Structure value.
    while: again != 0
        again: 0
        # Each round keeps one more body whole; a body kept whole is one field, so nf rounds suffice.
        rounds: rounds + 1
        if: rounds > nf + 1
            return: l2_error(path, node, "internal: a call's bound actuals do not settle")
        n: 0
        k: 0
        while: k < nf
            n: n + cnt[k]
            k: k + 1
        ---
        copies: (cast: (@: LmP0Field) l2_bound_alloc((cast: (size_t) n), c.sizeof(c.LmP0Field)))
        if: copies = 0
            return: l2_error(path, node, "out of memory")
        last: 0
        j: 0
        k: 0
        while: k < nf
            f: first[k]
            s0: 0
            while: s0 < cnt[k] && f != 0
                cp: copies + j
                cp\value: f\value
                cp\next: 0
                if: last != 0
                    last\next: cp
                last: cp
                j: j + 1
                s0: s0 + 1
                f: l2_next_active(f\next)
            ---
            k: k + 1
        ---
        f: copies
        k: 0
        while: k < nf && again = 0
            s0: l2_expr_span(f)
            if: s0 != cnt[k]
                j: k
                if: s0 > cnt[k] && k + 1 < nf
                    j: k + 1
                if: span[j] > 0 || cnt[j] < 1
                    return: l2_error(path, f\value, "internal: a bound actual is not one argument")
                whole: l2_bind_whole(first[j], cnt[j], first[j]\value)
                if: whole = 0
                    return: l2_error(path, node, "out of memory")
                first[j]: (cast: (@: LmP0Field) l2_bound_alloc(1U, c.sizeof(c.LmP0Field)))
                if: first[j] = 0
                    return: l2_error(path, node, "out of memory")
                first[j]\value: whole
                cnt[j]: 1
                again: 1
            ---
            if: again = 0
                f: l2_skip_span(f, cnt[k])
            k: k + 1
        ---
    ---
    # The body stays as written.  The projection is the record's.
    k: l2_bound_find(body)
    if: k < 0
        return: l2_error(path, node, "internal: a bound call has no record")
    l2_bnd_first[k]: copies
    l2_bnd_count[k]: n
return: 0

# A bound argument's fields: a named one's are its Frame's body; a positional Structure's are its own;
# any other positional actual is its own span of fields.  *out_n: how many.
fn: l2_arg_fields (@: LmP0Field a; int: span; @: int out_n) @: LmP0Field
    @: LmP0Node v
    \out_n: 0
    if: a = 0 || a\value = 0
        return: 0
    v: a\value
    if: span = 0
        if: v\as = 0 || v\as\frame = 0 || v\as\frame\body = 0
            return: 0
        \out_n: l2_count_active(v\as\frame\body)
        return: l2_next_active(v\as\frame\body\first_field)
    if: span = 1 && v\kind = c.LM_P0_NODE_STRUCTURE && v\as != 0 && v\as\structure != 0
        \out_n: l2_count_active(v\as\structure)
        return: l2_next_active(v\as\structure\first_field)
    \out_n: span
return: a

# Two source tables of one name (§8): said at the second, with the place of the first -- they may stand in
# two files of the program.
fn: l2_table_twice (const: @(char path); const: @(LmP0Node at); int: k) int
    []: char place 64
    size_t: line 1U
    size_t: column 1U
    size_t: pn 0U
    if: l2_tb_name_at[k] != 0 && l2_tb_name_at[k]\span != 0
        line: l2_tb_name_at[k]\span\line
        column: l2_tb_name_at[k]\span\column
    ---
    if: l2_tb_path[k] != 0
        pn: strlen(l2_tb_path[k])
    # The other source's path whole (FIXED-BLOCKS-AUDIT); its line and column are numbers.
    c.snprintf(place, 64U, ":%zu:%zu)", line, column)
return: l2_error_words(path, at, "two source tables have this name (the other at ", l2_tb_path[k], pn, place, 0, 0U, "", 0, 0U, "")

# The tables' memory beyond the unit's places.
fn: l2_tb_free () int
    l2_xfree((cast: (@: void) l2_tb_name))
    l2_xfree((cast: (@: void) l2_tb_cols))
    l2_xfree((cast: (@: void) l2_tb_call))
    l2_xfree((cast: (@: void) l2_tb_path))
    l2_xfree((cast: (@: void) l2_tb_name_at))
    l2_xfree((cast: (@: void) l2_tb_col0))
    l2_xfree((cast: (@: void) l2_tb_ncol))
    l2_xfree((cast: (@: void) l2_tb_cell0))
    l2_xfree((cast: (@: void) l2_tb_nrow))
return: 0

# Room for one more source table: the unit's 8 places while they suffice, then memory of twice the tables, the
# tables kept (FIXED-BLOCKS-AUDIT).  0, or 1 out of memory.
fn: l2_tb_room () int
    @@: LmP0Text nm
    @@: LmP0Node co
    @@: LmP0Node ca
    @@: char pa
    @@: LmP0Node na
    @: int c0
    @: int nc
    @: int e0
    @: int nr
    int: cap
    size_t: psz
    size_t: isz
    size_t: ok 1U
    if: l2_tb_cap = 0
        l2_tb_name: (cast: (@@: LmP0Text) l2_tb_name_own)
        l2_tb_cols: (cast: (@@: LmP0Node) l2_tb_cols_own)
        l2_tb_call: (cast: (@@: LmP0Node) l2_tb_call_own)
        l2_tb_path: (cast: (@@: char) l2_tb_path_own)
        l2_tb_name_at: (cast: (@@: LmP0Node) l2_tb_name_at_own)
        l2_tb_col0: l2_tb_col0_own
        l2_tb_ncol: l2_tb_ncol_own
        l2_tb_cell0: l2_tb_cell0_own
        l2_tb_nrow: l2_tb_nrow_own
        l2_tb_cap: 8
    if: l2_tb_n < l2_tb_cap
        return: 0
    if: l2_tb_cap > c.INT_MAX / 2
        return: 1
    cap: l2_tb_cap * 2
    psz: c.sizeof(@: void)
    isz: c.sizeof(c.int)
    nm: (cast: (@@: LmP0Text) l2_xmalloc((cast: (size_t) cap) * psz))
    co: (cast: (@@: LmP0Node) l2_xmalloc((cast: (size_t) cap) * psz))
    ca: (cast: (@@: LmP0Node) l2_xmalloc((cast: (size_t) cap) * psz))
    pa: (cast: (@@: char) l2_xmalloc((cast: (size_t) cap) * psz))
    na: (cast: (@@: LmP0Node) l2_xmalloc((cast: (size_t) cap) * psz))
    c0: (cast: (@: int) l2_xmalloc((cast: (size_t) cap) * isz))
    nc: (cast: (@: int) l2_xmalloc((cast: (size_t) cap) * isz))
    e0: (cast: (@: int) l2_xmalloc((cast: (size_t) cap) * isz))
    nr: (cast: (@: int) l2_xmalloc((cast: (size_t) cap) * isz))
    if: nm = 0 || co = 0 || ca = 0 || pa = 0 || na = 0 || c0 = 0 || nc = 0 || e0 = 0 || nr = 0
        ok: 0U
    if: ok = 0U
        l2_xfree((cast: (@: void) nm))
        l2_xfree((cast: (@: void) co))
        l2_xfree((cast: (@: void) ca))
        l2_xfree((cast: (@: void) pa))
        l2_xfree((cast: (@: void) na))
        l2_xfree((cast: (@: void) c0))
        l2_xfree((cast: (@: void) nc))
        l2_xfree((cast: (@: void) e0))
        l2_xfree((cast: (@: void) nr))
        return: 1
    memcpy((cast: (@: void) nm), (cast: (@: void) l2_tb_name), (cast: (size_t) l2_tb_n) * psz)
    memcpy((cast: (@: void) co), (cast: (@: void) l2_tb_cols), (cast: (size_t) l2_tb_n) * psz)
    memcpy((cast: (@: void) ca), (cast: (@: void) l2_tb_call), (cast: (size_t) l2_tb_n) * psz)
    memcpy((cast: (@: void) pa), (cast: (@: void) l2_tb_path), (cast: (size_t) l2_tb_n) * psz)
    memcpy((cast: (@: void) na), (cast: (@: void) l2_tb_name_at), (cast: (size_t) l2_tb_n) * psz)
    memcpy((cast: (@: void) c0), (cast: (@: void) l2_tb_col0), (cast: (size_t) l2_tb_n) * isz)
    memcpy((cast: (@: void) nc), (cast: (@: void) l2_tb_ncol), (cast: (size_t) l2_tb_n) * isz)
    memcpy((cast: (@: void) e0), (cast: (@: void) l2_tb_cell0), (cast: (size_t) l2_tb_n) * isz)
    memcpy((cast: (@: void) nr), (cast: (@: void) l2_tb_nrow), (cast: (size_t) l2_tb_n) * isz)
    if: l2_tb_cap > 8
        l2_tb_free()
    l2_tb_name: nm
    l2_tb_cols: co
    l2_tb_call: ca
    l2_tb_path: pa
    l2_tb_name_at: na
    l2_tb_col0: c0
    l2_tb_ncol: nc
    l2_tb_cell0: e0
    l2_tb_nrow: nr
    l2_tb_cap: cap
return: 0

# Room for one more column name: the unit's 128 places, then memory of twice the columns.
fn: l2_tbc_room () int
    @@: LmP0Text nm
    int: cap
    size_t: psz
    if: l2_tbc_cap = 0
        l2_tbc_name: (cast: (@@: LmP0Text) l2_tbc_name_own)
        l2_tbc_cap: 128
    if: l2_tbc_n < l2_tbc_cap
        return: 0
    if: l2_tbc_cap > c.INT_MAX / 2
        return: 1
    cap: l2_tbc_cap * 2
    psz: c.sizeof(@: void)
    nm: (cast: (@@: LmP0Text) l2_xmalloc((cast: (size_t) cap) * psz))
    if: nm = 0
        return: 1
    memcpy((cast: (@: void) nm), (cast: (@: void) l2_tbc_name), (cast: (size_t) l2_tbc_n) * psz)
    if: l2_tbc_cap > 128
        l2_xfree((cast: (@: void) l2_tbc_name))
    l2_tbc_name: nm
    l2_tbc_cap: cap
return: 0

# Room for one more cell: the unit's 4096 places, then memory of twice the cells.
fn: l2_tbx_room () int
    @@: LmP0Node ar
    @@: char nm
    int: cap
    size_t: psz
    if: l2_tbx_cap = 0
        l2_tbx_arg: (cast: (@@: LmP0Node) l2_tbx_arg_own)
        l2_tbx_name: (cast: (@@: char) l2_tbx_name_own)
        l2_tbx_cap: 4096
    if: l2_tbx_n < l2_tbx_cap
        return: 0
    if: l2_tbx_cap > c.INT_MAX / 2
        return: 1
    cap: l2_tbx_cap * 2
    psz: c.sizeof(@: void)
    ar: (cast: (@@: LmP0Node) l2_xmalloc((cast: (size_t) cap) * psz))
    nm: (cast: (@@: char) l2_xmalloc((cast: (size_t) cap) * psz))
    if: ar = 0 || nm = 0
        l2_xfree((cast: (@: void) ar))
        l2_xfree((cast: (@: void) nm))
        return: 1
    memcpy((cast: (@: void) ar), (cast: (@: void) l2_tbx_arg), (cast: (size_t) l2_tbx_n) * psz)
    memcpy((cast: (@: void) nm), (cast: (@: void) l2_tbx_name), (cast: (size_t) l2_tbx_n) * psz)
    if: l2_tbx_cap > 4096
        l2_xfree((cast: (@: void) l2_tbx_arg))
        l2_xfree((cast: (@: void) l2_tbx_name))
    l2_tbx_arg: ar
    l2_tbx_name: nm
    l2_tbx_cap: cap
return: 0

# A `table:` call (Q41, Q43): its actuals bound to the receiver's formals by l2_bind_actuals.  Its name
# is the one atom of its `name:` argument (a quoted spelling is the same name, l2_payload_same), one
# name to one source table; a name of another form names no table (l2_table_find).  Its columns are its
# `columns:` argument's formals, each named as a formal is named -- `(T: n)`, `(@: T n)`: the last atom
# of the formal's frame; a bare atom is a name -- their types kept as written (a column's type is read
# when the tables that define `class` and `categoryFlag` are: steps/table-receiver.md §5).  Its rows are
# the chain of its `rows:` argument, each cell one actual (l2_expr_span) of any kind, cut into rows by
# the number of columns -- the one place a table differs from an ordinary call, and by the author's norm
# (Q43): N actuals a row to its N formals.
fn: l2_table_call (const: @(LmP0Node call); const: @(char path)) int
    []: @(LmP0Field) at 4
    []: int span 4
    @: LmP0Field f
    @: LmP0Field g
    @: LmP0Node v
    @: LmP0Text name
    []: char buf_own 128
    @: char buf 0
    size_t: room
    @: char copy
    size_t: len
    int: t
    int: n
    int: k
    int: w
    int: col 0
    if: l2_table_formals() != 0
        return: 1
    if: l2_tb_room() != 0
        return: l2_alloc_or(path, call, "out of memory")
    if: l2_bind_actuals(call\as\frame\body\first_field, 4, l2_tb_formal, "table", at, span, path, call) != 0
        return: 1
    t: l2_tb_n
    l2_tb_name[t]: 0
    l2_tb_name_at[t]: 0
    l2_tb_path[t]: (cast: (@: char) path)
    f: l2_arg_fields(at[1], span[1], @ n)
    if: n = 1 && f != 0 && f\value != 0 && f\value\kind = c.LM_P0_NODE_ATOM && f\value\as != 0
        l2_tb_name[t]: (cast: (@: LmP0Text) f\value\as\atom)
        l2_tb_name_at[t]: f\value
        k: 0
        while: k < t
            if: l2_tb_name[k] != 0 && l2_payload_same(l2_tb_name[k], l2_tb_name[t])
                return: l2_table_twice(path, f\value, k)
            k: k + 1
        ---
    ---
    l2_tb_cols[t]: at[2]\value
    l2_tb_call[t]: (cast: (@: LmP0Node) call)
    l2_tb_col0[t]: l2_tbc_n
    l2_tb_ncol[t]: 0
    l2_tb_cell0[t]: l2_tbx_n
    l2_tb_nrow[t]: 0
    f: l2_arg_fields(at[2], span[2], @ n)
    k: 0
    while: k < n && f != 0
        v: f\value
        if: v != 0 && v\kind = c.LM_P0_NODE_STRUCTURE && v\as != 0 && v\as\structure != 0 && l2_count_active(v\as\structure) = 1
            v: l2_next_active(v\as\structure\first_field)\value
        name: 0
        if: v != 0 && v\kind = c.LM_P0_NODE_ATOM && v\as != 0
            name: (cast: (@: LmP0Text) v\as\atom)
        if: v != 0 && v\kind = c.LM_P0_NODE_FRAME && v\as != 0 && v\as\frame != 0 && v\as\frame\body != 0
            g: l2_next_active(v\as\frame\body\first_field)
            while: g != 0
                if: g\value != 0 && g\value\kind = c.LM_P0_NODE_ATOM && g\value\as != 0
                    name: (cast: (@: LmP0Text) g\value\as\atom)
                g: l2_next_active(g\next)
            ---
        ---
        if: l2_tbc_room() != 0
            return: l2_alloc_or(path, v, "out of memory")
        if: name = 0
            return: l2_error(path, v, "a table column needs a name")
        w: l2_tb_col0[t]
        while: w < l2_tbc_n
            if: l2_payload_same(l2_tbc_name[w], name)
                return: l2_error(path, v, "a table column is named twice")
            w: w + 1
        l2_tbc_name[l2_tbc_n]: name
        l2_tbc_n: l2_tbc_n + 1
        l2_tb_ncol[t]: l2_tb_ncol[t] + 1
        f: l2_next_active(f\next)
        k: k + 1
    f: l2_arg_fields(at[3], span[3], @ n)
    k: 0
    while: k < n && f != 0
        w: l2_expr_span(f)
        if: w < 1
            return: l2_error(path, f\value, "a table cell is not an argument")
        if: l2_tb_ncol[t] = 0
            return: l2_error(path, at[3]\value, "table rows are not whole rows of its columns")
        if: l2_tbx_room() != 0
            return: l2_alloc_or(path, f\value, "out of memory")
        l2_tbx_arg[l2_tbx_n]: f\value
        l2_tbx_name[l2_tbx_n]: 0
        if: w = 1 && f\value\kind = c.LM_P0_NODE_ATOM && f\value\as != 0
            # The cell's text in memory of its own size: its bytes and the terminator; a triple-quoted cell is
            # written as an L1 string, at most four bytes for each of its bytes (an escape) and its quotes.
            room: f\value\as\atom\length + 1U
            if: l2_triple_q(f\value\as\atom) != 0
                if: l2_mul_ok(f\value\as\atom\length, 4U) = 0
                    return: l2_alloc_or(path, f\value, "size overflow")
                room: f\value\as\atom\length * 4U + 3U
            buf: l2_text_room(room, buf_own, 128U)
            if: buf = 0
                return: l2_alloc_or(path, f\value, "out of memory")
            if: l2_tok_text(f\value\as\atom, buf, room) != 0
                return: l2_error(path, f\value, "internal: a table cell's text did not fit its room")
            len: c.strlen(buf) + 1U
            copy: (cast: (@: char) l2_xmalloc(len))
            if: copy = 0
                return: l2_alloc_or(path, f\value, "out of memory")
            memcpy(copy, buf, len)
            l2_tbx_name[l2_tbx_n]: copy
        ---
        l2_tbx_n: l2_tbx_n + 1
        col: col + 1
        if: col >= l2_tb_ncol[t]
            col: 0
            l2_tb_nrow[t]: l2_tb_nrow[t] + 1
        ---
        k: k + w
        f: l2_skip_span(f, w)
    if: col != 0
        return: l2_error(path, at[3]\value, "table rows are not whole rows of its columns")
    l2_tb_n: l2_tb_n + 1
return: 0

# The source tables in a Structure of one of the program's files, at any depth (lingvamyxa_prev's book :663,
# :684, :18194; §8, Q46): every `table:` whose body begins with the atom `source`, wherever it stands -- the
# file's root, a method's body, a Structure's, a block -- built in source order (l2_table_call).  Once built
# it is inactive: a projection done at translation (prev :18194), which no body reads as a statement.  A
# `table:` without `source` builds a table when the program runs, left to the program (REVIEW 7dad13b).
fn: l2_tables_in (const: @(LmP0Structure s); const: @(char path)) int
    @: LmP0Field f
    @: LmP0Field g
    @: LmP0Node n
    if: s = 0
        return: 0
    f: l2_next_active(s\first_field)
    while: f != 0
        n: f\value
        if: l2_frame_head(n, "table") != 0 && n\as\frame\body != 0
            g: l2_next_active(n\as\frame\body\first_field)
            if: g != 0 && g\value != 0 && g\value\kind = c.LM_P0_NODE_ATOM && g\value\as != 0 && l2_payload_eq(g\value\as\atom, "source") != 0
                if: l2_table_call(n, path) != 0
                    return: 1
                n\flags: n\flags | c.LM_P0_NODE_INACTIVE
                f: l2_next_active(f\next)
                continue
            ---
        if: n != 0 && n\as != 0 && n\kind = c.LM_P0_NODE_FRAME && n\as\frame != 0
            if: l2_tables_in(n\as\frame\body, path) != 0
                return: 1
            if: n\as\frame\trailer != 0 && l2_tables_in(n\as\frame\trailer\body, path) != 0
                return: 1
            ---
        if: n != 0 && n\as != 0 && n\kind = c.LM_P0_NODE_STRUCTURE
            if: l2_tables_in(n\as\structure, path) != 0
                return: 1
            ---
        f: l2_next_active(f\next)
    ---
    if: s\trailer != 0
        return: l2_tables_in(s\trailer\body, path)
return: 0

# The source tables of one file of the program: its root Structure's, at any depth (l2_tables_in).
fn: l2_program_tables (const: @(LmP0Node root); const: @(char path)) int
    if: root = 0 || root\as = 0 || root\kind != c.LM_P0_NODE_STRUCTURE
        return: 0
return: l2_tables_in(root\as\structure, path)

# The source table of this name (a quoted spelling is the same name), or -1.
fn: l2_table_find (const: @(char name)) int
    int: t 0
    while: t < l2_tb_n
        if: l2_tb_name[t] != 0 && l2_payload_eq(l2_tb_name[t], name) != 0
            return: t
        t: t + 1
return: 0 - 1

# Table t's column of this name, or -1.
fn: l2_table_col (int: t; const: @(char name)) int
    int: k 0
    while: k < l2_tb_ncol[t]
        if: l2_payload_eq(l2_tbc_name[l2_tb_col0[t] + k], name) != 0
            return: k
        k: k + 1
return: 0 - 1

# The columns the conversion reads, by name: its query of the table, which keeps any others.
fn: l2_convert_colname (int: k) const: @: char
    if: k = 0
        return: "from"
    if: k = 1
        return: "to"
    if: k = 2
        return: "forbidden"
    if: k = 3
        return: "receiver"
return: "impl"

# A translation input beside the source that P0 refuses with a diagnostic (P54a, REVIEW e682d71): the
# diagnostic, located in that file and counted, as the source's own is (l2_translate) -- one cause, one
# line, and the use site adds nothing.  1 when it was said; 0 when P0 left none (the file could not be
# read -- said where it was needed).
fn: l2_input_said (const: @(char label); @: LmP0Document document) int
    const: @: LmP0Diagnostic diagnostic
    if: document = 0
        return: 0
    diagnostic: lm_p0_document_diagnostic(document)
    if: diagnostic = 0
        return: 0
    c.fprintf(l1_stderr(), "l2trans error: %s:%zu:%zu: %s (P0 %d)\n", label, diagnostic\line, diagnostic\column, diagnostic\message, diagnostic\code)
    l2_diag_n: l2_diag_n + 1
return: 1

# The program's parts (§8, Q46): each file named after the source at the call, parsed -- its P0 diagnostic
# said in that file (l2_input_said), or, when P0 left none, "cannot read a program file" -- and its source
# tables built (l2_program_tables).  Their documents stay for the translation: the tables and the methods
# of a part hold their nodes.
fn: l2_parts_read () int
    int: k 0
    @: LmP0Document document 0
    if: l2_part_n <= 0
        return: 0
    l2_part_doc: (cast: (@@: LmP0Document) malloc((cast: (size_t) l2_part_n) * c.sizeof(@: void)))
    l2_part_m0: (cast: (@: int) malloc((cast: (size_t) l2_part_n) * c.sizeof(c.int)))
    l2_part_m1: (cast: (@: int) malloc((cast: (size_t) l2_part_n) * c.sizeof(c.int)))
    l2_part_ns: (cast: (@: int) malloc((cast: (size_t) l2_part_n) * c.sizeof(c.int)))
    if: l2_part_doc = 0 || l2_part_m0 = 0 || l2_part_m1 = 0 || l2_part_ns = 0
        return: l2_error(l2_part_path[0], 0, "out of memory")
    while: k < l2_part_n
        l2_part_doc[k]: 0
        l2_part_m0[k]: 0
        l2_part_m1[k]: 0
        l2_part_ns[k]: 0 - 1
        k: k + 1
    k: 0
    while: k < l2_part_n
        if: l2_path_is_lm2(l2_part_path[k]) = 0
            c.fprintf(l1_stderr(), "l2trans error: %s:1:1: expected a .lm2 source\n", l2_part_path[k])
            l2_diag_n: l2_diag_n + 1
            return: 1
        document: 0
        if: lm_p0_parse_file(l2_part_path[k], @ document) != 0 || document = 0 || lm_p0_document_root(document) = 0
            if: l2_input_said(l2_part_path[k], document) = 0
                c.fprintf(l1_stderr(), "l2trans error: %s: cannot read a program file\n", l2_part_path[k])
                l2_diag_n: l2_diag_n + 1
            ---
            if: document != 0
                lm_p0_document_destroy(document)
            return: 1
        l2_part_doc[k]: document
        if: l2_program_tables(lm_p0_document_root(document), l2_part_path[k]) != 0
            return: 1
        k: k + 1
return: 0


# Said at its cause (one mechanism, REVIEW 2a48dc7): a located line about the program's tables -- a cell a
# row needs, a column or a row a table lacks, a table the program lacks -- with the flags every site that
# asked reads to add nothing (l2_cv_refused, l2_primitive_leaf_implements).  1.
fn: l2_table_said (const: @(char path); const: @(LmP0Node at); const: @(char msg)) int
    if: path = 0
        path: l2_src
    l2_error(path, at, msg)
    l2_cv_said: 1
    l2_pr_said: 1
    l2_cv_gap: 3
return: 1

# The conversion table (§8, Q46): the program's source table `primitive.convert`, asked by name when a
# conversion first needs it, with the columns the conversion reads.  l2_cv_gap 1: no usable row.  2: the
# row's receiver is no method of the program.  3: said at its cause (l2_table_said).  5: the program has no
# such table -- said at the edge that needed it.
fn: l2_convert_load () int
    []: char msg 160
    int: k 0
    if: l2_cv_ready != 0
        return: l2_cv_failed
    l2_cv_ready: 1
    l2_cv_failed: 1
    l2_cv_t: l2_table_find("primitive.convert")
    if: l2_cv_t < 0
        return: 1
    # The receiver is the row's `receiver` cell; the `impl` column is data the translator does not read (a
    # receiver is a method of the program, found by name: REVIEW 311902d, answer 2).
    while: k < 4
        l2_cv_c[k]: l2_table_col(l2_cv_t, l2_convert_colname(k))
        if: l2_cv_c[k] < 0
            c.snprintf(msg, 160U, "conversion table has no column %s", l2_convert_colname(k))
            return: l2_table_said(l2_tb_path[l2_cv_t], l2_tb_cols[l2_cv_t], msg)
        k: k + 1
    l2_cv_failed: 0
return: 0

# The columns the primitive question reads, by name: its query of `primitive.description`.
fn: l2_prim_colname (int: k) const: @: char
    if: k = 0
        return: "class"
    if: k = 1
        return: "cell"
return: "convert"

# The row of primitive.description whose `class` is this name (a quoted spelling the same name) -- the
# name as written (name), or a type word of the translator (cname) -- or -1.
fn: l2_prim_row (const: @(LmP0Text name); const: @(char cname)) int
    int: r 0
    int: at
    while: r < l2_tb_nrow[l2_pr_t]
        at: l2_tb_cell0[l2_pr_t] + r * l2_tb_ncol[l2_pr_t] + l2_pr_c[0]
        if: l2_tbx_name[at] != 0 && name != 0 && l2_payload_same(name, l2_tbx_arg[at]\as\atom) != 0
            return: r
        if: l2_tbx_name[at] != 0 && cname != 0 && l2_payload_eq(l2_tbx_arg[at]\as\atom, cname) != 0
            return: r
        r: r + 1
return: 0 - 1

# The primitive table (slice 2; §8, Q46): the program's source table `primitive.description`, asked by name
# when a question first needs it, with the columns class, cell and convert.  A program without it is said so
# once, where the program was being read (l2_q_at); a column it lacks, or a row for a type word of the
# translator, is said at the table -- each with the flags that tell the site that asked to add nothing.
fn: l2_prim_load () int
    []: char msg 160
    int: k 0
    if: l2_pr_ready != 0
        return: l2_pr_failed
    l2_pr_ready: 1
    l2_pr_failed: 1
    l2_pr_t: l2_table_find("primitive.description")
    if: l2_pr_t < 0
        return: l2_table_said(l2_q_path, l2_q_at, "the program has no source table `primitive.description`")
    while: k < 3
        l2_pr_c[k]: l2_table_col(l2_pr_t, l2_prim_colname(k))
        if: l2_pr_c[k] < 0
            c.snprintf(msg, 160U, "primitive table has no column %s", l2_prim_colname(k))
            return: l2_table_said(l2_tb_path[l2_pr_t], l2_tb_cols[l2_pr_t], msg)
        k: k + 1
    # The translator's own type words (l2_prim_code_name: its codes for int, char, size_t, unsigned,
    # ulong, void) are what it asks the table about on every typed store: each needs its row, or the
    # translator would answer for it by its codes where the table says nothing.  Until those codes come
    # from the table (the inventory of closed lists), a missing row is refused here, at the table.
    k: 0
    while: k <= 64
        if: l2_prim_code_name(k) != 0 && l2_prim_row(0, l2_prim_code_name(k)) < 0
            c.snprintf(msg, 160U, "primitive table has no row for %s, a type word of the translator", l2_prim_code_name(k))
            return: l2_table_said(l2_tb_path[l2_pr_t], l2_tb_call[l2_pr_t], msg)
        k: k + 1
    l2_pr_failed: 0
return: 0



# The row for from_n -> to_n; its receiver -- a method of the program, found by the name its `receiver` cell
# gives (Q33; §8) -- is left in l2_cv_recv.
fn: l2_convert_hit (const: @(char from_n); const: @(char to_n)) @: char
    int: r 0
    int: at
    int: k 0
    @: char cf
    @: char ct
    @: char cx
    @: char cr
    l2_cv_gap: 0
    l2_cv_recv: 0
    if: from_n = 0 || to_n = 0
        return: 0
    if: l2_convert_load() != 0
        l2_cv_gap: 3
        if: l2_cv_t < 0
            l2_cv_gap: 5
        return: 0
    while: r < l2_tb_nrow[l2_cv_t]
        # A cell gives a name only when it is one atom (l2_tbx_name); another argument is no type name,
        # so it matches no from or to.  The row chosen needs a flag and names from its other cells:
        # where one of them is another argument, that is said at the cell -- evaluating a table
        # argument by its column's type waits for the column types (steps/table-receiver.md §5) --
        # never read as a default.
        at: l2_tb_cell0[l2_cv_t] + r * l2_tb_ncol[l2_cv_t]
        cf: l2_tbx_name[at + l2_cv_c[0]]
        ct: l2_tbx_name[at + l2_cv_c[1]]
        cx: l2_tbx_name[at + l2_cv_c[2]]
        cr: l2_tbx_name[at + l2_cv_c[3]]
        if: cf != 0 && ct != 0 && c.strcmp(cf, from_n) = 0 && c.strcmp(ct, to_n) = 0
            if: cx = 0 || cr = 0
                k: at + l2_cv_c[3]
                if: cx = 0
                    k: at + l2_cv_c[2]
                l2_table_said(l2_tb_path[l2_cv_t], l2_tbx_arg[k], "a conversion table cell this row needs is not a name (evaluating a table argument is not ported yet)")
                return: 0
            if: c.strcmp(cx, "1") = 0 || c.strcmp(cr, "None") = 0
                l2_cv_gap: 1
                return: 0
            l2_cv_recv: cr
            if: l2_convert_method() < 0
                l2_cv_gap: 2
                return: 0
            return: cr
        r: r + 1
    l2_cv_gap: 1
return: 0

# The program's method a conversion calls: the one its row's receiver names (l2_cv_recv; Q33, §8), or -1.
fn: l2_convert_method () int
    int: i 0
    while: l2_cv_recv != 0 && i < l2_m_n
        if: l2_m_name[i] != 0 && l2_text_eq(l2_m_name[i], l2_cv_recv)
            return: i
        i: i + 1
return: 0 - 1

# A conversion edge calls its receiver, a method of the program (Q33; §8): an ordinary edge to it.  A row
# whose receiver is no method of the program was refused at the edge (l2_cv_gap 2).
fn: l2_convert_edge (int: mi; const: @(char path); const: @(LmP0Node stmt)) int
    int: idx
    idx: l2_convert_method()
    if: idx < 0
        return: l2_error(path, stmt, "internal: a conversion without its receiver")
    l2_m_edge[l2_edge_off(mi, idx)]: l2_m_edge[l2_edge_off(mi, idx)] | 1
return: l2_note_call(mi, idx, stmt, path)

# A row whose receiver is no method of the program (§8): said at the edge, with the receiver's name.
fn: l2_convert_norecv (const: @(char path); const: @(LmP0Node at)) int
    if: l2_cv_recv = 0
        return: l2_error(path, at, "the program has no method for the receiver of this conversion")
return: l2_error_name(path, at, "the program has no method `", l2_cv_recv, strlen(l2_cv_recv), "`, the receiver of this conversion")

# The program part method mi was read from, or -1: a method of the source (§8).
fn: l2_m_part (int: mi) int
    int: k 0
    while: mi >= 0 && k < l2_part_n && l2_part_m0 != 0
        if: mi >= l2_part_m0[k] && mi < l2_part_m1[k]
            return: k
        k: k + 1
return: 0 - 1

# The file a method was read from: a method of a program part, and its root's procedure (§10), is located in
# that part (§8), every other in the source.
fn: l2_method_src (int: mi; const: @(char path)) const: @: char
    int: k
    k: l2_m_code_file(mi)
    if: k >= 0
        return: l2_part_path[k]
return: path

# The store of a keyed pair calls the receiver: the value is its actual and
# the result is the stored token (l2_tok). A refusal of the receiver is the
# implicit throw `convert` of this method (l2_emit_call). 0: no conversion
# here. 1: error. 2: no row. 3: the call is emitted.  A composite value (n > 1
# fields, the slices 3/4 boundary) is typed by l2_native_composite_ty and the
# WHOLE field chain is handed to the receiver unchanged -- fr\body already
# holds exactly the store's own value fields and nothing else consumes them
# when this returns 3 (the caller skips its own plain l2_eval_fields then).
fn: l2_convert_on_store (int: mi; int: oi; const: @(LmP0Node stmt); const: @(LmP0Frame fr); const: @(char ind)) int
    if: oi < 0
        return: 0
return: l2_convert_value_to(mi, l2_ft_of_own(l2_own_ty[oi]), stmt, fr, ind)

# The same edge into a place of type to_ft (a formal code): an own field's (l2_convert_on_store), a field written
# through a path (l2_emit_stmts, OPUS-PATHCONV-20260929-10).  Its codes are l2_convert_on_store's.
fn: l2_convert_value_to (int: mi; int: to_ft; const: @(LmP0Node stmt); const: @(LmP0Frame fr); const: @(char ind)) int
    int: from_ft 0
    int: idx
    int: rc
    int: n
    @: LmP0Field only
    const: @(char from_n)
    const: @(char to_n)
    if: to_ft < 0 || fr = 0 || fr\body = 0
        return: 0
    n: l2_count_active(fr\body)
    if: n < 1
        return: 0
    if: n = 1
        only: l2_next_active(fr\body\first_field)
        if: only = 0 || l2_colon_value_ty(only\value, mi, @ from_ft) != 0
            return: 0
    ---
    if: n > 1
        from_ft: l2_native_composite_ty(fr\body\first_field, n, mi)
        if: from_ft = 0 - 3
            return: 2
        if: from_ft = 0 - 1
            return: 0
    ---
    from_n: l2_prim_code_name(from_ft)
    to_n: l2_prim_code_name(to_ft)
    if: from_n = 0 || to_n = 0 || c.strcmp(from_n, to_n) = 0
        return: 0
    if: l2_convert_hit(from_n, to_n) = 0
        return: 2
    idx: l2_convert_method()
    if: idx < 0
        return: l2_error(l2_src, stmt, "internal: a conversion site was not checked")
    rc: l2_emit_call(stmt, idx, 0, 0 - 1, fr\body, mi, ind, l2_tok, 1)
    if: rc != 0
        return: 1
return: 3

# A composite (multi-field) value's translation-time type, native-safe: reuses borrowed spans (pure
# field flattening) and l2_rw_split/l2_rw_prec/l2_rw_unify (pure precedence structure) from the
# walked root's own l2_rw_tyof, but types each LEAF through l2_colon_bound_ty/l2_colon_simple_ty
# (l2_native_leaf_ty) instead of l2_rw_opty -- l2_rw_opty's bound-name path (l2_rw_own_ty) reads
# l2_rw_seen, the walk's own count-pass bookkeeping, which is never populated for an ordinary
# method's own fields outside a walk (measured: reusing l2_rw_tyof directly refused ordinary
# local-variable composites like `keep - 1U` as "incompatible type" across two dozen unrelated
# fixtures).  A path atom's glued text (`a\value`, l2_rw_path_atom) is typed by the number field
# it reaches (l2_native_path_ty; l2_colon_bound_ty looks up a plain declared name, not a path).
# A callable formal, bare or called, is typed by its contract's result (l2_native_cf_ty).  Two shapes
# do not resolve as a plain numeric value -- a path that reaches no number field and a non-numeric
# bound name (a dynamic call) -- and must poison the WHOLE composite (a distinct code, -99, that a leaf's own
# unify-permissive -1/-2 must never be confused with: unify(-1, -1) already means "two untyped
# literals," not "two things I could not resolve," and defaulting the latter to unsigned produced
# the same false "incompatible type" refusal one level up).  Returns a plain primitive type code
# (0/1/2/3/36), or -3 when the composite is itself internally mixed (located "mixed numeric
# types"), or -1 when it cannot be typed at all -- the caller's silent bypass, same as an
# unresolved single value.
# A prefix sign: `-` (1) or `+` (2). The grammar lists them among the prefix
# operators and says that writing a prefix next to its operand is style, so the
# token alone says nothing. The expression context does: the sign is a prefix
# only where an operand begins (l2_operand_run), never where an operator stands.
fn: l2_prefix_sign (const: @(LmP0Text t)) int
    if: t = 0
        return: 0
    if: l2_text_eq(t, "-")
        return: 1
    if: l2_text_eq(t, "+")
        return: 2
return: 0

# `-(a + b)`: P0 gives a sign written against a group as a Frame headed by the
# sign. It is the same prefix over that group. 0 for any other node.
fn: l2_prefix_frame (const: @(LmP0Node node)) int
    if: node = 0 || node\kind != c.LM_P0_NODE_FRAME || node\as = 0 || node\as\frame = 0 || node\as\frame\body = 0 || node\as\frame\trailer != 0
        return: 0
return: l2_prefix_sign(node\as\frame\head)

# The operand of a span that begins with a prefix sign: every field after the
# sign. 1 when the span does not begin with one.
fn: l2_prefix_rest (@: L2ValueSpan span; @: L2ValueSpan rest) int
    @: LmP0Field f
    if: span = 0 || rest = 0 || span\count < 2
        return: 1
    f: l2_next_active(span\first)
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM || f\value\as = 0 || l2_prefix_sign(f\value\as\atom) = 0
        return: 1
    rest\first: l2_next_active(f\next)
    rest\count: span\count - 1
    if: rest\first = 0
        return: 1
    rest\node: rest\first\value
return: 0

# The native kind of a prefix sign's result from its operand's: the operand
# promoted as C promotes it (l2_rw_unify of a type with itself). A reference or
# a text is no number: the kind rule's own refusals, located at the operand.
fn: l2_prefix_native_ty (int: ty; const: @(LmP0Node at)) int
    if: ty <= 0 - 15 && ty >= 0 - 17
        return: ty
    if: ty = 0 - 5
        if: l2_kind_at = 0
            l2_kind_at: (cast: (@: LmP0Node) at)
        return: 0 - 15
    if: ty = 0 - 6
        if: l2_kind_at = 0
            l2_kind_at: (cast: (@: LmP0Node) at)
        return: 0 - 16
    if: ty = 0 - 99 || ty = 0 - 3
        return: ty
return: l2_rw_unify(ty, ty)

fn: l2_native_leaf_ty (const: @(LmP0Node node); int: mi) int
    @: LmP0Text t
    int: neg 0
    size_t: mag 0U
    int: usuf 0
    int: ty 0
    int: eoi 0 - 1
    size_t: eix 0U
    LmP0Text: base
    int: levels
    L2IndexedOperand: indexed_value
    @: L2IndexedOperand indexed @ indexed_value
    if: node = 0 || node\as = 0
        return: 0 - 99
    if: l2_indexed_node(node, mi, indexed) = 0
        if: l2_prim_code_name(indexed\type) != 0
            return: indexed\type
        return: 0 - 99
    if: node\kind = c.LM_P0_NODE_ATOM
        t: node\as\atom
        if: l2_deref_word(t, mi, @ base, @ levels, @ ty) = 0
            if: l2_pointer_depth(ty) > 0
                return: -5
            return: ty
        if: l2_rw_num_lit(t, @ neg, @ mag, @ usuf) != 0
            if: usuf != 0
                return: 0 - 2
            return: 0 - 1
        if: l2_rw_has_slash(t) != 0
            return: l2_native_path_ty(t)
        # A callable formal named bare runs (callable-first): its value is its contract's result (l2_native_cf_ty).
        if: l2_native_cf_ty(mi, t) != 0 - 100
            return: l2_native_cf_ty(mi, t)
        # K03 S4: a named Structure's name is the Structure, a reference (the resolution's kind 5): the kind rule's -5.
        if: l2_head_resolve(mi, t, 0, 0) = 5
            l2_kind_at: (cast: (@: LmP0Node) node)
            return: 0 - 5
        if: l2_colon_simple_ty(node, mi, @ ty) != 0
            return: 0 - 99
        # A text is no number (-11; -10 is a number literal or a char), and a Structure is a reference: their own
        # kinds, -6 and -5, for the kind rule (l2_native_expr_ty).
        if: ty = 0 - 11
            l2_kind_at: (cast: (@: LmP0Node) node)
            return: 0 - 6
        if: ty = 0 - 10
            return: 0 - 1
        if: l2_colon_is_graph_ty(ty) != 0
            l2_kind_at: (cast: (@: LmP0Node) node)
            return: 0 - 5
        if: l2_prim_code_name(ty) = 0
            return: 0 - 99
        return: ty
    if: node\kind = c.LM_P0_NODE_FRAME
        if: l2_prefix_frame(node) != 0
            return: l2_prefix_native_ty(l2_native_group_ty(node\as\frame\body\first_field, l2_count_active(node\as\frame\body), mi), node)
        # A callable formal's call: its contract's result (l2_native_cf_ty).
        if: node\as\frame != 0 && l2_native_cf_ty(mi, node\as\frame\head) != 0 - 100
            return: l2_native_cf_ty(mi, node\as\frame\head)
        if: l2_colon_simple_ty(node, mi, @ ty) != 0
            return: 0 - 99
        if: l2_colon_is_graph_ty(ty) != 0
            l2_kind_at: (cast: (@: LmP0Node) node)
            return: 0 - 5
        if: l2_prim_code_name(ty) = 0
            return: 0 - 99
        return: ty
    # A parenthesized group beside other operands -- `(k + j) * 1U`; P0 makes a sole container transparent, one with
    # neighbours stays a Structure -- is the expression its fields make (l2_native_group_ty).
    if: node\kind = c.LM_P0_NODE_STRUCTURE
        if: node\as\structure = 0
            return: 0 - 99
        return: l2_native_group_ty(node\as\structure\first_field, l2_count_active(node\as\structure), mi)
return: 0 - 99

# The kind rule over a prefix sign applied to a group: a reference or a text
# under the sign is refused where it stands, and two numeric types in the
# group are a conversion. 1: refused, said. 0: nothing to say.
fn: l2_prefix_kind_refused (const: @(LmP0Node node); int: mi; const: @(char path)) int
    int: ty
    @: LmP0Node where
    if: l2_prefix_frame(node) = 0
        return: 0
    l2_kind_at: 0
    ty: l2_native_leaf_ty(node, mi)
    where: l2_kind_at
    if: where = 0
        where: (cast: (@: LmP0Node) node)
    if: ty = 0 - 15
        return: l2_error(path, where, "a reference where a number is asked")
    if: ty = 0 - 16
        return: l2_error(path, where, "a text where a number is asked")
    if: ty = 0 - 17
        return: l2_error(path, where, "a reference compared with a number other than 0")
    if: ty = 0 - 3
        return: l2_error(path, where, "mixed numeric types (a conversion)")
return: 0

# Is value the bare name of a callable formal of method mi -- named where a value is consumed, its call?
fn: l2_cf_named (int: mi; const: @(LmP0Node value)) int
    int: k
    int: formal
    if: mi < 0 || value = 0 || value\kind != c.LM_P0_NODE_ATOM || value\as = 0 || value\as\atom = 0
        return: 0
    k: l2_call_head_method(mi, value\as\atom, @ formal)
    if: k >= 0 && formal >= 0
        return: 1
return: 0

# Is tok[lo..hi] the one literal 0 -- all that stands beside a reference (the walk's l2_rw_tlit)?
fn: l2_native_zero (@: L2ValueSpan tok; int: lo; int: hi) int
    if: lo != hi || l2_span_node(tok, lo) = 0 || l2_span_node(tok, lo)\kind != c.LM_P0_NODE_ATOM || l2_span_node(tok, lo)\as = 0 || l2_span_node(tok, lo)\as\atom = 0
        return: 0
return: l2_text_eq(l2_span_node(tok, lo)\as\atom, "0")

fn: l2_native_expr_ty (@: L2ValueSpan tok; int: lo; int: hi; int: mi) int
    int: best
    int: p
    int: a
    int: b
    int: u
    if: lo = hi
        return: l2_native_span_ty(tok + lo, mi)
    best: l2_rw_split(tok, lo, hi)
    p: l2_rw_prec(l2_span_node(tok, best)\as\atom)
    a: l2_native_expr_ty(tok, lo, best - 1, mi)
    b: l2_native_expr_ty(tok, best + 1, hi, mi)
    # The kind rule (the walk's -179; a text is no number).  A refusal found below goes up as it is: -15 a reference
    # where a number is asked, -16 a text where a number is asked, -17 a reference compared with a number other than 0.
    if: a <= 0 - 15 && a >= 0 - 17
        return: a
    if: b <= 0 - 15 && b >= 0 - 17
        return: b
    # A text in a comparison or in arithmetic; a reference in arithmetic.
    if: p >= 3 && (a = 0 - 6 || b = 0 - 6)
        return: 0 - 16
    if: p >= 5 && (a = 0 - 5 || b = 0 - 5)
        return: 0 - 15
    # A reference compared: with a reference, or with the literal 0 (beside a reference only 0 stands); a literal
    # other than 0 is refused as the walk refuses it, a typed number is a reference where a number is asked.
    if: (p = 3 || p = 4) && (a = 0 - 5 || b = 0 - 5)
        if: a = 0 - 5 && b = 0 - 5
            return: 0
        if: (a = 0 - 5 && l2_native_zero(tok, best + 1, hi) != 0) || (b = 0 - 5 && l2_native_zero(tok, lo, best - 1) != 0)
            return: 0
        if: a = 0 - 5 && (b = 0 - 1 || b = 0 - 2) && best + 1 = hi
            l2_kind_at: l2_span_node(tok, hi)
            return: 0 - 17
        if: b = 0 - 5 && (a = 0 - 1 || a = 0 - 2) && lo = best - 1
            l2_kind_at: l2_span_node(tok, lo)
            return: 0 - 17
        # A typed number beside a reference; an operand the typer does not know is not this rule's.
        if: (a = 0 - 5 && b >= 0 && l2_prim_code_name(b) != 0) || (b = 0 - 5 && a >= 0 && l2_prim_code_name(a) != 0)
            return: 0 - 15
        return: 0 - 99
    ---
    # A logical operation keeps a text or a reference operand untyped, as before.
    if: a = 0 - 5 || b = 0 - 5 || a = 0 - 6 || b = 0 - 6
        return: 0 - 99
    if: a = 0 - 99 || b = 0 - 99
        return: 0 - 99
    if: p = 1 || p = 2
        if: a = 0 - 3 || b = 0 - 3
            return: 0 - 3
        return: 0
    ---
    u: l2_rw_unify(a, b)
    if: u = 0 - 3
        return: 0 - 3
    ---
    p: l2_rw_prec(l2_span_node(tok, best)\as\atom)
    if: p = 3 || p = 4
        return: 0
return: u

# The type of a parenthesized group's n fields from `first`: operands and operators alternate, as the walk types a
# group (l2_rw_fields_ty); any other run of fields stays untyped (-99), as a Structure operand was.
fn: l2_native_group_ty (@: LmP0Field first; int: n; int: mi) int
    @: L2ValueSpan tok
    int: m
    int: ty
    tok: l2_value_spans(first, n, @ m)
    if: tok = 0
        return: 0 - 99
    ty: l2_native_expr_ty(tok, 0, m - 1, mi)
    l2_xfree((cast: (@: void) tok))
return: ty

# The type of a path to a number field -- the field it reaches (l2_path_kind -> l2_path_kind_ft, as the path write's
# check reads it; the walk types a path operand by its field, l2_rw_opty) -- or -99 for any other path, which leaves
# the composite untyped.
fn: l2_native_path_ty (const: @(LmP0Text t)) int
    int: leaf 0
    int: ft
    if: t = 0 || t\data = 0 || t\length = 0U
        return: 0 - 99
    ft: l2_path_kind_ft(l2_path_kind(t\data, t\length, @ leaf))
    if: ft < 0
        return: 0 - 99
return: ft

# A callable formal of method mi named t -- bare (it runs, callable-first) or called -- is a value of its contract's
# result (l2_colon_ret_ty of the contract, as l2_colon_value_ty types a whole value): that number type, or -99 for any
# other result.  -100: t is no callable formal of mi.
fn: l2_native_cf_ty (int: mi; const: @(LmP0Text t)) int
    int: k
    int: formal
    int: ty 0
    if: mi < 0 || t = 0
        return: 0 - 100
    k: l2_call_head_method(mi, t, @ formal)
    # K03 NS-ROLES-1b: a binding `b: tick`, named bare or called, is a value of tick's result, as a callable formal is.
    if: k < 0 || (formal < 0 && l2_call_alias_own(mi, t) < 0)
        return: 0 - 100
    if: l2_colon_ret_ty(k, @ ty) != 0 || l2_prim_code_name(ty) = 0
        return: 0 - 99
return: ty

# Is the store of the path pd..pn into own field `head` of method mi the general store's, not the path branch's plain
# read of a number leaf?  It is for a number field of another type than the own field's -- a conversion
# (l2_convert_on_store) -- and for a reference field (`@: T name`, kinds 10 and 11): its value is the reference the
# field holds, read as any reference field is read (l2_path_text_read), and stored as any reference is, with its
# admission (REF-FIELD-VALUE-READ: the path branch, which reads number leaves only, stored stale text for one) -- and
# for a path that selects a callable (K03 S6, l2_path_callee): its value is the callable's nullary call, evaluated as
# `A\M()` is (l2_emit_fields).  0 for any other path or place.
fn: l2_path_store_general (int: mi; const: @(LmP0Text head); const: @(char pd); size_t: pn) int
    int: leaf 0
    int: kind
    int: pft
    int: oft
    int: oi
    LmP0Text: word
    oi: l2_own_visible(mi, head)
    if: oi < 0 || pd = 0 || pn = 0U
        return: 0
    word.data: pd
    word.length: pn
    if: l2_path_callee(mi, @ word) >= 0
        return: 1
    kind: l2_path_kind(pd, pn, @ leaf)
    if: kind = 10 || kind = 11
        return: 1
    pft: l2_path_kind_ft(kind)
    oft: l2_ft_of_own(l2_own_ty[oi])
    if: pft < 0 || l2_prim_code_name(pft) = 0 || l2_prim_code_name(oft) = 0 || pft = oft
        return: 0
return: 1

fn: l2_native_composite_ty (@: LmP0Field field; int: n; int: mi) int
    @: L2ValueSpan tok
    int: m
    int: ty
    L2Address: address_value
    @: L2Address address @ address_value
    L2IndexedOperand: indexed_value
    @: L2IndexedOperand indexed @ indexed_value
    if: l2_indexed_operand(field, n, mi, indexed) = 0 && indexed\count = n
        return: indexed\type
    if: l2_ptr_arith_ty(field, n, mi, @ ty) = 0
        return: ty
    if: l2_address_operand(field, n, mi, address) = 0
        return: address\type
    if: field = 0 || n < 2
        return: 0 - 1
    tok: l2_value_spans(field, n, @ m)
    # One token of several fields is a path (P0 gives `P\v` as `P`, `\`, `v`): the value's one operand, typed as a leaf.
    if: tok = 0
        return: 0 - 1
    ty: l2_native_expr_ty(tok, 0, m - 1, mi)
    l2_xfree((cast: (@: void) tok))
    if: ty = 0 - 3
        return: 0 - 3
    # A kind refusal is said by the field check (l2_check_value_kinds); to these callers the value stays untyped.
    if: ty = 0 - 99 || ty = 0 - 5 || ty = 0 - 6 || (ty <= 0 - 15 && ty >= 0 - 17)
        return: 0 - 1
    if: ty = 0 - 1
        ty: 0
    if: ty = 0 - 2
        ty: 3
return: ty

# implements-port slices 3 and 4 (A3; steps/implements-port-plan.md): one value of one named
# primitive type given to a place of another -- a formal (slice 3) or a callable's result
# (slice 4) -- is the edge an assignment has (l2_colon_check_assignment): the row's receiver is
# called on the value and its result takes the place; with no row it is refused, located at the
# value.  to_ft is the place's formal code.  A literal is typed by its place (-10).  The shared
# core once from_ft is known (l2_colon_simple_ty for one value, l2_native_composite_ty for a
# composite, l2_check_value_convert_field's own dispatch) -- 0: nothing to do or the edge noted;
# 1: error.
# The expression kind is independent of its exact machine pointer type.
# After held-result resolution, a numeric receiver must not lose a whole
# reference operand merely because its precise pointer contract is deferred.
fn: l2_check_numeric_span_kind (@: LmP0Field first; int: n; int: mi; const: @(char path)) int
    int: ty
    @: LmP0Field field l2_next_active(first)
    if: n < 2 || field = 0
        return: 0
    ty: l2_native_group_ty(first, n, mi)
    if: ty = -5
        return: l2_error(path, field\value, "a reference where a number is asked")
return: 0

fn: l2_check_value_convert_core (const: @(LmP0Node value); int: from_ft; int: to_ft; int: mi; const: @(char path)) int
    int: cok
    # A text or a Structure given to a number place (a formal, a declaration): the kind rule (-179), in the walk's words.
    # A callable formal named here is its call (callable-first), not the formal: not typed here, as before.
    if: from_ft = 0 - 11
        return: l2_error(path, value, "a text where a number is asked")
    if: l2_colon_is_graph_ty(from_ft) != 0 && l2_cf_named(mi, value) = 0
        return: l2_error(path, value, "a reference where a number is asked")
    if: from_ft = 8 || l2_prim_code_name(from_ft) = 0
        return: 0
    if: c.strcmp(l2_prim_code_name(from_ft), l2_prim_code_name(to_ft)) = 0
        return: 0
    cok: l2_colon_types_compatible(to_ft, from_ft)
    if: cok = 0 && l2_cv_gap = 3
        return: l2_cv_refused(path, value, "internal: a conversion refused without its reason")
    if: cok = 0 && l2_cv_gap = 5
        return: l2_error(path, value, "the program has no source table `primitive.convert`")
    if: cok = 0 && l2_cv_gap = 2
        return: l2_convert_norecv(path, value)
    if: cok = 0 && l2_cv_gap = 1
        return: l2_error(path, value, "mixed numeric types (a conversion)")
    if: cok = 0
        return: l2_error(path, value, "value has incompatible type")
    if: l2_cv_used != 0 && l2_convert_edge(mi, path, value) != 0
        return: 1
return: 0

fn: l2_check_value_convert (const: @(LmP0Node value); int: to_ft; int: mi; const: @(char path)) int
    int: from_ft 0
    if: value = 0 || to_ft = 8 || l2_prim_code_name(to_ft) = 0
        return: 0
    if: l2_colon_simple_ty(value, mi, @ from_ft) != 0
        return: 0
return: l2_check_value_convert_core(value, from_ft, to_ft, mi, path)

# The field-span form of l2_check_value_convert: one value (n = 1, l2_colon_simple_ty, unchanged)
# or a composite (n > 1, l2_native_composite_ty -- the slices 3/4 boundary). field is the span's
# own first active field, unadvanced. A composite that is internally
# mixed is a located refusal, same phrase as a single mismatched value with no converter row.
fn: l2_check_value_convert_field (@: LmP0Field field; int: n; int: to_ft; int: mi; const: @(char path)) int
    int: from_ft
    @: LmP0Field only
    if: field = 0 || n < 1 || to_ft = 8
        return: 0
    # A receiving contract, including a pointer, waits for hidden inputs to
    # acquire their ordinary source type before checking compatibility.
    if: l2_waits(field, n, mi) != 0
        return: l2_wait_add(2, mi, (cast: (@: void) field), n, to_ft, field\value, path)
    if: l2_pointer_depth(to_ft) > 0
        return: l2_check_receiving_value(field\value, field, n, to_ft, 0 - 1, 0, mi, path)
    if: l2_prim_code_name(to_ft) = 0
        return: 0
    only: l2_next_active(field)
    if: only = 0
        return: 0
    # A number place: the bare name of a held callable is received as its result.
    if: l2_held_result_receive(mi, field, n, 1, path) != 0
        return: 1
    if: l2_check_numeric_span_kind(field, n, mi, path) != 0
        return: 1
    # K03 S4: a named Structure's name is the Structure, a reference: a number place refuses it, as the call's actuals do.
    if: n = 1 && only\value != 0 && only\value\kind = c.LM_P0_NODE_ATOM && l2_head_resolve(mi, only\value\as\atom, 0, 0) = 5
        return: l2_error(path, only\value, "a reference where a number is asked")
    if: n = 1
        return: l2_check_value_convert(only\value, to_ft, mi, path)
    if: n > 1
        from_ft: l2_native_composite_ty(field, n, mi)
        if: from_ft = 0 - 3
            return: l2_error(path, only\value, "mixed numeric types (a conversion)")
        if: from_ft = 0 - 1
            return: 0
        return: l2_check_value_convert_core(only\value, from_ft, to_ft, mi, path)
return: 0

# The emission of l2_check_value_convert's edge: the receiver is called on the one value -- a
# one-field Structure over a copy of its field, so l2_emit_call evaluates it once, in this method --
# and its result token takes the place; a refusal of the receiver is this method's implicit throw
# `convert` (edge 1), as at a store (l2_convert_on_store).  0: emitted into dest.  1: error.
# 2: no conversion here.
fn: l2_emit_value_convert (const: @(LmP0Node node); @: LmP0Field a0; int: to_ft; int: mi; const: @(char ind); @: L2Tx dest) int
    int: from_ft 0
    int: cidx
    int: rc
    @: LmP0Structure one 0
    @: LmP0Field f 0
    if: a0 = 0 || a0\value = 0 || to_ft = 8 || l2_prim_code_name(to_ft) = 0
        return: 2
    if: l2_colon_simple_ty(a0\value, mi, @ from_ft) != 0 || from_ft = 8 || l2_prim_code_name(from_ft) = 0
        return: 2
    if: c.strcmp(l2_prim_code_name(from_ft), l2_prim_code_name(to_ft)) = 0
        return: 2
    if: l2_convert_hit(l2_prim_code_name(from_ft), l2_prim_code_name(to_ft)) = 0
        return: l2_error(l2_src, a0\value, "internal: a conversion site was not checked")
    cidx: l2_convert_method()
    if: cidx < 0
        return: l2_error(l2_src, a0\value, "internal: a conversion site was not checked")
    one: (cast: (@: LmP0Structure) l2_xmalloc(c.sizeof(c.LmP0Structure)))
    f: (cast: (@: LmP0Field) l2_xmalloc(c.sizeof(c.LmP0Field)))
    if: one = 0 || f = 0
        if: one != 0
            l2_xfree((cast: (@: void) one))
        if: f != 0
            l2_xfree((cast: (@: void) f))
        return: l2_error(l2_src, a0\value, "out of memory")
    memset((cast: (@: void) one), 0, c.sizeof(c.LmP0Structure))
    memcpy((cast: (@: void) f), (cast: (@: void) a0), c.sizeof(c.LmP0Field))
    f\next: 0
    one\first_field: f
    rc: l2_emit_call(node, cidx, 0, 0 - 1, one, mi, ind, dest, 1)
    l2_xfree((cast: (@: void) f))
    l2_xfree((cast: (@: void) one))
    if: rc != 0
        return: 1
return: 0

# The composite (n > 1 fields) form of l2_emit_value_convert's edge: the same shape, but the
# receiver's one actual is a COPY of the whole n-field chain (not one field) -- l2_emit_call groups
# it into the receiver's single formal by arity, the same way a composite actual already groups
# into any one-formal call today (`take(n - 1)`).  The copy is taken once (l2_xmalloc'd as an
# array, relinked by \next, mirroring l2_rw_convert's own root-side copy) so the composite
# expression is evaluated exactly once, in the receiver call, not duplicated.
fn: l2_emit_value_convert_n (const: @(LmP0Node node); @: LmP0Field field; int: n; int: to_ft; int: mi; const: @(char ind); @: L2Tx dest) int
    int: from_ft
    int: cidx
    int: rc
    int: i 0
    @: LmP0Field f
    @: LmP0Field copy 0
    @: LmP0Field cur 0
    @: LmP0Field prev 0
    @: LmP0Structure one 0
    if: field = 0 || n < 2 || to_ft = 8 || l2_prim_code_name(to_ft) = 0
        return: 2
    from_ft: l2_native_composite_ty(field, n, mi)
    if: from_ft = 0 - 3 || from_ft = 0 - 1 || l2_prim_code_name(from_ft) = 0
        return: 2
    if: c.strcmp(l2_prim_code_name(from_ft), l2_prim_code_name(to_ft)) = 0
        return: 2
    if: l2_convert_hit(l2_prim_code_name(from_ft), l2_prim_code_name(to_ft)) = 0
        return: l2_error(l2_src, node, "internal: a conversion site was not checked")
    cidx: l2_convert_method()
    if: cidx < 0
        return: l2_error(l2_src, node, "internal: a conversion site was not checked")
    one: (cast: (@: LmP0Structure) l2_xmalloc(c.sizeof(c.LmP0Structure)))
    copy: (cast: (@: LmP0Field) l2_xmalloc((cast: (size_t) n) * c.sizeof(c.LmP0Field)))
    if: one = 0 || copy = 0
        if: one != 0
            l2_xfree((cast: (@: void) one))
        if: copy != 0
            l2_xfree((cast: (@: void) copy))
        return: l2_error(l2_src, node, "out of memory")
    memset((cast: (@: void) one), 0, c.sizeof(c.LmP0Structure))
    f: l2_next_active(field)
    while: i < n && f != 0
        cur: copy + i
        memcpy((cast: (@: void) cur), (cast: (@: void) f), c.sizeof(c.LmP0Field))
        cur\next: 0
        if: prev != 0
            prev\next: cur
        ---
        prev: cur
        f: l2_next_active(f\next)
        i: i + 1
    ---
    if: i != n
        l2_xfree((cast: (@: void) copy))
        l2_xfree((cast: (@: void) one))
        return: l2_error(l2_src, node, "internal: a conversion value is shorter than its run")
    one\first_field: copy
    rc: l2_emit_call(node, cidx, 0, 0 - 1, one, mi, ind, dest, 1)
    l2_xfree((cast: (@: void) copy))
    l2_xfree((cast: (@: void) one))
    if: rc != 0
        return: 1
return: 0

# The field-span dispatcher for l2_emit_value_convert's edge: one value (n = 1, unchanged) or a
# composite (n > 1, l2_emit_value_convert_n). field is the span's own first field, unadvanced.
fn: l2_emit_value_convert_field (const: @(LmP0Node node); @: LmP0Field field; int: n; int: to_ft; int: mi; const: @(char ind); @: L2Tx dest) int
    @: LmP0Field only
    if: field = 0 || n < 1
        return: 2
    if: n = 1
        only: l2_next_active(field)
        if: only = 0
            return: 2
        return: l2_emit_value_convert(node, only, to_ft, mi, ind, dest)
    if: n > 1
        return: l2_emit_value_convert_n(node, field, n, to_ft, mi, ind, dest)
return: 2

# A callable result as the consumed-value/formal code of the same C99 type.
fn: l2_ret_ft (int: mi) int
return: l2_result_value_ty(l2_m_ret[mi])

# The kind of a `return:` value where the result is a number or a char: one value whose type is known and is no number
# -- a text, a Structure, a pointer -- is refused, as an assignment's value of its place's type is
# (l2_colon_check_assignment, "incompatible type"); it went out as C converting a pointer into the result.  A result of
# another type (a pointer, a Structure, a callable) is not this check's.
fn: l2_check_ret_kind (int: mi; const: @(LmP0Structure body); const: @(char path)) int
    int: to_ft
    int: vt 0
    @: LmP0Field only
    if: body = 0 || l2_m_ret[mi] = 8 || l2_nsty_get(mi, 0 - 1) >= 0 || l2_count_active(body) != 1
        return: 0
    to_ft: l2_ret_ft(mi)
    if: to_ft = 8 || l2_prim_code_name(to_ft) = 0
        return: 0
    # A number place: the bare name of a held callable is received as its result.
    if: l2_held_result_receive(mi, body\first_field, 1, 1, path) != 0
        return: 1
    only: l2_next_active(body\first_field)
    if: only = 0 || only\value = 0 || l2_colon_value_ty(only\value, mi, @ vt) != 0
        return: 0
    if: vt = 0 - 10 || vt = 0 - 12 || vt = 8 || l2_prim_code_name(vt) != 0
        return: 0
return: l2_error(path, only\value, "return value has incompatible type")

# Slice 4: `return: v` with one value or a composite, in a body or a trailer.  A Structure result
# is admitted (l2_admit_return), never converted.
fn: l2_check_ret_convert (int: mi; const: @(LmP0Structure body); const: @(char path)) int
    @: LmP0Field only
    if: body = 0 || l2_m_ret[mi] = 8 || l2_nsty_get(mi, 0 - 1) >= 0
        return: 0
    # A method returns its merge at one place, a statement of its body (l2_t7_return_stmt, which the check passes
    # by).  A merge returned from a nested body of the method is not built yet: a limit of this implementation and
    # no rule, said where the merge stands and not as a type error of its value.
    only: l2_next_active(body\first_field)
    if: l2_m_ret[mi] = 16 && l2_count_active(body) = 1 && only != 0 && only\value != 0 && l2_frame_head(only\value, "merge") != 0
        return: l2_error(path, only\value, "a merge returned from a nested body of its method is not built yet")
    if: l2_check_ret_kind(mi, body, path) != 0
        return: 1
return: l2_check_value_convert_field(body\first_field, l2_count_active(body), l2_ret_ft(mi), mi, path)

# Its emission: 0 emitted into dest, 1 error, 2 none.
fn: l2_emit_ret_convert (int: mi; const: @(LmP0Structure body); const: @(LmP0Node at); const: @(char ind); @: L2Tx dest) int
    if: body = 0 || l2_m_ret[mi] = 8 || l2_nsty_get(mi, 0 - 1) >= 0
        return: 2
return: l2_emit_value_convert_field(at, body\first_field, l2_count_active(body), l2_ret_ft(mi), mi, ind, dest)

# B3, a declaration's initializer (steps/implements-port-plan.md): `size_t: s (x)` / `size_t: t y`
# with an int x or y is the edge a store has -- the declaration's type is the place, read from its
# type word (l2_own_decl_ty has a numbering of its own).  A parenthesised initializer is its fields:
# the sole anonymous container is transparent at consumption.  An array declaration is no place.
fn: l2_decl_ft (const: @(LmP0Node stmt)) int
    int: code 0
    if: stmt = 0 || l2_own_decl_ty(stmt) = 0 || l2_own_array_count(stmt) != 0 || stmt\as = 0 || stmt\as\frame = 0 || l2_ret_type_word(stmt\as\frame\head, 0, 0, @ code) != 0
        return: 0 - 1
    if: code = 33
        return: 34
return: code

fn: l2_check_init_convert (const: @(LmP0Node stmt); @: LmP0Field last; int: mi; const: @(char path)) int
    int: to_ft l2_decl_ft(stmt)
    @: L2Declaration application l2_declaration(stmt)
    if: to_ft < 0 || last = 0 || last\value = 0
        return: 0
    if: application\candidate_count = 1 && last\value\kind = c.LM_P0_NODE_STRUCTURE && last\value\as != 0 && last\value\as\structure != 0
        return: l2_check_value_convert_field(last\value\as\structure\first_field, l2_count_active(last\value\as\structure), to_ft, mi, path)
return: l2_check_value_convert_field(application\candidate, application\candidate_count, to_ft, mi, path)

# Its emission: 0 emitted into dest, 1 error, 2 none.
fn: l2_emit_init_convert (const: @(LmP0Node stmt); @: LmP0Field last; int: mi; const: @(char ind); @: L2Tx dest) int
    int: to_ft l2_decl_ft(stmt)
    @: L2Declaration application l2_declaration(stmt)
    if: to_ft < 0 || last = 0 || last\value = 0
        return: 2
    if: application\candidate_count = 1 && last\value\kind = c.LM_P0_NODE_STRUCTURE && last\value\as != 0 && last\value\as\structure != 0
        return: l2_emit_value_convert_field(stmt, last\value\as\structure\first_field, l2_count_active(last\value\as\structure), to_ft, mi, ind, dest)
return: l2_emit_value_convert_field(stmt, application\candidate, application\candidate_count, to_ft, mi, ind, dest)

# C99 object-pointer compatibility follows the immediate pointed-to type.
# Base qualification is immediate only at depth one: void* can hold char**,
# but void** is not generic and char** does not acquire const char** implicitly.
fn: l2_pointer_compatible (int: target; int: value) int
    LmP0Text: target_word
    LmP0Text: value_word
    int: target_depth
    int: value_depth
    int: target_const
    int: value_const
    int: target_immediate
    int: value_immediate
    if: l2_type_parts(target, @ target_word, @ target_depth, @ target_const) != 0 || l2_type_parts(value, @ value_word, @ value_depth, @ value_const) != 0 || target_depth < 1 || value_depth < 1
        return: 0
    target_immediate: target_const != 0 && target_depth = 1
    value_immediate: value_const != 0 && value_depth = 1
    if: value_immediate != 0 && target_immediate = 0
        return: 0
    if: (target_depth = 1 && l2_text_eq(@ target_word, "void")) || (value_depth = 1 && l2_text_eq(@ value_word, "void"))
        return: 1
    if: target_depth != value_depth || l2_text_same(@ target_word, @ value_word) = 0
        return: 0
    if: target_const = value_const || target_depth = 1
        return: 1
return: 0

# Named primitive value codes are l2_primitive_leaf_implements. The lists
# below are the literal class (-10), a quoted pointer (-11), an opaque raw C
# result (-12), and a code that is not one of those names. The C result's
# machine compatibility is deferred to its receiving C type; a Structure
# requirement still has its separate referent admission.
# Two different names are a store only when convert.lm2 has that row.
fn: l2_colon_types_compatible (int: target_ty; int: value_ty) int
    const: @(char cn)
    const: @(char rn)
    @: LmP0Text cand 0
    @: LmP0Text req 0
    int: result 0
    int: status 0
    int: target_numeric 0
    int: value_numeric 0
    target_ty: l2_formal_raw(target_ty)
    value_ty: l2_formal_raw(value_ty)
    l2_cv_gap: 0
    l2_cv_used: 0
    if: value_ty = -12
        return: 1
    # C99 string literals provide a char-array address. Project that source
    # class before applying the same pointer compatibility as a named value.
    if: value_ty = -11
        value_ty: 12
    cn: l2_prim_code_name(value_ty)
    rn: l2_prim_code_name(target_ty)
    if: cn != 0 && rn != 0
        cand: (cast: (@: LmP0Text) l2_xmalloc(c.sizeof(c.LmP0Text)))
        req: (cast: (@: LmP0Text) l2_xmalloc(c.sizeof(c.LmP0Text)))
        if: cand = 0 || req = 0
            if: cand != 0
                l2_xfree((cast: (@: void) cand))
            if: req != 0
                l2_xfree((cast: (@: void) req))
            return: 0
        cand\data: cn
        cand\length: strlen(cn)
        req\data: rn
        req\length: strlen(rn)
        status: l2_primitive_leaf_implements(cand, req, @ result)
        l2_xfree((cast: (@: void) cand))
        l2_xfree((cast: (@: void) req))
        if: status = 0 && c.strcmp(cn, rn) = 0
            return: result
        if: status = 0 && result = 0
            return: 0
        if: status = 0 && l2_convert_hit(cn, rn) = 0
            return: 0
        if: status = 0
            l2_cv_used: 1
            return: 1
        if: status = 1
            return: 0
        ---
    if: target_ty = 0 || target_ty = 1 || target_ty = 2 || target_ty = 34 || target_ty = 36
        target_numeric: 1
    if: value_ty = -10 || value_ty = 0 || value_ty = 1 || value_ty = 2 || value_ty = 34 || value_ty = 36
        value_numeric: 1
    if: target_numeric != 0 && value_numeric != 0
        return: 1
    if: target_ty = value_ty
        return: 1
return: l2_pointer_compatible(target_ty, value_ty)

# The general expression checker still owns compound expressions.  For the
# single-value form that decides the contextual colon role, both sides already
# have translation-time types, so refuse an incompatible pair here rather than
# emitting invalid C and pretending that the assignment was typed.
fn: l2_check_receiving_value (const: @(LmP0Node stmt); @: LmP0Field first; int: n; int: target_ty; int: receiving_model; const: @(LmP0Text receiving_name); int: mi; const: @(char path)) int
    int: wk
    []: char lpd_own 1024
    @: char lpd 0
    size_t: lpn 0U
    int: lkind 0
    int: lelem 0
    int: ldepth 0
    size_t: li0 0U
    @: LmP0Field only
    int: value_ty
    int: cok 0
    int: composite 0
    int: candidate_model
    int: actual_status
    int: receiving_own -1
    L2ReferenceSource: reference_source
    int: zero_neg
    int: zero_unsigned
    size_t: zero_magnitude
    L2Address: descriptor_value
    @: L2Address descriptor @ descriptor_value
    only: l2_next_active(first)
    if: n = 1 && only != 0 && only\value != 0 && only\value\kind = c.LM_P0_NODE_STRUCTURE && only\value\as != 0 && only\value\as\structure != 0
        return: l2_check_receiving_value(stmt, only\value\as\structure\first_field, l2_count_active(only\value\as\structure), target_ty, receiving_model, receiving_name, mi, path)
    if: n < 1
        return: l2_error(path, stmt, "assignment value has unknown type")
    if: l2_pointer_depth(target_ty) > 0 && l2_reference_descriptor(first, n, mi, descriptor) = 0
        value_ty: descriptor\type
    else:
        if: n = 1
            # K03 S4: a word of the language received as a value -- the bare word or its Frame -- meets the word's value
            # contract first, said at the word (l2_check_word_value); an operator with operands goes on to be typed.
            if: only != 0 && only\value != 0 && l2_stmt_word_head(only\value, mi) != 0
                wk: l2_check_word_value(only\value, l2_stmt_word_head(only\value, mi), mi, path)
                if: wk != 2
                    return: wk
                ---
            # K03 S4: a named Structure (the resolution's kind 5): its name is a reference, which a number place refuses;
            # its application runs its body and gives no value.
            if: only != 0 && only\value != 0 && l2_app_head(only\value) != 0 && l2_head_resolve(mi, l2_app_head(only\value), 0, 0) = 5
                if: only\value\kind = c.LM_P0_NODE_FRAME
                    return: l2_error(path, only\value, "a callable without a result has no value")
                if: l2_prim_code_name(target_ty) != 0
                    return: l2_error(path, only\value, "a reference where a number is asked")
                ---
            if: only != 0 && l2_prefix_kind_refused(only\value, mi, path) != 0
                return: 1
            # A number place: the bare name of a held callable is received as its result.
            if: l2_held_result_receive(mi, first, n, (cast: (int) (l2_prim_code_name(target_ty) != 0)), path) != 0
                return: 1
            if: only = 0 || l2_colon_value_ty(only\value, mi, @ value_ty) != 0
                return: l2_error(path, stmt, "assignment value has unknown type")
        ---
    ---
    if: n > 1
        composite: 1
        if: l2_held_result_receive(mi, first, n, 0, path) != 0
            return: 1
        if: l2_prim_code_name(target_ty) != 0 && l2_check_numeric_span_kind(first, n, mi, path) != 0
            return: 1
        value_ty: l2_native_composite_ty(first, n, mi)
        if: value_ty = 0 - 3
            return: l2_error(path, stmt, "mixed numeric types (a conversion)")
        if: value_ty = 0 - 1
            # Deferred machine typing does not remove the receiving model's
            # language-level admission obligation.
            if: receiving_model >= 0
                return: l2_admit_site(mi)
            return: 0
    ---
    if: composite = 0 && only\value != 0 && only\value\kind = c.LM_P0_NODE_FRAME && only\value\as != 0 && only\value\as\frame != 0 && l2_text_eq(only\value\as\frame\head, "sizeof")
        if: l2_check_sizeof(only\value, mi, path) != 0
            return: 1
    ---
    if: composite = 0 && only\value != 0 && only\value\kind = c.LM_P0_NODE_FRAME && only\value\as != 0 && only\value\as\frame != 0 && l2_text_eq(only\value\as\frame\head, "length")
        if: l2_array_length_own(only\value, mi) < 0 && l2_arr_len_shape(only\value, lpd_own, 1024U, @ lpd, @ lpn, @ lkind, @ lelem, @ ldepth, @ li0) != 0
            return: l2_error(path, only\value, "length requires one known primitive own array")
    ---
    # FABLE-SONNET-DIAG-AND-INDEX-20260924-163 commit 1 (D-40): a call whose
    # callee has no result (value_ty = 8, l2_colon_simple_ty's own void code,
    # the same one a real sub or a void-returning predef gives) refuses with
    # the ONE existing "no result" text everywhere this shape is caught, not
    # the generic incompatible-type message -- matching l2_check_value_call
    # (the bare-atom case) and l2_check_call's own argument-position check.
    if: value_ty = 8
        return: l2_error(path, stmt, "a callable without a result has no value")
    cok: l2_colon_types_compatible(target_ty, value_ty)
    # A parsed zero integer literal is a C99 null pointer constant, not a
    # conversion of an arbitrary numeric value. General constant-expression
    # folding and the remaining C99 literal forms are separate common debt.
    if: cok = 0 && value_ty = -10 && composite = 0 && l2_pointer_depth(target_ty) > 0 && only\value != 0 && only\value\kind = c.LM_P0_NODE_ATOM
        if: l2_rw_num_lit(only\value\as\atom, @ zero_neg, @ zero_magnitude, @ zero_unsigned) != 0 && zero_magnitude = 0U
            cok: 1
        ---
    if: cok = 0 && l2_cv_gap = 3
        return: l2_cv_refused(path, stmt, "internal: a conversion refused without its reason")
    if: cok = 0 && l2_cv_gap = 5
        return: l2_error(path, stmt, "the program has no source table `primitive.convert`")
    if: cok = 0 && l2_cv_gap = 2
        return: l2_convert_norecv(path, stmt)
    if: cok = 0 && l2_cv_gap = 1
        return: l2_error(path, stmt, "mixed numeric types (a conversion)")
    if: cok = 0
        return: l2_error(path, stmt, "assignment value has incompatible type")
    # A converter is a receiver (Q33): the edge is a call of it, so a refusing
    # receiver puts this method on the throw channel (l2_throws_close).
    if: l2_cv_used != 0 && l2_convert_edge(mi, path, stmt) != 0
        return: 1
    if: composite = 0 && only\value != 0 && only\value\kind = c.LM_P0_NODE_ATOM && l2_check_literal_kind(only\value\as\atom, l2_lit_kind_from_ft(target_ty), path, stmt) != 0
        return: 1
    # Admission belongs to the receiving model, independently of the source's
    # machine pointer spelling. A void* conversion cannot erase this obligation.
    if: receiving_model >= 0
        l2_reference_source(first, n, mi, @ reference_source)
        # Physical receivers need the same source-to-target table even when
        # the destination is a resolved place rather than a lexical own row.
        if: l2_d105_prepare(receiving_model, @ reference_source, stmt) != 0
            return: 1
        if: receiving_name != 0
            receiving_own: l2_own_find_decl(mi, receiving_name, stmt)
            if: receiving_own < 0 && stmt != 0 && stmt\kind = c.LM_P0_NODE_FRAME && stmt\as != 0 && stmt\as\frame != 0 && l2_text_same(stmt\as\frame\head, receiving_name) != 0
                receiving_own: l2_resolved_own(mi, receiving_name)
            ---
        if: receiving_own >= 0 && l2_d105_note(mi, l2_own_mi[receiving_own], l2_d105_own_key(receiving_own), first, n, stmt) != 0
            return: 1
        if: l2_colon_is_graph_ty(value_ty) != 0
            actual_status: l2_actual_ns(mi, first, n, path, stmt, @ candidate_model)
            if: actual_status = 1
                return: 1
            if: actual_status = 0 && reference_source.method < 0 && l2_admit_consumer_ix(candidate_model, receiving_model, receiving_name, l2_fn_frame(mi), path, stmt, "assignment") != 0
                return: 1
            ---
        return: l2_admit_site(mi)
    # RECEPTION-EDGE-DEBTS (d): an opaque reference place holds what was given to it, as an opaque formal and an
    # opaque result do (l2_d105_note_return): the sources of the value given are the place's.
    if: receiving_name != 0 && l2_pointer_depth(target_ty) = 1
        receiving_own: l2_own_find_decl(mi, receiving_name, stmt)
        if: receiving_own < 0 && stmt != 0 && stmt\kind = c.LM_P0_NODE_FRAME && stmt\as != 0 && stmt\as\frame != 0 && l2_text_same(stmt\as\frame\head, receiving_name) != 0
            receiving_own: l2_resolved_own(mi, receiving_name)
        ---
        if: receiving_own >= 0 && l2_d105_note(mi, l2_own_mi[receiving_own], l2_d105_own_key(receiving_own), first, n, stmt) != 0
            return: 1
    ---
return: 0

# Resolution chooses the target act; the receiving-value contract is shared
# with an explicit declaration initializer.
fn: l2_colon_check_assignment (const: @(LmP0Node stmt); int: mi; const: @(char path)) int
    int: n
    int: target_ty
    if: l2_is_asgn(stmt, mi) = 0 || stmt = 0 || stmt\as = 0 || stmt\as\frame = 0 || stmt\as\frame\head = 0 || stmt\as\frame\body = 0
        return: 0
    n: l2_count_active(stmt\as\frame\body)
    if: n < 1
        return: 0
    if: l2_waits(stmt\as\frame\body\first_field, n, mi) != 0 || l2_wait_name(mi, stmt\as\frame\head) != 0
        return: l2_wait_add(1, mi, (cast: (@: void) stmt), n, 0, stmt, path)
    if: l2_colon_bound_ty(mi, stmt\as\frame\head, @ target_ty) != 0
        return: 0
    # A head holding a constructed named Structure (an own slot) is that Structure: `v: w` is its call, and an ordinary
    # named Structure has no arguments (Q59) -- the arity refusal.  So is a head the reference binding `b: A` bound to a
    # Structure (K03 NS-ROLES-1, l2_rb_find; docs/LMX_semantics.en.md:666, :835, L2_spec_en.md:206: `b: args` applies the
    # bound Structure, it is not a rebinding).  A formal is not: a nonprimitive formal is a reference binding whichever
    # way its signature spells it, and `v: w` is its rebinding (l2_check_receiving_value; the admission at emission).
    if: l2_colon_is_graph_ty(target_ty) != 0 && l2_formal_find(mi, stmt\as\frame\head) < 0 && l2_own_visible(mi, stmt\as\frame\head) >= 0 && (l2_own_is_slot(l2_own_visible(mi, stmt\as\frame\head)) != 0 || (l2_rb_find(l2_own_decl[l2_own_visible(mi, stmt\as\frame\head)]) != 0 && l2_rb_meth_of(l2_own_decl[l2_own_visible(mi, stmt\as\frame\head)]) < 0))
        return: l2_struct_arity_error(path, stmt, stmt\as\frame\head)
return: l2_check_receiving_value(stmt, stmt\as\frame\body\first_field, n, target_ty, l2_graph_nsty(mi, stmt\as\frame\head), stmt\as\frame\head, mi, path)

# A receiving expression borrows its original fields. Parentheses are the
# ordinary transparent one-value Structure, not a second initializer language.
fn: l2_reference_fields (@@: LmP0Field first; @: int n) int
    @: LmP0Field f l2_next_active(\first)
    while: \n = 1 && f != 0 && f\value != 0 && f\value\kind = c.LM_P0_NODE_STRUCTURE && f\value\as != 0 && f\value\as\structure != 0
        \n: l2_count_active(f\value\as\structure)
        f: l2_next_active(f\value\as\structure\first_field)
    ---
    \first: f
return: 0

# In a reference-receiving position an existing Structure denotes its physical
# descriptor. Reuse the resolved binding category used by address acquisition;
# an explicit pointer cell is not a descriptor and is read as an ordinary value.
fn: l2_reference_descriptor (@: LmP0Field first; int: n; int: mi; @: L2Address out) int
    @: LmP0Text name 0
    l2_reference_fields(@ first, @ n)
    if: n != 1 || first = 0 || first\value = 0 || first\value\as = 0
        return: 1
    if: first\value\kind = c.LM_P0_NODE_ATOM
        name: first\value\as\atom
    if: l2_empty_call_shape(first\value) != 0
        name: first\value\as\frame\head
    if: name = 0 || l2_address_name(mi, name, out) != 0 || out\descriptor = 0 || l2_colon_is_graph_ty(out\type) = 0
        return: 1
    # Callable formals retain their existing result-receiving call route. Their
    # transport descriptor alone does not select occurrence-as-value here.
    if: out\kind = 2 && l2_cf_get(mi, out\index) >= 0
        return: 1
return: 0

# D105 source places share the existing own-row identity. -1 is still the
# return place; the helpers are the only encoding of an own-row key.
fn: l2_d105_own_key (int: own) int
return: -2 - own

fn: l2_d105_key_own (int: key) int
    if: key > -2
        return: -1
return: -2 - key

fn: l2_d105_key_method (int: mi; int: key) int
    int: own l2_d105_key_own(key)
    if: own >= 0 && own < l2_own_n
        return: l2_own_mi[own]
return: mi

# A locally constructed named Structure has its own declared physical layout.
# Direct slot storage alone proves nothing about a received/caught descriptor.
fn: l2_own_layout (int: own) int
    int: model
    int: row
    if: own < 0 || own >= l2_own_n
        return: -1
    model: l2_own_nsty_get(own)
    if: model >= 0 && l2_ns_local[model] >= 0 && l2_own_of_local_ns(l2_own_mi[own], model) = own
        return: model
    row: l2_ns_constructed_row(l2_own_mi[own], l2_own_decl[own])
    if: row >= 0 && l2_nsf_kind[row] = 2 && l2_nsf_ref[row] = model && l2_nsf_fname[row] = l2_own_name[own]
        return: model
return: -1

# The existing constructed-body producer selects call metadata, never a
# prototype occurrence. Copy/reception sources require a current-value proof
# at the source site; immutable constructor evidence alone cannot select them.
fn: l2_own_call_origin (int: own) int
    int: origin l2_own_layout(own)
    if: origin < 0
        origin: l2_own_copy_origin(own)
    # K03 NS-ROLES-1b: a binding `b: A` to a named Structure itself holds exactly A (no rebinding form yet): its
    # execution is A's.  A binding to a value of a named model holds what that value holds, which may be a Structure
    # admitted by name -- executed as a Structure formal's would be, not yet.
    if: origin < 0 && own >= 0 && own < l2_own_n && l2_own_decl[own] != 0 && l2_rb_meth_of(l2_own_decl[own]) = -2
        origin: l2_own_nsty_get(own)
    if: origin < 0 || origin >= l2_ns_n || l2_ns_proc[origin] < 0
        return: -1
return: origin

# The named Structure whose whole copy own row `own` holds by its one
# declaration: `own: merge S` with exactly S and no body. For such a merge
# the kernel returns the copier's completed occurrence -- S's body, its
# nested occurrences and its native word (lmx_merge_profiles_owned). -1 for
# any other row. This is a fact about the declaration, not yet about the
# value a later call finds there.
fn: l2_own_copy_layout (int: own) int
    int: result l2_mres_of_own(own)
    @: L2ReferenceSource source
    if: result < 0 || l2_mres_source = 0
        return: -1
    source: @ l2_mres_source[result]
    if: source\layout < 0 || source\layout >= l2_ns_n || l2_ns_eternal[source\layout] >= 0
        return: -1
return: source\layout

# The named Structure type a nested method captures a host's own field as: the
# field's declared type, or for a whole copy `x: merge S` the Structure S whose
# completed occurrence the copy is -- the same fields at the same slots.
fn: l2_own_capture_ns (int: own) int
    int: ns
    if: own < 0
        return: -1
    ns: l2_own_nsty_get(own)
    if: ns < 0
        ns: l2_own_copy_layout(own)
return: ns

# The named Structure whose completed occurrence own row `own` holds, proved
# through declarations alone: a whole copy of a named Structure
# (l2_own_copy_layout); a whole copy of a row of the same body that is proved
# in turn (l2_mres_from); the definition row of a method's own named Structure
# (l2_own_layout). -1 otherwise. For a merge of one operand without a body
# the kernel returns the copier's completed occurrence, so each link holds
# what its operand held when the merge ran. That no row of the chain was
# replaced before then is l2_copy_calls_verify's part.
fn: l2_own_copy_chain (int: own) int
    int: hops 0
    int: result
    int: layout
    int: mi
    if: own < 0 || own >= l2_own_n
        return: -1
    mi: l2_own_mi[own]
    while: own >= 0 && own < l2_own_n && hops <= l2_mres_n
        if: l2_own_mi[own] != mi
            return: -1
        result: l2_mres_of_own(own)
        if: result < 0
            return: l2_own_layout(own)
        layout: l2_own_copy_layout(own)
        if: layout >= 0
            return: layout
        if: l2_mres_from = 0
            return: -1
        own: l2_mres_from[result]
        hops: hops + 1
    ---
return: -1

# The copied Structure whose procedure contract a call of own row `own`
# uses: one proved alternative. The row is a slot filled by its one merge
# declaration and declared in the body that lexically owns the copied
# Structure, so the copy's lexical parent is that prototype's parent. No
# statement form stores another Structure into such a row; an address of the
# row, the one way a store could reach its cell, is refused once every body
# has been read (l2_copy_calls_verify). The call itself dispatches the value
# the row holds, never the prototype.
fn: l2_own_copy_origin (int: own) int
    int: layout l2_own_copy_chain(own)
    int: owner
    if: layout < 0 || l2_own_is_slot(own) = 0 || l2_ns_parent[layout] >= 0
        return: -1
    owner: l2_ns_local[layout]
    if: owner < 0
        owner: l2_e
    if: l2_own_mi[own] != owner
        return: -1
return: layout

# A constructor contributes a possible source to its existing own-row key.
# This is compile-time reachability, NOT evidence about a later held value:
# receiveMessage may replace that same row. Actual evidence is recorded only
# on the fresh value at construction. Candidate bindings/reception/catch are
# not constructors, and copied values are not new type declarations.
fn: l2_own_source_layout (int: own) int
    int: model l2_own_layout(own)
    int: result l2_mres_of_own(own)
    if: result >= 0
        return: l2_schema_merge(result)
return: model

fn: l2_reference_source (@: LmP0Field first; int: n; int: mi; @: L2ReferenceSource out) int
    L2Address: value
    @: L2Address address @ value
    int: resolved 1
    int: callee
    @: LmP0Frame cast_frame
    @: LmP0Field type_field
    @: LmP0Field operand_field
    int: operand_count
    int: cast_type
    int: operand_type
    int: pointer_operand 0
    L2ValueSpan: operand
    out\schema: -1
    out\layout: -1
    out\method: -1
    out\place: -1
    l2_reference_fields(@ first, @ n)
    if: n < 1 || first = 0 || first\value = 0 || first\value\as = 0
        return: 0
    # Pointer casts preserve the operand's possible physical sources, never
    # replace them by the cast target. Check its immediate contract: an integer cast
    # or arithmetic cannot acquire provenance merely by casting back.
    if: n = 1 && l2_frame_head(first\value, "cast") != 0
        cast_frame: first\value\as\frame
        operand_count: l2_count_active(cast_frame\body) - 1
        if: operand_count < 1
            return: 0
        type_field: l2_next_active(cast_frame\body\first_field)
        operand_field: l2_next_active(type_field\next)
        if: l2_cast_resolve(type_field\value, @ cast_type, 0) != 0 || l2_pointer_depth(cast_type) = 0
            return: 0
        l2_reference_fields(@ operand_field, @ operand_count)
        if: operand_count < 1 || l2_operand_run(operand_field, operand_count) != operand_count
            return: 0
        if: l2_reference_descriptor(operand_field, operand_count, mi, address) = 0
            pointer_operand: 1
        if: pointer_operand = 0 && operand_count = 1 && l2_colon_value_ty(operand_field\value, mi, @ operand_type) = 0 && l2_pointer_depth(operand_type) > 0
            pointer_operand: 1
        if: pointer_operand = 0 && operand_count > 1
            operand.first: operand_field
            operand.count: operand_count
            operand.node: operand_field\value
            operand_type: l2_native_span_ty(@ operand, mi)
            pointer_operand: (cast: (int) (operand_type = -5 || l2_pointer_depth(operand_type) > 0))
        ---
        if: pointer_operand != 0
            l2_reference_source(operand_field, operand_count, mi, out)
        return: 0
    ---
    resolved: l2_reference_descriptor(first, n, mi, address)
    if: resolved != 0 && l2_address_operand(first, n, mi, address) = 0 && address\descriptor != 0
        resolved: 0
    if: resolved != 0 && n = 1 && first\value\kind = c.LM_P0_NODE_ATOM
        resolved: l2_address_name(mi, first\value\as\atom, address)
    if: resolved = 0 && address\kind = 2
        address\model: l2_input_model(mi, address\index)
    if: resolved = 0 && (address\kind = 1 || address\kind = 2)
        if: address\kind = 1
            out\schema: l2_own_schema(address\index)
            out\method: l2_own_mi[address\index]
            out\place: l2_d105_own_key(address\index)
        else:
            out\schema: l2_input_schema(mi, address\index)
            out\method: mi
            out\place: address\index
        ---
        return: 0
    if: resolved = 0 && address\model >= 0
        out\schema: address\model
        if: address\kind = 5
            out\layout: address\model
        if: address\kind = 1
            out\method: l2_own_mi[address\index]
            out\place: l2_d105_own_key(address\index)
        if: address\kind = 2
            out\method: mi
            out\place: address\index
        return: 0
    ---
    # A field path that ends at a Structure field: the value is the Structure that field
    # declares, which is also what the field physically holds. A path is not a place a call
    # site fills, so it has no alternatives.
    if: n >= 3 && l2_reference_path_leaf(first, n, mi) >= 0
        out\schema: l2_reference_path_leaf(first, n, mi)
        out\layout: out\schema
        return: 0
    callee: l2_d105_callee(mi, first, n)
    if: callee >= 0
        out\schema: l2_input_model(callee, -1)
        out\method: callee
        out\place: -1
return: 0

# The declared Structure of the field a path span ends at, read where mi stands, or -1.
fn: l2_reference_path_leaf (@: LmP0Field first; int: n; int: mi) int
    @: char text l2_address_path_text(first, n)
    int: saved l2_cur_mi
    int: leaf
    if: text = 0
        return: -1
    l2_cur_mi: mi
    leaf: l2_path_struct_leaf(text, strlen(text))
    l2_cur_mi: saved
    l2_xfree(text)
return: leaf

fn: l2_check_reference_init (const: @(LmP0Node stmt); int: mi; const: @(char path)) int
    @: L2Declaration declaration l2_declaration(stmt)
    @: LmP0Field first
    int: n
    int: ty
    L2Address: descriptor_value
    @: L2Address descriptor @ descriptor_value
    if: declaration = 0 || declaration\candidate_count = 0
        return: 0
    if: l2_contract_formal(declaration\contract, @ ty) != 0
        return: l2_error(path, stmt, "unknown type")
    first: declaration\candidate
    n: declaration\candidate_count
    l2_reference_fields(@ first, @ n)
    if: n < 1
        return: 1
    if: l2_check_one_value(first, n, path) != 0
        return: 1
    if: l2_reference_descriptor(first, n, mi, descriptor) != 0 && l2_check_fields(first, n, mi, path, stmt) != 0
        return: 1
return: l2_check_receiving_value(stmt, first, n, ty, l2_declaration_model(stmt, 0), declaration\name, mi, path)

# `f()`, `f: ()` and the closed empty vertical, name absent (FABLE-SONNET-
# EMPTY-STRUCT-20260923-132, book SS10/SS12, after -127's P0 parity all
# three spellings are the identical Frame -- head plus a body with 0
# active fields). When that head resolves to nothing at all -- not a
# formal, own field, slot, merge result or model/type name -- the empty
# Structure-body itself supplies the structural type: this is a
# declaration, not a failed call.  It needs mi to resolve the head.
#
# "Resolves to nothing" has to mean the same thing on BOTH calls this gets
# (l2_check_body's admission, then l2_emit_body's construction): once the
# first call has run l2_own_add for this exact statement, l2_own_find(mi,
# fr\head) finds THAT row on the second call, and a plain oi>=0 exclusion
# would make the shape stop matching its own declaration the moment
# emission looks for it -- measured: l2_emit_body never reached its
# construction branch, and l2_translate's own no-located-diagnostic
# safety net (the (c) fix, a few lines up) fired instead, since nothing
# had called l2_error. An existing row is only a genuine conflict when
# some OTHER statement declared it.
# `t()`, `t: ()` or the closed empty vertical -- one P0 Frame (-127): a name that is no call's head (l2_is_asgn), a
# body with no field, no trailer.  Whether it declares t or calls t is resolution's: l2_empty_struct_decl_shape,
# l2_empty_struct_assign_shape.
fn: l2_empty_call_shape (const: @(LmP0Node v)) int
    if: l2_is_asgn(v, 0 - 1) = 0
        return: 0
    if: v\as\frame\trailer != 0 || v\as\frame\body\trailer != 0 || l2_count_active(v\as\frame\body) != 0
        return: 0
return: 1

# `f()` -- one P0 tree with `f: ()` and the closed empty vertical (l2_empty_call_shape) -- when f already binds a
# Structure: f's nullary call, as the bare atom f is (book §9 after 55c1abc: a callable, an ordinary named Structure
# included, is called, never assigned; l2_check_struct_call): 1 an own field of graph type, of a declared Structure
# type or of none; 2 a declared named Structure, a unit child.  0 otherwise: absent (the -132 declaration below), a
# callable head (a call, -130; l2_is_asgn), or a binding that holds no Structure.
fn: l2_empty_struct_assign_shape (const: @(LmP0Node stmt); int: mi) int
    @: LmP0Frame fr
    int: oi
    int: ni
    if: l2_empty_call_shape(stmt) = 0
        return: 0
    fr: stmt\as\frame
    if: l2_param_find(mi, fr\head) >= 0 || l2_slot_find(mi, fr\head) >= 0 || l2_ml_find(fr\head) >= 0
        return: 0
    # A held callable of the site is a callable head: the statement is its call with no
    # actuals, checked against its header as any call of it is.
    if: l2_call_head_held(mi, fr\head) >= 0
        return: 0
    # K03 NS-ROLES-1b: so is a binding `b: tick` -- `b()` is tick's call on the occurrence b holds.
    if: l2_call_alias_own(mi, fr\head) >= 0
        return: 0
    oi: l2_own_find(mi, fr\head)
    if: oi >= 0 && l2_own_decl[oi] != stmt
        return: l2_colon_is_graph_ty(l2_ft_of_own(l2_own_ty[oi]))
    if: oi >= 0
        return: 0
    ni: l2_ns_find(fr\head)
    if: ni >= 0 && l2_ns_parent[ni] < 0 && l2_ns_eternal[ni] < 0
        return: 2
return: 0

# K03 S5: the method that lexically holds procedure mi, the procedure of a method's own named Structure
# (l2_local_ns_entry), or -1: that procedure's body is read in the method's lexical context.
fn: l2_ns_host_of (int: mi) int
    int: ni l2_m_nsof(mi)
    if: ni < 0
        return: 0 - 1
return: l2_ns_local[ni]

fn: l2_empty_struct_decl_shape (const: @(LmP0Node stmt); int: mi) int
    @: LmP0Frame fr
    int: existing
    if: l2_is_asgn(stmt, mi) = 0
        return: 0
    fr: stmt\as\frame
    if: fr\body = 0 || fr\trailer != 0 || fr\body\trailer != 0 || l2_count_active(fr\body) != 0
        return: 0
    existing: l2_own_find(mi, fr\head)
    if: existing >= 0 && l2_own_decl[existing] != stmt
        return: 0
    if: l2_param_find(mi, fr\head) >= 0 || l2_slot_find(mi, fr\head) >= 0 || l2_ml_find(fr\head) >= 0 || l2_colon_model(fr\head) != 0
        return: 0
    # K03: a word of the language is never a head that resolves to nothing: `merge()` is merge's application.  Read
    # from the word alone, as the rest of this shape is read: the row the statement would declare does not count.
    if: l2_head_word(fr\head) != 0
        return: 0
    # K03 S5: in the procedure of a method's own named Structure, a name that method sees (the one resolution at its
    # site) is no head that resolves to nothing either: a known name never becomes a new definition.
    if: l2_ns_host_of(mi) >= 0 && l2_head_resolve(l2_ns_host_of(mi), fr\head, 0, 0) != 0
        return: 0
return: 1

# Whether own field oi is typed by its own declaration: `f()`, `f: ()` or the closed empty vertical -- one P0 Frame,
# the name with an empty Structure body (l2_empty_struct_decl_shape) -- declared it, so its declared type is that
# empty Structure (book §9 :561-:563: the Structure on the right gives the new variable its type), whose call runs
# nothing (l2_struct_call_inert).  Read from the declaration itself, not from the state of resolution: only that
# declaration registers an own field at a Frame of the field's own name with no body field.
fn: l2_own_self_typed (int: oi) int
    @: LmP0Node d
    if: oi < 0 || oi >= l2_own_n
        return: 0
    d: l2_own_decl[oi]
    if: d = 0 || d\kind != c.LM_P0_NODE_FRAME || d\as = 0 || d\as\frame = 0 || d\as\frame\head = 0 || d\as\frame\body = 0
        return: 0
    if: d\as\frame\trailer != 0 || d\as\frame\body\trailer != 0 || l2_count_active(d\as\frame\body) != 0
        return: 0
return: (cast: (int) (l2_text_same(d\as\frame\head, l2_own_name[oi]) != 0))

# The kind a field declaration of a Structure literal gives its field, in l2_take_ns_body's codes for the number
# leaves -- size_t 0, char 1, int 7, unsigned 8, ulong 9 -- or -1 for any other declaration.
fn: l2_lit_field_kind (const: @(LmP0Node fld)) int
    if: l2_frame_head(fld, "size_t")
        return: 0
    if: l2_frame_head(fld, "char")
        return: 1
    if: l2_frame_head(fld, "int")
        return: 7
    if: l2_frame_head(fld, "unsigned")
        return: 8
    if: l2_frame_head(fld, "ulong")
        return: 9
return: 0 - 1

# K03 RECEIVE-OUTPUT: whether fld declares a number or a char with a computed candidate -- written after the name and
# not a literal: `int: i getValue()`, `int: i x`, `int: i 2 + 3`.  q53.md:95-97: such a declaration is analogous to a
# receiver's output, not to `int: i 5` -- not data, never a public field of its Structure; #dynamic: its computed
# initialization runs when control reaches it.  A literal candidate (a number or a quoted character, of whatever kind)
# keeps the data declaration it was, and so does `int: i` followed by `i: getValue()`.
fn: l2_ns_computed_decl (const: @(LmP0Node fld)) int
    @: LmP0Field g
    size_t: bits 0U
    if: fld = 0 || l2_lit_field_kind(fld) < 0 || fld\as\frame\body = 0 || l2_count_active(fld\as\frame\body) < 2
        return: 0
    g: l2_next_active(fld\as\frame\body\first_field)
    if: g = 0 || g\value = 0 || g\value\kind != c.LM_P0_NODE_ATOM || l2_bind_spelling(g\value\as\atom) = 0
        return: 0
    if: l2_count_active(fld\as\frame\body) > 2
        return: 1
    g: l2_next_active(g\next)
    if: g = 0 || g\value = 0
        return: 0
    if: g\value\kind != c.LM_P0_NODE_ATOM
        return: 1
    if: l2_num(g\value\as\atom) != 0 || l2_int_literal_bits(g\value\as\atom, @ bits) != 0 || l2_char_literal(g\value\as\atom) >= 0
        return: 0
return: 1

# Whether named Structure ni is the empty Structure -- its declaration's body holds no field and no statement, and no
# `until` loop closes it: `E()`, `E: ()` -- whose call runs nothing.
fn: l2_ns_empty (int: ni) int
    @: LmP0Node at
    if: ni < 0 || ni >= l2_ns_n
        return: 0
    at: l2_ns_at[ni]
    if: at = 0 || at\kind != c.LM_P0_NODE_FRAME || at\as = 0 || at\as\frame = 0
        return: 0
    if: at\as\frame\trailer != 0 && at\as\frame\trailer\spelling != 0 && l2_text_eq(at\as\frame\trailer\spelling, "until") != 0
        return: 0
return: (cast: (int) (at\as\frame\body = 0 || l2_count_active(at\as\frame\body) = 0))

# The nullary call of the Structure bound to t that runs nothing: an own field -- no formal, slot or local -- whose
# type is the empty Structure, declared by `f()` itself (l2_own_self_typed) or of an empty named Structure
# (l2_ns_empty).  (A named Structure's own name and the root's field `Model: v` are executed: l2_ns_exec_any.)
fn: l2_struct_call_inert (const: @(LmP0Text t); int: mi) int
    int: oi
    int: ni
    if: t = 0 || mi < 0 || l2_param_find(mi, t) >= 0 || l2_slot_find(mi, t) >= 0 || l2_ml_find(t) >= 0
        return: 0
    oi: l2_own_visible(mi, t)
    if: oi < 0 || l2_colon_is_graph_ty(l2_ft_of_own(l2_own_ty[oi])) = 0
        return: 0
    ni: l2_own_nsty_get(oi)
    # The whole copy of an empty named Structure runs nothing either.
    if: ni < 0 && l2_own_copy_layout(oi) >= 0
        return: l2_ns_empty(l2_own_copy_layout(oi))
    if: ni < 0
        return: l2_own_self_typed(oi)
return: l2_ns_empty(ni)

# A written atom tail (`A: b`, a literal) is the same absent-head definition the unit retains.
# It is not a typed-field constructor. Calls and receiver words stay out (l2_retained_atom).
fn: l2_atom_only_tail (const: @(LmP0Frame fr)) int
    @: LmP0Field f
    int: n
    if: fr = 0 || fr\body = 0
        return: 0
    n: l2_count_active(fr\body)
    if: n < 1
        return: 0
    f: l2_next_active(fr\body\first_field)
    while: n > 0 && f != 0
        if: l2_discard_run(f) != 1 || f\value = 0 || l2_retained_atom(f\value) = 0
            return: 0
        n: n - 1
        f: l2_next_active(f\next)
    ---
return: (cast: (int) (n = 0))

# One expression span and nothing after it (`A: (2 + 2)`, `A: 2 + 2`). Parentheses are
# transparent: the span is the operator and its operands, not a typed-field constructor.
fn: l2_expr_only_tail (const: @(LmP0Frame fr)) int
    @: LmP0Field f
    int: span
    if: fr = 0 || fr\body = 0
        return: 0
    if: l2_count_active(fr\body) < 1
        return: 0
    f: l2_next_active(fr\body\first_field)
    if: f = 0
        return: 0
    span: l2_discard_run(f)
    if: span < 2
        return: 0
return: (cast: (int) (l2_skip_span(f, span) = 0))

# Does method mi read name h as a free name before statement stop, as the scan of its free names reads it
# (l2_scan_body)?  Such a read is an executable free read before the first write: it uses h as an input of mi,
# and stop then assigns that input (the author, 2026-10-05; LMX_blog/q/head-role-hidden-input-fixed-point.md:
# «Исполняемое свободное чтение имени до первой записи — самостоятельный факт использования входа»).  The scan
# runs as a probe from mi's own environment, as l2_own_lexical reads it: it makes no row, mark, capture or
# input, and it ends at stop.  A read in stop's own tail or after it is not before it; a statement the scan
# does not reach has nothing read before it.
fn: l2_head_read_before (int: mi; const: @(LmP0Text h); const: @(LmP0Node stop)) int
    L2SourceSite: saved
    int: hit 0
    int: restored
    if: mi < 0 || mi >= l2_m_n || h = 0 || stop = 0 || l2_hr_on != 0 || l2_m_body[mi] = 0 || l2_m_body[mi]\as = 0
        return: 0
    if: l2_source_save(@ saved) != 0
        return: 0
    l2_scope_n: 0
    l2_own_excl: -1
    l2_vis_method(mi)
    l2_hr_on: 1
    l2_hr_name: (cast: (@: LmP0Text) h)
    l2_hr_stop: (cast: (@: LmP0Node) stop)
    l2_hr_hit: 0
    l2_hr_done: 0
    l2_scan_body(l2_m_body[mi]\as\structure, mi, 0)
    if: l2_hr_done != 0
        hit: l2_hr_hit
    l2_hr_on: 0
    l2_hr_name: 0
    l2_hr_stop: 0
    restored: l2_source_restore(@ saved)
    l2_xfree((cast: (@: void) saved.scopes))
    if: restored != 0
        return: 0
return: hit

# l2_head_read_before for statement stmt of method mi, found once and kept until l2_release: every pass that
# asks for the role of the head gets the answer the first one found, and no prefix is scanned twice.  Without
# memory to keep it the answer is found again when asked.
fn: l2_head_read_kept (int: mi; const: @(LmP0Text h); const: @(LmP0Node stmt)) int
    int: i 0
    int: got
    int: want
    @: void grown
    while: i < l2_hr_n
        if: l2_hr_at[i] = stmt && l2_hr_mi[i] = mi
            return: l2_hr_val[i]
        i: i + 1
    ---
    got: l2_head_read_before(mi, h, stmt)
    if: l2_hr_n >= l2_hr_cap
        want: l2_cap_next(l2_hr_cap, l2_hr_n + 1)
        if: want < 0
            return: got
        grown: l2_vec_grow((cast: (@: void) l2_hr_at), l2_hr_n, want, c.sizeof(@: LmP0Node))
        if: grown = 0
            return: got
        l2_hr_at: (cast: (@@: LmP0Node) grown)
        grown: l2_vec_grow((cast: (@: void) l2_hr_mi), l2_hr_n, want, c.sizeof(c.int))
        if: grown = 0
            return: got
        l2_hr_mi: (cast: (@: int) grown)
        grown: l2_vec_grow((cast: (@: void) l2_hr_val), l2_hr_n, want, c.sizeof(c.int))
        if: grown = 0
            return: got
        l2_hr_val: (cast: (@: int) grown)
        l2_hr_cap: want
    ---
    l2_hr_at[l2_hr_n]: (cast: (@: LmP0Node) stmt)
    l2_hr_mi[l2_hr_n]: mi
    l2_hr_val[l2_hr_n]: got
    l2_hr_n: l2_hr_n + 1
return: got

# An original named Structure in a method uses the same absent-head/body
# classification as l2_unit_role. Its whole source is retained, including an
# empty body. Neither field kinds nor a trailer make its definition execute.
# The head resolves to nothing there: no formal or dynamic input, no field of the method but the one
# this statement declares, no slot, merge result, method, C door or declared function, primitive type word,
# receiver of the language, named Structure or field of the unit.  The general declaration route (book §9
# :559-:563), as at the root (l2_unit_role 5) and as `f()` (-132): the Structure on the right gives S its type.
# The same answer in every pass: the row this statement declares does not count.
fn: l2_local_ns_shape (const: @(LmP0Node stmt); int: mi) int
    @: LmP0Text w 0
    # K03 NS-ROLES-1: the reference binding `b: A` -- kept by the collection, or A naming a Structure, a callable or a
    # Structure value at the site -- is no definition of b (l2_ref_bind_site).
    if: l2_rb_find(stmt) != 0 || l2_local_absent_def(stmt, mi) = 0
        return: 0
    if: stmt\as != 0 && stmt\as\frame != 0 && l2_ref_tail_atom(stmt\as\frame) != 0 && l2_ref_tail_kind(mi, l2_ref_tail_atom(stmt\as\frame), @ w, 0) != 0
        return: 0
return: 1

# A method's statement whose head resolves to nothing at its site, with a retained body: the definition route's test
# (l2_local_ns_shape), which the reference binding shares (l2_ref_bind_site).
fn: l2_local_absent_def (const: @(LmP0Node stmt); int: mi) int
    @: LmP0Frame fr
    @: LmP0Text h
    int: oi
    if: mi < 0 || mi = l2_e || stmt = 0 || stmt\kind != c.LM_P0_NODE_FRAME || stmt\as = 0 || stmt\as\frame = 0
        return: 0
    fr: stmt\as\frame
    h: fr\head
    if: h = 0 || l2_ident(h) = 0 || l2_is_asgn(stmt, mi) = 0 || fr\body = 0 || fr\body\trailer != 0
        return: 0
    if: l2_is_char_decl(stmt) != 0
        return: 0
    if: fr\trailer != 0 && (fr\trailer\spelling = 0 || l2_text_eq(fr\trailer\spelling, "end") = 0)
        return: 0
    if: l2_retained_body(fr) = 0 || l2_merge_construction(fr) != 0
        return: 0
    if: l2_param_find(mi, h) >= 0 || l2_slot_find(mi, h) >= 0 || l2_ml_find(h) >= 0 || l2_unit_names_method(h) != 0 || l2_site_method(mi, h) >= 0 || l2_is_known(h) != 0
        return: 0
    if: (l2_prim_type_word(h) != 0 && l2_ns_find(h) < 0) || l2_head_word(h) != 0 || l2_ns_find(h) >= 0 || l2_unit_declares(h, 0) != 0
        return: 0
    # K03 S5: in the procedure of a method's own named Structure, a head the host method sees (the one resolution at its
    # site, l2_ns_host_of) is no new definition: a known name never becomes one.
    if: l2_ns_host_of(mi) >= 0 && l2_head_resolve(l2_ns_host_of(mi), h, 0, 0) != 0
        return: 0
    # A definition inside a method sees that method's names: its formal, or a field it declares at method
    # level, is a binding the head resolves to (l2_colon_bound_ty), and the statement assigns it.
    if: l2_mad_host_of(mi) >= 0 && (l2_formal_find(l2_mad_host_of(mi), h) >= 0 || l2_mad_host_own(l2_mad_host_of(mi), h) >= 0)
        return: 0
    oi: l2_own_find(mi, h)
    if: oi >= 0 && l2_own_decl[oi] != stmt
        return: 0
    # A head the method read as a free name before this statement is its input, established by that read
    # (l2_head_read_before): the statement assigns it.  Its own tail, a later read and a caller's value of the
    # same name establish nothing (the author, 2026-10-05).  Inside that scan a statement before this one keeps
    # the role its collection gave it: the row it declares.
    if: l2_hr_on != 0
        return: (cast: (int) (l2_own_by_decl(mi, stmt) >= 0))
    if: l2_head_read_kept(mi, h, stmt) != 0
        return: 0
return: 1

# K03 NS-ROLES-1: what the one atom a names at the current site in method mi, for the reference binding (the one
# resolution, l2_head_resolve): 5 a named Structure, 4 a Structure value of a named model -- an own field, a formal
# (the word of the model into *out_word for both; a named Structure's is a itself) --, 2 a method, whose occurrence the
# binding holds (Codex -07 Q1; *out_meth the method, *out_word a), 8 a held callable (a callable formal, a held
# callable merge, a C function local: not built yet), 6 a Structure value of no named model -- a merge result, or a
# binding to one (NS-ROLES-1c; *out_word the Structure reference's word `Lmx`, *out_meth its own field) --, 0 anything
# else (a datum, an unknown name: the definition route).
fn: l2_ref_tail_kind (int: mi; const: @(LmP0Text a); @@: LmP0Text out_word; @: int out_meth) int
    int: k
    int: idx -1
    int: own
    int: model -1
    if: out_word != 0
        \out_word: 0
    if: out_meth != 0
        \out_meth: -1
    if: a = 0
        return: 0
    k: l2_head_resolve(mi, a, @ idx, 0)
    if: k = 5
        if: out_word != 0
            \out_word: (cast: (@: LmP0Text) a)
        return: 5
    if: k = 2 && idx >= 0
        if: out_word != 0
            \out_word: (cast: (@: LmP0Text) a)
        if: out_meth != 0
            \out_meth: idx
        return: 2
    if: k = 3
        return: 8
    if: k != 4
        return: 0
    own: l2_resolved_own(mi, a)
    if: own >= 0 && own = idx
        # A merge result -- its row declared by merge's construction, `a: merge: ...`, known before its schema is -- or a
        # binding to one: its schema is that merge's record.
        if: (l2_own_decl[own] != 0 && l2_application(l2_own_decl[own]) != 0 && l2_merge_construction(l2_application(l2_own_decl[own])) != 0) || (l2_own_nsty_get(own) < 0 && l2_own_schema(own) != -1)
            if: out_word != 0
                \out_word: l2_lmx_text()
            if: out_meth != 0
                \out_meth: own
            return: 6
        model: l2_own_nsty_get(own)
        ---
    if: own < 0 && l2_formal_find(mi, a) >= 0 && l2_formal_find(mi, a) = idx
        model: l2_input_model(mi, idx)
    if: model < 0 || model >= l2_ns_n
        return: 0
    if: out_word != 0
        \out_word: l2_ns_name[model]
return: 4

# K03 NS-ROLES-1 (Codex K03-S5-MIGRATION-20261007-06 (b), -07 Q1/Q2; docs/LMX_semantics.en.md:666, :834): whether statement
# stmt of method mi -- the root's E included -- is the absent-b reference binding `b: A`, and what A is at its site
# (l2_ref_tail_kind; *out_word the word of A's model for a Structure).  Its head resolves to nothing there: a root
# item by its unit role (l2_unit_ref_bind, read from the source), a statement of a block of the root by the resolution
# at its place, a method's statement by the definition route's own test (l2_local_absent_def).  7: the root's source
# reading and the site disagree -- said by the collection, never taken silently.
fn: l2_ref_bind_site (const: @(LmP0Node stmt); int: mi; @@: LmP0Text out_word; @: int out_meth) int
    @: LmP0Text a
    int: k
    if: out_word != 0
        \out_word: 0
    if: out_meth != 0
        \out_meth: -1
    if: stmt = 0 || stmt\kind != c.LM_P0_NODE_FRAME || stmt\as = 0 || stmt\as\frame = 0 || mi < 0
        return: 0
    a: l2_ref_tail_atom(stmt\as\frame)
    if: a = 0
        return: 0
    if: mi = l2_e && l2_unit_item(stmt) != 0
        if: l2_head_absent(stmt\as\frame\head, stmt) = 0 || l2_retained_body(stmt\as\frame) = 0 || l2_unit_ref_bind(stmt\as\frame, stmt) = 0
            return: 0
        k: l2_ref_tail_kind(mi, a, out_word, out_meth)
        if: k = 0
            return: 7
        return: k
    ---
    # A statement of a block of the root: its head resolves to nothing at its site (the one resolution, read as the
    # root reads its statements, from the statement's place).
    if: mi = l2_e
        if: l2_ident(stmt\as\frame\head) = 0 || l2_head_resolve(mi, stmt\as\frame\head, 0, 0) != 0 || l2_retained_body(stmt\as\frame) = 0
            return: 0
        return: l2_ref_tail_kind(mi, a, out_word, out_meth)
    ---
    if: l2_local_absent_def(stmt, mi) = 0
        return: 0
return: l2_ref_tail_kind(mi, a, out_word, out_meth)

# The atom A of a reference binding's statement, the place its limits are said at.
fn: l2_ref_tail_node (const: @(LmP0Node stmt)) const: @: LmP0Node
    @: LmP0Field f
    if: stmt = 0 || stmt\as = 0 || stmt\as\frame = 0 || stmt\as\frame\body = 0
        return: stmt
    f: l2_next_active(stmt\as\frame\body\first_field)
    if: f = 0 || f\value = 0
        return: stmt
return: f\value

# K03 NS-ROLES-2: whether procedure mi's reading of statement stmt of its named Structure's body -- l2_ref_bind_site's
# kind k, the word w of what it binds, or the binding a pass before kept (l2_rb_find) -- agrees with the field the body
# made of it: a binding row for a binding to that named Structure, and no binding where the body made none.
fn: l2_ns_bind_agrees (int: mi; const: @(LmP0Node stmt); int: k; const: @(LmP0Text w)) int
    int: row 0
    int: bound -1
    int: ni l2_m_nsof(mi)
    while: row < l2_nsf_n
        if: l2_nsf_owner[row] = ni && l2_nsf_source[row] = stmt && l2_nsf_kind[row] = 10 && l2_nsf_val[row] != 0U
            bound: (cast: (int) l2_nsf_val[row]) - 1
        row: row + 1
    ---
    if: bound < 0
        return: (cast: (int) (l2_rb_find(stmt) = 0 && k != 2 && k != 4 && k != 5 && k != 6 && k != 8))
    if: k = 5 && w != 0
        return: (cast: (int) (l2_ns_find(w) = bound))
return: (cast: (int) (k = 0 && l2_rb_find(stmt) != 0 && l2_ns_find(l2_rb_find(stmt)) = bound))

# Compatibility field-construction capability, separate from the whole-source
# producer. Follow actual nested declarations without an artificial depth cap.
fn: l2_ns_num_fields (int: ni) int
    int: fx 0
    int: n 0
    if: ni < 0 || ni >= l2_ns_n
        return: 0
    while: fx < l2_nsf_n
        if: l2_nsf_owner[fx] = ni && l2_nsf_kind[fx] = 2 && l2_ns_num_fields(l2_nsf_ref[fx]) = 0
            return: 0
        if: l2_nsf_owner[fx] = ni && l2_nsf_kind[fx] != 0 && l2_nsf_kind[fx] != 1 && l2_nsf_kind[fx] != 2 && l2_nsf_kind[fx] != 3 && l2_nsf_kind[fx] != 4 && l2_nsf_kind[fx] != 5 && l2_nsf_kind[fx] != 6 && l2_nsf_kind[fx] != 7 && l2_nsf_kind[fx] != 8 && l2_nsf_kind[fx] != 9 && l2_nsf_kind[fx] != 10 && l2_nsf_kind[fx] != 11
            return: 0
        if: l2_nsf_owner[fx] = ni
            n: n + 1
        fx: fx + 1
    ---
    if: n < 1
        return: 0
return: 1

# CHECK commits the exact original declaration and its callable source row.
# The shared source producer constructs the occurrence at its written place;
# reached execution of the definition does not allocate a second occurrence.
fn: l2_local_ns_declare (const: @(LmP0Node stmt); int: mi; const: @(char path)) int
    int: ni
    int: cj
    @: LmP0Text h
    h: stmt\as\frame\head
    ni: l2_local_ns_entry(stmt, mi, path)
    if: ni < 0
        return: 1
    cj: l2_own_add(mi, h, l2_graph_own(), path, stmt)
    if: cj < 0
        return: 1
    if: l2_own_off(mi, cj) = (cast: (size_t) -1)
        return: l2_error(path, stmt, "size overflow")
    l2_m_uses[l2_own_off(mi, cj)]: 1
    l2_m_own[mi]: l2_m_own[mi] + 1
    if: l2_bind_own(mi, cj, path, stmt) != 0
        return: 1
return: l2_own_nsty_set(cj, ni)

# The entry of a method's own named Structure declared by stmt in mi: found by its declaration, or made -- the body
# read as a named Structure's (l2_take_ns_body), every entry it makes (a nested one too) local to mi.  -1 with the
# body's own diagnostic.
fn: l2_local_ns_entry (const: @(LmP0Node stmt); int: mi; const: @(char path)) int
    int: ni 0 - 1
    int: i 0
    while: i < l2_ns_n
        if: l2_ns_at[i] = stmt && l2_ns_name[i] = stmt\as\frame\head
            ni: i
        i: i + 1
    ---
    if: ni >= 0
        return: ni
    ni: l2_ns_n
    # A typed-field constructor keeps its atoms as statements. A written-atom
    # definition keeps those atoms as content (kind 12), the same as the unit.
    if: l2_atom_only_tail(stmt\as\frame) = 0
        l2_atom_hold: 1
    l2_ns_take_mi: mi
    if: l2_take_ns_body(stmt\as\frame\head, 0 - 1, stmt\as\frame\body, stmt, path) != 0
        l2_atom_hold: 0
        l2_ns_take_mi: 0 - 1
        return: 0 - 1
    l2_atom_hold: 0
    l2_ns_take_mi: 0 - 1
    if: ni >= l2_ns_n
        l2_error(path, stmt, "internal: a method's named Structure made no entry")
        return: 0 - 1
    i: ni
    while: i < l2_ns_n
        l2_ns_local[i]: mi
        i: i + 1
    ---
    # An expression span is the Structure's child, not a procedure. The take recorded it as a
    # statement; clear that so the method stays walked and the operator is stored later.
    if: l2_expr_only_tail(stmt\as\frame) != 0
        l2_ns_stmt[ni]: 0
        l2_ns_count[ni]: 1
    # Register original bodies at the collection fixed point, independently
    # of calledness and before any execution/count arrays are sized.
return: ni

# Whether the statements from `first` -- nested bodies too -- execute the name h: its bare atom, or `h()` (one P0 Frame
# with `h: ()`, l2_empty_call_shape).  A syntactic reading, before the method is checked; it errs only toward a
# procedure no statement runs (the call's own check decides what h is, l2_check_struct_call).
fn: l2_body_calls_name (@: LmP0Field first; const: @(LmP0Text h)) int
    @: LmP0Field f
    @: LmP0Field g
    @: LmP0Node v
    f: l2_next_active(first)
    while: f != 0
        v: f\value
        if: v != 0 && v\kind = c.LM_P0_NODE_ATOM && v\as != 0 && l2_discard_run(f) = 1 && l2_text_same(v\as\atom, h) != 0
            return: 1
        if: l2_empty_call_shape(v) != 0 && l2_text_same(v\as\frame\head, h) != 0
            return: 1
        if: v != 0 && v\kind = c.LM_P0_NODE_FRAME && v\as != 0 && v\as\frame != 0 && v\as\frame\body != 0
            g: l2_next_active(v\as\frame\body\first_field)
            while: g != 0
                if: g\value != 0 && g\value\kind = c.LM_P0_NODE_STRUCTURE && g\value\as != 0 && g\value\as\structure != 0 && l2_body_calls_name(g\value\as\structure\first_field, h) != 0
                    return: 1
                g: l2_next_active(g\next)
            ---
            if: l2_frame_head(v, "else") != 0 && l2_body_calls_name(v\as\frame\body\first_field, h) != 0
                return: 1
        ---
        if: v != 0 && v\kind = c.LM_P0_NODE_STRUCTURE && v\as != 0 && v\as\structure != 0 && l2_body_calls_name(v\as\structure\first_field, h) != 0
            return: 1
        f: l2_next_active(f\next)
    ---
return: 0

# The procedure of a method's own named Structure ni (slice 2c): a method whose body is S's body and whose own fields
# are S's fields in S's slots (l2_ns_proc_add, §12).  Registered in the collection pre-pass, after the entry E: a
# method after E has no unit child (l2_occ_n), and none is wanted -- its occurrence is S itself, built at S's statement
# in the method (l2_emit_local_ns).  The one table the unit sized before this pass takes it too (l2_m_value_used).  A
# library unit executes no named Structure: none there.
fn: l2_local_ns_proc (int: ni; const: @(char path)) int
    int: n0
    int: k
    int: sn
    int: bad
    size_t: nb 0U
    @: int grown
    @@: LmP0Node saved 0
    if: l2_library_mode != 0 || ni < 0 || ni >= l2_ns_n || l2_ns_proc[ni] >= 0
        return: 0
    n0: l2_m_n
    # Registered as a unit named Structure's is, with no scope open: the scopes the method's pre-pass is in at S's
    # statement are the method's, set aside and restored -- S's fields are S's, never a field of the body S stands in.
    sn: l2_scope_n
    if: sn > 0
        nb: (cast: (size_t) sn) * c.sizeof(@: void)
        saved: (cast: (@@: LmP0Node) l2_xmalloc(nb))
        if: saved = 0
            return: l2_alloc_or(path, l2_ns_at[ni], "out of memory")
        memcpy((cast: (@: void) saved), (cast: (@: void) l2_scope_at), nb)
    ---
    l2_scope_n: 0
    bad: l2_ns_proc_add(ni, path)
    if: sn > 0
        memcpy((cast: (@: void) l2_scope_at), (cast: (@: void) saved), nb)
        l2_xfree((cast: (@: void) saved))
    ---
    l2_scope_n: sn
    if: bad != 0
        return: 1
    if: l2_m_value_used != 0
        grown: (cast: (@: int) realloc((cast: (@: void) l2_m_value_used), (cast: (size_t) l2_m_n) * c.sizeof(c.int)))
        if: grown = 0
            return: l2_alloc_or(path, l2_ns_at[ni], "out of memory")
        l2_m_value_used: grown
        k: n0
        while: k < l2_m_n
            l2_m_value_used[k]: 0
            k: k + 1
        ---
    ---
return: 0

# The own field of mi a call names when t is a method's own named Structure with a procedure (slice 2c): the field S
# its declaration declares, typed by the entry local to mi (l2_ns_local) -- or -1.  No formal, slot or local.
fn: l2_local_ns_callee (const: @(LmP0Text t); int: mi) int
    int: oi
    int: ni
    if: t = 0 || mi < 0 || l2_param_find(mi, t) >= 0 || l2_slot_find(mi, t) >= 0 || l2_ml_find(t) >= 0
        return: 0 - 1
    oi: l2_own_visible(mi, t)
    if: oi < 0
        return: 0 - 1
    ni: l2_own_call_origin(oi)
    if: ni < 0
        return: 0 - 1
return: oi

# The own field of mi that a method's own named Structure ni types: the one its declaration declares.  -1 if none.
fn: l2_own_of_local_ns (int: mi; int: ni) int
    int: oi 0
    if: ni < 0 || ni >= l2_ns_n || l2_ns_local[ni] != mi
        return: 0 - 1
    while: oi < l2_own_n
        if: l2_own_mi[oi] = mi && l2_own_decl[oi] = l2_ns_at[ni] && l2_own_nsty_get(oi) = ni
            return: oi
        oi: oi + 1
    ---
return: 0 - 1

# receiveMessage: m / receiveMessage: m Model (author, Q10, 2026-09-23; the
# two-name form, FABLE-SONNET-SEND-REF-20260925-172 commit 2) -- the general
# mail receiver: m is bound to the graph of the next admitted letter of the
# CURRENT Thread, and to 0 when its inbox is empty. It is a receiver of the
# language: its name is reserved, so no method takes it (RESERVED-NAME-BINDINGS,
# l2_bind_admit). m is an own field typed to the
# synthesized letter model (l2_letter_ns_for), declared by the first
# receiveMessage that names it and rebound by every later one. With a second
# name, that name is the user's model for the letter's payload (field 1);
# without one, the payload is untyped -- either way m\sender and, when typed,
# m\payload\<field> resolve as ordinary field paths. 0 = the shape (out_model
# 0 for the one-name form), 2 = the receiver with anything but one or two
# names, 1 = not it.
fn: l2_receive_msg_shape (const: @(LmP0Node stmt); @@: LmP0Text out_name; @@: LmP0Text out_model) int
    @: LmP0Frame fr
    @: LmP0Field only
    @: LmP0Field second
    if: out_name = 0
        return: 1
    \out_name: 0
    if: out_model != 0
        \out_model: 0
    if: stmt = 0 || l2_app_head(stmt) = 0 || l2_text_eq(l2_app_head(stmt), "receiveMessage") = 0
        return: 1
    # K03: the bare word is its application with no name: it binds none.
    if: stmt\kind != c.LM_P0_NODE_FRAME || stmt\as = 0 || stmt\as\frame = 0
        return: 2
    fr: stmt\as\frame
    if: fr\body = 0 || fr\trailer != 0 || fr\body\trailer != 0 || (l2_count_active(fr\body) != 1 && l2_count_active(fr\body) != 2)
        return: 2
    only: l2_next_active(fr\body\first_field)
    if: only = 0 || only\value = 0 || only\value\kind != c.LM_P0_NODE_ATOM || only\value\as = 0 || only\value\as\atom = 0 || l2_bind_spelling(only\value\as\atom) = 0
        return: 2
    if: l2_count_active(fr\body) = 2
        second: l2_next_active(only\next)
        if: second = 0 || second\value = 0 || second\value\kind != c.LM_P0_NODE_ATOM || second\value\as = 0 || second\value\as\atom = 0 || l2_ident(second\value\as\atom) = 0
            return: 2
        \out_name: only\value\as\atom
        if: out_model != 0
            \out_model: second\value\as\atom
        return: 0
    \out_name: only\value\as\atom
return: 0

# Existing fixed-name caches retain only a view over permanent literal bytes.
# Their one allocation is released with the translation, not on each use.
fn: l2_sender_text () @: LmP0Text
    if: l2_sender_name_cache = 0
        l2_sender_name_cache: (cast: (@: LmP0Text) l2_xmalloc(c.sizeof(c.LmP0Text)))
        if: l2_sender_name_cache = 0
            return: 0
        l2_sender_name_cache\data: "sender"
        l2_sender_name_cache\length: 6U
    ---
return: l2_sender_name_cache

fn: l2_payload_text () @: LmP0Text
    if: l2_payload_name_cache = 0
        l2_payload_name_cache: (cast: (@: LmP0Text) l2_xmalloc(c.sizeof(c.LmP0Text)))
        if: l2_payload_name_cache = 0
            return: 0
        l2_payload_name_cache\data: "payload"
        l2_payload_name_cache\length: 7U
    ---
return: l2_payload_name_cache

# A deterministic, never-source-spellable name for a synthesized letter
# model, so it is traceable (and distinct per payload model) without ever
# being findable by l2_ns_find over real source text: a leading space is not
# a character any L2 identifier can start with. 0 model = the untyped letter.
fn: l2_letter_synth_name (const: @(LmP0Text model)) @: LmP0Text
    @: LmP0Text r
    @: char buf
    r: (cast: (@: LmP0Text) l2_xmalloc(c.sizeof(c.LmP0Text)))
    if: r = 0
        return: 0
    if: model = 0
        r\data: " receiveMessage"
        r\length: 16U
        return: r
    buf: (cast: (@: char) l2_xmalloc((cast: (size_t) model\length) + 1U))
    if: buf = 0
        return: 0
    buf[0]: 32
    memcpy((cast: (@: void) (buf + 1)), (cast: (@: void) model\data), model\length)
    r\data: buf
    r\length: model\length + 1U
return: r

# The Message reference: the type of a letter's sender, which the translator builds itself
# (l2_letter_ns_for) and never recognizes from a source spelling (§GATE G2).  One code, named
# here; it projects to C once, as `const LmxMsg *` (l2_pointer_decl_text), and D-80's addressee
# check compares the own code of that reference.  Target (plan §7): Message as a translator
# description with no source fields, sender a reference to it, D-80 by identity.
fn: l2_msg_ref_ty () int
return: 29

# The C type expression of a pointer cell whose pointee code is `code` (own code - 1000): the
# kernel's closed-unit encoding LMX_TYPE_POINTER_BASE + code, except the Message reference, which
# the kernel names (LMX_TYPE_MSG_REF, lmx.h.lm1) -- so kernel and translator meet at one name,
# not at a shared literal.
fn: l2_ptr_cell_type (int: code; @: char dest) int
    if: dest = 0
        return: 1
    if: code = l2_msg_ref_ty()
        return: (cast: (int) (c.sprintf(dest, "c.LMX_TYPE_MSG_REF") < 0))
return: (cast: (int) (c.sprintf(dest, "c.LMX_TYPE_POINTER_BASE + %d", code) < 0))

# The synthesized letter model for a receiveMessage payload (0 model =
# untyped): a Structure {sender: @: LmxMsg; payload: Model}, memoized by
# model so every receive site naming the same model -- or none -- shares one
# entry (a letter's shape is a type, not a per-site construction). The
# untyped payload uses the SAME general reference kind (10) the sender field
# does, pointee Lmx (the generic model projection, l2_lmx_text), exactly like
# a formal's or local's `@: Lmx` would be.  A named model's payload is kind 3
# with the model as its target, set here: the model's copy, made when the
# letter model is constructed (l2_emit_ns_refs).  No source spelling makes
# kind 3 (K03 NS-ROLES-2).
fn: l2_letter_ns_for (const: @(LmP0Text model); const: @(LmP0Node at); const: @(char path); @: int out_ni) int
    int: k 0
    int: mni 0 - 1
    int: ni
    int: lmx_ty
    @@: LmP0Text gn
    @: int gi
    @: LmP0Text sender
    @: LmP0Text payload
    size_t: want
    if: out_ni = 0
        return: 1
    \out_ni: -1
    while: k < l2_letter_model_n
        if: model = 0 && l2_letter_model_name[k] = 0
            \out_ni: l2_letter_model_ns[k]
            return: 0
        if: model != 0 && l2_letter_model_name[k] != 0 && l2_text_same(l2_letter_model_name[k], model) != 0
            \out_ni: l2_letter_model_ns[k]
            return: 0
        k: k + 1
    ---
    if: model != 0
        mni: l2_ns_find(model)
        if: mni < 0
            return: l2_error(path, at, "receiveMessage: unknown payload model")
        ---
    ---
    sender: l2_sender_text()
    payload: l2_payload_text()
    if: sender = 0 || payload = 0
        return: l2_error(path, at, "out of memory")
    ni: l2_ns_push(l2_letter_synth_name(model), 0 - 1, at)
    if: ni < 0
        return: l2_error(path, at, "out of memory")
    l2_ns_first[ni]: l2_nsf_n
    if: l2_nsf_push(10, 0U, l2_msg_ref_ty(), ni, 0) < 0
        return: l2_error(path, at, "out of memory")
    l2_nsf_fname[l2_nsf_n - 1]: sender
    if: model != 0
        if: l2_nsf_push(3, 0U, mni, ni, 0) < 0
            return: l2_error(path, at, "out of memory")
        l2_nsf_fname[l2_nsf_n - 1]: payload
    else:
        lmx_ty: l2_foreign_intern(l2_lmx_text(), 1, 0)
        if: lmx_ty < 100
            return: l2_error(path, at, "out of memory")
        if: l2_nsf_push(10, 0U, lmx_ty, ni, 0) < 0
            return: l2_error(path, at, "out of memory")
        l2_nsf_fname[l2_nsf_n - 1]: payload
    ---
    l2_ns_count[ni]: 2
    want: (cast: (size_t) (l2_letter_model_n + 1))
    gn: (cast: (@@: LmP0Text) realloc((cast: (@: void) l2_letter_model_name), want * c.sizeof(@: void)))
    if: gn = 0
        return: l2_error(path, at, "out of memory")
    l2_letter_model_name: gn
    gi: (cast: (@: int) realloc((cast: (@: void) l2_letter_model_ns), want * c.sizeof(c.int)))
    if: gi = 0
        return: l2_error(path, at, "out of memory")
    l2_letter_model_ns: gi
    l2_letter_model_name[l2_letter_model_n]: (cast: (@: LmP0Text) model)
    l2_letter_model_ns[l2_letter_model_n]: ni
    l2_letter_model_n: l2_letter_model_n + 1
    \out_ni: ni
return: 0

# Does a body take a letter anywhere? Such a method declares the two locals
# of the take (the letter record and its graph).
fn: l2_body_receives (const: @(LmP0Structure body)) int
    @: LmP0Field field
    @: LmP0Field inner
    @: LmP0Node stmt
    @: LmP0Text nm
    if: body = 0
        return: 0
    field: l2_next_active(body\first_field)
    while: field != 0
        stmt: field\value
        if: stmt != 0 && stmt\kind = c.LM_P0_NODE_STRUCTURE && stmt\as != 0 && stmt\as\structure != 0 && l2_body_receives(stmt\as\structure) != 0
            return: 1
        if: l2_receive_msg_shape(stmt, @ nm, 0) = 0
            return: 1
        if: stmt != 0 && stmt\kind = c.LM_P0_NODE_FRAME && stmt\as != 0 && stmt\as\frame != 0 && stmt\as\frame\body != 0
            if: l2_for_find(stmt) >= 0 && l2_scope_block(stmt) = stmt\as\frame\body && l2_body_receives(stmt\as\frame\body) != 0
                return: 1
            inner: l2_next_active(l2_call_actuals(stmt\as\frame\body))
            while: inner != 0
                if: inner\value != 0 && inner\value\kind = c.LM_P0_NODE_STRUCTURE && inner\value\as != 0 && l2_body_receives(inner\value\as\structure) != 0
                    return: 1
                inner: l2_next_active(inner\next)
            ---
        ---
        field: l2_next_active(field\next)
    ---
return: 0

# THE OWN STORAGE CODE OF A FORMAL'S TYPE (FABLE-L2-ARG-ADDRESS-DIRTY-20260921-67).  Argument-as-own
# binding is one mechanism for every argument type that can be assigned; the TYPE decides only
# which graph cell holds the published value.  Formal codes and own storage codes are different
# number spaces (unsigned is 34 as a formal and 3 as an own field; a pointer formal r is the own
# field 1000 + r, the same code a declared pointer own has), so every comparison between the two
# goes through this one function instead of comparing the raw numbers.  -1 is "the graph has no
# cell for this type today", never "this type is not eligible": pointers of every depth and
# pointee go to the one generic pointer cell.
fn: l2_own_ty_of_param (int: ft) int
    if: ft = 34
        return: 3
    if: ft = l2_graph_code()
        return: l2_graph_own()
    if: l2_pointer_depth(ft) > 0
        return: l2_oc_pointer(ft)
    if: ft = 0 || ft = 1 || ft = 2 || ft = 36
        return: ft
return: -1

# The inverse: the FORMAL code of an own storage code.
fn: l2_ft_of_own (int: oty) int
    if: oty = 3
        return: 34
    if: l2_oc_is_pointer(oty) != 0
        return: l2_oc_ft(oty)
return: oty

# OWN-TYPE-CODE-BANDS: an own field's code names its kind and its type at once.  A primitive and a primitive Array
# have their own numbers, all below 1000; a pointer and an Array of pointers are made from the formal type they hold,
# at or above it -- the kind in the low bit, the formal type in the rest, so no formal type, however many are interned,
# makes one kind read as the other.  Only these helpers make one, test one or take the formal type back.
fn: l2_oc_pointer (int: ft) int
return: 1000 + 2 * ft

fn: l2_oc_parray (int: ft) int
return: 1001 + 2 * ft

fn: l2_oc_is_pointer (int: oty) int
return: (cast: (int) (oty >= 1000 && (oty - 1000) % 2 = 0))

fn: l2_oc_is_parray (int: oty) int
return: (cast: (int) (oty >= 1000 && (oty - 1000) % 2 = 1))

# A pointer or an Array of pointers: a reference.
fn: l2_oc_is_ref (int: oty) int
return: (cast: (int) (oty >= 1000))

# The formal type a pointer or an Array of pointers holds.
fn: l2_oc_ft (int: oty) int
return: (oty - 1000) / 2

# Storage/layout codes describe the existing cell; ordinary expression typing
# projects the value it holds. An Array contributes its descriptor reference,
# while element and hidden-input storage keep their separate existing contracts.
fn: l2_value_ft_of_own (int: oty) int
    if: l2_own_is_array(oty) != 0
        return: l2_array_desc_ty()
return: l2_ft_of_own(oty)

# THE TYPE CODE OF A HIDDEN/DYNAMIC INPUT (FABLE-L2-ARG-ADDRESS-PROOF-20260921-84).  It used to be the
# own storage code itself with 0 for "not typed yet" -- and int's storage code IS 0.  So an int
# could not be a dynamic input at all: a callee reading the caller's int never got it, and the
# typing fixed point never ended (it stored 0 over 0 and reported a change on every pass).
# Around that hole five separate lists named the types that did work, char and size_t, and one
# of them compared a FORMAL code with this code raw -- the two-number-spaces mistake once more.
# Now the code is the own storage code PLUS ONE and 0 alone is "not typed yet".  These two
# functions are the only place that knows it; nothing else adds or subtracts one.  Eligibility
# is the question the publication descriptor already answers: is there a value cell.
fn: l2_dt_of_own (int: oty) int
    if: oty < 0 || l2_own_store_helper(oty) = 0
        return: 0
return: oty + 1

fn: l2_own_of_dt (int: dt) int
    if: dt <= 0
        return: -1
return: dt - 1

# THE ONE BOUNDARY where a type that cannot travel as a dynamic input is refused.  A SOURCE was
# found -- the caller's own field or formal, or the body's own same-name field -- and its type
# has no value cell.  That is said here, by name; it must not surface later as a free name
# nobody could resolve, and never as a formal the signature quietly lacks.
fn: l2_dt_of_source (int: oty; const: @(char path); const: @(LmP0Node at); @: int dt) int
    if: dt = 0
        return: 1
    \dt: l2_dt_of_own(oty)
    if: \dt = 0
        return: l2_error(path, at, "dynamic input type has no value cell")
return: 0

# The one formula for "the C expression that reaches own field oi's cell":
# the completed field place supplies both its physical holder and child;
# a root field uses its owning occurrence via l2_own_ctr. Every emitter
# that needs this address -- the dirty-load cache (l2_emit_own_from
# below), an array leaf, a single-hop path read -- writes it into dest
# rather than each hand-inlining the same two branches
# (FABLE-SONNET-OWN-LOOKUP-AUDIT-20260923-131 (a): they had drifted --
# one copy missing l2_emit_own_from's own cache guard).
fn: l2_own_from_expr (int: oi; @: L2Tx dest) int
    @: L2GraphField field l2_graph_field(oi)
    []: char nm 96
    if: field = 0 || dest = 0
        return: 1
    if: field\holder != 0
        if: c.snprintf(nm, 96U, "lmx_arena_ref_cell(l2_gp%zu, %zuU)", field\holder\id, field\child) < 0
            return: 1
        return: l2_tx_set(dest, nm)
    if: c.snprintf(nm, 96U, ", %zuU)", field\child) < 0
        return: 1
return: l2_tx_join(dest, "lmx_arena_ref_cell(", l2_own_ctr(oi), nm, 0, 0)

# A DIRECT own field (-189 c3b-1, c3b-2, c3b-3): a number -- int, char, size_t, unsigned, ulong -- or
# a pointer is its cell, and an own Structure field its slot (l2_own_is_slot).  It has no working
# copy: a read is a typed load (l2_own_load) and a write a typed store (l2_own_store), so there is
# nothing to publish at a call or an exit.  A field bound to a formal or a dynamic input is one too, from
# its binding line on (l2_formal_row); before that line the name is the machine argument.
fn: l2_own_direct (int: mi; int: k) int
    int: ty
    if: mi < 0 || k < 0 || k >= l2_own_n
        return: 0
    ty: l2_own_ty[k]
return: ty = 0 || ty = 1 || ty = 2 || ty = 3 || ty = 36 || l2_own_is_pointer(ty) != 0

# AN OWN STRUCTURE FIELD IS A DIRECT SLOT (-189 c3b-3; q26: an own binding is the slot itself, a
# reference `@: T x` a pointer cell): a field of the graph type whose declaration is not a pointer
# declaration -- `Model: m`, `T: m`, `receiveMessage: m`, `f()`, a Structure catch parameter.  Its
# slot holds the Structure, empty (0) until the field is bound; the builder makes no cell for it.
fn: l2_own_is_slot (int: k) int
    if: k < 0 || k >= l2_own_n || l2_own_is_pointer(l2_own_ty[k]) = 0 || l2_own_is_graph(l2_own_ty[k]) = 0
        return: 0
    # K03 NS-ROLES-1: the reference binding `b: A` (l2_rb_find) declares a reference, a pointer cell, as `@: T x` does.
    if: l2_rb_find(l2_own_decl[k]) != 0
        return: 0
return: l2_frame_head(l2_own_decl[k], "@") = 0

# The container and index of own field k's slot, "ctr, NU" -- the two halves of l2_own_from_expr.
fn: l2_own_slot_at (int: k; @: char dest) int
    @: L2GraphField field l2_graph_field(k)
    if: field = 0 || dest = 0
        return: 1
    if: field\holder != 0
        return: (cast: (int) (c.sprintf(dest, "l2_gp%zu, %zuU", field\holder\id, field\child) < 0))
return: (cast: (int) (c.sprintf(dest, "%s, %zuU", l2_own_ctr(k), field\child) < 0))

# Load own field k from the slot address l2_xp into temporary t: a slot holds the Structure itself,
# any other field a typed cell (l2_emit_cell_load).
fn: l2_emit_own_cell_load (int: k; const: @(char ind); int: t; const: @(LmP0Node at)) int
    []: char txt_own 1024
    L2Tx: txt_tx
    @: L2Tx txt l2_tx_local(@ txt_tx, txt_own, 1024U)
    []: char dcl_own 1024
    L2Tx: dcl_tx
    @: L2Tx dcl l2_tx_local(@ dcl_tx, dcl_own, 1024U)
    []: char nm 32
    if: l2_own_is_slot(k) = 0
        return: l2_emit_cell_load(l2_own_ty[k], ind, t, at)
    if: c.sprintf(nm, "l2_t%d", t) < 0 || l2_pointer_decl_text(l2_oc_ft(l2_own_ty[k]), 0, nm, dcl) != 0 || l2_pointer_decl_text(l2_oc_ft(l2_own_ty[k]), 0, 0, txt) != 0
        return: 1
return: (cast: (int) (c.fprintf(l2_out, "%s%s\n%sl2_t%d: (cast: (%s) l2_xp[0])\n", ind, dcl\data, ind, t, txt\data) < 0))

# The parameter of mi (a formal, or a dynamic input) that own field k's name names, or -1: a field
# of that name binds it -- at method level, or in a body, whose hosted field it then is (fable).
fn: l2_own_formal (int: mi; int: k) int
    if: mi < 0 || k < 0 || k >= l2_own_n
        return: 0 - 1
return: l2_param_find(mi, l2_own_name[k])

# THE BOUND ROW (L3 §12; L2 §10, §18.3).  Parameter pk of mi (a formal, or a dynamic input) names the machine
# argument until a same-name field declared in scope has had its declaration line, and that field from then on -- a
# bare assignment binds nothing (bafca4c).  A field declared in a nested body ends when the body ends (l2_emit_body):
# its declaration is visible forward and down, never outward (Q51), so a branch not taken binds nothing after it.  The
# latest mark wins; -1 is the machine argument.
fn: l2_formal_row (int: mi; int: pk) int
    @: LmP0Text name
    int: own
    if: mi < 0 || pk < 0
        return: -1
    if: pk < l2_m_arity[mi]
        name: l2_fn(mi, pk)
    else:
        name: l2_dn(mi, pk - l2_m_arity[mi])
    own: l2_own_visible(mi, name)
    if: own >= 0 && l2_own_mi[own] = mi
        return: own
return: -1

# The direct own field a bare name means at this point of the emission, or -1: a formal's bound
# row (l2_formal_row), else the method's own field of that name.
fn: l2_name_cell (int: mi; const: @(LmP0Text t)) int
    int: pi l2_param_find(mi, t)
    int: k
    if: pi >= 0
        return: l2_formal_row(mi, pi)
    k: l2_own_visible(mi, t)
    if: k >= 0 && l2_own_direct(mi, k) != 0
        return: k
return: 0 - 1

# Resolve the binding before asking its storage category. A formal with no
# bound own row must not reveal an outer same-name field. Arrays use the same
# source-visible own selection as direct-cell values, without requiring a cache.
fn: l2_resolved_own (int: mi; const: @(LmP0Text t)) int
    int: k l2_name_cell(mi, t)
    if: k < 0 && l2_param_find(mi, t) < 0
        k: l2_own_visible(mi, t)
return: k

# THE WORKING STATE (steps/working-state-7b.md; book §12 `#dynamic`, §14; `docs/new_parts/dirty.md`; Lingvamyxa
# spec 21.5, 21.6).  Own field k has a working value in the activation of method mi -- the root's too, an ordinary
# activation (Q52) -- when it is mi's own, used by a bare name (l2_m_uses), has a cell (l2_own_direct) and is no
# array.  A same-name field declared for a formal or a dynamic input is one too (7b-2): its declaration is the explicit
# one that makes the argument graph-backed (book §12), takes the argument's current value into the working value and
# marks it (l2_own_store), and from there the name is the field (l2_formal_row); before it the name and `@x` are the
# parameter's (L2 §18.3), never a field (bafca4c).  The working value is the C local l2_q<k>, loaded from
# the cell at entry (l2_emit_work_decl); a bare read is the local (l2_own_load); an admitted write changes the local
# and sets l2_q<k>_dirty (l2_own_work_store); a boundary publishes the marked ones and unmarks them
# (l2_emit_publish).  A clean one is never written back and nothing is reloaded after a call.  An explicit path and
# `@x` of an own field stay the cell (L2 §18.2): a write through them does not touch the local.
fn: l2_own_cached (int: mi; int: k) int
    if: mi < 0 || k < 0 || k >= l2_own_n || l2_own_mi[k] != mi || l2_m_uses = 0
        return: 0
    if: l2_m_uses[l2_own_off(mi, k)] = 0 || l2_own_is_array(l2_own_ty[k]) != 0 || l2_own_direct(mi, k) = 0
        return: 0
    # A catch parameter is written by the delivery into its cell -- the walker's pad binding, the native handler -- so
    # in 7b-1 it keeps no working value in either mode (steps/working-state-7b.md, the open items).
    if: l2_own_host[k] != 0 && l2_frame_head(l2_own_host[k], "catch") != 0
        return: 0
return: 1


# The typed load of own field k: its working value when the method being emitted has one (l2_work_mi), else its cell.
fn: l2_own_load (int: k; @: L2Tx dest) int
    []: char nm 32
    if: l2_own_cached(l2_work_mi, k) != 0
        if: c.snprintf(nm, 32U, "l2_q%d", k) < 0
            return: 1
        return: l2_tx_set(dest, nm)
return: l2_own_cell_load(k, dest)

# The C type of a working value of own type ty that is a number, or 0.
fn: l2_own_num_ctype (int: ty) const: @: char
    if: ty = 0
        return: "int"
    if: ty = 1
        return: "char"
    if: ty = 2
        return: "size_t"
    if: ty = 3
        return: "unsigned"
    if: ty = 36
        return: "ulong"
return: 0

# The working value of own field k in the prologue: declared, loaded from its cell (at entry, Lingvamyxa spec 21.5),
# clean.
fn: l2_emit_work_decl (int: k) int
    []: char load_own 1024
    L2Tx: load_tx
    @: L2Tx load l2_tx_local(@ load_tx, load_own, 1024U)
    []: char dcl_own 1024
    L2Tx: dcl_tx
    @: L2Tx dcl l2_tx_local(@ dcl_tx, dcl_own, 1024U)
    []: char nm 32
    const: @(char cty) l2_own_num_ctype(l2_own_ty[k])
    if: l2_own_cell_load(k, load) != 0 || c.sprintf(nm, "l2_q%d", k) < 0
        return: 1
    # A number's cell is never empty where it is held: an empty one is a place a partial copy does not hold
    # (READ-FIELD-CLOSURE), and its read is refused, never read as nothing (Codex -28 review point 3).
    if: cty != 0
        return: (cast: (int) (c.fprintf(l2_out, "    %s: l2_q%d\n    if: l2_q%d_from[0] = 0\n        c.fprintf(c.stderr, \"lmx: invariant: own field %d reads an absent place\\n\")\n        c.abort()\n    l2_q%d: %s\n    int: l2_q%d_dirty 0\n", cty, k, k, k, k, load\data, k) < 0))
    if: l2_own_is_pointer(l2_own_ty[k]) = 0 || l2_pointer_decl_text(l2_oc_ft(l2_own_ty[k]), 0, nm, dcl) != 0
        return: 1
return: (cast: (int) (c.fprintf(l2_out, "    %s\n    l2_q%d: %s\n    int: l2_q%d_dirty 0\n", dcl\data, k, load\data, k) < 0))

# An admitted write of own field k's working value: the local and its mark.
fn: l2_own_work_store (int: k; const: @(char ind); const: @(char val)) int
    []: char txt_own 1024
    L2Tx: txt_tx
    @: L2Tx txt l2_tx_local(@ txt_tx, txt_own, 1024U)
    int: ty l2_own_ty[k]
    if: ty = 1
        return: (cast: (int) (c.fprintf(l2_out, "%sl2_q%d: (cast: (char) ((cast: (int) (%s)) & 255))\n%sl2_q%d_dirty: 1\n", ind, k, val, ind, k) < 0))
    if: l2_own_num_ctype(ty) != 0
        return: (cast: (int) (c.fprintf(l2_out, "%sl2_q%d: (%s)\n%sl2_q%d_dirty: 1\n", ind, k, val, ind, k) < 0))
    if: l2_own_is_pointer(ty) = 0 || l2_pointer_decl_text(l2_oc_ft(ty), 0, 0, txt) != 0
        return: 1
return: (cast: (int) (c.fprintf(l2_out, "%sl2_q%d: (cast: (%s) (%s))\n%sl2_q%d_dirty: 1\n", ind, k, txt\data, val, ind, k) < 0))

# THE PUBLICATION at a boundary (book §12, §14; Lingvamyxa spec 21.6): every own field of the method being emitted that
# has a working value, in forward field order (its rows' order).  A marked one is written into its cell -- the typed
# store, X1 when it fails -- and unmarked; a clean one is not written.  Outside a method's body (no working values)
# nothing is emitted.
fn: l2_emit_publish (const: @(char ind)) int
    int: k 0
    @: char deep 0
    []: char val 64
    if: l2_work_mi < 0 || ind = 0
        return: 0
    while: k < l2_own_n
        if: l2_own_cached(l2_work_mi, k) != 0
            if: deep = 0 && l2_bump_ind(ind, @ deep) != 0
                return: 1
            if: l2_own_ty[k] = 1 && c.sprintf(val, "(cast: (int) l2_q%d)", k) < 0
                return: 1
            if: l2_own_ty[k] != 1 && c.sprintf(val, "l2_q%d", k) < 0
                return: 1
            if: c.fprintf(l2_out, "%sif: l2_q%d_dirty != 0\n", ind, k) < 0
                return: 1
            if: l2_own_cell_store(l2_work_mi, k, deep, val) != 0 || c.fprintf(l2_out, "%sl2_q%d_dirty: 0\n%s---\n", deep, k, ind) < 0
                return: 1
        ---
        k: k + 1
    ---
return: 0

# The typed load of direct own field k's cell, spelled into dest.
fn: l2_own_cell_load (int: k; @: L2Tx dest) int
    int: ty l2_own_ty[k]
    []: char txt_own 256
    L2Tx: txt_tx
    @: L2Tx txt l2_tx_local(@ txt_tx, txt_own, 256U)
    []: char nm 96
    if: txt = 0
        return: 1
    if: ty = 0
        if: c.snprintf(nm, 96U, "lmx_int_value_known(l2_q%d_from[0])", k) < 0
            return: 1
        return: l2_tx_set(dest, nm)
    if: ty = 1
        if: c.snprintf(nm, 96U, "(cast: (char) lmx_char_value_known(l2_q%d_from[0]))", k) < 0
            return: 1
        return: l2_tx_set(dest, nm)
    if: ty = 2
        if: c.snprintf(nm, 96U, "lmx_size_value_known(l2_q%d_from[0])", k) < 0
            return: 1
        return: l2_tx_set(dest, nm)
    if: ty = 3
        if: c.snprintf(nm, 96U, "lmx_unsigned_value_known(l2_q%d_from[0])", k) < 0
            return: 1
        return: l2_tx_set(dest, nm)
    if: ty = 36
        if: c.snprintf(nm, 96U, "lmx_ulong_value_known(l2_q%d_from[0])", k) < 0
            return: 1
        return: l2_tx_set(dest, nm)
    if: l2_own_is_pointer(ty) != 0 && l2_pointer_decl_text(l2_oc_ft(ty), 0, 0, txt) != 0
        return: 1
    if: l2_own_is_slot(k) != 0
        if: c.snprintf(nm, 96U, ") l2_q%d_from[0])", k) < 0
            return: 1
        return: l2_tx_join(dest, "(cast: (", txt\data, nm, 0, 0)
    if: l2_own_is_pointer(ty) != 0
        if: c.snprintf(nm, 96U, ") lmx_pointer_value_known(l2_q%d_from[0]))", k) < 0
            return: 1
        return: l2_tx_join(dest, "(cast: (", txt\data, nm, 0, 0)
return: 1

# The address of direct own field k's cell, typed by the field (L2 §10: `@x` of a data field is its
# cell's address in the instance, stable for the instance's life) -- the same spelling l2_prep_addr
# gives an own field.
fn: l2_own_addr (int: k; @: L2Tx dest) int
    int: ty l2_own_ty[k]
    []: char txt_own 256
    L2Tx: txt_tx
    @: L2Tx txt l2_tx_local(@ txt_tx, txt_own, 256U)
    []: char nm 96
    if: txt = 0
        return: 1
    if: l2_own_is_array(ty) != 0
        if: l2_own_from_expr(k, txt) != 0
            return: 1
        return: l2_tx_join(dest, "(cast: (@: VoidArray) ", txt\data, "[0])", 0, 0)
    if: ty = 0
        if: c.snprintf(nm, 96U, "(cast: (@: int) l2_q%d_from[0])", k) < 0
            return: 1
        return: l2_tx_set(dest, nm)
    if: ty = 1
        if: c.snprintf(nm, 96U, "(cast: (@: char) l2_q%d_from[0])", k) < 0
            return: 1
        return: l2_tx_set(dest, nm)
    if: ty = 2
        if: c.snprintf(nm, 96U, "(cast: (@: size_t) l2_q%d_from[0])", k) < 0
            return: 1
        return: l2_tx_set(dest, nm)
    if: ty = 3
        if: c.snprintf(nm, 96U, "(cast: (@: unsigned) l2_q%d_from[0])", k) < 0
            return: 1
        return: l2_tx_set(dest, nm)
    if: ty = 36
        if: c.snprintf(nm, 96U, "(cast: (@: ulong) l2_q%d_from[0])", k) < 0
            return: 1
        return: l2_tx_set(dest, nm)
    if: c.snprintf(nm, 96U, ") l2_q%d_from[0])", k) < 0
        return: 1
    # A pointer field's cell is the address of its pointer.
    if: l2_own_is_pointer(ty) != 0 && l2_own_is_slot(k) = 0 && l2_pointer_decl_text(l2_oc_ft(ty), 1, 0, txt) = 0
        return: l2_tx_join(dest, "(cast: (", txt\data, nm, 0, 0)
    # An own Structure field is a slot that holds the Structure itself (-189 c3b-3): `@mo` is that
    # reference, the slot's value -- what l2_own_load gives the slot (D-53): its working value when it has one (§7b).
    if: l2_own_is_slot(k) != 0 && l2_own_cached(l2_work_mi, k) != 0
        return: l2_own_load(k, dest)
    if: l2_own_is_pointer(ty) != 0 && l2_own_is_slot(k) != 0 && l2_pointer_decl_text(l2_oc_ft(ty), 0, 0, txt) = 0
        return: l2_tx_join(dest, "(cast: (", txt\data, nm, 0, 0)
return: 1

# Store `val` into direct own field k -- its working value when it has one (§7b), else its cell: the typed store, X1
# when it fails. Every primitive store preserves its cell. The slot is bound first (the prelude has bound it already). A field
# declared for a parameter is bound from its first store on (l2_formal_row): its declaration line, whose value `val`
# was spelled before, while the name was still the argument (the argument's current value, book §12 keep(3) = 4).
fn: l2_own_store (int: mi; int: k; const: @(char ind); const: @(char val)) int
    if: k < 0 || ind = 0 || val = 0
        return: 1
    if: l2_own_bseq[k] = 0 && l2_own_formal(mi, k) >= 0
        l2_bseq_n: l2_bseq_n + 1
        l2_own_bseq[k]: l2_bseq_n
    ---
    # §7b: a field with a working value is written in the working value and marked; the cell waits for a boundary.
    if: mi = l2_work_mi && l2_own_cached(mi, k) != 0
        return: l2_own_work_store(k, ind, val)
return: l2_own_cell_store(mi, k, ind, val)

# The typed store of `val` into own field k's cell -- l2_own_store's cell half, and the publication's.
fn: l2_own_cell_store (int: mi; int: k; const: @(char ind); const: @(char val)) int
    const: @(char helper) 0
    []: char at 256
    if: k < 0 || ind = 0 || val = 0
        return: 1
    # An own Structure field binds its slot (-189 c3b-3); a pointer stores into its cell.
    if: l2_own_is_slot(k) != 0
        if: l2_own_slot_at(k, at) != 0
            return: 1
        return: (cast: (int) (c.fprintf(l2_out, "%sif: lmx_arena_ref_store(%s, (cast: (@: void) (%s))) != 0\n%s    c.fprintf(c.stderr, \"lmx: invariant: own field %d store failed\\n\")\n%s    c.abort()\n%s---\n", ind, at, val, ind, k, ind, ind) < 0))
    ---
    helper: l2_own_store_helper(l2_own_ty[k])
    if: helper = 0
        return: 1
    if: l2_emit_own_from(mi, k, ind) != 0
        return: 1
    if: l2_own_is_pointer(l2_own_ty[k]) != 0
        return: (cast: (int) (c.fprintf(l2_out, "%sif: lmx_pointer_store_known(l2_q%d_from[0], (cast: (@: void) (%s))) != 0\n%s    c.fprintf(c.stderr, \"lmx: invariant: own field %d store failed\\n\")\n%s    c.abort()\n%s---\n", ind, k, val, ind, k, ind, ind) < 0))
    ---
return: (cast: (int) (c.fprintf(l2_out, "%sif: %s(l2_q%d_from[0], (%s)) != 0\n%s    c.fprintf(c.stderr, \"lmx: invariant: own field %d store failed\\n\")\n%s    c.abort()\n%s---\n", ind, helper, k, val, ind, k, ind, ind) < 0))

fn: l2_emit_own_from (int: mi; int: oi; const: @(char ind)) int
    []: char l2_eof_expr_own 128
    L2Tx: l2_eof_expr_tx
    @: L2Tx l2_eof_expr l2_tx_local(@ l2_eof_expr_tx, l2_eof_expr_own, 128U)
    if: mi < 0 || oi < 0 || ind = 0
        return: 0
    if: l2_own_from_expr(oi, l2_eof_expr) != 0
        return: 1
    if: c.fprintf(l2_out, "%sif: l2_q%d_from = 0\n%s    l2_q%d_from: %s\n%sif: l2_q%d_from = 0\n%s    c.fprintf(c.stderr, \"lmx: invariant: own field %d has no cell\\n\")\n%s    c.abort()\n", ind, oi, ind, oi, l2_eof_expr\data, ind, oi, ind, oi, ind) < 0
        return: 1
return: 0

fn: l2_collect_asgn_body (const: @(LmP0Structure body); int: mi; const: @(char path)) int
    L2Address: receiver_place
    @: LmP0Field field
    @: LmP0Field nxt
    @: LmP0Field last
    @: LmP0Node stmt
    const: @: LmP0Frame fr
    @: LmP0Text fa
    @: LmP0Text cmodel
    int: n
    int: k
    int: j
    int: cj
    int: letni
    int: retained
    int: rbm
    if: body = 0 || mi < 0
        return: 0
    field: l2_next_active(body\first_field)
    while: field != 0
        stmt: field\value
        l2_vis_stmt(mi, stmt)
        retained: l2_ns_constructed_row(mi, stmt)
        if: retained = -2
            return: 1
        if: retained >= 0
            field: l2_next_active(field\next)
            continue
        if: l2_frame_head(stmt, "catch")
            if: l2_catch_body(stmt) != 0
                if: l2_scope_push(stmt) != 0
                    return: l2_alloc_or(path, stmt, "out of memory")
                if: l2_collect_asgn_body(l2_catch_body(stmt), mi, path) != 0
                    l2_scope_pop()
                    return: 1
                l2_scope_pop()
            ---
            field: l2_next_active(field\next)
            continue
        # An anonymous `---` block is a nested executable body, like an if body (§14, Q14 K).
        if: stmt != 0 && stmt\kind = c.LM_P0_NODE_STRUCTURE && stmt\as != 0 && stmt\as\structure != 0
            if: l2_scope_push(stmt) != 0
                return: l2_alloc_or(path, stmt, "out of memory")
            if: l2_collect_asgn_body(stmt\as\structure, mi, path) != 0
                l2_scope_pop()
                return: 1
            l2_scope_pop()
            field: l2_next_active(field\next)
            continue
        # K03 NS-ROLES-1 (Codex K03-S5-MIGRATION-20261007-06 (b); docs/LMX_semantics.en.md:666): the absent-b reference
        # binding `b: A` (l2_ref_bind_site) is kept here, before any reader of the statement, and declares b as the
        # reference `@: M b A` would (l2_rb_declaration) -- the reference rows below take it; a binding to a method
        # holds its occurrence (NS-ROLES-1b).  A reference to a merge result or to a held callable is not built yet: said
        # at A.
        k: l2_ref_bind_site(stmt, mi, @ fa, @ rbm)
        # K03 NS-ROLES-2: a named Structure's body made its bindings fields when it was taken (l2_ns_bind_item); its
        # procedure reads the same statement at its site -- the two readings agree, never taken silently.
        if: l2_m_nsof(mi) >= 0 && l2_scope_host() = 0 && l2_ns_bind_agrees(mi, stmt, k, fa) = 0
            return: l2_error(path, stmt, "internal: a named Structure's field and its procedure disagree about a reference binding")
        if: k = 5 && l2_rb_add(stmt, fa, -2) != 0
            return: l2_alloc_or(path, stmt, "out of memory")
        if: k = 4 && l2_rb_add(stmt, fa, -1) != 0
            return: l2_alloc_or(path, stmt, "out of memory")
        if: k = 2 && l2_rb_add(stmt, fa, rbm) != 0
            return: l2_alloc_or(path, stmt, "out of memory")
        if: k = 6 && l2_rb_add_own(stmt, fa, rbm) != 0
            return: l2_alloc_or(path, stmt, "out of memory")
        if: k = 8
            return: l2_error(path, l2_ref_tail_node(stmt), "a reference binding to a held callable is not built yet")
        if: k = 7
            return: l2_error(path, stmt, "internal: the unit role and the site disagree about a reference binding")
        # A merge declares an ordinary Structure slot. Its schema is recorded
        # separately, keyed by this exact declaration row, never by spelling.
        if: l2_merge_declaration(body, stmt, mi) != 0
            if: l2_own_add(mi, stmt\as\frame\head, l2_graph_own(), path, stmt) < 0
                return: 1
            field: l2_next_active(field\next)
            continue
        # A method's own named Structure (OPUS-Q54-CONTINUE-20260929-14 2b): its type, local to mi, and S, its own
        # field typed by it -- here, before the method's names are read (l2_dyn_local), so that a later read of S
        # finds the field and never makes S a dynamic input.
        # The walked root's typed reference `@: T r`, T a named Structure (OPUS-CALLABLE-STRUCT-BINDING-20260929-16): an own
        # field of the unit typed by T -- declared by `@`, so a pointer cell, not a slot (q26) -- as the walked root has no
        # machine locals.
        if: l2_root_ref_ns(mi, stmt, @ fa) >= 0
            cj: l2_own_add(mi, fa, l2_graph_own(), path, stmt)
            if: cj < 0
                return: 1
            if: l2_own_nsty_set(cj, l2_root_ref_ns(mi, stmt, @ fa)) != 0
                return: 1
            field: l2_next_active(field\next)
            continue
        if: l2_local_ns_shape(stmt, mi) != 0
            if: l2_local_ns_entry(stmt, mi, path) < 0
                return: 1
            cj: l2_own_add(mi, stmt\as\frame\head, l2_graph_own(), path, stmt)
            if: cj < 0
                return: 1
            if: l2_own_nsty_set(cj, l2_local_ns_entry(stmt, mi, path)) != 0
                return: 1
            field: l2_next_active(field\next)
            continue
        # A local model may only become available in this ordered declaration
        # pass. Its reference receiver still gets the ordinary physical own
        # row, not a machine-local alias or a second type/binding table.
        k: l2_own_decl_ty(stmt)
        if: l2_own_is_pointer(k) != 0 && l2_own_ref_decl(stmt, mi) < 0
            fa: l2_own_decl_name(stmt)
            cj: l2_own_add(mi, fa, l2_own_store_ty(k), path, stmt)
            if: cj < 0 || l2_own_off(mi, cj) = (cast: (size_t) -1)
                return: l2_alloc_or(path, stmt, "out of memory")
            l2_m_uses[l2_own_off(mi, cj)]: 1
            l2_m_own[mi]: l2_m_own[mi] + 1
            if: l2_bind_own(mi, cj, path, stmt) != 0
                return: 1
            field: l2_next_active(field\next)
            continue
        # receiveMessage: m declares m the same way (an own field of graph
        # type). receiveMessage: m Model (FABLE-SONNET-SEND-REF-20260925-172
        # commit 2) additionally types it to the synthesized letter model,
        # exactly as the colon-decl branch above types its own field --
        # cmodel is reused, the two branches never both match the same
        # statement. The bare (no-model) form stays untyped, unchanged: it is
        # admitted at run time into WHATEVER typed field it is later bound
        # to or assigned into (unit_admit_letter_formal.lm2 and its siblings
        # depend on this -- retyping it broke them, measured directly).
        if: l2_receive_msg_shape(stmt, @ fa, @ cmodel) = 0
            # K03 RECEIVE-OUTPUT: at a named Structure's top level too the name is the receiver's computed output, no
            # field of the Structure (q53.md:95-97; l2_own_mslot); in a block of the body it has the block's place.
            cj: l2_own_output_add(mi, fa, l2_graph_own(), path, stmt)
            if: cj < 0
                return: 1
            if: l2_receiver_output_place(stmt, mi, @ receiver_place) != 0
                return: l2_error(path, stmt, "internal: receiver output has no resolved storage place")
            cj: receiver_place.index
            if: cmodel != 0
                if: l2_letter_ns_for(cmodel, stmt, path, @ letni) != 0
                    return: 1
                if: l2_own_nsty_set(cj, letni) != 0
                    return: 1
                ---
            field: l2_next_active(field\next)
            continue
        if: l2_frame_head(stmt, "if")
            fr: stmt\as\frame
            n: l2_count_active(fr\body)
            last: l2_next_active(fr\body\first_field)
            k: 1
            while: k < n
                last: l2_next_active(last\next)
                k: k + 1
            if: last != 0 && last\value != 0 && last\value\kind = c.LM_P0_NODE_STRUCTURE
                if: l2_scope_push(last\value) != 0
                    return: l2_alloc_or(path, stmt, "out of memory")
                if: l2_collect_asgn_body(last\value\as\structure, mi, path) != 0
                    l2_scope_pop()
                    return: 1
                l2_scope_pop()
            nxt: l2_next_active(field\next)
            if: nxt != 0 && l2_frame_head(nxt\value, "else") && nxt\value\as != 0 && nxt\value\as\frame != 0
                if: l2_scope_push(nxt\value) != 0
                    return: l2_alloc_or(path, nxt\value, "out of memory")
                if: l2_collect_asgn_body(nxt\value\as\frame\body, mi, path) != 0
                    l2_scope_pop()
                    return: 1
                l2_scope_pop()
            if: nxt != 0 && l2_frame_head(nxt\value, "else")
                field: l2_next_active(nxt\next)
            if: nxt = 0 || l2_frame_head(nxt\value, "else") = 0
                field: nxt
            ---
        if: l2_frame_head(stmt, "while")
            fr: stmt\as\frame
            n: l2_count_active(fr\body)
            last: l2_next_active(fr\body\first_field)
            k: 1
            while: k < n
                last: l2_next_active(last\next)
                k: k + 1
            if: n >= 2 && last != 0 && last\value != 0 && last\value\kind = c.LM_P0_NODE_STRUCTURE
                if: l2_scope_push(last\value) != 0
                    return: l2_alloc_or(path, stmt, "out of memory")
                if: l2_collect_asgn_body(last\value\as\structure, mi, path) != 0
                    l2_scope_pop()
                    return: 1
                l2_scope_pop()
            field: l2_next_active(field\next)
        if: l2_frame_head(stmt, "for")
            if: l2_for_cstyle(stmt) = 0
                field: l2_next_active(field\next)
                continue
            if: l2_scope_push(stmt) != 0
                return: l2_alloc_or(path, stmt, "out of memory")
            last: l2_next_active(stmt\as\frame\body\first_field)
            k: 1
            while: k < 5
                last: l2_next_active(last\next)
                k: k + 1
            if: last != 0 && last\value != 0 && last\value\kind = c.LM_P0_NODE_STRUCTURE && l2_collect_asgn_body(last\value\as\structure, mi, path) != 0
                l2_scope_pop()
                return: 1
            l2_scope_pop()
            field: l2_next_active(field\next)
            continue
        # The store of a callable merge, `@: h f(a)`: the receiver declares h, which holds the node the call
        # returns (l2_receiver_call).
        if: l2_mad_store_stmt(stmt) != 0
            cj: l2_own_add(mi, l2_store_name(stmt), l2_graph_own(), path, stmt)
            if: cj < 0
                return: 1
            if: l2_own_off(mi, cj) = (cast: (size_t) -1)
                return: l2_error(path, stmt, "size overflow")
            if: l2_m_uses[l2_own_off(mi, cj)] = 0
                l2_m_uses[l2_own_off(mi, cj)]: 1
                l2_m_own[mi]: l2_m_own[mi] + 1
            ---
            field: l2_next_active(field\next)
            continue
        # A bare assignment prepares nothing (the author, bafca4c: assignment is not a declaration; a field exists only
        # where a declaration puts it).  Assigned to an argument's name -- a formal or a dynamic input -- it changes that
        # activation's value (the parameter) unless a same-name field declared in scope has bound the name; it binds no
        # field and publishes nothing (Q52: only the hidden input changes).
        if: l2_frame_head(stmt, "if") = 0 && l2_frame_head(stmt, "while") = 0 && l2_frame_head(stmt, "for") = 0 && l2_is_asgn(stmt, mi)
            field: l2_next_active(field\next)
        if: l2_frame_head(stmt, "if") = 0 && l2_frame_head(stmt, "while") = 0 && l2_frame_head(stmt, "for") = 0 && l2_is_asgn(stmt, mi) = 0
            field: l2_next_active(field\next)
return: 0

# Is method i a root whose fields other methods see by name: the entry, or the root procedure
# of a program part?
fn: l2_asgn_root (int: i) int
    int: k 0
    if: i = l2_e
        return: 1
    while: k < l2_part_n
        if: l2_part_ns != 0 && l2_part_ns[k] >= 0 && l2_ns_proc[l2_part_ns[k]] = i
            return: 1
        k: k + 1
    ---
return: 0

fn: l2_collect_asgn_method (int: i; const: @(char path)) int
    l2_vis_method(i)
    # A head that names an activation-local machine value is its use, not
    # a definition: the declaration roles below are classified against
    # this method's own machine locals, never another method's table.
    l2_ml_free()
    l2_ml_imported_only: 1
    if: l2_m_body[i] != 0 && l2_m_body[i]\as != 0 && l2_ml_collect(l2_m_body[i]\as\structure, i, path) != 0
        l2_ml_imported_only: 0
        return: 1
    l2_ml_imported_only: 0
    if: l2_m_body[i] != 0 && l2_m_body[i]\as != 0 && l2_collect_asgn_body(l2_m_body[i]\as\structure, i, path) != 0
        return: 1
return: 0

# The roots first, then the other methods in their order: a method's statement is classified
# with the declarations of the root it sees already collected.  The order among a method's own
# rows, and among a root's, is the order of their statements either way.
fn: l2_collect_asgn_binds (const: @(char path)) int
    int: i 0
    while: i < l2_m_n
        if: l2_asgn_root(i) != 0 && l2_collect_asgn_method(i, path) != 0
            return: 1
        i: i + 1
    ---
    i: 0
    while: i < l2_m_n
        if: l2_asgn_root(i) = 0 && l2_collect_asgn_method(i, path) != 0
            return: 1
        i: i + 1
    ---
    l2_vis_on: 0
return: 0

fn: l2_bind_own (int: mi; int: oi; const: @(char path); const: @(LmP0Node at)) int
    int: fi
    @: L2Declaration declaration
    if: mi < 0 || oi < 0
        return: 0
    declaration: l2_declaration(l2_own_decl[oi])
    # This is input-materialization metadata only. The source site's checker
    # admits the preceding binding; explicit candidates and pointer defaults
    # are independent of a same-name input.
    if: declaration = 0 || declaration\candidate_count != 0 || l2_own_is_pointer(l2_own_ty[oi]) != 0
        return: 0
    fi: l2_param_find(mi, l2_own_name[oi])
    if: fi >= 0
        l2_m_alias[l2_own_off(mi, oi)]: fi
return: 0

fn: l2_collect_decls (const: @(LmP0Structure body); int: mi; const: @(char path); int: depth; @: int sn) int
    @: L2Declaration declaration
    @: LmP0Field field
    @: LmP0Field nxt
    @: LmP0Field last
    @: LmP0Node stmt
    @: LmP0Text fa
    int: j
    int: n
    int: ty
    int: retained
    int: rbm
    if: body = 0 || sn = 0
        return: 0
    field: l2_next_active(body\first_field)
    while: field != 0
        stmt: field\value
        l2_vis_stmt(mi, stmt)
        retained: l2_ns_constructed_row(mi, stmt)
        if: retained = -2
            return: 1
        # K03 NS-ROLES-1: the root's reference binding `b: A` (l2_ref_bind_site) is kept before the root's rows are made
        # here, so that its row is made as every reference declaration's is (l2_rb_declaration, l2_own_decl_ty).  E is
        # made after every Structure it may name is registered; a method's binding is kept by its collection
        # (l2_collect_asgn_body), which comes after that too.
        if: mi = l2_e
            j: l2_ref_bind_site(stmt, mi, @ fa, @ rbm)
            if: j = 5 && l2_rb_add(stmt, fa, -2) != 0
                return: l2_alloc_or(path, stmt, "out of memory")
            if: j = 4 && l2_rb_add(stmt, fa, -1) != 0
                return: l2_alloc_or(path, stmt, "out of memory")
            if: j = 2 && l2_rb_add(stmt, fa, rbm) != 0
                return: l2_alloc_or(path, stmt, "out of memory")
            if: j = 6 && l2_rb_add_own(stmt, fa, rbm) != 0
                return: l2_alloc_or(path, stmt, "out of memory")
        ---
        if: retained >= 0 && l2_nsf_kind[retained] = 2
            # A named constructor binds the already allocated child in its
            # owner's source slot. It neither copies nor executes that body.
            j: l2_own_add(mi, l2_nsf_fname[retained], l2_graph_own(), path, stmt)
            if: j < 0 || l2_own_nsty_set(j, l2_nsf_ref[retained]) != 0
                return: 1
            if: l2_own_off(mi, j) = (cast: (size_t) -1)
                return: l2_error(path, stmt, "size overflow")
            l2_m_uses[l2_own_off(mi, j)]: 1
            l2_m_own[mi]: l2_m_own[mi] + 1
            field: l2_next_active(field\next)
            continue
        # S1.3: a catch hosts its parameters; its handler is a nested body under it.
        if: l2_frame_head(stmt, "catch")
            if: l2_collect_catch(stmt, mi, path, depth, sn) != 0
                return: 1
            field: l2_next_active(field\next)
            continue
        # An anonymous `---` block is a nested executable body, like an if body (§14, Q14 K) --
        # unless it opens an expression run (l2_discard_run): an operand, not a block.
        if: stmt != 0 && stmt\kind = c.LM_P0_NODE_STRUCTURE && stmt\as != 0 && stmt\as\structure != 0 && l2_discard_run(field) > 0
            field: l2_next_active(field\next)
            continue
        if: stmt != 0 && stmt\kind = c.LM_P0_NODE_STRUCTURE && stmt\as != 0 && stmt\as\structure != 0
            if: l2_for_add(stmt, mi, l2_for_find(l2_scope_host()), 0) < 0 || l2_scope_push(stmt) != 0
                return: l2_alloc_or(path, stmt, "out of memory")
            if: l2_collect_decls(stmt\as\structure, mi, path, depth + 1, sn) != 0
                l2_scope_pop()
                return: 1
            l2_scope_pop()
            field: l2_next_active(field\next)
            continue
        if: l2_frame_head(stmt, "if")
            if: stmt\as\frame\body = 0
                return: l2_error(path, stmt, "unsupported body")
            n: l2_count_active(stmt\as\frame\body)
            last: l2_next_active(stmt\as\frame\body\first_field)
            j: 1
            while: j < n
                last: l2_next_active(last\next)
                j: j + 1
            if: last = 0 || last\value = 0 || last\value\kind != c.LM_P0_NODE_STRUCTURE || last\value\as = 0
                return: l2_error(path, stmt, "unsupported body")
            if: l2_for_add(last\value, mi, l2_for_find(l2_scope_host()), stmt) < 0 || l2_scope_push(last\value) != 0
                return: l2_alloc_or(path, stmt, "out of memory")
            if: l2_collect_decls(last\value\as\structure, mi, path, depth + 1, sn) != 0
                l2_scope_pop()
                return: 1
            l2_scope_pop()
            nxt: l2_next_active(field\next)
            if: nxt != 0 && l2_frame_head(nxt\value, "else")
                if: nxt\value\as\frame\body = 0
                    return: l2_error(path, nxt\value, "unsupported body")
                if: l2_for_add(nxt\value, mi, l2_for_find(l2_scope_host()), nxt\value) < 0 || l2_scope_push(nxt\value) != 0
                    return: l2_alloc_or(path, nxt\value, "out of memory")
                if: l2_collect_decls(nxt\value\as\frame\body, mi, path, depth + 1, sn) != 0
                    l2_scope_pop()
                    return: 1
                l2_scope_pop()
            if: nxt != 0 && l2_frame_head(nxt\value, "else")
                field: l2_next_active(nxt\next)
            if: nxt = 0 || l2_frame_head(nxt\value, "else") = 0
                field: nxt
            continue
        if: l2_frame_head(stmt, "while")
            if: stmt\as\frame\body = 0
                return: l2_error(path, stmt, "unsupported body")
            n: l2_count_active(stmt\as\frame\body)
            last: l2_next_active(stmt\as\frame\body\first_field)
            j: 1
            while: j < n
                last: l2_next_active(last\next)
                j: j + 1
            if: last = 0 || last\value = 0 || last\value\kind != c.LM_P0_NODE_STRUCTURE || last\value\as = 0
                return: l2_error(path, stmt, "unsupported body")
            if: l2_for_add(last\value, mi, l2_for_find(l2_scope_host()), stmt) < 0 || l2_scope_push(last\value) != 0
                return: l2_alloc_or(path, stmt, "out of memory")
            if: l2_collect_decls(last\value\as\structure, mi, path, depth + 1, sn) != 0
                l2_scope_pop()
                return: 1
            l2_scope_pop()
            field: l2_next_active(field\next)
            continue
        if: l2_frame_head(stmt, "for")
            if: l2_for_cstyle(stmt) = 0
                field: l2_next_active(field\next)
                continue
            if: l2_for_add(stmt, mi, l2_for_find(l2_scope_host()), stmt) < 0
                return: l2_error(path, stmt, "out of memory")
            if: l2_scope_push(stmt) != 0
                return: l2_alloc_or(path, stmt, "out of memory")
            nxt: l2_next_active(stmt\as\frame\body\first_field)
            if: nxt != 0 && l2_own_decl_ty(nxt\value) != 0
                ty: l2_own_decl_ty(nxt\value)
                if: l2_own_is_array(ty) != 0
                    l2_scope_pop()
                    return: l2_error(path, nxt\value, "unsupported own array declaration")
                fa: l2_next_active(nxt\value\as\frame\body\first_field)\value\as\atom
                j: l2_own_add(mi, fa, l2_own_store_ty(ty), path, nxt\value)
                if: j < 0
                    l2_scope_pop()
                    return: 1
                if: l2_own_off(mi, j) = (cast: (size_t) -1)
                    l2_scope_pop()
                    return: l2_error(path, nxt\value, "size overflow")
                l2_m_uses[l2_own_off(mi, j)]: 1
                l2_m_own[mi]: l2_m_own[mi] + 1
                if: l2_bind_own(mi, j, path, nxt\value) != 0
                    l2_scope_pop()
                    return: 1
                ---
            nxt: l2_next_active(nxt\next)
            nxt: l2_next_active(nxt\next)
            nxt: l2_next_active(nxt\next)
            nxt: l2_next_active(nxt\next)
            if: nxt != 0 && nxt\value != 0 && nxt\value\kind = c.LM_P0_NODE_STRUCTURE && nxt\value\as != 0 && l2_collect_decls(nxt\value\as\structure, mi, path, depth + 1, sn) != 0
                l2_scope_pop()
                return: 1
            l2_scope_pop()
            field: l2_next_active(field\next)
            continue
        if: l2_frame_head(stmt, "[]") && (l2_own_array_count(stmt) = 0 || depth != l2_scope_n)
            return: l2_error(path, stmt, "unsupported own array declaration")
        if: l2_frame_head(stmt, "if") = 0 && l2_unimpl_numeric(stmt) != 0
            return: l2_error(path, stmt, l2_unimpl_numeric(stmt))
        if: l2_frame_head(stmt, "if") = 0 && l2_own_decl_ty(stmt) != 0 && depth > 0 && l2_scope_n = 0
            return: l2_error(path, stmt, "unsupported own declaration")
        if: l2_frame_head(stmt, "if") = 0 && l2_own_decl_ty(stmt) != 0 && (depth = 0 || l2_scope_n != 0)
            ty: l2_own_decl_ty(stmt)
            fa: l2_own_decl_name(stmt)
            j: l2_own_add(mi, fa, l2_own_store_ty(ty), path, stmt)
            if: j < 0
                return: 1
            if: l2_own_is_array(ty) != 0
                if: l2_own_count[j] != 0
                    return: l2_error(path, stmt, "duplicate own array declaration")
                l2_own_count[j]: l2_own_array_count(stmt)
            ---
            if: l2_own_off(mi, j) = (cast: (size_t) -1)
                return: l2_error(path, stmt, "size overflow")
            l2_m_uses[l2_own_off(mi, j)]: 1
            l2_m_own[mi]: l2_m_own[mi] + 1
            if: l2_bind_own(mi, j, path, stmt) != 0
                return: 1
            declaration: l2_declaration(stmt)
            if: declaration != 0 && declaration\candidate_count = 1
                last: declaration\candidate
                if: last != 0 && last\value != 0 && last\value\kind = c.LM_P0_NODE_ATOM && l2_check_literal_kind(last\value\as\atom, l2_lit_kind_from_own(ty), path, stmt) != 0
                    return: 1
                ---
            ---
            field: l2_next_active(field\next)
        # K03 S6: `@: char x` and `@: size_t x` are own pointer declarations (l2_own_decl_ty: l2_contract_own's pointer
        # code, never 0); the two slot arms that read them when it was 0 were unreachable and are gone -- no declaration
        # registers a slot.
        if: l2_frame_head(stmt, "if") = 0 && l2_own_decl_ty(stmt) = 0
            field: l2_next_active(field\next)
return: 0

fn: l2_name_before (const: @(LmP0Text a); const: @(LmP0Text b)) int
    size_t: n
    if: a = 0 || b = 0 || a\data = 0 || b\data = 0
        return: 0
    n: a\length
    if: b\length < n
        n: b\length
    if: memcmp(a\data, b\data, n) < 0
        return: 1
    if: memcmp(a\data, b\data, n) > 0
        return: 0
    if: a\length < b\length
        return: 1
return: 0

fn: l2_dyn_add (int: mi; const: @(LmP0Text t); int: ty) int
    int: k
    int: i
    @: LmP0Text saved
    if: mi < 0 || t = 0
        return: 0
    if: l2_formal_find(mi, t) >= 0
        return: 0
    k: l2_dyn_find(mi, t)
    if: k >= 0
        if: ty != 0 && l2_dt(mi, k) != 0 && l2_dt(mi, k) != ty
            return: 1
        if: ty != 0 && l2_dt_set(mi, k, ty) != 0
            return: 1
        return: 0
    if: l2_m_dyn[mi] >= c.INT_MAX
        l2_alloc_err: 2
        return: 1
    if: l2_hidden_reserve(mi, l2_m_dyn[mi] + 1) != 0
        return: 1
    # The table owns its Text view, not the original source bytes. Prefix
    # views may be machine locals, but their bytes belong to the live P0
    # document. Preserve that byte identity for exact source diagnostics.
    l2_alloc_kind: 5
    saved: (cast: (@: LmP0Text) l2_xmalloc(c.sizeof(c.LmP0Text)))
    if: saved = 0
        return: 1
    saved\data: t\data
    saved\length: t\length
    i: l2_m_dyn[mi]
    while: i > 0 && l2_name_before(t, l2_dn(mi, i - 1))
        if: l2_dn_set(mi, i, l2_dn(mi, i - 1)) != 0
            return: 1
        if: l2_dt_set(mi, i, l2_dt(mi, i - 1)) != 0
            return: 1
        i: i - 1
    if: l2_dn_set(mi, i, saved) != 0
        return: 1
    if: l2_dt_set(mi, i, ty) != 0
        return: 1
    l2_m_dyn[mi]: l2_m_dyn[mi] + 1
return: 0

# The root of a frame head `name\f` in any method, as l2_scan_path_root reads it in a callable merge's model.  In
# value position the root is an atom of its own and l2_scan_ident meets it; a head is one text, so a method that
# only writes through a name (`box\v: 3`) did not read the name: a free one was no input of the method, and the
# write went to whichever declaration of that spelling the path's resolution found.  The root is read as that
# atom would be.
fn: l2_scan_head_root (int: mi; const: @(LmP0Text t); @: int seen) int
    size_t: e 0U
    LmP0Text: root
    if: mi < 0 || t = 0 || t\data = 0
        return: 0
    while: e < t\length && t\data[e] != 92
        e: e + 1U
    ---
    if: e = 0U || e >= t\length
        return: 0
    root.data: t\data
    root.length: e
    if: l2_ident(@ root) = 0
        return: 0
return: l2_scan_ident(mi, @ root, seen)

fn: l2_scan_ident (int: mi; const: @(LmP0Text t); @: int seen) int
    int: oi
    int: ty
    int: levels
    LmP0Text: base
    if: l2_deref_name(t, @ base, @ levels) = 0
        return: l2_scan_ident(mi, @ base, seen)
    # Item 738: a frame head `name\f` in a callable merge's model -- an update through a capture.
    if: mi >= 0 && t != 0 && l2_ident(t) = 0 && l2_mad_host_of(mi) >= 0
        return: l2_scan_path_root(mi, t, seen)
    if: mi >= 0 && t != 0 && l2_ident(t) = 0
        return: l2_scan_head_root(mi, t, seen)
    if: mi < 0 || t = 0 || l2_ident(t) = 0
        return: 0
    if: l2_formal_find(mi, t) >= 0
        return: 0
    if: l2_slot_find(mi, t) >= 0
        return: 0
    if: l2_site_method(mi, t) >= 0
        return: 0
    if: l2_ml_find(t) >= 0
        return: 0
    # A unit-level declaration or a bound merge result is a name IN SCOPE,
    # reached through the program unit. It is not a free name, so it must
    # not become an untyped dynamic input.
    if: l2_ns_find(t) >= 0 && l2_ns_parent[l2_ns_find(t)] < 0
        return: 0
    # K02c: a merge result bound in THIS scope -- the method's own, or a local the site sees -- is in scope.  The
    # UNIT's merge result seen from a method is a free name like any other unit field (Q52, below): the caller's
    # binding first, then an inherited input, then the unit's; its schema travels with it (l2_input_schema).
    oi: l2_resolved_own(mi, t)
    if: oi >= 0 && l2_mres_of_own(oi) >= 0 && l2_own_unit_seen(oi, mi) = 0
        return: 0
    if: l2_is_known(t)
        return: 0
    if: l2_text_eq(t, "return") || l2_text_eq(t, "if") || l2_text_eq(t, "else") || l2_text_eq(t, "while") || l2_text_eq(t, "for") || l2_text_eq(t, "continue") || l2_text_eq(t, "break") || l2_text_eq(t, "fn") || l2_text_eq(t, "sub") || l2_text_eq(t, "end") || l2_text_eq(t, "node") || l2_prim_type_word(t) || l2_text_eq(t, "length") || l2_text_eq(t, "sizeof") || l2_text_eq(t, "cast")
        return: 0
    if: t\length >= 2U && t\data[0] = 99 && t\data[1] = 46
        return: 0
    # K03 (the author, 2026-10-06): a word of the language the site does not bind -- `merge`, `table`, `catch` -- is its
    # own application, consumed by its contract (l2_head_resolve); it is never a free input of the method.
    if: l2_head_word(t) != 0 && l2_head_resolve(mi, t, 0, 0) = 1
        return: 0
    oi: l2_own_visible(mi, t)
    # A probe (l2_head_read_before) asks whether its name is read here as a free name; it makes nothing.
    if: l2_hr_on != 0
        if: oi < 0 && l2_define_name(t) = 0 && l2_text_same(t, l2_hr_name) != 0
            l2_hr_hit: 1
        return: 0
    # Q52 (the author: «нет видимого поля "y" у структуры "s" ... поля такого нет (потому что объявление не там)»;
    # «0 — меняется лишь скрытый вход s»): a field of the unit that a method sees is not the method's -- its name is a
    # hidden input of the method, the caller's current value handed over at the call (book :1182); a bare write changes
    # only that activation's value.  A type with no value cell (an Array) cannot travel as an input: it stays the place
    # it is declared at, read and written there.  A named Structure's procedure too: a procedure without arguments,
    # «that is, a procedure with hidden arguments» (the author, 2026-09-28, OPUS-CODEX-20260928-08).
    if: oi >= 0 && l2_own_unit_seen(oi, mi) != 0 && l2_dt_of_own(l2_own_ty[oi]) != 0
        return: l2_dyn_add(mi, t, l2_dt_of_own(l2_own_ty[oi]))
    if: oi >= 0 && l2_own_unit_seen(oi, mi) != 0
        if: l2_own_off(mi, oi) = (cast: (size_t) -1)
            return: 1
        if: l2_m_uses[l2_own_off(mi, oi)] = 0
            l2_m_own[mi]: l2_m_own[mi] + 1
        l2_m_uses[l2_own_off(mi, oi)]: 1
        return: 0
    if: oi >= 0 && l2_m_uses[l2_own_off(mi, oi)] != 0 && l2_dt_of_own(l2_own_ty[oi]) != 0 && (seen = 0 || seen[oi] = 0)
        l2_m_pre[l2_own_off(mi, oi)]: 1
        ty: l2_dt_of_own(l2_own_ty[oi])
        return: l2_dyn_add(mi, t, ty)
    if: oi >= 0 && l2_m_uses[l2_own_off(mi, oi)] != 0
        return: 0
    if: l2_define_name(t) != 0
        return: 0
    # T6b: a name of the host's activation -- a formal, or a field the host declares at method
    # level -- is a capture of this model, recorded here, where it resolves, with its type.  Its
    # value at the return becomes an own field of the node the return builds.  A numeric value
    # is captured (l2_mcap_ty_ok); any other is left unrecorded, and the walk of the model
    # refuses it, located.
    # Item 738: a Structure of a named type -- the host's formal or its own field -- is captured as a
    # copy of the fields the model reads (steps/capture-738.md), its type kept with it.
    # A3 (Codex, 2026-09-28): the capture is a hidden input of the nested method -- a host's direct call passes the
    # host's current value, the node the host's return builds passes the value it copied there (l2_mad_emit,
    # l2_emit_mad_call); the l2_mcap_* record says the input is the host's name.
    if: l2_mad_host_of(mi) >= 0 && l2_formal_find(l2_mad_host_of(mi), t) >= 0
        ty: l2_own_ty_of_param(l2_ft(l2_mad_host_of(mi), l2_formal_find(l2_mad_host_of(mi), t)))
        if: l2_nsty_get(l2_mad_host_of(mi), l2_formal_find(l2_mad_host_of(mi), t)) >= 0
            if: l2_mcap_add(mi, t, ty, l2_nsty_get(l2_mad_host_of(mi), l2_formal_find(l2_mad_host_of(mi), t))) != 0
                return: 1
            return: l2_cap_dyn_add(mi, t, ty, 1)
        if: l2_mcap_ty_ok(ty) != 0
            if: l2_mcap_add(mi, t, ty, 0 - 1) != 0
                return: 1
            return: l2_cap_dyn_add(mi, t, ty, 0)
        return: 0
    if: l2_mad_host_of(mi) >= 0 && l2_mad_host_own(l2_mad_host_of(mi), t) >= 0
        ty: l2_own_ty[l2_mad_host_own(l2_mad_host_of(mi), t)]
        if: l2_own_capture_ns(l2_mad_host_own(l2_mad_host_of(mi), t)) >= 0
            if: l2_mcap_add(mi, t, ty, l2_own_capture_ns(l2_mad_host_own(l2_mad_host_of(mi), t))) != 0
                return: 1
            return: l2_cap_dyn_add(mi, t, ty, 1)
        if: l2_mcap_ty_ok(ty) != 0
            if: l2_mcap_add(mi, t, ty, 0 - 1) != 0
                return: 1
            return: l2_cap_dyn_add(mi, t, ty, 0)
        return: 0
    if: l2_mad_host_of(mi) >= 0
        return: l2_error(l2_src, l2_m_node[mi], "a callable merge binds a name that is not a formal")
    if: l2_dyn_add(mi, t, 0) != 0
        return: 1
return: 0

# The formal of the callee -- method idx, or else held callable held -- that a Frame among a call's actuals
# names, as l2_bind_actuals reads the actuals; -1 when f names none.
fn: l2_actual_formal (@: LmP0Field f; int: idx; int: held) int
    @: LmP0Frame fr
    int: nf 0
    int: k 0
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_FRAME || f\value\as = 0 || f\value\as\frame = 0 || f\value\as\frame\head = 0
        return: -1
    fr: f\value\as\frame
    if: idx >= 0
        nf: l2_m_arity[idx]
    if: idx < 0 && held >= 0
        nf: l2_mad_held_formals(held)
    while: k < nf
        if: idx >= 0 && l2_payload_same(fr\head, l2_fn(idx, k)) != 0
            return: k
        if: idx < 0 && l2_payload_same(fr\head, l2_mad_held_arg_name(held, k)) != 0
            return: k
        k: k + 1
    ---
return: -1

# The actuals of call, a Frame with a body, as the scan reads them: once l2_bind_calls has bound the call, its
# projection (l2_call_actuals).  A probe (l2_head_read_before) runs at collection, before any call is bound,
# and reads a call as its binding will (l2_bind_actuals): a Frame among the actuals whose head names a formal
# of the callee is that formal's argument -- its head the formal's label, its body the value.
fn: l2_scan_actuals (const: @(LmP0Node call); int: mi; @: int seen) int
    @: LmP0Structure body
    @: LmP0Field f
    int: idx
    int: held -1
    int: fi 0
    int: span
    int: named
    body: call\as\frame\body
    if: l2_hr_on = 0 || l2_bound_find(body) >= 0
        return: l2_scan_fields(l2_call_actuals(body), l2_call_actual_fields(body), mi, seen)
    idx: l2_call_head_method(mi, call\as\frame\head, @ fi)
    if: idx = l2_e
        idx: -1
    if: idx < 0
        held: l2_call_head_held(mi, call\as\frame\head)
    f: l2_next_active(body\first_field)
    while: f != 0
        span: l2_expr_span(f)
        if: span < 1
            span: 1
        named: -1
        if: span = 1
            named: l2_actual_formal(f, idx, held)
        if: named >= 0 && f\value\as\frame\body != 0 && l2_scan_fields(f\value\as\frame\body\first_field, l2_count_active(f\value\as\frame\body), mi, seen) != 0
            return: 1
        if: named < 0 && l2_scan_fields(f, span, mi, seen) != 0
            return: 1
        f: l2_skip_span(f, span)
    ---
return: 0

fn: l2_scan_node (const: @(LmP0Node node); int: mi; @: int seen) int
    @: LmP0Field f
    int: n
    int: oi
    int: span
    int: indexed
    l2_here_at_method(mi, node)
    if: node = 0
        return: 0
    if: node\kind = c.LM_P0_NODE_ATOM
        return: l2_scan_ident(mi, node\as\atom, seen)
    if: node\kind = c.LM_P0_NODE_STRUCTURE && node\as != 0 && node\as\structure != 0
        f: node\as\structure\first_field
        n: l2_count_active(node\as\structure)
        return: l2_scan_fields(f, n, mi, seen)
    # A sizeof type operand is type syntax even if its resolution will fail.
    # It cannot introduce a hidden value input; ordinary sizeof(name) can.
    if: l2_sizeof_is_type(node) != 0
        return: 0
    # In @: name the head is syntax and the single atom is a value. Resolve an
    # own field here before the generic structural-word filter, so a legitimate
    # field called count/data/next remains addressable.
    if: node\kind = c.LM_P0_NODE_FRAME && l2_frame_head(node, "@") && node\as\frame\body != 0 && l2_count_active(node\as\frame\body) = 1
        f: l2_next_active(node\as\frame\body\first_field)
        if: f != 0 && f\value != 0 && f\value\kind = c.LM_P0_NODE_ATOM
            oi: l2_own_visible(mi, f\value\as\atom)
            if: oi >= 0 && l2_own_unit_seen(oi, mi) != 0 && l2_hr_on != 0
                return: 0
            if: oi >= 0 && l2_own_unit_seen(oi, mi) != 0
                if: l2_m_uses[l2_own_off(mi, oi)] = 0
                    l2_m_own[mi]: l2_m_own[mi] + 1
                l2_m_uses[l2_own_off(mi, oi)]: 1
                return: 0
            ---
        ---
    # implements(candidate, required, consumer) is decided at translation from
    # declarations; its head and operands are not lexical references either.
    if: node\kind = c.LM_P0_NODE_FRAME && l2_frame_head(node, "implements")
        return: 0
    # A cast contributes only its operand to lexical free-name analysis. The
    # head and its first field name a language operation and a C type.
    if: node\kind = c.LM_P0_NODE_FRAME && l2_frame_head(node, "cast") && node\as\frame\body != 0 && l2_count_active(node\as\frame\body) >= 2
        f: l2_next_active(node\as\frame\body\first_field)
        f: l2_next_active(f\next)
        # A field/index expression may occupy several flat fields; the target
        # type is still not a lexical reference.
        if: l2_count_active(node\as\frame\body) > 2
            return: l2_scan_fields(f, l2_count_active(node\as\frame\body) - 1, mi, seen)
        return: l2_scan_node(f\value, mi, seen)
    if: node\kind = c.LM_P0_NODE_FRAME && node\as != 0 && node\as\frame != 0 && node\as\frame\body != 0
        oi: l2_find_method(node\as\frame\head)
        if: oi >= 0 && oi != l2_e
            if: l2_scan_ident(mi, node\as\frame\head, seen) != 0
                return: 1
            # A probe reads a call l2_bind_calls has not bound yet (l2_scan_actuals).
            if: l2_hr_on != 0 && l2_bound_find(node\as\frame\body) < 0
                return: l2_scan_actuals(node, mi, seen)
            # An empty Structure actual (D-23) has nothing to scan.  The actuals are
            # taken by formal coordinate: the projection.
            f: l2_next_active(l2_call_actuals(node\as\frame\body))
            n: 0
            while: f != 0
                span: l2_expr_span(f)
                if: span < 1
                    return: 1
                if: l2_empty_actual(f, oi, n) = 0 && l2_scan_fields(f, span, mi, seen) != 0
                    return: 1
                f: l2_skip_span(f, span)
                n: n + 1
            ---
            return: 0
        ---
        # A callable merge is not a free name. Its model and bindings are resolved by l2_pap_prepare.
        if: l2_frame_head(node, "merge") != 0
            return: 0
        ---
        indexed: l2_scan_index_head(node, mi, seen)
        if: indexed = 2
            return: 1
        if: indexed = 1 && l2_scan_ident(mi, node\as\frame\head, seen) != 0
            return: 1
        # A call of a callable formal arrives here: its actuals are its projection too.
        return: l2_scan_actuals(node, mi, seen)
return: 0

fn: l2_scan_index_head (const: @(LmP0Node node); int: mi; @: int seen) int
    int: status
    @: L2HeadExpression expression l2_head_expression(node, @ status)
    if: status = 2
        return: 2
    if: expression = 0
        return: 1
    if: l2_scan_fields(expression\body\first_field, l2_count_active(expression\body), mi, seen) != 0
        return: 2
return: 0

fn: l2_scan_fields (@: LmP0Field field; int: n; int: mi; @: int seen) int
    @: LmP0Field f
    @: LmP0Field nxt
    @: LmP0Field seg1
    int: i
    int: after 0
    int: run
    int: prefix 1
    @: LmP0Field operand_after l2_next_active(field)
    f: l2_next_active(field)
    i: 0
    while: i < n && f != 0
        nxt: l2_next_active(f\next)
        if: f = operand_after
            prefix: 1
            run: l2_operand_run(f, n - i)
            if: run < 1
                run: 1
            operand_after: l2_skip_span(f, run)
        if: after != 0 && f\value != 0 && f\value\kind = c.LM_P0_NODE_ATOM
            after: after - 1
            f: nxt
            i: i + 1
            continue
        # `node\name` in a nested method: a value of its host's body (book §3) -- a lexical use the node its host's
        # return builds carries (l2_scan_node_use), not a free name of the method.
        if: f\value != 0 && f\value\kind = c.LM_P0_NODE_ATOM && f\value\as != 0 && l2_text_eq(f\value\as\atom, "node") != 0 && nxt != 0 && nxt\value != 0 && nxt\value\kind = c.LM_P0_NODE_ATOM && nxt\value\as != 0 && l2_is_slash(nxt\value\as\atom)
            seg1: l2_next_active(nxt\next)
            if: seg1 != 0 && seg1\value != 0 && seg1\value\kind = c.LM_P0_NODE_ATOM && seg1\value\as != 0 && l2_scan_node_use(mi, seg1\value\as\atom) != 0
                return: 1
            ---
        if: prefix = 0 && f\value != 0 && f\value\kind = c.LM_P0_NODE_ATOM && l2_is_slash(f\value\as\atom)
            after: 1
            # A root-qualified occurrence index, `root\[N]name` (FABLE-SONNET-
            # OCC-ROOT-20260924-146): the 4 tokens after the slash ([, N, ],
            # name) are all part of one resolved path, none a bare name
            # reference a dynamic-input scan should register -- mirrors the
            # l2_check_fields/l2_emit_fields recognizer for the same shape.
            if: nxt != 0 && nxt\value != 0 && nxt\value\kind = c.LM_P0_NODE_ATOM && l2_text_eq(nxt\value\as\atom, "[") != 0
                after: 4
                ---
            ---
        if: f\value != 0 && (f\value\kind != c.LM_P0_NODE_ATOM || (l2_is_slash(f\value\as\atom) = 0 && l2_text_eq(f\value\as\atom, "@") = 0))
            prefix: 0
        if: l2_scan_node(f\value, mi, seen) != 0
            return: 1
        f: nxt
        i: i + 1
return: 0

# Scan the initializer from the same source-linked declaration contract used
# by checking and emission, including const wrappers and compound candidates.
fn: l2_scan_reference_init (const: @(LmP0Node stmt); int: mi; @: int seen) int
    @: L2Declaration declaration l2_declaration(stmt)
    if: declaration = 0
        return: 1
return: l2_scan_fields(declaration\candidate, declaration\candidate_count, mi, seen)

# A reached declaration binds this exact row. Receiver-declared names obey
# the same scan state as ordinary declarations, not an untyped hidden input.
fn: l2_scan_bound (int: mi; int: oi; @: int seen) int
    size_t: off
    if: l2_hr_on != 0
        return: 0
    if: oi < 0
        return: 1
    off: l2_own_off(mi, oi)
    if: off = (cast: (size_t) -1)
        return: 1
    if: l2_m_uses[off] = 0
        l2_m_own[mi]: l2_m_own[mi] + 1
    l2_m_uses[off]: 1
    if: seen != 0
        seen[oi]: 1
return: 0

fn: l2_scan_body (const: @(LmP0Structure body); int: mi; @: int seen) int
    @: L2Declaration declaration
    @: LmP0Text slnm 0
    int: slty 0
    @: LmP0Field field
    @: LmP0Field nxt
    @: LmP0Field last
    @: LmP0Node stmt
    const: @: LmP0Frame fr
    @: LmP0Text fa
    int: n
    int: k
    int: oi
    int: ty
    int: excluded
    int: scanned
    int: retained
    if: body = 0
        return: 0
    field: l2_next_active(body\first_field)
    while: field != 0
        stmt: field\value
        # A probe (l2_head_read_before) ends at the statement it asks about.
        if: l2_hr_on != 0 && stmt = l2_hr_stop
            l2_hr_done: 1
            return: 1
        l2_vis_stmt(mi, stmt)
        retained: l2_ns_constructed_row(mi, stmt)
        if: retained = -2
            return: 1
        if: retained >= 0
            field: l2_next_active(field\next)
            continue
        if: l2_mad_on(mi) != 0 && l2_frame_head(stmt, "fn") != 0
            field: l2_next_active(field\next)
            continue
        # An anonymous `---` block is a nested executable body, like an if body (§14, Q14 K); a closing `until` reads
        # its condition in the block's scope, after the body (l2_block_until).
        if: stmt != 0 && stmt\kind = c.LM_P0_NODE_STRUCTURE && stmt\as != 0 && stmt\as\structure != 0
            if: l2_scope_push(stmt) != 0
                return: 1
            if: l2_scan_body(stmt\as\structure, mi, seen) != 0
                l2_scope_pop()
                return: 1
            if: l2_block_until(stmt) != 0 && l2_scan_fields(l2_block_until(stmt)\first_field, l2_count_active(l2_block_until(stmt)), mi, seen) != 0
                l2_scope_pop()
                return: 1
            l2_scope_pop()
            field: l2_next_active(field\next)
            continue
        # A bare atom statement, or a statement line P0 gives as several fields (`y + 1`): one
        # expression (l2_expr_span), whose names are read as the same expression's are anywhere.
        if: stmt != 0 && stmt\kind = c.LM_P0_NODE_ATOM
            k: l2_expr_span(field)
            if: k < 1
                k: 1
            if: l2_scan_fields(field, k, mi, seen) != 0
                return: 1
            field: l2_skip_span(field, k)
            continue
        # sendMessage: X, or sendMessage: Ref X (FABLE-SONNET-SEND-REF-20260925-172 commit 3) --
        # the message is always the LAST active field; anything before it is the Ref expression,
        # scanned like any other (l2_scan_fields already skips a path run's own `\name` segments,
        # the same shape a Ref like m\sender has).  The message's name and its field names label
        # positions; only each field's value is an expression.
        if: stmt != 0 && l2_frame_head(stmt, "sendMessage") != 0 && stmt\as\frame\body != 0
            nxt: l2_next_active(stmt\as\frame\body\first_field)
            n: l2_count_active(stmt\as\frame\body)
            if: n > 1 && l2_scan_fields(stmt\as\frame\body\first_field, n - 1, mi, seen) != 0
                return: 1
            if: n > 1
                nxt: l2_skip_span(nxt, n - 1)
            ---
            if: nxt != 0 && nxt\value != 0 && nxt\value\kind = c.LM_P0_NODE_FRAME && nxt\value\as\frame\body != 0
                last: l2_next_active(nxt\value\as\frame\body\first_field)
                while: last != 0
                    if: last\value != 0 && last\value\kind = c.LM_P0_NODE_FRAME && last\value\as\frame\body != 0
                        if: l2_scan_fields(last\value\as\frame\body\first_field, l2_count_active(last\value\as\frame\body), mi, seen) != 0
                            return: 1
                        ---
                    ---
                    last: l2_next_active(last\next)
                ---
            ---
            field: l2_next_active(field\next)
            continue
        if: l2_merge_declaration(body, stmt, mi) != 0
            oi: l2_own_find_decl(mi, stmt\as\frame\head, stmt)
            excluded: l2_own_excl
            l2_own_excl: oi
            fr: l2_merge_frame(stmt)\as\frame
            scanned: l2_scan_fields(fr\body\first_field, l2_count_active(fr\body), mi, seen)
            l2_own_excl: excluded
            if: scanned != 0 || l2_scan_bound(mi, oi, seen) != 0
                return: 1
            field: l2_next_active(field\next)
            continue
        # `@: h f(a)` (l2_mad_store_stmt): h is declared here and read nowhere; the call is read as any call.
        if: l2_mad_store_stmt(stmt) != 0
            if: l2_scan_node(l2_receiver_call(stmt, 0), mi, seen) != 0 || l2_scan_bound(mi, l2_own_by_decl(mi, stmt), seen) != 0
                return: 1
            field: l2_next_active(field\next)
            continue
        # S1.2: a `throws:` list names exits, not values; a `throw:` references its payload.
        if: l2_frame_head(stmt, "throws")
            field: l2_next_active(field\next)
            continue
        if: l2_frame_head(stmt, "throw")
            if: l2_scan_throw_args(stmt, mi, seen) != 0
                return: 1
            field: l2_next_active(field\next)
            continue
        # S1.3: a catch's name is an exit and its parameters are declared and bound by the delivery
        # before its handler runs; the handler is scanned under the catch's scope.
        if: l2_frame_head(stmt, "catch")
            if: l2_catch_body(stmt) != 0
                if: l2_scope_push(stmt) != 0
                    return: 1
                if: l2_scan_catch_bound(stmt, mi, seen) != 0
                    l2_scope_pop()
                    return: 1
                if: l2_scan_body(l2_catch_body(stmt), mi, seen) != 0
                    l2_scope_pop()
                    return: 1
                l2_scope_pop()
            ---
            field: l2_next_active(field\next)
            continue
        # A source-defined local Structure is already collected. Its field
        # declarations are not free reads of this activation; bind the exact
        # collected row before scanning subsequent statements.
        if: l2_local_ns_shape(stmt, mi) != 0
            if: l2_scan_bound(mi, l2_own_find_decl(mi, stmt\as\frame\head, stmt), seen) != 0
                return: 1
            field: l2_next_active(field\next)
            continue
        # Existing receiver-declaration routes bind their already classified
        # names here.
        # `f()` with f resolving to nothing declares f (-132, l2_empty_struct_decl_shape, read here with this method's
        # locals, l2_ml_rebuild): its row made here too, so that a later read of f -- the bare `f`, its nullary call,
        # among them -- resolves to the field and never makes f a dynamic input.  The check pass's l2_own_add on the
        # same statement finds this row.
        if: l2_empty_struct_decl_shape(stmt, mi) != 0
            if: l2_hr_on = 0 && l2_scan_bound(mi, l2_own_add(mi, stmt\as\frame\head, l2_graph_own(), l2_src, stmt), seen) != 0
                return: 1
            field: l2_next_active(field\next)
            continue
        if: l2_receive_msg_shape(stmt, @ fa, 0) = 0
            if: l2_hr_on = 0 && l2_scan_bound(mi, l2_own_output_add(mi, fa, l2_graph_own(), l2_src, stmt), seen) != 0
                return: 1
            field: l2_next_active(field\next)
            continue
        # A pointer-local declaration is a TYPE and a name, neither of them a
        # reference. Without this the type atom itself is inferred as an
        # untyped dynamic input and the whole method is refused as an
        # "unresolved name" that names nothing the source wrote.
        if: l2_own_decl_ty(stmt) = 0 && l2_ptr_local_ty(stmt, @ slnm, @ slty) = 0
            if: l2_scan_reference_init(stmt, mi, seen) != 0
                return: 1
            field: l2_next_active(field\next)
            continue
        # The same for a const local: const: @(LmxMsg m) declares a cursor,
        # it does not reference LmxMsg.
        if: l2_own_decl_ty(stmt) = 0 && l2_const_local_ty(stmt, @ slnm, @ slty) = 0
            if: l2_scan_reference_init(stmt, mi, seen) != 0
                return: 1
            field: l2_next_active(field\next)
            continue
        # And for a function-pointer local: TYPE: d names a disposer type the
        # header declares. Fourth form of the same rule.
        if: l2_fnptr_local(stmt, @ slnm) = 0
            field: l2_next_active(field\next)
            continue
        if: l2_struct_local(stmt, @ slnm) = 0
            field: l2_next_active(field\next)
            continue
        if: l2_frame_head(stmt, "if")
            fr: stmt\as\frame
            n: l2_count_active(fr\body)
            last: l2_next_active(fr\body\first_field)
            k: 1
            while: k < n
                last: l2_next_active(last\next)
                k: k + 1
            if: l2_scan_fields(fr\body\first_field, n - 1, mi, seen) != 0
                return: 1
            if: last != 0 && last\value != 0 && last\value\kind = c.LM_P0_NODE_STRUCTURE
                if: l2_scope_push(last\value) != 0
                    return: 1
                if: l2_scan_body(last\value\as\structure, mi, seen) != 0
                    l2_scope_pop()
                    return: 1
                l2_scope_pop()
            nxt: l2_next_active(field\next)
            if: nxt != 0 && l2_frame_head(nxt\value, "else") && nxt\value\as != 0 && nxt\value\as\frame != 0
                if: l2_scope_push(nxt\value) != 0
                    return: 1
                if: l2_scan_body(nxt\value\as\frame\body, mi, seen) != 0
                    l2_scope_pop()
                    return: 1
                l2_scope_pop()
            if: nxt != 0 && l2_frame_head(nxt\value, "else")
                field: l2_next_active(nxt\next)
            if: nxt = 0 || l2_frame_head(nxt\value, "else") = 0
                field: nxt
            ---
        if: l2_frame_head(stmt, "while")
            fr: stmt\as\frame
            n: l2_count_active(fr\body)
            last: l2_next_active(fr\body\first_field)
            k: 1
            while: k < n
                last: l2_next_active(last\next)
                k: k + 1
            if: n >= 2 && l2_scan_fields(fr\body\first_field, n - 1, mi, seen) != 0
                return: 1
            if: n >= 2 && last != 0 && last\value != 0 && last\value\kind = c.LM_P0_NODE_STRUCTURE
                if: l2_scope_push(last\value) != 0
                    return: 1
                if: l2_scan_body(last\value\as\structure, mi, seen) != 0
                    l2_scope_pop()
                    return: 1
                l2_scope_pop()
            field: l2_next_active(field\next)
        if: l2_frame_head(stmt, "for")
            if: l2_for_cstyle(stmt) = 0
                field: l2_next_active(field\next)
                continue
            if: l2_scope_push(stmt) != 0
                return: 1
            last: l2_next_active(stmt\as\frame\body\first_field)
            # The candidate runs before this exact counter declaration becomes visible.
            # Later condition/step/body uses see it in the loop's lexical host.
            if: last != 0 && last\value != 0 && l2_own_decl_name(last\value) != 0
                declaration: l2_declaration(last\value)
                oi: l2_own_find_decl(mi, declaration\name, last\value)
                l2_here_at_method(mi, last\value)
                excluded: l2_own_excl
                l2_own_excl: oi
                scanned: l2_scan_fields(declaration\candidate, declaration\candidate_count, mi, seen)
                l2_own_excl: excluded
                if: scanned != 0
                    l2_scope_pop()
                    return: 1
                if: oi >= 0 && seen != 0
                    seen[oi]: 1
            ---
            last: l2_next_active(last\next)
            if: last != 0 && last\value != 0 && last\value\kind = c.LM_P0_NODE_STRUCTURE && l2_scan_fields(last\value\as\structure\first_field, l2_count_active(last\value\as\structure), mi, seen) != 0
                l2_scope_pop()
                return: 1
            last: l2_next_active(last\next)
            if: last != 0 && l2_scan_node(last\value, mi, seen) != 0
                l2_scope_pop()
                return: 1
            last: l2_next_active(last\next)
            last: l2_next_active(last\next)
            if: last != 0 && last\value != 0 && last\value\kind = c.LM_P0_NODE_STRUCTURE && l2_scan_body(last\value\as\structure, mi, seen) != 0
                l2_scope_pop()
                return: 1
            l2_scope_pop()
            field: l2_next_active(field\next)
            continue
        # A callable merge binds names; it does not read them as free inputs.
        if: l2_frame_head(stmt, "merge") != 0
            field: l2_next_active(field\next)
            continue
        ---
        if: l2_frame_head(stmt, "if") = 0 && l2_frame_head(stmt, "while") = 0 && l2_frame_head(stmt, "for") = 0 && l2_is_asgn(stmt, mi)
            # steps/free-names.md §7: the target is resolved as a read of it is (book :1182), and first, in reading
            # order -- a name no declaration of this body gives is read like any name, so a free one is a dynamic
            # input: a hidden argument of the callers, whose value the bare assignment changes in this activation only
            # (bafca4c; Q52) -- no field -- or unresolved if none binds it.  Not an empty-Structure body: `f()` whose head resolves to nothing
            # declares f (l2_empty_struct_decl_shape, -132).
            # A target this method does not declare -- nothing binds it, or it names a field of a Structure the method
            # sees, the unit or a part's root -- is read as any name is: l2_scan_ident makes such a unit field a hidden
            # input (Q52: «0 -- меняется лишь скрытый вход s»), so the write is the activation's, not the field's.
            # A method's own named Structure (l2_local_ns_shape) declares its head, as `f()` does, and its fields are
            # declarations: neither is read.
            if: stmt\as\frame\body != 0 && l2_count_active(stmt\as\frame\body) > 0 && l2_own_find_decl(mi, stmt\as\frame\head, stmt) < 0 && (l2_own_visible(mi, stmt\as\frame\head) < 0 || l2_own_mi[l2_own_visible(mi, stmt\as\frame\head)] != mi) && l2_local_ns_shape(stmt, mi) = 0 && l2_scan_ident(mi, stmt\as\frame\head, seen) != 0
                return: 1
            # The statement may be a call (`put(b: 1; a: 8)`): its actuals are its projection.
            if: stmt\as\frame\body != 0 && l2_local_ns_shape(stmt, mi) = 0 && l2_scan_actuals(stmt, mi, seen) != 0
                return: 1
            oi: l2_own_find_decl(mi, stmt\as\frame\head, stmt)
            # A target that became an argument's name (a formal or a hidden input) marks no field.
            if: oi < 0 && l2_param_find(mi, stmt\as\frame\head) < 0
                oi: l2_own_visible(mi, stmt\as\frame\head)
            ---
            if: l2_hr_on = 0 && oi >= 0 && l2_own_unit_seen(oi, mi) != 0
                if: l2_own_off(mi, oi) = (cast: (size_t) -1)
                    return: 1
                if: l2_m_uses[l2_own_off(mi, oi)] = 0
                    l2_m_own[mi]: l2_m_own[mi] + 1
                l2_m_uses[l2_own_off(mi, oi)]: 1
            ---
            if: oi >= 0 && seen != 0
                seen[oi]: 1
            field: l2_next_active(field\next)
        if: l2_frame_head(stmt, "if") = 0 && l2_frame_head(stmt, "while") = 0 && l2_frame_head(stmt, "for") = 0 && l2_is_asgn(stmt, mi) = 0 && l2_own_decl_ty(stmt) != 0
            # FABLE-SONNET-RECEIVE-RENAME-20260924-166 commit 3 (D-48): the check-time twin of
            # l2_emit_body's own-decl-line branch -- same Q24 fix, this statement's own row.
            fa: l2_own_decl_name(stmt)
            oi: l2_own_find_decl(mi, fa, stmt)
            # steps/free-names.md M1: the initializer is read before the declared name is bound, and its names are
            # reads as anywhere else -- a free one is a dynamic input of the method, as the pointer-local branch
            # below reads its own initializer.  Its own name reads the occurrence declared before it (Q24 = A,
            # D-48: l2_own_excl, as the emitter reads it).  An array declaration's fields are its element type, name
            # and count.
            declaration: l2_declaration(stmt)
            if: l2_own_array_count(stmt) = 0 && declaration != 0 && declaration\candidate_count > 0
                l2_own_excl: oi
                if: l2_scan_fields(declaration\candidate, declaration\candidate_count, mi, seen) != 0
                    l2_own_excl: 0 - 1
                    return: 1
                l2_own_excl: 0 - 1
            ---
            if: oi >= 0 && seen != 0
                seen[oi]: 1
            field: l2_next_active(field\next)
        if: l2_frame_head(stmt, "if") = 0 && l2_frame_head(stmt, "while") = 0 && l2_frame_head(stmt, "for") = 0 && l2_is_asgn(stmt, mi) = 0 && l2_own_decl_ty(stmt) = 0 && l2_is_char_decl(stmt)
            field: l2_next_active(field\next)
        if: l2_frame_head(stmt, "if") = 0 && l2_frame_head(stmt, "while") = 0 && l2_frame_head(stmt, "for") = 0 && l2_is_asgn(stmt, mi) = 0 && l2_is_char_decl(stmt) = 0
            if: stmt != 0 && stmt\as != 0 && stmt\as\frame != 0 && l2_scan_ident(mi, stmt\as\frame\head, seen) != 0
                return: 1
            if: stmt != 0 && stmt\as != 0 && stmt\as\frame != 0 && stmt\as\frame\body != 0 && l2_scan_actuals(stmt, mi, seen) != 0
                return: 1
            field: l2_next_active(field\next)
return: 0

# How many own rows a scan of this node may add: one per letter or `f()` in it.
fn: l2_colon_decl_room (const: @(LmP0Node node)) int
    @: LmP0Field f 0
    @: LmP0Text cn 0
    int: n 0
    if: node = 0 || node\as = 0
        return: 0
    if: node\kind = c.LM_P0_NODE_FRAME && l2_receive_msg_shape(node, @ cn, 0) = 0
        return: 1
    if: node\kind = c.LM_P0_NODE_FRAME && l2_empty_call_shape(node) != 0
        return: 1
    if: node\kind = c.LM_P0_NODE_STRUCTURE && node\as\structure != 0
        f: node\as\structure\first_field
    if: node\kind = c.LM_P0_NODE_FRAME && node\as\frame != 0 && node\as\frame\body != 0
        f: l2_call_actuals(node\as\frame\body)
    while: f != 0
        n: n + l2_colon_decl_room(f\value)
        f: f\next
    ---
return: n

fn: l2_dyn_local (const: @(char path)) int
    int: d0 0
    int: i 0
    int: k
    int: oi
    int: dummy 0
    int: heap 0
    int: room
    @: int seen
    size_t: nb
    seen: @ dummy
    # The scan below registers every `Model: fresh` it meets as an own row, so
    # `seen` must have room for those rows too, not only for the rows that
    # exist now (a row index past l2_own_n here overran the table).
    room: l2_own_n
    while: i < l2_m_n
        if: l2_m_body[i] != 0
            room: room + l2_colon_decl_room(l2_m_body[i])
        i: i + 1
    ---
    i: 0
    if: room > 0
        if: l2_mul_ok((cast: (size_t) room), c.sizeof(c.int)) = 0
            l2_alloc_err: 2
            return: l2_alloc_or(path, 0, "unsupported body")
        nb: (cast: (size_t) room) * c.sizeof(c.int)
        l2_alloc_kind: 5
        seen: (cast: (@: int) l2_xmalloc(nb))
        if: seen = 0
            return: l2_alloc_or(path, 0, "unsupported body")
        heap: 1
        ---
    while: i < l2_m_n
        l2_vis_method(i)
        if: heap != 0
            memset((cast: (@: void) seen), 0, nb)
        if: l2_m_body[i] != 0 && l2_m_body[i]\as != 0 && l2_ml_rebuild(l2_m_body[i]\as\structure, i, path) != 0
            if: heap != 0
                l2_xfree((cast: (@: void) seen))
            return: 1
        # One cause, one line (REVIEW 9256c3b): a scan that said why (l2_scan_ident's located
        # refusals) is not followed by the general words.
        d0: l2_diag_n
        if: l2_m_body[i] != 0 && l2_m_body[i]\as != 0 && l2_scan_body(l2_m_body[i]\as\structure, i, seen) != 0
            if: heap != 0
                l2_xfree((cast: (@: void) seen))
            return: l2_said_or(path, l2_m_node[i], d0, "unsupported body")
        if: l2_m_node[i] != 0 && l2_m_node[i]\as != 0 && l2_ret_tr(l2_m_node[i]\as\frame) != 0 && l2_scan_fields(l2_ret_tr(l2_m_node[i]\as\frame)\first_field, l2_count_active(l2_ret_tr(l2_m_node[i]\as\frame)), i, seen) != 0
            if: heap != 0
                l2_xfree((cast: (@: void) seen))
            return: l2_said_or(path, l2_m_node[i], d0, "unsupported body")
        oi: 0
        while: oi < l2_own_n
            if: l2_m_uses[l2_own_off(i, oi)] != 0 && l2_m_pre[l2_own_off(i, oi)] != 0 && l2_dyn_add(i, l2_own_name[oi], l2_dt_of_own(l2_own_ty[oi])) != 0
                if: heap != 0
                    l2_xfree((cast: (@: void) seen))
                return: l2_alloc_or(path, l2_m_node[i], "unsupported body")
            if: l2_m_uses[l2_own_off(i, oi)] != 0 && l2_bind_own(i, oi, path, l2_m_node[i]) != 0
                if: heap != 0
                    l2_xfree((cast: (@: void) seen))
                return: 1
            oi: oi + 1
        i: i + 1
    l2_vis_on: 0
    if: heap != 0
        l2_xfree((cast: (@: void) seen))
return: 0

fn: l2_dyn_site_callee (const: @(L2SourceSite site); int: cidx; int: fi; const: @(char path); @: int changed) int
    int: m site\method
    int: k 0
    int: src
    int: own
    int: ty
    int: sdt
    int: before
    int: model
    int: need
    int: pres
    @: LmP0Text nm
    while: k < l2_m_dyn[cidx]
        if: l2_mad_host_of(cidx) = m && l2_cap_arg_ns(cidx, l2_m_arity[cidx] + k) >= 0
            k: k + 1
            continue
        # K04 S2 part two: an input the callable this site has does not need is asked of no one.
        need: l2_site_needs(m, site\source, fi, cidx, k, 0, 0, path)
        if: need < 0
            return: 1
        if: need = 0
            k: k + 1
            continue
        nm: l2_dn(cidx, k)
        ty: l2_dt(cidx, k)
        own: l2_resolved_own(m, nm)
        src: -1
        sdt: 0
        # K04 S3: whether this site hands the entry present (l2_dyp_mark): the caller's own binding, or its own
        # input when that can be present.
        pres: 0
        if: own >= 0 && l2_m_uses[l2_own_off(m, own)] != 0
            pres: 1
            if: l2_dt_of_source(l2_own_ty[own], path, site\source, @ sdt) != 0
                return: 1
            ---
        else:
            src: l2_param_find(m, nm)
            # A graph input named as a unit Structure or an eternal branch is reached through the unit, not
            # inherited.  A unit-level MERGE RESULT is a unit field like any other (K02c): the scan made it the
            # callee's input (l2_scan_ident), and a caller without a binding of its own inherits it.
            if: src < 0 && m != l2_e && (ty != l2_graph_dt() || ((l2_ns_find(nm) < 0 || l2_ns_parent[l2_ns_find(nm)] >= 0) && l2_ebr_find(nm) < 0))
                before: l2_m_dyn[m]
                if: l2_dyn_add(m, nm, ty) != 0
                    return: l2_alloc_or(path, site\source, "unsupported body")
                if: l2_m_dyn[m] != before
                    \changed: 1
                src: l2_param_find(m, nm)
            if: src >= 0 && src < l2_m_arity[m]
                pres: 1
                if: l2_input_is_descriptor(m, src) != 0
                    sdt: l2_graph_dt()
                    ---
                else:
                    if: l2_dt_of_source(l2_own_ty_of_param(l2_input_ft(m, src)), path, site\source, @ sdt) != 0
                        return: 1
                    ---
                ---
            if: src >= l2_m_arity[m] && src >= 0
                # The name goes on from m's own input: m needs it for the reasons this site has.
                if: l2_site_needs(m, site\source, fi, cidx, k, 1, changed, path) < 0
                    return: 1
                if: l2_dyn_fwd(m, src - l2_m_arity[m]) = 0 || l2_dyp_has(m, nm) != 0
                    pres: 1
                sdt: l2_dt(m, src - l2_m_arity[m])
                if: sdt = 0 && ty != 0
                    if: l2_dt_set(m, src - l2_m_arity[m], ty) != 0
                        return: 1
                    \changed: 1
                    sdt: ty
                ---
            if: src < 0 && m = l2_e
                # K04 S2 part two: the root has no binding to give.  A name the callee reads has the callee's
                # lexical source.  A name the callee only forwards has no source in the callee: its readers
                # resolve it, each from its own, and the call is inadmissible only when one of them has none
                # (need 2).
                own: 0 - 1
                if: l2_dyn_reads(cidx, k) != 0 || l2_dyr_any(cidx, nm) = 0
                    own: l2_own_lexical(cidx, nm)
                    if: own < 0
                        need: 2
                    ---
                # The root reads the lexical source of a callee that cannot take the entry absent, and hands it.
                if: l2_hid_takes_absent(cidx, k) = 0
                    pres: 1
                if: own >= 0
                    if: l2_dt_of_source(l2_own_ty[own], path, site\source, @ sdt) != 0
                        return: 1
                    ---
                else:
                    # One admission rule for an input with a type and one without (Codex, OPUS-CODEX-20261005-01):
                    # a required input no one can give makes this call -- where the chain starts -- inadmissible,
                    # and a type learned elsewhere decides nothing about where the failure is said.
                    if: need = 2
                        return: l2_error_name(path, site\source, "unbound dynamic input ", nm\data, nm\length, "")
                    ---
        ---
        if: pres != 0 && l2_dyp_mark(cidx, nm, changed) != 0
            return: 1
        # RECEPTION-EDGE-DEBTS (e) (Codex, FABLE-CODEX-20261004-12: "An opaque reference supplied as a hidden input
        # to a typed reference use has the same receiving-edge conversion/admission as the explicit analogue,
        # provided actual reference depth/type is correct."): a caller's `@: void` under a name its reader uses as a
        # graph reference is admitted where the input is formed, as an opaque actual to a Structure formal is.
        if: sdt != 0 && ty != 0 && sdt != ty && (ty != l2_graph_dt() || l2_ft_of_own(l2_own_of_dt(sdt)) != 16)
            return: l2_error(path, site\source, "incompatible entry signature")
        if: sdt != 0 && ty = 0
            if: l2_dt_set(cidx, k, sdt) != 0
                return: 1
            \changed: 1
        # What reaches an input is recorded where the input has a schema to admit it to -- and where it is a
        # reference with no declaration in the callee's sight, which the callee can only hand on: the
        # declarations that reach it are then known where a reader's schema admits it, by the one the value
        # carries (l2_hidden_emit_admit).  No admission stands at this call then.
        if: l2_input_schema(cidx, l2_m_arity[cidx] + k) != -1 || (l2_dt(cidx, k) = l2_graph_dt() && l2_input_undeclared(cidx, l2_m_arity[cidx] + k) != 0)
            model: l2_hidden_model_source(m, cidx, k, @ src)
            if: src != -1
                if: l2_d105_edge(l2_d105_key_method(m, src), src, cidx, l2_m_arity[cidx] + k, site\source) != 0
                    return: 1
                ---
            else:
                if: model >= 0 && l2_d105_source(cidx, l2_m_arity[cidx] + k, model, site\source) != 0
                    return: 1
                ---
            ---
            if: model = -1 && l2_input_schema(cidx, l2_m_arity[cidx] + k) != -1 && l2_admit_site(m) != 0
                return: 1
            # A dynamic candidate handed under the name: its refusal is m's implicit `implements`.
            if: model != -1 && src != -1 && l2_input_schema(cidx, l2_m_arity[cidx] + k) != -1 && l2_d105_place_dynamic(m, src) != 0 && l2_admit_site(m) != 0
                return: 1
            ---
        k: k + 1
return: 0

# One held call in the fixed point (K04 S3; Codex, FABLE-CODEX-20261004-12).  A name the model needs that the
# calling method does not bind becomes the method's own input, which it only hands on: its callers give it
# along the chain, as for a call of a method, and where no one does it arrives absent and the model's readers
# resolve it, each from its own source -- for a name of the model's host, the value kept in its node.  A number
# and a reference alike: whether a name is asked does not depend on how its value is represented.  The root
# has no caller: what it cannot give is refused or left to the readers where the call is formed
# (l2_held_unbound).  Where the method already hands on the name as another type nothing is added: see
# l2_held_never.  A named Structure of the unit, or an eternal branch, is reached through the unit and asked
# of no one, as at a call of a method (l2_dyn_site_callee).  A reference the calling method gives is recorded
# for its admission to the model's use, as a call of a method records it (l2_d105_edge, l2_d105_source).
fn: l2_dyn_site_held (const: @(L2SourceSite site); int: model; const: @(char path); @: int changed) int
    int: m site\method
    int: k 0
    int: need
    int: own
    int: pi
    int: before
    int: ty
    int: pres
    int: gives
    int: asked
    int: cand
    int: src
    int: hty
    @: LmP0Text nm
    if: m < 0 || model < 0
        return: 0
    while: k < l2_m_dyn[model]
        nm: l2_dn(model, k)
        ty: l2_dt(model, k)
        if: nm = 0
            k: k + 1
            continue
        need: l2_site_needs(m, site\source, 0 - 1, model, k, 0, 0, path)
        if: need < 0
            return: 1
        if: need = 0
            k: k + 1
            continue
        if: m = l2_e && ty = 0 && need = 2
            return: l2_error_name(path, site\source, "unbound dynamic input ", nm\data, nm\length, "")
        own: l2_resolved_own(m, nm)
        pres: 0
        gives: 0
        # The root's every declared field of the name is its binding (l2_rw_held_bound); a method's, the one it
        # uses.
        if: own >= 0 && (m = l2_e || l2_m_uses[l2_own_off(m, own)] != 0)
            pres: 1
            gives: 1
        if: pres = 0 && m != l2_e
            pi: l2_param_find(m, nm)
            if: pi >= 0 && pi < l2_m_arity[m]
                pres: 1
            # A name inherited along the chain at all: not a named Structure of the unit, not an eternal branch.
            asked: (cast: (int) (ty != l2_graph_dt() || ((l2_ns_find(nm) < 0 || l2_ns_parent[l2_ns_find(nm)] >= 0) && l2_ebr_find(nm) < 0)))
            # The method's own input of the name hands it on: one of this type or not yet typed, and, where the model
            # reads a number, one of another numeric type, which the held call converts (HELD-FREE-NAME-OTHER-TYPE).
            # A new one takes no type from a model that reads a number: a value handed on keeps the type its callers'
            # bindings give it (Codex, OPUS-HANDOFF-20261005-103112, item 5: "first-seen consumer type is not an
            # unobservable carrier"); the model's applies only where none gives one (l2_dyk_close).  One it has as
            # another kind stays as it is.
            hty: ty
            if: l2_rw_num_ty(l2_own_of_dt(ty)) != 0
                hty: 0
            if: asked != 0 && (pi < 0 || (pi >= l2_m_arity[m] && (l2_dt(m, pi - l2_m_arity[m]) = 0 || l2_dt(m, pi - l2_m_arity[m]) = ty || (hty = 0 && l2_rw_num_ty(l2_own_of_dt(l2_dt(m, pi - l2_m_arity[m]))) != 0))))
                before: l2_m_dyn[m]
                if: l2_dyn_add(m, nm, hty) != 0
                    return: l2_alloc_or(path, site\source, "unsupported body")
                if: l2_m_dyn[m] != before
                    \changed: 1
                pi: l2_param_find(m, nm)
                if: hty = 0 && ty != 0 && pi >= l2_m_arity[m] && l2_dt(m, pi - l2_m_arity[m]) = 0 && l2_dyk_note(m, nm, ty) != 0
                    return: l2_alloc_or(path, site\source, "out of memory")
                if: l2_site_needs(m, site\source, 0 - 1, model, k, 1, changed, path) < 0
                    return: 1
                if: pi >= l2_m_arity[m] && (l2_dyn_fwd(m, pi - l2_m_arity[m]) = 0 || l2_dyp_has(m, nm) != 0)
                    pres: 1
            ---
            if: pi >= 0
                gives: 1
        ---
        if: pres != 0 && l2_dyp_mark(model, nm, changed) != 0
            return: 1
        # What the calling method gives under the name -- its own field, its formal, its own input -- is a
        # candidate for the model's use of the name: its source is recorded, as at a call of a method.  A
        # capture of the model's host given as a Structure of the capture's own type keeps the admission it
        # has, as itself (l2_held_cap_same).
        if: gives != 0 && l2_held_cap_same(m, model, k) = 0 && l2_input_schema(model, l2_m_arity[model] + k) != -1
            src: 0 - 1
            cand: l2_hidden_model_source(m, model, k, @ src)
            if: src != -1
                if: l2_d105_edge(l2_d105_key_method(m, src), src, model, l2_m_arity[model] + k, site\source) != 0
                    return: 1
                ---
            else:
                if: cand >= 0 && l2_d105_source(model, l2_m_arity[model] + k, cand, site\source) != 0
                    return: 1
                ---
            ---
            if: cand = -1 && l2_admit_site(m) != 0
                return: 1
            if: cand != -1 && src != -1 && l2_d105_place_dynamic(m, src) != 0 && l2_admit_site(m) != 0
                return: 1
            ---
        k: k + 1
    ---
return: 0

# One call site in the fixed point.  A call of a method asks that method's dynamic inputs of its caller.  A
# call through a callable formal (count = formal + 1, l2_check_call) asks those of every method that reaches
# the formal, and nothing on behalf of the method that only declares it (K04; Codex,
# FABLE-CODEX-20261004-12): the reaching methods' free names propagate as any statically known requirement.
fn: l2_dyn_site (const: @(L2SourceSite site); const: @(char path); @: int changed) int
    int: fi (cast: (int) site\count) - 1
    int: i 0
    int: n
    # A held call (count -1, l2_check_held_call).
    if: fi = 0 - 2
        return: l2_dyn_site_held(site, site\target, path, changed)
    if: fi < 0
        return: l2_dyn_site_callee(site, site\target, 0 - 1, path, changed)
    n: l2_cfl_count(site\method, fi)
    while: i < n
        if: l2_dyn_site_callee(site, l2_cfl_at(site\method, fi, i), fi, path, changed) != 0
            return: 1
        i: i + 1
    ---
return: 0

fn: l2_dyn_step (const: @(char path); @: int changed) int
    L2SourceSite: saved
    int: w 0
    int: rc 0
    int: restored
    if: l2_source_save(@ saved) != 0
        return: l2_alloc_or(path, 0, "out of memory")
    while: w < l2_wait_n && rc = 0
        if: l2_wait[w].kind = 4
            rc: l2_source_restore(l2_wait + w)
            if: rc = 0
                rc: l2_dyn_site(l2_wait + w, l2_method_src((cast: (int) l2_wait[w].method), path), changed)
        ---
        w: w + 1
    restored: l2_source_restore(@ saved)
    l2_xfree((cast: (@: void) saved.scopes))
    if: rc != 0 || restored != 0
        return: 1
return: 0

# The node that holds this very text -- an atom's, or a frame's head -- in the tree under s, or 0.
# Every atom has its own text (lm_p0_append_atom_slice), so the pointer is one place in the source.
# Hidden names own a stable view of original source bytes, including a prefix
# operand's suffix. Recover the original P0 node by byte identity, never name.
fn: l2_source_text (const: @(LmP0Text original); const: @(LmP0Text view)) int
    LmP0Text: base
    int: levels
    if: original = 0 || view = 0
        return: 0
    if: original\data = view\data && original\length = view\length
        return: 1
    if: l2_deref_name(original, @ base, @ levels) = 0
        return: (cast: (int) (base.data = view\data && base.length = view\length))
    # The root of a head `name\f` (l2_scan_head_root): the same bytes, the head going on with the path's `\`.
    if: original\data != 0 && original\data = view\data && view\length > 0U && view\length < original\length && original\data[view\length] = 92
        return: 1
return: 0

fn: l2_node_of_text (const: @(LmP0Structure s); const: @(LmP0Text t)) @: LmP0Node
    @: LmP0Field f
    @: LmP0Node n
    @: LmP0Node r 0
    if: s = 0 || t = 0
        return: 0
    # A call's actuals: the Frame that names an actual spells a formal of the
    # callee, never the free name looked for.
    f: l2_call_actuals(s)
    while: f != 0 && r = 0
        n: f\value
        if: n != 0 && n\as != 0 && n\kind = c.LM_P0_NODE_ATOM && l2_source_text(n\as\atom, t) != 0
            r: n
        if: r = 0 && n != 0 && n\as != 0 && n\kind = c.LM_P0_NODE_FRAME && n\as\frame != 0
            if: l2_source_text(n\as\frame\head, t) != 0
                r: n
            if: r = 0
                r: l2_node_of_text(n\as\frame\body, t)
            if: r = 0 && n\as\frame\trailer != 0
                r: l2_node_of_text(n\as\frame\trailer\body, t)
            ---
        if: r = 0 && n != 0 && n\as != 0 && n\kind = c.LM_P0_NODE_STRUCTURE
            r: l2_node_of_text(n\as\structure, t)
        f: f\next
    if: r = 0 && s\trailer != 0
        r: l2_node_of_text(s\trailer\body, t)
return: r

# Where free name k of method m stands: the read its record keeps (l2_dyn_add takes the text of the
# read that makes it), found in the bodies -- and in a method's `return:` trailer, which P0 hangs on its
# header frame, outside its body (steps/table-receiver.md §8); else at.  An unresolved name was said at its
# method's declaration, or at 1:1 for the root and for a named Structure's procedure, which have none.
fn: l2_free_name_at (int: m; int: k; const: @(LmP0Node at)) @: LmP0Node
    int: i 0
    @: LmP0Node r 0
    @: L2HeadExpression expression l2_head_expressions
    while: i < l2_m_n && r = 0
        if: l2_m_body[i] != 0 && l2_m_body[i]\as != 0
            r: l2_node_of_text(l2_m_body[i]\as\structure, l2_dn(m, k))
        if: r = 0 && l2_m_node[i] != 0 && l2_m_node[i]\as != 0 && l2_m_node[i]\kind = c.LM_P0_NODE_FRAME && l2_m_node[i]\as\frame != 0 && l2_m_node[i]\as\frame\trailer != 0
            r: l2_node_of_text(l2_m_node[i]\as\frame\trailer\body, l2_dn(m, k))
        i: i + 1
    while: expression != 0 && r = 0
        r: l2_node_of_text(expression\body, l2_dn(m, k))
        expression: expression\allocated_next
    ---
    if: r = 0
        return: (cast: (@: LmP0Node) at)
return: r

fn: l2_dyn_typed (const: @(char path)) int
    int: m 0
    int: k
    while: m < l2_m_n
        k: 0
        while: k < l2_m_dyn[m]
            if: l2_dt(m, k) = 0
                if: l2_dn(m, k) != 0
                    c.fprintf(l1_stderr(), "l2trans detail: unresolved dynamic=%.*s\n", (cast: (int) l2_dn(m, k)\length), l2_dn(m, k)\data)
                return: l2_error(l2_method_src(m, path), l2_free_name_at(m, k, l2_m_node[m]), "unresolved name")
            k: k + 1
        m: m + 1
return: 0

fn: l2_dyn_close (const: @(char path)) int
    int: changed 1
    # Every check has run: what reaches each callable formal is closed before the requirements propagate.
    if: l2_cfl_close() != 0
        return: 1
    # The D-105 facts of the actuals of calls through callable formals reach the methods that reach those formals.
    if: l2_cfa_apply() != 0
        return: 1
    # Each successful step can only add one of the finite method/name/type
    # facts collected from this unit. Iterate to the actual fixed point; an
    # arbitrary pass count rejects valid long call chains.
    # HELD-FREE-NAME-OTHER-TYPE: once the sites change nothing, an input no binding typed takes the type of the held
    # model that asked it (l2_dyk_close), and the sites are visited again, so that the type reaches the methods that
    # hand the name on -- and the models those ask in turn.
    while: changed != 0
        changed: 0
        if: l2_dyn_step(path, @ changed) != 0
            return: 1
        if: changed = 0 && l2_dyk_close(@ changed) != 0
            return: l2_alloc_or(path, 0, "out of memory")
    ---
    # What reaches each input is closed: the coordinate space of a path through an undeclared free name is found
    # (l2_anchor_close).  Such an input has a schema from here on, so the sites are visited once more: what a
    # site records by the schema of the input it hands to -- the admission it stands for, the method it marks
    # -- is recorded now.  Nothing a site recorded before is taken back.
    if: l2_anchor_close() != 0
        return: 1
    changed: 1
    while: changed != 0
        changed: 0
        if: l2_dyn_step(path, @ changed) != 0
            return: 1
    ---
    # Every site has recorded its edges: the possible anchors of a value's positional identity are closed over them
    # (l2_d105a_close), and the identity entries of the receptions are found from these (l2_identity_list).  The
    # waited checks end here again, and both are found again.
    l2_d105a_done: 0
    l2_ide_n: 0
    if: l2_d105a_close() != 0
        return: 1
return: l2_dyn_typed(path)

# steps/free-names.md M2: is t a dynamic input of mi that the closure has not typed yet?  Never while the waited
# checks run (l2_wait_on): by then every input has its type, or l2_dyn_typed refused it as unresolved.
fn: l2_wait_name (int: mi; const: @(LmP0Text t)) int
    int: k
    int: levels
    LmP0Text: base
    if: l2_wait_on != 0 || mi < 0 || mi >= l2_m_n || t = 0 || l2_m_dyn = 0 || l2_m_dyn[mi] = 0
        return: 0
    if: l2_deref_name(t, @ base, @ levels) = 0
        return: l2_wait_name(mi, @ base)
    k: l2_dyn_find(mi, t)
    if: k >= 0 && l2_dt(mi, k) = 0
        return: 1
return: 0

# Receiver operands depend on their input types as transparent Structures do.
# An actual call is a site of its own: its actuals wait there, while its result
# has its callee's type. The resolved call boundary is shared with effect scanning.
fn: l2_waits (@: LmP0Field field; int: n; int: mi) int
    @: LmP0Field f
    int: i 0
    f: l2_next_active(field)
    while: i < n && f != 0
        if: l2_sizeof_is_type(f\value) != 0
            f: l2_next_active(f\next)
            i: i + 1
            continue
        if: f\value != 0 && f\value\as != 0 && f\value\kind = c.LM_P0_NODE_ATOM && l2_wait_name(mi, f\value\as\atom) != 0
            return: 1
        if: f\value != 0 && f\value\as != 0 && f\value\kind = c.LM_P0_NODE_STRUCTURE && f\value\as\structure != 0 && l2_waits(f\value\as\structure\first_field, l2_count_active(f\value\as\structure), mi) != 0
            return: 1
        if: f\value != 0 && f\value\as != 0 && f\value\kind = c.LM_P0_NODE_FRAME && f\value\as\frame != 0 && f\value\as\frame\body != 0 && l2_frame_is_call(f\value\as\frame, mi) = 0
            if: l2_waits(f\value\as\frame\body\first_field, l2_count_active(f\value\as\frame\body), mi) != 0
                return: 1
            ---
        f: l2_next_active(f\next)
        i: i + 1
return: 0

# Save/replay one translation environment; the copied scopes belong to the snapshot.
fn: l2_source_save (@: L2SourceSite saved) int
    int: i 0
    saved\method: l2_here_mi
    saved\source_method: l2_here_source_mi
    saved\current_method: l2_cur_mi
    saved\source: l2_here_node
    saved\excluded: l2_own_excl
    saved\visibility: l2_vis_on
    saved\visible_at: l2_vis_at
    saved\scope_count: l2_scope_n
    saved\scopes: 0
    if: l2_scope_n > 0
        if: l2_mul_ok((cast: (size_t) l2_scope_n), c.sizeof(@: LmP0Node)) = 0
            return: 1
        saved\scopes: (cast: (@@: LmP0Node) l2_xmalloc((cast: (size_t) l2_scope_n) * c.sizeof(@: LmP0Node)))
        if: saved\scopes = 0
            return: 1
        while: i < l2_scope_n
            saved\scopes[i]: l2_scope_at[i]
            i: i + 1
return: 0

fn: l2_source_restore (const: @(L2SourceSite saved)) int
    int: i 0
    l2_scope_n: 0
    l2_here_at_method(saved\method, saved\source)
    l2_here_source_mi: saved\source_method
    l2_cur_mi: saved\current_method
    l2_own_excl: saved\excluded
    l2_vis_on: saved\visibility
    l2_vis_at: saved\visible_at
    while: i < saved\scope_count
        if: l2_scope_push(saved\scopes[i]) != 0
            return: 1
        i: i + 1
return: 0

# A hidden input's canonical fallback belongs to its callee's lexical
# environment, never to the position/scope/exclusion of a particular caller.
fn: l2_own_lexical (int: mi; const: @(LmP0Text t)) int
    L2SourceSite: saved
    int: own -1
    int: i 0
    int: restored
    if: l2_source_save(@ saved) != 0
        return: -1
    l2_scope_n: 0
    l2_own_excl: -1
    l2_vis_method(mi)
    while: i < l2_own_n
        if: l2_own_unit_seen(i, mi) != 0 && l2_text_same(l2_own_name[i], t) != 0
            if: l2_own_source_after(i, own) != 0
                own: i
        ---
        i: i + 1
    restored: l2_source_restore(@ saved)
    l2_xfree((cast: (@: void) saved.scopes))
    if: restored != 0
        return: -1
return: own

# Checks and calls retain immutable source environments, not inferred bindings.
fn: l2_wait_add (int: kind; int: mi; @: void site; int: n; int: to; const: @(LmP0Node source); const: @(char path)) int
    size_t: cap
    @: L2SourceSite records
    @: L2SourceSite record
    int: i 0
    while: i < l2_wait_n
        if: l2_wait[i].kind = kind && l2_wait[i].method = mi && l2_wait[i].site = site && l2_wait[i].count = n && l2_wait[i].target = to && l2_wait[i].excluded = l2_own_excl && (kind != 6 || l2_wait[i].source = source)
            return: 0
        i: i + 1
    if: l2_wait_n >= l2_wait_cap
        cap: (cast: (size_t) l2_wait_cap) * 2U
        if: cap < 8U
            cap: 8U
        if: cap > (cast: (size_t) c.INT_MAX) || l2_mul_ok(cap, c.sizeof(c.L2SourceSite)) = 0
            return: l2_alloc_or(path, 0, "out of memory")
        records: (cast: (@: L2SourceSite) l2_xmalloc(cap * c.sizeof(c.L2SourceSite)))
        if: records = 0
            return: l2_alloc_or(path, 0, "out of memory")
        if: l2_wait_n > 0
            memcpy((cast: (@: void) records), (cast: (@: void) l2_wait), (cast: (size_t) l2_wait_n) * c.sizeof(c.L2SourceSite))
        if: l2_wait != 0
            l2_xfree((cast: (@: void) l2_wait))
        l2_wait: records
        l2_wait_cap: (cast: (int) cap)
    record: l2_wait + l2_wait_n
    if: l2_source_save(record) != 0
        return: l2_alloc_or(path, 0, "out of memory")
    record\kind: kind
    record\method: mi
    record\current_method: mi
    record\count: n
    record\target: to
    record\site: site
    record\source: (cast: (@: LmP0Node) source)
    l2_wait_n: l2_wait_n + 1
return: 0

fn: l2_note_call (int: mi; int: callee; const: @(LmP0Node node); const: @(char path)) int
return: l2_wait_add(4, mi, (cast: (@: void) node), 0, callee, node, path)

# steps/free-names.md M2/M3: after l2_dyn_close every waited check runs at its site -- in its method, under the scope
# stack it was checked under, with the dynamic inputs typed -- and the edges it notes (a conversion's receiver,
# l2_convert_edge) are closed again: throws, reach, dynamic inputs.
fn: l2_wait_run (const: @(char path)) int
    L2SourceSite: saved
    int: w 0
    int: mi
    int: rc 0
    int: restored
    int: old_wait l2_wait_on
    if: l2_source_save(@ saved) != 0
        return: l2_alloc_or(path, 0, "out of memory")
    l2_wait_on: 1
    while: w < l2_wait_n && rc = 0
        mi: l2_wait[w].method
        if: l2_wait[w].kind != 4
            rc: l2_source_restore(l2_wait + w)
        if: rc = 0 && l2_wait[w].kind = 1
            rc: l2_colon_check_assignment((cast: (@: LmP0Node) l2_wait[w].site), mi, l2_method_src(mi, path))
        if: rc = 0 && l2_wait[w].kind = 2
            rc: l2_check_value_convert_field((cast: (@: LmP0Field) l2_wait[w].site), (cast: (int) l2_wait[w].count), (cast: (int) l2_wait[w].target), mi, l2_method_src(mi, path))
        if: rc = 0 && l2_wait[w].kind = 3
            rc: l2_wait_kinds((cast: (@: LmP0Field) l2_wait[w].site), (cast: (int) l2_wait[w].count), mi, l2_method_src(mi, path))
        if: rc = 0 && l2_wait[w].kind = 5
            rc: l2_check_indirect_write((cast: (@: LmP0Node) l2_wait[w].site), mi, l2_method_src(mi, path))
        if: rc = 0 && l2_wait[w].kind = 6
            rc: l2_check_fields((cast: (@: LmP0Field) l2_wait[w].site), (cast: (int) l2_wait[w].count), mi, l2_method_src(mi, path), (cast: (@: LmP0Node) l2_wait[w].source))
        if: rc = 0 && l2_wait[w].kind = 7
            rc: l2_check_path_write((cast: (@: LmP0Node) l2_wait[w].site), mi, l2_method_src(mi, path))
        if: rc = 0 && l2_wait[w].kind = 8
            rc: l2_check_held_convert((cast: (@: LmP0Node) l2_wait[w].site), (cast: (int) l2_wait[w].count), mi, l2_method_src(mi, path))
        w: w + 1
    restored: l2_source_restore(@ saved)
    l2_xfree((cast: (@: void) saved.scopes))
    l2_wait_on: old_wait
    if: rc != 0 || restored != 0
        return: 1
    if: l2_throws_close() != 0
        return: 1
return: l2_dyn_close(path)

# A waited kind check (kind 3): l2_check_value_kinds at its span, located at the span's first value where the typer
# names no operand.
fn: l2_wait_kinds (@: LmP0Field field; int: n; int: mi; const: @(char path)) int
    @: LmP0Field f
    f: l2_next_active(field)
    if: f = 0
        return: 0
return: l2_check_value_kinds(field, n, mi, path, f\value)

# Check one complete initializer before binding its declaration. Deferred checks
# and hidden calls retain this same exclusion, regardless of the receiving type.
# An indirect target's type may itself be a hidden input. Replay the same
# receiving check once it closes, retaining the complete source environment.
fn: l2_check_indirect_write (const: @(LmP0Node stmt); int: mi; const: @(char path)) int
    LmP0Text: base
    LmP0Text: word
    int: levels
    int: target
    int: source
    int: depth
    int: qualified
    if: stmt = 0 || stmt\kind != c.LM_P0_NODE_FRAME || stmt\as = 0 || stmt\as\frame = 0 || l2_deref_name(stmt\as\frame\head, @ base, @ levels) != 0
        return: 2
    if: stmt\as\frame\body = 0
        return: l2_error(path, stmt, "invalid raw dereference")
    if: l2_check_fields(stmt\as\frame\body\first_field, l2_count_active(stmt\as\frame\body), mi, path, stmt) != 0
        return: 1
    if: l2_wait_name(mi, @ base) != 0
        return: l2_wait_add(5, mi, (cast: (@: void) stmt), 0, 0, stmt, path)
    if: l2_deref_word(stmt\as\frame\head, mi, @ base, @ levels, @ target) != 0 || l2_colon_bound_ty(mi, @ base, @ source) != 0 || l2_type_parts(l2_formal_raw(source), @ word, @ depth, @ qualified) != 0
        return: l2_error(path, stmt, "invalid raw dereference")
    if: qualified != 0 && depth = levels
        return: l2_error(path, stmt, "a const value cannot be written")
return: l2_check_receiving_value(stmt, stmt\as\frame\body\first_field, l2_count_active(stmt\as\frame\body), target, l2_contract_model_depth(l2_binding_contract(mi, @ base), 0, levels), 0, mi, path)

fn: l2_check_decl_candidate (const: @(LmP0Node stmt); int: mi; const: @(char path)) int
    @: L2Declaration declaration l2_declaration(stmt)
    @: LmP0Field first
    int: previous l2_own_excl
    int: rc 0
    int: own
    int: formal
    if: declaration = 0
        return: 0
    l2_here_at_method(mi, stmt)
    own: l2_own_find_decl(mi, declaration\name, stmt)
    l2_own_excl: own
    if: declaration\candidate_count = 0
        formal: l2_param_find(mi, declaration\name)
        if: own >= 0 && formal >= 0 && l2_own_is_pointer(l2_own_ty[own]) = 0
            first: l2_next_active(stmt\as\frame\body\first_field)
            rc: l2_check_value_convert_field(first, 1, l2_ft_of_own(l2_own_ty[own]), mi, path)
        ---
        l2_own_excl: previous
        return: rc
    first: declaration\candidate
    if: first = 0 || first\value = 0
        rc: 1
    if: rc = 0
        rc: l2_check_one_value(first, declaration\candidate_count, path)
    if: rc = 0
        rc: l2_check_fields(first, declaration\candidate_count, mi, path, stmt)
    if: rc = 0 && declaration\candidate_count = 1 && first\value\kind = c.LM_P0_NODE_ATOM
        rc: l2_check_literal_kind(first\value\as\atom, l2_lit_kind_from_own(l2_own_decl_ty(stmt)), path, stmt)
    if: rc = 0
        rc: l2_check_init_convert(stmt, first, mi, path)
    l2_own_excl: previous
return: rc

fn: l2_wait_free () int
    int: i 0
    while: i < l2_wait_n
        l2_xfree((cast: (@: void) l2_wait[i].scopes))
        i: i + 1
    l2_xfree((cast: (@: void) l2_wait))
    l2_wait: 0
    l2_wait_n: 0
    l2_wait_cap: 0
    l2_wait_on: 0
return: 0


# FABLE-GROKBOT-C-MEMBER-ACCESS-20260923-120 part1 / FABLE-GROKBOT-RAW-MEMBER-ROOT-AND-7A-CLOSE-20260923-126 part1:
# Raw C member paths fire ONLY when the root's resolved type is spelled c.*
# (foreign intern whose name is not the Lmx Structure projection).  The runtime
# struct codes 28/29/30 stood here until §GATE G2: a kernel type reaches this
# door only as c.*.  A Structure / own / formal / occurrence root
# that also interns as foreign Lmx (ty >= 100) must NOT take this door -- the
# L2 path dispatcher (l2_path_root / l2_emit_path) decides first.
# Mutant: restore "if: ty >= 100 / return: 1" alone -- Model compound fixture
# emits wrong literal C member access (RED).
# Mutant: make this always return 0 -- c.LmP0Text fixtures refuse unsupported body.
fn: l2_ty_raw_c_members (int: ty) int
    int: i
    if: ty < 100
        return: 0
    i: ty - 100
    if: i < 0 || i >= l2_foreign_n
        return: 0
    if: l2_foreign_name[i] = 0
        return: 0
    if: l2_text_eq(l2_foreign_name[i], "Lmx")
        return: 0
return: 1

fn: l2_raw_path (const: @(char pd); size_t: pn; int: mi; @: int out_j) int
    size_t: i 0U
    size_t: sl 0U
    int: j
    LmP0Text: root
    if: pd = 0 || mi < 0 || out_j = 0
        return: 1
    sl: pn
    while: i < pn
        if: pd[i] = 92 && sl = pn
            sl: i
        i: i + 1U
    if: sl = 0U || sl = pn || sl + 1U >= pn
        return: 1
    root.data: (cast: (@: char) pd)
    root.length: sl
    j: l2_resolved_own(mi, @ root)
    if: j >= 0
        \out_j: l2_m_arity[mi] + l2_m_sn[mi] + l2_ml_n + j
        return: l2_ty_raw_c_members(l2_ft_of_own(l2_own_ty[j])) = 0
    j: 0
    while: j < l2_m_arity[mi]
        if: l2_fn(mi, j) != 0 && l2_fn(mi, j)\length = sl && memcmp(l2_fn(mi, j)\data, pd, sl) = 0
            \out_j: j
            # A runtime struct or foreign type field is spelled as written.
            if: l2_ty_raw_c_members(l2_ft(mi, j)) != 0
                return: 0
            # Root matched a formal but is not c.*-raw: L2 dispatcher decides.
            return: 1
        j: j + 1
    j: 0
    while: j < l2_m_sn[mi]
        if: l2_sn[l2_slot_off(mi, j)] != 0 && l2_sn[l2_slot_off(mi, j)]\length = sl && memcmp(l2_sn[l2_slot_off(mi, j)]\data, pd, sl) = 0
            # Raw formal and local-slot targets share this result channel.
            # Place slots after the method's actual formal count so every
            # arity remains disjoint without a reserved numeric band.
            \out_j: l2_m_arity[mi] + j
            # A runtime struct or foreign type field is spelled as written.
            if: l2_ty_raw_c_members(l2_st[l2_slot_off(mi, j)]) != 0
                return: 0
            # Root matched a slot but is not c.*-raw: L2 dispatcher decides.
            return: 1
        j: j + 1
    j: 0
    while: j < l2_ml_n
        # A runtime struct or foreign type field is spelled as written.
        if: l2_ty_raw_c_members(l2_ml_ty[j]) != 0 && l2_ml_nm[j] != 0 && l2_ml_nm[j]\length = sl && memcmp(l2_ml_nm[j]\data, pd, sl) = 0
            \out_j: l2_m_arity[mi] + l2_m_sn[mi] + j
            return: 0
        j: j + 1
return: 1


fn: l2_raw_head (const: @(LmP0Text t); int: mi; @: int out_j) int
    if: t = 0
        return: 1
return: l2_raw_path(t\data, t\length, mi, out_j)

# Resolve the same raw-C root for reads, calls and stores. A declared pointer
# field supplies its working value; only the foreign suffix is emitted raw.
fn: l2_emit_raw_path (const: @(char pd); size_t: pn; int: mi; const: @(char ind); @: L2Tx dest) int
    int: binding
    int: own
    size_t: sl 0U
    LmP0Text: root
    if: l2_raw_path(pd, pn, mi, @ binding) != 0
        return: 1
    while: sl < pn && pd[sl] != 92
        sl: sl + 1U
    root.data: (cast: (@: char) pd)
    root.length: sl
    own: l2_resolved_own(mi, @ root)
    if: own >= 0
        if: l2_own_load(own, dest) != 0
            return: 1
    ---
    if: own < 0 && binding < l2_m_arity[mi] && l2_tok_formal(mi, binding, dest) != 0
        return: 1
    if: own < 0 && binding >= l2_m_arity[mi] && binding < l2_m_arity[mi] + l2_m_sn[mi] && l2_tok_slot(mi, binding - l2_m_arity[mi], dest) != 0
        return: 1
    if: own < 0 && binding >= l2_m_arity[mi] + l2_m_sn[mi] && l2_tok_tx(dest, @ root) != 0
        return: 1
    ---
    # The path after its root, as it is written, of any length.
return: l2_tx_catn(dest, pd + sl, pn - sl)
fn: l2_pointer_depth (int: ty) int
    int: fi
    if: ty = l2_graph_code()
        return: 1
    if: ty = 3 || ty = 9 || ty = 11 || ty = 12 || ty = 16 || ty = 25 || ty = l2_msg_ref_ty() || ty = 38
        return: 1
    if: ty = 17 || ty = 18 || ty = 19 || ty = 20 || ty = 24 || ty = 39
        return: 2
    if: ty >= 100
        fi: ty - 100
        if: fi >= 0 && fi < l2_foreign_n
            return: l2_foreign_depth[fi]
        ---
    ---
return: 0

# Prefix `\` is raw dereference. Only the leading run is dereference; any
# later `\field` stays postfix field-follow. Rename the selected L2 binding,
# preserve both positional operators, and leave `[]` to the index path.
# The pointer own field k, loaded into a new temporary for a dereference (-189 c3b-3): its name,
# appended to dest.  With ind 0 (a check, which emits nothing) the load expression is spelled.
fn: l2_deref_load (int: k; const: @(char ind); @: L2Tx dest) int
    []: char load_own 256
    L2Tx: load_tx
    @: L2Tx load l2_tx_local(@ load_tx, load_own, 256U)
    []: char dcl_own 256
    L2Tx: dcl_tx
    @: L2Tx dcl l2_tx_local(@ dcl_tx, dcl_own, 256U)
    []: char nm 32
    int: t
    if: load = 0 || dcl = 0 || l2_own_load(k, load) != 0
        return: 1
    if: ind = 0
        return: l2_tx_set(dest, load\data)
    t: l2_tn
    l2_tn: l2_tn + 1
    if: c.snprintf(nm, 32U, "l2_t%d", t) < 0 || l2_pointer_decl_text(l2_oc_ft(l2_own_ty[k]), 0, nm, dcl) != 0
        return: 1
    if: c.fprintf(l2_out, "%s%s\n%s%s: %s\n", ind, dcl\data, ind, nm, load\data) < 0
        return: 1
return: l2_tx_set(dest, nm)

fn: l2_prefix_deref (const: @(LmP0Text t); int: mi; const: @(char ind); @: L2Tx dest) int
    LmP0Text: plain_base
    int: plain_levels
    int: plain_type
    size_t: lead 0U
    size_t: base_end
    int: j
    int: ty 0
    int: found 0
    int: rc
    []: char nm 48
    []: char sub_own 128
    L2Tx: sub_tx
    @: L2Tx sub l2_tx_local(@ sub_tx, sub_own, 128U)
    if: t = 0 || t\data = 0 || dest = 0 || sub = 0
        return: 1
    if: l2_deref_word(t, mi, @ plain_base, @ plain_levels, @ plain_type) = 0
        # As many indirections as the word is written with, then what its base loads as.
        rc: 2
        ty: l2_resolved_own(mi, @ plain_base)
        if: ty >= 0
            rc: l2_deref_load(ty, ind, sub)
        if: rc = 2
            ty: l2_param_find(mi, @ plain_base)
            if: ty >= 0
                rc: l2_tok_formal(mi, ty, sub)
        ---
        if: rc = 2
            ty: l2_slot_find(mi, @ plain_base)
            if: ty >= 0
                rc: l2_tok_slot(mi, ty, sub)
        ---
        if: rc = 2 && l2_ml_find(@ plain_base) >= 0
            rc: l2_tok_tx(sub, @ plain_base)
        if: rc != 0
            return: rc
        return: l2_prefix_levels(dest, (cast: (size_t) plain_levels), sub\data, 0, 0U)
    while: lead < t\length && t\data[lead] = 92
        lead: lead + 1U
    if: lead = 0U
        return: 1
    base_end: lead
    while: base_end < t\length && t\data[base_end] != 92
        base_end: base_end + 1U
    if: base_end = lead
        return: 2
    plain_base.data: t\data + lead
    plain_base.length: base_end - lead
    j: l2_resolved_own(mi, @ plain_base)
    if: j >= 0
        ty: l2_ft_of_own(l2_own_ty[j])
        if: l2_deref_load(j, ind, sub) != 0
            return: 2
        found: 1
    else:
        j: l2_param_find(mi, @ plain_base)
        if: j >= 0
            ty: l2_input_ft(mi, j)
            if: l2_tok_formal(mi, j, sub) != 0
                return: 2
            found: 1
        ---
    ---
    j: 0
    while: j < l2_m_sn[mi] && found = 0
        if: l2_sn[l2_slot_off(mi, j)] != 0 && l2_sn[l2_slot_off(mi, j)]\length = base_end - lead && memcmp(l2_sn[l2_slot_off(mi, j)]\data, t\data + lead, base_end - lead) = 0
            ty: l2_st[l2_slot_off(mi, j)]
            if: c.snprintf(nm, 48U, "l2_s%d_%d", mi, j) < 0 || l2_tx_set(sub, nm) != 0
                return: 2
            found: 1
        ---
        j: j + 1
    ---
    j: 0
    while: j < l2_ml_n && found = 0
        if: l2_ml_nm[j] != 0 && l2_ml_nm[j]\length = base_end - lead && memcmp(l2_ml_nm[j]\data, t\data + lead, base_end - lead) = 0
            ty: l2_ml_ty[j]
            if: l2_tx_clear(sub) != 0 || l2_tx_catn(sub, t\data + lead, base_end - lead) != 0
                return: 2
            found: 1
        ---
        j: j + 1
    ---
    if: found = 0 || l2_pointer_depth(ty) < (cast: (int) lead)
        return: 2
    # The indirections as written, the base's text, and the path after it, of any length.
return: l2_prefix_levels(dest, lead, sub\data, t\data + base_end, t\length - base_end)

# Borrow lexical pieces from the existing P0 scanner. Foreign member suffixes
# stay with their already resolved root; neither emitter invents a local lexer.
fn: l2_index_piece (const: @(LmP0Text text); @: size_t cursor; @: LmP0Text part) int
    size_t: start \cursor
    size_t: stop
    while: start < text\length
        if: text\data[start] = 32 || text\data[start] = 9
            start: start + 1U
            continue
        if: text\data[start] = 123
            if: lm_p0_skip_brace_mark(0, text\data, text\length, @ start, 0U, 0U) = 0
                return: -1
            continue
        break
    ---
    if: start = text\length
        \cursor: start
        return: 0
    if: lm_p0_starts_python_string(text\data, text\length, start) != 0
        stop: lm_p0_skip_python_string_unchecked(text\data, text\length, start)
    else:
        if: text\data[start] = 34 || text\data[start] = 96
            stop: start
            if: lm_p0_scan_quoted(0, text\data, text\length, @ stop, text\data[start], 0U, 0U) = 0
                return: -1
            ---
        else:
            stop: lm_p0_scan_compact_atom_piece(text\data, text\length, start, 0)
        ---
    ---
    if: stop <= start
        return: -1
    if: lm_p0_is_bare_identifier_start(text\data[start]) != 0
        while: stop + 1U < text\length && text\data[stop] = 92 && lm_p0_is_bare_identifier_start(text\data[stop + 1U]) != 0
            stop: lm_p0_scan_compact_atom_piece(text\data, text\length, stop + 1U, 0)
        ---
    ---
    part\data: text\data + start
    part\length: stop - start
    \cursor: stop
return: 1

fn: l2_raw_index_group (const: @(LmP0Text text); @: size_t cursor; @: LmP0Text part) int
    size_t: start \cursor
    size_t: close
    if: start >= text\length || text\data[start] != 91
        return: 1
    # The source was already parsed. Reuse its delimiter scanner without
    # mutating the document's diagnostic; the caller reports its original site.
    if: lm_p0_find_matching_bracket(0, text\data, text\length, start, 0U, 0U, @ close) = 0 || close = start + 1U
        return: 1
    part\data: text\data + start + 1U
    part\length: close - start - 1U
    \cursor: close + 1U
return: 0

fn: l2_field_index_group (@: LmP0Field open; int: available; @: L2ValueSpan part; @@: LmP0Field after) int
    @: LmP0Field field
    int: used 1
    int: depth 1
    if: open = 0 || open\value = 0 || open\value\kind != c.LM_P0_NODE_ATOM || l2_text_eq(open\value\as\atom, "[") = 0
        return: 0
    field: l2_next_active(open\next)
    part\first: field
    if: field = 0
        return: 0
    part\node: field\value
    while: used < available && field != 0
        if: field\value != 0 && field\value\kind = c.LM_P0_NODE_ATOM
            if: l2_text_eq(field\value\as\atom, "[") != 0
                depth: depth + 1
            if: l2_text_eq(field\value\as\atom, "]") != 0
                depth: depth - 1
                if: depth = 0
                    if: used = 1
                        return: 0
                    part\count: used - 1
                    \after: l2_next_active(field\next)
                    return: used + 1
                ---
            ---
        ---
        field: l2_next_active(field\next)
        used: used + 1
    ---
return: 0

fn: l2_raw_index_text (const: @(LmP0Text text); int: mi; @: L2RawIndex out) int
    size_t: first 0U
    size_t: root_end 0U
    size_t: cursor
    LmP0Text: part
    int: ty
    int: own
    if: text = 0 || text\data = 0 || text\length < 4U || text\data[text\length - 1U] != 93
        return: 1
    while: first < text\length && text\data[first] != 91
        first: first + 1U
    if: first = 0U || first = text\length
        return: 1
    while: root_end < first && text\data[root_end] != 92
        root_end: root_end + 1U
    out\base.data: text\data
    out\base.length: first
    out\root.data: text\data
    out\root.length: root_end
    own: l2_resolved_own(mi, @ out\root)
    if: own >= 0 && l2_own_is_array(l2_own_ty[own]) != 0
        return: 1
    if: l2_colon_bound_ty(mi, @ out\root, @ ty) != 0
        return: 3
    out\text: text
    out\first: 0
    out\count: 0
    out\begin: first
    out\groups: 0
    out\foreign: (cast: (int) (root_end < first))
    if: out\foreign != 0 && l2_raw_c_root(mi, @ out\root) = 0
        return: 3
    cursor: first
    while: cursor < text\length
        if: l2_raw_index_group(text, @ cursor, @ part) != 0
            return: 2
        out\groups: out\groups + 1
        if: out\foreign = 0
            # The element of a pointer to a foreign by-value record is C
            # storage without an L2 value type; nothing indexes it further.
            if: ty < 0
                return: 3
            if: l2_foreign_record_pointer(ty) != 0
                ty: 0 - 1
            else:
                ty: l2_indirect_type(ty)
                if: ty < 0
                    return: 3
                ---
            ---
        ---
    ---
    out\type: ty
    if: out\foreign != 0
        out\type: -1
return: 0

# The pointee of `ty` is a foreign C record held by value: one indirection
# reaches C storage that has no L2 value type. A Structure reference and a
# void pointer are not such storage.
fn: l2_foreign_record_pointer (int: ty) int
    LmP0Text: word_value
    @: LmP0Text word @ word_value
    int: depth
    int: qualified
    int: result
    int: raw l2_formal_raw(ty)
    if: raw < 100 || l2_type_parts(raw, word, @ depth, @ qualified) != 0 || depth != 1
        return: 0
    if: l2_text_eq(word, "Lmx") != 0 || l2_ret_type_word(word, 0, 0, @ result) = 0
        return: 0
return: 1

# Split read operands keep their actual P0 base and index nodes. This view
# does not join source text or allocate a replacement parser tree.
fn: l2_raw_index_span (@: L2ValueSpan span; int: mi; @: L2RawIndex out) int
    @: LmP0Field field l2_next_active(span\first)
    @: LmP0Field index
    @: LmP0Field after
    L2ValueSpan: part
    int: used 1
    int: group
    int: own
    int: ty
    if: span\count < 4 || field = 0 || field\value = 0 || field\value\kind != c.LM_P0_NODE_ATOM || field\value\as = 0
        return: 1
    out\root.data: field\value\as\atom\data
    out\root.length: field\value\as\atom\length
    out\base: out\root
    out\text: 0
    out\first: field
    out\count: span\count
    out\begin: 0U
    out\foreign: 0
    out\groups: 0
    own: l2_resolved_own(mi, @ out\root)
    if: own >= 0 && l2_own_is_array(l2_own_ty[own]) != 0
        return: 1
    if: l2_colon_bound_ty(mi, @ out\root, @ ty) != 0
        return: 3
    field: l2_next_active(field\next)
    while: used + 2 < span\count && field != 0 && field\value != 0 && field\value\kind = c.LM_P0_NODE_ATOM && l2_is_slash(field\value\as\atom) != 0
        index: l2_next_active(field\next)
        if: index = 0 || index\value = 0 || index\value\kind != c.LM_P0_NODE_ATOM
            return: 1
        out\foreign: 1
        field: l2_next_active(index\next)
        used: used + 2
    ---
    if: out\foreign != 0 && l2_raw_c_root(mi, @ out\root) = 0
        return: 3
    out\begin: (cast: (size_t) used)
    while: used < span\count
        group: l2_field_index_group(field, span\count - used, @ part, @ after)
        if: group = 0
            return: 1
        field: after
        used: used + group
        out\groups: out\groups + 1
        if: out\foreign = 0
            if: ty < 0
                return: 3
            if: l2_foreign_record_pointer(ty) != 0
                ty: 0 - 1
            else:
                ty: l2_indirect_type(ty)
                if: ty < 0
                    return: 3
                ---
            ---
        ---
    ---
    if: used != span\count || out\groups = 0
        return: 1
    out\type: ty
    if: out\foreign != 0
        out\type: -1
return: 0

fn: l2_index_head (const: @(LmP0Text t); int: mi) int
    L2RawIndex: indexed
    LmP0Text: word
    int: status l2_raw_index_text(t, mi, @ indexed)
    int: source
    int: depth
    int: qualified
    if: status != 0
        return: status
    if: indexed.foreign = 0
        if: l2_colon_bound_ty(mi, @ (indexed.root), @ source) != 0 || l2_type_parts(l2_formal_raw(source), @ word, @ depth, @ qualified) != 0
            return: 3
        if: qualified != 0 && indexed.groups >= depth
            return: 3
        ---
    ---
return: 0

# Select the already classified pointer base through ordinary lexical binding.
# Only a resolved foreign member suffix remains raw C.
fn: l2_emit_index_base (const: @(LmP0Text t); int: mi; const: @(char ind); @: L2Tx dest) int
    size_t: base_end 0U
    size_t: root_end 0U
    int: binding
    LmP0Text: name
    while: base_end < t\length && t\data[base_end] != 91
        base_end: base_end + 1U
    while: root_end < base_end && t\data[root_end] != 92
        root_end: root_end + 1U
    if: root_end < base_end
        return: l2_emit_raw_path(t\data, base_end, mi, ind, dest)
    name.data: t\data
    name.length: base_end
    binding: l2_resolved_own(mi, @ name)
    if: binding >= 0
        return: l2_own_load(binding, dest)
    binding: l2_param_find(mi, @ name)
    if: binding >= 0
        return: l2_tok_formal(mi, binding, dest)
    binding: l2_slot_find(mi, @ name)
    if: binding >= 0
        return: l2_tok_slot(mi, binding, dest)
    if: l2_ml_find(@ name) >= 0
        return: l2_tok_tx(dest, @ name)
return: 1

# Spell a native pointer index through the same selected lexical roots as
# other values; foreign suffixes retain their existing C member projection.

fn: l2_emit_index_expression (const: @(LmP0Text text); int: mi; const: @(char ind); @: L2Tx dest) int
    size_t: cursor 0U
    int: status
    int: own
    LmP0Text: piece
    @: LmP0Text word @ piece
    []: char load_own 256
    L2Tx: load_tx
    @: L2Tx load l2_tx_local(@ load_tx, load_own, 256U)
    if: dest = 0 || load = 0 || l2_tx_clear(dest) != 0
        return: 1
    while: cursor < text\length
        status: l2_index_piece(text, @ cursor, @ piece)
        if: status = 0
            break
        if: status != 1
            return: 1
        own: l2_resolved_own(mi, @ piece)
        if: own >= 0 && l2_own_is_array(l2_own_ty[own]) != 0
            status: l2_emit_array_ptr(own, ind, load)
        else:
            if: l2_ident(@ piece) != 0
                status: l2_emit_index_base(@ piece, mi, ind, load)
                if: status != 0 && (l2_define_name(@ piece) != 0 || l2_is_known(@ piece) != 0)
                    status: l2_tok_tx(load, @ piece)
                ---
            else:
                if: l2_rw_has_slash(@ piece) != 0 && lm_p0_is_bare_identifier_start(word\data[0]) != 0
                    status: l2_emit_raw_path((piece.data), (piece.length), mi, ind, load)
                else:
                    status: l2_tok_tx(load, @ piece)
                ---
            ---
        ---
        if: status != 0
            return: 1
        # Each piece and a space after it, as many as the index is written with.
        if: l2_tx_cat(dest, load\data) != 0 || l2_tx_cat(dest, " ") != 0
            return: 1
    ---
return: 0

# Every sequential group is emitted; the last group cannot replace the first.
fn: l2_emit_index_place (const: @(LmP0Text text); int: mi; const: @(char ind); @: L2Tx dest) int
    L2RawIndex: indexed
    LmP0Text: part
    size_t: cursor
    []: char index_own 256
    L2Tx: index_tx
    @: L2Tx index l2_tx_local(@ index_tx, index_own, 256U)
    if: index = 0 || l2_raw_index_text(text, mi, @ indexed) != 0 || l2_emit_index_base(@ (indexed.base), mi, ind, dest) != 0
        return: 1
    cursor: indexed.begin
    # Each index group after the base, of any length.
    while: cursor < text\length
        if: l2_raw_index_group(text, @ cursor, @ part) != 0 || l2_emit_index_expression(@ part, mi, ind, index) != 0
            return: 1
        if: l2_tx_cat(dest, "[") != 0 || l2_tx_cat(dest, index\data) != 0 || l2_tx_cat(dest, "]") != 0
            return: 1
    ---
return: 0

# Five flat tokens `\ [ N ] name` are one occurrence operand, not a prefix plus a bracket.
fn: l2_occ_run (@: LmP0Field field) int
    @: LmP0Field p1
    @: LmP0Field p2
    @: LmP0Field p3
    @: LmP0Field p4
    if: field = 0 || field\value = 0 || field\value\kind != c.LM_P0_NODE_ATOM || field\value\as = 0
        return: 0
    if: l2_is_slash(field\value\as\atom) = 0
        return: 0
    p1: l2_next_active(field\next)
    if: p1 = 0 || p1\value = 0 || p1\value\kind != c.LM_P0_NODE_ATOM || p1\value\as = 0 || l2_text_eq(p1\value\as\atom, "[") = 0
        return: 0
    p2: l2_next_active(p1\next)
    if: p2 = 0 || p2\value = 0 || p2\value\kind != c.LM_P0_NODE_ATOM || p2\value\as = 0 || l2_num(p2\value\as\atom) = 0
        return: 0
    p3: l2_next_active(p2\next)
    if: p3 = 0 || p3\value = 0 || p3\value\kind != c.LM_P0_NODE_ATOM || p3\value\as = 0 || l2_text_eq(p3\value\as\atom, "]") = 0
        return: 0
    p4: l2_next_active(p3\next)
    if: p4 = 0 || p4\value = 0 || p4\value\kind != c.LM_P0_NODE_ATOM || p4\value\as = 0 || l2_ident(p4\value\as\atom) = 0
        return: 0
return: 5

# Span of one expression, including bounded path/index operands and operators.
fn: l2_expr_span (@: LmP0Field field) int
    @: LmP0Field f l2_next_active(field)
    @: LmP0Field scan f
    int: available 0
    int: span 0
    int: run
    while: scan != 0
        available: available + 1
        scan: l2_next_active(scan\next)
    ---
    if: available = 0 || f\value = 0
        return: 0
    # One bounded operand reader owns prefix, path and bracket boundaries.
    # Each bracket keeps its original expression fields, of any cardinality.
    while: span < available
        run: l2_operand_run(f, available - span)
        if: run < 1
            return: 0
        span: span + run
        f: l2_skip_span(f, run)
        if: span = available || f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM || l2_is_binop(f\value\as\atom) = 0
            break
        span: span + 1
        f: l2_next_active(f\next)
        if: span = available || f = 0 || f\value = 0
            return: 0
    ---
return: span

fn: l2_actual_count (@: LmP0Field field) int
    @: LmP0Field f
    int: count 0
    int: span
    int: i
    f: l2_next_active(field)
    while: f != 0
        span: l2_expr_span(f)
        if: span < 1
            return: 0 - 1
        count: count + 1
        i: 0
        while: i < span && f != 0
            f: l2_next_active(f\next)
            i: i + 1
        ---
return: count

# node's/for's own single-hop own-table lookups (l2_slash_own,
# l2_slash_for/l2_slash_for_prefix, l2_slash_node_prefix) are removed --
# FABLE-SONNET-NODE-ROOT-20260923-121, author Q9: node/for are ordinary
# roots of the -113 path dispatcher now (l2_path_root, l2_e_own_seg,
# l2_for_own_seg), not reserved spelling prefixes onto the current
# method's own table, and no longer excluded from this function either --
# FABLE-SONNET-ARRAY-WRITE-DISPATCH-20260923-119 already made it (the
# text-span sibling of l2_own_array_root, for l2_own_index_head
# specifically -- statement-head array read/write) refuse unconditionally
# for every root: a root's suffix must denote an Array-typed field of the
# root's TYPE, never a same-named sibling in mi's own table, and that
# capability (walking the root's type through the namespace slots to an
# indexed store) is not built. Refusing is the honest state; the caller's
# fallback (the ordinary field-path machinery) gives "unsupported index"
# for this shape.
fn: l2_own_array_root_span (int: mi; const: @(LmP0Text t); size_t: stop) int
return: 0 - 1

# Parse an own Array's literal element offset. L2 does not impose an extent
# check; checked L3 access validates the final index against the descriptor.
fn: l2_array_literal (int: oi; const: @(LmP0Text t); size_t: begin; size_t: stop; @: size_t out_index) int
    size_t: value 0U
    size_t: digit
    size_t: i
    if: oi < 0 || t = 0 || t\data = 0 || out_index = 0 || begin >= stop || stop > t\length
        return: 1
    if: l2_own_is_array(l2_own_ty[oi]) = 0 || l2_own_count[oi] = 0
        return: 1
    i: begin
    while: i < stop
        if: t\data[i] < 48 || t\data[i] > 57
            return: 1
        digit: (cast: (size_t) (t\data[i] - 48))
        if: value > (((cast: (size_t) -1) - digit) / 10U)
            return: 1
        value: value * 10U + digit
        i: i + 1U
    ---
    \out_index: value
return: 0

# name[ident] on an own array of mi. 0 = not this shape. 1 = ident is a size_t field
# (out_arr, out_field). 2 = ident is some other number: no silent cast.
fn: l2_dyn_own_index (int: mi; const: @(LmP0Text t); @: int out_arr; @: int out_field) int
    size_t: n
    size_t: i
    size_t: lb
    size_t: ilen
    int: dep 0
    int: arr
    int: oi
    int: digits 1
    LmP0Text: slice_value
    @: LmP0Text slice @ slice_value
    if: mi < 0 || t = 0 || t\data = 0 || out_arr = 0 || out_field = 0
        return: 0
    n: t\length
    if: n < 4U || t\data[n - 1U] != 93
        return: 0
    i: n - 1U
    lb: n
    while: lb = n && i > 0U
        if: t\data[i] = 93
            dep: dep + 1
        if: t\data[i] = 91
            dep: dep - 1
            if: dep = 0
                lb: i
            ---
        i: i - 1U
    ---
    if: lb = n || lb = 0U || lb + 1U >= n - 1U
        return: 0
    slice\data: t\data
    slice\length: lb
    arr: l2_resolved_own(mi, slice)
    if: arr < 0 || l2_own_is_array(l2_own_ty[arr]) = 0
        return: 0
    ilen: n - lb - 2U
    i: lb + 1U
    while: i < n - 1U
        if: t\data[i] < 48 || t\data[i] > 57
            digits: 0
        i: i + 1U
    ---
    if: digits != 0
        return: 0
    if: (t\data[lb + 1U] < 65 || t\data[lb + 1U] > 90) && (t\data[lb + 1U] < 97 || t\data[lb + 1U] > 122) && t\data[lb + 1U] != 95
        return: 0
    i: lb + 1U
    while: i < n - 1U
        if: (t\data[i] < 48 || t\data[i] > 57) && (t\data[i] < 65 || t\data[i] > 90) && (t\data[i] < 97 || t\data[i] > 122) && t\data[i] != 95
            return: 0
        i: i + 1U
    ---
    slice\data: t\data + lb + 1U
    slice\length: ilen
    oi: l2_resolved_own(mi, slice)
    if: oi < 0
        return: 0
    if: l2_own_ty[oi] != 2
        if: l2_rw_num_ty(l2_own_ty[oi]) != 0
            return: 2
        return: 0
    ---
    \out_arr: arr
    \out_field: oi
return: 1

# A formal, slot, or method local whose type is a raw C struct (c.*). An index on
# one of its fields is C's index, not an own-array literal proof.
fn: l2_raw_c_root (int: mi; const: @(LmP0Text t)) int
    int: j
    if: mi < 0 || t = 0
        return: 0
    j: l2_resolved_own(mi, t)
    if: j >= 0
        return: l2_ty_raw_c_members(l2_ft_of_own(l2_own_ty[j]))
    j: l2_formal_find(mi, t)
    if: j >= 0 && l2_ty_raw_c_members(l2_ft(mi, j)) != 0
        return: 1
    j: l2_slot_find(mi, t)
    if: j >= 0 && l2_ty_raw_c_members(l2_st[l2_slot_off(mi, j)]) != 0
        return: 1
    j: l2_ml_find(t)
    if: j >= 0 && l2_ty_raw_c_members(l2_ml_ty[j]) != 0
        return: 1
return: 0

# 0 when `t` is `root\field[index]` and root is a raw C formal, slot, or local.
# The C index emitter writes it. An L2 Structure path is not this.
fn: l2_raw_index_head (const: @(LmP0Text t); int: mi) int
    int: j
    size_t: base_end 0U
    LmP0Text: root
    if: l2_raw_head(t, mi, @ j) = 0
        return: 0
    if: l2_index_head(t, mi) != 0
        return: 1
    while: base_end < t\length && t\data[base_end] != 92 && t\data[base_end] != 91
        base_end: base_end + 1U
    root.data: t\data
    root.length: base_end
return: (cast: (int) (l2_raw_c_root(mi, @ root) = 0))

# 1: another head; 2: unsupported own-array index; 0: proven valid.
fn: l2_own_index_head (const: @(LmP0Text t); int: mi; @: int out_own; @: size_t out_index) int
    int: oi 0
    size_t: lb 0U
    LmP0Text: name_value
    @: LmP0Text name @ name_value
    if: mi < 0 || t = 0 || t\data = 0 || out_own = 0 || out_index = 0
        return: 1
    while: lb < t\length && t\data[lb] != 91
        lb: lb + 1U
    if: lb = t\length || lb = 0U
        return: 1
    # node/for (FABLE-SONNET-NODE-ROOT-20260923-121): no more literal-
    # spelling shortcut here -- l2_own_array_root_span refuses every rooted
    # array head uniformly now, node/for included, exactly like any other
    # general root (indexing into an Array-typed field of the resolved
    # root's type is a capability -119 already parked, not this ticket's
    # either). The bare (unrooted) own-array case just below is unaffected.
    oi: l2_own_array_root_span(mi, t, lb)
    if: oi >= 0
        if: t\data[t\length - 1U] != 93
            return: 2
        if: l2_array_literal(oi, t, lb + 1U, t\length - 1U, out_index) != 0
            return: 2
        \out_own: oi
        return: 0
    name\data: t\data
    name\length: lb
    oi: l2_resolved_own(mi, name)
    if: oi < 0 || l2_own_is_array(l2_own_ty[oi]) = 0
        return: 1
    if: t\data[t\length - 1U] != 93 || l2_array_literal(oi, t, lb + 1U, t\length - 1U, out_index) != 0
        return: 2
    \out_own: oi
return: 0

# length() consumes a known own-array reference without exposing that reference.
# A declared method called length takes precedence at the normal resolver.
fn: l2_array_length_own (const: @(LmP0Node node); int: mi) int
    @: LmP0Field arg
    @: LmP0Field slash
    @: LmP0Field name
    int: count
    int: oi
    if: mi < 0 || l2_frame_head(node, "length") = 0
        return: -1
    if: node\as\frame\trailer != 0 || node\as\frame\body = 0
        return: -1
    if: node\as\frame\body\trailer != 0
        return: -1
    arg: l2_next_active(node\as\frame\body\first_field)
    if: arg = 0 || arg\value = 0 || arg\value\kind != c.LM_P0_NODE_ATOM
        return: -1
    count: l2_count_active(node\as\frame\body)
    oi: -1
    if: count = 1
        oi: l2_resolved_own(mi, arg\value\as\atom)
    if: count = 3 && (l2_text_eq(arg\value\as\atom, "for") || l2_text_eq(arg\value\as\atom, "node") || l2_own_visible(mi, arg\value\as\atom) >= 0 || l2_formal_find(mi, arg\value\as\atom) >= 0)
        slash: l2_next_active(arg\next)
        name: l2_next_active(slash\next)
        if: slash\value = 0 || slash\value\kind != c.LM_P0_NODE_ATOM || l2_is_slash(slash\value\as\atom) = 0
            return: -1
        if: name = 0 || name\value = 0 || name\value\kind != c.LM_P0_NODE_ATOM
            return: -1
        oi: l2_own_array_root(mi, arg\value\as\atom, name\value\as\atom)
        ---
    ---
    if: oi < 0
        return: -1
    if: l2_own_is_array(l2_own_ty[oi]) = 0 || l2_own_count[oi] = 0
        return: -1
return: oi

# This bootstrap admits only positive decimal extents, never the empty ABI.
fn: l2_positive_decimal (const: @(LmP0Text t)) size_t
    size_t: n 0U
    size_t: i 0U
    size_t: digit
    if: t = 0 || t\data = 0 || t\length = 0U
        return: 0U
    while: i < t\length
        if: t\data[i] < 48 || t\data[i] > 57
            return: 0U
        digit: (cast: (size_t) (t\data[i] - 48))
        if: n > (((cast: (size_t) -1) - digit) / 10U)
            return: 0U
        n: n * 10U + digit
        i: i + 1U
    ---
    return: n

# Value of a size_t literal as written, INCLUDING the U suffix that l2_num
# accepts. l2_positive_decimal refuses any non-digit and therefore returns 0
# for "3U", which silently stored zero in every qualified branch and every
# merge body field until a content check caught it.
fn: l2_literal_value (const: @(LmP0Text t)) size_t
    size_t: n 0U
    size_t: i 0U
    size_t: stop
    size_t: digit
    if: t = 0 || t\data = 0 || t\length = 0U
        return: 0U
    stop: t\length
    if: t\data[stop - 1U] = 85 || t\data[stop - 1U] = 117
        stop: stop - 1U
    if: stop = 0U
        return: 0U
    while: i < stop
        if: t\data[i] < 48 || t\data[i] > 57
            return: 0U
        digit: (cast: (size_t) (t\data[i] - 48))
        if: n > (((cast: (size_t) -1) - digit) / 10U)
            return: 0U
        n: n * 10U + digit
        i: i + 1U
    ---
return: n

fn: l2_array_count_is (const: @(LmP0Text t)) int
    if: l2_num(t) = 0
        return: 0
    # l2_literal_value returns zero for both the valid empty extent and an
    # overflow. l2_num rejects leading zeroes, so only 0/0U/0u may use zero.
    if: l2_literal_value(t) != 0U
        return: 1
    if: t != 0 && t\data != 0 && t\data[0] = 48
        return: 1
return: 0

fn: l2_own_array_count (const: @(LmP0Node stmt)) @: LmP0Text
    @: L2Declaration application l2_declaration(stmt)
    if: application = 0 || application\contract\kind != 1 || application\extent = 0
        return: 0
    if: l2_contract_own(application\contract) = 0
        return: 0
    if: l2_array_count_is(application\extent) != 0
        return: application\extent
return: l2_define_count(application\extent)


fn: l2_own_decl_name (const: @(LmP0Node stmt)) @: LmP0Text
    @: L2Declaration application l2_declaration(stmt)
    # K03 NS-ROLES-1b: a binding `b: tick` declares b.
    if: l2_rb_meth_of(stmt) >= 0 && stmt\as != 0 && stmt\as\frame != 0
        return: stmt\as\frame\head
    if: application = 0
        return: 0
return: application\name

# A by-value local of a language numeric type (spec 6.6) is a Message-owned cell;
# a type whose owned domain is not implemented yet is refused by name, never
# emitted as activation C storage (e2 ruling 2026-09-14, model §21).
fn: l2_unimpl_numeric (const: @(LmP0Node stmt)) const: @: char
    if: stmt = 0 || stmt\kind != c.LM_P0_NODE_FRAME || stmt\as = 0 || stmt\as\frame = 0 || stmt\as\frame\body = 0
        return: 0
    if: l2_count_active(stmt\as\frame\body) != 1 && l2_count_active(stmt\as\frame\body) != 2
        return: 0
    if: l2_frame_head(stmt, "float")
        return: "by-value float local not yet implemented"
    if: l2_frame_head(stmt, "short")
        return: "by-value short local not yet implemented"
    if: l2_frame_head(stmt, "signed")
        return: "by-value signed local not yet implemented"
    if: l2_frame_head(stmt, "_Bool")
        return: "by-value _Bool local not yet implemented"
    if: l2_frame_head(stmt, "double")
        return: "by-value double local not yet implemented"
    if: l2_frame_head(stmt, "long")
        return: "by-value long local not yet implemented"
    if: l2_frame_head(stmt, "llong")
        return: "by-value llong local not yet implemented"
    if: l2_frame_head(stmt, "ullong")
        return: "by-value ullong local not yet implemented"
    if: l2_frame_head(stmt, "uint")
        return: "by-value uint local not yet implemented"
    if: l2_frame_head(stmt, "u8") || l2_frame_head(stmt, "u16") || l2_frame_head(stmt, "u32") || l2_frame_head(stmt, "u64")
        return: "by-value unsigned fixed-width local not yet implemented"
    if: l2_frame_head(stmt, "i8") || l2_frame_head(stmt, "i16") || l2_frame_head(stmt, "i32") || l2_frame_head(stmt, "i64")
        return: "by-value signed fixed-width local not yet implemented"
    if: l2_frame_head(stmt, "wchar_t")
        return: "by-value wchar_t local not yet implemented"
return: 0

# Whether the n fields from first are one value (book section 9): what the
# operand reader spans -- one atom, one operator run, one Frame.  A call, a receiver's too, is its Frame, `make: 3`,
# `make(3)`, `merge: A C`: neither `make 3` nor `merge A C` is one value (the author, 2026-10-06).
fn: l2_fields_one_value (@: LmP0Field first; int: n) int
    @: LmP0Field f l2_next_active(first)
    if: n < 1 || f = 0 || f\value = 0
        return: 0
    if: l2_expr_span(f) = n
        return: 1
return: 0

# A declaration's candidate is one value (DECLARATION-CANDIDATE-ROLE): the first value past it is refused where it
# stands, whether or not anything reads the declared name.
fn: l2_check_one_value (@: LmP0Field first; int: n; const: @(char path)) int
    @: LmP0Field f l2_next_active(first)
    @: LmP0Field extra
    if: l2_fields_one_value(f, n) != 0
        return: 0
    extra: l2_skip_span(f, l2_expr_span(f))
    if: extra = 0 || extra\value = 0
        extra: f
return: l2_error(path, extra\value, "a declaration takes one value")

fn: l2_own_decl_ty (const: @(LmP0Node stmt)) int
    @: L2Declaration application l2_declaration(stmt)
    # K03 NS-ROLES-1b: a binding `b: tick` declares a reference cell holding tick's occurrence.
    if: l2_rb_meth_of(stmt) >= 0
        return: l2_own_ty_of_param(l2_graph_ft())
    if: application = 0
        return: 0
    # Under a type word alone, a tail that is not one operand declares nothing (a call, a statement).  A declaration
    # word -- `[]`, `@`, `const`, `immutable`, `independent` -- declares whatever its candidate: a candidate that is
    # not one value is refused by the check (l2_check_one_value), and the declaration is never taken for another role,
    # a machine local with the model (DECLARATION-CANDIDATE-ROLE).
    if: application\contract\kind = 0 && application\candidate_count > 0 && l2_expr_span(application\candidate) != application\candidate_count
        return: 0
    if: application\contract\kind = 1 && l2_own_array_count(stmt) = 0
        return: 0
return: l2_contract_own(application\contract)

fn: l2_own_is_array (int: ty) int
    if: ty = 4 || ty = 5 || ty = 7 || ty = 8 || ty = 37 || l2_oc_is_parray(ty) != 0
        return: 1
return: 0

fn: l2_own_is_pointer (int: ty) int
return: l2_oc_is_pointer(ty)

# The L1 spelling of raw pointer type `raw` with extra_depth more address levels, into dest: the
# type alone (name 0), or a declarator of `name` -- a const type keeps the name inside
# `const: @(... name)`, where appending it after the closing parenthesis would be invalid L1.
fn: l2_formal_raw (int: ty) int
    # The graph code is spelled as the source type it is, `Lmx *`.
    if: ty = l2_graph_code()
        return: l2_oc_ft(l2_graph_own())
return: ty

# The representation of a primitive/foreign type, shared by pointer spelling
# and address typing. The word borrows stable source/literal bytes.
fn: l2_type_parts (int: raw; @: LmP0Text word; @: int out_depth; @: int out_qualified) int
    int: fi raw - 100
    int: depth 0
    int: is_const 0
    const: @(char base) l2_prim_code_name(raw)
    if: raw = 3
        base: "char"
        depth: 1
        is_const: 1
    if: raw = l2_msg_ref_ty()
        base: "LmxMsg"
        depth: 1
        is_const: 1
    if: raw = 9
        base: "size_t"
        depth: 1
    if: raw = 11
        base: "int"
        depth: 1
    if: raw = 12
        base: "char"
        depth: 1
    if: raw = 16
        base: "void"
        depth: 1
    if: raw = 25
        base: "unsigned"
        depth: 1
    if: raw = 38
        base: "ulong"
        depth: 1
    if: raw = 17
        base: "char"
        depth: 2
    if: raw = 18
        base: "void"
        depth: 2
    if: raw = 19
        base: "int"
        depth: 2
    if: raw = 20
        base: "size_t"
        depth: 2
    if: raw = 24
        base: "unsigned"
        depth: 2
    if: raw = 39
        base: "ulong"
        depth: 2
    if: raw >= 100
        if: fi < 0 || fi >= l2_foreign_n
            return: 1
        depth: l2_foreign_depth[fi]
        is_const: l2_foreign_const[fi]
        word\data: l2_foreign_name[fi]\data
        word\length: l2_foreign_name[fi]\length
    else:
        if: base = 0
            return: 1
        word\data: base
        word\length: strlen(base)
    ---
    \out_depth: depth
    \out_qualified: is_const
return: 0

fn: l2_address_type (int: ty) int
    LmP0Text: word_value
    @: LmP0Text word @ word_value
    int: depth
    int: qualified
    int: result
    ty: l2_formal_raw(ty)
    if: l2_type_parts(ty, word, @ depth, @ qualified) != 0
        return: 0 - 1
    if: qualified = 0 && l2_ptr_type_word(word, depth + 1, @ result) = 0
        return: result
return: l2_foreign_intern(word, depth + 1, qualified)

# One ordinary pointer indirection, retaining the exact closed pointee contract.
fn: l2_indirect_type (int: ty) int
    LmP0Text: word_value
    @: LmP0Text word @ word_value
    int: depth
    int: qualified
    int: result
    if: l2_type_parts(l2_formal_raw(ty), word, @ depth, @ qualified) != 0 || depth < 1
        return: -1
    if: depth = 1
        if: l2_ret_type_word(word, 0, 0, @ result) != 0 || result = 8
            return: -1
        if: result = 33
            result: 34
        return: result
    if: qualified = 0 && l2_ptr_type_word(word, depth - 1, @ result) = 0
        return: result
return: l2_foreign_intern(word, depth - 1, qualified)

# A borrowed prefix-dereference name view. No replacement source node or
# receiving-type guess: the existing binding supplies the pointer contract.
fn: l2_indirect_span (@: L2ValueSpan span; int: mi; @: L2ValueSpan operand; @: int levels; @: int source_type; @: int result_type) int
    @: LmP0Field f l2_next_active(span\first)
    L2Address: address
    L2IndexedOperand: indexed
    @: char text 0
    int: count span\count
    int: depth 0
    int: ty
    int: kind
    int: raw
    int: saved_mi
    \levels: 0
    while: count > 0 && f != 0 && f\value != 0 && f\value\kind = c.LM_P0_NODE_ATOM && f\value\as != 0 && l2_is_slash(f\value\as\atom) != 0
        \levels: \levels + 1
        count: count - 1
        f: l2_next_active(f\next)
    if: \levels = 0 || count < 1 || f = 0 || l2_operand_run(f, count) != count
        return: 1
    operand\first: f
    operand\count: count
    operand\node: f\value
    if: l2_indexed_operand(f, count, mi, @ indexed) = 0 && indexed.count = count
        ty: indexed.type
    else:
        if: l2_address_operand(f, count, mi, @ address) = 0
            ty: address.type
        else:
            if: count = 1
                if: l2_colon_value_ty(f\value, mi, @ ty) != 0
                    return: 1
                ---
            else:
                text: l2_address_path_text(f, count)
                if: text = 0
                    return: 1
                saved_mi: l2_cur_mi
                l2_cur_mi: mi
                kind: l2_path_contract(text, strlen(text), @ raw, 0)
                l2_cur_mi: saved_mi
                l2_xfree(text)
                ty: l2_path_kind_ft(kind)
                if: kind = 10 || kind = 11
                    ty: raw
                if: ty < 0
                    return: 1
            ---
        ---
    ---
    \source_type: ty
    while: depth < \levels
        ty: l2_indirect_type(ty)
        if: ty < 0
            return: 1
        depth: depth + 1
    \result_type: ty
return: 0

# Materialize the pointer expression once before spelling a raw indirection.
# L1 accepts a named operand here; a cast/function expression must not be
# concatenated after a bare prefix token.
fn: l2_emit_indirect_span (@: L2ValueSpan operand; int: levels; int: source_type; int: mi; const: @(char ind); @: L2Tx dest) int
    []: char value_own 1024
    L2Tx: value_tx
    @: L2Tx value @ value_tx
    []: char name 64
    []: char declaration_own 1024
    L2Tx: declaration_tx
    @: L2Tx declaration l2_tx_local(@ declaration_tx, declaration_own, 1024U)
    int: i 0
    int: t
    if: l2_tx_open(value, value_own, 1024U) != 0 || l2_eval_fields(operand\first, operand\count, mi, ind, value) != 0
        return: 1
    t: l2_tn
    l2_tn: l2_tn + 1
    if: c.sprintf(name, "l2_t%d", t) < 0 || l2_pointer_decl_text(l2_formal_raw(source_type), 0, name, declaration) != 0 || c.fprintf(l2_out, "%s%s %s\n", ind, declaration\data, value\data) < 0
        return: 1
    # As many indirections as the operand is written with, then the temporary's name.
    if: l2_tx_clear(dest) != 0
        return: 1
    while: i < levels
        if: l2_tx_cat(dest, "\\") != 0
            return: 1
        i: i + 1
    ---
return: l2_tx_cat(dest, name)

fn: l2_deref_name (const: @(LmP0Text text); @: LmP0Text base; @: int levels) int
    size_t: lead 0U
    if: text = 0 || text\data = 0
        return: 1
    while: lead < text\length && text\data[lead] = 92
        lead: lead + 1U
    if: lead = 0U || lead = text\length || lead > (cast: (size_t) c.INT_MAX)
        return: 1
    base\data: text\data + lead
    base\length: text\length - lead
    if: l2_ident(base) = 0
        return: 1
    \levels: (cast: (int) lead)
return: 0

fn: l2_deref_word (const: @(LmP0Text text); int: mi; @: LmP0Text base; @: int levels; @: int result) int
    int: ty
    int: i 0
    if: l2_deref_name(text, base, levels) != 0 || l2_colon_bound_ty(mi, base, @ ty) != 0
        return: 1
    while: i < \levels
        ty: l2_indirect_type(ty)
        if: ty < 0
            return: 1
        i: i + 1
    \result: ty
return: 0

# Snapshot the resolved final place before any receiving expression can change
# a binding used to select it. The store still addresses the original storage.
fn: l2_capture_indirect_place (int: value_type; const: @(char ind); @: L2Tx place) int
    []: char name 48
    []: char declaration_own 256
    L2Tx: declaration_tx
    @: L2Tx declaration l2_tx_local(@ declaration_tx, declaration_own, 256U)
    int: address_type l2_address_type(value_type)
    if: place = 0 || place\data = 0 || place\data[0] != 92 || address_type < 0 || declaration = 0
        return: 1
    c.snprintf(name, 48U, "l2_t%d", l2_tn)
    l2_tn: l2_tn + 1
    if: l2_pointer_decl_text(address_type, 0, name, declaration) != 0
        return: 1
    if: c.fprintf(l2_out, "%s%s %s\n", ind, declaration\data, place\data + 1U) < 0
        return: 1
return: l2_tx_join(place, "\\", name, 0, 0, 0)

fn: l2_pointer_decl_text (int: raw; int: extra_depth; const: @(char name); @: L2Tx dest) int
    LmP0Text: word_value
    @: LmP0Text word @ word_value
    int: depth
    int: is_const
    int: i 0
    if: dest = 0 || extra_depth < 0 || l2_type_parts(raw, word, @ depth, @ is_const) != 0 || depth + extra_depth < 1
        return: 1
    depth: depth + extra_depth
    if: l2_tx_clear(dest) != 0
        return: 1
    if: is_const != 0 && l2_tx_cat(dest, "const: ") != 0
        return: 1
    while: i < depth
        if: l2_tx_cat(dest, "@") != 0
            return: 1
        i: i + 1
    ---
    if: is_const != 0 && l2_tx_cat(dest, "(") != 0
        return: 1
    if: is_const = 0 && l2_tx_cat(dest, ": ") != 0
        return: 1
    # The type's word as it is written, of any length.
    if: l2_tx_catn(dest, word\data, word\length) != 0
        return: 1
    if: name != 0 && (l2_tx_cat(dest, " ") != 0 || l2_tx_cat(dest, name) != 0)
        return: 1
    if: is_const != 0 && l2_tx_cat(dest, ")") != 0
        return: 1
return: 0

# The same resolved type supplies exact automatic value storage or its address
# parameter. This is spelling only; foreign values do not gain walker support.
fn: l2_value_decl_text (int: raw; int: extra_depth; const: @(char name); @: L2Tx dest) int
    LmP0Text: word_value
    @: LmP0Text word @ word_value
    int: depth
    int: qualified
    if: dest = 0 || name = 0 || extra_depth < 0 || l2_type_parts(raw, word, @ depth, @ qualified) != 0
        return: 1
    if: depth + extra_depth > 0
        return: l2_pointer_decl_text(raw, extra_depth, name, dest)
    if: qualified != 0
        return: 1
    if: l2_tx_wrapn(dest, 0, word\data, word\length, ": ") != 0
        return: 1
return: l2_tx_cat(dest, name)

fn: l2_emit_raw_pointer_type (@: FILE out; int: raw; int: extra_depth) int
    []: char txt_own 1024
    L2Tx: txt_tx
    @: L2Tx txt l2_tx_local(@ txt_tx, txt_own, 1024U)
    if: out = 0 || l2_pointer_decl_text(raw, extra_depth, 0, txt) != 0
        return: 1
return: (cast: (int) (fputs(txt\data, out) < 0))
fn: l2_emit_own_pointer_type (@: FILE out; int: ty) int
    if: l2_oc_is_pointer(ty) = 0
        return: 1
return: l2_emit_raw_pointer_type(out, l2_oc_ft(ty), 0)

# Type of Array<@^n T>.data is @^(n+1) T. The extra level is the address of
# the contiguous element backing, not a replacement void** representation.
fn: l2_emit_own_pointer_array_data_type (@: FILE out; int: ty) int
    if: l2_oc_is_parray(ty) = 0
        return: 1
return: l2_emit_raw_pointer_type(out, l2_oc_ft(ty), 1)

fn: l2_own_store_ty (int: dty) int
    if: dty = 3
        return: 0
    if: dty = 6
        return: 3
return: dty

fn: l2_scope_free () int
    if: l2_scope_at != 0
        l2_xfree((cast: (@: void) l2_scope_at))
    l2_scope_at: 0
    l2_scope_n: 0
    l2_scope_cap: 0
return: 0

# Emitted indentation strings are translation-owned scratch values. Keep every
# returned pointer stable until the unit is finished; the table and strings grow
# from the actual nesting encountered rather than imposing a language depth.
fn: l2_indent_free () int
    int: i 0
    while: i < l2_indent_n
        if: l2_indent_at[i] != 0
            l2_xfree((cast: (@: void) l2_indent_at[i]))
        i: i + 1
    if: l2_indent_at != 0
        l2_xfree((cast: (@: void) l2_indent_at))
    l2_indent_at: 0
    l2_indent_n: 0
    l2_indent_cap: 0
return: 0

fn: l2_indent_reserve (int: need) int
    size_t: cap
    size_t: need_u
    size_t: psz
    size_t: nb
    @@: char nn 0
    int: i 0
    if: need < 0
        l2_alloc_err: 2
        return: 1
    if: need <= l2_indent_cap
        return: 0
    need_u: (cast: (size_t) need)
    cap: (cast: (size_t) l2_indent_cap)
    if: cap < 1U
        cap: 4U
    while: cap < need_u
        if: cap > ((cast: (size_t) c.INT_MAX) / 2U)
            cap: need_u
        else:
            cap: cap * 2U
        ---
    if: cap > (cast: (size_t) c.INT_MAX)
        l2_alloc_err: 2
        return: 1
    psz: c.sizeof(@: char)
    if: l2_mul_ok(cap, psz) = 0
        l2_alloc_err: 2
        return: 1
    nb: cap * psz
    l2_alloc_kind: 8
    nn: (cast: (@@: char) l2_xmalloc(nb))
    if: nn = 0
        return: 1
    memset((cast: (@: void) nn), 0, nb)
    while: i < l2_indent_n
        nn[i]: l2_indent_at[i]
        i: i + 1
    if: l2_indent_at != 0
        l2_xfree((cast: (@: void) l2_indent_at))
    l2_indent_at: nn
    l2_indent_cap: (cast: (int) cap)
return: 0

fn: l2_pub_free () int
    if: l2_pub_tmp != 0
        l2_xfree((cast: (@: void) l2_pub_tmp))
    if: l2_pub_bak != 0
        l2_xfree((cast: (@: void) l2_pub_bak))
    l2_pub_tmp: 0
    l2_pub_bak: 0
    l2_pub_bak_cap: 0U
return: 0

# Publication filenames grow from the actual destination path. The decimal
# suffix bound is derived from size_t width (three decimal digits per byte is
# safely above log10(256)); it is not a count of allowed backup candidates.
fn: l2_pub_prepare (const: @(char out_path)) int
    size_t: pn
    size_t: tmp_n
    size_t: bak_extra
    size_t: bak_n
    @: char nt 0
    @: char nb 0
    if: out_path = 0
        return: 1
    pn: strlen(out_path)
    if: pn > ((cast: (size_t) -1) - 5U)
        l2_alloc_err: 2
        return: 1
    tmp_n: pn + 5U
    if: c.sizeof(c.size_t) > (((cast: (size_t) -1) - 6U) / 3U)
        l2_alloc_err: 2
        return: 1
    bak_extra: 6U + c.sizeof(c.size_t) * 3U
    if: pn > ((cast: (size_t) -1) - bak_extra)
        l2_alloc_err: 2
        return: 1
    bak_n: pn + bak_extra
    l2_alloc_kind: 9
    nt: (cast: (@: char) l2_xmalloc(tmp_n))
    nb: (cast: (@: char) l2_xmalloc(bak_n))
    if: nt = 0 || nb = 0
        if: nt != 0
            l2_xfree((cast: (@: void) nt))
        if: nb != 0
            l2_xfree((cast: (@: void) nb))
        return: 1
    memcpy(nt, out_path, pn)
    nt[pn]: 46
    nt[pn + 1U]: 116
    nt[pn + 2U]: 109
    nt[pn + 3U]: 112
    nt[pn + 4U]: 0
    memcpy(nb, out_path, pn)
    nb[pn]: 46
    nb[pn + 1U]: 98
    nb[pn + 2U]: 97
    nb[pn + 3U]: 107
    nb[pn + 4U]: 0
    l2_pub_tmp: nt
    l2_pub_bak: nb
    l2_pub_bak_cap: bak_n
return: 0

fn: l2_scope_reserve (int: need) int
    size_t: cap
    size_t: need_u
    size_t: psz
    size_t: nb
    @@: LmP0Node nn 0
    int: i
    if: need < 0
        return: 1
    if: need <= l2_scope_cap
        return: 0
    if: need > c.INT_MAX
        l2_alloc_err: 2
        return: 1
    need_u: (cast: (size_t) need)
    cap: (cast: (size_t) l2_scope_cap)
    if: cap < 1U
        cap: 4U
    while: cap < need_u
        if: cap > ((cast: (size_t) -1) / 2U)
            l2_alloc_err: 2
            return: 1
        cap: cap * 2U
    psz: c.sizeof(@: char)
    if: l2_mul_ok(cap, psz) = 0
        l2_alloc_err: 2
        return: 1
    nb: cap * psz
    l2_alloc_kind: 5
    nn: (cast: (@@: LmP0Node) l2_xmalloc(nb))
    if: nn = 0
        return: 1
    memset((cast: (@: void) nn), 0, nb)
    i: 0
    while: i < l2_scope_n
        nn[i]: l2_scope_at[i]
        i: i + 1
    if: l2_scope_at != 0
        l2_xfree((cast: (@: void) l2_scope_at))
    l2_scope_at: nn
    l2_scope_cap: (cast: (int) cap)
return: 0

fn: l2_scope_push (const: @(LmP0Node node)) int
    if: node = 0
        return: 1
    if: l2_scope_reserve(l2_scope_n + 1) != 0
        return: 1
    l2_scope_at[l2_scope_n]: (cast: (@: LmP0Node) node)
    l2_scope_n: l2_scope_n + 1
return: 0

fn: l2_scope_pop () int
    if: l2_scope_n <= 0
        return: 1
    l2_scope_n: l2_scope_n - 1
    l2_scope_at[l2_scope_n]: 0
return: 0

fn: l2_scope_has (const: @(LmP0Node node)) int
    int: i 0
    if: node = 0
        return: 0
    while: i < l2_scope_n
        if: l2_scope_at[i] = node
            return: 1
        i: i + 1
return: 0

fn: l2_scope_host () @: LmP0Node
    if: l2_scope_n <= 0
        return: 0
return: l2_scope_at[l2_scope_n - 1]

fn: l2_for_free () int
    l2_source_containers_free()
    l2_graph_places_free()
    if: l2_for_node != 0
        l2_xfree((cast: (@: void) l2_for_node))
    if: l2_for_uchild != 0
        l2_xfree((cast: (@: void) l2_for_uchild))
    if: l2_for_nkid != 0
        l2_xfree((cast: (@: void) l2_for_nkid))
    if: l2_for_mi != 0
        l2_xfree((cast: (@: void) l2_for_mi))
    if: l2_for_parent != 0
        l2_xfree((cast: (@: void) l2_for_parent))
    if: l2_for_stmt != 0
        l2_xfree((cast: (@: void) l2_for_stmt))
    l2_for_node: 0
    l2_for_stmt: 0
    l2_for_uchild: 0
    l2_for_nkid: 0
    l2_for_mi: 0
    l2_for_parent: 0
    l2_for_n: 0
    l2_for_cap: 0
return: 0

# Release each stable edge, body index and live field places on translation reset
# and final release. All storage participates in the translator's counted allocator.
fn: l2_graph_places_free () int
    @: L2GraphPlace place
    while: l2_graph_places != 0
        place: l2_graph_places
        l2_graph_places: place\allocated_next
        l2_xfree((cast: (@: void) place))
    if: l2_for_place != 0
        l2_xfree((cast: (@: void) l2_for_place))
    if: l2_own_places != 0
        l2_xfree((cast: (@: void) l2_own_places))
    l2_for_place: 0
    l2_own_places: 0
    l2_graph_places_last: 0
    l2_graph_place_n: 0U
return: 0

fn: l2_graph_place_new (int: mi; @: L2GraphPlace parent; size_t: child) @: L2GraphPlace
    @: L2GraphPlace place
    l2_alloc_kind: 5
    place: (cast: (@: L2GraphPlace) l2_xmalloc(c.sizeof(c.L2GraphPlace)))
    if: place = 0
        return: 0
    place\id: l2_graph_place_n
    l2_graph_place_n: l2_graph_place_n + 1U
    place\method: mi
    place\child: child
    place\parent: parent
    place\allocated_next: 0
    if: l2_graph_places_last = 0
        l2_graph_places: place
    else:
        l2_graph_places_last\allocated_next: place
    ---
    l2_graph_places_last: place
return: place

fn: l2_source_containers_free () int
    @: L2SourceContainer row
    @: L2ConstructionTemp temp
    @: L2SourceField field
    while: l2_source_containers != 0
        row: l2_source_containers
        l2_source_containers: row\allocated_next
        while: row\fields != 0
            field: row\fields
            row\fields: field\next
            l2_xfree((cast: (@: void) field))
        l2_xfree((cast: (@: void) row))
    while: l2_construct_temps != 0
        temp: l2_construct_temps
        l2_construct_temps: temp\allocated_next
        l2_xfree((cast: (@: void) temp))
    if: l2_for_transferred != 0
        l2_xfree((cast: (@: void) l2_for_transferred))
    l2_for_transferred: 0
    l2_construct_phase: -1
    l2_construct_view_index: -1
    l2_source_next_id: 0U
return: 0

# The source key includes the actual construction view. Two projected bodies
# from one model are two occurrences, not a P0-pointer keyed singleton.
fn: l2_source_container (@: LmP0Structure body; int: inert) @: L2SourceContainer
    @: L2SourceContainer row l2_source_containers
    @: LmP0Node node
    int: fid 0
    while: row != 0
        if: row\view_kind = l2_construct_view_kind && row\view_index = l2_construct_view_index && row\body = body
            return: row
        row: row\allocated_next
    ---
    if: l2_construct_phase != 0 || l2_construct_view_index < 0
        return: 0
    l2_alloc_kind: 5
    row: (cast: (@: L2SourceContainer) l2_xmalloc(c.sizeof(c.L2SourceContainer)))
    if: row = 0
        return: 0
    row\view_kind: l2_construct_view_kind
    row\id: l2_source_next_id
    l2_source_next_id: l2_source_next_id + 1U
    row\view_index: l2_construct_view_index
    row\source_mi: l2_rw_mi
    row\body: body
    row\inert: inert
    row\root: 0
    row\fid: -1
    row\width: 0
    row\temp: -1
    row\fills: 0
    row\shell_state: 0
    row\place: 0
    row\fields: 0
    if: row\view_kind = 0
        while: fid < l2_for_n
            node: l2_for_node[fid]
            if: l2_for_owner(fid) = row\view_index && node != 0 && node\as != 0 && node\kind = c.LM_P0_NODE_STRUCTURE && node\as\structure = body
                row\fid: fid
                fid: l2_for_n
            ---
            # A Frame may itself own this whole body (e.g. ELSE). A FOR
            # header or CATCH signature is not its nested executable body.
            if: fid < l2_for_n && l2_for_owner(fid) = row\view_index && node != 0 && node\as != 0 && node\kind = c.LM_P0_NODE_FRAME && node\as\frame != 0 && node\as\frame\body = body
                row\fid: fid
                fid: l2_for_n
            ---
            fid: fid + 1
        ---
    row\allocated_next: l2_source_containers
    l2_source_containers: row
return: row

# The committed actual body corresponding to an old physical allocation.
# Matching source identity chooses its producer; a runtime pointer does not.
fn: l2_source_materialized (int: fid) @: L2SourceContainer
    @: L2SourceContainer row l2_source_containers
    if: fid < 0
        return: 0
    while: row != 0
        if: row\fid = fid && row\inert = 0
            return: row
        row: row\allocated_next
    ---
return: 0

# The execution root is an existing occurrence, not a new storage object.
fn: l2_source_root (int: mi) @: L2SourceContainer
    @: L2SourceContainer row l2_source_containers
    while: row != 0
        if: row\view_kind = 0 && row\view_index = mi && row\root != 0
            return: row
        row: row\allocated_next
    ---
return: 0

# Constructor ownership is committed from exact declarations, independently
# of the declaration's former packed child or control-scope classification.
fn: l2_source_owns (int: own) int
    @: L2SourceContainer row l2_source_containers
    @: L2SourceField field
    while: row != 0
        if: row\view_kind = 0 && row\inert = 0
            field: row\fields
            while: field != 0
                if: field\own = own
                    return: 1
                field: field\next
            ---
        ---
        row: row\allocated_next
    ---
return: 0

fn: l2_source_field_slot (@: L2SourceContainer row; int: own; int: slot) int
    @: L2SourceField field row\fields
    while: field != 0
        if: field\own = own
            if: field\slot != slot
                return: l2_error(l2_src, l2_own_decl[own], "internal: a declaration changed source slot")
            return: 0
        field: field\next
    ---
    if: l2_construct_phase != 0
        return: l2_error(l2_src, l2_own_decl[own], "internal: a declaration has no source slot")
    l2_alloc_kind: 5
    field: (cast: (@: L2SourceField) l2_xmalloc(c.sizeof(c.L2SourceField)))
    if: field = 0
        return: l2_alloc_or(l2_src, l2_own_decl[own], "source field slots could not be allocated")
    field\own: own
    field\slot: slot
    field\storage_temp: -1
    field\place.holder: 0
    field\place.child: (cast: (size_t) slot)
    field\next: row\fields
    row\fields: field
return: 0

# Existing producer/declaration evidence distinguishes output storage from a
# written typed declaration. Source identity is borrowed; no receiver-name
# switch or additional runtime annotation is needed.
fn: l2_own_computed (int: own) int
    @: L2Declaration declaration
    if: own < 0 || own >= l2_own_n
        return: 0
    if: l2_mres_of_own(own) >= 0
        return: 1
    # An explicit pointer-value declaration owns its typed cell, even when
    # its initializer is computed. It is not a receiver's output operand.
    if: l2_own_is_slot(own) = 0
        return: 0
    declaration: l2_declaration(l2_own_decl[own])
    if: declaration = 0 || declaration\name != l2_own_name[own]
        return: 0
return: (cast: (int) (l2_contract_own(declaration\contract) = 0))

# Only an actual committed GLOBAL fill owns this source occurrence. Position
# or nesting alone does not establish a producer (notably for PAP/T7 views).
fn: l2_source_global (@: LmP0Structure body) int
    int: i 0
    int: fid
    @: LmP0Node node
    if: l2_construct_view_kind != 0
        return: 0
    # A committed root owns its original source bodies. The legacy GLOBAL
    # producer must not suppress their source fields during this traversal.
    if: l2_source_root(l2_construct_view_index) != 0
        return: 0
    while: i < l2_fill_n
        fid: l2_fill_k[i]
        node: l2_for_node[fid]
        if: l2_for_owner(fid) = l2_construct_view_index && node != 0 && node\as != 0 && node\kind = c.LM_P0_NODE_STRUCTURE && node\as\structure = body
            return: 1
        i: i + 1
    ---
return: 0

# Inert children are now produced by their actual enclosing body, not both by
# its old storage prefix and its source traversal. Repack only the surviving
# prefix. A whole actual source body also owns its real declaration cells;
# a header scope without that source identity stays a distinct producer.
fn: l2_source_ownership_commit () int
    @: L2SourceContainer row l2_source_containers
    int: fid
    int: child
    int: oi
    int: width
    int: moved
    size_t: bytes
    if: l2_mul_ok((cast: (size_t) l2_for_n), c.sizeof(c.int)) = 0
        l2_alloc_err: 2
        return: l2_alloc_or(l2_src, 0, "internal: source producers could not be allocated")
    bytes: (cast: (size_t) l2_for_n) * c.sizeof(c.int)
    if: bytes > 0U
        l2_alloc_kind: 5
        l2_for_transferred: (cast: (@: int) l2_xmalloc(bytes))
        if: l2_for_transferred = 0
            return: l2_alloc_or(l2_src, 0, "internal: source producers could not be allocated")
        memset((cast: (@: void) l2_for_transferred), 0, bytes)
    ---
    while: row != 0
        if: row\fid >= 0
            l2_for_transferred[row\fid]: 1
        row: row\allocated_next
    ---
    fid: 0
    while: fid < l2_for_n
        moved: 0
        child: 0
        while: child < l2_for_n
            if: l2_for_parent[child] = fid && l2_for_transferred[child] != 0 && l2_for_uchild[child] >= 0
                moved: 1
            child: child + 1
        ---
        if: l2_for_transferred[fid] = 0 && moved != 0
            width: 0
            oi: 0
            while: oi < l2_own_n
                if: l2_own_fid[oi] = fid
                    width: width + 1
                oi: oi + 1
            ---
            child: 0
            while: child < l2_for_n
                if: l2_for_parent[child] = fid && l2_for_transferred[child] = 0 && l2_for_uchild[child] >= 0
                    l2_for_uchild[child]: width
                    width: width + 1
                child: child + 1
            ---
            l2_for_nkid[fid]: width
        ---
        fid: fid + 1
    ---
    if: l2_source_release_slots() != 0
        return: 1
    fid: 0
    while: fid < l2_for_n
        if: l2_for_transferred[fid] = 0 && l2_for_parent[fid] < 0 && l2_for_uchild[fid] >= 0 && (l2_m_src_end = 0 || l2_m_src_end[l2_for_owner(fid)] < 0)
            l2_for_uchild[fid]: l2_m_head(l2_for_owner(fid)) + l2_m_own_count(l2_for_owner(fid)) + l2_for_rank(fid)
        fid: fid + 1
    ---
return: 0

# Release obsolete source-order reservations together with their former
# producer. Otherwise skipping its allocation leaves a hole before the real
# source action. Apply one prefix projection to every surviving consumer.
fn: l2_source_release_slots () int
    int: mi 0
    int: fid
    int: oi
    int: k
    int: n
    int: removed
    int: marker
    int: slot
    @: int before
    @: LmP0Field original
    @: L2GraphField field
    if: l2_m_src_end = 0
        return: 0
    while: mi < l2_m_n
        n: l2_m_src_end[mi]
        if: n > 0
            l2_alloc_kind: 5
            before: (cast: (@: int) l2_xmalloc((cast: (size_t) n) * c.sizeof(c.int)))
            if: before = 0
                return: l2_alloc_or(l2_src, l2_m_node[mi], "source slot projection could not be allocated")
            memset((cast: (@: void) before), 0, (cast: (size_t) n) * c.sizeof(c.int))
            fid: 0
            while: fid < l2_for_n
                if: l2_for_owner(fid) = mi && l2_for_parent[fid] < 0 && l2_for_transferred[fid] != 0 && l2_for_uchild[fid] >= 0
                    before[l2_for_uchild[fid]]: 1
                fid: fid + 1
            ---
            removed: 0
            k: 0
            while: k < n
                marker: before[k]
                before[k]: removed
                removed: removed + marker
                k: k + 1
            ---
            if: removed != 0
                oi: 0
                while: oi < l2_own_n
                    if: l2_own_mi[oi] = mi && l2_own_fid[oi] < 0 && l2_own_uchild[oi] >= 0
                        slot: l2_own_uchild[oi]
                        l2_own_uchild[oi]: slot - before[slot]
                        field: l2_own_places + oi
                        field\child: (cast: (size_t) l2_own_uchild[oi])
                    ---
                    oi: oi + 1
                ---
                fid: 0
                while: fid < l2_for_n
                    if: l2_for_owner(fid) = mi && l2_for_parent[fid] < 0 && l2_for_transferred[fid] = 0 && l2_for_uchild[fid] >= 0
                        slot: l2_for_uchild[fid]
                        l2_for_uchild[fid]: slot - before[slot]
                        if: l2_for_place[fid] != 0
                            l2_for_place[fid]\child: (cast: (size_t) l2_for_uchild[fid])
                        ---
                    ---
                    fid: fid + 1
                ---
                original: l2_next_active(l2_m_body[mi]\as\structure\first_field)
                while: original != 0
                    k: 0
                    while: k < l2_ps_n
                        if: l2_ps_node[k] = original\value
                            slot: l2_ps_slot[k]
                            l2_ps_slot[k]: slot - before[slot]
                        ---
                        k: k + 1
                    ---
                    original: l2_next_active(original\next)
                ---
                l2_m_src_end[mi]: n - removed
            ---
            l2_xfree((cast: (@: void) before))
        ---
        mi: mi + 1
    ---
return: 0

fn: l2_construct_find (int: index) @: L2ConstructionTemp
    @: L2ConstructionTemp temp l2_construct_temps
    while: temp != 0
        if: temp\view_kind = l2_construct_view_kind && temp\view_index = l2_construct_view_index && temp\index = index
            return: temp
        temp: temp\allocated_next
    ---
return: 0

fn: l2_construct_begin (int: kind; int: index; int: phase) int
    l2_construct_view_kind: kind
    l2_construct_view_index: index
    l2_construct_phase: phase
    l2_rw_pn: 0
    l2_rw_nest: 0
    l2_rw_loops: 0
    l2_rw_shell_fid: -1
    l2_rw_conv: 0
return: 0

fn: l2_construct_temp (int: index; int: parent; int: root) int
    @: L2ConstructionTemp temp
    if: l2_construct_phase != 1
        return: 0
    if: l2_construct_find(index) != 0
        return: l2_error(l2_src, 0, "internal: a construction temp has two producers")
    l2_alloc_kind: 5
    temp: (cast: (@: L2ConstructionTemp) l2_xmalloc(c.sizeof(c.L2ConstructionTemp)))
    if: temp = 0
        return: l2_alloc_or(l2_src, 0, "internal: construction edges could not be allocated")
    temp\view_kind: l2_construct_view_kind
    temp\view_index: l2_construct_view_index
    temp\index: index
    temp\parent: parent
    temp\slot: -1
    temp\root: root
    temp\place: 0
    temp\allocated_next: l2_construct_temps
    l2_construct_temps: temp
return: 0

fn: l2_construct_link (int: parent; int: slot; int: child) int
    @: L2ConstructionTemp temp
    if: l2_construct_phase != 1
        return: 0
    temp: l2_construct_find(child)
    # Borrowed references do not establish an ownership edge or change parent.
    if: temp = 0 || temp\parent != parent || temp\root != 0
        return: 0
    if: temp\slot >= 0 && temp\slot != slot
        return: l2_error(l2_src, 0, "internal: a source allocation has two owning attachments")
    temp\slot: slot
return: 0

# Operation attachment may occur after its body is complete. Resolve the saved
# constructor edges only after PLACE, not from the last generated temp number.
fn: l2_construct_place (@: L2ConstructionTemp temp) @: L2GraphPlace
    @: L2ConstructionTemp parent
    @: L2SourceContainer source l2_source_containers
    @: L2GraphPlace place 0
    int: mi
    if: temp\root != 0
        return: 0
    if: temp\place != 0
        return: temp\place
    if: temp\slot < 0
        return: 0
    parent: l2_construct_find(temp\parent)
    if: parent = 0
        return: 0
    if: parent\root = 0
        place: l2_construct_place(parent)
        if: place = 0
            return: 0
        ---
    ---
    if: place != 0
        mi: place\method
    else:
        while: source != 0 && (source\view_kind != parent\view_kind || source\view_index != parent\view_index || source\temp != parent\index || source\root = 0)
            source: source\allocated_next
        if: source != 0
            mi: source\source_mi
        else:
            # Primary legacy/PAP roots directly identify their method. A
            # projected root must have the committed source owner above.
            if: temp\view_kind != 0
                l2_error(l2_src, 0, "internal: a projected place has no owning source root")
                return: 0
            mi: temp\view_index
        ---
    ---
    temp\place: l2_graph_place_new(mi, place, (cast: (size_t) temp\slot))
return: temp\place

fn: l2_source_places_bind () int
    @: L2SourceContainer row l2_source_containers
    @: L2ConstructionTemp temp
    @: L2GraphPlace place
    @: L2SourceField source_field
    @: L2GraphField field
    while: row != 0
        if: row\temp >= 0
            l2_construct_view_kind: row\view_kind
            l2_construct_view_index: row\view_index
            temp: l2_construct_find(row\temp)
            if: temp = 0
                return: l2_error(l2_src, 0, "internal: a retained source container has no producer")
            place: l2_construct_place(temp)
            if: place = 0 && temp\root = 0
                return: l2_error(l2_src, 0, "internal: a retained source container has no owning attachment")
            if: row\fid >= 0
                l2_for_place[row\fid]: place
            ---
            row\place: place
            source_field: row\fields
            while: source_field != 0
                source_field\place.holder: place
                source_field\place.child: (cast: (size_t) source_field\slot)
                if: l2_own_computed(source_field\own) != 0
                    temp: l2_construct_find(source_field\storage_temp)
                    if: temp = 0
                        return: l2_error(l2_src, l2_own_decl[source_field\own], "internal: an output operand has no producer")
                    source_field\place.holder: l2_construct_place(temp)
                    source_field\place.child: 1U
                    if: source_field\place.holder = 0
                        return: l2_error(l2_src, l2_own_decl[source_field\own], "internal: an output operand has no owning attachment")
                    ---
                ---
                # A projected construction owns its own field relation. Only
                # the original occurrence publishes the primary native map.
                if: row\view_kind = 0 && row\view_index = l2_own_mi[source_field\own]
                    field: l2_own_places + source_field\own
                    field\holder: source_field\place.holder
                    field\child: source_field\place.child
                    if: l2_own_fid[source_field\own] < 0
                        l2_own_uchild[source_field\own]: source_field\slot
                    else:
                        l2_own_fchild[source_field\own]: source_field\slot
                    ---
                ---
                source_field: source_field\next
            ---
        ---
        row: row\allocated_next
    ---
    l2_construct_view_index: -1
return: 0

# Verify the selected source producer itself: reachable shape alone cannot
# detect a repeated allocation which is later overwritten or left unreachable.
# The migrated inert rows are also excluded from the former GLOBAL builder.
fn: l2_source_fill (@: L2SourceContainer row) int
    if: l2_construct_phase != 2 || l2_rw_emit = 0
        return: 0
    if: row\fills != 0
        return: l2_error(l2_src, 0, "internal: a source container would be constructed twice")
    row\fills: 1
return: 0

fn: l2_source_fills_verify () int
    @: L2SourceContainer row l2_source_containers
    if: l2_construct_phase != 2
        return: 0
    while: row != 0
        if: row\view_kind = l2_construct_view_kind && row\view_index = l2_construct_view_index && row\fills != 1
            return: l2_error(l2_src, 0, "internal: a source container was not constructed")
        row: row\allocated_next
    ---
return: 0

# Seed the already-completed physical layout, without moving any source child.
# Only this adapter decodes the old packed/shell encoding. The backends consume
# child edges and neither inspect receiver names nor infer containers from scope.
fn: l2_graph_places_seed () int
    int: fid 0
    int: oi 0
    int: mi
    int: at
    int: pk
    size_t: bytes
    @: L2GraphPlace place
    @: L2GraphField field
    l2_graph_places_free()
    if: l2_mul_ok((cast: (size_t) l2_for_n), c.sizeof(@: L2GraphPlace)) = 0
        l2_alloc_err: 2
        return: l2_alloc_or(l2_src, 0, "internal: body place index could not be allocated")
    bytes: (cast: (size_t) l2_for_n) * c.sizeof(@: L2GraphPlace)
    if: bytes > 0U
        l2_alloc_kind: 5
        l2_for_place: (cast: (@@: L2GraphPlace) l2_xmalloc(bytes))
        if: l2_for_place = 0
            return: l2_alloc_or(l2_src, 0, "internal: body place index could not be allocated")
        memset((cast: (@: void) l2_for_place), 0, bytes)
    ---
    while: fid < l2_for_n
        mi: l2_for_owner(fid)
        pk: l2_for_parent[fid]
        place: 0
        if: l2_for_transferred != 0 && l2_for_transferred[fid] != 0
            l2_for_place[fid]: 0
            fid: fid + 1
            continue
        if: l2_for_uchild[fid] >= 0
            if: pk >= 0
                place: l2_for_place[pk]
                if: place = 0 || place\method != mi
                    return: l2_error(l2_src, l2_for_stmt[fid], "internal: a body has no containing graph place")
                ---
            place: l2_graph_place_new(mi, place, (cast: (size_t) l2_for_uchild[fid]))
            if: place = 0
                return: l2_alloc_or(l2_src, l2_for_stmt[fid], "internal: a body graph place could not be allocated")
            ---
        else:
            if: pk < 0 && (l2_for_uchild[fid] = 0 - 2 || l2_for_uchild[fid] = 0 - 3)
                at: l2_ps_lookup(l2_for_stmt[fid])
                if: at < 0
                    return: l2_error(l2_src, l2_for_stmt[fid], "internal: a body operator has no graph place")
                place: l2_graph_place_new(mi, 0, (cast: (size_t) at))
                if: place != 0
                    if: l2_for_uchild[fid] = 0 - 2
                        place: l2_graph_place_new(mi, place, 2U)
                    else:
                        place: l2_graph_place_new(mi, place, 1U)
                    ---
                if: place != 0
                    place: l2_graph_place_new(mi, place, 0U)
                if: place = 0
                    return: l2_alloc_or(l2_src, l2_for_stmt[fid], "internal: a body graph place could not be allocated")
                ---
            ---
        ---
        l2_for_place[fid]: place
        fid: fid + 1
    ---
    if: l2_mul_ok((cast: (size_t) l2_own_n), c.sizeof(c.L2GraphField)) = 0
        l2_alloc_err: 2
        return: l2_alloc_or(l2_src, 0, "internal: field place index could not be allocated")
    bytes: (cast: (size_t) l2_own_n) * c.sizeof(c.L2GraphField)
    if: bytes > 0U
        l2_alloc_kind: 5
        l2_own_places: (cast: (@: L2GraphField) l2_xmalloc(bytes))
        if: l2_own_places = 0
            return: l2_alloc_or(l2_src, 0, "internal: field place index could not be allocated")
    ---
    while: oi < l2_own_n
        field: l2_own_places + oi
        field\holder: 0
        if: l2_own_fid[oi] >= 0
            fid: l2_own_fid[oi]
            if: fid >= l2_for_n || l2_for_place[fid] = 0 || l2_own_fchild[oi] < 0
                return: l2_error(l2_src, l2_own_decl[oi], "internal: a field has no containing graph place")
            field\holder: l2_for_place[fid]
            field\child: (cast: (size_t) l2_own_fchild[oi])
        else:
            if: l2_own_uchild[oi] < 0
                return: l2_error(l2_src, l2_own_decl[oi], "internal: a field has no graph slot")
            field\child: (cast: (size_t) l2_own_uchild[oi])
        ---
        oi: oi + 1
    ---
return: 0

# Shared namespace field initialization, independent of the root's physical
# placement. The selected occurrence is already allocated at its source field.
fn: l2_emit_ns_cells (int: k) int
    int: oi
    int: fx
    []: char sx 128
    []: char pty 128
    oi: 0
    fx: 0
    while: fx < l2_nsf_n
        if: l2_nsf_owner[fx] = k
            oi: l2_nsf_slot(fx)
            if: oi < 0
                return: l2_error(l2_src, l2_ns_at[k], "internal: a namespace constructor has no completed source place")
        ---
        if: l2_nsf_owner[fx] = k && l2_emit_ns_num_cell(k, oi, fx) != 0
            return: 1
        if: l2_nsf_owner[fx] = k && l2_nsf_kind[fx] = 1 && l2_ns_eternal[k] < 0 && c.fprintf(l2_out, "        l2_entry_slot: lmx_arena_ref_cell(l2_nsp[%d], %uU)\n        if: l2_entry_slot = 0\n            return: 1\n        l2_entry_slot[0]: lmx_char_new_owned(l2_program_arena)\n        if: l2_entry_slot[0] = 0 || lmx_char_store_known(l2_entry_slot[0], %d) != 0\n            return: 1\n", k, (cast: (unsigned) oi), (cast: (int) l2_nsf_val[fx])) < 0
            return: 1
        if: l2_nsf_owner[fx] = k && l2_nsf_kind[fx] = 1 && l2_ns_eternal[k] >= 0 && c.fprintf(l2_out, "        l2_entry_slot: lmx_arena_ref_cell(l2_nsp[%d], %uU)\n        if: l2_entry_slot = 0\n            return: 1\n        l2_entry_slot[0]: lmx_arena_take_profiled(l2_program_arena, c.sizeof(c.char), c.LMX_KIND_PRIMITIVE, c.LMX_TYPE_CHAR, l2_eprofile%u)\n        if: l2_entry_slot[0] = 0\n            return: 1\n        l2_profile_char: (cast: (@: char) l2_entry_slot[0])\n        l2_profile_char[0]: (cast: (char) %d)\n", k, (cast: (unsigned) oi), (cast: (unsigned) l2_ns_eternal[k]), (cast: (int) l2_nsf_val[fx])) < 0
            return: 1
        # An ARRAY field: one record plus its backing, both owned by the
        # Message. The copier already classifies them by address, so
        # nothing here is special to arrays beyond building them.
        if: l2_nsf_owner[fx] = k && l2_nsf_kind[fx] = 5 && l2_nsf_ref[fx] = 0 && l2_ns_eternal[k] < 0 && c.fprintf(l2_out, "        l2_entry_slot: lmx_arena_ref_cell(l2_nsp[%d], %uU)\n        if: l2_entry_slot = 0\n            return: 1\n        l2_entry_slot[0]: (cast: (@: void) lmx_array_new_owned(c.LMX_TYPE_ARRAY_OF_INT, %zuU, l2_program_arena))\n        if: l2_entry_slot[0] = 0\n            return: 1\n", k, (cast: (unsigned) oi), l2_nsf_val[fx]) < 0
            return: 1
        if: l2_nsf_owner[fx] = k && l2_nsf_kind[fx] = 5 && l2_nsf_ref[fx] = 1 && l2_ns_eternal[k] < 0 && c.fprintf(l2_out, "        l2_entry_slot: lmx_arena_ref_cell(l2_nsp[%d], %uU)\n        if: l2_entry_slot = 0\n            return: 1\n        l2_entry_slot[0]: (cast: (@: void) lmx_array_new_owned(c.LMX_TYPE_ARRAY_OF_CHAR, %zuU, l2_program_arena))\n        if: l2_entry_slot[0] = 0\n            return: 1\n", k, (cast: (unsigned) oi), l2_nsf_val[fx]) < 0
            return: 1
        # Kind 6: the outer Array of an Array of T Arrays, empty -- its own
        # descriptor in the arena's ARRAY_OF_DESC pool, len 0, no backing.
        if: l2_nsf_owner[fx] = k && l2_nsf_kind[fx] = 6 && l2_ns_eternal[k] < 0 && c.fprintf(l2_out, "        l2_entry_slot: lmx_arena_ref_cell(l2_nsp[%d], %uU)\n        if: l2_entry_slot = 0\n            return: 1\n        l2_entry_slot[0]: (cast: (@: void) lmx_array_ref_new_owned(c.LMX_TYPE_ARRAY_OF_DESC, 0U, l2_program_arena))\n        if: l2_entry_slot[0] = 0\n            return: 1\n", k, (cast: (unsigned) oi)) < 0
            return: 1
        if: l2_nsf_owner[fx] = k && l2_nsf_kind[fx] = 6 && l2_ns_eternal[k] >= 0 && c.fprintf(l2_out, "        l2_entry_slot: lmx_arena_ref_cell(l2_nsp[%d], %uU)\n        if: l2_entry_slot = 0\n            return: 1\n        l2_profile_array: (cast: (@: VoidArray) lmx_arena_take_profiled(l2_program_arena, c.sizeof(c.VoidArray), c.LMX_KIND_ARRAY, c.LMX_TYPE_ARRAY_OF_DESC, l2_eprofile%u))\n        if: l2_profile_array = 0\n            return: 1\n        l2_profile_array\\size: 0U\n        l2_profile_array\\data: 0\n        l2_entry_slot[0]: (cast: (@: void) l2_profile_array)\n", k, (cast: (unsigned) oi), (cast: (unsigned) l2_ns_eternal[k])) < 0
            return: 1
        if: l2_nsf_owner[fx] = k && l2_nsf_kind[fx] = 5 && l2_ns_eternal[k] >= 0
            if: l2_nsf_ref[fx] = 0 && c.fprintf(l2_out, "        l2_entry_slot: lmx_arena_ref_cell(l2_nsp[%d], %uU)\n        if: l2_entry_slot = 0\n            return: 1\n        l2_profile_array: (cast: (@: VoidArray) lmx_arena_take_profiled(l2_program_arena, c.sizeof(c.VoidArray), c.LMX_KIND_ARRAY, c.LMX_TYPE_ARRAY_OF_INT, l2_eprofile%u))\n        if: l2_profile_array = 0\n            return: 1\n        l2_profile_array\\size: %zuU\n        l2_profile_array\\data: 0\n", k, (cast: (unsigned) oi), (cast: (unsigned) l2_ns_eternal[k]), l2_nsf_val[fx]) < 0
                return: 1
            if: l2_nsf_ref[fx] = 0 && l2_nsf_val[fx] != 0U && c.fprintf(l2_out, "        l2_profile_array\\data: lmx_arena_take_n_profiled(l2_program_arena, c.sizeof(c.int), c.LMX_KIND_PRIMITIVE, c.LMX_TYPE_INT, l2_eprofile%u, %zuU)\n        if: l2_profile_array\\data = 0\n            return: 1\n", (cast: (unsigned) l2_ns_eternal[k]), l2_nsf_val[fx]) < 0
                return: 1
            if: l2_nsf_ref[fx] = 1 && c.fprintf(l2_out, "        l2_entry_slot: lmx_arena_ref_cell(l2_nsp[%d], %uU)\n        if: l2_entry_slot = 0\n            return: 1\n        l2_profile_array: (cast: (@: VoidArray) lmx_arena_take_profiled(l2_program_arena, c.sizeof(c.VoidArray), c.LMX_KIND_ARRAY, c.LMX_TYPE_ARRAY_OF_CHAR, l2_eprofile%u))\n        if: l2_profile_array = 0\n            return: 1\n        l2_profile_array\\size: %zuU\n        l2_profile_array\\data: 0\n", k, (cast: (unsigned) oi), (cast: (unsigned) l2_ns_eternal[k]), l2_nsf_val[fx]) < 0
                return: 1
            if: l2_nsf_ref[fx] = 1 && l2_nsf_val[fx] != 0U && c.fprintf(l2_out, "        l2_profile_array\\data: lmx_arena_take_n_profiled(l2_program_arena, c.sizeof(c.char), c.LMX_KIND_PRIMITIVE, c.LMX_TYPE_CHAR, l2_eprofile%u, %zuU)\n        if: l2_profile_array\\data = 0\n            return: 1\n", (cast: (unsigned) l2_ns_eternal[k]), l2_nsf_val[fx]) < 0
                return: 1
            if: fputs("        l2_entry_slot[0]: (cast: (@: void) l2_profile_array)\n", l2_out) < 0
                return: 1
            ---
        # A reference field (kind 10/11, FABLE-SONNET-SEND-REF-20260925-172
        # commit 1, RESTORED in commit 4 per the author's Q26.2 ruling: a
        # slot holding a Structure's address directly makes it a CHILD of
        # the holder (the copier descends, admission sees a Structure);
        # `@: T name` is a reference TO a reference, so the prototype
        # needs its own pointer CELL here, the same allocator the walked
        # root's own graph-typed own fields and a formal's/local's own
        # pointer locals already use (D-56's now-reverted direct-slot
        # shortcut assumed the slot held the pointee itself; the letter's
        # OWN sender slot -- built with the raw address, not a cell --
        # was the actual mismatch, fixed at the letter builders instead,
        # not here; see steps/send-ref-172.md commit 4).
        if: l2_nsf_owner[fx] = k && l2_nsf_kind[fx] >= 10 && l2_nsf_fname[fx] != 0 && l2_ns_eternal[k] < 0 && (l2_ptr_cell_type(l2_nsf_ref[fx], pty) != 0 || c.fprintf(l2_out, "        l2_entry_slot: lmx_arena_ref_cell(l2_nsp[%d], %uU)\n        if: l2_entry_slot = 0\n            return: 1\n        l2_entry_slot[0]: lmx_pointer_new_owned(%s, l2_program_arena)\n        if: l2_entry_slot[0] = 0\n            return: 1\n", k, (cast: (unsigned) oi), pty) < 0)
            return: 1
        if: l2_nsf_owner[fx] = k && l2_nsf_kind[fx] >= 10 && l2_nsf_fname[fx] != 0 && l2_ns_eternal[k] >= 0 && (l2_ptr_cell_type(l2_nsf_ref[fx], pty) != 0 || c.fprintf(l2_out, "        l2_entry_slot: lmx_arena_ref_cell(l2_nsp[%d], %uU)\n        if: l2_entry_slot = 0\n            return: 1\n        l2_entry_slot[0]: lmx_arena_take_profiled(l2_program_arena, c.sizeof(@: void), c.LMX_KIND_PRIMITIVE, %s, l2_eprofile%u)\n        if: l2_entry_slot[0] = 0\n            return: 1\n", k, (cast: (unsigned) oi), pty, (cast: (unsigned) l2_ns_eternal[k])) < 0)
            return: 1
        if: l2_nsf_owner[fx] = k && l2_nsf_kind[fx] = 12 && l2_nsf_fname[fx] = 0 && l2_emit_atom_slot(k, oi, l2_nsf_name[fx]) != 0
            return: 1
        fx: fx + 1
    ---
    if: c.sprintf(sx, "l2_nsp[%d]", k) < 0 || l2_emit_ns_names(k, sx, "        ", "return: 1", 0) != 0
        return: 1
return: 0

# Fill existing namespace reference fields after their referenced occurrences
# exist. Only generated construction locals are used; no companion graph.
fn: l2_emit_ns_refs (int: k) int
    int: oi
    int: fx
    oi: 0
    fx: 0
    while: fx < l2_nsf_n
        if: l2_nsf_owner[fx] = k
            oi: l2_nsf_slot(fx)
            if: oi < 0
                return: l2_error(l2_src, l2_ns_at[k], "internal: a namespace reference has no completed source place")
        ---
        # K03 NS-ROLES-2: a binding `b: A` (kind 10 with its referent, l2_ns_bind_target) -- its typed reference cell holds
        # A's node: shared by address, no copy, no reparent; an eternal branch's cell is its immutable profiled cell.
        if: l2_nsf_owner[fx] = k && l2_nsf_kind[fx] = 10 && l2_nsf_val[fx] != 0U && l2_ns_payload_pass != 2 && c.fprintf(l2_out, "        l2_entry_slot: lmx_arena_ref_cell(l2_nsp[%d], %uU)\n        if: l2_entry_slot = 0 || lmx_pointer_store_known(l2_entry_slot[0], (cast: (@: void) l2_nsp[%d])) != 0\n            return: 1\n", k, (cast: (unsigned) oi), (cast: (int) l2_nsf_val[fx]) - 1) < 0
            return: 1
        # The synthesized letter's payload of a named model (kind 3, l2_letter_ns_for): the model's copy -- or, a
        # qualified model, shared by address with no reparent.  The letter holds the copy; the copy's parent is its own,
        # the copy of the model's lexical parent: neither the letter nor the model's source parent (the author,
        # LMX_blog/2026-10-05.md#merge-parent).  No source spelling makes kind 3 (K03 NS-ROLES-2).  The copy retains the
        # program's qualified branches (l2_emit_keep), so the copied lexical chain keeps each independent: const:
        # immutable branch itself; the build makes it last, once they are sealed (l2_ns_payload_pass).
        if: l2_nsf_owner[fx] = k && l2_nsf_kind[fx] = 3 && l2_ns_eternal[l2_nsf_ref[fx]] < 0 && l2_ns_payload_pass != 1
            if: c.fprintf(l2_out, "        l2_mops[0U]: l2_nsp[%d]\n        l2_mbody: 0\n        l2_mkn: 0U\n", l2_nsf_ref[fx]) < 0 || l2_emit_keep("        ", "l2_mkeep", "l2_mkn") != 0
                return: 1
            if: c.fprintf(l2_out, "        l2_mstatus: lmx_merge_profiles_owned(l2_mops, 1U, l2_mbody, l2_program_arena, l2_program_arena, l2_mkeep, l2_mkn, 0, 0U, @ l2_mresult)\n        if: l2_mstatus != 0 || l2_mresult = 0\n            return: 1\n        if: lmx_arena_ref_store(l2_nsp[%d], %uU, (cast: (@: void) l2_mresult)) != 0\n            return: 1\n        if: l2_mresult\\parent = l2_nsp[%d] || (l2_nsp[%d]\\parent = 0 && l2_mresult\\parent != 0)\n            return: 1\n        if: l2_nsp[%d]\\parent != 0 && (l2_mresult\\parent = 0 || l2_mresult\\parent = l2_nsp[%d]\\parent)\n            return: 1\n", k, (cast: (unsigned) oi), k, l2_nsf_ref[fx], l2_nsf_ref[fx], l2_nsf_ref[fx]) < 0
                return: 1
        ---
        if: l2_nsf_owner[fx] = k && l2_nsf_kind[fx] = 3 && l2_ns_eternal[l2_nsf_ref[fx]] >= 0 && l2_ns_payload_pass != 2 && c.fprintf(l2_out, "        if: lmx_arena_ref_store(l2_nsp[%d], %uU, (cast: (@: void) l2_nsp[%d])) != 0\n            return: 1\n", k, (cast: (unsigned) oi), l2_nsf_ref[fx]) < 0
            return: 1
        if: l2_nsf_owner[fx] = k && l2_nsf_kind[fx] = 3 && l2_ns_eternal[l2_nsf_ref[fx]] >= 0 && l2_ns_parent[l2_nsf_ref[fx]] < 0 && l2_ns_payload_pass != 2 && c.fprintf(l2_out, "        if: l2_nsp[%d]\\parent != 0\n            return: 1\n", l2_nsf_ref[fx]) < 0
            return: 1
        if: l2_nsf_owner[fx] = k && l2_nsf_kind[fx] = 3 && l2_ns_eternal[l2_nsf_ref[fx]] >= 0 && l2_ns_parent[l2_nsf_ref[fx]] >= 0 && l2_ns_payload_pass != 2 && c.fprintf(l2_out, "        if: l2_nsp[%d]\\parent != l2_nsp[%d]\n            return: 1\n", l2_nsf_ref[fx], l2_ns_parent[l2_nsf_ref[fx]]) < 0
            return: 1
        # A callable field borrows the selected ordinary method occurrence.
        # This reference does not establish a new ownership/parent edge.  The occurrence is a required place of the
        # unit the fill reads -- of a callable merge's partial copy of it, too: an absent one is the shared invariant.
        if: l2_nsf_owner[fx] = k && l2_nsf_kind[fx] = 4 && l2_ns_payload_pass != 2 && (c.fprintf(l2_out, "        if: lmx_arena_ref_struct(l2_entry_unit, %uU) = 0\n", (cast: (unsigned) (l2_occ_slot(l2_nsf_ref[fx])))) < 0 || l2_emit_invariant("        ", "a field path reads an absent place") != 0)
            return: 1
        if: l2_nsf_owner[fx] = k && l2_nsf_kind[fx] = 4 && l2_ns_payload_pass != 2 && c.fprintf(l2_out, "        if: lmx_arena_ref_store(l2_nsp[%d], %uU, (cast: (@: void) lmx_arena_ref_struct(l2_entry_unit, %uU))) != 0\n            return: 1\n        if: lmx_arena_ref_struct(l2_entry_unit, %uU)\\parent != %s\n            return: 1\n", k, (cast: (unsigned) oi), (cast: (unsigned) (l2_occ_slot(l2_nsf_ref[fx]))), (cast: (unsigned) (l2_occ_slot(l2_nsf_ref[fx]))), l2_m_lexparent(l2_nsf_ref[fx])) < 0
            return: 1
        fx: fx + 1
    ---
return: 0

# The unit children named by the references of named Structure k's fill (l2_emit_ns_refs) are uses of the home being
# walked (l2_rw_mi): a callable field's borrowed method occurrence, kind 4 (l2_use_unit_child kind 1).
fn: l2_ns_refs_note (int: k) int
    int: fx 0
    while: fx < l2_nsf_n
        if: l2_nsf_owner[fx] = k && l2_nsf_kind[fx] = 4 && l2_use_unit_child(1, l2_nsf_ref[fx]) != 0
            return: 1
        fx: fx + 1
    ---
return: 0

# A projected construction has its own namespace aliases. Fill only the
# retained local roots of that selected view, never all prototype roots.
# One enumeration of them serves the FILL (emit 1) and the uses the view's home makes through them (emit 0, every pass,
# as `home`): the copy of the unit the view is built from holds what its home's uses name (l2_mu_collect_home,
# READ-FIELD-CLOSURE, T7).
fn: l2_source_refs_rows (int: kind; int: index; int: emit; int: home) int
    @: L2SourceContainer row l2_source_containers
    int: ni
    int: saved l2_rw_mi
    int: rc 0
    if: emit = 0
        l2_rw_mi: home
    while: row != 0 && rc = 0
        if: row\view_kind = kind && (index < 0 || row\view_index = index) && row\inert = 0 && row\root != 0
            ni: l2_m_nsof(row\source_mi)
            if: ni >= 0 && emit != 0 && l2_emit_ns_refs(ni) != 0
                rc: 1
            if: ni >= 0 && emit = 0 && l2_ns_refs_note(ni) != 0
                rc: 1
            ---
        ---
        row: row\allocated_next
    ---
    l2_rw_mi: saved
return: rc

fn: l2_source_refs_emit (int: kind; int: index) int
return: l2_source_refs_rows(kind, index, 1, 0 - 1)

fn: l2_source_refs_note (int: kind; int: index; int: home) int
return: l2_source_refs_rows(kind, index, 0, home)

# The declaration identity selects an original named source occurrence. A
# model-typed binding or a copied/borrowed value is not another definition.
fn: l2_source_definition_ns (int: own) int
    int: ni
    if: own < 0
        return: -1
    ni: l2_own_nsty_get(own)
    if: ni < 0 || ni >= l2_ns_n || l2_ns_source_body(ni) = 0
        return: -1
    if: l2_ns_at[ni] != l2_own_decl[own]
        return: -1
return: ni

# One original local root is attached to the exact field of its host source
# container, even when the namespace collector stamped an outer method.
fn: l2_source_definition_field (int: ni; int: kind; int: index; @@: L2SourceContainer owner) @: L2SourceField
    @: L2SourceContainer row l2_source_containers
    @: L2SourceField field
    @: L2SourceField found 0
    \owner: 0
    while: row != 0
        if: row\view_kind = kind && (index < 0 || row\view_index = index) && row\inert = 0
            field: row\fields
            while: field != 0
                if: l2_source_definition_ns(field\own) = ni
                    if: found != 0
                        l2_error(l2_src, l2_ns_at[ni], "internal: a source definition has two owning fields")
                        return: 0
                    found: field
                    \owner: row
                ---
                field: field\next
            ---
        ---
        row: row\allocated_next
    ---
return: found

# Allocate shells in physical ownership order, not reverse discovery order.
# Local callable-relative roots alias their one source child; they never get
# a unit slot or a companion context. Borrowed references are filled later.
fn: l2_source_shell_emit (@: L2SourceContainer row; const: @(char root)) int
    @: L2SourceContainer owner 0
    @: L2SourceContainer base l2_source_containers
    @: L2SourceField field
    int: mi row\source_mi
    int: ni -1
    int: scope row\view_index
    []: char spelling 64
    if: row\shell_state = 2
        return: 0
    if: row\shell_state = 1
        return: l2_error(l2_src, 0, "internal: cyclic source ownership")
    row\shell_state: 1
    ni: l2_m_nsof(mi)
    if: row\view_kind = 0
        scope: -1
    if: row\root != 0 && ni >= 0 && l2_ns_local[ni] >= 0
        field: l2_source_definition_field(ni, row\view_kind, scope, @ owner)
        if: field = 0 || owner = 0
            return: l2_error(l2_src, l2_ns_at[ni], "internal: a local source root has no owning field")
        if: l2_source_shell_emit(owner, root) != 0
            return: 1
        if: c.fprintf(l2_out, "        l2_nsp[%d]: lmx_struct_new_owned(l2_sc%zu, l2_program_arena)\n        if: l2_nsp[%d] = 0\n            return: 1\n", ni, owner\id, ni) < 0
            return: 1
        if: row\width > 0 && c.fprintf(l2_out, "        if: lmx_arena_refs_open_owned(l2_program_arena, l2_nsp[%d], %uU) != 0\n            return: 1\n", ni, (cast: (unsigned) row\width)) < 0
            return: 1
        if: c.fprintf(l2_out, "        if: lmx_arena_ref_store(l2_sc%zu, %uU, (cast: (@: void) l2_nsp[%d])) != 0\n            return: 1\n", owner\id, (cast: (unsigned) field\slot), ni) < 0
            return: 1
        if: c.sprintf(spelling, "l2_nsp[%d]", ni) < 0 || l2_emit_source_name(spelling, l2_ns_name[ni], "        ", "return: 1", 0) != 0
            return: 1
        if: c.fprintf(l2_out, "        @: Lmx l2_sc%zu l2_nsp[%d]\n", row\id, ni) < 0
            return: 1
        ---
    else:
        if: row\root != 0
            if: root != 0
                if: c.fprintf(l2_out, "        l2_entry_leaf: %s\n", root) < 0
                    return: 1
                ---
            else:
                if: fputs("        l2_entry_leaf: ", l2_out) < 0 || l2_emit_build_occ(mi) != 0 || fputs("\n", l2_out) < 0
                    return: 1
                ---
            ---
            if: c.fprintf(l2_out, "        @: Lmx l2_sc%zu l2_entry_leaf\n", row\id) < 0
                return: 1
            ---
        else:
            while: base != 0 && (base\view_kind != row\view_kind || base\view_index != row\view_index || base\source_mi != mi || base\root = 0)
                base: base\allocated_next
            if: base = 0 || l2_source_shell_emit(base, root) != 0
                return: l2_error(l2_src, 0, "internal: a source body has no owning root")
            if: c.fprintf(l2_out, "        @: Lmx l2_sc%zu lmx_struct_new_owned(l2_sc%zu, l2_program_arena)\n        if: l2_sc%zu = 0\n            return: 1\n", row\id, base\id, row\id) < 0
                return: 1
            if: row\width > 0 && c.fprintf(l2_out, "        if: lmx_arena_refs_open_owned(l2_program_arena, l2_sc%zu, %uU) != 0\n            return: 1\n", row\id, (cast: (unsigned) row\width)) < 0
                return: 1
            ---
        ---
    ---
    if: row\fid >= 0 && c.fprintf(l2_out, "        l2_b%d: l2_sc%zu\n", row\fid, row\id) < 0
        return: 1
    row\shell_state: 2
return: 0

# Allocate each committed whole body and its typed cells once, before any
# operand borrows them. The same object is attached/reparented at rw_body;
# there is no separate storage shell or second body allocation.
fn: l2_source_cells_emit (int: kind; int: index; const: @(char root)) int
    @: L2SourceContainer row l2_source_containers
    @: L2SourceField field
    int: mi
    int: ni
    []: char holder 64
    while: row != 0
        if: row\inert = 0 && row\view_kind = kind && (index < 0 || row\view_index = index) && l2_source_shell_emit(row, root) != 0
            return: 1
        row: row\allocated_next
    ---
    row: l2_source_containers
    while: row != 0
        if: row\inert = 0 && row\view_kind = kind && (index < 0 || row\view_index = index)
            mi: row\source_mi
            ni: -1
            if: row\root != 0
                ni: l2_m_nsof(mi)
            if: ni >= 0 && l2_ns_local[ni] >= 0 && l2_emit_ns_cells(ni) != 0
                return: 1
            field: row\fields
            while: field != 0
                if: l2_source_ns_constructor(row, field\own) >= 0 || l2_source_definition_ns(field\own) >= 0
                    field: field\next
                    continue
                if: l2_own_computed(field\own) != 0
                    if: c.fprintf(l2_out, "        @: Lmx l2_rw%d lmx_walk_plain(l2_program_arena, l2_sc%zu, 2U)\n        if: l2_rw%d = 0\n            return: 1\n        l2_entry_slot: lmx_arena_ref_cell(l2_rw%d, 1U)\n        if: l2_entry_slot = 0\n            return: 1\n", field\storage_temp, row\id, field\storage_temp, field\storage_temp) < 0 || l2_emit_cell_new(field\own, "        ", "l2_entry_slot", "return: 1", 0) != 0
                        return: 1
                    if: l2_own_is_slot(field\own) != 0 && l2_emit_source_name("l2_entry_slot", l2_own_name[field\own], "        ", "return: 1", 0) != 0
                        return: 1
                    field: field\next
                    continue
                if: l2_atom_value_stmt(l2_own_decl[field\own], l2_own_mi[field\own]) != 0
                    if: c.sprintf(holder, "l2_sc%zu", row\id) < 0 || l2_emit_method_atom_at(field\own, holder, (cast: (size_t) field\slot)) != 0
                        return: 1
                    ---
                else:
                    if: c.fprintf(l2_out, "        l2_entry_slot: lmx_arena_ref_cell(l2_sc%zu, %uU)\n        if: l2_entry_slot = 0\n            return: 1\n", row\id, (cast: (unsigned) field\slot)) < 0 || l2_emit_cell_new(field\own, "        ", "l2_entry_slot", "return: 1", 0) != 0
                        return: 1
                    ---
                ---
                field: field\next
            ---
        ---
        row: row\allocated_next
    ---
return: 0

# Fill placed named field Structures only after namespace references exist.
# This is a second pass over the same source slots, not another owning graph.
# Projected constructors use their own l2_sc alias just like ordinary bodies.
fn: l2_source_fields_emit (int: kind; int: index) int
    @: L2SourceContainer row l2_source_containers
    @: L2SourceField field
    []: char holder 64
    while: row != 0
        if: row\inert = 0 && row\view_kind = kind && (index < 0 || row\view_index = index)
            field: row\fields
            while: field != 0
                if: l2_source_ns_constructor(row, field\own) >= 0 || l2_source_definition_ns(field\own) >= 0
                    field: field\next
                    continue
                if: l2_field_own_stmt(l2_own_decl[field\own], l2_own_mi[field\own]) != 0
                    if: c.sprintf(holder, "l2_sc%zu", row\id) < 0 || l2_emit_method_fields_at(field\own, holder, (cast: (size_t) field\slot)) != 0
                        return: 1
                    ---
                ---
                field: field\next
            ---
        ---
        row: row\allocated_next
    ---
return: 0

# Publish each completed original named occurrence's physical schema in the
# existing admission table. Reads use the current value's evidence, never the
# originating method's prototype. This adds no source field or atom metadata.
fn: l2_source_layouts_emit (int: kind; int: index) int
    @: L2SourceContainer row l2_source_containers
    int: ni
    []: char value 64
    while: row != 0
        if: row\view_kind = kind && (index < 0 || row\view_index = index) && row\inert = 0 && row\root != 0
            ni: l2_m_nsof(row\source_mi)
            if: ni >= 0
                if: c.sprintf(value, "l2_sc%zu", row\id) < 0 || l2_emit_constructed_layout(ni, value, value, "        ") != 0
                    return: 1
                ---
            ---
        ---
        row: row\allocated_next
    ---
return: 0

# Produce one retained callable root in its own procedure context. A projected
# view identifies the enclosing construction, not the procedure whose source
# is being filled. Outer callable bindings must not resolve this body's names.
fn: l2_source_callable_fill (@: L2SourceContainer source; int: phase) int
    int: mi source\source_mi
    int: t -2
    int: made 0
    int: one 0
    int: bad 0
    int: saved_mi l2_rw_mi
    int: saved_cur l2_cur_mi
    int: saved_t7 l2_t7_walk
    int: saved_emit l2_rw_emit
    l2_construct_begin(source\view_kind, source\view_index, phase)
    l2_t7_walk: 0
    l2_rw_mi: mi
    l2_cur_mi: mi
    l2_rw_emit: (cast: (int) (phase = 2))
    l2_vis_method(mi)
    if: l2_rw_bseq_zero() != 0
        return: l2_alloc_or(l2_src, l2_m_node[mi], "source declaration marks could not be allocated")
    if: phase != 0
        t: l2_rw_t
        l2_rw_t: l2_rw_t + 1
        if: phase = 1
            source\temp: t
        if: l2_construct_temp(t, -1, 1) != 0
            bad: 1
        ---
    ---
    if: phase = 2
        if: l2_source_fill(source) != 0 || c.fprintf(l2_out, "        @: Lmx l2_rw%d l2_sc%zu\n", t, source\id) < 0
            bad: 1
        ---
    ---
    l2_rw_cache_on: 1
    if: bad = 0 && l2_rw_stmts(source\body\first_field, t, l2_m_head(mi), source, @ made) != 0
        bad: 1
    if: bad = 0 && l2_rw_trailer(mi, t, l2_m_head(mi) + made, @ one) != 0
        bad: 1
    if: bad = 0 && phase = 0
        source\width: l2_m_head(mi) + made + one
    if: bad = 0 && phase != 0 && source\width != l2_m_head(mi) + made + one
        bad: l2_error(l2_src, l2_m_node[mi], "internal: a retained callable changed source width")
    if: bad = 0 && phase = 2 && l2_emit_parts(mi) != 0
        bad: 1
    l2_rw_cache_on: 0
    l2_rw_emit: saved_emit
    l2_rw_mi: saved_mi
    l2_cur_mi: saved_cur
    l2_t7_walk: saved_t7
    l2_vis_on: 0
return: bad

# Close the selected constructor view over its exact retained definitions.
# A new local root has a callable-relative NULL place and one owning source
# field in this same view. Repeat discovery until nested definitions are all
# present; there is no depth bound and no body/capture companion graph.
fn: l2_source_definition_roots (int: kind; int: index; int: phase) int
    @: L2SourceContainer row
    @: L2SourceContainer local
    @: L2SourceField field
    int: ni
    int: changed 1
    int: saved_mi l2_rw_mi
    if: phase = 0
        while: changed != 0
            changed: 0
            row: l2_source_containers
            while: row != 0
                if: row\view_kind = kind && row\view_index = index && row\inert = 0
                    field: row\fields
                    while: field != 0
                        ni: l2_source_definition_ns(field\own)
                        if: ni >= 0 && l2_ns_local[ni] >= 0
                            l2_rw_mi: l2_ns_proc[ni]
                            local: l2_source_container(l2_ns_source_body(ni), 0)
                            if: local = 0
                                return: l2_alloc_or(l2_src, l2_ns_at[ni], "a retained callable source could not be allocated")
                            if: local\root = 0
                                local\root: 1
                                if: l2_source_callable_fill(local, phase) != 0
                                    return: 1
                                changed: 1
                            ---
                        ---
                        field: field\next
                    ---
                ---
                row: row\allocated_next
            ---
        ---
    else:
        row: l2_source_containers
        while: row != 0
            if: row\view_kind = kind && row\view_index = index && row\inert = 0 && row\root != 0
                ni: l2_m_nsof(row\source_mi)
                if: ni >= 0 && l2_ns_local[ni] >= 0 && l2_source_callable_fill(row, phase) != 0
                    return: 1
                ---
            ---
            row: row\allocated_next
        ---
    ---
    l2_rw_mi: saved_mi
return: 0

# NODE starts at this callable's actual lexical parent. A local definition's
# host body can have a non-NULL place in its host, but that prefix has already
# been crossed by NODE. Keep only the selected field's remaining suffix.
fn: l2_node_graph_stop (int: mi; @@: L2GraphPlace stop) int
    int: ni l2_m_nsof(mi)
    int: kind 0
    int: index -1
    @: L2SourceContainer owner 0
    \stop: 0
    if: ni < 0 || l2_ns_source_body(ni) = 0 || (l2_ns_local[ni] < 0 && l2_ns_parent[ni] < 0)
        return: 0
    if: l2_construct_phase > 0 && l2_construct_view_kind != 0
        kind: l2_construct_view_kind
        index: l2_construct_view_index
    if: l2_source_definition_field(ni, kind, index, @ owner) = 0 || owner = 0
        return: l2_error(l2_src, l2_ns_at[ni], "internal: a lexical parent has no source owner")
    \stop: owner\place
return: 0

# Find the selected constructor view's exact owning body. This also covers
# projected returned occurrences; a model's unit slot is not their holder.
fn: l2_source_field_owner (int: own; @@: L2SourceContainer owner) @: L2SourceField
    @: L2SourceContainer row l2_source_containers
    @: L2SourceField field
    \owner: 0
    while: row != 0
        if: row\inert = 0 && row\view_kind = l2_construct_view_kind && row\view_index = l2_construct_view_index
            field: row\fields
            while: field != 0
                if: field\own = own
                    \owner: row
                    return: field
                field: field\next
            ---
        ---
        row: row\allocated_next
    ---
return: 0

fn: l2_graph_field (int: oi) @: L2GraphField
    @: L2SourceContainer row l2_source_containers
    @: L2SourceField field
    if: oi < 0 || oi >= l2_own_n || l2_own_places = 0
        return: 0
    if: l2_construct_phase > 0 && l2_construct_view_index >= 0
        while: row != 0
            if: row\view_kind = l2_construct_view_kind && row\view_index = l2_construct_view_index && (row\place != 0 || row\root != 0)
                field: row\fields
                while: field != 0
                    if: field\own = oi
                        return: @ field\place
                    field: field\next
                ---
            ---
            row: row\allocated_next
        ---
        if: l2_construct_phase = 2 && l2_construct_view_kind != 0 && l2_own_mi[oi] = l2_rw_mi && l2_own_fid[oi] >= 0
            return: 0
        ---
    ---
return: l2_own_places + oi

# The same source scope can be constructed in several callable occurrences.
# A projected view uses its own committed object, not the original model's
# physical address. Paths to another occurrence keep that occurrence's place.
fn: l2_graph_body_place (int: fid) @: L2GraphPlace
    @: LmP0Node node
    @: LmP0Structure body
    @: L2SourceContainer row l2_source_containers
    if: fid < 0 || fid >= l2_for_n || l2_for_place = 0
        return: 0
    if: l2_construct_phase > 0 && l2_construct_view_kind != 0 && l2_construct_view_index >= 0 && l2_for_owner(fid) = l2_rw_mi
        node: l2_for_node[fid]
        body: 0
        if: node != 0 && node\as != 0 && node\kind = c.LM_P0_NODE_STRUCTURE
            body: node\as\structure
        if: node != 0 && node\as != 0 && node\kind = c.LM_P0_NODE_FRAME
            body: node\as\frame\body
        while: row != 0
            if: row\view_kind = l2_construct_view_kind && row\view_index = l2_construct_view_index && row\body = body && row\place != 0
                return: row\place
            row: row\allocated_next
        ---
        if: l2_construct_phase = 2
            return: 0
        ---
    ---
return: l2_for_place[fid]

# The legacy slot vocabulary is int-sized; the edge relation itself is size_t.
fn: l2_graph_field_child (int: oi) int
    @: L2GraphField field l2_graph_field(oi)
    if: field = 0 || field\child > (cast: (size_t) c.INT_MAX)
        return: 0 - 1
return: (cast: (int) field\child)

# Project a shared edge suffix from the Structure already in l2_pst. The stop
# is a physical ancestor, not a lexical scope or a control-operator spelling.
fn: l2_emit_graph_path (@: L2GraphPlace place; @: L2GraphPlace stop; int: mi; const: @(char ind)) int
    if: place = stop
        return: 0
    if: place = 0
        return: 1
    if: l2_emit_graph_path(place\parent, stop, mi, ind) != 0
        return: 1
    if: c.fprintf(l2_out, "%sl2_pst: lmx_arena_ref_struct(l2_pst, %zuU)\n%sif: l2_pst = 0\n", ind, place\child, ind) < 0
        return: 1
return: l2_emit_path_bail(mi, ind)

# Project an existing field from its actual owning occurrence into one machine
# pointer. Foreign occurrences have no local l2_gp aliases in this activation.
# Emit one step per ordinary parent edge, without a fixed-depth text buffer,
# a second graph, or a substitute model instance.
fn: l2_emit_graph_holder (@: L2GraphPlace place; const: @(char cursor); const: @(char ind)) int
    if: place = 0
        return: 0
    if: l2_emit_graph_holder(place\parent, cursor, ind) != 0
        return: 1
return: (cast: (int) (c.fprintf(l2_out, "%s%s: lmx_arena_ref_struct(%s, %zuU)\n", ind, cursor, cursor, place\child) < 0))

fn: l2_emit_graph_field_value (int: own; const: @(char ind); @: L2Tx dest) int
    @: L2GraphField field l2_graph_field(own)
    int: temp l2_tn
    []: char nm 32
    if: field = 0 || ind = 0 || dest = 0
        return: 1
    l2_tn: l2_tn + 1
    if: c.snprintf(nm, 32U, "l2_model%d", temp) < 0 || l2_tx_set(dest, nm) != 0 || c.fprintf(l2_out, "%s@: Lmx %s %s\n", ind, nm, l2_own_ctr(own)) < 0
        return: 1
    if: l2_emit_graph_holder(field\holder, nm, ind) != 0
        return: 1
return: (cast: (int) (c.fprintf(l2_out, "%s%s: lmx_arena_ref_struct(%s, %zuU)\n", ind, nm, nm, field\child) < 0))

# A place of the unit as an expression over the complete unit: each edge from the unit down to the place.  For
# code built after the unit is -- a merge's node, built when the merge runs -- which has none of the aliases the
# unit's constructor names its holders by (l2_emit_graph_build_place).
fn: l2_emit_graph_unit_place (@: L2GraphPlace place) int
    if: place = 0 && l2_rw_type_base != 0
        return: (cast: (int) (fputs("l2_program_unit", l2_out) < 0))
    if: place = 0
        return: (cast: (int) (fputs("l2_entry_unit", l2_out) < 0))
    if: fputs("lmx_arena_ref_struct(", l2_out) < 0 || l2_emit_graph_unit_place(place\parent) != 0
        return: 1
return: (cast: (int) (c.fprintf(l2_out, ", %zuU)", place\child) < 0))

# A construction-time field holder is an already allocated physical body.
# Runtime addressing follows its edges; construction uses that body's actual
# allocation alias even before the containing operation is attached.
fn: l2_emit_graph_build_place (@: L2GraphPlace place; int: root_mi) int
    int: fid 0
    int: ns
    @: L2SourceContainer row l2_source_containers
    @: L2SourceField field
    if: place = 0
        return: l2_emit_build_occ(root_mi)
    while: row != 0
        if: row\place = place && row\inert = 0
            return: (cast: (int) (c.fprintf(l2_out, "l2_sc%zu", row\id) < 0))
        field: row\fields
        while: field != 0
            if: field\storage_temp >= 0 && field\place.holder = place
                return: (cast: (int) (c.fprintf(l2_out, "l2_rw%d", field\storage_temp) < 0))
            field: field\next
        ---
        row: row\allocated_next
    ---
    # The constructor has allocated these very objects before filling the
    # operation bodies. An ancestor edge can still be unattached at this
    # point, so use its existing allocation alias rather than traverse that
    # incomplete edge. This is the same place, not another graph or cell.
    while: fid < l2_for_n
        ns: l2_m_nsof(l2_for_owner(fid))
        if: l2_for_place[fid] = place
            if: ns >= 0 && l2_ns_local[ns] >= 0
                return: l2_error(l2_src, l2_for_stmt[fid], "internal: a construction holder has not been allocated")
            return: (cast: (int) (c.fprintf(l2_out, "l2_b%d", fid) < 0))
        fid: fid + 1
    ---
return: l2_error(l2_src, 0, "internal: a construction holder has no allocation")

# Emit only machine pointer aliases for this method's selected occurrence.
# Allocation order is parent-before-child; the l2_h aliases keep existing own
# locators unchanged while their address backend uses the shared child relation.
fn: l2_emit_graph_places (int: mi) int
    int: fid 0
    int: oi
    int: used
    @: L2GraphPlace live
    @: L2GraphField field
    @: L2GraphPlace place l2_graph_places
    while: place != 0
        used: 0
        fid: 0
        while: fid < l2_for_n
            live: l2_for_place[fid]
            while: live != 0
                if: live = place
                    used: 1
                live: live\parent
            ---
            fid: fid + 1
        ---
        oi: 0
        while: oi < l2_own_n
            field: l2_own_places + oi
            live: field\holder
            while: live != 0
                if: live = place
                    used: 1
                live: live\parent
            ---
            oi: oi + 1
        ---
        if: place\method = mi && used != 0
            if: c.fprintf(l2_out, "    @: Lmx l2_gp%zu 0\n", place\id) < 0
                return: 1
            if: place\parent = 0
                if: c.fprintf(l2_out, "    l2_gp%zu: lmx_arena_ref_struct(self, %zuU)\n", place\id, place\child) < 0
                    return: 1
                ---
            else:
                if: c.fprintf(l2_out, "    l2_gp%zu: lmx_arena_ref_struct(l2_gp%zu, %zuU)\n", place\id, place\parent\id, place\child) < 0
                    return: 1
                ---
            ---
            if: c.fprintf(l2_out, "    if: l2_gp%zu = 0\n", place\id) < 0 || l2_emit_invariant("    ", "a body has no containing graph Structure") != 0
                return: 1
            ---
        place: place\allocated_next
    ---
    fid: 0
    while: fid < l2_for_n
        place: l2_for_place[fid]
        if: place != 0 && place\method = mi
            if: c.fprintf(l2_out, "    @: Lmx l2_h%d l2_gp%zu\n", fid, place\id) < 0
                return: 1
            ---
        fid: fid + 1
    ---
return: 0

fn: l2_for_reserve (int: need) int
    size_t: cap
    size_t: need_u
    size_t: psz
    size_t: nb
    size_t: ni
    @@: LmP0Node nn 0
    @: int nu 0
    @: int nk 0
    @: int nm 0
    @: int np 0
    @@: LmP0Node ns 0
    int: i
    if: need < 0
        return: 1
    if: need <= l2_for_cap
        return: 0
    if: need > c.INT_MAX
        l2_alloc_err: 2
        return: 1
    need_u: (cast: (size_t) need)
    cap: (cast: (size_t) l2_for_cap)
    if: cap < 1U
        cap: 4U
    while: cap < need_u
        if: cap > ((cast: (size_t) -1) / 2U)
            l2_alloc_err: 2
            return: 1
        cap: cap * 2U
    psz: c.sizeof(@: char)
    if: l2_mul_ok(cap, psz) = 0
        l2_alloc_err: 2
        return: 1
    if: l2_mul_ok(cap, c.sizeof(c.int)) = 0
        l2_alloc_err: 2
        return: 1
    nb: cap * psz
    ni: cap * c.sizeof(c.int)
    l2_alloc_kind: 5
    nn: (cast: (@@: LmP0Node) l2_xmalloc(nb))
    nu: (cast: (@: int) l2_xmalloc(ni))
    nk: (cast: (@: int) l2_xmalloc(ni))
    nm: (cast: (@: int) l2_xmalloc(ni))
    np: (cast: (@: int) l2_xmalloc(ni))
    ns: (cast: (@@: LmP0Node) l2_xmalloc(nb))
    if: nn = 0 || nu = 0 || nk = 0 || nm = 0 || np = 0 || ns = 0
        if: nn != 0
            l2_xfree((cast: (@: void) nn))
        if: nu != 0
            l2_xfree((cast: (@: void) nu))
        if: nk != 0
            l2_xfree((cast: (@: void) nk))
        if: nm != 0
            l2_xfree((cast: (@: void) nm))
        if: np != 0
            l2_xfree((cast: (@: void) np))
        if: ns != 0
            l2_xfree((cast: (@: void) ns))
        return: 1
    memset((cast: (@: void) nn), 0, nb)
    memset((cast: (@: void) ns), 0, nb)
    i: 0
    while: i < (cast: (int) cap)
        nu[i]: -1
        nk[i]: 0
        nm[i]: -1
        np[i]: -1
        i: i + 1
    i: 0
    while: i < l2_for_n
        nn[i]: l2_for_node[i]
        nu[i]: l2_for_uchild[i]
        nk[i]: l2_for_nkid[i]
        nm[i]: l2_for_mi[i]
        np[i]: l2_for_parent[i]
        ns[i]: l2_for_stmt[i]
        i: i + 1
    if: l2_for_stmt != 0
        l2_xfree((cast: (@: void) l2_for_stmt))
    if: l2_for_node != 0
        l2_xfree((cast: (@: void) l2_for_node))
        l2_xfree((cast: (@: void) l2_for_uchild))
        l2_xfree((cast: (@: void) l2_for_nkid))
        l2_xfree((cast: (@: void) l2_for_mi))
        l2_xfree((cast: (@: void) l2_for_parent))
    l2_for_node: nn
    l2_for_uchild: nu
    l2_for_nkid: nk
    l2_for_mi: nm
    l2_for_parent: np
    l2_for_stmt: ns
    l2_for_cap: (cast: (int) cap)
return: 0

fn: l2_for_find (const: @(LmP0Node node)) int
    int: i 0
    if: node = 0
        return: -1
    while: i < l2_for_n
        if: l2_for_node[i] = node
            return: i
        i: i + 1
return: -1

fn: l2_for_add (const: @(LmP0Node node); int: mi; int: parent; const: @(LmP0Node owner)) int
    int: i
    if: node = 0
        return: -1
    i: l2_for_find(node)
    if: i >= 0 && l2_for_mi[i] = mi && l2_for_parent[i] = parent
        return: i
    if: i >= 0
        return: -1
    if: l2_for_reserve(l2_for_n + 1) != 0
        return: -1
    l2_for_node[l2_for_n]: (cast: (@: LmP0Node) node)
    l2_for_uchild[l2_for_n]: -1
    l2_for_nkid[l2_for_n]: 0
    l2_for_mi[l2_for_n]: mi
    l2_for_parent[l2_for_n]: parent
    l2_for_stmt[l2_for_n]: (cast: (@: LmP0Node) owner)
    l2_for_n: l2_for_n + 1
return: l2_for_n - 1

# THE HEADER PARTS (-189 c4; form A, fable): a method's header is its `args` part at slot 0 and its
# `return` part at slot 1 of its occurrence M; a part exists iff it is declared, so a method has
# the two and the entry E (the file's body) none -- its fields start at 0, as a named Structure's
# do. A named Structure's procedure declares neither: its occurrence is the Structure itself.
# The original-source producer interleaves cells and operations; only the remaining dense
# adapters reserve a declaration prefix. (The walker
# does not read a header from it: executing it is EXEC, which checks no args part.)
# The number of children in front of own fields.
fn: l2_m_head (int: mi) int
    int: ni
    if: mi = l2_e
        return: 0
    ni: l2_m_nsof(mi)
    if: ni >= 0
        if: l2_ns_source_body(ni) != 0
            return: 0
        return: l2_ns_count[ni]
return: 2

# The completed source width, or the explicit dense adapter's declaration width.
fn: l2_ns_width (int: ni) int
    if: ni >= 0 && ni < l2_ns_n && l2_ns_proc[ni] >= 0 && l2_ns_eternal[ni] < 0
        return: l2_m_width(l2_ns_proc[ni])
return: l2_ns_count[ni]

# The unit child that holds method mi's occurrence: its own, or -- a named Structure's procedure (R9) -- the
# Structure, which holds its code as it holds its fields.
fn: l2_occ_slot (int: mi) int
    int: ni
    int: slot
    ni: l2_m_nsof(mi)
    if: ni >= 0 && l2_ns_parent[ni] < 0 && l2_ns_eternal[ni] < 0
        return: l2_ns_unit_slot(ni)
    slot: l2_source_unit_slot(l2_m_node[mi])
    if: slot >= 0
        return: slot
return: l2_unit_base + l2_occ_tail_rank(mi)

# A P0 identity in the statement-place table is a unit place only when its
# committed source occurrence is a direct child of the original unit. Nested
# method/body places never become root places merely because they have a slot.
fn: l2_source_unit_slot (const: @(LmP0Node node)) int
    @: L2SourceContainer source l2_source_root(l2_e)
    @: LmP0Field field
    if: source = 0 || source\body != l2_cur_unit || node = 0
        return: -1
    field: l2_next_active(source\body\first_field)
    while: field != 0
        if: field\value = node
            return: l2_ps_lookup(node)
        field: l2_next_active(field\next)
    ---
return: -1

# Existing producers are matched by source identity, never by another
# resolution/name pass after the lexical collector has changed its state.
# Is ns a synthesized letter model (l2_letter_ns_for)? Its `at` is the receive
# statement that first named it: a place for diagnostics, not a definition.
fn: l2_ns_synthesized (int: ns) int
    int: k 0
    while: k < l2_letter_model_n
        if: l2_letter_model_ns[k] = ns
            return: 1
        k: k + 1
    ---
return: 0

fn: l2_source_unit_declaration (const: @(LmP0Node node)) int
    int: i 0
    while: i < l2_m_n
        if: i != l2_e && l2_m_node[i] = node && l2_m_nsof(i) < 0
            return: 1
        i: i + 1
    i: 0
    while: i < l2_ns_n
        if: l2_ns_at[i] = node && l2_ns_parent[i] < 0 && l2_ns_local[i] < 0 && l2_ns_synthesized(i) = 0
            return: 1
        i: i + 1
    i: 0
    while: i < l2_ebr_n
        if: l2_ebr_at[i] = node
            return: 1
        i: i + 1
return: 0

# Only objects not placed by a source producer require a transitional unit
# tail. Rank and count use the allocation loop's same ownership predicate.
fn: l2_occ_tail_rank (int: mi) int
    int: i 0
    int: count 0
    while: i < mi
        if: i != l2_e && l2_m_nsof(i) < 0 && l2_source_unit_slot(l2_m_node[i]) < 0
            count: count + 1
        i: i + 1
return: count

fn: l2_ebr_tail_rank (int: branch) int
    int: i 0
    int: count 0
    while: i < branch
        if: l2_source_unit_slot(l2_ebr_at[i]) < 0
            count: count + 1
        i: i + 1
return: count

fn: l2_ns_tail_rank (int: ns) int
    int: i 0
    int: count 0
    while: i < ns
        if: l2_ns_parent[i] < 0 && l2_ns_local[i] < 0 && l2_ns_eternal[i] < 0 && (l2_ns_synthesized(i) != 0 || l2_source_unit_slot(l2_ns_at[i]) < 0)
            count: count + 1
        i: i + 1
return: count

# The named Structure whose procedure method mi is (§12), or -1.
fn: l2_m_nsof (int: mi) int
    int: i 0
    while: mi >= 0 && i < l2_ns_n
        if: l2_ns_proc[i] = mi
            return: i
        i: i + 1
    ---
return: 0 - 1

# Child index of own field oi inside its own method's Structure M: after the header parts
# (l2_m_head), the earlier unhosted own fields of the same method; no extra per-method table.  In a named Structure's
# procedure a field's index is the Structure's field's; a computed output (l2_own_computed, l2_ns_computed_decl) is no
# field of it (K03 RECEIVE-OUTPUT, q53.md:95-97) and takes a method's placeholder after the fields until its own
# receiver occurrence's place binds (l2_source_places_bind) -- no slot of the Structure, never `Host\m`.
fn: l2_own_mslot (int: oi) int
    int: k 0
    int: ni l2_m_nsof(l2_own_mi[oi])
    int: n l2_m_head(l2_own_mi[oi])
    # The declared row and the named Structure layout retain the same original
    # P0 name node. Map that occurrence, not its spelling: repeated names occupy
    # distinct existing slots. This is physical layout, not lexical lookup.
    if: ni >= 0
        n: 0
        while: k < l2_nsf_n
            if: l2_nsf_owner[k] = ni
                if: l2_nsf_fname[k] = l2_own_name[oi]
                    return: n
                n: n + 1
            ---
            k: k + 1
        if: l2_own_computed(oi) = 0 && l2_ns_computed_decl(l2_own_decl[oi]) = 0
            return: -1
        k: 0
        while: k < oi
            if: l2_own_host[k] = 0 && l2_own_mi[k] = l2_own_mi[oi] && (l2_own_computed(k) != 0 || l2_ns_computed_decl(l2_own_decl[k]) != 0)
                n: n + 1
            k: k + 1
        ---
        return: n
    while: k < oi
        if: l2_own_host[k] = 0 && l2_own_mi[k] = l2_own_mi[oi]
            n: n + 1
        k: k + 1
    ---
return: n

# Which Structure holds own field oi in the code being emitted right now. A
# method's own field is a child of that method's own Structure, reached through
# `self`; a shared own field stays a child of the program unit.
fn: l2_own_ctr (int: oi) const: @: char
    int: k
    if: oi < 0 || oi >= l2_own_n
        return: l2_unit_ref
    if: l2_own_mi[oi] = l2_cur_mi
        return: "self"
    # A lexical ancestor is the corresponding ancestor of this occurrence,
    # including inside a copied callable view, never the module prototype.
    if: l2_own_mi[oi] != l2_e && l2_lex_depth(l2_cur_mi, l2_own_mi[oi]) > 0
        c.sprintf(l2_ctr_buf, "l2_lex_o%d", l2_own_mi[oi])
        return: l2_ctr_buf
    # A field of a program part's root, read by a method of that part (§10): the root is the method's `node`,
    # its lexical parent.
    k: l2_m_part(l2_cur_mi)
    if: k >= 0 && l2_part_ns[k] >= 0 && l2_own_mi[oi] = l2_ns_proc[l2_part_ns[k]]
        return: "node"
    # E's occurrence is the unit.
    if: l2_own_mi[oi] = l2_e
        return: l2_unit_ref
    # A field of a program part's root read from outside the part -- the lexical source of a hidden input of a
    # method of that part (Q52, book :1196) -- is in that root, the unit's child it is built as (§10), not in its
    # procedure's occurrence.
    k: l2_m_file(l2_own_mi[oi])
    if: k >= 0 && l2_part_ns[k] >= 0 && l2_own_mi[oi] = l2_ns_proc[l2_part_ns[k]] && l2_ns_parent[l2_part_ns[k]] < 0 && l2_ns_eternal[l2_part_ns[k]] < 0
        if: c.sprintf(l2_ctr_buf, "lmx_arena_ref_struct(%s, %uU)", l2_unit_ref, (cast: (unsigned) (l2_ns_unit_slot(l2_part_ns[k])))) < 0
            return: l2_unit_ref
        return: l2_ctr_buf
    if: c.sprintf(l2_ctr_buf, "lmx_arena_ref_struct(%s, %uU)", l2_unit_ref, (cast: (unsigned) l2_occ_slot(l2_own_mi[oi]))) < 0
        return: l2_unit_ref
return: l2_ctr_buf

# Which method owns an executable control body (the entry E is one).
fn: l2_for_owner (int: k) int
    if: k >= 0 && k < l2_for_n
        return: l2_for_mi[k]
return: 0 - 1

# Unhosted own fields of a method: the children of M that follow its header parts.  A named Structure's
# procedure has none there (§12): its own fields are the Structure's, in the Structure's slots, and its
# occurrence holds its header parts, its control bodies and its walked steps.
fn: l2_m_own_count (int: mi) int
    int: i 0
    int: n 0
    if: l2_m_nsof(mi) >= 0
        return: 0
    while: i < l2_own_n
        if: l2_own_host[i] = 0 && l2_own_mi[i] = mi
            n: n + 1
        i: i + 1
    ---
return: n

# Executable control bodies owned by a method, and the rank of one among them.
fn: l2_m_for_count (int: mi) int
    int: k 0
    int: n 0
    while: k < l2_for_n
        if: l2_for_owner(k) = mi && l2_for_parent[k] < 0 && (l2_for_transferred = 0 || l2_for_transferred[k] = 0)
            n: n + 1
        k: k + 1
    ---
return: n

fn: l2_for_rank (int: k) int
    int: i 0
    int: n 0
    while: i < k
        if: l2_for_owner(i) = l2_for_owner(k) && l2_for_parent[i] < 0 && (l2_for_transferred = 0 || l2_for_transferred[i] = 0)
            n: n + 1
        i: i + 1
    ---
return: n

# Number of children M needs for method mi: its header parts, its unhosted own fields, its
# control bodies.
fn: l2_m_kids (int: mi) int
    if: l2_source_root(mi) != 0
        return: l2_m_head(mi)
return: l2_m_head(mi) + l2_m_own_count(mi) + l2_m_for_count(mi)

# Remember that statement `node` stores its walker step at child `slot`.
fn: l2_ps_add (const: @(LmP0Node node); int: slot) int
    int: cap
    @@: LmP0Node nn
    @: int ns
    if: node = 0
        return: 1
    if: l2_ps_n + 1 > l2_ps_cap
        cap: 16
        if: l2_ps_cap > 0
            cap: l2_ps_cap * 2
        nn: (cast: (@@: LmP0Node) realloc((cast: (@: void) l2_ps_node), (cast: (size_t) cap) * c.sizeof(@: void)))
        if: nn = 0
            return: l2_error(l2_src, 0, "out of memory")
        l2_ps_node: nn
        ns: (cast: (@: int) realloc((cast: (@: void) l2_ps_slot), (cast: (size_t) cap) * c.sizeof(c.int)))
        if: ns = 0
            return: l2_error(l2_src, 0, "out of memory")
        l2_ps_slot: ns
        l2_ps_cap: cap
    ---
    l2_ps_node[l2_ps_n]: (cast: (@: LmP0Node) node)
    l2_ps_slot[l2_ps_n]: slot
    l2_ps_n: l2_ps_n + 1
return: 0

fn: l2_ps_lookup (const: @(LmP0Node node)) int
    int: i 0
    if: node = 0
        return: 0 - 1
    while: i < l2_ps_n
        if: l2_ps_node[i] = node
            return: l2_ps_slot[i]
        i: i + 1
    ---
return: 0 - 1

fn: l2_fill_add (int: k) int
    int: cap
    @: int nk
    if: l2_fill_n + 1 > l2_fill_cap
        cap: 16
        if: l2_fill_cap > 0
            cap: l2_fill_cap * 2
        nk: (cast: (@: int) realloc((cast: (@: void) l2_fill_k), (cast: (size_t) cap) * c.sizeof(c.int)))
        if: nk = 0
            return: l2_error(l2_src, 0, "out of memory")
        l2_fill_k: nk
        l2_fill_cap: cap
    ---
    l2_fill_k[l2_fill_n]: k
    l2_fill_n: l2_fill_n + 1
return: 0

# A walked straight-line method can take source order. Named-Structure procedures, merge hosts,
# and callable-merge anchors keep the packed prefix: their step copy still assumes a dense suffix.
fn: l2_src_eligible (int: mi) int
    int: s 0
    if: l2_library_mode != 0 || mi < 0 || mi >= l2_m_n
        return: 0
    if: l2_m_nsof(mi) >= 0 || l2_mad_on(mi) != 0 || l2_pap_on(mi) != 0
        return: 0
    if: l2_rw_may(mi) = 0
        return: 0
    while: s < l2_t7_n
        if: l2_t7_anchor[s] = mi
            return: 0
        s: s + 1
    ---
return: 1

# The own row this declaration statement opened, or -1.
fn: l2_own_by_decl (int: mi; const: @(LmP0Node stmt)) int
    int: oi 0
    if: stmt = 0
        return: 0 - 1
    while: oi < l2_own_n
        if: l2_own_decl[oi] = stmt && l2_own_mi[oi] = mi
            return: oi
        oi: oi + 1
    ---
return: 0 - 1

# A method-local definition whose tail is written atoms or one expression span, and whose
# procedure was not built. Placement keeps that Structure as the own child. A numeric
# constructor stays out.
fn: l2_atom_value_stmt (const: @(LmP0Node stmt); int: mi) int
    int: oi
    int: ni
    int: fx
    if: stmt = 0 || mi < 0 || mi = l2_e || stmt\as = 0 || stmt\as\frame = 0
        return: 0
    if: l2_local_ns_shape(stmt, mi) = 0 || (l2_atom_only_tail(stmt\as\frame) = 0 && l2_expr_only_tail(stmt\as\frame) = 0)
        return: 0
    oi: l2_own_by_decl(mi, stmt)
    if: oi < 0
        return: 0
    ni: l2_own_nsty_get(oi)
    if: ni < 0 || ni >= l2_ns_n || l2_ns_proc[ni] >= 0
        return: 0
    fx: 0
    while: fx < l2_nsf_n
        if: l2_nsf_owner[fx] = ni && l2_nsf_kind[fx] != 12
            return: 0
        fx: fx + 1
    ---
return: 1

# Legacy placement still asks only for an unhosted child. Value construction
# itself uses the resolved body shape and the completed physical GraphField.
fn: l2_atom_own_stmt (const: @(LmP0Node stmt); int: mi) int
    int: oi l2_own_by_decl(mi, stmt)
    if: oi < 0 || l2_own_host[oi] != 0 || l2_own_fid[oi] >= 0
        return: 0
return: l2_atom_value_stmt(stmt, mi)

# A method-local named Structure whose fields are numbers or chars. The own slot
# holds that Structure, with one cell per field, in source order (l2_emit_method_fields).
# A written-atom tail and an expression span stay on l2_emit_method_atom.
fn: l2_field_own_stmt (const: @(LmP0Node stmt); int: mi) int
    int: oi
    int: ni
    int: fx
    int: n 0
    if: stmt = 0 || mi < 0 || mi = l2_e || stmt\as = 0 || stmt\as\frame = 0
        return: 0
    if: l2_local_ns_shape(stmt, mi) = 0 || l2_atom_only_tail(stmt\as\frame) != 0 || l2_expr_only_tail(stmt\as\frame) != 0
        return: 0
    oi: l2_own_by_decl(mi, stmt)
    if: oi < 0
        return: 0
    ni: l2_own_nsty_get(oi)
    if: ni < 0 || ni >= l2_ns_n || l2_ns_proc[ni] >= 0
        return: 0
    fx: 0
    while: fx < l2_nsf_n
        if: l2_nsf_owner[fx] = ni && l2_nsf_kind[fx] = 2 && l2_ns_num_fields(l2_nsf_ref[fx]) = 0
            return: 0
        if: l2_nsf_owner[fx] = ni && l2_nsf_kind[fx] != 0 && l2_nsf_kind[fx] != 1 && l2_nsf_kind[fx] != 2 && l2_nsf_kind[fx] != 3 && l2_nsf_kind[fx] != 4 && l2_nsf_kind[fx] != 5 && l2_nsf_kind[fx] != 6 && l2_nsf_kind[fx] != 7 && l2_nsf_kind[fx] != 8 && l2_nsf_kind[fx] != 9 && l2_nsf_kind[fx] != 10 && l2_nsf_kind[fx] != 11
            return: 0
        if: l2_nsf_owner[fx] = ni
            n: n + 1
        fx: fx + 1
    ---
    if: n < 1
        return: 0
return: 1

# 1 when this body and every body under it declare no local. The walked operator already
# holds those statements, so the shells are not children.
fn: l2_for_plain (int: fid) int
    int: i 0
    if: fid < 0 || fid >= l2_for_n
        return: 0
    while: i < l2_own_n
        if: l2_own_fid[i] = fid
            return: 0
        i: i + 1
    ---
    i: 0
    while: i < l2_for_n
        if: l2_for_parent[i] = fid && l2_for_plain(i) = 0
            return: 0
        i: i + 1
    ---
return: 1

# Clear this body and every body under it. The walk keeps the statements.
fn: l2_for_drop (int: fid) int
    int: i 0
    if: fid < 0 || fid >= l2_for_n
        return: 1
    l2_for_uchild[fid]: -1
    while: i < l2_for_n
        if: l2_for_parent[i] = fid && l2_for_drop(i) != 0
            return: 1
        i: i + 1
    ---
return: 0

# Drop plain shells under this body and pack the shells that remain after its own fields.
# This body stays. A plain descendant's statements already live in its operator.
fn: l2_for_trim (int: fid) int
    int: i 0
    int: n 0
    if: fid < 0 || fid >= l2_for_n
        return: 1
    while: i < l2_for_n
        if: l2_for_parent[i] = fid && l2_for_plain(i) != 0 && l2_for_drop(i) != 0
            return: 1
        i: i + 1
    ---
    i: 0
    while: i < l2_own_n
        if: l2_own_fid[i] = fid
            n: n + 1
        i: i + 1
    ---
    i: 0
    while: i < l2_for_n
        if: l2_for_parent[i] = fid && l2_for_uchild[i] >= 0
            l2_for_uchild[i]: n
            n: n + 1
        i: i + 1
    ---
    l2_for_nkid[fid]: n
return: 0

# A resolved nullary Structure call occupies its written source position,
# even when its body is empty. Resolution does not require a future physical
# child before PLACE has committed it.
fn: l2_src_ns_call (const: @(LmP0Text h); int: mi) int
    int: ni
    int: k
    if: h = 0
        return: 0 - 1
    ni: l2_ns_exec_named(h, mi)
    if: ni >= 0 && l2_ns_exec[ni] != 0
        return: 1
    k: l2_ns_exec_field(h, mi)
    if: k < 0
        k: l2_local_ns_callee(h, mi)
    if: k >= 0 && l2_ns_exec[l2_own_call_origin(k)] != 0
        return: 1
    if: l2_struct_call_inert(h, mi) != 0
        return: 1
return: 0 - 1

# 1: the walk stores this field-path write as one step. 0: it does not, so the method stays packed.
fn: l2_src_path_write (const: @(LmP0Node stmt); const: @(LmP0Text h)) int
    []: int path_own 42
    @: int path 0
    int: n
    int: kind
    int: raw_type
    int: model
    int: saved_mi
    if: h = 0 || l2_rw_has_slash(h) = 0
        return: 0
    if: stmt = 0 || stmt\kind != c.LM_P0_NODE_FRAME || stmt\as = 0 || stmt\as\frame = 0 || stmt\as\frame\body = 0
        return: 0
    n: l2_count_active(stmt\as\frame\body)
    if: n < 1
        return: 0
    path: l2_rw_path_room(h, path_own, 42)
    if: l2_rw_path_meta(stmt, h, 0, path) != 0
        return: 0
    if: path[3] < 0 || path[0] = 4
        return: 0
    if: l2_own_is_pointer(path[3]) != 0
        saved_mi: l2_cur_mi
        l2_cur_mi: l2_rw_mi
        kind: l2_path_contract(h\data, h\length, @ raw_type, @ model)
        l2_cur_mi: saved_mi
        if: kind != 10 && kind != 11
            return: 0
    ---
return: 1

# 1: the walk stores this array-element write as one step. 0: it does not, so the method stays packed.
fn: l2_src_elemput (const: @(LmP0Node stmt); const: @(LmP0Text h); int: mi) int
    size_t: eix 0U
    size_t: i 0U
    size_t: saved_at
    int: oi
    int: k
    int: idx
    int: n
    int: step
    int: saved_mi
    int: saved_src
    int: saved_on
    @: LmP0Node saved_node
    if: h = 0 || h\data = 0 || stmt = 0 || stmt\kind != c.LM_P0_NODE_FRAME || stmt\as = 0 || stmt\as\frame = 0 || stmt\as\frame\body = 0
        return: 0
    while: i < h\length && h\data[i] != 91
        i: i + 1U
    ---
    if: i = h\length
        return: 0
    n: l2_count_active(stmt\as\frame\body)
    if: n < 1
        return: 0
    saved_mi: l2_here_mi
    saved_src: l2_here_source_mi
    saved_node: l2_here_node
    saved_on: l2_here_on
    saved_at: l2_here
    l2_here_at_method(mi, stmt)
    step: 0
    oi: l2_rw_elem_of(h, @ eix)
    if: oi >= 0
        step: 1
    ---
    if: step = 0
        k: 0 - 1
        idx: l2_dyn_own_index(mi, h, @ oi, @ k)
        if: idx = 1 && oi >= 0 && l2_rw_elem_ty(oi) >= 0 && l2_rw_seen(oi) != 0 && l2_own_host[oi] = 0 && l2_own_fid[oi] < 0 && l2_own_uchild[oi] >= 0 && k >= 0 && l2_rw_seen(k) != 0 && l2_own_host[k] = 0 && l2_own_fid[k] < 0 && l2_own_uchild[k] >= 0
            step: 1
    ---
    l2_here_mi: saved_mi
    l2_here_source_mi: saved_src
    l2_here_node: saved_node
    l2_here_on: saved_on
    l2_here: saved_at
return: step

# 1: the walk stores this root merge as the result cell and one step.
# A result body is literals inside that step, not more cells of the entry.
# 0: a method merge, or a form the walk does not take, so the method stays packed.
fn: l2_src_merge (const: @(LmP0Node stmt); int: mi) int
    int: oi
    if: mi != l2_e || stmt = 0
        return: 0
    if: l2_merge_frame(stmt) = 0
        return: 0
    if: l2_mres_decl(mi, stmt) < 0
        return: 0
    oi: l2_own_by_decl(mi, stmt)
    if: oi < 0 || l2_own_host[oi] != 0 || l2_own_fid[oi] >= 0
        return: 0
return: 1

# 1: the walk stores this write of a numeric formal as one SET_ARG.
# The value is the same span the walk types, with no conversion and no reference.
# 0: anything else, so the method stays packed.
fn: l2_src_set_arg (const: @(LmP0Node stmt); const: @(LmP0Text h); int: mi) int
    int: idx
    int: want
    int: n
    int: m
    int: ty
    @: LmP0Node saved
    @: L2ValueSpan tok
    if: mi < 0 || mi = l2_e || h = 0 || stmt = 0 || stmt\as = 0 || stmt\as\frame = 0 || stmt\as\frame\body = 0
        return: 0
    idx: l2_param_find(mi, h)
    if: idx < 0
        return: 0
    want: l2_own_ty_of_param(l2_param_ty(mi, h))
    if: l2_rw_num_ty(want) = 0 || l2_own_is_pointer(want) != 0
        return: 0
    n: l2_count_active(stmt\as\frame\body)
    if: n < 1
        return: 0
    saved: l2_rw_mix_at
    tok: l2_value_spans(stmt\as\frame\body\first_field, n, @ m)
    if: tok = 0
        l2_rw_mix_at: saved
        return: 0
    ---
    ty: l2_rw_tyof(tok, 0, m - 1)
    l2_xfree((cast: (@: void) tok))
    l2_rw_mix_at: saved
    if: ty = 0 - 3 || l2_oc_is_ref(ty) != 0
        return: 0
    if: ty >= 0 && ty != want
        return: 0
return: 1

# 1: the walk stores this indirect write as one PUT. The value is a number of the
# dereferenced type, with no conversion. 0: anything else, so the method stays packed.
fn: l2_src_deref (const: @(LmP0Node stmt); const: @(LmP0Text h); int: mi) int
    LmP0Text: base
    int: levels
    int: raw
    int: want
    int: n
    int: m
    int: ty
    @: LmP0Node saved
    @: L2ValueSpan tok
    if: mi < 0 || h = 0 || stmt = 0 || stmt\as = 0 || stmt\as\frame = 0 || stmt\as\frame\body = 0
        return: 0
    if: l2_deref_word(h, mi, @ base, @ levels, @ raw) != 0
        return: 0
    want: l2_own_ty_of_param(raw)
    if: l2_rw_num_ty(want) = 0 || l2_own_is_pointer(want) != 0
        return: 0
    n: l2_count_active(stmt\as\frame\body)
    if: n < 1
        return: 0
    saved: l2_rw_mix_at
    tok: l2_value_spans(stmt\as\frame\body\first_field, n, @ m)
    if: tok = 0
        l2_rw_mix_at: saved
        return: 0
    ---
    ty: l2_rw_tyof(tok, 0, m - 1)
    l2_xfree((cast: (@: void) tok))
    l2_rw_mix_at: saved
    if: ty = 0 - 3 || l2_oc_is_ref(ty) != 0
        return: 0
    if: ty >= 0 && ty != want
        return: 0
return: 1

# The existing receiving contract determines whether a numeric declaration
# has an executable write: explicit candidate, implicit input carry, or none.
# Its physical cell exists independently of that action count.
fn: l2_numeric_decl_actions (const: @(LmP0Node stmt); int: mi) int
    @: L2Declaration declaration l2_declaration(stmt)
    if: declaration = 0
        return: 0
    if: declaration\candidate_count > 0
        return: 1
    if: mi != l2_e && l2_param_find(mi, declaration\name) >= 0
        return: 1
return: 0

# One top-level statement of a method being placed. Returns 0 when the statement is in the
# straight-line subset and the cursor has advanced; 1 when this method must keep the packed prefix.
fn: l2_src_one (@: LmP0Field field; int: mi; int: commit; @: int cursor; @@: LmP0Field next; @: int seen_own; @: int seen_for) int
    @: LmP0Node stmt
    @: LmP0Text h
    @: LmP0Structure body
    @: LmP0Field bf
    @: LmP0Field f
    int: n
    int: fid
    int: oi
    int: step
    int: ni
    stmt: field\value
    \next: l2_next_active(field\next)
    if: stmt = 0
        return: 1
    l2_here_at_method(mi, stmt)
    n: l2_discard_run(field)
    # A discarded string is still a source node. It takes the next child, as a
    # char* cell of the written spelling. The walker sees no operator there.
    if: n = 1 && stmt\kind = c.LM_P0_NODE_ATOM && stmt\as != 0 && l2_quoted(stmt\as\atom) != 0
        if: commit != 0 && l2_ps_add(stmt, \cursor) != 0
            return: 1
        \cursor: \cursor + 1
        return: 0
    if: n = 1 && stmt\kind = c.LM_P0_NODE_ATOM && stmt\as != 0 && l2_rw_struct_callee(stmt\as\atom) != 0
        l2_here_at_method(mi, stmt)
        step: l2_src_ns_call(stmt\as\atom, mi)
        if: step < 0
            return: 1
        if: step != 0
            if: commit != 0 && l2_ps_add(stmt, \cursor) != 0
                return: 1
            \cursor: \cursor + 1
        ---
        return: 0
    if: n = 0 && stmt\kind = c.LM_P0_NODE_FRAME && l2_empty_struct_assign_shape(stmt, mi) != 0
        l2_here_at_method(mi, stmt)
        step: l2_src_ns_call(stmt\as\frame\head, mi)
        if: step < 0
            return: 1
        if: step != 0
            if: commit != 0 && l2_ps_add(stmt, \cursor) != 0
                return: 1
            \cursor: \cursor + 1
        ---
        return: 0
    if: n > 0
        \next: l2_skip_span(field, n)
        if: commit != 0 && l2_ps_add(stmt, \cursor) != 0
            return: 1
        \cursor: \cursor + 1
        return: 0
    # K03: a `return` -- the bare word or its Frame -- is one source step, one consumer for both spellings.
    if: l2_stmt_word(stmt, mi, "return") != 0
        if: commit != 0 && l2_ps_add(stmt, \cursor) != 0
            return: 1
        \cursor: \cursor + 1
        return: 0
    if: stmt\kind = c.LM_P0_NODE_ATOM && stmt\as != 0
        return: 1
    if: stmt\kind = c.LM_P0_NODE_STRUCTURE
        # A block closed by until is one source step. The walked UNTIL already
        # holds that body and the condition. A local stays in the shell here.
        if: l2_block_until(stmt) != 0
            fid: l2_for_find(stmt)
            if: fid < 0 || l2_for_parent[fid] >= 0 || l2_for_owner(fid) != mi
                return: 1
            n: 0
            oi: 0
            while: oi < l2_own_n
                if: l2_own_fid[oi] = fid
                    n: n + 1
                oi: oi + 1
            ---
            if: n != l2_for_nkid[fid]
                oi: 0
                while: oi < l2_for_n
                    if: l2_for_parent[oi] = fid
                        n: -1
                        oi: l2_for_n
                    oi: oi + 1
                ---
                if: n != -1
                    return: 1
            ---
            if: l2_for_plain(fid) != 0 && commit != 0 && l2_for_drop(fid) != 0
                return: 1
            if: l2_for_plain(fid) = 0 && commit != 0
                l2_for_uchild[fid]: \cursor
            if: l2_for_plain(fid) = 0
                \cursor: \cursor + 1
            if: commit != 0 && l2_ps_add(stmt, \cursor) != 0
                return: 1
            \cursor: \cursor + 1
            \seen_for: \seen_for + 1
            return: 0
        fid: l2_for_find(stmt)
        if: fid < 0 || l2_for_parent[fid] >= 0 || l2_for_owner(fid) != mi
            return: 1
        if: stmt\as = 0 || stmt\as\structure = 0
            return: 1
        body: stmt\as\structure
        if: l2_body_inert(body, mi) != 0
            n: l2_source_inert_container(body, fid, commit)
            if: n < 0
                return: 1
            if: commit != 0
                l2_for_uchild[fid]: \cursor
                if: l2_fill_add(fid) != 0
                    return: 1
            ---
            \cursor: \cursor + 1
            \seen_for: \seen_for + 1
            return: 0
        # A plain block keeps its statements in the IF. Its shell is not a child.
        # A block with locals keeps the operator first. The cell shell follows it,
        # so the declarations are not a child ahead of the instruction.
        if: l2_for_plain(fid) != 0 && commit != 0 && l2_for_drop(fid) != 0
            return: 1
        if: commit != 0 && l2_ps_add(stmt, \cursor) != 0
            return: 1
        \cursor: \cursor + 1
        if: l2_for_plain(fid) = 0 && commit != 0
            l2_for_uchild[fid]: \cursor
        if: l2_for_plain(fid) = 0
            \cursor: \cursor + 1
        \seen_for: \seen_for + 1
        return: 0
    if: stmt\kind != c.LM_P0_NODE_FRAME || stmt\as = 0 || stmt\as\frame = 0
        return: 1
    h: stmt\as\frame\head
    # A top-level if or while is one source step. The walked IF or WHILE already
    # holds the condition and that body, including a nested body that declares no
    # local. A local, or a nested body that declares one, stays in the shell at
    # this step. ELSE retains its separate source slot and owns its own body.
    if: l2_text_eq(h, "if") || l2_text_eq(h, "while")
        if: stmt\as\frame\body = 0
            return: 1
        n: l2_count_active(stmt\as\frame\body)
        bf: l2_next_active(stmt\as\frame\body\first_field)
        oi: 1
        while: oi < n
            if: bf = 0
                return: 1
            bf: l2_next_active(bf\next)
            oi: oi + 1
        ---
        if: bf = 0 || bf\value = 0 || bf\value\kind != c.LM_P0_NODE_STRUCTURE
            return: 1
        fid: l2_for_find(bf\value)
        if: fid < 0 || l2_for_parent[fid] >= 0 || l2_for_owner(fid) != mi
            return: 1
        n: 0
        oi: 0
        while: oi < l2_own_n
            if: l2_own_fid[oi] = fid
                n: n + 1
            oi: oi + 1
        ---
        # A nested body explains a wider shell. With no nested body the owns are the shell.
        if: n != l2_for_nkid[fid]
            oi: 0
            while: oi < l2_for_n
                if: l2_for_parent[oi] = fid
                    n: -1
                    oi: l2_for_n
                oi: oi + 1
            ---
            if: n != -1
                return: 1
        ---
        step: -1
        if: l2_text_eq(h, "if") != 0 && \next != 0 && \next\value != 0 && l2_frame_head(\next\value, "else") != 0
            step: l2_for_find(\next\value)
            if: step < 0 || l2_for_parent[step] >= 0 || l2_for_owner(step) != mi
                return: 1
            n: 0
            oi: 0
            while: oi < l2_own_n
                if: l2_own_fid[oi] = step
                    n: n + 1
                oi: oi + 1
            ---
            if: n != l2_for_nkid[step]
                oi: 0
                while: oi < l2_for_n
                    if: l2_for_parent[oi] = step
                        n: -1
                        oi: l2_for_n
                    oi: oi + 1
                ---
                if: n != -1
                    return: 1
            ---
            \next: l2_next_active(\next\next)
        ---
        if: l2_for_plain(fid) != 0 && commit != 0 && l2_for_drop(fid) != 0
            return: 1
        if: step >= 0 && l2_for_plain(step) != 0 && commit != 0 && l2_for_drop(step) != 0
            return: 1
        if: commit != 0 && l2_ps_add(stmt, \cursor) != 0
            return: 1
        \cursor: \cursor + 1
        # The shell is child 0 of the walked body, not a sibling of the operator.
        # -2 names that placement. Native l2_h still binds it.
        if: l2_for_plain(fid) = 0 && commit != 0
            l2_for_uchild[fid]: 0 - 2
        # The enclosing source body owns ELSE; IF only borrows its false arm.
        # -3 marks the old shell inside ELSE.body (child 1), not IF.child 3.
        if: step >= 0
            if: commit != 0
                if: l2_ps_add(l2_for_stmt[step], \cursor) != 0
                    return: 1
                if: l2_for_plain(step) = 0
                    l2_for_uchild[step]: 0 - 3
                ---
            ---
            \cursor: \cursor + 1
        \seen_for: \seen_for + 1
        if: step >= 0
            \seen_for: \seen_for + 1
        return: 0
    # A c-style for. The shell at this index holds the counter and any local
    # the body keeps. A nested body with no local is not a shell; its statements
    # stay in the operator. The initializer is the next child and the FOR follows it.
    if: l2_text_eq(h, "for")
        if: l2_for_cstyle(stmt) = 0 || stmt\as = 0 || stmt\as\frame = 0 || stmt\as\frame\body = 0
            return: 1
        fid: l2_for_find(stmt)
        if: fid < 0 || l2_for_parent[fid] >= 0 || l2_for_owner(fid) != mi
            return: 1
        bf: l2_next_active(stmt\as\frame\body\first_field)
        if: bf = 0
            return: 1
        n: 0
        step: 0
        oi: 0
        while: oi < l2_own_n
            if: l2_own_fid[oi] = fid
                n: n + 1
                if: l2_own_decl[oi] = bf\value
                    step: 1
                ---
            oi: oi + 1
        ---
        if: step != 1
            return: 1
        step: 0
        oi: 0
        while: oi < l2_for_n
            if: l2_for_parent[oi] = fid
                step: step + 1
            oi: oi + 1
        ---
        n: n + step
        if: l2_for_nkid[fid] != n
            return: 1
        if: commit != 0 && l2_for_trim(fid) != 0
            return: 1
        step: \cursor + 1
        if: commit != 0
            l2_for_uchild[fid]: \cursor
            if: l2_ps_add(stmt, step) != 0
                return: 1
        ---
        \cursor: \cursor + 2 + l2_numeric_decl_actions(bf\value, mi)
        \seen_for: \seen_for + 1
        return: 0
    # A top-level catch is one source step. The walked PAD already holds the
    # handler. A parameter or a local stays in the shell at this step.
    if: l2_text_eq(h, "catch")
        fid: l2_for_find(stmt)
        if: fid < 0 || l2_for_parent[fid] >= 0 || l2_for_owner(fid) != mi
            return: 1
        n: 0
        oi: 0
        while: oi < l2_own_n
            if: l2_own_fid[oi] = fid
                n: n + 1
            oi: oi + 1
        ---
        if: n != l2_for_nkid[fid]
            oi: 0
            while: oi < l2_for_n
                if: l2_for_parent[oi] = fid
                    n: -1
                    oi: l2_for_n
                oi: oi + 1
            ---
            if: n != -1
                return: 1
        ---
        if: l2_for_plain(fid) != 0 && commit != 0 && l2_for_drop(fid) != 0
            return: 1
        if: l2_for_plain(fid) = 0 && commit != 0
            l2_for_uchild[fid]: \cursor
        if: l2_for_plain(fid) = 0
            \cursor: \cursor + 1
        if: commit != 0 && l2_ps_add(stmt, \cursor) != 0
            return: 1
        \cursor: \cursor + 1
        \seen_for: \seen_for + 1
        return: 0
    if: l2_text_eq(h, "else") || l2_text_eq(h, "until") || l2_text_eq(h, "fn") || l2_text_eq(h, "throw") || l2_text_eq(h, "throws")
        return: 1
    # The root's one-name receiveMessage is the letter cell and then the take.
    # A second name is an admission the walk does not place here.
    if: l2_text_eq(h, "receiveMessage")
        if: mi != l2_e || l2_find_method(h) >= 0
            return: 1
        if: stmt\as = 0 || stmt\as\frame = 0 || stmt\as\frame\body = 0 || l2_count_active(stmt\as\frame\body) != 1
            return: 1
        oi: l2_own_by_decl(mi, stmt)
        if: oi < 0 || l2_own_host[oi] != 0 || l2_own_is_pointer(l2_own_ty[oi]) = 0
            return: 1
        if: commit != 0
            l2_own_uchild[oi]: \cursor
        \cursor: \cursor + 1
        \seen_own: \seen_own + 1
        if: commit != 0 && l2_ps_add(stmt, \cursor) != 0
            return: 1
        \cursor: \cursor + 1
        return: 0
    if: l2_text_eq(h, "sendMessage")
        if: mi != l2_e
            return: 1
        if: commit != 0 && l2_ps_add(stmt, \cursor) != 0
            return: 1
        \cursor: \cursor + 1
        return: 0
    oi: l2_own_ref_decl(stmt, mi)
    if: oi >= 0
        if: l2_own_host[oi] != 0
            return: 1
        if: commit != 0
            l2_own_uchild[oi]: \cursor
        \cursor: \cursor + 1
        \seen_own: \seen_own + 1
        if: commit != 0 && l2_ps_add(stmt, \cursor) != 0
            return: 1
        \cursor: \cursor + 1
        return: 0
    if: l2_prim_type_word(h) != 0
        if: l2_text_eq(h, "int") = 0 && l2_text_eq(h, "char") = 0 && l2_text_eq(h, "size_t") = 0 && l2_text_eq(h, "unsigned") = 0 && l2_text_eq(h, "ulong") = 0
            # The root's Model: name is the cell and then the merge.
            # A method stays packed.
            if: mi != l2_e
                return: 1
            ni: l2_ns_find(h)
            oi: l2_own_by_decl(mi, stmt)
            if: ni < 0 || oi < 0 || l2_own_host[oi] != 0 || l2_own_fid[oi] >= 0
                return: 1
            if: l2_own_nsty_get(oi) != ni || l2_ns_parent[ni] >= 0 || l2_ns_eternal[ni] >= 0
                return: 1
            if: stmt\as = 0 || stmt\as\frame = 0 || stmt\as\frame\body = 0
                return: 1
            if: l2_count_active(stmt\as\frame\body) = 1
                f: l2_next_active(stmt\as\frame\body\first_field)
                if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM
                    return: 1
                if: commit != 0
                    l2_own_uchild[oi]: \cursor
                \cursor: \cursor + 1
                \seen_own: \seen_own + 1
                if: commit != 0 && l2_ps_add(stmt, \cursor) != 0
                    return: 1
                \cursor: \cursor + 1
                return: 0
            return: 1
        oi: l2_own_by_decl(mi, stmt)
        if: oi < 0 || l2_own_host[oi] != 0
            return: 1
        if: commit != 0
            l2_own_uchild[oi]: \cursor
        \cursor: \cursor + 1
        \seen_own: \seen_own + 1
        f: l2_next_active(stmt\as\frame\body\first_field)
        if: f = 0
            return: 1
        step: l2_numeric_decl_actions(stmt, mi)
        if: step != 0
            if: commit != 0 && l2_ps_add(stmt, \cursor) != 0
                return: 1
            \cursor: \cursor + 1
        ---
        return: 0
    if: l2_text_eq(h, "[]")
        oi: l2_own_by_decl(mi, stmt)
        if: oi < 0 || l2_own_host[oi] != 0 || l2_own_fid[oi] >= 0 || l2_own_uchild[oi] < 0
            return: 1
        if: l2_rw_elem_ty(oi) < 0 || stmt\as\frame\body = 0 || l2_count_active(stmt\as\frame\body) != 3
            return: 1
        if: commit != 0
            l2_own_uchild[oi]: \cursor
        \cursor: \cursor + 1
        \seen_own: \seen_own + 1
        return: 0
    if: l2_find_method(h) >= 0 && l2_find_method(h) != l2_e
        if: commit != 0 && l2_ps_add(stmt, \cursor) != 0
            return: 1
        \cursor: \cursor + 1
        return: 0
    if: l2_src_path_write(stmt, h) != 0
        if: commit != 0 && l2_ps_add(stmt, \cursor) != 0
            return: 1
        \cursor: \cursor + 1
        return: 0
    if: l2_src_elemput(stmt, h, mi) != 0
        if: commit != 0 && l2_ps_add(stmt, \cursor) != 0
            return: 1
        \cursor: \cursor + 1
        return: 0
    if: l2_src_merge(stmt, mi) != 0
        oi: l2_own_by_decl(mi, stmt)
        if: commit != 0
            l2_own_uchild[oi]: \cursor
        \cursor: \cursor + 1
        \seen_own: \seen_own + 1
        if: commit != 0 && l2_ps_add(stmt, \cursor) != 0
            return: 1
        \cursor: \cursor + 1
        return: 0
    oi: l2_own_by_decl(mi, stmt)
    if: oi >= 0 && (stmt\as\frame\body = 0 || l2_count_active(stmt\as\frame\body) = 0)
        if: l2_own_host[oi] != 0
            return: 1
        if: commit != 0
            l2_own_uchild[oi]: \cursor
        \cursor: \cursor + 1
        \seen_own: \seen_own + 1
        return: 0
    # A written-atom definition is the own child itself. No second step: the
    # empty cell at that index is the Structure (l2_emit_method_atom).
    if: l2_atom_own_stmt(stmt, mi) != 0
        if: commit != 0
            l2_own_uchild[oi]: \cursor
        \cursor: \cursor + 1
        \seen_own: \seen_own + 1
        return: 0
    if: oi >= 0
        return: 1
    oi: 0
    while: oi < l2_own_n
        if: l2_own_mi[oi] = mi && l2_text_same(l2_own_name[oi], h) != 0
            if: stmt\as\frame\body = 0 || l2_count_active(stmt\as\frame\body) < 1
                return: 1
            if: commit != 0 && l2_ps_add(stmt, \cursor) != 0
                return: 1
            \cursor: \cursor + 1
            return: 0
        oi: oi + 1
    ---
    if: l2_src_deref(stmt, h, mi) != 0
        if: commit != 0 && l2_ps_add(stmt, \cursor) != 0
            return: 1
        \cursor: \cursor + 1
        return: 0
    if: l2_src_set_arg(stmt, h, mi) != 0
        if: commit != 0 && l2_ps_add(stmt, \cursor) != 0
            return: 1
        \cursor: \cursor + 1
        return: 0
return: 1

# Place method mi when `commit` is 1. A return of 1 leaves the packed slots in place.
fn: l2_src_method (int: mi; int: commit) int
    @: LmP0Field field 0
    @: LmP0Structure tr 0
    int: cursor
    int: seen_own 0
    int: seen_for 0
    int: saved l2_rw_mi
    cursor: l2_m_head(mi)
    if: l2_m_body[mi] != 0 && l2_m_body[mi]\as != 0 && l2_m_body[mi]\as\structure != 0
        field: l2_next_active(l2_m_body[mi]\as\structure\first_field)
    l2_rw_mi: mi
    while: field != 0
        if: l2_src_one(field, mi, commit, @ cursor, @ field, @ seen_own, @ seen_for) != 0
            l2_rw_mi: saved
            return: 1
    ---
    if: seen_own != l2_m_own_count(mi) || seen_for != l2_m_for_count(mi)
        l2_rw_mi: saved
        return: 1
    if: l2_m_node[mi] != 0 && l2_m_node[mi]\as != 0
        tr: l2_ret_tr(l2_m_node[mi]\as\frame)
    if: tr != 0
        if: commit != 0
            l2_m_trail[mi]: 1
        cursor: cursor + 1
    ---
    if: commit != 0
        l2_m_src_end[mi]: cursor
    l2_rw_mi: saved
return: 0

fn: l2_layout_source () int
    int: mi 0
    if: l2_library_mode != 0 || l2_m_n <= 0
        return: 0
    if: l2_m_src_end != 0
        l2_xfree((cast: (@: void) l2_m_src_end))
    if: l2_m_trail != 0
        l2_xfree((cast: (@: void) l2_m_trail))
    l2_m_src_end: (cast: (@: int) calloc((cast: (size_t) l2_m_n), c.sizeof(c.int)))
    l2_m_trail: (cast: (@: int) calloc((cast: (size_t) l2_m_n), c.sizeof(c.int)))
    if: l2_m_src_end = 0 || l2_m_trail = 0
        return: l2_error(l2_src, 0, "out of memory")
    l2_ps_n: 0
    l2_fill_n: 0
    while: mi < l2_m_n
        l2_m_src_end[mi]: 0 - 1
        l2_m_trail[mi]: 0
        # The unit's execution body now commits its complete source positions
        # in COUNT, like an actual nested body, not in the legacy ps/fill pass.
        if: mi != l2_e && l2_src_eligible(mi) != 0 && l2_src_method(mi, 0) = 0
            if: l2_src_method(mi, 1) != 0
                return: l2_error(l2_src, l2_m_node[mi], "internal: source order could not be placed")
            ---
        mi: mi + 1
    ---
return: 0

# One source-container traversal for COUNT (0), PLACE (1) and FILL (2).
# These containers already have their physical objects; expression materializers
# fill their original fields, never a second body assembled from effect counts.
fn: l2_source_inert_container (const: @(LmP0Structure body); int: fid; int: phase) int
    int: width
    int: holder 0 - 1
    if: body = 0 || fid < 0 || fid >= l2_for_n
        return: -1
    if: phase = 2
        holder: l2_rw_t
        l2_rw_t: l2_rw_t + 1
        if: c.fprintf(l2_out, "        @: Lmx l2_rw%d l2_b%d\n", holder, fid) < 0
            return: -1
    ---
    width: l2_source_container_fields((cast: (@: LmP0Structure) body), fid, phase, holder)
    if: width < 0
        return: -1
    if: phase = 1
        l2_for_nkid[fid]: width
    if: phase = 2 && width != l2_for_nkid[fid]
        return: -1
return: width

# After roles and all original container objects exist, fill their source fields.
fn: l2_fill_inert () int
    int: i 0
    int: k
    int: saved_mi l2_rw_mi
    int: saved_cur l2_cur_mi
    int: saved_emit l2_rw_emit
    @: LmP0Node node
    while: i < l2_fill_n
        k: l2_fill_k[i]
        if: l2_for_transferred != 0 && l2_for_transferred[k] != 0
            i: i + 1
            continue
        node: l2_for_node[k]
        if: node = 0 || node\as = 0 || node\as\structure = 0
            return: l2_error(l2_src, node, "internal: an expression body is missing")
        l2_rw_mi: l2_for_owner(k)
        l2_cur_mi: l2_rw_mi
        l2_rw_emit: 1
        if: l2_source_inert_container(node\as\structure, k, 2) < 0
            l2_rw_mi: saved_mi
            l2_cur_mi: saved_cur
            l2_rw_emit: saved_emit
            return: l2_error(l2_src, node, "internal: retained source container changed between passes")
        l2_rw_mi: saved_mi
        l2_cur_mi: saved_cur
        l2_rw_emit: saved_emit
        i: i + 1
    ---
return: 0

fn: l2_layout_owns () int
    int: oi 0
    int: fid
    while: oi < l2_for_n
        l2_for_nkid[oi]: 0
        oi: oi + 1
    oi: 0
    while: oi < l2_own_n
        if: l2_own_host[oi] = 0
            l2_own_fid[oi]: -1
            l2_own_fchild[oi]: -1
            l2_own_uchild[oi]: l2_own_mslot(oi)
            # l2_own_mslot maps the existing declaration occurrence, including
            # repeated names; structural lookup by spelling is not that identity.
            if: l2_own_uchild[oi] < 0
                return: l2_error(l2_src, l2_own_decl[oi], "internal: an own declaration has no physical field")
            ---
        if: l2_own_host[oi] != 0
            fid: l2_for_find(l2_own_host[oi])
            if: fid < 0
                return: 1
            l2_own_fid[oi]: fid
            l2_own_fchild[oi]: l2_for_nkid[fid]
            l2_for_nkid[fid]: l2_for_nkid[fid] + 1
            l2_own_uchild[oi]: -1
        oi: oi + 1
    # A top-level control body becomes a child of its method Structure (for the
    # entry E, of the unit). A nested body becomes a child of its containing
    # body, after that body's direct own fields. Discovery is preorder, so a
    # parent is always laid out before its descendants.
    oi: 0
    while: oi < l2_for_n
        if: l2_for_parent[oi] >= 0
            l2_for_uchild[oi]: l2_for_nkid[l2_for_parent[oi]]
            l2_for_nkid[l2_for_parent[oi]]: l2_for_nkid[l2_for_parent[oi]] + 1
        if: l2_for_parent[oi] < 0
            l2_for_uchild[oi]: l2_m_head(l2_for_owner(oi)) + l2_m_own_count(l2_for_owner(oi)) + l2_for_rank(oi)
        ---
        oi: oi + 1
    ---
    # The unit is E's occurrence: E's own fields and control bodies from 0 (E has no header
    # parts); the other methods' occurrences follow. Source order overwrites the packed slots
    # of straight-line methods before any width is read.
    # Source-placement analysis also resolves field paths. Give it the explicit
    # current layout; emit_unit reseeds after the source pass finishes its moves.
    if: l2_graph_places_seed() != 0
        return: 1
    if: l2_layout_source() != 0
        return: 1
    l2_unit_base: 0
    if: l2_e >= 0
        l2_unit_base: l2_m_kids(l2_e)
    ---
return: 0

fn: l2_for_cstyle (const: @(LmP0Node stmt)) int
    @: LmP0Field f0
    @: LmP0Field f1
    @: LmP0Field f2
    @: LmP0Field f3
    @: LmP0Field f4
    if: l2_frame_head(stmt, "for") = 0
        return: 0
    if: stmt\as = 0 || stmt\as\frame = 0 || stmt\as\frame\body = 0
        return: 0
    if: l2_count_active(stmt\as\frame\body) != 5
        return: 0
    f0: l2_next_active(stmt\as\frame\body\first_field)
    if: f0 = 0
        return: 0
    f1: l2_next_active(f0\next)
    if: f1 = 0
        return: 0
    f2: l2_next_active(f1\next)
    if: f2 = 0
        return: 0
    f3: l2_next_active(f2\next)
    if: f3 = 0
        return: 0
    f4: l2_next_active(f3\next)
    if: f4 = 0
        return: 0
    if: l2_own_decl_ty(f0\value) != 3
        return: 0
    if: f1\value = 0 || f1\value\kind != c.LM_P0_NODE_STRUCTURE || f1\value\as = 0
        return: 0
    if: f2\value = 0 || f2\value\kind != c.LM_P0_NODE_ATOM || l2_ident(f2\value\as\atom) = 0
        return: 0
    if: f3\value = 0 || f3\value\kind != c.LM_P0_NODE_ATOM
        return: 0
    if: l2_text_eq(f3\value\as\atom, "++") = 0 && l2_text_eq(f3\value\as\atom, "--") = 0
        return: 0
    if: f4\value = 0 || f4\value\kind != c.LM_P0_NODE_STRUCTURE || f4\value\as = 0
        return: 0
return: 1

# l2_path_own (node/for's own single-hop own-table lookup) is removed --
# FABLE-SONNET-NODE-ROOT-20260923-121, author Q9: node/for are ordinary
# roots of the -113 path dispatcher now.
fn: l2_slot_decl_ty (const: @(LmP0Node stmt)) int
    @: LmP0Field f
    @: LmP0Field g
    if: l2_frame_head(stmt, "@") = 0
        return: 0
    if: stmt\as = 0 || stmt\as\frame = 0 || stmt\as\frame\body = 0
        return: 0
    if: l2_count_active(stmt\as\frame\body) != 2
        return: 0
    f: l2_next_active(stmt\as\frame\body\first_field)
    g: l2_next_active(f\next)
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM
        return: 0
    if: g = 0 || g\value = 0 || g\value\kind != c.LM_P0_NODE_ATOM
        return: 0
    if: l2_bind_spelling(g\value\as\atom) = 0
        return: 0
    if: l2_text_eq(f\value\as\atom, "char")
        return: 3
    if: l2_text_eq(f\value\as\atom, "size_t")
        return: 9
return: 0

fn: l2_slot_find (int: mi; const: @(LmP0Text t)) int
    int: i 0
    if: mi < 0 || t = 0
        return: -1
    while: i < l2_m_sn[mi]
        if: l2_text_same(l2_sn[l2_slot_off(mi, i)], t)
            return: i
        i: i + 1
return: -1

fn: l2_is_char_decl (const: @(LmP0Node stmt)) int
    if: l2_own_decl_ty(stmt) != 0
        return: 1
    if: l2_slot_decl_ty(stmt) != 0
        return: 1
return: 0

fn: l2_is_plus (const: @(LmP0Text t)) int
    if: l2_text_eq(t, "+") || l2_text_eq(t, "/") || l2_text_eq(t, "-") || l2_text_eq(t, "*") || l2_text_eq(t, "%")
        return: 1
    if: l2_text_eq(t, "&") || l2_text_eq(t, "|") || l2_text_eq(t, "<<") || l2_text_eq(t, ">>")
        return: 1
return: 0

fn: l2_is_cmp (const: @(LmP0Text t)) int
    if: l2_text_eq(t, "<") || l2_text_eq(t, ">") || l2_text_eq(t, "=") || l2_text_eq(t, "!=") || l2_text_eq(t, "<=") || l2_text_eq(t, ">=")
        return: 1
return: 0

fn: l2_is_andor (const: @(LmP0Text t)) int
    if: l2_text_eq(t, "&&") || l2_text_eq(t, "||")
        return: 1
return: 0

fn: l2_is_brack (const: @(LmP0Text t)) int
    if: l2_text_eq(t, "[") || l2_text_eq(t, "]")
        return: 1
return: 0

fn: l2_is_slash (const: @(LmP0Text t)) int
    if: t = 0 || t\length != 1U
        return: 0
    if: t\data[0] != 92
        return: 0
return: 1

# c.name is the explicit foreign door (spec 6.6.6): admitted as written, and the
# C compiler checks the declaration and the ABI. A bare name is an L2 call and
# resolves only against unit methods and parsed prototype: declarations. The
# includes a foreign name implies are emission needs, not admission.
fn: l2_is_known (const: @(LmP0Text t)) int
    if: t = 0 || t\data = 0
        return: 0
    # Includes for runtime headers come from the source unit's own predef:/include:
    # (plus the profile prelude). Name-driven need_stdlib/need_string/need_p0/need_own
    # (FABLE-SONNET-NAME-SPECIALS-20260924-155 commit 3, :18296) are gone. Emitter-set
    # need_query remains where the translator emits its own helper.
    # c.* is the raw door; a leading c.array: local declarator is gone too
    # (FABLE-SONNET-NAME-SPECIALS-20260924-155 commit 4, :5029) -- it is
    # just an ordinary c.* frame now, matched here like any other.
    if: t\length > 2U && t\data[0] = 99 && t\data[1] = 46
        return: 1
    # FABLE-SONNET-NAME-SPECIALS-20260924-155 commit 2 (steps/name-specials-
    # inventory.md): the translator's own adapter families are LMX functions
    # implemented in L1 (l1src/parser.lm1, l1src/own.lm1, l2src/*.h.lm1) --
    # visible ONLY through the source unit's own predef: declarations, like
    # any other adapter, never through a name whitelist (plan §7a norm).
    # This dropped a hard-coded 11-name list that used to answer for a
    # handful of names before ever asking l2_predef_has_function; measured
    # which fixtures actually relied on it (none of them redundant with the
    # general mechanism) and gave each the predef:/prototype line it lacked
    # instead of keeping the special case.
    if: l2_predef_has_function(t) != 0
        return: 1
return: 0

# A c.name the generic C call lowers inside an expression. The forms excluded
# here have their own lowering: a type operand, an owned-text helper with a
# fixed emitted name, or a byte/Message operation with materialised operands.
# A c.name statement the generic C call lowers. c.* is a uniform raw door.
fn: l2_c_stmt_door (const: @(LmP0Text t)) int
    if: t = 0 || t\data = 0 || t\length <= 2U || t\data[0] != 99 || t\data[1] != 46
        return: 0
return: 1

# The primitive type words: a type operand of sizeof:, never a lexical
# reference. FABLE-SONNET-TYPE-WORD-FOLD-20260924-162 commit 2: thin
# wrapper over the shared pointer-local word-matcher (l2_ptr_type_word's
# depth=1 table already has exactly these six words; depth=2 would add
# nothing not already covered).
fn: l2_prim_type_word (const: @(LmP0Text t)) int
    int: dummy_ty 0
return: l2_ptr_type_word(t, 1, @ dummy_ty) = 0

fn: l2_is_binop (const: @(LmP0Text t)) int
    if: l2_is_plus(t) || l2_is_cmp(t) || l2_is_andor(t)
        return: 1
return: 0

# The existing resolved call categories, without scanning operand subtrees.
# Call detection and dependency waiting share this boundary.
fn: l2_frame_is_call (const: @(LmP0Frame frame); int: mi) int
    int: fi
    int: local
    if: frame = 0 || frame\head = 0
        return: 0
    if: l2_call_head_method(mi, frame\head, @ fi) >= 0 || l2_is_known(frame\head) != 0 || l2_call_head_held(mi, frame\head) >= 0
        return: 1
    local: l2_ml_find(frame\head)
    if: local >= 0 && l2_ml_ty[local] = 40
        return: 1
    if: l2_raw_head(frame\head, mi, @ fi) = 0
        return: 1
return: 0

fn: l2_node_has_call (const: @(LmP0Node node)) int
    @: LmP0Field f
    int: fi 0
    if: node = 0
        return: 0
    # A callable named as a value is called (l2_prep): a unit method, or a callable formal of the
    # method being lowered -- so `&&`/`||` guard it like any call.
    if: node\kind = c.LM_P0_NODE_ATOM && node\as != 0 && node\as\atom != 0 && l2_atom_callee(node\as\atom, l2_cur_mi, @ fi) >= 0
        return: 1
    if: node\kind = c.LM_P0_NODE_FRAME && node\as != 0 && node\as\frame != 0 && l2_frame_is_call(node\as\frame, l2_cur_mi) != 0
        return: 1
    if: node\kind = c.LM_P0_NODE_FRAME && node\as != 0 && node\as\frame != 0 && node\as\frame\body != 0
        return: l2_fields_has_call(node\as\frame\body\first_field, l2_count_active(node\as\frame\body))
    if: node\kind = c.LM_P0_NODE_STRUCTURE && node\as != 0 && node\as\structure != 0
        return: l2_fields_has_call(node\as\structure\first_field, l2_count_active(node\as\structure))
return: 0

fn: l2_fields_has_call (@: LmP0Field field; int: n) int
    @: LmP0Field f
    int: i
    int: run
    int: callee
    @: char path 0
    f: l2_next_active(field)
    i: 0
    while: i < n && f != 0
        run: l2_operand_run(f, n - i)
        callee: l2_path_run_callee(f, run, l2_cur_mi, @ path)
        if: path != 0
            l2_xfree((cast: (@: void) path))
            path: 0
        if: callee >= 0
            return: 1
        if: l2_node_has_call(f\value)
            return: 1
        f: l2_next_active(f\next)
        i: i + 1
return: 0

fn: l2_is_or_atom (const: @(LmP0Node node)) int
    if: node = 0 || node\kind != c.LM_P0_NODE_ATOM
        return: 0
return: l2_text_eq(node\as\atom, "||")

fn: l2_is_and_atom (const: @(LmP0Node node)) int
    if: node = 0 || node\kind != c.LM_P0_NODE_ATOM
        return: 0
return: l2_text_eq(node\as\atom, "&&")

fn: l2_advance (@: LmP0Field f; int: k) @: LmP0Field
    int: i 0
    while: i < k && f != 0
        f: l2_next_active(f\next)
        i: i + 1
return: f

fn: l2_span_or (@: LmP0Field field; int: n) int
    @: LmP0Field f
    int: i 0
    f: l2_next_active(field)
    while: i < n && f != 0
        if: i > 0 && l2_is_or_atom(f\value)
            return: i
        f: l2_next_active(f\next)
        i: i + 1
return: i

fn: l2_span_and (@: LmP0Field field; int: n) int
    @: LmP0Field f
    int: i 0
    f: l2_next_active(field)
    while: i < n && f != 0
        if: i > 0 && l2_is_and_atom(f\value)
            return: i
        f: l2_next_active(f\next)
        i: i + 1
return: i

fn: l2_bump_ind (const: @(char ind); @@: char dest) int
    size_t: ln
    size_t: need
    @: char made 0
    if: dest = 0 || ind = 0
        return: 1
    \dest: 0
    ln: strlen(ind)
    if: ln > ((cast: (size_t) -1) - 5U)
        l2_alloc_err: 2
        return: 1
    if: l2_indent_n = c.INT_MAX || l2_indent_reserve(l2_indent_n + 1) != 0
        return: 1
    need: ln + 5U
    l2_alloc_kind: 8
    made: (cast: (@: char) l2_xmalloc(need))
    if: made = 0
        return: 1
    memcpy(made, ind, ln)
    made[ln]: 32
    made[ln + 1U]: 32
    made[ln + 2U]: 32
    made[ln + 3U]: 32
    made[ln + 4U]: 0
    l2_indent_at[l2_indent_n]: made
    l2_indent_n: l2_indent_n + 1
    \dest: made
return: 0

fn: l2_new_temp (const: @(char ind); @: L2Tx dest) int
    int: t
    if: dest = 0
        return: 1
    t: l2_tn
    l2_tn: l2_tn + 1
    if: c.fprintf(l2_out, "%sint: l2_t%d\n", ind, t) < 0
        return: 1
return: l2_tx_temp(dest, t)

fn: l2_bool_set (const: @(char ind); const: @(char dest); const: @(char rhs)) int
    if: dest = 0 || rhs = 0 || ind = 0
        return: 1
    if: c.fprintf(l2_out, "%s%s: (%s) != 0\n", ind, dest, rhs) < 0
        return: 1
return: 0

fn: l2_eval_cond (@: LmP0Field field; int: n; int: mi; const: @(char ind); const: @(char dest)) int
    []: char scratch_own 1024
    L2Tx: scratch_tx
    @: L2Tx scratch @ scratch_tx
    if: dest = 0 || l2_tx_open(scratch, scratch_own, 1024U) != 0
        return: 1
    if: l2_eval_fields(field, n, mi, ind, scratch) != 0
        return: 1
return: l2_bool_set(ind, dest, scratch\data)

fn: l2_intern_prove (const: @(char path); const: @(LmP0Node node)) int
    unsigned: id
    int: two
    if: l2_mul3_ok(2U, 3U, 4U) = 0
        return: l2_error(path, node, "intern broken")
    if: l2_mul3_ok((cast: (size_t) -1), 2U, 1U) != 0
        return: l2_error(path, node, "intern broken")
    if: l2_m_n = 0
        return: 0
    id: l2_m_sig[0]
    l2_intern_again: l2_intern_mi(0)
    if: l2_intern_again = 0U && l2_alloc_err = 2
        return: l2_error(path, node, "size overflow")
    if: l2_intern_again = 0U && l2_alloc_err != 0
        return: l2_error(path, node, "out of memory")
    if: id = 0U || l2_intern_again != id
        return: l2_error(path, node, "intern broken")
    l2_intern_swap: 0U
    two: 0
    if: l2_m_arity[0] = 2 && l2_m_f0[0] != 0 && l2_m_f1[0] != 0
        two: 1
    if: two != 0 && l2_text_same(l2_m_f0[0], l2_m_f1[0]) = 0
        l2_intern_swap: l2_intern_pair(l2_m_f1[0]\data, l2_m_f1[0]\length, l2_m_f0[0]\data, l2_m_f0[0]\length)
    if: two != 0 && l2_intern_swap = 0U && l2_alloc_err = 2
        return: l2_error(path, node, "size overflow")
    if: two != 0 && l2_intern_swap = 0U && l2_alloc_err != 0
        return: l2_error(path, node, "out of memory")
    if: two != 0 && l2_text_same(l2_m_f0[0], l2_m_f1[0]) = 0 && (l2_intern_swap = 0U || l2_intern_swap = id)
        return: l2_error(path, node, "intern failed to distinguish swapped formals")
    l2_intern_probe: l2_intern_pair("a", 1U, "b", 1U)
    if: l2_intern_probe = 0U && l2_alloc_err = 2
        return: l2_error(path, node, "size overflow")
    if: l2_intern_probe = 0U && l2_alloc_err != 0
        return: l2_error(path, node, "out of memory")
    if: l2_intern_probe = 0U
        return: l2_error(path, node, "intern broken")
    # D-107 (REVIEW 59c74b3, fable_pc): the probe is the contract of two int inputs `a`, `b` and an
    # int result; whether the unit's first method IS that contract is the interner's own equality
    # (l2_intern_eq_mi: arity, input types, result, throws, names) -- not a look at two names and one
    # type, which took `fn: zz (int: a; int: b) size_t` for the probe's and refused the unit.
    if: two != 0 && l2_intern_eq_mi(l2_intern_probe - 1U, 0) != 0 && l2_intern_probe != id
        return: l2_error(path, node, "intern failed memcmp of equal names")
    if: two != 0 && l2_intern_eq_mi(l2_intern_probe - 1U, 0) = 0 && l2_intern_probe = id
        return: l2_error(path, node, "intern false-equal distinct contracts")
    l2_sigv: id
return: 0

fn: l2_ebr_reserve (int: need) int
    size_t: cap
    size_t: need_u
    size_t: psz
    size_t: nb
    size_t: nz
    @@: LmP0Text nn 0
    @@: LmP0Text nl 0
    @: size_t nv 0
    @@: LmP0Node na 0
    int: i
    if: need < 0
        return: 1
    if: need <= l2_ebr_cap
        return: 0
    if: need > c.INT_MAX
        l2_alloc_err: 2
        return: 1
    need_u: (cast: (size_t) need)
    cap: (cast: (size_t) l2_ebr_cap)
    if: cap < 1U
        cap: 4U
    while: cap < need_u
        if: cap > ((cast: (size_t) -1) / 2U)
            l2_alloc_err: 2
            return: 1
        cap: cap * 2U
    psz: c.sizeof(@: char)
    if: l2_mul_ok(cap, psz) = 0 || l2_mul_ok(cap, c.sizeof(c.size_t)) = 0
        l2_alloc_err: 2
        return: 1
    nb: cap * psz
    nz: cap * c.sizeof(c.size_t)
    l2_alloc_kind: 5
    nn: (cast: (@@: LmP0Text) l2_xmalloc(nb))
    nl: (cast: (@@: LmP0Text) l2_xmalloc(nb))
    nv: (cast: (@: size_t) l2_xmalloc(nz))
    na: (cast: (@@: LmP0Node) l2_xmalloc(nb))
    if: nn = 0 || nl = 0 || nv = 0 || na = 0
        if: nn != 0
            l2_xfree((cast: (@: void) nn))
        if: nl != 0
            l2_xfree((cast: (@: void) nl))
        if: nv != 0
            l2_xfree((cast: (@: void) nv))
        if: na != 0
            l2_xfree((cast: (@: void) na))
        return: 1
    memset((cast: (@: void) nn), 0, nb)
    memset((cast: (@: void) nl), 0, nb)
    memset((cast: (@: void) nv), 0, nz)
    memset((cast: (@: void) na), 0, nb)
    i: 0
    while: i < l2_ebr_n
        nn[i]: l2_ebr_name[i]
        nl[i]: l2_ebr_leaf[i]
        nv[i]: l2_ebr_val[i]
        na[i]: l2_ebr_at[i]
        i: i + 1
    if: l2_ebr_name != 0
        l2_xfree((cast: (@: void) l2_ebr_name))
        l2_xfree((cast: (@: void) l2_ebr_leaf))
        l2_xfree((cast: (@: void) l2_ebr_val))
        l2_xfree((cast: (@: void) l2_ebr_at))
    l2_ebr_name: nn
    l2_ebr_leaf: nl
    l2_ebr_val: nv
    l2_ebr_at: na
    l2_ebr_cap: (cast: (int) cap)
return: 0

# Index of the qualified branch named by an atom, or -1. Qualified branches
# are the only NAMED Structures this subset has, so they are the only things
# a merge operand can currently spell.
fn: l2_ebr_find (const: @(LmP0Text t)) int
    int: i 0
    while: i < l2_ebr_n
        if: l2_text_same(l2_ebr_name[i], t) && l2_vis_ok(l2_ebr_at[i])
            return: i
        i: i + 1
    ---
return: 0 - 1

# independent: const: immutable: (): E   with one size_t child, SPEC 9.1.1/9.1.3.
#
# The three receivers are right-nested ordinary receivers and all are required:
# independent alone builds a zero-rooted Structure with no retention, and const:
# immutable alone freezes a value without making it eternal, so neither grants
# the eternal sharing contract (SPEC 7237). independent qualifies STRUCTURE
# CONSTRUCTION, never a bare primitive, which is why the leaf must be "()".
#
# E gets two references, per SPEC 9.1.4: an ordinary declaration-site child of
# the unit graph, and an entry in the root retention array. Neither reparents
# it; E\parent stays 0.
# An ordinary named Structure -- a root definition, a qualified branch's root, a nested one -- is visible from its
# place on (l2_vis_ok), as any ordinary declaration; only the callables fn, fm and sub create are visible both ways
# (docs/LMX_semantics.en.md#declaration-visibility; the author, 2026-10-07).  A program part's code sees none.  The
# lookup by payload and a branch's read the same place.
# Query provenance is the original source node, not a same-name binding.
# Stored contract words retain their declaration's source even when a later
# consumer asks about them. Synthetic spellings use the explicit current
# compiler source environment. No information is added to the runtime graph.
fn: l2_ns_source_site (const: @(LmP0Text t)) const: @: LmP0Node
    @: LmP0Node site l2_node_of_text(l2_ruse_unit, t)
    const: @: LmP0Node root
    @: L2HeadExpression expression l2_head_expressions
    int: i 0
    while: site = 0 && l2_part_doc != 0 && i < l2_part_n
        root: lm_p0_document_root(l2_part_doc[i])
        if: root != 0 && root\kind = c.LM_P0_NODE_STRUCTURE && root\as != 0
            site: l2_node_of_text(root\as\structure, t)
        i: i + 1
    ---
    while: site = 0 && expression != 0
        site: l2_node_of_text(expression\body, t)
        expression: expression\allocated_next
    ---
    if: site = 0
        site: l2_here_node
    return: l2_head_source_node(site)

# A namespace record is eligible only in its actual lexical owner. Global
# source visibility remains the existing boundary; nested declarations use
# the source query's owner and horizon, not a unit header's unrelated offset.
fn: l2_ns_source_rank (int: ni; const: @(LmP0Node site)) int
    int: parent
    int: depth 0
    if: ni < 0 || ni >= l2_ns_n || l2_ns_local[ni] >= 0 || l2_vis_on = 2
        return: -1
    parent: l2_ns_parent[ni]
    if: parent < 0
        if: l2_vis_ok(l2_ns_at[ni]) = 0
            return: -1
        ---
    else:
        if: site = 0 || l2_node_in(l2_head_source_node(l2_ns_at[parent]), site) = 0
            return: -1
        ---
    ---
    # Offsets compare only within one original source tree. The unchanged
    # part visibility boundary decides cross-file eligibility, not byte order.
    if: site != 0 && site\span != 0 && l2_ns_at[ni] != 0 && l2_ns_at[ni]\span != 0 && (parent >= 0 || (l2_struct_has(l2_ruse_unit, site) != 0 && l2_struct_has(l2_ruse_unit, l2_ns_at[ni]) != 0)) && l2_ns_at[ni]\span\offset > site\span\offset
        return: -1
    while: parent >= 0 && parent < l2_ns_n
        depth: depth + 1
        parent: l2_ns_parent[parent]
    ---
return: depth

fn: l2_ns_find (const: @(LmP0Text t)) int
    int: i 0
    int: rank
    int: selected -1
    int: selected_rank -1
    int: site_ready 0
    const: @: LmP0Node site 0
    while: i < l2_ns_n
        if: l2_text_same(l2_ns_name[i], t) != 0
            if: site_ready = 0
                site: l2_ns_source_site(t)
                site_ready: 1
            ---
            rank: l2_ns_source_rank(i, site)
            if: rank > selected_rank
                selected: i
                selected_rank: rank
            ---
        ---
        i: i + 1
    ---
return: selected

# Type positions resolve the same visible declaration as values. Only an
# actually constructed local Structure supplies its model here; a reference
# variable's receiving contract is not a declaration of a new model.
fn: l2_type_model (const: @(LmP0Text word)) int
    int: own
    int: excluded l2_own_excl
    if: l2_here_mi >= 0
        # A declaration's receiving type is read before that declaration binds,
        # just like its candidate. Preserve an enclosing initializer exclusion.
        own: l2_own_find_decl(l2_here_mi, word, l2_here_node)
        if: own >= 0
            l2_own_excl: own
        own: l2_resolved_own(l2_here_mi, word)
        l2_own_excl: excluded
        if: own >= 0 && l2_own_mi[own] = l2_here_mi
            return: l2_own_layout(own)
        if: l2_param_find(l2_here_mi, word) >= 0
            return: -1
    ---
return: l2_ns_find(word)

fn: l2_payload_eq (const: @(LmP0Text atom); const: @(char s)) int
    const: @(char data)
    size_t: n
    size_t: sl
    if: atom = 0 || atom\data = 0 || s = 0
        return: 0
    data: atom\data
    n: atom\length
    if: n >= 2U && data[0] = 96 && data[n - 1U] = 96
        data: data + 1U
        n: n - 2U
    sl: strlen(s)
    if: n != sl
        return: 0
return: memcmp(data, s, n) = 0

fn: l2_ns_find_payload (const: @(LmP0Text t)) int
    const: @(char data)
    size_t: n
    int: i 0
    int: rank
    int: selected -1
    int: selected_rank -1
    int: site_ready 0
    const: @: LmP0Node site 0
    if: t = 0 || t\data = 0
        return: 0 - 1
    data: t\data
    n: t\length
    if: n >= 2U && data[0] = 96 && data[n - 1U] = 96
        data: data + 1U
        n: n - 2U
    while: i < l2_ns_n
        if: l2_ns_name[i] != 0 && l2_ns_name[i]\data != 0 && l2_ns_name[i]\length = n && memcmp(l2_ns_name[i]\data, data, n) = 0
            if: site_ready = 0
                site: l2_ns_source_site(t)
                site_ready: 1
            ---
            rank: l2_ns_source_rank(i, site)
            if: rank > selected_rank
                selected: i
                selected_rank: rank
            ---
        ---
        i: i + 1
    ---
return: selected

fn: l2_ns_field_ix (int: ni; const: @(char name)) int
    if: ni < 0 || name = 0
        return: 0 - 1
return: l2_ns_named_row(ni, name, 0U, strlen(name), 0, 0)

fn: l2_ns_has_field (int: ni; const: @(char name)) int
    if: ni < 0 || name = 0
        return: 0
return: l2_ns_named_row(ni, name, 0U, strlen(name), 0, 0) >= 0

# First-level field names, prior lm_trans_descriptor_implements: every consumer
# field that is also on required must be present on candidate. Empty required
# or empty consumer is true.
fn: l2_descriptor_implements (int: cand; int: req; int: cons; @: int out_result) int
    int: k 0
    int: req_n 0
    int: cons_n 0
    @: char fname
    []: char buf_own 128
    @: char buf 0
    if: out_result != 0
        \out_result: 0
    if: cand = -1 || req < 0 || cons < 0 || out_result = 0
        return: 1
    while: k < l2_nsf_n
        if: l2_nsf_owner[k] = req
            req_n: req_n + 1
        if: l2_nsf_owner[k] = cons
            cons_n: cons_n + 1
        k: k + 1
    if: req_n = 0 || cons_n = 0
        \out_result: 1
        return: 0
    k: 0
    while: k < l2_nsf_n
        if: l2_nsf_owner[k] = cons && l2_nsf_fname[k] != 0 && l2_nsf_fname[k]\data != 0 && l2_nsf_fname[k]\length > 0U
            # A field's name of any length is compared (l2_text_room); a name of 128 bytes or more used to be
            # passed over.
            buf: l2_text_room(l2_nsf_fname[k]\length + 1U, buf_own, 128U)
            if: buf = 0
                return: 1
            memcpy(buf, l2_nsf_fname[k]\data, l2_nsf_fname[k]\length)
            buf[l2_nsf_fname[k]\length]: 0
            fname: buf
            if: l2_ns_has_field(req, fname) != 0
                if: l2_schema_named_meta(cand, l2_nsf_fname[k], -1, 0) < 0
                    \out_result: 0
                    return: 0
                ---
            ---
        ---
        k: k + 1
    ---
    \out_result: 1
return: 0

# Hosted primitive.description rows from lingvamyxa_prev/lm2/primitive.lm2.
# cell=0 and convert=forbidden are void/None; every other listed name has a cell
# and a non-forbidden convert (keyed).
# A primitive by the table (§GATE settings, slice 2; Q41): the row of primitive.description whose `class`
# is this name (a quoted spelling the same name) -- 1, its cell (the `cell` column is 1) and whether a
# conversion to or from it is forbidden (the `convert` column is `forbidden`); 0 when no row names it.  A
# cell this row needs that gives no name is said at the cell -- evaluating a table argument by its
# column's type is slice 3 -- and the decision is malformed (l2_pr_said): the site that asked refuses
# without a line of its own.
fn: l2_prim_kind (const: @(LmP0Text name); @: int out_cell; @: int out_forbid) int
    int: r
    int: at
    int: k
    @: char ce
    @: char cv
    if: out_cell != 0
        \out_cell: 0
    if: out_forbid != 0
        \out_forbid: 0
    if: name = 0 || l2_prim_load() != 0
        return: 0
    r: l2_prim_row(name, 0)
    if: r < 0
        return: 0
    at: l2_tb_cell0[l2_pr_t] + r * l2_tb_ncol[l2_pr_t]
    ce: l2_tbx_name[at + l2_pr_c[1]]
    cv: l2_tbx_name[at + l2_pr_c[2]]
    if: ce = 0 || cv = 0
        k: at + l2_pr_c[2]
        if: ce = 0
            k: at + l2_pr_c[1]
        # Said at its cause, one mechanism (l2_table_said): the site that asked adds nothing.
        l2_table_said(l2_tb_path[l2_pr_t], l2_tbx_arg[k], "a primitive table cell this row needs is not a name (evaluating a table argument is not ported yet)")
        return: 0
    if: out_cell != 0 && c.strcmp(ce, "1") = 0
        \out_cell: 1
    if: out_forbid != 0 && c.strcmp(cv, "forbidden") = 0
        \out_forbid: 1
return: 1

# Prior lm_trans_primitive_leaf_implements: 0 = decided, 1 = malformed, 2 = not
# a primitive pair (fall through to structural descriptors).
fn: l2_primitive_leaf_implements (const: @(LmP0Text cand); const: @(LmP0Text req); @: int out_result) int
    int: c_cell 0
    int: r_cell 0
    int: c_forb 0
    int: r_forb 0
    int: c_ok
    int: r_ok
    const: @(char cd)
    const: @(char rd)
    size_t: cn
    size_t: rn
    if: out_result != 0
        \out_result: 0
    if: cand = 0 || req = 0 || cand\data = 0 || req\data = 0 || out_result = 0
        return: 1
    cd: cand\data
    cn: cand\length
    rd: req\data
    rn: req\length
    if: cn >= 2U && cd[0] = 96 && cd[cn - 1U] = 96
        cd: cd + 1U
        cn: cn - 2U
    if: rn >= 2U && rd[0] = 96 && rd[rn - 1U] = 96
        rd: rd + 1U
        rn: rn - 2U
    if: l2_payload_eq(cand, "void") != 0 || l2_payload_eq(req, "void") != 0 || l2_payload_eq(cand, "None") != 0 || l2_payload_eq(req, "None") != 0
        \out_result: 0
        return: 0
    c_ok: l2_prim_kind(cand, @ c_cell, @ c_forb)
    r_ok: l2_prim_kind(req, @ r_cell, @ r_forb)
    # A cell of the primitive table the decision needed was said at its cause: the decision is malformed,
    # not "not a primitive pair" -- which would fall through to the translator's own numeric codes.
    if: l2_pr_said != 0
        return: 1
    if: c_ok != 0 && cn = rn && memcmp(cd, rd, cn) = 0
        \out_result: 1
        return: 0
    if: c_ok = 0 || r_ok = 0
        return: 2
    if: c_cell = 0 || r_cell = 0
        \out_result: 0
        return: 0
    if: c_forb != 0 || r_forb != 0
        \out_result: 0
        return: 0
    \out_result: 1
return: 0

fn: l2_implements (const: @(LmP0Text cand); const: @(LmP0Text req); const: @(LmP0Text cons); @: int out_result) int
    int: cni
    int: rni
    int: sni
    int: status
    int: dummy_cell 0
    int: dummy_forb 0
    int: k 0
    int: req_n 0
    if: out_result != 0
        \out_result: 0
    if: cand = 0 || req = 0 || cons = 0 || out_result = 0
        return: 1
    sni: l2_ns_find_payload(cons)
    if: sni < 0
        return: 2
    status: l2_primitive_leaf_implements(cand, req, out_result)
    if: status = 1
        return: 1
    if: status = 0
        return: 0
    cni: l2_ns_find_payload(cand)
    rni: l2_ns_find_payload(req)
    if: cni < 0 && l2_prim_kind(cand, @ dummy_cell, @ dummy_forb) != 0 && rni >= 0
        while: k < l2_nsf_n
            if: l2_nsf_owner[k] = rni
                req_n: req_n + 1
            k: k + 1
        if: req_n = 0
            \out_result: 1
            return: 0
        \out_result: 0
        return: 0
    if: rni < 0 && l2_prim_kind(req, @ dummy_cell, @ dummy_forb) != 0 && cni >= 0
        \out_result: 0
        return: 0
    if: cni < 0
        return: 3
    if: rni < 0
        return: 4
return: l2_descriptor_implements(cni, rni, sni, out_result)

fn: l2_implements_arg_atom (const: @(LmP0Node node); @: LmP0Text out) int
    if: node = 0 || out = 0 || node\kind != c.LM_P0_NODE_ATOM || node\as = 0 || node\as\atom = 0
        return: 0
    out\data: node\as\atom\data
    out\length: node\as\atom\length
return: 1

fn: l2_check_implements (const: @(LmP0Node node); const: @(char path)) int
    const: @: LmP0Frame call
    @: LmP0Field a0
    @: LmP0Field a1
    @: LmP0Field a2
    @: LmP0Field a3
    @: LmP0Text cand 0
    @: LmP0Text req 0
    @: LmP0Text cons 0
    int: result 0
    int: status
    if: node = 0 || node\as = 0 || node\as\frame = 0
        return: l2_error(path, node, "implements expects candidate, required, consumer")
    call: node\as\frame
    if: call\body = 0 || call\trailer != 0 || call\body\trailer != 0 || l2_count_active(call\body) != 3
        return: l2_error(path, node, "implements expects candidate, required, consumer")
    a0: l2_next_active(call\body\first_field)
    a1: l2_next_active(a0\next)
    a2: l2_next_active(a1\next)
    a3: l2_next_active(a2\next)
    cand: (cast: (@: LmP0Text) l2_xmalloc(c.sizeof(c.LmP0Text)))
    req: (cast: (@: LmP0Text) l2_xmalloc(c.sizeof(c.LmP0Text)))
    cons: (cast: (@: LmP0Text) l2_xmalloc(c.sizeof(c.LmP0Text)))
    if: cand = 0 || req = 0 || cons = 0
        if: cand != 0
            l2_xfree((cast: (@: void) cand))
        if: req != 0
            l2_xfree((cast: (@: void) req))
        if: cons != 0
            l2_xfree((cast: (@: void) cons))
        return: l2_error(path, node, "out of memory")
    status: 1
    if: a3 != 0 || l2_implements_arg_atom(a0\value, cand) = 0 || l2_implements_arg_atom(a1\value, req) = 0 || l2_implements_arg_atom(a2\value, cons) = 0
        l2_xfree((cast: (@: void) cand))
        l2_xfree((cast: (@: void) req))
        l2_xfree((cast: (@: void) cons))
        return: l2_error(path, node, "implements expects descriptor names")
    status: l2_implements(cand, req, cons, @ result)
    l2_xfree((cast: (@: void) cand))
    l2_xfree((cast: (@: void) req))
    l2_xfree((cast: (@: void) cons))
    if: status = 2
        return: l2_error(path, a2\value, "unknown consumer descriptor")
    if: status = 3
        return: l2_error(path, a0\value, "unknown candidate descriptor")
    if: status = 4
        return: l2_error(path, a1\value, "unknown required descriptor")
    if: status != 0 && l2_pr_said != 0
        return: 1
    if: status != 0
        return: l2_error(path, node, "malformed implements descriptor")
return: 0

fn: l2_prep_implements (const: @(LmP0Node node); @: L2Tx dest) int
    const: @: LmP0Frame call
    @: LmP0Field a0
    @: LmP0Field a1
    @: LmP0Field a2
    @: LmP0Text cand 0
    @: LmP0Text req 0
    @: LmP0Text cons 0
    int: result 0
    int: status
    if: dest = 0 || node = 0 || node\as = 0 || node\as\frame = 0 || node\as\frame\body = 0
        return: 1
    call: node\as\frame
    a0: l2_next_active(call\body\first_field)
    a1: l2_next_active(a0\next)
    a2: l2_next_active(a1\next)
    cand: (cast: (@: LmP0Text) l2_xmalloc(c.sizeof(c.LmP0Text)))
    req: (cast: (@: LmP0Text) l2_xmalloc(c.sizeof(c.LmP0Text)))
    cons: (cast: (@: LmP0Text) l2_xmalloc(c.sizeof(c.LmP0Text)))
    if: cand = 0 || req = 0 || cons = 0
        if: cand != 0
            l2_xfree((cast: (@: void) cand))
        if: req != 0
            l2_xfree((cast: (@: void) req))
        if: cons != 0
            l2_xfree((cast: (@: void) cons))
        return: 1
    if: l2_implements_arg_atom(a0\value, cand) = 0 || l2_implements_arg_atom(a1\value, req) = 0 || l2_implements_arg_atom(a2\value, cons) = 0
        l2_xfree((cast: (@: void) cand))
        l2_xfree((cast: (@: void) req))
        l2_xfree((cast: (@: void) cons))
        return: 1
    status: l2_implements(cand, req, cons, @ result)
    l2_xfree((cast: (@: void) cand))
    l2_xfree((cast: (@: void) req))
    l2_xfree((cast: (@: void) cons))
    if: status != 0
        return: 1
    if: result != 0
        return: l2_tx_set(dest, "1")
return: l2_tx_set(dest, "0")

fn: l2_nsty_set (int: mi; int: k; int: ni) int
    int: cap
    @: int nmi 0
    @: int nk 0
    @: int nni 0
    if: ni < 0
        return: 0
    if: l2_nsty_n >= l2_nsty_cap
        cap: l2_nsty_cap
        if: cap < 1
            cap: 8
        while: cap <= l2_nsty_n
            if: cap > c.INT_MAX / 2
                cap: l2_nsty_n + 1
            else:
                cap: cap * 2
            ---
        nmi: (cast: (@: int) malloc((cast: (size_t) cap) * c.sizeof(c.int)))
        nk: (cast: (@: int) malloc((cast: (size_t) cap) * c.sizeof(c.int)))
        nni: (cast: (@: int) malloc((cast: (size_t) cap) * c.sizeof(c.int)))
        if: nmi = 0 || nk = 0 || nni = 0
            if: nmi != 0
                free((cast: (@: void) nmi))
            if: nk != 0
                free((cast: (@: void) nk))
            if: nni != 0
                free((cast: (@: void) nni))
            return: 1
        if: l2_nsty_n > 0
            memcpy((cast: (@: void) nmi), (cast: (@: void) l2_nsty_mi), (cast: (size_t) l2_nsty_n) * c.sizeof(c.int))
            memcpy((cast: (@: void) nk), (cast: (@: void) l2_nsty_k), (cast: (size_t) l2_nsty_n) * c.sizeof(c.int))
            memcpy((cast: (@: void) nni), (cast: (@: void) l2_nsty_ni), (cast: (size_t) l2_nsty_n) * c.sizeof(c.int))
        if: l2_nsty_mi != 0
            free((cast: (@: void) l2_nsty_mi))
        if: l2_nsty_k != 0
            free((cast: (@: void) l2_nsty_k))
        if: l2_nsty_ni != 0
            free((cast: (@: void) l2_nsty_ni))
        l2_nsty_mi: nmi
        l2_nsty_k: nk
        l2_nsty_ni: nni
        l2_nsty_cap: cap
    l2_nsty_mi[l2_nsty_n]: mi
    l2_nsty_k[l2_nsty_n]: k
    l2_nsty_ni[l2_nsty_n]: ni
    l2_nsty_n: l2_nsty_n + 1
return: 0

fn: l2_nsty_get (int: mi; int: k) int
    int: i 0
    while: i < l2_nsty_n
        if: l2_nsty_mi[i] = mi && l2_nsty_k[i] = k
            return: l2_nsty_ni[i]
        i: i + 1
    ---
return: 0 - 1

fn: l2_nsty_of_name (int: mi; const: @(LmP0Text name)) int
    int: fi
    int: ni
    if: name = 0
        return: 0 - 1
    fi: l2_formal_find(mi, name)
    if: fi >= 0
        ni: l2_nsty_get(mi, fi)
        if: ni >= 0
            return: ni
        ---
    ---
return: l2_ns_find_payload(name)

# An own field's namespace/type index, keyed into the same (mi, k) table
# l2_nsty_set/get already hold formal/return namespace types in -- FABLE-
# SONNET-FIELD-PATHS-20260923-113. Formal slot keys are >= 0 and -1 is the
# return value, so k = -2 - oi can never collide with either: one table, no
# second index or parallel array (next_core_tasks.md 4).
fn: l2_own_nsty_set (int: oi; int: ni) int
    if: oi < 0 || ni < 0
        return: 0
return: l2_nsty_set(l2_own_mi[oi], 0 - 2 - oi, ni)

fn: l2_own_nsty_get (int: oi) int
    if: oi < 0
        return: 0 - 1
return: l2_nsty_get(l2_own_mi[oi], 0 - 2 - oi)

fn: l2_fn_frame (int: mi) @: LmP0Frame
    if: l2_m_node != 0 && l2_m_node[mi] != 0 && l2_m_node[mi]\as != 0
        return: l2_m_node[mi]\as\frame
return: 0

# The original callable declaration, not its compiler procedure-body adapter.
# A namespace procedure has no fn node; its source is the same named Structure
# used by construction. The unit execution row has no enclosing source Frame.
fn: l2_callable_source_node (int: mi) @: LmP0Node
    int: ni
    if: l2_m_node[mi] != 0
        return: l2_m_node[mi]
    ni: l2_m_nsof(mi)
    if: ni >= 0
        return: l2_ns_at[ni]
return: 0

# Invert the existing original source identity, without another registry.
# Synthetic namespace adapters are not original defining Frames. Anonymous
# control bodies remain part of their host's ordinary method traversal.
fn: l2_source_is_callable_definition (const: @(LmP0Node node)) int
    int: mi 0
    int: ni
    if: node = 0
        return: 0
    while: mi < l2_m_n
        if: l2_m_node[mi] = node
            return: 1
        ni: l2_m_nsof(mi)
        if: ni >= 0 && l2_ns_original_body(ni) != 0 && l2_ns_at[ni] = node
            return: 1
        mi: mi + 1
return: 0

fn: l2_callable_source_frame (int: mi) @: LmP0Frame
    @: LmP0Node node l2_callable_source_node(mi)
    if: node != 0
        return: node\as\frame
return: 0

fn: l2_uses_is_slash (const: @(LmP0Text text)) int
return: text != 0 && text\length = 1U && text\data != 0 && text\data[0] = 92

fn: l2_uses_slash_off (const: @(char data); size_t: length) size_t
    size_t: i 0U
    while: i < length
        if: data[i] = 92
            return: i
        i: i + 1U
return: length

# Release the list: the buffer is no longer needed.
fn: l2_uses_reset () int
    if: l2_uses_buf != 0
        l2_xfree((cast: (@: void) l2_uses_buf))
    ---
    l2_uses_buf: 0
    l2_uses_cap: 0
    l2_uses_len: 0
    l2_uses_oom: 0
    if: l2_uses_tmp != 0
        l2_xfree((cast: (@: void) l2_uses_tmp))
    ---
    l2_uses_tmp: 0
    l2_uses_tmp_cap: 0U
    l2_uses_tmp_n: 0U
return: 0

# n more bytes of the path being joined.  No memory: l2_uses_oom, which every walk of uses is asked for.
sub: l2_uses_tmp_put (const: @(char data); size_t: n)
    size_t: want
    @: char grown
    if: data = 0 || n = 0U || l2_uses_oom != 0
        return
    if: n > (cast: (size_t) -1) - l2_uses_tmp_n
        l2_uses_oom: 1
        return
    if: l2_uses_tmp_n + n > l2_uses_tmp_cap
        want: l2_uses_tmp_cap
        if: want < 256U
            want: 256U
        while: want < l2_uses_tmp_n + n
            if: want > (cast: (size_t) -1) / 2U
                l2_uses_oom: 1
                return
            want: want * 2U
        ---
        l2_alloc_kind: 5
        grown: (cast: (@: char) l2_xmalloc(want))
        if: grown = 0
            l2_uses_oom: 1
            return
        if: l2_uses_tmp_n > 0U && l2_uses_tmp != 0
            memcpy(grown, l2_uses_tmp, l2_uses_tmp_n)
        if: l2_uses_tmp != 0
            l2_xfree((cast: (@: void) l2_uses_tmp))
        ---
        l2_uses_tmp: grown
        l2_uses_tmp_cap: want
    ---
    memcpy(l2_uses_tmp + l2_uses_tmp_n, data, n)
    l2_uses_tmp_n: l2_uses_tmp_n + n
end: l2_uses_tmp_put

# Room for `extra` more bytes: the buffer doubles, never a fixed ceiling.
fn: l2_uses_ensure (size_t: extra) int
    int: want
    @: char grown
    if: (cast: (size_t) l2_uses_len) + extra <= (cast: (size_t) l2_uses_cap)
        return: 0
    want: l2_uses_cap * 2
    if: want < 1024
        want: 1024
    ---
    while: (cast: (size_t) want) < (cast: (size_t) l2_uses_len) + extra
        want: want * 2
    ---
    grown: (cast: (@: char) l2_xmalloc((cast: (size_t) want)))
    if: grown = 0
        return: 1
    if: l2_uses_len > 0 && l2_uses_buf != 0
        memcpy(grown, l2_uses_buf, (cast: (size_t) l2_uses_len))
    ---
    if: l2_uses_buf != 0
        l2_xfree((cast: (@: void) l2_uses_buf))
    ---
    l2_uses_buf: grown
    l2_uses_cap: want
return: 0

sub: l2_uses_path_add (const: @(char path); size_t: length)
    @: char slot
    size_t: off 0U
    size_t: n
    if: path = 0 || length = 0U
        return
    while: off < (cast: (size_t) l2_uses_len)
        slot: l2_uses_buf + off
        n: strlen(slot)
        if: n = length && memcmp(slot, path, n) = 0
            return
        off: off + n + 1U
    ---
    if: l2_uses_ensure(length + 1U) != 0
        l2_uses_oom: 1
        return
    ---
    memcpy(l2_uses_buf + (cast: (size_t) l2_uses_len), path, length)
    l2_uses_buf[(cast: (size_t) l2_uses_len) + length]: 0
    l2_uses_len: (cast: (int) ((cast: (size_t) l2_uses_len) + length + 1U))
end: l2_uses_path_add

fn: l2_uses_name_eq (const: @(LmP0Text name); const: @(LmP0Text varb)) int
    const: @(char ad)
    const: @(char bd)
    size_t: an
    size_t: bn
    if: name = 0 || varb = 0 || name\data = 0 || varb\data = 0
        return: 0
    ad: name\data
    an: name\length
    bd: varb\data
    bn: varb\length
    if: an >= 2U && ad[0] = 96 && ad[an - 1U] = 96
        ad: ad + 1U
        an: an - 2U
    if: bn >= 2U && bd[0] = 96 && bd[bn - 1U] = 96
        bd: bd + 1U
        bn: bn - 2U
    if: an != bn
        return: 0
return: memcmp(ad, bd, an) = 0

fn: l2_uses_scan_follow (const: @(LmP0Text varb); @: LmP0Field start) @: LmP0Field
    @: LmP0Field field
    @: LmP0Text name
    int: tracked
    int: closed
    int: digits
    if: start = 0 || start\value = 0 || start\value\kind != c.LM_P0_NODE_ATOM
        return: start
    name: start\value\as\atom
    tracked: l2_uses_name_eq(name, varb)
    field: start\next
    if: field = 0 || field\value = 0 || field\value\kind != c.LM_P0_NODE_ATOM || l2_uses_is_slash(field\value\as\atom) = 0
        return: start
    # The steps are joined at their own length: a step is as long as its name is.
    l2_uses_tmp_n: 0U
    while: field != 0 && field\value != 0 && field\value\kind = c.LM_P0_NODE_ATOM && l2_uses_is_slash(field\value\as\atom) != 0
        field: field\next
        if: field = 0 || field\value = 0 || field\value\kind != c.LM_P0_NODE_ATOM || field\value\as\atom = 0
            return: start
        name: field\value\as\atom
        if: tracked != 0 && name\length > 0U
            if: l2_uses_tmp_n != 0U
                l2_uses_tmp_put("\\", 1U)
            # `[N]name` arrives as separate atoms; one segment `[N]name` is what
            # the used-edge check parses (the occurrence selector is part of it).
            if: name\length = 1U && name\data[0] = 91
                closed: 0
                l2_uses_tmp_put("[", 1U)
                digits: 0
                field: field\next
                while: field != 0 && field\value != 0 && field\value\kind = c.LM_P0_NODE_ATOM && field\value\as\atom != 0 && closed = 0
                    name: field\value\as\atom
                    l2_uses_tmp_put(name\data, name\length)
                    if: name\length = 1U && name\data[0] = 93
                        closed: 1
                    ---
                    digits: digits + 1
                    field: field\next
                ---
                if: closed = 0 || field = 0 || field\value = 0 || field\value\kind != c.LM_P0_NODE_ATOM || field\value\as\atom = 0 || digits < 2
                    return: start
                ---
                name: field\value\as\atom
                l2_uses_tmp_put(name\data, name\length)
            else:
                l2_uses_tmp_put(name\data, name\length)
            ---
        ---
        field: field\next
    if: tracked != 0 && l2_uses_tmp_n > 0U && l2_uses_oom = 0
        l2_uses_path_add(l2_uses_tmp, l2_uses_tmp_n)
return: field

fn: l2_uses_walk_frame (const: @(LmP0Text varb); const: @(LmP0Frame frame)) int
    @: LmP0Text head 0
    size_t: slash
    size_t: rest
    if: varb = 0 || frame = 0
        return: 0
    if: frame\head != 0 && frame\head\data != 0 && frame\head\length > 0U
        slash: l2_uses_slash_off(frame\head\data, frame\head\length)
        if: slash < frame\head\length
            if: slash > 0U
                head: (cast: (@: LmP0Text) l2_xmalloc(c.sizeof(c.LmP0Text)))
                if: head != 0
                    head\data: frame\head\data
                    head\length: slash
                    if: l2_uses_name_eq(head, varb) != 0 && slash + 1U < frame\head\length
                        rest: frame\head\length - slash - 1U
                        l2_uses_path_add(frame\head\data + slash + 1U, rest)
                    ---
                    l2_xfree((cast: (@: void) head))
                ---
            ---
            return: l2_uses_walk_body(varb, frame)
        ---
    ---
return: l2_uses_walk_body(varb, frame)

# D-109: the uses of a consumer are its body's and its hung `return:`'s -- P0 makes a `return:` after the
# body the frame's trailer, and a read there (`return: m\a`) is a use like any other.  The walk read the
# body alone, and a formal admitted by the consumer's uses could lack a field its return reads.
fn: l2_uses_walk_body (const: @(LmP0Text varb); const: @(LmP0Frame frame)) int
    if: l2_uses_walk_structure(varb, frame\body) != 0
        return: 1
    if: frame\trailer != 0 && frame\trailer\body != 0
        return: l2_uses_walk_structure(varb, frame\trailer\body)
return: 0

fn: l2_uses_walk_structure (const: @(LmP0Text varb); const: @(LmP0Structure body)) int
    @: LmP0Field field
    @: LmP0Field next
    if: varb = 0 || body = 0
        return: 0
    field: l2_call_actuals(body)
    while: field != 0
        next: l2_uses_scan_follow(varb, field)
        if: next != field
            field: next
        else:
            if: l2_uses_walk_node(varb, field\value) != 0
                return: 1
            field: field\next
        ---
return: 0

fn: l2_uses_walk_node (const: @(LmP0Text varb); const: @(LmP0Node node)) int
    if: varb = 0 || node = 0
        return: 0
    if: node\kind = c.LM_P0_NODE_STRUCTURE && node\as != 0
        return: l2_uses_walk_structure(varb, node\as\structure)
    if: node\kind = c.LM_P0_NODE_FRAME && node\as != 0
        return: l2_uses_walk_frame(varb, node\as\frame)
return: 0

# Whether method m has code whose uses of a name can be read: a method's frame, or a named Structure's procedure
# body, which has no method node (l2_ns_proc).
fn: l2_m_consumer (int: m) int
    if: m < 0 || m >= l2_m_n
        return: 0
    if: l2_m_node[m] != 0 && l2_m_node[m]\as != 0 && l2_m_node[m]\as\frame != 0
        return: 1
return: (cast: (int) (l2_m_node[m] = 0 && l2_m_body[m] != 0 && l2_m_nsof(m) >= 0))

# The uses of name nm in the code of method m (l2_m_consumer): the method's frame -- its body and its hung `return:`
# -- or the named Structure's procedure body.
fn: l2_uses_walk_method (const: @(LmP0Text nm); int: m) int
    if: m < 0 || m >= l2_m_n
        return: 0
    if: l2_m_node[m] != 0 && l2_m_node[m]\as != 0 && l2_m_node[m]\as\frame != 0
        return: l2_uses_walk_frame(nm, l2_m_node[m]\as\frame)
    if: l2_m_consumer(m) != 0
        return: l2_uses_walk_node(nm, l2_m_body[m])
return: 0

# Used-path Consumer: every segment of a path that required declares is
# required on the candidate. A Structure field (kind 2 or 3) descends into that
# pair. The last segment is a leaf: its kind must match. A name required
# does not declare at that level is not part of this Consumer.
fn: l2_descriptor_used (int: cand; int: req; @: int out_result) int
    size_t: off 0U
    @: char slot
    size_t: n
    size_t: at
    size_t: cut
    int: ci
    int: ri
    int: ck
    int: rk
    int: more
    int: occurrence
    size_t: name_at
    LmP0Text: name
    L2SchemaField: actual
    L2SchemaField: needed
    if: out_result != 0
        \out_result: 0
    if: cand = -1 || req = -1 || out_result = 0
        return: 1
    if: l2_uses_len = 0
        \out_result: 1
        return: 0
    if: l2_uses_buf = 0
        return: 1
    while: off < (cast: (size_t) l2_uses_len)
        slot: l2_uses_buf + off
        n: strlen(slot)
        ci: cand
        ri: req
        at: 0U
        while: at < n && ci != -1 && ri != -1
            cut: at
            while: cut < n && slot[cut] != 92
                cut: cut + 1U
            if: cut = at
                \out_result: 0
                return: 0
            more: 0
            if: cut < n
                more: 1
            occurrence: -1
            name_at: 0U
            if: slot[at] = 91
                occurrence: 0
                name_at: 1U
                while: name_at < cut - at && slot[at + name_at] >= 48 && slot[at + name_at] <= 57
                    occurrence: occurrence * 10 + (cast: (int) (slot[at + name_at] - 48))
                    name_at: name_at + 1U
                if: name_at >= cut - at || slot[at + name_at] != 93
                    return: 1
                name_at: name_at + 1U
            name.data: slot + at + name_at
            name.length: cut - at - name_at
            rk: l2_schema_named_meta(ri, @ name, occurrence, @ needed)
            if: rk < 0
                at: n
            else:
                ck: l2_schema_named_meta(ci, @ name, occurrence, @ actual)
                if: ck < 0
                    \out_result: 0
                    return: 0
                if: more != 0 && (needed.kind = 2 || needed.kind = 3) && needed.model >= 0
                    if: actual.kind != needed.kind || actual.model < 0
                        \out_result: 0
                        return: 0
                    ri: needed.model
                    ci: actual.model
                    at: cut + 1U
                else:
                    if: more = 0 && actual.kind != needed.kind
                        \out_result: 0
                        return: 0
                    at: n
                ---
            ---
        ---
        off: off + n + 1U
    ---
    \out_result: 1
return: 0

fn: l2_admit_finish (int: cand; int: req; int: status; int: compatible; const: @(LmP0Text cand_name); const: @(char path); const: @(LmP0Node at); const: @(char context)) int
    if: status != 0
        return: l2_error(path, at, "malformed implements descriptor")
    if: cand = req
        return: 0
    if: compatible = 0
        if: context != 0 && strcmp(context, "function argument") = 0
            return: l2_error(path, at, "implements is false in function argument")
        if: context != 0 && strcmp(context, "assignment") = 0
            return: l2_error(path, at, "implements is false in assignment")
        if: context != 0 && strcmp(context, "return value") = 0
            return: l2_error(path, at, "implements is false in return value")
        return: l2_error(path, at, "implements is false")
return: 0

# Q59 (the author, 2026-10-01): "an ordinary named Structure has no arguments, while `A: B`
# remains a general application checked against the resolved A's contract".  An argument supplied
# to a resolved argumentless Structure is therefore the SAME arity refusal the argument matcher
# gives a callable with too few formals -- the resolved value's contract, not an unimplemented
# construct ("not built yet") and not a name-specific ban.
fn: l2_struct_arity_error (const: @(char path); const: @(LmP0Node at); const: @(LmP0Text name)) int
    if: name = 0 || name\data = 0 || name\length = 0U
        return: l2_error(path, at, "more arguments than the resolved Structure has formals")
    ---
return: l2_error_name(path, at, "more arguments than ", name\data, name\length, " has formals")

# No uses walk: the caller supplied a descriptor Consumer.
fn: l2_admit_implements (int: cand; int: req; int: cons; const: @(LmP0Text cand_name); const: @(char path); const: @(LmP0Node at); const: @(char context)) int
    int: compatible 0
    int: status
    if: cand = -1 || req < 0 || cons < 0
        return: 0
    status: l2_descriptor_implements(cand, req, cons, @ compatible)
return: l2_admit_finish(cand, req, status, compatible, cand_name, path, at, context)

# The Consumer is the path list from l2_uses_walk_frame. Zero paths succeed
# inside l2_descriptor_used. A nonempty list checks those names. req is the
# required type, not the Consumer.
fn: l2_admit_paths (int: cand; int: req; const: @(LmP0Text cand_name); const: @(char path); const: @(LmP0Node at); const: @(char context)) int
    int: compatible 0
    int: status
    if: cand = -1 || req = -1
        return: 0
    status: l2_descriptor_used(cand, req, @ compatible)
return: l2_admit_finish(cand, req, status, compatible, cand_name, path, at, context)

fn: l2_admit_consumer_ix (int: cand; int: req; const: @(LmP0Text varb); const: @(LmP0Frame consumer); const: @(char path); const: @(LmP0Node at); const: @(char context)) int
return: l2_admit_consumer_at(cand, req, varb, consumer, 0, path, at, context)

# The Consumer is a frame -- a callee, a method -- or, where there is no frame node (the walked root, a named
# Structure's procedure), the body the name lives in: the paths varb takes there.  Neither: the declared type's shape.
fn: l2_admit_consumer_at (int: cand; int: req; const: @(LmP0Text varb); const: @(LmP0Frame consumer); const: @(LmP0Structure body); const: @(char path); const: @(LmP0Node at); const: @(char context)) int
    int: status 0
    if: cand = -1 || req = -1
        return: 0
    if: consumer = 0 && body = 0
        return: l2_admit_implements(cand, req, req, 0, path, at, context)
    l2_uses_reset()
    if: consumer != 0 && l2_uses_walk_frame(varb, consumer) != 0
        l2_uses_reset()
        return: 1
    if: consumer = 0 && l2_uses_walk_structure(varb, body) != 0
        l2_uses_reset()
        return: 1
    if: l2_uses_oom != 0
        l2_uses_reset()
        return: l2_error(path, at, "out of memory")
    status: l2_admit_paths(cand, req, 0, path, at, context)
    l2_uses_reset()
return: status

fn: l2_admit_consumer_uses (const: @(LmP0Text cand_name); int: req; const: @(LmP0Text varb); const: @(LmP0Frame consumer); const: @(char path); const: @(LmP0Node at); const: @(char context)) int
    int: cand
    if: cand_name = 0 || req < 0
        return: 0
    cand: l2_ns_find_payload(cand_name)
    if: cand < 0
        return: 0
return: l2_admit_consumer_ix(cand, req, varb, consumer, path, at, context)

# An otherwise unrecognized unit-level frame with a matching end is an ordinary
# named Structure. Reserved heads are matched before this is ever reached, so a
# malformed reserved construct stays an error rather than becoming a
# declaration. Fields are size_t literals in this slice.
# Grow every per-Structure table by one and return the new index, or -1.
fn: l2_ns_push (const: @(LmP0Text name); int: parent; const: @(LmP0Node at)) int
    @@: LmP0Text gn
    @@: LmP0Node ga
    @: int gi
    size_t: want (cast: (size_t) (l2_ns_n + 1))
    gn: (cast: (@@: LmP0Text) realloc((cast: (@: void) l2_ns_name), want * c.sizeof(@: void)))
    if: gn = 0
        return: 0 - 1
    l2_ns_name: gn
    gi: (cast: (@: int) realloc((cast: (@: void) l2_ns_first), want * c.sizeof(c.int)))
    if: gi = 0
        return: 0 - 1
    l2_ns_first: gi
    gi: (cast: (@: int) realloc((cast: (@: void) l2_ns_count), want * c.sizeof(c.int)))
    if: gi = 0
        return: 0 - 1
    l2_ns_count: gi
    gi: (cast: (@: int) realloc((cast: (@: void) l2_ns_parent), want * c.sizeof(c.int)))
    if: gi = 0
        return: 0 - 1
    l2_ns_parent: gi
    gi: (cast: (@: int) realloc((cast: (@: void) l2_ns_eternal), want * c.sizeof(c.int)))
    if: gi = 0
        return: 0 - 1
    l2_ns_eternal: gi
    ga: (cast: (@@: LmP0Node) realloc((cast: (@: void) l2_ns_at), want * c.sizeof(@: void)))
    if: ga = 0
        return: 0 - 1
    l2_ns_at: ga
    gi: (cast: (@: int) realloc((cast: (@: void) l2_ns_exec), want * c.sizeof(c.int)))
    if: gi = 0
        return: 0 - 1
    l2_ns_exec: gi
    gi: (cast: (@: int) realloc((cast: (@: void) l2_ns_proc), want * c.sizeof(c.int)))
    if: gi = 0
        return: 0 - 1
    l2_ns_proc: gi
    ga: (cast: (@@: LmP0Node) realloc((cast: (@: void) l2_ns_stmt), want * c.sizeof(@: void)))
    if: ga = 0
        return: 0 - 1
    l2_ns_stmt: ga
    gi: (cast: (@: int) realloc((cast: (@: void) l2_ns_local), want * c.sizeof(c.int)))
    if: gi = 0
        return: 0 - 1
    l2_ns_local: gi
    l2_ns_exec[l2_ns_n]: 0
    l2_ns_proc[l2_ns_n]: 0 - 1
    l2_ns_stmt[l2_ns_n]: 0
    l2_ns_at[l2_ns_n]: (cast: (@: LmP0Node) at)
    l2_ns_name[l2_ns_n]: (cast: (@: LmP0Text) name)
    l2_ns_first[l2_ns_n]: 0
    l2_ns_count[l2_ns_n]: 0
    l2_ns_parent[l2_ns_n]: parent
    l2_ns_eternal[l2_ns_n]: 0 - 1
    l2_ns_local[l2_ns_n]: 0 - 1
    l2_ns_n: l2_ns_n + 1
return: l2_ns_n - 1

# Grow every per-field table by one and return the new index, or -1.
fn: l2_nsf_push (int: kind; size_t: value; int: ref; int: owner; const: @(LmP0Node source)) int
    @@: LmP0Text gt
    @@: LmP0Node gs
    @: size_t gv
    @: int gi
    size_t: want (cast: (size_t) (l2_nsf_n + 1))
    gv: (cast: (@: size_t) realloc((cast: (@: void) l2_nsf_val), want * c.sizeof(c.size_t)))
    if: gv = 0
        return: 0 - 1
    l2_nsf_val: gv
    gi: (cast: (@: int) realloc((cast: (@: void) l2_nsf_kind), want * c.sizeof(c.int)))
    if: gi = 0
        return: 0 - 1
    l2_nsf_kind: gi
    gi: (cast: (@: int) realloc((cast: (@: void) l2_nsf_ref), want * c.sizeof(c.int)))
    if: gi = 0
        return: 0 - 1
    l2_nsf_ref: gi
    gt: (cast: (@@: LmP0Text) realloc((cast: (@: void) l2_nsf_name), want * c.sizeof(@: void)))
    if: gt = 0
        return: 0 - 1
    l2_nsf_name: gt
    gt: (cast: (@@: LmP0Text) realloc((cast: (@: void) l2_nsf_fname), want * c.sizeof(@: void)))
    if: gt = 0
        return: 0 - 1
    l2_nsf_fname: gt
    l2_nsf_val[l2_nsf_n]: value
    l2_nsf_kind[l2_nsf_n]: kind
    gi: (cast: (@: int) realloc((cast: (@: void) l2_nsf_owner), want * c.sizeof(c.int)))
    if: gi = 0
        return: 0 - 1
    l2_nsf_owner: gi
    gs: (cast: (@@: LmP0Node) realloc((cast: (@: void) l2_nsf_source), want * c.sizeof(@: void)))
    if: gs = 0
        return: -1
    l2_nsf_source: gs
    l2_nsf_ref[l2_nsf_n]: ref
    l2_nsf_name[l2_nsf_n]: 0
    l2_nsf_fname[l2_nsf_n]: 0
    l2_nsf_owner[l2_nsf_n]: owner
    l2_nsf_source[l2_nsf_n]: (cast: (@: LmP0Node) source)
    l2_nsf_n: l2_nsf_n + 1
return: l2_nsf_n - 1

# The value of a char literal written as an apostrophe-quoted single byte.
fn: l2_char_literal (const: @(LmP0Text t)) int
    if: t = 0 || t\data = 0 || t\length != 3U
        return: 0 - 1
    if: t\data[0] != 39 || t\data[2] != 39
        return: 0 - 1
return: (cast: (int) (cast: (unsigned char) t\data[1]))

# ADMISSION OF AN UNTYPED GRAPH (fable's B2 for S3, the author's Q12): a graph
# with no declared Structure type -- the letter receiveMessage takes, an `@: Lmx`
# value -- bound to a declared Structure type, by `receiveMessage:` into a typed
# own field, by rebinding a typed own field, or as the argument of a typed
# formal, is admitted at that binding by the kernel's runtime implements walk.
# The translator's part is the static one: the target's type is a declared
# Structure.  The coarse walk is the interim admission until the
# receiving-expression port (next_core_tasks.md 7).

# The declared Structure type of a graph-valued binding, or -1 when it has none.
fn: l2_graph_nsty (int: mi; const: @(LmP0Text name)) int
    int: i
    if: mi < 0 || name = 0
        return: 0 - 1
    i: l2_resolved_own(mi, name)
    if: i >= 0
        return: l2_own_nsty_get(i)
    i: l2_param_find(mi, name)
    if: i >= 0
        return: l2_input_model(mi, i)
    i: l2_own_visible(mi, name)
    if: i >= 0
        return: l2_own_nsty_get(i)
    i: l2_ml_find(name)
    if: i >= 0
        return: l2_ml_ns[i]
return: 0 - 1

# Is this value one name of an untyped graph: graph-valued, no declared type?
fn: l2_untyped_graph (int: mi; const: @(LmP0Node value)) int
    int: ty 0
    int: own
    if: value = 0 || value\kind != c.LM_P0_NODE_ATOM || value\as = 0 || value\as\atom = 0 || l2_ident(value\as\atom) = 0
        return: 0
    if: l2_colon_bound_ty(mi, value\as\atom, @ ty) != 0 || l2_colon_is_graph_ty(ty) = 0
        return: 0
    own: l2_resolved_own(mi, value\as\atom)
    if: own >= 0 && l2_own_schema(own) != -1
        return: 0
    own: l2_param_find(mi, value\as\atom)
    if: own >= 0 && l2_input_schema(mi, own) != -1
        return: 0
    if: l2_graph_nsty(mi, value\as\atom) >= 0
        return: 0
return: 1

# Project one declared child from its already selected actual parent. The
# source identity chooses the NSF row; only its completed place is emitted.
# Growable text retains arbitrary ancestry without an expression/depth cap.
fn: l2_model_child (int: ni; @: L2Tx dest) int
    int: slot l2_ns_field_in_parent(ni)
    []: char suffix 32
    []: char local 128
    L2Tx: text
    @: L2Tx child l2_tx_local(@ text, local, 128U)
    if: slot < 0 || dest = 0 || child = 0 || c.snprintf(suffix, 32U, ", %uU)", (cast: (unsigned) slot)) < 0
        return: 1
    if: l2_tx_join(child, "lmx_arena_ref_struct(", dest\data, suffix, 0, 0) != 0
        return: 1
return: l2_tx_set(dest, child\data)

# The actual declaration instance in the selected lexical/receiving unit,
# projected through its existing source-owned children, never a new shape.
fn: l2_type_inst (int: ni; @: L2Tx dest) int
    []: char nm 32
    if: ni < 0 || ni >= l2_ns_n || dest = 0 || l2_ns_local[ni] >= 0
        return: 1
    if: l2_ns_parent[ni] >= 0
        if: l2_type_inst(l2_ns_parent[ni], dest) != 0
            return: 1
        return: l2_model_child(ni, dest)
    ---
    if: l2_ns_eternal[ni] < 0 && c.snprintf(nm, 32U, ", %uU)", (cast: (unsigned) (l2_ns_unit_slot(ni)))) < 0
        return: 1
    if: l2_ns_eternal[ni] >= 0 && c.snprintf(nm, 32U, ", %uU)", (cast: (unsigned) (l2_ebr_unit_slot(l2_ns_eternal[ni])))) < 0
        return: 1
    if: l2_recv_unit != 0
        return: l2_tx_join(dest, "lmx_arena_ref_struct(", l2_recv_unit, nm, 0, 0)
return: l2_tx_join(dest, "lmx_arena_ref_struct(", l2_unit_ref, nm, 0, 0)

# A schema token is module metadata, not a model instance or a language value.
# Distinct source schemas have distinct cells even when their field maps agree.
fn: l2_layout_token (int: ni; @: char dest) int
    int: slot l2_schema_token_slot(ni)
    if: slot < 0 || slot >= l2_ns_n + l2_mres_n || dest = 0
        return: 1
return: (cast: (int) (c.sprintf(dest, "(cast: (@: void) (l2_layout_tokens + %d))", slot) < 0))

# Required local models remain their actual reached declaration instance.
# This projection is separate from a module-lifetime schema identity.
fn: l2_model_inst (int: mi; int: ni; const: @(char ind); @: L2Tx dest) int
    int: oi
    []: char nm 48
    if: dest = 0
        return: 1
    # K02c: a merge result's schema (tagged) is instanced by the result itself -- the Structure its own slot holds,
    # the one place its layout exists at run time; no schema Structure is manufactured.
    if: l2_schema_kind(ni) = 2
        oi: l2_mres_own[l2_schema_index(ni)]
        if: oi < 0 || oi >= l2_own_n
            return: 1
        # The method being EMITTED may hold the result as a working value not yet published to its cell (the root
        # admitting its own `copy` for a callee's input): the instance is that value, whichever method mi names.
        if: l2_own_cached(l2_work_mi, oi) != 0
            if: c.snprintf(nm, 48U, "(cast: (@: Lmx) l2_q%d)", oi) < 0
                return: 1
            return: l2_tx_set(dest, nm)
        return: l2_emit_graph_field_value(oi, ind, dest)
    if: ni < 0 || ni >= l2_ns_n
        return: 1
    if: l2_ns_local[ni] < 0
        return: l2_type_inst(ni, dest)
    if: l2_ns_parent[ni] >= 0
        if: l2_model_inst(mi, l2_ns_parent[ni], ind, dest) != 0
            return: 1
        return: l2_model_child(ni, dest)
    ---
    oi: l2_own_of_local_ns(mi, ni)
    if: oi < 0
        return: 1
    if: mi = l2_work_mi && l2_own_cached(mi, oi) != 0
        if: c.snprintf(nm, 48U, "(cast: (@: Lmx) l2_q%d)", oi) < 0
            return: 1
        return: l2_tx_set(dest, nm)
return: l2_emit_graph_field_value(oi, ind, dest)

# A site that can refuse admission makes its method fail the way a failing
# merge does, so the method takes the status ABI (closed over callers later).
fn: l2_admit_site (int: mi) int
    if: mi < 0 || l2_m_throws = 0
        return: 1
    l2_m_throws[mi]: 1
    l2_need_admit: 1
return: 0

# THE IMPLICIT THROW NAMES (S1.1).  An operator that fails throws its own name; nobody has to
# catch it, and uncaught it reaches the root of the executing Message, which stops (author Q11).
# The team names them (Q17 = A), and this table is the one place that spells them.  Its ORDER is
# the global g, the same in every method: a method's status for implicit name g is d + g, where d
# is the number of names the method declares (0 is the normal return, 1..d its declared names), so
# a caller that knows a callee's d -- from the callee, or from a callable formal's signature --
# knows every implicit status the callee can return.  No other status is on the channel: the
# translator's and the kernel's own broken promises take the diagnostic route (X1,
# l2_emit_invariant), never a status.  `convert` is a converter's refusal at a conversion edge
# (D-83, Q33): whatever the receiver a convert.lm2 row names throws arrives as `convert`.
fn: l2_implicit_name (int: g) const: @: char
    if: g = 1
        return: "merge"
    if: g = 2
        return: "implements"
    if: g = 3
        return: "convert"
return: 0

# THE DECLARED THROW NAMES (S1.2).  `throws:` is the first item of a method head (author Q13):
# the names that may leave the method, in order.  A name's position is its status -- name k
# leaves method mi as k, 1..d -- and the implicit names follow at d + g.  E has no list: its row
# has no method frame.  The list is read from the source tree, like the formals.
fn: l2_throws_frame (int: mi) @: LmP0Node
    @: LmP0Field f
    if: mi < 0 || mi >= l2_m_n || l2_m_node[mi] = 0 || l2_m_body[mi] = 0 || l2_m_body[mi]\kind != c.LM_P0_NODE_STRUCTURE || l2_m_body[mi]\as = 0 || l2_m_body[mi]\as\structure = 0
        return: 0
    f: l2_next_active(l2_m_body[mi]\as\structure\first_field)
    if: f = 0 || l2_frame_head(f\value, "throws") = 0
        return: 0
return: f\value

# d: how many throw names method mi declares.
fn: l2_throws_declared (int: mi) int
    @: LmP0Node t
    t: l2_throws_frame(mi)
    if: t = 0 || t\as = 0 || t\as\frame = 0 || t\as\frame\body = 0
        return: 0
return: l2_count_active(t\as\frame\body)

# Name k (1..d) of method mi's `throws:`; 0 past its end.
fn: l2_throws_name (int: mi; int: k) @: LmP0Text
    @: LmP0Node t
    @: LmP0Field f
    int: i 1
    t: l2_throws_frame(mi)
    if: t = 0 || t\as = 0 || t\as\frame = 0 || t\as\frame\body = 0 || k < 1
        return: 0
    f: l2_next_active(t\as\frame\body\first_field)
    while: f != 0 && i < k
        f: l2_next_active(f\next)
        i: i + 1
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM || f\value\as = 0
        return: 0
return: f\value\as\atom

# The position of `name` in method mi's `throws:`, 1..d; 0: not declared there.
fn: l2_throws_pos (int: mi; const: @(LmP0Text name)) int
    int: k 1
    int: d
    if: name = 0
        return: 0
    d: l2_throws_declared(mi)
    while: k <= d
        if: l2_text_same(l2_throws_name(mi, k), name) != 0
            return: k
        k: k + 1
return: 0

# Two methods declare the same names in the same order: one signature for the intern, and a
# callable formal's contract (S1.4).  A row < 0 declares none.
fn: l2_throws_same (int: a; int: b) int
    int: k 1
    int: d
    d: l2_throws_declared(a)
    if: d != l2_throws_declared(b)
        return: 0
    while: k <= d
        if: l2_text_same(l2_throws_name(a, k), l2_throws_name(b, k)) = 0
            return: 0
        k: k + 1
return: 1

# `throws:` leading a method head names at least one exit: each an identifier, none twice, and
# none an implicit name -- those are thrown by their operators and are not declared (fable,
# -135: a rule may one day promote them; the translator does not).
fn: l2_check_throws_list (const: @(LmP0Node body); const: @(char path)) int
    @: LmP0Field f
    @: LmP0Field g
    @: LmP0Node t
    int: gi
    if: body = 0 || body\kind != c.LM_P0_NODE_STRUCTURE || body\as = 0 || body\as\structure = 0
        return: 0
    f: l2_next_active(body\as\structure\first_field)
    if: f = 0 || l2_frame_head(f\value, "throws") = 0
        return: 0
    t: f\value
    if: t\as\frame\trailer != 0 || t\as\frame\body = 0 || t\as\frame\body\trailer != 0 || l2_count_active(t\as\frame\body) = 0
        return: l2_error(path, t, "throws: lists the names that may leave the method")
    f: l2_next_active(t\as\frame\body\first_field)
    while: f != 0
        if: f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM || f\value\as = 0 || l2_ident(f\value\as\atom) = 0 || f\value\as\atom\length >= 63U
            return: l2_error(path, t, "a throws: item is a name")
        gi: 1
        while: l2_implicit_name(gi) != 0
            if: l2_text_eq(f\value\as\atom, l2_implicit_name(gi)) != 0
                return: l2_error(path, f\value, "an implicit throw name is not declared")
            gi: gi + 1
        g: l2_next_active(t\as\frame\body\first_field)
        while: g != f
            if: l2_text_same(g\value\as\atom, f\value\as\atom) != 0
                return: l2_error(path, f\value, "duplicate name in throws:")
            g: l2_next_active(g\next)
        f: l2_next_active(f\next)
return: 0

# THE CATCH BLOCKS (S1.3, §14).  `catch: Name (params)` with its handler body is a landing pad in
# the caller's block.  A handler covers every call of its block and of the statement blocks
# nested in it (Q14 K); the innermost block that catches the name takes it, and a sibling block
# is not searched.  A name thrown inside its own handler is not caught by that handler: the
# search goes on in the enclosing blocks (§14 :495).
#
# The statements of the block a scope entry stands for: an if/while body or an anonymous `---`
# (the Structure itself), an else, a for's body, a catch's handler body.
fn: l2_scope_block (const: @(LmP0Node node)) @: LmP0Structure
    @: LmP0Field f
    int: k 1
    if: node = 0 || node\as = 0
        return: 0
    if: node\kind = c.LM_P0_NODE_STRUCTURE
        return: node\as\structure
    if: node\kind != c.LM_P0_NODE_FRAME || node\as\frame = 0 || node\as\frame\body = 0
        return: 0
    if: l2_frame_head(node, "else")
        return: node\as\frame\body
    f: l2_next_active(node\as\frame\body\first_field)
    if: l2_frame_head(node, "catch")
        k: 3
    if: l2_frame_head(node, "for")
        k: 5
    if: k = 1
        return: 0
    while: f != 0 && k > 1
        f: l2_next_active(f\next)
        k: k - 1
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_STRUCTURE || f\value\as = 0
        return: 0
return: f\value\as\structure

# The name a catch frame handles.
fn: l2_catch_name (const: @(LmP0Node cf)) @: LmP0Text
    @: LmP0Field f
    if: l2_frame_head(cf, "catch") = 0 || cf\as\frame\body = 0
        return: 0
    f: l2_next_active(cf\as\frame\body\first_field)
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM || f\value\as = 0
        return: 0
return: f\value\as\atom

# A catch frame's parameters, and its handler body (0: none).
fn: l2_catch_params (const: @(LmP0Node cf)) @: LmP0Structure
    @: LmP0Field f
    if: l2_frame_head(cf, "catch") = 0 || cf\as\frame\body = 0
        return: 0
    f: l2_next_active(cf\as\frame\body\first_field)
    if: f != 0
        f: l2_next_active(f\next)
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_STRUCTURE || f\value\as = 0
        return: 0
return: f\value\as\structure

fn: l2_catch_body (const: @(LmP0Node cf)) @: LmP0Structure
return: l2_scope_block(cf)

# The catch of `name` among the direct statements of block blk, and its place among the block's
# catches, 1..m (0: none).  A declared name comes as text, an implicit one as its table spelling.
fn: l2_block_catch (const: @(LmP0Structure blk); const: @(LmP0Text tname); const: @(char cname); @: int out_idx) @: LmP0Node
    @: LmP0Field f
    @: LmP0Text nm
    int: i 0
    if: out_idx != 0
        \out_idx: 0
    if: blk = 0
        return: 0
    f: l2_next_active(blk\first_field)
    while: f != 0
        if: l2_frame_head(f\value, "catch")
            i: i + 1
            nm: l2_catch_name(f\value)
            if: nm != 0 && ((tname != 0 && l2_text_same(nm, tname) != 0) || (cname != 0 && l2_text_eq(nm, cname) != 0))
                if: out_idx != 0
                    \out_idx: i
                return: f\value
            ---
        f: l2_next_active(f\next)
return: 0

# Does block blk hold a catch at all?
fn: l2_block_has_catch (const: @(LmP0Structure blk)) int
    @: LmP0Field f
    if: blk = 0
        return: 0
    f: l2_next_active(blk\first_field)
    while: f != 0
        if: l2_frame_head(f\value, "catch")
            return: 1
        f: l2_next_active(f\next)
return: 0

# THE HANDLER OF A NAME thrown at the point being checked or emitted: the enclosing blocks from
# the innermost out -- the common scope stack, then the method
# body -- and in each the catch of that name, unless it is the very handler the point is in (the
# same name inside its own handler goes to the enclosing context).  0: no handler in this method.
fn: l2_catch_find (int: mi; const: @(LmP0Text tname); const: @(char cname); @@: LmP0Structure out_blk; @: int out_idx) @: LmP0Node
    int: lv
    int: idx 0
    @: LmP0Node prev 0
    @: LmP0Node cf 0
    @: LmP0Structure blk 0
    lv: l2_scope_n - 1
    while: lv >= -1
        blk: 0
        if: lv >= 0
            blk: l2_scope_block(l2_scope_at[lv])
        if: lv < 0 && mi >= 0 && mi < l2_m_n && l2_m_body[mi] != 0 && l2_m_body[mi]\kind = c.LM_P0_NODE_STRUCTURE && l2_m_body[mi]\as != 0
            blk: l2_m_body[mi]\as\structure
        cf: l2_block_catch(blk, tname, cname, @ idx)
        if: cf != 0 && cf != prev
            if: out_blk != 0
                \out_blk: blk
            if: out_idx != 0
                \out_idx: idx
            return: cf
        prev: 0
        if: lv >= 0 && l2_frame_head(l2_scope_at[lv], "catch")
            prev: l2_scope_at[lv]
        lv: lv - 1
return: 0

# Room for one more entry of the stack of enclosing loops and pads: the unit's 64 places while they suffice, then
# memory of twice the entries, the entries kept.  0, or 1 out of memory.
fn: l2_lp_room () int
    @: int nk
    @: int np
    int: cap
    size_t: isz
    if: l2_lp_cap = 0
        l2_lpk: l2_lpk_own
        l2_lpp: l2_lpp_own
        l2_lp_cap: 64
    if: l2_lp_n < l2_lp_cap
        return: 0
    if: l2_lp_cap > c.INT_MAX / 2
        return: 1
    cap: l2_lp_cap * 2
    isz: c.sizeof(c.int)
    nk: (cast: (@: int) l2_xmalloc((cast: (size_t) cap) * isz))
    np: (cast: (@: int) l2_xmalloc((cast: (size_t) cap) * isz))
    if: nk = 0 || np = 0
        l2_xfree((cast: (@: void) nk))
        l2_xfree((cast: (@: void) np))
        return: 1
    memcpy((cast: (@: void) nk), (cast: (@: void) l2_lpk), (cast: (size_t) l2_lp_n) * isz)
    memcpy((cast: (@: void) np), (cast: (@: void) l2_lpp), (cast: (size_t) l2_lp_n) * isz)
    if: l2_lp_cap > 64
        l2_xfree((cast: (@: void) l2_lpk))
        l2_xfree((cast: (@: void) l2_lpp))
    l2_lpk: nk
    l2_lpp: np
    l2_lp_cap: cap
return: 0

# The same for the open pads.
fn: l2_pad_room () int
    @@: LmP0Structure nb
    @: int ni
    int: cap
    size_t: psz
    size_t: isz
    if: l2_pad_cap = 0
        l2_padb: (cast: (@@: LmP0Structure) l2_padb_own)
        l2_padi: l2_padi_own
        l2_pad_cap: 64
    if: l2_pad_n < l2_pad_cap
        return: 0
    if: l2_pad_cap > c.INT_MAX / 2
        return: 1
    cap: l2_pad_cap * 2
    psz: c.sizeof(@: void)
    isz: c.sizeof(c.int)
    nb: (cast: (@@: LmP0Structure) l2_xmalloc((cast: (size_t) cap) * psz))
    ni: (cast: (@: int) l2_xmalloc((cast: (size_t) cap) * isz))
    if: nb = 0 || ni = 0
        l2_xfree((cast: (@: void) nb))
        l2_xfree((cast: (@: void) ni))
        return: 1
    memcpy((cast: (@: void) nb), (cast: (@: void) l2_padb), (cast: (size_t) l2_pad_n) * psz)
    memcpy((cast: (@: void) ni), (cast: (@: void) l2_padi), (cast: (size_t) l2_pad_n) * isz)
    if: l2_pad_cap > 64
        l2_xfree((cast: (@: void) l2_padb))
        l2_xfree((cast: (@: void) l2_padi))
    l2_padb: nb
    l2_padi: ni
    l2_pad_cap: cap
return: 0

# The same for the walker's pads of one emission.
fn: l2_rw_pad_room () int
    @@: LmP0Node nc
    @: int ni
    int: cap
    size_t: psz
    size_t: isz
    if: l2_rw_pcap = 0
        l2_rw_pcf: (cast: (@@: LmP0Node) l2_rw_pcf_own)
        l2_rw_pid: l2_rw_pid_own
        l2_rw_pcap: 64
    if: l2_rw_pn < l2_rw_pcap
        return: 0
    if: l2_rw_pcap > c.INT_MAX / 2
        return: 1
    cap: l2_rw_pcap * 2
    psz: c.sizeof(@: void)
    isz: c.sizeof(c.int)
    nc: (cast: (@@: LmP0Node) l2_xmalloc((cast: (size_t) cap) * psz))
    ni: (cast: (@: int) l2_xmalloc((cast: (size_t) cap) * isz))
    if: nc = 0 || ni = 0
        l2_xfree((cast: (@: void) nc))
        l2_xfree((cast: (@: void) ni))
        return: 1
    memcpy((cast: (@: void) nc), (cast: (@: void) l2_rw_pcf), (cast: (size_t) l2_rw_pn) * psz)
    memcpy((cast: (@: void) ni), (cast: (@: void) l2_rw_pid), (cast: (size_t) l2_rw_pn) * isz)
    if: l2_rw_pcap > 64
        l2_xfree((cast: (@: void) l2_rw_pcf))
        l2_xfree((cast: (@: void) l2_rw_pid))
    l2_rw_pcf: nc
    l2_rw_pid: ni
    l2_rw_pcap: cap
return: 0

# THE PADS.  A block that holds catches is emitted as one loop, its pad:
#     int: l2_atP 0            -- 0 on the straight pass, i after a delivery to catch i
#     while: 1
#         if: l2_atP <= 0      -- segment 0, before the first catch
#         if: l2_atP = 1       -- catch 1: bind its parameters, run its handler
#         if: l2_atP <= 1      -- segment 1
#         ...
#         break
# A delivery to catch i stores the payload, sets l2_atP to i and restarts the pad: the segments
# before catch i are skipped, its handler runs, and the statements after it run -- so a catch
# before the call re-enters the region, and one after it continues past (§14).  From inside
# nested loops the delivery leaves each of them first: l2_goP and a break, and after each loop
# `if: l2_goP != 0` breaks again or, at the pad, restarts it.  A user break or continue written
# directly in a pad leaves the pad the same way (l2_ubP / l2_ucP) and is done at its own loop.
fn: l2_lp_push (int: kind; int: pad) int
    if: l2_lp_room() != 0
        return: l2_alloc_or(l2_src, 0, "out of memory")
    l2_lpk[l2_lp_n]: kind
    l2_lpp[l2_lp_n]: pad
    l2_lp_n: l2_lp_n + 1
return: 0

fn: l2_lp_pop () int
    if: l2_lp_n > 0
        l2_lp_n: l2_lp_n - 1
return: 0

fn: l2_pad_of (const: @(LmP0Structure blk)) int
    int: i
    i: l2_pad_n - 1
    while: i >= 0
        if: l2_padb[i] = blk
            return: l2_padi[i]
        i: i - 1
return: -1

# A throw of `name` arrives here with `payload`: if a handler in this method takes it, deliver
# (1); if none does, write nothing (0) and the caller propagates it.  -1: an error.
fn: l2_emit_deliver (int: mi; const: @(LmP0Text tname); const: @(char cname); const: @(char payload); const: @(char ind)) int
    @: LmP0Structure blk 0
    int: idx 0
    int: p
    if: l2_catch_find(mi, tname, cname, @ blk, @ idx) = 0
        return: 0
    p: l2_pad_of(blk)
    if: p < 0 || idx < 1
        l2_error(l2_src, 0, "internal: a catch without its pad")
        return: -1
    if: c.fprintf(l2_out, "%sl2_pl%d: %s\n%sl2_at%d: %d\n", ind, p, payload, ind, p, idx) < 0
        return: -1
    if: l2_lp_n > 0 && l2_lpk[l2_lp_n - 1] = 1 && l2_lpp[l2_lp_n - 1] = p
        if: c.fprintf(l2_out, "%scontinue\n", ind) < 0
            return: -1
        return: 1
    if: c.fprintf(l2_out, "%sl2_go%d: 1\n%sbreak\n", ind, p, ind) < 0
        return: -1
return: 1

# After a loop's end (it is off the stack already): a delivery that left it restarts its pad if
# the pad is the loop around, or leaves the next loop too; a user break or continue that left the
# pad `closed` (>= 0) is done by the loop around it, or leaves the next pad too.
fn: l2_emit_loop_exit (int: closed; const: @(char ind)) int
    int: i 0
    int: topk -1
    int: top -1
    if: l2_lp_n > 0
        topk: l2_lpk[l2_lp_n - 1]
        top: l2_lpp[l2_lp_n - 1]
    ---
    while: i < l2_lp_n
        if: l2_lpk[i] = 1 && topk = 1 && l2_lpp[i] = top && c.fprintf(l2_out, "%sif: l2_go%d != 0\n%s    l2_go%d: 0\n%s    continue\n", ind, top, ind, top, ind) < 0
            return: 1
        if: l2_lpk[i] = 1 && (topk != 1 || l2_lpp[i] != top) && c.fprintf(l2_out, "%sif: l2_go%d != 0\n%s    break\n", ind, l2_lpp[i], ind) < 0
            return: 1
        i: i + 1
    if: closed >= 0 && topk = 0 && c.fprintf(l2_out, "%sif: l2_ub%d != 0\n%s    l2_ub%d: 0\n%s    break\n%sif: l2_uc%d != 0\n%s    l2_uc%d: 0\n%s    continue\n", ind, closed, ind, closed, ind, ind, closed, ind, closed, ind) < 0
        return: 1
    if: closed >= 0 && topk = 1 && c.fprintf(l2_out, "%sif: l2_ub%d != 0\n%s    l2_ub%d: 0\n%s    l2_ub%d: 1\n%s    break\n%sif: l2_uc%d != 0\n%s    l2_uc%d: 0\n%s    l2_uc%d: 1\n%s    break\n", ind, closed, ind, closed, ind, top, ind, ind, closed, ind, closed, ind, top, ind) < 0
        return: 1
return: 0

# The parameters of a catch are written by its delivery before the handler reads them: to the
# use scan they are bound, never an input the activation reads from outside.
fn: l2_scan_catch_bound (const: @(LmP0Node cf); int: mi; @: int seen) int
    @: LmP0Field p
    @: LmP0Structure ps
    @: LmP0Text fa 0
    int: ty 0
    int: oi
    ps: l2_catch_params(cf)
    if: ps = 0 || seen = 0
        return: 0
    p: l2_next_active(ps\first_field)
    while: p != 0
        fa: 0
        if: l2_typed_formal(p\value, l2_src, @ fa, @ ty) != 0
            return: 1
        oi: l2_own_find_decl(mi, fa, p\value)
        if: oi >= 0
            seen[oi]: 1
        p: l2_next_active(p\next)
return: 0

# A catch parameter binds argument k of the payload by ordinary assignment (Q12, §7): a
# primitive after its domain check, a Structure after the runtime implements of its declared
# type.  The own storage type of a parameter type (-1: not a parameter type).
fn: l2_catch_param_own (int: ty) int
    if: ty = 0 || ty = 2 || ty = 34 || ty = 36
        return: l2_own_ty_of_param(ty)
    if: ty = l2_graph_ft()
        return: l2_graph_own()
return: -1

# `catch: Name (params)` and its handler: the name, no second catch of it in this block, the
# parameters (an implicit name has none, X2), and the handler body under the catch's scope.
fn: l2_check_catch (const: @(LmP0Node cf); const: @(LmP0Structure blk); const: @(char path); int: mi; int: depth) int
    @: LmP0Field f
    @: LmP0Field p
    @: LmP0Text nm
    @: LmP0Text fa 0
    @: LmP0Structure ps
    @: LmP0Structure hb
    int: n
    int: ty 0
    int: gi
    n: l2_count_active(l2_app_actuals(cf))
    if: n < 2 || n > 3 || cf\kind != c.LM_P0_NODE_FRAME || cf\as\frame\trailer != 0
        return: l2_error(path, cf, "catch: takes a name, its parameters and a handler body")
    nm: l2_catch_name(cf)
    ps: l2_catch_params(cf)
    hb: l2_catch_body(cf)
    if: nm = 0 || l2_ident(nm) = 0 || ps = 0 || (n = 3 && hb = 0)
        return: l2_error(path, cf, "catch: takes a name, its parameters and a handler body")
    f: l2_next_active(blk\first_field)
    while: f != 0 && f\value != cf
        if: l2_frame_head(f\value, "catch") && l2_text_same(l2_catch_name(f\value), nm) != 0
            return: l2_error_name(path, cf, "duplicate catch: ", nm\data, nm\length, "")
        f: l2_next_active(f\next)
    gi: 1
    while: l2_implicit_name(gi) != 0
        if: l2_text_eq(nm, l2_implicit_name(gi)) != 0 && l2_count_active(ps) != 0
            return: l2_error(path, cf, "an implicit throw carries no payload")
        gi: gi + 1
    p: l2_next_active(ps\first_field)
    while: p != 0
        fa: 0
        if: l2_typed_formal(p\value, path, @ fa, @ ty) != 0
            return: 1
        if: l2_catch_param_own(ty) < 0
            return: l2_error(path, p\value, "unsupported catch parameter type")
        if: ty = l2_graph_ft() && (p\value\kind != c.LM_P0_NODE_FRAME || l2_ns_find(p\value\as\frame\head) < 0)
            return: l2_error(path, p\value, "unsupported catch parameter type")
        # The handler reads its parameter by name; a visible formal, method, own or unit field of
        # the same name would be found first.
        if: l2_formal_find(mi, fa) >= 0 || l2_find_method(fa) >= 0 || l2_own_visible(mi, fa) >= 0
            return: l2_error(path, p\value, "a catch parameter hides a visible name")
        l2_need_admit: 1
        if: ty = l2_graph_ft() && l2_admit_site(mi) != 0
            return: l2_error(path, p\value, "internal: admission outside a method")
        p: l2_next_active(p\next)
    if: hb = 0
        return: 0
    if: l2_scope_push(cf) != 0
        return: l2_alloc_or(path, cf, "out of memory")
    if: l2_check_body(hb, mi, path, depth + 1) != 0
        l2_scope_pop()
        return: 1
    l2_scope_pop()
return: 0

# The parameters of a catch are own fields hosted by the catch (declared under its scope, like a
# for's variable): bound on delivery, read in the handler, published like any own field.
fn: l2_collect_catch (const: @(LmP0Node cf); int: mi; const: @(char path); int: depth; @: int sn) int
    @: LmP0Field p
    @: LmP0Text fa 0
    @: LmP0Structure ps
    @: LmP0Structure hb
    int: ty 0
    int: own
    int: j
    ps: l2_catch_params(cf)
    hb: l2_catch_body(cf)
    if: l2_for_add(cf, mi, l2_for_find(l2_scope_host()), cf) < 0 || l2_scope_push(cf) != 0
        return: l2_alloc_or(path, cf, "out of memory")
    p: 0
    if: ps != 0
        p: l2_next_active(ps\first_field)
    while: p != 0
        fa: 0
        if: l2_typed_formal(p\value, path, @ fa, @ ty) != 0
            l2_scope_pop()
            return: 1
        own: l2_catch_param_own(ty)
        if: own < 0
            l2_scope_pop()
            return: l2_error(path, p\value, "unsupported catch parameter type")
        j: l2_own_add(mi, fa, own, path, p\value)
        if: j < 0
            l2_scope_pop()
            return: 1
        if: l2_own_off(mi, j) = (cast: (size_t) -1)
            l2_scope_pop()
            return: l2_error(path, p\value, "size overflow")
        if: l2_m_uses[l2_own_off(mi, j)] = 0
            l2_m_own[mi]: l2_m_own[mi] + 1
        l2_m_uses[l2_own_off(mi, j)]: 1
        if: ty = l2_graph_ft() && l2_own_nsty_set(j, l2_ns_find(p\value\as\frame\head)) != 0
            l2_scope_pop()
            return: 1
        p: l2_next_active(p\next)
    if: hb != 0 && l2_collect_decls(hb, mi, path, depth + 1, sn) != 0
        l2_scope_pop()
        return: 1
    l2_scope_pop()
return: 0

# Catch i of pad p: `if: l2_atP = i`, then the parameters bound from the payload and the handler
# body, under the catch's scope.  A payload shorter than the parameters, or a field that is not
# of the parameter's type, is a refused admission: the implicit throw `implements`, raised here.
fn: l2_emit_handler (const: @(LmP0Node cf); int: p; int: i; int: mi; const: @(char d1); const: @(char d2)) int
    @: LmP0Field f
    @: LmP0Text fa 0
    @: LmP0Structure ps
    @: LmP0Structure hb
    int: np 0
    int: k 0
    int: ty 0
    int: oi
    const: @(char vfn) 0
    const: @(char tcode) 0
    []: char val 96
    ps: l2_catch_params(cf)
    hb: l2_catch_body(cf)
    if: ps != 0
        np: l2_count_active(ps)
    if: np = 0 && hb = 0
        return: 0
    if: c.fprintf(l2_out, "%sif: l2_at%d = %d\n", d1, p, i) < 0
        return: 1
    if: l2_scope_push(cf) != 0
        return: 1
    if: np > 0 && c.fprintf(l2_out, "%sif: l2_pl%d = 0 || l2_pl%d\\array.size < %dU\n", d2, p, p, np) < 0
        return: 1
    if: np > 0 && l2_emit_implicit_throw(mi, "implements", d2) != 0
        return: 1
    f: 0
    if: ps != 0
        f: l2_next_active(ps\first_field)
    while: f != 0
        fa: 0
        if: l2_typed_formal(f\value, l2_src, @ fa, @ ty) != 0
            return: 1
        oi: l2_own_find_decl(mi, fa, f\value)
        if: oi < 0
            return: l2_error(l2_src, f\value, "internal: a catch parameter has no own field")
        if: c.fprintf(l2_out, "%sl2_pv%d: lmx_arena_ref_value(l2_pl%d, %dU)\n", d2, p, p, k) < 0
            return: 1
        vfn: 0
        if: ty = 0
            vfn: "lmx_int_value_known"
            tcode: "c.LMX_TYPE_INT"
        if: ty = 2
            vfn: "lmx_size_value_known"
            tcode: "c.LMX_TYPE_SIZE_T"
        if: ty = 34
            vfn: "lmx_unsigned_value_known"
            tcode: "c.LMX_TYPE_UNSIGNED"
        if: ty = 36
            vfn: "lmx_ulong_value_known"
            tcode: "c.LMX_TYPE_ULONG"
        if: vfn != 0
            if: c.fprintf(l2_out, "%sif: l2_pv%d = 0 || lmx_domain_type(l2_program_arena, l2_pv%d) != %s\n", d2, p, p, tcode) < 0
                return: 1
            if: l2_emit_implicit_throw(mi, "implements", d2) != 0
                return: 1
            if: c.sprintf(val, "%s(l2_pv%d)", vfn, p) < 0 || l2_own_store(mi, oi, d2, val) != 0
                return: 1
            ---
        if: vfn = 0
            if: c.sprintf(val, "(cast: (@: Lmx) l2_pv%d)", p) < 0
                return: 1
            if: l2_emit_admit(mi, l2_own_nsty_get(oi), val, d2) != 0 || l2_own_store(mi, oi, d2, val) != 0
                return: 1
            ---
        f: l2_next_active(f\next)
        k: k + 1
    if: hb != 0 && l2_emit_body(hb, mi, d2, (cast: (int) (np = 0))) != 0
        l2_scope_pop()
        return: 1
    l2_scope_pop()
    if: c.fprintf(l2_out, "%s---\n", d2) < 0
        return: 1
return: 0

# A block that holds catches, lowered to its pad (see THE PADS).
fn: l2_emit_pad (const: @(LmP0Structure body); int: mi; const: @(char ind)) int
    @: LmP0Field f
    @: LmP0Field seg
    @: char d1 0
    @: char d2 0
    int: p
    int: j 0
    int: parent 0
    int: q 0
    # A user break or continue can be written directly in this pad only if a user loop encloses
    # it; only then does the pad carry the flags that take one out.
    while: q < l2_lp_n
        if: l2_lpk[q] = 0
            parent: 1
        q: q + 1
    if: l2_bump_ind(ind, @ d1) != 0 || l2_bump_ind(d1, @ d2) != 0
        return: 1
    if: l2_pad_room() != 0
        return: l2_alloc_or(l2_src, 0, "out of memory")
    p: l2_pad_seq
    l2_pad_seq: l2_pad_seq + 1
    if: c.fprintf(l2_out, "%sint: l2_at%d 0\n%sint: l2_go%d 0\n%s@: Lmx l2_pl%d 0\n%s@: void l2_pv%d 0\n", ind, p, ind, p, ind, p, ind, p) < 0
        return: 1
    if: parent > 0 && c.fprintf(l2_out, "%sint: l2_ub%d 0\n%sint: l2_uc%d 0\n", ind, p, ind, p) < 0
        return: 1
    if: c.fprintf(l2_out, "%swhile: 1\n", ind) < 0
        return: 1
    l2_padb[l2_pad_n]: (cast: (@: LmP0Structure) body)
    l2_padi[l2_pad_n]: p
    l2_pad_n: l2_pad_n + 1
    if: l2_lp_push(1, p) != 0
        return: 1
    if: l2_emit_poll(mi, d1) != 0
        return: 1
    seg: l2_next_active(body\first_field)
    f: seg
    while: f != 0
        if: l2_frame_head(f\value, "catch")
            if: seg != f && c.fprintf(l2_out, "%sif: l2_at%d <= %d\n", d1, p, j) < 0
                return: 1
            if: seg != f && l2_emit_stmts(body, seg, f, mi, d2, 1) != 0
                return: 1
            if: seg != f && c.fprintf(l2_out, "%s---\n", d2) < 0
                return: 1
            j: j + 1
            if: l2_emit_handler(f\value, p, j, mi, d1, d2) != 0
                return: 1
            seg: l2_next_active(f\next)
            f: seg
            continue
        f: l2_next_active(f\next)
    if: seg != 0 && c.fprintf(l2_out, "%sif: l2_at%d <= %d\n", d1, p, j) < 0
        return: 1
    if: seg != 0 && l2_emit_stmts(body, seg, 0, mi, d2, 1) != 0
        return: 1
    if: seg != 0 && c.fprintf(l2_out, "%s---\n", d2) < 0
        return: 1
    if: c.fprintf(l2_out, "%sbreak\n%send: while\n", d1, ind) < 0
        return: 1
    l2_lp_pop()
    l2_pad_n: l2_pad_n - 1
    if: parent > 0
        return: l2_emit_loop_exit(p, ind)
return: l2_emit_loop_exit(0 - 1, ind)

# A freshly opened L1 body needs an explicit Structure when all its source
# operations were elided. Do not add one to an already populated body: L1 can
# inherit a preceding declaration into a following Structure.
fn: l2_emit_empty_body (long: from; const: @(char ind)) int
    long: to c.ftell(l2_out)
    if: from < 0 || to < 0
        return: l2_error(l2_src, 0, "cannot locate generated statement output")
    if: to = from && c.fprintf(l2_out, "%s()\n", ind) < 0
        return: 1
return: 0

# Leaving a body drops marks of fields declared in that body only (D-79). A formal's
# binding is one cell of the method: a bare write inside the body does not end at the
# body's edge. A declaration in the body (`int: n` in the if) does.
fn: l2_emit_body (const: @(LmP0Structure body); int: mi; const: @(char ind); int: empty_body) int
    int: s0 l2_bseq_n
    int: k 0
    long: emitted_from 0
    if: empty_body != 0
        emitted_from: c.ftell(l2_out)
    if: l2_emit_body_in(body, mi, ind) != 0
        return: 1
    while: k < l2_own_n
        if: l2_own_bseq[k] > s0 && l2_host_is_body(l2_own_host[k], body) != 0
            l2_own_bseq[k]: 0
        k: k + 1
    ---
    if: empty_body != 0
        return: l2_emit_empty_body(emitted_from, ind)
return: 0

# host is the node pushed for this body: a structure node, or an else frame.
fn: l2_host_is_body (const: @(LmP0Node host); const: @(LmP0Structure body)) int
    @: LmP0Field field
    if: host = 0 || body = 0 || host\as = 0
        return: 0
    if: host\kind = c.LM_P0_NODE_STRUCTURE && host\as\structure = body
        return: 1
    if: host\kind = c.LM_P0_NODE_FRAME && host\as\frame != 0 && host\as\frame\body = body
        return: 1
    # A receiver's body may be a Structure operand after its header operands.
    if: host\kind = c.LM_P0_NODE_FRAME && host\as\frame != 0 && host\as\frame\body != 0
        field: l2_next_active(host\as\frame\body\first_field)
        while: field != 0
            if: field\value != 0 && field\value\kind = c.LM_P0_NODE_STRUCTURE && field\value\as != 0 && field\value\as\structure = body
                return: 1
            field: l2_next_active(field\next)
        ---
return: 0

# A block with catches is its pad; any other block is its statements.
fn: l2_emit_body_in (const: @(LmP0Structure body); int: mi; const: @(char ind)) int
    if: body = 0
        return: 0
    # The walked body is the model's frames (l2_pap_steps). This native function is not the call.
    if: l2_pap_on(mi) != 0
        if: l2_m_ret[mi] != 8 && c.fprintf(l2_out, "%sreturn: 0\n", ind) < 0
            return: 1
        return: 0
    # The host's return constructs the selected callable; its own statements
    # still execute normally before that construction.
    # The host's body is the method's own; a nested body of it is its statements, as any block's.
    if: l2_mad_on(mi) != 0 && l2_m_body[mi] != 0 && l2_m_body[mi]\as != 0 && body = l2_m_body[mi]\as\structure
        return: l2_mad_host_body(body, mi, ind)
    if: l2_block_has_catch(body) != 0
        return: l2_emit_pad(body, mi, ind)
return: l2_emit_stmts(body, l2_next_active(body\first_field), 0, mi, ind, 0)

# THE STATIC RULE (§14, author Q13): every name a callee declares is caught in the caller's
# enclosing blocks (S1.3) or listed in the caller's own `throws:`, else the call is refused.  E
# lists none, so a declared name that would reach E is refused there.
fn: l2_check_throws_handled (int: mi; int: callee; const: @(char path); const: @(LmP0Node at)) int
    int: k 1
    int: d
    @: LmP0Text nm
    d: l2_throws_declared(callee)
    while: k <= d
        nm: l2_throws_name(callee, k)
        if: nm != 0 && l2_throws_pos(mi, nm) = 0 && l2_catch_find(mi, nm, 0, 0, 0) = 0
            if: mi = l2_e
                return: l2_error_name(path, at, "unhandled throw in entry: ", nm\data, nm\length, "")
            return: l2_error_name(path, at, "unhandled throw: ", nm\data, nm\length, "")
        k: k + 1
return: 0

# The payload cell of one throw argument: an own storage type -- 0 int, 2 size_t, 3 unsigned,
# 36 ulong -- whose fresh cell holds the value as an own field of that type holds it, or the
# `@: Lmx` pointer type (>= 1000) of a Structure, whose reference is the child itself.  -1:
# nothing a payload carries yet -- a char (a method has no char table to intern it in), a text,
# a value of several fields.
fn: l2_throw_arg_ty (@: LmP0Field a0; int: span; int: mi) int
    int: ty 0
    int: own
    const: @: LmP0Text at
    if: a0 = 0 || span != 1 || a0\value = 0
        return: -1
    if: l2_colon_simple_ty(a0\value, mi, @ ty) != 0
        return: -1
    if: ty = -10
        if: a0\value\kind != c.LM_P0_NODE_ATOM || a0\value\as = 0 || a0\value\as\atom = 0
            return: -1
        at: a0\value\as\atom
        if: at\length = 0U || at\data[0] = 39
            return: -1
        if: at\length >= 2U && (at\data[at\length - 1U] = 76 || at\data[at\length - 1U] = 108) && (at\data[at\length - 2U] = 85 || at\data[at\length - 2U] = 117)
            return: 36
        if: at\data[at\length - 1U] = 85 || at\data[at\length - 1U] = 117
            return: 2
        return: 0
    if: ty < 0
        return: -1
    # A declared graph formal carries the graph type itself (l2_colon_is_graph_ty).
    if: ty = l2_graph_ft()
        return: l2_graph_own()
    own: l2_own_ty_of_param(ty)
    if: own = 0 || own = 2 || own = 3 || own = 36
        return: own
    if: l2_oc_is_ref(own) != 0 && own = l2_graph_own()
        return: own
return: -1

# `throw: Name(args)` / `throw: Name`: Name is declared in this method's `throws:` (§14), and
# each argument is one value a payload can carry (l2_throw_arg_ty), checked like a call's.
fn: l2_check_throw (const: @(LmP0Node stmt); int: mi; const: @(char path)) int
    @: LmP0Node what
    @: LmP0Field a0
    @: LmP0Text name 0
    int: span
    int: pmi
    const: @: LmP0Frame fr
    if: l2_count_active(l2_app_actuals(stmt)) != 1 || stmt\kind != c.LM_P0_NODE_FRAME
        return: l2_error(path, stmt, "throw: takes one name and its payload")
    fr: stmt\as\frame
    if: fr\trailer != 0 || fr\body = 0 || fr\body\trailer != 0
        return: l2_error(path, stmt, "throw: takes one name and its payload")
    what: l2_next_active(fr\body\first_field)\value
    if: what != 0 && what\kind = c.LM_P0_NODE_ATOM && what\as != 0
        name: what\as\atom
    if: what != 0 && what\kind = c.LM_P0_NODE_FRAME && what\as != 0 && what\as\frame != 0
        name: what\as\frame\head
    if: name = 0 || l2_ident(name) = 0
        return: l2_error(path, stmt, "throw: takes one name and its payload")
    if: l2_throws_pos(mi, name) = 0
        return: l2_error(path, stmt, "throw of an undeclared name")
    if: what\kind != c.LM_P0_NODE_FRAME
        return: 0
    if: what\as\frame\trailer != 0 || what\as\frame\body = 0 || what\as\frame\body\trailer != 0
        return: l2_error(path, stmt, "unsupported trailer")
    a0: l2_next_active(what\as\frame\body\first_field)
    while: a0 != 0
        span: l2_expr_span(a0)
        if: span < 1 || l2_check_fields(a0, span, mi, path, stmt) != 0
            return: 1
        if: l2_throw_arg_ty(a0, span, mi) < 0
            return: l2_error(path, stmt, "unsupported throw payload value")
        pmi: 0
        while: pmi < span && a0 != 0
            a0: l2_next_active(a0\next)
            pmi: pmi + 1
        ---
    ---
return: 0

# A `throw:` references its payload arguments; its name is an exit, not a value.
fn: l2_scan_throw_args (const: @(LmP0Node stmt); int: mi; @: int seen) int
    @: LmP0Field w
    if: stmt = 0 || stmt\as = 0 || stmt\as\frame = 0 || stmt\as\frame\body = 0
        return: 0
    w: l2_next_active(stmt\as\frame\body\first_field)
    if: w = 0 || w\value = 0 || w\value\kind != c.LM_P0_NODE_FRAME || w\value\as = 0 || w\value\as\frame = 0 || w\value\as\frame\body = 0
        return: 0
return: l2_scan_fields(w\value\as\frame\body\first_field, l2_count_active(w\value\as\frame\body), mi, seen)

# THE THROW (S1.2).  The arguments are evaluated in order into a fresh payload Structure in
# l2_program_arena: child k is argument k -- a fresh cell of its type holding the value, or the
# Structure reference itself (no copy, no reparenting).  A payload that cannot be allocated
# leaves as no payload, 0; a catch parameter's binding refuses it (S1.3).  Then what the
# activation wrote is published (§13) and the throw leaves: `l2_out_throw[0]: payload; return:
# pos(Name)`.
fn: l2_emit_throw (const: @(LmP0Node stmt); int: mi; const: @(char ind)) int
    @: LmP0Node what
    @: LmP0Field a0 0
    @: LmP0Text name
    int: n 0
    int: k 0
    int: span
    int: pmi
    int: ty
    int: t
    int: pos
    const: @(char newf) 0
    what: l2_next_active(stmt\as\frame\body\first_field)\value
    if: what\kind = c.LM_P0_NODE_ATOM
        name: what\as\atom
    else:
        name: what\as\frame\head
        if: what\as\frame\body != 0
            a0: l2_next_active(what\as\frame\body\first_field)
        ---
    ---
    if: a0 != 0
        n: l2_actual_count(a0)
    pos: l2_throws_pos(mi, name)
    if: pos <= 0
        return: l2_error(l2_src, stmt, "internal: a throw was not checked")
    t: l2_tn
    l2_tn: l2_tn + 1
    if: n > 0 && c.fprintf(l2_out, "%s@: Lmx l2_tp%d 0\n%s@: void l2_tc%d 0\n%sl2_tp%d: lmx_node_new_owned(l2_program_arena)\n%sif: l2_tp%d != 0 && lmx_arena_refs_open_owned(l2_program_arena, l2_tp%d, %dU) != 0\n%s    l2_tp%d: 0\n", ind, t, ind, t, ind, t, ind, t, t, n, ind, t) < 0
        return: 1
    while: a0 != 0 && k < n
        span: l2_expr_span(a0)
        ty: l2_throw_arg_ty(a0, span, mi)
        if: ty < 0
            return: l2_error(l2_src, stmt, "internal: a throw payload value was not checked")
        if: l2_eval_fields(a0, span, mi, ind, l2_tok) != 0
            return: 1
        newf: 0
        if: ty = 0
            newf: "lmx_int_new_owned"
        if: ty = 2
            newf: "lmx_size_new_owned"
        if: ty = 3
            newf: "lmx_unsigned_new_owned"
        if: ty = 36
            newf: "lmx_ulong_new_owned"
        if: newf != 0 && c.fprintf(l2_out, "%sif: l2_tp%d != 0\n%s    l2_tc%d: %s(l2_program_arena)\n%sif: l2_tp%d != 0 && l2_tc%d = 0\n%s    l2_tp%d: 0\n%sif: l2_tp%d != 0 && (%s(l2_tc%d, %s) != 0 || lmx_arena_ref_store(l2_tp%d, %dU, l2_tc%d) != 0)\n", ind, t, ind, t, newf, ind, t, t, ind, t, ind, t, l2_own_store_helper(ty), t, l2_tok\data, t, k, t) < 0
            return: 1
        if: newf = 0 && c.fprintf(l2_out, "%sif: l2_tp%d != 0 && lmx_arena_ref_store(l2_tp%d, %dU, (cast: (@: void) %s)) != 0\n", ind, t, t, k, l2_tok\data) < 0
            return: 1
        if: l2_emit_invariant(ind, "a throw payload refused its field") != 0
            return: 1
        pmi: 0
        while: pmi < span && a0 != 0
            a0: l2_next_active(a0\next)
            pmi: pmi + 1
        k: k + 1
    ---
    # §7b: the throw is an exit -- its payload is evaluated above, and what is marked is published before it leaves
    # (book §14).
    if: l2_emit_publish(ind) != 0
        return: 1
    if: n > 0 && c.fprintf(l2_out, "%sl2_out_throw[0]: l2_tp%d\n%sreturn: %d\n", ind, t, ind, pos) < 0
        return: 1
    if: n = 0 && c.fprintf(l2_out, "%sl2_out_throw[0]: 0\n%sreturn: %d\n", ind, ind, pos) < 0
        return: 1
return: 0

# The status method mi returns for the implicit name `name`: d + g.  0: not an implicit name.
fn: l2_implicit_status (int: mi; const: @(char name)) int
    int: g 1
    if: name = 0
        return: 0
    while: l2_implicit_name(g) != 0
        if: c.strcmp(l2_implicit_name(g), name) = 0
            return: l2_throws_declared(mi) + g
        g: g + 1
return: 0

# AN IMPLICIT THROW LEAVES THE METHOD.  The caller has written the `if:` line at `ind`; this is
# its body.  What is marked is published (§7b, book §14), and the throw leaves with its status and
# no payload: merge has none (X2), and neither has implements while no catch parameter asks for one.
# A handler of this method that takes it is no exit, and publishes nothing.
fn: l2_emit_implicit_throw (int: mi; const: @(char name); const: @(char ind)) int
    @: char deep 0
    int: st
    int: dv
    st: l2_implicit_status(mi, name)
    if: st <= 0
        return: l2_error(l2_src, 0, "internal: not an implicit throw name")
    if: l2_bump_ind(ind, @ deep) != 0
        return: 1
    # A handler in this method takes it (S1.3: a catch of the operator's name); else it leaves.
    dv: l2_emit_deliver(mi, 0, name, "0", deep)
    if: dv < 0
        return: 1
    if: dv > 0
        return: 0
    if: l2_emit_publish(deep) != 0
        return: 1
    if: c.fprintf(l2_out, "%sl2_out_throw[0]: 0\n%sreturn: %d\n", deep, deep, st) < 0
        return: 1
return: 0

# A THROW THAT PASSES THROUGH A CALL.  The callee's status k is in the callee's numbering and the
# caller re-encodes it into its own.  1..d_callee are declared names: k becomes the caller's
# position of the same NAME, which the static rule (l2_check_throws_handled) proved exists.  Above
# d_callee, k is implicit name g = k - d_callee, which the caller returns as d_caller + g.
# §7b: leaving this way publishes nothing -- the call's own publication (l2_emit_call) is the line before the status
# test, so no working value can be marked here.
fn: l2_emit_propagate (int: mi; int: callee; int: t; const: @(char ind)) int
    int: shift
    int: k 1
    int: g 1
    int: pos
    int: dv
    @: char d2 0
    @: char d3 0
    []: char pl 32
    if: mi < 0 || callee < 0 || ind = 0
        return: 1
    if: l2_bump_ind(ind, @ d2) != 0 || l2_bump_ind(d2, @ d3) != 0 || c.sprintf(pl, "l2_te%d", t) < 0
        return: 1
    shift: l2_throws_declared(mi) - l2_throws_declared(callee)
    if: c.fprintf(l2_out, "%sif: l2_ts%d != 0\n%s    l2_out_throw[0]: l2_te%d\n", ind, t, ind, t) < 0
        return: 1
    # A handler in this method takes a name first (S1.3); else a declared name leaves by its
    # position in this method's list.
    while: k <= l2_throws_declared(callee)
        if: c.fprintf(l2_out, "%sif: l2_ts%d = %d\n", d2, t, k) < 0
            return: 1
        dv: l2_emit_deliver(mi, l2_throws_name(callee, k), 0, pl, d3)
        if: dv < 0
            return: 1
        pos: l2_throws_pos(mi, l2_throws_name(callee, k))
        if: dv = 0 && pos <= 0
            return: l2_error(l2_src, 0, "internal: a callee's declared throw is not handled by its caller")
        if: dv = 0 && c.fprintf(l2_out, "%sreturn: %d\n", d3, pos) < 0
            return: 1
        k: k + 1
    while: l2_implicit_name(g) != 0
        if: l2_catch_find(mi, 0, l2_implicit_name(g), 0, 0) != 0
            if: c.fprintf(l2_out, "%sif: l2_ts%d = %d\n", d2, t, l2_throws_declared(callee) + g) < 0
                return: 1
            if: l2_emit_deliver(mi, 0, l2_implicit_name(g), pl, d3) < 0
                return: 1
            ---
        g: g + 1
    if: shift = 0 && c.fprintf(l2_out, "%s    return: l2_ts%d\n", ind, t) < 0
        return: 1
    if: shift > 0 && c.fprintf(l2_out, "%s    return: l2_ts%d + %d\n", ind, t, shift) < 0
        return: 1
    if: shift < 0 && c.fprintf(l2_out, "%s    return: l2_ts%d - %d\n", ind, t, 0 - shift) < 0
        return: 1
return: 0

# THE DIAGNOSTIC ROUTE (X1).  A check the generated program makes of the translator's or the
# kernel's own promise -- the shape merge produced, a cell the unit was built with -- is an
# invariant, not a throw: it is on no status, so no catch can take it and no caller reads it as a
# name.  It says what broke on stderr and aborts: the kernel has no delivery to a diagnostic root
# that could stop just this Message (lmx_msg_poll_abort reports only a letter that already
# succeeded), and going on would bind the wrong shape or read through the missing cell.  The
# `if:` line is the caller's, at `ind`; `what` is the diagnostic's text.
fn: l2_emit_invariant (const: @(char ind); const: @(char what)) int
    if: ind = 0 || what = 0
        return: 1
    if: c.fprintf(l2_out, "%s    c.fprintf(c.stderr, \"lmx: invariant: %s\\n\")\n%s    c.abort()\n", ind, what, ind) < 0
        return: 1
return: 0

# D-57 (-178 commit 3): a letter is admitted by its PAYLOAD.  Since -173 a letter is (sender;
# payload), and the user's model describes the payload (the mail design), so admitting the whole
# letter refused every host letter.  Is `node` the name of a letter -- an own field of method mi
# declared by `receiveMessage: name`?
fn: l2_is_letter_name (int: mi; const: @(LmP0Node node)) int
    @: LmP0Text name 0
    int: oi
    if: node = 0 || node\kind != c.LM_P0_NODE_ATOM || node\as = 0 || node\as\atom = 0
        return: 0
    oi: l2_own_visible(mi, node\as\atom)
    if: oi < 0 || l2_own_decl[oi] = 0
        return: 0
return: (cast: (int) (l2_receive_msg_shape(l2_own_decl[oi], @ name, 0) = 0))

# A letter value or its explicit reference denotes the same received Structure.
# Parenthesized values use the same expression fields at every admission site.
fn: l2_is_letter_value (int: mi; @: LmP0Field first; int: count) int
    @: LmP0Node value
    first: l2_next_active(first)
    if: first = 0 || first\value = 0
        return: 0
    value: first\value
    if: count = 2 && value\kind = c.LM_P0_NODE_ATOM && l2_text_eq(value\as\atom, "@") != 0
        return: l2_is_letter_value(mi, first\next, 1)
    if: count != 1
        return: 0
    if: value\kind = c.LM_P0_NODE_STRUCTURE
        return: l2_is_letter_value(mi, value\as\structure\first_field, l2_count_active(value\as\structure))
    if: l2_frame_head(value, "@") != 0 && l2_count_active(value\as\frame\body) = 1
        return: l2_is_letter_value(mi, value\as\frame\body\first_field, 1)
return: l2_is_letter_name(mi, value)

# The value expression `val` rewritten into its letter's payload, slot 1 -- lmx_arena_ref_value answers 0 for a
# null letter, so a null stays null and passes unadmitted.
fn: l2_payload_expr (@: L2Tx val) int
    []: char tmp_own 320
    L2Tx: tmp_tx
    @: L2Tx tmp @ tmp_tx
    if: val = 0 || l2_tx_open(tmp, tmp_own, 320U) != 0
        return: 1
    if: l2_tx_join(tmp, "(cast: (@: Lmx) lmx_arena_ref_value((cast: (@: Lmx) ", val\data, "), 1U))", 0, 0) != 0
        return: 1
return: l2_tx_set(val, tmp\data)

# varA = the candidate, varB = the declared type's shape, consumer = that same
# shape: every declared field counts as used -- stricter than a uses tree, never
# looser.  0 is no graph and is not admitted.  NO or UNKNOWN throws the implicit
# name `implements` (Q17 = A): no silent binding.
fn: l2_emit_admit (int: mi; int: ni; const: @(char value); const: @(char ind)) int
    []: char inst_own 128
    L2Tx: inst_tx
    @: L2Tx inst l2_tx_local(@ inst_tx, inst_own, 128U)
    if: mi < 0 || l2_m_throws = 0 || l2_m_throws[mi] = 0
        return: l2_error(l2_src, 0, "internal: an admission site was not checked")
    # Root and descendant declarations share the actual-instance projection.
    if: l2_model_inst(mi, ni, ind, inst) != 0
        return: l2_error(l2_src, 0, "internal: admission to a type with no shape")
return: l2_emit_positional_admit(mi, inst\data, value, ind)

# Own field oi whose type is the Structure at its place -- a method's own named Structure (l2_local_ns_shape): the value
# admitted to that Structure -- its working value when it has one (l2_q<oi>), else its slot -- as a declared named
# Structure is admitted to the Structure at its place, its unit child (l2_type_inst).  NO or UNKNOWN throws
# `implements`, as l2_emit_admit's.
fn: l2_emit_admit_own (int: mi; int: oi; const: @(char value); const: @(char ind)) int
    []: char inst_own 320
    L2Tx: inst_tx
    @: L2Tx inst l2_tx_local(@ inst_tx, inst_own, 320U)
    if: mi < 0 || l2_m_throws = 0 || l2_m_throws[mi] = 0
        return: l2_error(l2_src, 0, "internal: an admission site was not checked")
    if: l2_model_inst(mi, l2_own_nsty_get(oi), ind, inst) != 0
        return: 1
return: l2_emit_positional_admit(mi, inst\data, value, ind)

# Unknown-layout receptions still establish a usable correspondence. Keep the
# full current receiver check, including nested holes, before publishing an
# identity entry with unknown layout. Existing mapped entries stay untouched.
fn: l2_emit_positional_admit (int: mi; const: @(char inst); const: @(char value); const: @(char ind)) int
    if: c.fprintf(l2_out, "%sif: %s != 0 && lmx_implements_receiver_view(l2_program_arena, (cast: (@: Lmx) %s), %s, %s, 0) != c.LMX_IMPLEMENTS_YES\n", ind, value, value, inst, inst) < 0 || l2_emit_implicit_throw(mi, "implements", ind) != 0
        return: 1
    if: c.fprintf(l2_out, "%sif: %s != 0 && lmx_implements_find(l2_program_arena, (cast: (@: Lmx) %s), %s) = 0 && lmx_implements_register_map(l2_program_arena, (cast: (@: Lmx) %s), %s, 0, 0U, 0) != c.LMX_IMPLEMENTS_YES\n", ind, value, value, inst, value, inst) < 0
        return: 1
return: l2_emit_implicit_throw(mi, "implements", ind)

# A kind-3 field -- the synthesized letter's payload of a named model (l2_letter_ns_for): one merge of the named unit
# Structure into this slot. The result is a distinct copy, held by the Structure that holds the field; its parent is
# the copy's own -- the copy of the model's lexical parent, neither the holder nor the model's source parent (the
# author, LMX_blog/2026-10-05.md#merge-parent).
fn: l2_emit_ns_ref (int: ref; const: @(char parent); int: slot; const: @(char ind); int: live) int
    int: id 0
    int: at 0
    if: parent = 0 || ind = 0 || ref < 0 || ref >= l2_ns_n || l2_ns_local[ref] >= 0 || l2_ns_eternal[ref] >= 0
        return: l2_error(l2_src, 0, "a method's named Structure reference is not a unit Structure")
    id: l2_held_n
    l2_held_n: l2_held_n + 1
    at: l2_ns_unit_slot(ref)
    if: c.fprintf(l2_out, "%s[]: @(Lmx) l2_href%d 1\n%sint: l2_hstat%d 0\n%s@: Lmx l2_hres%d 0\n%s@: Lmx l2_hbody%d 0\n", ind, id, ind, id, ind, id, ind, id) < 0
        return: 1
    if: live = 0 && c.fprintf(l2_out, "%sl2_href%d[0U]: l2_nsp[%d]\n", ind, id, ref) < 0
        return: 1
    if: live != 0 && c.fprintf(l2_out, "%sl2_href%d[0U]: lmx_arena_ref_struct(l2_program_unit, %uU)\n", ind, id, (cast: (unsigned) at)) < 0
        return: 1
    if: c.fprintf(l2_out, "%sl2_hbody%d: 0\n%sl2_hstat%d: lmx_merge_owned(l2_href%d, 1U, l2_hbody%d, l2_program_arena, l2_program_arena, 0, 0U, @ l2_hres%d)\n%sif: l2_hstat%d != 0 || l2_hres%d = 0\n", ind, id, ind, id, id, id, id, ind, id, id) < 0
        return: 1
    if: live = 0 && c.fprintf(l2_out, "%s    return: 1\n", ind) < 0
        return: 1
    if: live != 0 && l2_emit_invariant(ind, "a method's named Structure reference did not copy") != 0
        return: 1
    if: c.fprintf(l2_out, "%sif: lmx_arena_ref_store(%s, %uU, (cast: (@: void) l2_hres%d)) != 0\n", ind, parent, (cast: (unsigned) slot), id) < 0
        return: 1
    if: live = 0 && c.fprintf(l2_out, "%s    return: 1\n", ind) < 0
        return: 1
    if: live != 0 && l2_emit_invariant(ind, "a method's named Structure reference did not take its place") != 0
        return: 1
    if: c.fprintf(l2_out, "%sif: l2_hres%d\\parent = %s || (l2_href%d[0U]\\parent = 0 && l2_hres%d\\parent != 0) || (l2_href%d[0U]\\parent != 0 && (l2_hres%d\\parent = 0 || l2_hres%d\\parent = l2_href%d[0U]\\parent))\n", ind, id, parent, id, id, id, id, id, id) < 0
        return: 1
    if: live = 0 && c.fprintf(l2_out, "%s    return: 1\n", ind) < 0
        return: 1
    if: live != 0 && l2_emit_invariant(ind, "a method's named Structure reference is not parented inside its copy") != 0
        return: 1
return: 0

# One nested Structure of entry nest, stored at slot of parent. Its fields are numbers, chars,
# or further nested Structures. live 0 fails with return 1; live 1 aborts on the invariant.
fn: l2_emit_one_nest (int: nest; const: @(char parent); int: slot; const: @(char cell); const: @(char ind); int: live) int
    int: sx 0
    int: sn 0
    int: id 0
    []: char mine 32
    []: char pty 64
    if: nest < 0 || nest >= l2_ns_n || parent = 0 || cell = 0 || ind = 0
        return: 1
    id: l2_held_n
    l2_held_n: l2_held_n + 1
    if: c.sprintf(mine, "l2_held%d", id) < 0
        return: 1
    while: sx < l2_nsf_n
        if: l2_nsf_owner[sx] = nest && (l2_nsf_kind[sx] = 0 || l2_nsf_kind[sx] = 1 || l2_nsf_kind[sx] = 2 || l2_nsf_kind[sx] = 3 || l2_nsf_kind[sx] = 4 || l2_nsf_kind[sx] = 5 || l2_nsf_kind[sx] = 6 || l2_nsf_kind[sx] = 7 || l2_nsf_kind[sx] = 8 || l2_nsf_kind[sx] = 9 || l2_nsf_kind[sx] = 10 || l2_nsf_kind[sx] = 11)
            sn: sn + 1
        sx: sx + 1
    ---
    if: c.fprintf(l2_out, "%s@: Lmx %s lmx_struct_new_owned(%s, l2_program_arena)\n%sif: %s = 0\n", ind, mine, parent, ind, mine) < 0
        return: 1
    if: live = 0 && c.fprintf(l2_out, "%s    return: 1\n", ind) < 0
        return: 1
    if: live != 0 && l2_emit_invariant(ind, "a method's named Structure did not allocate") != 0
        return: 1
    if: live = 0 && l2_emit_source_name(mine, l2_ns_name[nest], ind, "return: 1", 0) != 0
        return: 1
    if: live != 0 && l2_emit_source_name(mine, l2_ns_name[nest], ind, "c.abort()", "return: 0") != 0
        return: 1
    if: sn > 0 && c.fprintf(l2_out, "%sif: lmx_arena_refs_open_owned(l2_program_arena, %s, %dU) != 0\n", ind, mine, sn) < 0
        return: 1
    if: sn > 0 && live = 0 && c.fprintf(l2_out, "%s    return: 1\n", ind) < 0
        return: 1
    if: sn > 0 && live != 0 && l2_emit_invariant(ind, "a method's named Structure did not open its fields") != 0
        return: 1
    sn: 0
    sx: 0
    while: sx < l2_nsf_n
        # A method's named Structure holds no binding (l2_take_ns_body says so at its place).
        if: l2_nsf_owner[sx] = nest && l2_nsf_kind[sx] = 10 && l2_nsf_val[sx] != 0U
            return: l2_error(l2_src, l2_nsf_source[sx], "internal: a method's named Structure holds a reference binding")
        if: l2_nsf_owner[sx] = nest && l2_nsf_kind[sx] = 3
            if: l2_emit_ns_ref(l2_nsf_ref[sx], mine, sn, ind, live) != 0
                return: 1
            sn: sn + 1
        if: l2_nsf_owner[sx] = nest && l2_nsf_kind[sx] = 2
            if: l2_emit_one_nest(l2_nsf_ref[sx], mine, sn, cell, ind, live) != 0
                return: 1
            sn: sn + 1
        if: l2_nsf_owner[sx] = nest && l2_nsf_kind[sx] = 7
            if: c.fprintf(l2_out, "%s%s: lmx_arena_ref_cell(%s, %uU)\n%sif: %s = 0\n", ind, cell, mine, (cast: (unsigned) sn), ind, cell) < 0
                return: 1
            if: live = 0 && c.fprintf(l2_out, "%s    return: 1\n", ind) < 0
                return: 1
            if: live != 0 && l2_emit_invariant(ind, "a method's named Structure has no field cell") != 0
                return: 1
            if: c.fprintf(l2_out, "%s%s[0]: lmx_int_new_owned(l2_program_arena)\n%sif: %s[0] = 0 || lmx_int_store_known(%s[0], %d) != 0\n", ind, cell, ind, cell, cell, (cast: (int) l2_nsf_val[sx])) < 0
                return: 1
            if: live = 0 && c.fprintf(l2_out, "%s    return: 1\n", ind) < 0
                return: 1
            if: live != 0 && l2_emit_invariant(ind, "a method's named Structure field refused its value") != 0
                return: 1
            sn: sn + 1
        if: l2_nsf_owner[sx] = nest && l2_nsf_kind[sx] = 1
            if: c.fprintf(l2_out, "%s%s: lmx_arena_ref_cell(%s, %uU)\n%sif: %s = 0\n", ind, cell, mine, (cast: (unsigned) sn), ind, cell) < 0
                return: 1
            if: live = 0 && c.fprintf(l2_out, "%s    return: 1\n", ind) < 0
                return: 1
            if: live != 0 && l2_emit_invariant(ind, "a method's named Structure has no field cell") != 0
                return: 1
            if: c.fprintf(l2_out, "%s%s[0]: lmx_char_new_owned(l2_program_arena)\n%sif: %s[0] = 0 || lmx_char_store_known(%s[0], %d) != 0\n", ind, cell, ind, cell, cell, (cast: (int) l2_nsf_val[sx])) < 0
                return: 1
            if: live = 0 && c.fprintf(l2_out, "%s    return: 1\n", ind) < 0
                return: 1
            if: live != 0 && l2_emit_invariant(ind, "a method's named Structure field refused its value") != 0
                return: 1
            sn: sn + 1
        if: l2_nsf_owner[sx] = nest && l2_nsf_kind[sx] = 6
            if: c.fprintf(l2_out, "%s%s: lmx_arena_ref_cell(%s, %uU)\n%sif: %s = 0\n", ind, cell, mine, (cast: (unsigned) sn), ind, cell) < 0
                return: 1
            if: live = 0 && c.fprintf(l2_out, "%s    return: 1\n", ind) < 0
                return: 1
            if: live != 0 && l2_emit_invariant(ind, "a method's named Structure has no field cell") != 0
                return: 1
            if: c.fprintf(l2_out, "%s%s[0]: (cast: (@: void) lmx_array_ref_new_owned(c.LMX_TYPE_ARRAY_OF_DESC, 0U, l2_program_arena))\n%sif: %s[0] = 0\n", ind, cell, ind, cell) < 0
                return: 1
            if: live = 0 && c.fprintf(l2_out, "%s    return: 1\n", ind) < 0
                return: 1
            if: live != 0 && l2_emit_invariant(ind, "a method's named Structure field did not allocate") != 0
                return: 1
            sn: sn + 1
        if: l2_nsf_owner[sx] = nest && l2_nsf_kind[sx] = 5 && l2_nsf_ref[sx] != 0 && l2_nsf_ref[sx] != 1
            return: 1
        if: l2_nsf_owner[sx] = nest && l2_nsf_kind[sx] = 5 && l2_nsf_ref[sx] = 0
            if: c.fprintf(l2_out, "%s%s: lmx_arena_ref_cell(%s, %uU)\n%sif: %s = 0\n", ind, cell, mine, (cast: (unsigned) sn), ind, cell) < 0
                return: 1
            if: live = 0 && c.fprintf(l2_out, "%s    return: 1\n", ind) < 0
                return: 1
            if: live != 0 && l2_emit_invariant(ind, "a method's named Structure has no field cell") != 0
                return: 1
            if: c.fprintf(l2_out, "%s%s[0]: (cast: (@: void) lmx_array_new_owned(c.LMX_TYPE_ARRAY_OF_INT, %zuU, l2_program_arena))\n%sif: %s[0] = 0\n", ind, cell, l2_nsf_val[sx], ind, cell) < 0
                return: 1
            if: live = 0 && c.fprintf(l2_out, "%s    return: 1\n", ind) < 0
                return: 1
            if: live != 0 && l2_emit_invariant(ind, "a method's named Structure field did not allocate") != 0
                return: 1
            sn: sn + 1
        if: l2_nsf_owner[sx] = nest && l2_nsf_kind[sx] = 5 && l2_nsf_ref[sx] = 1
            if: c.fprintf(l2_out, "%s%s: lmx_arena_ref_cell(%s, %uU)\n%sif: %s = 0\n", ind, cell, mine, (cast: (unsigned) sn), ind, cell) < 0
                return: 1
            if: live = 0 && c.fprintf(l2_out, "%s    return: 1\n", ind) < 0
                return: 1
            if: live != 0 && l2_emit_invariant(ind, "a method's named Structure has no field cell") != 0
                return: 1
            if: c.fprintf(l2_out, "%s%s[0]: (cast: (@: void) lmx_array_new_owned(c.LMX_TYPE_ARRAY_OF_CHAR, %zuU, l2_program_arena))\n%sif: %s[0] = 0\n", ind, cell, l2_nsf_val[sx], ind, cell) < 0
                return: 1
            if: live = 0 && c.fprintf(l2_out, "%s    return: 1\n", ind) < 0
                return: 1
            if: live != 0 && l2_emit_invariant(ind, "a method's named Structure field did not allocate") != 0
                return: 1
            sn: sn + 1
        if: l2_nsf_owner[sx] = nest && (l2_nsf_kind[sx] = 10 || l2_nsf_kind[sx] = 11)
            if: l2_ptr_cell_type(l2_nsf_ref[sx], pty) != 0
                return: 1
            if: c.fprintf(l2_out, "%s%s: lmx_arena_ref_cell(%s, %uU)\n%sif: %s = 0\n", ind, cell, mine, (cast: (unsigned) sn), ind, cell) < 0
                return: 1
            if: live = 0 && c.fprintf(l2_out, "%s    return: 1\n", ind) < 0
                return: 1
            if: live != 0 && l2_emit_invariant(ind, "a method's named Structure has no field cell") != 0
                return: 1
            if: c.fprintf(l2_out, "%s%s[0]: lmx_pointer_new_owned(%s, l2_program_arena)\n%sif: %s[0] = 0\n", ind, cell, pty, ind, cell) < 0
                return: 1
            if: live = 0 && c.fprintf(l2_out, "%s    return: 1\n", ind) < 0
                return: 1
            if: live != 0 && l2_emit_invariant(ind, "a method's named Structure field did not allocate") != 0
                return: 1
            sn: sn + 1
        sx: sx + 1
    ---
    if: live = 0 && l2_emit_ns_names(nest, mine, ind, "return: 1", 0) != 0
        return: 1
    if: live != 0 && l2_emit_ns_names(nest, mine, ind, "c.abort()", "return: 0") != 0
        return: 1
    if: c.fprintf(l2_out, "%sif: lmx_arena_ref_store(%s, %uU, (cast: (@: void) %s)) != 0\n", ind, parent, (cast: (unsigned) slot), mine) < 0
        return: 1
    if: live = 0 && c.fprintf(l2_out, "%s    return: 1\n", ind) < 0
        return: 1
    if: live != 0 && l2_emit_invariant(ind, "a method's named Structure field refused its value") != 0
        return: 1
return: 0

# The run-time half of a method's own named Structure (l2_local_ns_declare): the statement builds its Structure -- a
# child of the activation's Structure, `self`, its lexical parent -- with a cell per number field holding its literal,
# as the unit builds a named Structure's (l2_emit_ns_num_cell), and binds it at the field's place, its own slot
# (l2_own_store).  Each execution builds a new one: a structural expression constructs its value when execution
# reaches it (book §9).

# A reached constructor knows its fresh value's layout. Publish that evidence
# in the existing correspondence table, before binding the value. This does
# not copy a source record, and later reads consult the current held value.
fn: l2_emit_constructed_layout (int: model; const: @(char value); const: @(char req); const: @(char ind)) int
    []: char token 128
    if: l2_layout_token(model, token) != 0
        return: 1
    if: c.fprintf(l2_out, "%sif: lmx_implements_register_map(l2_program_arena, %s, %s, 0, 0U, %s) != c.LMX_IMPLEMENTS_YES\n", ind, value, req, token) < 0
        return: 1
return: l2_emit_invariant(ind, "a constructed Structure did not record its layout")

# The control bodies of a method's own named Structure's procedure pr, built with S (temporary l2_t<t>) at its statement
# (slice 2c-3), as the unit builds a procedure's (R9): in preorder, each a child of S or of its enclosing body at its
# slot (l2_for_uchild), opened to its width (l2_for_nkid), with a cell for every field declared in it (l2_own_fid) --
# the Structures the procedure's native code finds in its occurrence (l2_h<k>).  Each temporary is l2_lb<t>_<k>.

# `T: []: []: x` (author, Q15, 2026-09-23): `[]:` applied twice makes two levels
# of independent one-dimensional Arrays -- the outer one holds references to
# the descriptors of the inner T Arrays, each with its own length.  It is not
# `T: [][]: x`, the one rectangular Array.  T is int or char, as for `[]:`.
# 0 = the shape (T in out_ty: 0 int, 1 char), 1 = not it.
fn: l2_ns_arrarr_field (const: @(LmP0Node fld); @: int out_ty; @@: LmP0Text out_name) int
    @: LmP0Field g
    @: LmP0Node outer
    @: LmP0Node inner
    if: fld = 0 || fld\kind != c.LM_P0_NODE_FRAME || fld\as = 0 || fld\as\frame = 0 || fld\as\frame\body = 0 || out_ty = 0 || out_name = 0
        return: 1
    if: l2_frame_head(fld, "int")
        \out_ty: 0
    else:
        if: l2_frame_head(fld, "char") = 0
            return: 1
        \out_ty: 1
    ---
    if: fld\as\frame\trailer != 0 || l2_count_active(fld\as\frame\body) != 1
        return: 1
    outer: l2_next_active(fld\as\frame\body\first_field)\value
    if: outer = 0 || outer\kind != c.LM_P0_NODE_FRAME || l2_frame_head(outer, "[]") = 0 || outer\as\frame\trailer != 0 || outer\as\frame\body = 0 || l2_count_active(outer\as\frame\body) != 1
        return: 1
    inner: l2_next_active(outer\as\frame\body\first_field)\value
    if: inner = 0 || inner\kind != c.LM_P0_NODE_FRAME || l2_frame_head(inner, "[]") = 0 || inner\as\frame\trailer != 0 || inner\as\frame\body = 0 || l2_count_active(inner\as\frame\body) != 1
        return: 1
    g: l2_next_active(inner\as\frame\body\first_field)
    if: g = 0 || g\value = 0 || g\value\kind != c.LM_P0_NODE_ATOM || l2_bind_spelling(g\value\as\atom) = 0
        return: 1
    \out_name: (cast: (@: LmP0Text) g\value\as\atom)
return: 0

# K03 NS-ROLES-2 (Codex K03-NS-ROLES-2-20261007-20; docs/LMX_semantics.en.md#resolved-head-consumption,
# #declaration-visibility): whether name t is known at the current place in named Structure me's body, read from the
# source while the body is taken, as the unit's items are (l2_head_absent): a field of me or of a Structure enclosing
# it declared above that place, the name of me or of one enclosing it (its body is below its own place), and, past
# the top Structure's own item, what the unit declares above that item and, for a method's own named Structure, what
# the method sees there (l2_head_resolve).
fn: l2_ns_site_known (const: @(LmP0Text t); int: me) int
    int: x me
    int: top me
    int: j
    if: t = 0 || me < 0
        return: 0
    while: x >= 0
        if: l2_ns_name[x] != 0 && l2_text_same(l2_ns_name[x], t) != 0
            return: 1
        j: l2_ns_first[x]
        while: j < l2_nsf_n
            if: l2_nsf_owner[j] = x && l2_nsf_fname[j] != 0 && l2_text_same(l2_nsf_fname[j], t) != 0
                return: 1
            j: j + 1
        ---
        top: x
        x: l2_ns_parent[x]
    ---
    if: l2_head_absent(t, l2_ns_at[top]) = 0
        return: 1
return: (cast: (int) (l2_ns_take_mi >= 0 && l2_head_resolve(l2_ns_take_mi, t, 0, 0) != 0))

# K03 NS-ROLES-2: what the one atom a of the item `b: a`, b absent, names at the current place in named Structure me's
# body, read as l2_ns_site_known reads that place -- the binding's source reading, as l2_unit_ref_bind is the root's:
#  >= 0  a named Structure visible there: me or a Structure enclosing it, or one the unit defines above the top
#        Structure's item, a qualified branch's root included (visible from its place on) -- its entry;
#   -2   a callable: a method (visible both ways) or a callable field above;
#   -3   a value that holds a Structure: a Structure nested above (its own field there), a reference field above, a
#        Structure value of the unit above, what the host method of a method's own named Structure binds;
#   -1   nothing that binds -- a datum, an unknown name: the definition route.
fn: l2_ns_bind_target (const: @(LmP0Text a); int: me) int
    int: x me
    int: top me
    int: j
    int: k
    if: a = 0 || me < 0 || l2_ident(a) = 0 || l2_head_word(a) != 0
        return: -1
    while: x >= 0
        if: l2_ns_name[x] != 0 && l2_text_same(l2_ns_name[x], a) != 0
            return: x
        j: l2_ns_first[x]
        while: j < l2_nsf_n
            if: l2_nsf_owner[j] = x && l2_nsf_fname[j] != 0 && l2_text_same(l2_nsf_fname[j], a) != 0
                if: l2_nsf_kind[j] = 4
                    return: -2
                if: l2_nsf_kind[j] = 2 || ((l2_nsf_kind[j] = 10 || l2_nsf_kind[j] = 11) && l2_nsf_name[j] != 0)
                    return: -3
                return: -1
            ---
            j: j + 1
        ---
        top: x
        x: l2_ns_parent[x]
    ---
    if: l2_ns_take_mi >= 0
        if: l2_ref_tail_kind(l2_ns_take_mi, a, 0, 0) = 0
            return: -1
        return: -3
    if: l2_unit_names_method(a) != 0
        return: -2
    # A named Structure of the unit above the top Structure's item, a qualified branch's root included: the unit's
    # items are taken in source order, so the ones registered already are exactly those above it -- an ordinary named
    # Structure is visible from its place on.
    k: 0
    while: k < l2_ns_n
        if: l2_ns_parent[k] < 0 && l2_ns_local[k] < 0 && l2_ns_name[k] != 0 && l2_text_same(l2_ns_name[k], a) != 0
            return: k
        k: k + 1
    ---
    if: l2_unit_value_above(a, l2_ns_at[top]) != 0
        return: -3
return: -1

# K03 NS-ROLES-2: whether item node of named Structure me's body is the binding `b: A` -- its head resolving to
# nothing at its place (l2_ns_site_known), its tail one atom (l2_ref_tail_atom) that binds there
# (l2_ns_bind_target): a named Structure, or a callable or a value, which a named body does not hold yet (said by
# l2_take_ns_body at A).
fn: l2_ns_bind_item (const: @(LmP0Node node); int: me) int
    @: LmP0Text a
    if: node = 0 || me < 0 || node\kind != c.LM_P0_NODE_FRAME || node\as = 0 || node\as\frame = 0 || node\as\frame\head = 0 || l2_ident(node\as\frame\head) = 0
        return: 0
    a: l2_ref_tail_atom(node\as\frame)
    if: a = 0 || l2_ns_site_known(node\as\frame\head, me) != 0
        return: 0
return: (cast: (int) (l2_ns_bind_target(a, me) != -1))

# Q57 (the author; K03): whether node, an item of named Structure me's body, defines a NESTED named Structure: a
# frame whose head resolves to nothing at its place (l2_ns_site_known) with a retained tail -- the general definition
# route of the root and of a method (l2_unit_role 5, l2_local_absent_def): its written content, one atom or a literal
# included (K03 NS-ROLES-2, docs/LMX_semantics.en.md#resolved-head-consumption: "Unknown A in A: b declares Structure
# A", `b: zz`, `b: 7`), never inferred storage.  Merge's construction and the binding `b: A` (l2_ns_bind_item) are
# no definitions.  `C: makeA()` with both unknown: C holds an empty named makeA.  Parentheses, emptiness and the
# number of items do not tell a definition from a call (Q58): the head's resolution does.
fn: l2_ns_nested_def (const: @(LmP0Node node); int: me) int
    if: node = 0 || me < 0 || node\kind != c.LM_P0_NODE_FRAME || node\as = 0 || node\as\frame = 0 || node\as\frame\head = 0 || l2_ident(node\as\frame\head) = 0
        return: 0
    if: l2_ns_site_known(node\as\frame\head, me) != 0 || l2_retained_body(node\as\frame) = 0 || l2_merge_construction(node\as\frame) != 0
        return: 0
return: (cast: (int) (l2_ns_bind_item(node, me) = 0))

# A written atom kept as the body of an absent-head definition. A literal is structural
# content. An identifier that is not itself a call (a method, a named Structure, a C door) is the same
# content, whether or not some other binding spells it.  A word of the language (K03 S5: the defined set,
# l2_head_word) is its application, an item of the body under its contract, never content; those calls
# stay statements. Method-local bodies (l2_atom_hold) are unchanged.
fn: l2_retained_atom (const: @(LmP0Node node)) int
    @: LmP0Text t
    if: l2_atom_hold != 0 || node = 0 || node\kind != c.LM_P0_NODE_ATOM || node\as = 0 || node\as\atom = 0
        return: 0
    t: node\as\atom
    if: l2_head_word(t) != 0
        return: 0
    if: l2_num(t) != 0 || l2_quoted(t) != 0 || l2_char_literal(t) >= 0
        return: 1
    if: l2_ident(t) = 0
        return: 0
    if: l2_site_method(l2_here_mi, t) >= 0 || l2_unit_names_method(t) != 0 || l2_ns_find(t) >= 0 || l2_is_known(t) != 0
        return: 0
return: 1

# Write t as one C string literal. The bytes are the source atom, not a resolved value.
fn: l2_emit_cstr (const: @(LmP0Text t)) int
    size_t: i 0U
    int: b
    if: c.fputc(34, l2_out) = c.EOF
        return: 1
    if: t = 0 || t\data = 0
        if: c.fputc(34, l2_out) = c.EOF
            return: 1
        return: 0
    while: i < t\length
        b: (cast: (int) t\data[i])
        if: b < 0
            b: b + 256
        if: b = 34 || b = 92
            if: c.fprintf(l2_out, "\\%c", b) < 0
                return: 1
            ---
        if: b != 34 && b != 92 && (b < 32 || b > 126)
            if: c.fprintf(l2_out, "\\%03o", b) < 0
                return: 1
            ---
        if: b != 34 && b != 92 && b >= 32 && b <= 126
            if: c.fprintf(l2_out, "%c", b) < 0
                return: 1
            ---
        i: i + 1U
    ---
    if: c.fputc(34, l2_out) = c.EOF
        return: 1
return: 0

# Kind 12 uses the common typed/symbolic atom producer, not a char* spelling.
fn: l2_emit_atom_slot (int: k; int: oi; const: @(LmP0Text t)) int
    []: char profile 48
    c.sprintf(profile, "0")
    if: l2_ns_eternal[k] >= 0 && c.sprintf(profile, "l2_eprofile%u", (cast: (unsigned) l2_ns_eternal[k])) < 0
        return: 1
    if: c.fprintf(l2_out, "        l2_entry_slot: lmx_arena_ref_cell(l2_nsp[%d], %uU)\n        if: l2_entry_slot = 0\n            return: 1\n", k, (cast: (unsigned) oi)) < 0
        return: 1
return: l2_emit_source_atom(t, "l2_entry_slot[0]", "        ", profile, "return: 1", 0)

# The construction-time child of a placed method-local atom definition: the Structure
# occupies the own slot. Each written atom uses the common physical producer.
fn: l2_emit_method_atom_at (int: oi; const: @(char holder); size_t: child) int
    int: mi
    int: ni
    int: fx
    int: n 0
    int: j 0
    mi: l2_own_mi[oi]
    ni: l2_own_nsty_get(oi)
    if: mi < 0 || mi >= l2_m_n || ni < 0 || ni >= l2_ns_n || holder = 0
        return: 1
    fx: 0
    while: fx < l2_nsf_n
        if: l2_nsf_owner[fx] = ni && l2_nsf_kind[fx] = 12
            n: n + 1
        fx: fx + 1
    ---
    # An expression span is one child. The operator is stored after walk roles exist.
    if: n = 0 && l2_own_decl[oi] != 0 && l2_own_decl[oi]\as != 0 && l2_expr_only_tail(l2_own_decl[oi]\as\frame) != 0
        n: 1
    if: c.fprintf(l2_out, "        l2_entry_leaf: %s\n        if: l2_entry_leaf = 0\n            return: 1\n        l2_fkid: lmx_struct_new_owned(l2_entry_leaf, l2_program_arena)\n        if: l2_fkid = 0\n            return: 1\n", holder) < 0
        return: 1
    if: l2_emit_source_name("l2_fkid", l2_own_name[oi], "        ", "return: 1", 0) != 0
        return: 1
    if: n > 0 && c.fprintf(l2_out, "        if: lmx_arena_refs_open_owned(l2_program_arena, l2_fkid, %dU) != 0\n            return: 1\n", n) < 0
        return: 1
    fx: 0
    while: fx < l2_nsf_n
        if: l2_nsf_owner[fx] = ni && l2_nsf_kind[fx] = 12
            if: c.fprintf(l2_out, "        l2_entry_slot: lmx_arena_ref_cell(l2_fkid, %uU)\n        if: l2_entry_slot = 0\n            return: 1\n", (cast: (unsigned) j)) < 0
                return: 1
            if: l2_emit_source_atom(l2_nsf_name[fx], "l2_entry_slot[0]", "        ", "0", "return: 1", 0) != 0
                return: 1
            j: j + 1
        fx: fx + 1
    ---
    if: c.fprintf(l2_out, "        if: lmx_arena_ref_store(l2_entry_leaf, %zuU, (cast: (@: void) l2_fkid)) != 0\n            return: 1\n", child) < 0
        return: 1
return: 0

fn: l2_emit_method_atom (int: oi) int
    @: L2GraphField field l2_graph_field(oi)
    if: field = 0
        return: 1
    if: fputs("        l2_pst: ", l2_out) < 0 || l2_emit_graph_build_place(field\holder, l2_own_mi[oi]) != 0 || fputs("\n", l2_out) < 0
        return: 1
return: l2_emit_method_atom_at(oi, "l2_pst", field\child)

# The supported namespace constructor fills its actual owning source slot.
# All callers share this producer, including projected callable occurrences.
fn: l2_emit_method_fields_at (int: oi; const: @(char holder); size_t: child) int
    int: mi
    int: ni
    int: fx
    int: n 0
    int: j 0
    const: @(char newf) 0
    const: @(char store) 0
    []: char lit 48
    mi: l2_own_mi[oi]
    ni: l2_own_nsty_get(oi)
    if: mi < 0 || mi >= l2_m_n || ni < 0 || ni >= l2_ns_n || holder = 0
        return: 1
    fx: 0
    while: fx < l2_nsf_n
        if: l2_nsf_owner[fx] = ni && (l2_nsf_kind[fx] = 0 || l2_nsf_kind[fx] = 1 || l2_nsf_kind[fx] = 2 || l2_nsf_kind[fx] = 3 || l2_nsf_kind[fx] = 4 || l2_nsf_kind[fx] = 5 || l2_nsf_kind[fx] = 6 || l2_nsf_kind[fx] = 7 || l2_nsf_kind[fx] = 8 || l2_nsf_kind[fx] = 9 || l2_nsf_kind[fx] = 10 || l2_nsf_kind[fx] = 11)
            n: n + 1
        fx: fx + 1
    ---
    if: c.fprintf(l2_out, "        l2_entry_leaf: %s\n        if: l2_entry_leaf = 0\n            return: 1\n        l2_fkid: lmx_struct_new_owned(l2_entry_leaf, l2_program_arena)\n        if: l2_fkid = 0\n            return: 1\n", holder) < 0
        return: 1
    if: l2_emit_source_name("l2_fkid", l2_own_name[oi], "        ", "return: 1", 0) != 0
        return: 1
    if: n > 0 && c.fprintf(l2_out, "        if: lmx_arena_refs_open_owned(l2_program_arena, l2_fkid, %dU) != 0\n            return: 1\n", n) < 0
        return: 1
    fx: 0
    while: fx < l2_nsf_n
        newf: 0
        store: 0
        if: l2_nsf_owner[fx] = ni && l2_nsf_kind[fx] = 1
            if: c.fprintf(l2_out, "        l2_entry_slot: lmx_arena_ref_cell(l2_fkid, %uU)\n        if: l2_entry_slot = 0\n            return: 1\n        l2_entry_slot[0]: lmx_char_new_owned(l2_program_arena)\n        if: l2_entry_slot[0] = 0 || lmx_char_store_known(l2_entry_slot[0], %d) != 0\n            return: 1\n", (cast: (unsigned) j), (cast: (int) l2_nsf_val[fx])) < 0
                return: 1
            j: j + 1
        if: l2_nsf_owner[fx] = ni && l2_nsf_kind[fx] = 0
            newf: "lmx_size_new_owned"
            store: "lmx_size_store_known"
            if: c.sprintf(lit, "%zuU", l2_nsf_val[fx]) < 0
                return: 1
            ---
        if: l2_nsf_owner[fx] = ni && l2_nsf_kind[fx] = 7
            newf: "lmx_int_new_owned"
            store: "lmx_int_store_known"
            if: c.sprintf(lit, "%d", (cast: (int) l2_nsf_val[fx])) < 0
                return: 1
            ---
        if: l2_nsf_owner[fx] = ni && l2_nsf_kind[fx] = 8
            newf: "lmx_unsigned_new_owned"
            store: "lmx_unsigned_store_known"
            if: c.sprintf(lit, "%uU", (cast: (unsigned) l2_nsf_val[fx])) < 0
                return: 1
            ---
        if: l2_nsf_owner[fx] = ni && l2_nsf_kind[fx] = 9
            newf: "lmx_ulong_new_owned"
            store: "lmx_ulong_store_known"
            if: c.sprintf(lit, "%zuU", l2_nsf_val[fx]) < 0
                return: 1
            ---
        if: l2_nsf_owner[fx] = ni && (l2_nsf_kind[fx] = 10 || l2_nsf_kind[fx] = 11)
            if: l2_ptr_cell_type(l2_nsf_ref[fx], lit) != 0
                return: 1
            if: c.fprintf(l2_out, "        l2_entry_slot: lmx_arena_ref_cell(l2_fkid, %uU)\n        if: l2_entry_slot = 0\n            return: 1\n        l2_entry_slot[0]: lmx_pointer_new_owned(%s, l2_program_arena)\n        if: l2_entry_slot[0] = 0\n            return: 1\n", (cast: (unsigned) j), lit) < 0
                return: 1
            j: j + 1
        if: l2_nsf_owner[fx] = ni && l2_nsf_kind[fx] = 6
            if: c.fprintf(l2_out, "        l2_entry_slot: lmx_arena_ref_cell(l2_fkid, %uU)\n        if: l2_entry_slot = 0\n            return: 1\n        l2_entry_slot[0]: (cast: (@: void) lmx_array_ref_new_owned(c.LMX_TYPE_ARRAY_OF_DESC, 0U, l2_program_arena))\n        if: l2_entry_slot[0] = 0\n            return: 1\n", (cast: (unsigned) j)) < 0
                return: 1
            j: j + 1
        if: l2_nsf_owner[fx] = ni && l2_nsf_kind[fx] = 5 && l2_nsf_ref[fx] = 0
            if: c.fprintf(l2_out, "        l2_entry_slot: lmx_arena_ref_cell(l2_fkid, %uU)\n        if: l2_entry_slot = 0\n            return: 1\n        l2_entry_slot[0]: (cast: (@: void) lmx_array_new_owned(c.LMX_TYPE_ARRAY_OF_INT, %zuU, l2_program_arena))\n        if: l2_entry_slot[0] = 0\n            return: 1\n", (cast: (unsigned) j), l2_nsf_val[fx]) < 0
                return: 1
            j: j + 1
        if: l2_nsf_owner[fx] = ni && l2_nsf_kind[fx] = 5 && l2_nsf_ref[fx] = 1
            if: c.fprintf(l2_out, "        l2_entry_slot: lmx_arena_ref_cell(l2_fkid, %uU)\n        if: l2_entry_slot = 0\n            return: 1\n        l2_entry_slot[0]: (cast: (@: void) lmx_array_new_owned(c.LMX_TYPE_ARRAY_OF_CHAR, %zuU, l2_program_arena))\n        if: l2_entry_slot[0] = 0\n            return: 1\n", (cast: (unsigned) j), l2_nsf_val[fx]) < 0
                return: 1
            j: j + 1
        # A method's named Structure holds no binding (l2_take_ns_body says so at its place).
        if: l2_nsf_owner[fx] = ni && l2_nsf_kind[fx] = 10 && l2_nsf_val[fx] != 0U
            return: l2_error(l2_src, l2_nsf_source[fx], "internal: a method's named Structure holds a reference binding")
        # Referents already exist in this construction phase. Keep their fields
        # at the same ordinal as every other field; do not patch a flat host slot.
        if: l2_nsf_owner[fx] = ni && l2_nsf_kind[fx] = 3
            if: l2_emit_ns_ref(l2_nsf_ref[fx], "l2_fkid", j, "        ", 0) != 0
                return: 1
            j: j + 1
        if: l2_nsf_owner[fx] = ni && l2_nsf_kind[fx] = 4
            if: c.fprintf(l2_out, "        if: lmx_arena_ref_store(l2_fkid, %uU, (cast: (@: void) lmx_arena_ref_struct(l2_entry_unit, %uU))) != 0\n            return: 1\n", (cast: (unsigned) j), (cast: (unsigned) l2_occ_slot(l2_nsf_ref[fx]))) < 0
                return: 1
            j: j + 1
        if: l2_nsf_owner[fx] = ni && l2_nsf_kind[fx] = 2
            if: l2_emit_one_nest(l2_nsf_ref[fx], "l2_fkid", j, "l2_entry_slot", "        ", 0) != 0
                return: 1
            j: j + 1
        if: newf != 0 && c.fprintf(l2_out, "        l2_entry_slot: lmx_arena_ref_cell(l2_fkid, %uU)\n        if: l2_entry_slot = 0\n            return: 1\n        l2_entry_slot[0]: %s(l2_program_arena)\n        if: l2_entry_slot[0] = 0\n            return: 1\n        if: %s(l2_entry_slot[0], %s) != 0\n            return: 1\n", (cast: (unsigned) j), newf, store, lit) < 0
            return: 1
        if: newf != 0
            j: j + 1
        fx: fx + 1
    ---
    if: l2_emit_ns_names(ni, "l2_fkid", "        ", "return: 1", 0) != 0
        return: 1
    if: c.fprintf(l2_out, "        if: lmx_arena_ref_store(%s, %zuU, (cast: (@: void) l2_fkid)) != 0\n            return: 1\n", holder, child) < 0
        return: 1
return: 0

fn: l2_emit_method_fields (int: oi) int
    @: L2GraphField field l2_graph_field(oi)
    if: field = 0
        return: 1
    if: fputs("        l2_pst: ", l2_out) < 0 || l2_emit_graph_build_place(field\holder, l2_own_mi[oi]) != 0 || fputs("\n", l2_out) < 0
        return: 1
return: l2_emit_method_fields_at(oi, "l2_pst", field\child)

# steps/named-struct-exec.md, slice 1: whether node, a Frame item of named Structure me's body, is a
# statement -- `x: value` where x names a field me declared above (a declaration's head is a type; an
# assignment's is the field's own name).  An item that is no Frame -- a bare `return` -- is a statement at
# the caller (l2_take_ns_body).
fn: l2_ns_body_stmt (const: @(LmP0Node node); int: me) int
    int: j
    if: node = 0 || me < 0
        return: 0
    # §12 (Q45 and its additions: a named Structure is a procedure, its body a method's body): a receiver's
    # call is a statement of the body, not a field -- a method of the unit, wherever it stands (methods are
    # visible both ways, l2_unit_names_method), or a word of the language: `return`, `if`, `catch: e` declare
    # no field (l2_ns_decl_first, K03 S5).  A `return: n` is one of them: the check says what it
    # says of every callable that returns nothing, in any place of the body.
    if: node\kind = c.LM_P0_NODE_FRAME && node\as != 0 && node\as\frame != 0 && node\as\frame\head != 0
        if: l2_find_method(node\as\frame\head) >= 0 || l2_unit_names_method(node\as\frame\head) != 0
            return: 1
        # Only a declaration is a field -- the typed shapes l2_take_ns_body takes (l2_ns_decl_first), a nested
        # definition, a binding; an item of any other shape -- `cells[1]: …`, `x\f: …`, `g: 5` with g declared
        # above, `sendMessage: exit(…)`, a known head's application `Model: m` -- is a statement.
        # Q57: a nested head that resolves to nothing, with its tail retained, is a nested named Structure -- a
        # FIELD of me (kind 2), read by l2_take_ns_body -- not a statement of the body.
        if: l2_ns_nested_def(node, me) != 0
            return: 0
        # K03 NS-ROLES-2: the binding `b: A`, b absent, declares b -- a field of me (l2_ns_bind_item).
        if: l2_ns_bind_item(node, me) != 0
            return: 0
        # K03 RECEIVE-OUTPUT: a number or char declaration with a computed candidate is the body's statement, its
        # output no field of me (l2_ns_computed_decl).
        if: l2_ns_decl_first(node) = 0 || l2_ns_computed_decl(node) != 0
            return: 1
        ---
    if: node\kind != c.LM_P0_NODE_FRAME || node\as = 0 || node\as\frame = 0 || node\as\frame\head = 0 || l2_ident(node\as\frame\head) = 0
        return: 0
    j: l2_ns_first[me]
    while: j < l2_nsf_n
        if: l2_nsf_owner[j] = me && l2_nsf_fname[j] != 0 && l2_text_same(l2_nsf_fname[j], node\as\frame\head) != 0
            return: 1
        j: j + 1
    ---
return: 0

# One Structure body: registers the entry FIRST so its index precedes every nested entry, then reads the items in
# source order -- fields (numbers and chars with their literals, arrays, inline and defined nested Structures built in
# place with this entry as their node, callable fields, typed references `@: T x`, bindings `b: A` holding a named
# Structure visible at their place), retained content, statements.
fn: l2_take_ns_body (const: @(LmP0Text name); int: parent; const: @(LmP0Structure body); const: @(LmP0Node at); const: @(char path)) int
    @: LmP0Field f
    int: aty 0
    size_t: acount 0U
    @: LmP0Text fname 0
    @: LmP0Field g
    @: LmP0Field h
    @: LmP0Node fld
    int: me
    int: sub_ix
    int: ref_ix
    int: count 0
    int: cval
    int: rdepth
    int: rty
    int: rref
    size_t: bits 0U
    int: st 0
    int: span 0
    if: body = 0
        return: l2_error(path, at, "a named Structure needs at least one field")
    me: l2_ns_push(name, parent, at)
    if: me < 0
        return: l2_error(path, at, "out of memory")
    l2_ns_first[me]: l2_nsf_n
    f: l2_next_active(body\first_field)
    # A named Structure with no fields is the empty Structure type (book §9).
    # `E: ()` / `end: E` is one empty Structure field; refs_open refuses a
    # zero count, so the shape stays a node of length 0.
    if: f = 0 || (l2_next_active(f\next) = 0 && l2_empty_struct(f\value) != 0)
        l2_ns_count[me]: 0
        return: 0
    while: f != 0
        fld: f\value
        # steps/named-struct-exec.md, slice 1: a statement of the body (Q19.2 = 2, "тело целиком, как у
        # метода") -- an assignment to a field declared above, or a bare `return` -- is no field.
        # Construction does not run it (book :928 computes the initializers only); slice 2 runs the
        # whole body when the Structure is executed.
        # Q19.1: a named Structure's `return` is bare ("может быть только "return" без аргументов").  It
        # had a refusal of its own here, at the top of the body only (REVIEW 0c601ea); §12: `return: n` is
        # a statement of the body, refused by the check as in every callable that returns nothing.
        # §12: an item that is no Frame -- a bare atom, a block -- is a statement of the body too.
        # An absent-head definition keeps a written atom as content (kind 12), not as a
        # procedure dynamic. A call atom and `return` still take the statement path.
        # An expression span (`2 + 2`, including a transparent parenthesized form) is one
        # body node. Its atoms stay inside that expression; the procedure keeps the
        # operator tree. Splitting the literals out would put them in front of the operator.
        span: l2_discard_run(f)
        if: span > 1
            if: l2_ns_stmt[me] = 0
                l2_ns_stmt[me]: fld
            f: l2_skip_span(f, span)
            continue
        if: l2_retained_atom(fld) != 0
            if: l2_nsf_push(12, 0U, 0, me, fld) < 0
                return: l2_error(path, at, "out of memory")
            l2_nsf_name[l2_nsf_n - 1]: fld\as\atom
            count: count + 1
            f: l2_next_active(f\next)
            continue
        # K03 S5: a field-declaring word applied to nothing -- bare `size_t` as `size_t()` -- is that field's
        # declaration, and its contract says what it lacks, at the word.
        if: fld != 0 && l2_ns_field_word(l2_app_head(fld)) != 0 && l2_count_active(l2_app_actuals(fld)) = 0
            return: l2_ns_field_needs(path, fld, l2_app_head(fld))
        if: l2_ns_body_stmt(fld, me) != 0 || (fld != 0 && fld\kind != c.LM_P0_NODE_FRAME)
            if: l2_ns_stmt[me] = 0
                l2_ns_stmt[me]: fld
            f: l2_next_active(f\next)
            continue
        if: fld = 0 || fld\kind != c.LM_P0_NODE_FRAME || fld\as = 0 || fld\as\frame = 0 || fld\as\frame\body = 0
            return: l2_error(path, at, "unsupported named Structure field")
        g: l2_next_active(fld\as\frame\body\first_field)
        # K03 NS-ROLES-2 (Codex K03-NS-ROLES-2-20261007-20; docs/LMX_semantics.en.md#resolved-head-consumption): the
        # binding `b: A`, b absent, A a named Structure visible here, declares b as the root's and a method's binding
        # does (NS-ROLES-1): a typed reference cell -- the `@: A b` storage, kind 10 -- holding A itself, no copy, no
        # reparent.  The construction fills the cell with A's node (l2_emit_ns_refs; A stands above b, so it exists); the
        # procedure's statement assigns it again when it runs, as a pointer cell's initializer does.  A callable or a
        # value as A is not held by a named body yet, nor any binding in a method's named Structure: said at A.
        if: l2_ns_bind_item(fld, me) != 0
            rref: l2_ns_bind_target(l2_ref_tail_atom(fld\as\frame), me)
            if: l2_ns_take_mi >= 0
                return: l2_error(path, l2_ref_tail_node(fld), "a reference binding in a method's named Structure is not built yet")
            if: rref = -2
                return: l2_error(path, l2_ref_tail_node(fld), "a reference binding to a callable in a named Structure is not built yet")
            if: rref < 0
                return: l2_error(path, l2_ref_tail_node(fld), "a reference binding to a Structure value in a named Structure is not built yet")
            rty: l2_foreign_intern(l2_lmx_text(), 1, 0)
            if: rty < 100
                return: l2_error(path, at, "out of memory")
            if: l2_nsf_push(10, (cast: (size_t) (rref + 1)), rty, me, fld) < 0
                return: l2_error(path, at, "out of memory")
            if: l2_bind_admit((cast: (@: LmP0Text) fld\as\frame\head), l2_bind_at(fld, (cast: (@: LmP0Text) fld\as\frame\head)), path) != 0
                return: 1
            l2_nsf_fname[l2_nsf_n - 1]: (cast: (@: LmP0Text) fld\as\frame\head)
            l2_nsf_name[l2_nsf_n - 1]: l2_ns_name[rref]
            count: count + 1
            f: l2_next_active(f\next)
            continue
        # Kind 6: an Array of references to T Arrays.  The spelling has no count,
        # so construction makes the outer Array empty; its slot holds the outer
        # descriptor's reference, as a kind-5 slot does.
        if: l2_ns_arrarr_field(fld, @ aty, @ fname) = 0
            if: l2_nsf_push(6, 0U, aty, me, fld) < 0
                return: l2_error(path, at, "out of memory")
            if: l2_bind_admit(fname, l2_bind_at(fld, fname), path) != 0
                return: 1
            l2_nsf_fname[l2_nsf_n - 1]: fname
            count: count + 1
            f: l2_next_active(f\next)
            continue
        # Q57 (K03): a nested named Structure by general resolution (l2_ns_nested_def) -- the field the `(): name`
        # spelling below declares, kind 2, built in place with me as its node, its body read as any Structure's
        # (the empty one too).  The slot is reserved before recursing, so field order is source order.
        if: l2_ns_nested_def(fld, me) != 0
            if: l2_fn_close(fld\as\frame, fld\as\frame\head, 0) != 0
                return: l2_error(path, at, "end target does not match close target")
            if: l2_nsf_push(2, 0U, 0, me, fld) < 0
                return: l2_error(path, at, "out of memory")
            if: l2_bind_admit((cast: (@: LmP0Text) fld\as\frame\head), l2_bind_at(fld, (cast: (@: LmP0Text) fld\as\frame\head)), path) != 0
                return: 1
            l2_nsf_fname[l2_nsf_n - 1]: (cast: (@: LmP0Text) fld\as\frame\head)
            sub_ix: l2_nsf_n - 1
            ref_ix: l2_ns_n
            if: l2_take_ns_body((cast: (@: LmP0Text) fld\as\frame\head), me, fld\as\frame\body, fld, path) != 0
                return: 1
            l2_nsf_ref[sub_ix]: ref_ix
            count: count + 1
            f: l2_next_active(f\next)
            continue
        if: l2_frame_head(fld, "[]")
            # []: <int|char> <name> <count>, the same spelling an own array
            # uses. The record and its backing are two owned ranges; both
            # belong to the Structure that declares them.
            if: l2_count_active(fld\as\frame\body) != 3
                return: l2_error(path, at, "an array field needs a type, a name and a count")
            aty: 0 - 1
            if: l2_text_eq(g\value\as\atom, "int")
                aty: 0
            if: l2_text_eq(g\value\as\atom, "char")
                aty: 1
            if: aty < 0
                return: l2_error(path, at, "an array field element is int or char")
            g: l2_next_active(g\next)
            if: g\value = 0 || g\value\kind != c.LM_P0_NODE_ATOM || l2_bind_spelling(g\value\as\atom) = 0
                return: l2_error(path, at, "an array field needs a name")
            fname: (cast: (@: LmP0Text) g\value\as\atom)
            g: l2_next_active(g\next)
            if: g\value = 0 || g\value\kind != c.LM_P0_NODE_ATOM || l2_array_count_is(g\value\as\atom) = 0
                return: l2_error(path, at, "an array field needs a count")
            acount: l2_literal_value(g\value\as\atom)
            if: l2_nsf_push(5, acount, aty, me, fld) < 0
                return: l2_error(path, at, "out of memory")
            if: l2_bind_admit(fname, l2_bind_at(fld, fname), path) != 0
                return: 1
            l2_nsf_fname[l2_nsf_n - 1]: fname
            l2_ns_has_array: 1
        else:
            if: l2_frame_head(fld, "size_t")
                if: l2_count_active(fld\as\frame\body) != 2 || g\value = 0 || g\value\kind != c.LM_P0_NODE_ATOM || l2_bind_spelling(g\value\as\atom) = 0
                    return: l2_error(path, at, "a named Structure field needs a name")
                fname: (cast: (@: LmP0Text) g\value\as\atom)
                g: l2_next_active(g\next)
                if: g\value = 0 || g\value\kind != c.LM_P0_NODE_ATOM || l2_num(g\value\as\atom) = 0
                    return: l2_error(path, at, "a named Structure field needs a literal")
                if: l2_nsf_push(0, l2_literal_value(g\value\as\atom), 0 - 1, me, fld) < 0
                    return: l2_error(path, at, "out of memory")
                if: l2_bind_admit(fname, l2_bind_at(fld, fname), path) != 0
                    return: 1
                l2_nsf_fname[l2_nsf_n - 1]: fname
                ---
            else:
                # int/unsigned/ulong (D-15, steps/defects.md): the same
                # shape size_t just used, kinds 7/8/9 -- the own-field path
                # already accepts these numbers for a field-path leaf
                # (l2_field_path_check, l2_own_seg_scan), only the named-
                # Structure declaration side never registered them, so
                # `int: greeting 0` fell through every named shape here and
                # read as the catch-all `Name: field` Structure reference,
                # which then refused it for not having exactly one item.
                if: l2_frame_head(fld, "int")
                    if: l2_count_active(fld\as\frame\body) != 2 || g\value = 0 || g\value\kind != c.LM_P0_NODE_ATOM || l2_bind_spelling(g\value\as\atom) = 0
                        return: l2_error(path, at, "a named Structure field needs a name")
                    fname: (cast: (@: LmP0Text) g\value\as\atom)
                    g: l2_next_active(g\next)
                    bits: 0U
                    st: 0
                    if: g\value = 0 || g\value\kind != c.LM_P0_NODE_ATOM
                        return: l2_error(path, at, "a named Structure field needs a literal")
                    st: l2_int_literal_bits(g\value\as\atom, @ bits)
                    if: st = 2
                        return: l2_error(path, at, "literal not representable as int")
                    if: st != 1
                        return: l2_error(path, at, "a named Structure field needs a literal")
                    if: l2_nsf_push(7, bits, 0 - 1, me, fld) < 0
                        return: l2_error(path, at, "out of memory")
                    if: l2_bind_admit(fname, l2_bind_at(fld, fname), path) != 0
                        return: 1
                    l2_nsf_fname[l2_nsf_n - 1]: fname
                    ---
                else:
                    if: l2_frame_head(fld, "unsigned")
                        if: l2_count_active(fld\as\frame\body) != 2 || g\value = 0 || g\value\kind != c.LM_P0_NODE_ATOM || l2_bind_spelling(g\value\as\atom) = 0
                            return: l2_error(path, at, "a named Structure field needs a name")
                        fname: (cast: (@: LmP0Text) g\value\as\atom)
                        g: l2_next_active(g\next)
                        if: g\value = 0 || g\value\kind != c.LM_P0_NODE_ATOM || l2_num(g\value\as\atom) = 0
                            return: l2_error(path, at, "a named Structure field needs a literal")
                        if: l2_nsf_push(8, l2_literal_value(g\value\as\atom), 0 - 1, me, fld) < 0
                            return: l2_error(path, at, "out of memory")
                        if: l2_bind_admit(fname, l2_bind_at(fld, fname), path) != 0
                            return: 1
                        l2_nsf_fname[l2_nsf_n - 1]: fname
                        ---
                    else:
                        if: l2_frame_head(fld, "ulong")
                            if: l2_count_active(fld\as\frame\body) != 2 || g\value = 0 || g\value\kind != c.LM_P0_NODE_ATOM || l2_bind_spelling(g\value\as\atom) = 0
                                return: l2_error(path, at, "a named Structure field needs a name")
                            fname: (cast: (@: LmP0Text) g\value\as\atom)
                            g: l2_next_active(g\next)
                            if: g\value = 0 || g\value\kind != c.LM_P0_NODE_ATOM || l2_num(g\value\as\atom) = 0
                                return: l2_error(path, at, "a named Structure field needs a literal")
                            if: l2_nsf_push(9, l2_literal_value(g\value\as\atom), 0 - 1, me, fld) < 0
                                return: l2_error(path, at, "out of memory")
                            if: l2_bind_admit(fname, l2_bind_at(fld, fname), path) != 0
                                return: 1
                            l2_nsf_fname[l2_nsf_n - 1]: fname
                            ---
                        else:
                            if: l2_frame_head(fld, "char")
                                if: l2_count_active(fld\as\frame\body) != 2 || g\value = 0 || g\value\kind != c.LM_P0_NODE_ATOM || l2_bind_spelling(g\value\as\atom) = 0
                                    return: l2_error(path, at, "a named Structure field needs a name")
                                fname: (cast: (@: LmP0Text) g\value\as\atom)
                                g: l2_next_active(g\next)
                                cval: 0 - 1
                                if: g\value != 0 && g\value\kind = c.LM_P0_NODE_ATOM
                                    cval: l2_char_literal(g\value\as\atom)
                                if: cval < 0
                                    return: l2_error(path, at, "a char field needs a quoted single character")
                                if: l2_nsf_push(1, (cast: (size_t) cval), 0 - 1, me, fld) < 0
                                    return: l2_error(path, at, "out of memory")
                                if: l2_bind_admit(fname, l2_bind_at(fld, fname), path) != 0
                                    return: 1
                                l2_nsf_fname[l2_nsf_n - 1]: fname
                                l2_ns_has_char: 1
                            else:
                                if: l2_frame_head(fld, "fn")
                                    # A CALLABLE field: the field NAME is the method name and its
                                    # value is that method own Structure, whose slot 0 holds the
                                    # shared METHOD descriptor. Resolved with the reference fields
                                    # after the whole unit is read, since M may come later.
                                    if: l2_count_active(fld\as\frame\body) != 1 || g\value = 0 || g\value\kind != c.LM_P0_NODE_ATOM || l2_bind_spelling(g\value\as\atom) = 0
                                        return: l2_error(path, at, "a callable field needs a method name")
                                    if: l2_nsf_push(4, 0U, 0 - 1, me, fld) < 0
                                        return: l2_error(path, at, "out of memory")
                                    if: l2_bind_admit((cast: (@: LmP0Text) g\value\as\atom), l2_bind_at(fld, (cast: (@: LmP0Text) g\value\as\atom)), path) != 0
                                        return: 1
                                    l2_nsf_fname[l2_nsf_n - 1]: (cast: (@: LmP0Text) g\value\as\atom)
                                    l2_nsf_name[l2_nsf_n - 1]: (cast: (@: LmP0Text) g\value\as\atom)
                                else:
                                    if: l2_frame_head(fld, "()")
                                        # An inline nested Structure: (): name followed by its body block.
                                        if: l2_count_active(fld\as\frame\body) != 2 || g\value = 0 || g\value\kind != c.LM_P0_NODE_ATOM || l2_bind_spelling(g\value\as\atom) = 0
                                            return: l2_error(path, at, "a nested Structure needs a name and a body")
                                        if: l2_fn_close(fld\as\frame, g\value\as\atom, 0) != 0
                                            return: l2_error(path, at, "end target does not match close target")
                                        if: l2_nsf_push(2, 0U, 0, me, fld) < 0
                                            return: l2_error(path, at, "out of memory")
                                        if: l2_bind_admit((cast: (@: LmP0Text) g\value\as\atom), l2_bind_at(fld, (cast: (@: LmP0Text) g\value\as\atom)), path) != 0
                                            return: 1
                                        l2_nsf_fname[l2_nsf_n - 1]: (cast: (@: LmP0Text) g\value\as\atom)
                                        sub_ix: l2_nsf_n - 1
                                        # The field slot is reserved before recursing, so field order is
                                        # source order; the nested entry index is patched in after.
                                        ref_ix: l2_ns_n
                                        if: l2_take_ns_body((cast: (@: LmP0Text) g\value\as\atom), me, l2_next_active(g\next)\value\as\structure, fld, path) != 0
                                            return: 1
                                        l2_nsf_ref[sub_ix]: ref_ix
                                    else:
                                        rdepth: l2_address_depth(fld\as\frame\head)
                                        if: rdepth != 0
                                            # @: T name / @@: T name (author's rule: `@` of any
                                            # depth is a declaration receiver in L3, so a named
                                            # Structure -- itself L3 -- admits a reference field
                                            # the same way a formal or local does). The pointee
                                            # vocabulary is exactly a formal's/local's: the six
                                            # core words at this depth, the kernel types at depth
                                            # 1 (LmxMsg code 29, the mail sender reference; D-52 --
                                            # steps/defects.md -- covers the prototype-construction
                                            # gap this kind needed, FABLE-SONNET-SEND-REF-20260925-172
                                            # commit 1), or
                                            # another named Structure. Not a Message-only kind.
                                            if: l2_count_active(fld\as\frame\body) != 2 || g\value = 0 || g\value\kind != c.LM_P0_NODE_ATOM
                                                return: l2_error(path, at, "a reference field needs a type and a name")
                                            h: l2_next_active(g\next)
                                            if: h\value = 0 || h\value\kind != c.LM_P0_NODE_ATOM || l2_bind_spelling(h\value\as\atom) = 0
                                                return: l2_error(path, at, "a reference field needs a name")
                                            rty: 0 - 1
                                            if: l2_ptr_type_word(g\value\as\atom, rdepth, @ rty) != 0
                                                if: rdepth != 1 || l2_kernel_ptr_word(g\value\as\atom, @ rty) != 0
                                                    if: l2_resolve_type_atom(g\value\as\atom, rdepth, 0, @ rty) != 0
                                                        return: l2_error(path, g\value, "unknown type")
                                                    ---
                                                ---
                                            if: l2_nsf_push(9 + rdepth, 0U, rty, me, fld) < 0
                                                return: l2_error(path, at, "out of memory")
                                            if: l2_bind_admit((cast: (@: LmP0Text) h\value\as\atom), l2_bind_at(fld, (cast: (@: LmP0Text) h\value\as\atom)), path) != 0
                                                return: 1
                                            l2_nsf_fname[l2_nsf_n - 1]: (cast: (@: LmP0Text) h\value\as\atom)
                                            # `@: T q` with T a named Structure (D-76): the pointee's name, so a
                                            # path goes on through q (l2_ns_ref_pointee).
                                            if: rdepth = 1 && l2_ns_find(g\value\as\atom) >= 0
                                                l2_nsf_name[l2_nsf_n - 1]: (cast: (@: LmP0Text) g\value\as\atom)
                                            ---
                                        else:
                                            # K03 NS-ROLES-2: a field is one of the shapes above (l2_ns_body_stmt
                                            # admits no other): there is no `Name: field`.
                                            return: l2_error(path, fld, "internal: a named Structure's item is neither a field nor a statement")
                                        ---
                                    ---
                                ---
            ---
        count: count + 1
        f: l2_next_active(f\next)
    ---
    l2_ns_count[me]: count
return: 0

# An otherwise unrecognized unit-level frame with a matching end is an ordinary
# named Structure. Reserved heads are matched before this is ever reached, so a
# malformed reserved construct stays an error rather than becoming a
# declaration.
# The declaration entry that is the ROOT of one qualified branch, or -1.
fn: l2_ebr_root (int: k) int
    int: i 0
    while: i < l2_ns_n
        if: l2_ns_eternal[i] = k && l2_ns_parent[i] < 0
            return: i
        i: i + 1
    ---
return: 0 - 1

# Append one result-slot row. Kind -1 marks a slot with no source name.
fn: l2_mrs_push (int: res; const: @(LmP0Text name); int: kind; int: ent; const: @(LmP0Text type_word); int: row) int
    @@: LmP0Text gt
    @: int gi
    size_t: want (cast: (size_t) (l2_mrs_n + 1))
    gi: (cast: (@: int) realloc((cast: (@: void) l2_mrs_res), want * c.sizeof(c.int)))
    if: gi = 0
        return: 0 - 1
    l2_mrs_res: gi
    gi: (cast: (@: int) realloc((cast: (@: void) l2_mrs_kind), want * c.sizeof(c.int)))
    if: gi = 0
        return: 0 - 1
    l2_mrs_kind: gi
    gi: (cast: (@: int) realloc((cast: (@: void) l2_mrs_ent), want * c.sizeof(c.int)))
    if: gi = 0
        return: 0 - 1
    l2_mrs_ent: gi
    gi: (cast: (@: int) realloc((cast: (@: void) l2_mrs_row), want * c.sizeof(c.int)))
    if: gi = 0
        return: 0 - 1
    l2_mrs_row: gi
    gt: (cast: (@@: LmP0Text) realloc((cast: (@: void) l2_mrs_name), want * c.sizeof(@: void)))
    if: gt = 0
        return: 0 - 1
    l2_mrs_name: gt
    gt: (cast: (@@: LmP0Text) realloc((cast: (@: void) l2_mrs_type), want * c.sizeof(@: void)))
    if: gt = 0
        return: -1
    l2_mrs_type: gt
    l2_mrs_res[l2_mrs_n]: res
    l2_mrs_name[l2_mrs_n]: (cast: (@: LmP0Text) name)
    l2_mrs_type[l2_mrs_n]: (cast: (@: LmP0Text) type_word)
    l2_mrs_kind[l2_mrs_n]: kind
    l2_mrs_ent[l2_mrs_n]: ent
    l2_mrs_row[l2_mrs_n]: row
    l2_mrs_n: l2_mrs_n + 1
return: 0

# R9: every merge result's rows made again, in the scan's order, when a Structure with a procedure has steps -- its
# code is copied by a merge after its fields (l2_mrs_take_entry), and the steps are counted after the first scan.
fn: l2_mrs_rebuild_all () int
    int: i 0
    int: any 0
    while: i < l2_ns_n
        if: l2_ns_proc[i] >= 0 && l2_m_steps != 0 && l2_m_steps[l2_ns_proc[i]] > 0
            any: 1
        i: i + 1
    ---
    if: any = 0 || l2_mres_n = 0
        return: 0
    l2_mrs_n: 0
    l2_msrc_n: 0
    l2_mrs_rebuild: 1
    i: 0
    while: i < l2_m_n
        l2_vis_method(i)
        if: l2_m_body[i] != 0 && l2_m_body[i]\as != 0 && l2_merge_scan(l2_m_body[i]\as\structure, i) != 0
            l2_mrs_rebuild: 0
            l2_vis_on: 0
            return: 1
        i: i + 1
    ---
    l2_mrs_rebuild: 0
    l2_vis_on: 0
return: 0

# The number of slots merge result res has so far.
fn: l2_mrs_width (int: res) int
    int: r 0
    int: w 0
    while: r < l2_mrs_n
        if: l2_mrs_res[r] = res
            w: w + 1
        r: r + 1
    ---
return: w

# Record where field j of operand k of merge result res lands (l2_msrc_*).
fn: l2_msrc_push (int: res; int: k; int: j; int: slot; int: pair) int
    @: int gi
    size_t: want (cast: (size_t) (l2_msrc_n + 1))
    gi: (cast: (@: int) realloc((cast: (@: void) l2_msrc_res), want * c.sizeof(c.int)))
    if: gi = 0
        return: 0 - 1
    l2_msrc_res: gi
    gi: (cast: (@: int) realloc((cast: (@: void) l2_msrc_op), want * c.sizeof(c.int)))
    if: gi = 0
        return: 0 - 1
    l2_msrc_op: gi
    gi: (cast: (@: int) realloc((cast: (@: void) l2_msrc_fld), want * c.sizeof(c.int)))
    if: gi = 0
        return: 0 - 1
    l2_msrc_fld: gi
    gi: (cast: (@: int) realloc((cast: (@: void) l2_msrc_slot), want * c.sizeof(c.int)))
    if: gi = 0
        return: 0 - 1
    l2_msrc_slot: gi
    gi: (cast: (@: int) realloc((cast: (@: void) l2_msrc_pair), want * c.sizeof(c.int)))
    if: gi = 0
        return: 0 - 1
    l2_msrc_pair: gi
    l2_msrc_res[l2_msrc_n]: res
    l2_msrc_op[l2_msrc_n]: k
    l2_msrc_fld[l2_msrc_n]: j
    l2_msrc_slot[l2_msrc_n]: slot
    l2_msrc_pair[l2_msrc_n]: pair
    l2_msrc_n: l2_msrc_n + 1
return: 0

# Field j of operand k joins merge result res by the author's rule (plan §4).  The model's
# fields (k = 0) are the first rows, its own repeats included.  A later field whose name a
# placed row carries -- the model's (the last such row, the one `merged\x` names) or one an
# earlier operand added -- goes INTO that row when its type is the row's; any other later
# field is a row of its own.  So merge makes no repeated names.  The body joins last, as
# operand n (the kernel's `operand = count`, -194 K1); pairs apply in this order, so a later
# operand's value wins.
fn: l2_mrs_join (int: res; int: k; int: j; const: @(LmP0Text name); int: kind; int: ent; const: @(LmP0Text type_word); int: row; const: @(LmP0Node at)) int
    int: r 0
    int: slotix 0
    int: hit 0 - 1
    int: hr 0 - 1
    while: k > 0 && r < l2_mrs_n
        if: l2_mrs_res[r] = res && l2_text_same(l2_mrs_name[r], name)
            hit: slotix
            hr: r
        if: l2_mrs_res[r] = res
            slotix: slotix + 1
        r: r + 1
    ---
    if: hit >= 0 && l2_mrs_kind[hr] != kind
        return: l2_error(l2_src, at, "a merge operand field has another type than the model field of its name")
    if: hit >= 0 && kind >= 2 && kind <= 6 && l2_mrs_ent[hr] != ent
        return: l2_error(l2_src, at, "a merge operand field has another type than the model field of its name")
    # K03 NS-ROLES-2: a reference field's type is the Structure it references (l2_nsf_pointee) -- two references to
    # different named Structures are two types, whatever their one machine pointer type.
    if: hit >= 0 && kind = 10 && l2_mrs_row[hr] >= 0 && row >= 0 && l2_nsf_pointee(l2_mrs_row[hr]) != l2_nsf_pointee(row)
        return: l2_error(l2_src, at, "a merge operand field has another type than the model field of its name")
    if: hit >= 0
        return: l2_msrc_push(res, k, j, hit, 1)
    if: l2_msrc_push(res, k, j, l2_mrs_width(res), 0) != 0
        return: 0 - 1
return: l2_mrs_push(res, name, kind, ent, type_word, row)

# Before placement CHECK uses declaration metadata. The completed merge map
# instead visits every real child in source order, including unnamed operations.
fn: l2_mrs_take_entry (int: res; int: k; int: ni; const: @(LmP0Node at)) int
    int: q 0
    int: j 0
    if: l2_mrs_rebuild != 0 && l2_ns_source_body(ni) != 0
        while: j < l2_ns_width(ni)
            q: l2_ns_row_at_slot(ni, j)
            if: q = -2
                return: l2_error(l2_src, at, "internal: a merge source child has no completed place")
            if: q >= 0 && l2_mrs_join(res, k, j, l2_nsf_fname[q], l2_nsf_kind[q], l2_nsf_ref[q], l2_nsf_name[q], q, at) != 0
                return: 1
            if: q < 0 && l2_mrs_join(res, k, j, 0, -1, -1, 0, -1, at) != 0
                return: 1
            j: j + 1
        ---
        return: 0
    ---
    while: q < l2_nsf_n
        if: l2_nsf_owner[q] = ni
            if: l2_mrs_join(res, k, j, l2_nsf_fname[q], l2_nsf_kind[q], l2_nsf_ref[q], l2_nsf_name[q], q, at) != 0
                return: 1
            j: j + 1
        ---
        q: q + 1
    ---
    # R9: after its fields a Structure with a procedure holds its code -- control bodies, steps -- and the merge
    # copies them as it copies every child: a row each, with no name, so none pairs (l2_text_same of no name is 0).
    while: j < l2_ns_width(ni)
        if: l2_mrs_join(res, k, j, 0, 0 - 1, 0 - 1, 0, -1, at) != 0
            return: 1
        j: j + 1
    ---
return: 0

# The rows an already bound result contributes when it is itself operand k.
fn: l2_mrs_take_result (int: res; int: k; int: src; const: @(LmP0Node at)) int
    int: r 0
    int: j 0
    int: n
    n: l2_mrs_n
    while: r < n
        if: l2_mrs_res[r] = src
            if: l2_mrs_join(res, k, j, l2_mrs_name[r], l2_mrs_kind[r], l2_mrs_ent[r], l2_mrs_type[r], l2_mrs_row[r], at) != 0
                return: 1
            j: j + 1
        ---
        r: r + 1
    ---
return: 0

# Join a value-position path, which arrives as atoms around separator atoms,
# into one byte span. Returns the length, or 0 when the field list is not a
# path. The buffer is caller supplied; a path longer than it is not a path.
# A member written `[N]name` arrives as separate atoms (`[`, the digits, `]`,
# the name); they are joined into the one segment `[N]name` the lookup parses
# (K01: the occurrence selector is part of the segment text).
# TEXT OF ANY LENGTH.  A name or a path the program writes may be of any length.  A function that joins one into a
# buffer of its own asks l2_text_room for the buffer: its local one when the text fits, else storage of exactly the
# text's size, kept until the translation is released (l2_ltx, l2_release).  The size comes from the fields the text
# is made of (l2_atoms_len).  Nothing is clipped, and no length is refused.

# The bytes of the atoms of the active fields from f on: cnt of them, or to the end of the list when cnt < 0.  No
# text a builder joins of those fields is longer (l2_join_path, l2_path_chain, l2_ruse_follow, l2_arr_operand): the
# separators it writes are atoms of the list as well.
fn: l2_atoms_len (@: LmP0Field f; int: cnt) size_t
    @: LmP0Field g
    size_t: n 0U
    int: i 0
    g: l2_next_active(f)
    while: g != 0 && (cnt < 0 || i < cnt)
        if: g\value != 0 && g\value\kind = c.LM_P0_NODE_ATOM && g\value\as != 0 && g\value\as\atom != 0
            n: n + g\value\as\atom\length
        g: l2_next_active(g\next)
        i: i + 1
    ---
return: n

# Room for need bytes: `local` when its capacity cap holds them, else storage of exactly need bytes, kept until
# l2_release.  0 when there is no memory.
# One line of the allocation trace (L2_ALLOC_TRACE): the ordinal of the allocation about to be made -- the
# one L2_FAIL_MALLOC counts -- what makes the room, and which allocation of it this is.
fn: l2_alloc_note (const: @(char what)) int
    if: l2_alloc_trace = 0
        return: 0
    if: l2_room_tag = 0
        c.fprintf(l2_alloc_trace, "%d room %s\n", l2_alloc_n + 1, what)
        return: 0
    c.fprintf(l2_alloc_trace, "%d %s %s\n", l2_alloc_n + 1, l2_room_tag, what)
return: 0

fn: l2_text_room (size_t: need; @: char local; size_t: cap) @: char
    @: char made
    @: void grown
    int: want
    size_t: psz
    if: need <= cap && local != 0
        return: local
    if: l2_ltx_n >= l2_ltx_cap
        want: l2_cap_next(l2_ltx_cap, l2_ltx_n + 1)
        if: want < 0
            l2_alloc_err: 2
            return: 0
        psz: c.sizeof(@: char)
        l2_alloc_note("vector")
        grown: l2_vec_grow((cast: (@: void) l2_ltx), l2_ltx_n, want, psz)
        if: grown = 0
            return: 0
        l2_ltx: (cast: (@@: char) grown)
        l2_ltx_cap: want
    ---
    l2_alloc_note("buffer")
    made: (cast: (@: char) l2_xmalloc(need))
    if: made = 0
        return: 0
    l2_ltx[l2_ltx_n]: made
    l2_ltx_n: l2_ltx_n + 1
return: made

# The words of a refusal that name up to three things: p0, the xn bytes of x, p1, the yn bytes of y, p2, the zn
# bytes of z, p3 -- in memory of their own size, so that no name is cut from the words that name it
# (FIXED-BLOCKS-AUDIT).  A name not given (0) is said as nothing.
fn: l2_error_words (const: @(char path); const: @(LmP0Node at); const: @(char p0); const: @(char x); size_t: xn; const: @(char p1); const: @(char y); size_t: yn; const: @(char p2); const: @(char z); size_t: zn; const: @(char p3)) int
    []: char own 256
    @: char msg
    size_t: need
    if: x = 0
        x: ""
        xn: 0U
    if: y = 0
        y: ""
        yn: 0U
    if: z = 0
        z: ""
        zn: 0U
    if: xn > (cast: (size_t) c.INT_MAX) || yn > (cast: (size_t) c.INT_MAX) || zn > (cast: (size_t) c.INT_MAX)
        return: l2_error(path, at, p0)
    need: strlen(p0) + xn + strlen(p1) + yn + strlen(p2) + zn + strlen(p3) + 1U
    msg: l2_text_room(need, own, 256U)
    if: msg = 0
        return: l2_alloc_or(path, at, "out of memory")
    c.snprintf(msg, need, "%s%.*s%s%.*s%s%.*s%s", p0, (cast: (int) xn), x, p1, (cast: (int) yn), y, p2, (cast: (int) zn), z, p3)
return: l2_error(path, at, msg)

# The words of a refusal that names one thing: before, the n bytes of name, after (l2_error_words).
fn: l2_error_name (const: @(char path); const: @(LmP0Node at); const: @(char before); const: @(char name); size_t: n; const: @(char after)) int
    if: name = 0
        return: l2_error(path, at, before)
return: l2_error_words(path, at, before, name, n, after, 0, 0U, "", 0, 0U, "")

fn: l2_join_path (@: LmP0Field field; int: cnt; @: char buf; size_t: cap) size_t
    @: LmP0Field f
    const: @: LmP0Text t
    size_t: n 0U
    int: want_name 1
    int: i 0
    int: closed
    if: field = 0 || buf = 0 || cnt < 3
        return: 0U
    f: l2_next_active(field)
    while: f != 0 && i < cnt
        if: f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM
            return: 0U
        t: f\value\as\atom
        if: t = 0 || t\data = 0 || t\length = 0U
            return: 0U
        if: want_name != 0 && t\length = 1U && t\data[0] = 92
            return: 0U
        if: want_name = 0 && (t\length != 1U || t\data[0] != 92)
            return: 0U
        if: want_name != 0 && t\length = 1U && t\data[0] = 91
            # `[N]name`: zeros or more digits, the closing bracket, the name.
            if: n + 1U > cap
                return: 0U
            buf[n]: 91
            n: n + 1U
            closed: 0
            i: i + 1
            f: l2_next_active(f\next)
            while: f != 0 && i < cnt && closed = 0
                if: f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM
                    return: 0U
                t: f\value\as\atom
                if: t = 0 || t\data = 0 || t\length = 0U || n + t\length > cap
                    return: 0U
                memcpy(buf + n, t\data, t\length)
                n: n + t\length
                if: t\length = 1U && t\data[0] = 93
                    closed: 1
                ---
                f: l2_next_active(f\next)
                i: i + 1
            ---
            if: closed = 0 || f = 0 || i >= cnt
                return: 0U
            if: f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM || f\value\as = 0
                return: 0U
            t: f\value\as\atom
            if: t = 0 || t\data = 0 || t\length = 0U || (t\length = 1U && (t\data[0] = 92 || t\data[0] = 93)) || n + t\length > cap
                return: 0U
            memcpy(buf + n, t\data, t\length)
            n: n + t\length
            want_name: 0
            f: l2_next_active(f\next)
            i: i + 1
            continue
        ---
        if: n + t\length > cap
            return: 0U
        memcpy(buf + n, t\data, t\length)
        n: n + t\length
        want_name: 1 - want_name
        f: l2_next_active(f\next)
        i: i + 1
    ---
    if: want_name != 0 || i != cnt
        return: 0U
return: n

# D-89: the literal a field-path statement writes into a size_t, unsigned or
# ulong field (path kinds 0, 8, 9) must be representable there -- the same
# check an ordinary assignment makes (l2_check_literal_kind), not a store of
# the 0 l2_literal_value leaves for what does not fit.
fn: l2_path_rhs_range (const: @(LmP0Structure body); int: kind; const: @(LmP0Node stmt)) int
    @: LmP0Field f
    int: lk 0 - 1
    if: kind = 0
        lk: 2
    if: kind = 8
        lk: 3
    if: kind = 9
        lk: 4
    if: lk < 0 || body = 0 || l2_count_active(body) != 1
        return: 0
    f: l2_next_active(body\first_field)
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM || l2_num(f\value\as\atom) = 0
        return: 0
return: l2_check_literal_kind(f\value\as\atom, lk, l2_src, stmt)

# The value a field-path statement stores: a literal, or a char literal. Only
# what the declared field kinds already admit.
fn: l2_path_rhs (const: @(LmP0Structure body); int: kind; @: size_t out_v) int
    @: LmP0Field f
    const: @: LmP0Text t
    int: cv
    int: st
    if: body = 0 || l2_count_active(body) != 1
        return: 1
    f: l2_next_active(body\first_field)
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM
        return: 1
    t: f\value\as\atom
    if: kind = 7
        st: l2_int_literal_bits(t, out_v)
        if: st != 1
            return: 1
        return: 0
    if: (kind = 0 || kind = 8 || kind = 9) && l2_num(t) = 0
        return: 1
    if: kind = 0 || kind = 8 || kind = 9
        \out_v: l2_literal_value(t)
        return: 0
    cv: l2_char_literal(t)
    if: cv < 0
        return: 1
    \out_v: (cast: (size_t) cv)
return: 0

# The body of "if: <slot> = 0" for a field path: a slot the translator resolved
# must exist, so this is a lost-graph stop, not a language outcome. It leaves a
# method exactly the way l2_emit_path_load leaves one -- the method's own
# return shape -- and the entry with a distinguished code.
# Which method does this statement or call head name? A plain name, or a field
# path whose leaf is a callable. -1 when the head names no method.

# Is this statement a CALL rather than an update? Block, short/colon and
# parenthesized forms must select the same operation. COMPACT/COLON flags
# do not choose here. An existing METHOD is a call in every form; a path
# that ends at a callable field is a call; an empty argument list cannot
# be an update. Everything else with a path head is an update, and a
# wrong one is reported against the field it names.
fn: l2_head_is_call (const: @(LmP0Text t); const: @(LmP0Structure body); unsigned: flags; int: mi) int
    int: k 0
    int: fi
    int: req
    if: t = 0
        return: 0
    req: l2_call_head_method(mi, t, @ fi)
    if: req >= 0
        return: 1
    # A held callable of the site is called in every form, as a method is.
    if: l2_call_head_held(mi, t) >= 0
        return: 1
    # c.name(...) is the raw C door (spec 6.6.6): a call in every form, an empty argument list
    # included (`c.abort()`), never an update of a field of that name.
    if: l2_c_stmt_door(t) != 0
        return: 1
    if: t\data = 0
        return: 0
    if: l2_seg_count(t\data, t\length) < 2
        return: 0
    if: l2_path_kind(t\data, t\length, @ k) = 4
        return: 1
    if: body = 0 || l2_count_active(body) = 0
        return: 1
return: 0

# Resolve the source binding before its callable category: visible own, then
# formal/hidden input, then other local bindings, then unit method/path. A
# non-callable binding blocks a same-name method; it is not a failed lookup
# that licenses selection of an outer callable. Other callable categories
# (named Structure, held value, fnptr) keep their existing later dispatch.
fn: l2_call_head_method (int: mi; const: @(LmP0Text head); @: int out_fi) int
    int: fi
    int: m
    int: ty
    int: k
    \out_fi: -1
    # K03 NS-ROLES-1b: a field bound by `b: tick` -- the site's own, or the unit's seen from a method -- calls tick, on
    # the occurrence it holds (l2_call_alias_own); another own field blocks every outer callable of its name.
    k: l2_call_alias_own(mi, head)
    if: k >= 0
        return: l2_rb_meth_of(l2_own_decl[k])
    if: l2_resolved_own(mi, head) >= 0
        return: -1
    fi: l2_formal_find(mi, head)
    \out_fi: fi
    if: fi >= 0
        return: l2_cf_get(mi, fi)
    # Even an as-yet untyped hidden input is a real binding.
    if: l2_param_find(mi, head) >= 0 || l2_colon_bound_ty(mi, head, @ ty) = 0 || l2_slot_find(mi, head) >= 0 || l2_ml_find(head) >= 0
        return: -1
    m: l2_head_method(mi, head)
    if: m >= 0
        \out_fi: 0 - 1
    ---
return: m

# The existing callable code selected by a field path, including an ordinary
# named body's procedure. Selection does not execute the leaf. A discarded
# application executes it; receiving a no-result occurrence as a nonprimitive
# argument transports its reference. Returning callables supply their result.
fn: l2_path_callee (int: mi; @: LmP0Text t) int
    int: fi 0 - 1
    int: k
    if: t = 0 || t\data = 0 || l2_seg_count(t\data, t\length) < 2
        return: -1
    k: l2_call_head_method(mi, t, @ fi)
    if: k < 0 || k = l2_e || fi >= 0
        return: -1
return: k

# The callable the operand run field..count -- one path, `a\b...` -- selects (l2_path_callee), with the path's text in
# *out for the caller to free (l2_xfree); else -1, *out 0.
fn: l2_path_run_callee (@: LmP0Field field; int: count; int: mi; @@: char out) int
    @: char text
    LmP0Text: word
    int: k
    \out: 0
    if: count < 3 || l2_operand_run(field, count) != count
        return: -1
    text: l2_address_path_text(field, count)
    if: text = 0
        return: -1
    word.data: text
    word.length: strlen(text)
    k: l2_path_callee(mi, @ word)
    if: k < 0
        l2_xfree((cast: (@: void) text))
        return: -1
    \out: text
return: k

# K03 NS-ROLES-1b: the field a call head names at its site in method mi when a binding `b: tick` declared it -- the
# site's own row or, in a method, the unit's field it sees (l2_own_visible; there its value is the method's hidden
# input, Q52) -- or -1.  The call is tick's on the occurrence the field holds.
fn: l2_call_alias_own (int: mi; const: @(LmP0Text head)) int
    int: k
    if: mi < 0 || head = 0 || l2_formal_find(mi, head) >= 0 || l2_slot_find(mi, head) >= 0 || l2_ml_find(head) >= 0
        return: -1
    k: l2_own_visible(mi, head)
    if: k < 0 || l2_own_decl[k] = 0 || l2_rb_meth_of(l2_own_decl[k]) < 0
        return: -1
return: k

# D-106: does a call head inside method mi name a callable formal of mi?
fn: l2_head_is_callable_formal (int: mi; const: @(LmP0Text head)) int
    int: fi
    int: method l2_call_head_method(mi, head, @ fi)
return: (cast: (int) (method >= 0 && fi >= 0))

# D-106: is a call head inside method mi a call of a unit method by its name (not a callable formal of
# mi)?  A method's occurrence path (`Holder\viaPath`) is not a name here, as l2_find_method has it.
fn: l2_head_is_method_call (int: mi; const: @(LmP0Text head)) int
    int: fi
    int: method l2_call_head_method(mi, head, @ fi)
return: (cast: (int) (method >= 0 && fi < 0 && method = l2_site_method(mi, head)))

fn: l2_head_method (int: mi; const: @(LmP0Text t)) int
    int: k 0
    int: r
    int: kind
    int: model
    if: t = 0
        return: 0 - 1
    r: l2_site_method(mi, t)
    if: r >= 0
        return: r
    if: t\data = 0
        return: 0 - 1
    if: l2_seg_count(t\data, t\length) < 2
        return: 0 - 1
    kind: l2_path_contract(t\data, t\length, @ k, @ model)
    if: kind = 4
        return: k
    if: (kind = 2 || kind = 3) && model >= 0 && model < l2_ns_n
        return: l2_ns_proc[model]
return: 0 - 1

# A field path that meets no Structure where it needs one (D-05) takes the X1 route: a message and
# an abort (l2_emit_invariant).  It used to return 0 from the whole method, a silent success.
fn: l2_emit_path_bail (int: mi; const: @(char ind)) int
    if: mi < 0
        return: 1
return: l2_emit_invariant(ind, "a field path met no Structure")

# ---------------------------------------------------------------------------
# SOURCE FIELD PATHS (SPEC 8252, 8366). A path is a name, then field-follow
# separators and field names: its root is selected from the ordinary source
# bindings, including reached merge-result own slots. Every step
# resolves at TRANSLATION to a child index. The graph carries no name table at
# run time and none is introduced here.
#
# A path arrives in two spellings. In update position the parser hands over the
# whole path as ONE frame head text; in value position it arrives as a sequence
# of atoms separated by the separator atom. These functions therefore take a
# plain byte span, which both spellings can produce, rather than an LmP0Text.
# ---------------------------------------------------------------------------

# Segment i of a separator-joined span, as an offset and a length.
# Is this statement head a field path this emitter lowers? Used by the
# unsupported-body guard, which runs before the statement is dispatched.
fn: l2_is_path_head (const: @(LmP0Text t)) int
    int: ni 0
    int: res 0
    int: oi 0
    int: root 0
    int: fi 0
    if: t = 0 || t\data = 0
        return: 0
    if: l2_raw_head(t, l2_cur_mi, @ fi) = 0
        return: 0
    if: l2_seg_count(t\data, t\length) < 2
        return: 0
    if: l2_path_root(t\data, t\length, @ ni, @ res, @ oi, @ root, @ fi) != 0
        return: 0
return: 1

fn: l2_seg_at (const: @(char pd); size_t: pn; int: i; @: size_t off; @: size_t len) int
    size_t: j 0U
    size_t: start 0U
    int: seen 0
    if: pd = 0
        return: 1
    while: j < pn
        if: pd[j] = 92 && seen = i
            \off: start
            \len: j - start
            return: 0
        if: pd[j] = 92
            seen: seen + 1
            start: j + 1U
        j: j + 1U
    ---
    if: seen != i
        return: 1
    \off: start
    \len: pn - start
return: 0

fn: l2_seg_count (const: @(char pd); size_t: pn) int
    size_t: j 0U
    int: n 1
    if: pd = 0
        return: 0
    while: j < pn
        if: pd[j] = 92
            if: n = c.INT_MAX
                l2_alloc_err: 2
                return: -1
            n: n + 1
        j: j + 1U
    ---
return: n

# Does this name equal the given span of the path?
fn: l2_name_is_seg (const: @(LmP0Text name); const: @(char pd); size_t: off; size_t: len) int
    if: name = 0 || name\data = 0 || pd = 0 || len = 0U
        return: 0
    if: name\length != len
        return: 0
return: memcmp(name\data, pd + off, len) = 0

# Split one path segment `[N]name` or `name`: \out_occ is -1 for the bare name
# (the LAST occurrence view, K01) or N for the explicit occurrence; \out_off and
# \out_len are the name's span.  1 when the segment is a malformed bracket group.
fn: l2_seg_split (const: @(char pd); size_t: off; size_t: len; @: int out_occ; @: size_t out_off; @: size_t out_len) int
    size_t: j
    int: occ 0
    int: digits 0
    \out_occ: 0 - 1
    \out_off: off
    \out_len: len
    if: pd = 0 || len = 0U || off + len < off
        return: 1
    if: pd[off] != 91
        return: 0
    j: off + 1U
    while: j < off + len && pd[j] >= 48 && pd[j] <= 57
        occ: occ * 10 + (cast: (int) (pd[j] - 48))
        j: j + 1U
        digits: digits + 1
    ---
    if: digits = 0 || j + 1U >= off + len || pd[j] != 93
        return: 1
    \out_occ: occ
    \out_off: j + 1U
    \out_len: off + len - (j + 1U)
return: 0

# The occurrence a path segment SELECTS: 0 - 1 for a bare `name` (the name's LAST
# occurrence), N for `[N]name`.  A malformed segment is 1; the caller reports it.
fn: l2_seg_occurrence (const: @(char pd); size_t: off; size_t: len; @: int out) int
    size_t: o off
    size_t: l len
    if: l2_seg_split(pd, off, len, out, @ o, @ l) != 0
        return: 1
return: 0

# The name atom after the bracket group whose `[` is `at` (value-position path
# runs carry `[`, the digits, `]` and the name as separate atoms).
fn: l2_after_bracket (@: LmP0Field at) @: LmP0Field
    @: LmP0Field f at
    while: f != 0
        if: f\value != 0 && f\value\kind = c.LM_P0_NODE_ATOM && f\value\as != 0 && f\value\as\atom != 0 && f\value\as\atom\data != 0 && f\value\as\atom\length = 1U && f\value\as\atom\data[0] = 93
            return: l2_next_active(f\next)
        f: l2_next_active(f\next)
    ---
return: at

# Metadata selection is independent of storage layout. Return the global NSF
# row for LAST or the segment's explicit occurrence. Consumers may then ask
# for its declaration ordinal or its completed physical place separately.
fn: l2_ns_named_row (int: ni; const: @(char pd); size_t: off; size_t: len; @: int out_kind; @: int out_ent) int
    int: k 0
    int: hit 0 - 1
    int: occurrence 0 - 1
    int: seen 0
    size_t: noff off
    size_t: nlen len
    if: ni < 0 || l2_seg_split(pd, off, len, @ occurrence, @ noff, @ nlen) != 0
        return: 0 - 1
    while: k < l2_nsf_n
        if: l2_nsf_owner[k] = ni && l2_nsf_fname[k] != 0 && l2_nsf_fname[k]\data != 0 && l2_nsf_fname[k]\length > 0U && l2_nsf_fname[k]\length = nlen && memcmp(l2_nsf_fname[k]\data, pd + noff, nlen) = 0
            if: occurrence < 0 || seen = occurrence
                hit: k
            seen: seen + 1
        ---
        k: k + 1
    ---
    if: hit >= 0 && out_kind != 0
        \out_kind: l2_nsf_kind[hit]
    if: hit >= 0 && out_ent != 0
        \out_ent: l2_nsf_ref[hit]
return: hit

# The dense declaration ordinal is not a physical source child. The existing
# dense namespace producer still consumes it until the connected source-layout
# cutover; source-owned consumers must use the completed projection instead.
fn: l2_nsf_ordinal (int: row) int
    int: k 0
    int: ordinal 0
    if: row < 0 || row >= l2_nsf_n
        return: -1
    while: k < row
        if: l2_nsf_owner[k] = l2_nsf_owner[row]
            ordinal: ordinal + 1
        k: k + 1
return: ordinal

# COUNT uses the explicit declaration seed only to count operand topology;
# it emits no child coordinate. Completed-layout consumers must project the
# selected original token into the existing source container, never fall back.
fn: l2_nsf_slot (int: row) int
    int: ni
    int: mi
    int: found -1
    @: L2SourceContainer source
    @: L2SourceField field
    @: LmP0Field atom
    int: retained
    if: row < 0 || row >= l2_nsf_n
        return: -1
    ni: l2_nsf_owner[row]
    if: l2_ns_source_body(ni) = 0 || l2_construct_phase = 0
        return: l2_nsf_ordinal(row)
    mi: l2_ns_proc[ni]
    source: l2_source_root(mi)
    if: source = 0
        return: -1
    if: l2_nsf_fname[row] != 0
        field: source\fields
        while: field != 0
            if: l2_own_mi[field\own] = mi && l2_nsf_fname[row] = l2_own_name[field\own]
                if: found >= 0
                    return: -1
                found: field\slot
            field: field\next
        ---
        if: found >= 0
            return: found
    ---
    atom: l2_next_active(source\body\first_field)
    while: atom != 0
        retained: l2_ns_constructed_row(mi, atom\value)
        if: retained = -2
            return: -1
        if: retained = row
            if: found >= 0
                return: -1
            found: l2_ps_lookup(atom\value)
        atom: l2_next_active(atom\next)
    ---
return: found

# A valid unnamed source operation is a child, not a missing named field.
# -1 denotes that unnamed child; -2 is an invalid or unprojected coordinate.
fn: l2_ns_row_at_slot (int: ni; int: slot) int
    int: row 0
    int: child
    int: found -1
    if: slot < 0 || slot >= l2_ns_width(ni)
        return: -2
    while: row < l2_nsf_n
        if: l2_nsf_owner[row] = ni
            child: l2_nsf_slot(row)
            if: child < 0
                return: -2
            if: child = slot
                if: found >= 0
                    return: -2
                found: row
            ---
        ---
        row: row + 1
    ---
return: found

# An existing namespace constructor owns an exact written declaration, not
# merely a field with the same spelling. Share this identity check with source
# roots and with execution views that borrow the declaration's original token.
fn: l2_ns_decl_constructor (int: ni; int: own) int
    int: row 0
    int: kind
    if: ni < 0 || own < 0
        return: -1
    while: row < l2_nsf_n
        if: l2_nsf_owner[row] = ni && l2_nsf_source[row] = l2_own_decl[own] && l2_nsf_fname[row] != 0 && l2_nsf_fname[row] = l2_own_name[own]
            kind: l2_nsf_kind[row]
            if: kind = 2 && (l2_nsf_source[row] != l2_own_decl[own] || l2_nsf_ref[row] != l2_own_nsty_get(own))
                row: row + 1
                continue
            if: kind = 0 || kind = 1 || kind = 2 || kind = 3 || kind = 4 || kind = 6 || kind = 7 || kind = 8 || kind = 9 || kind >= 10
                return: row
            if: kind = 5 && (l2_nsf_ref[row] = 0 || l2_nsf_ref[row] = 1)
                return: row
        ---
        row: row + 1
    ---
return: -1

# Reuse a constructor only in its exact original root source view. The
# existing NSF constructor must actually create that child's value; a kind
# number alone (notably depth3 pointer versus anonymous kind12) proves nothing.
fn: l2_source_ns_constructor (@: L2SourceContainer source; int: own) int
    int: ni
    if: source = 0 || own < 0 || source\root = 0 || source\source_mi != l2_own_mi[own]
        return: -1
    ni: l2_m_nsof(source\source_mi)
    if: l2_ns_source_body(ni) != source\body
        return: -1
return: l2_ns_decl_constructor(ni, own)

# A borrowed execution view does not redeclare the original source field.
# Its exact canonical NSF producer retains the cell in the actual occurrence;
# this view emits only its initializer action. Real nested declarations have
# another original token and continue to own their ordinary source slots.
fn: l2_source_borrowed_constructor (@: L2SourceContainer source; int: own) int
    int: ni
    @: LmP0Structure body
    @: LmP0Field field
    if: source = 0 || own < 0 || source\root != 0 || source\source_mi != l2_own_mi[own]
        return: -1
    ni: l2_m_nsof(source\source_mi)
    body: l2_ns_original_body(ni)
    if: body = 0 || body = source\body
        return: -1
    field: l2_next_active(body\first_field)
    while: field != 0
        if: field\value = l2_own_decl[own]
            return: l2_ns_decl_constructor(ni, own)
        field: l2_next_active(field\next)
    ---
return: -1

fn: l2_ns_slot_named (int: ni; const: @(char pd); size_t: off; size_t: len; @: int out_kind; @: int out_ent) int
return: l2_nsf_slot(l2_ns_named_row(ni, pd, off, len, out_kind, out_ent))

# The named Structure reference field row points at: a binding's own referent, resolved once at its place
# (l2_ns_bind_target, K03 NS-ROLES-2), or a typed reference `@: T q`'s pointee by its word T (D-76); -1 for none.
fn: l2_nsf_pointee (int: row) int
    if: row < 0 || row >= l2_nsf_n || l2_nsf_kind[row] != 10 || l2_nsf_name[row] = 0
        return: -1
    if: l2_nsf_val[row] != 0U
        return: (cast: (int) l2_nsf_val[row]) - 1
return: l2_ns_find(l2_nsf_name[row])

# The named Structure the reference field `seg` of Structure ni points at, or -1 (D-76).
fn: l2_ns_ref_pointee (int: ni; const: @(char pd); size_t: off; size_t: len) int
return: l2_nsf_pointee(l2_ns_named_row(ni, pd, off, len, 0, 0))

# A resolved field carries its machine pointer type separately from its
# declared structural model. Own rows already carry that model; namespace
# fields use their existing declaration metadata. No new runtime index.
fn: l2_field_pointee (int: ns; int: own; const: @(char pd); size_t: off; size_t: len) int
    if: own >= 0
        return: l2_own_nsty_get(own)
return: l2_ns_ref_pointee(ns, pd, off, len)

# The same for a bound merge result, whose slots carry the names of the fields
# that CONTRIBUTED them.  merge makes no repeated names (the author's merge rule, plan §4):
# a later operand's field of a model name went INTO the model's slot, so a name has one
# slot -- or the model's own repeats, of which bare `merged\x` is the last and an explicit
# `merged\[N]x` the occurrence N (K01: the segment carries the selector; the -1/-2 split
# with l2_mrs_slot_nth is the older spelling of the same rule).
fn: l2_mrs_slot_named (int: res; const: @(char pd); size_t: off; size_t: len; @: int out_kind; @: int out_ent) int
    int: k 0
    int: slotix 0
    int: hit 0 - 1
    int: occurrence 0 - 1
    int: seen 0
    size_t: noff off
    size_t: nlen len
    if: l2_seg_split(pd, off, len, @ occurrence, @ noff, @ nlen) != 0
        return: 0 - 1
    while: k < l2_mrs_n
        if: l2_mrs_res[k] = res && l2_name_is_seg(l2_mrs_name[k], pd, noff, nlen) != 0
            if: occurrence < 0
                hit: slotix
                \out_kind: l2_mrs_kind[k]
                \out_ent: l2_mrs_ent[k]
            else:
                if: seen = occurrence
                    \out_kind: l2_mrs_kind[k]
                    \out_ent: l2_mrs_ent[k]
                    return: slotix
                seen: seen + 1
            ---
        ---
        if: l2_mrs_res[k] = res
            slotix: slotix + 1
        k: k + 1
    ---
return: hit

# The field row that contributed slot `slot` of bound merge result res; -1 when it has none.
fn: l2_mrs_slot_row (int: res; int: slot) int
    int: k 0
    int: slotix 0
    if: res < 0 || slot < 0
        return: -1
    while: k < l2_mrs_n
        if: l2_mrs_res[k] = res
            if: slotix = slot
                return: l2_mrs_row[k]
            slotix: slotix + 1
        ---
        k: k + 1
    ---
return: -1

# The named Structure a reference field `@: T q` at slot `slot` of merge result res points
# at -- the pointee the contributing declaration names -- or -1.
fn: l2_mrs_ref_pointee (int: res; int: slot) int
return: l2_nsf_pointee(l2_mrs_slot_row(res, slot))

# Occurrence occ (0 = the first) of field `name` of bound merge result res: its slot, with the
# field kind and entry; -1 when there is no such occurrence.  Only the model's own repeats
# are occurrences past the first.
fn: l2_mrs_slot_nth (int: res; const: @(LmP0Text name); int: occ; @: int out_kind; @: int out_ent) int
    int: k 0
    int: slotix 0
    int: seen 0
    if: name = 0 || out_kind = 0 || out_ent = 0 || occ < 0
        return: 0 - 1
    while: k < l2_mrs_n
        if: l2_mrs_res[k] = res && l2_name_is_seg(l2_mrs_name[k], name\data, 0U, name\length) != 0 && seen = occ
            \out_kind: l2_mrs_kind[k]
            \out_ent: l2_mrs_ent[k]
            return: slotix
        if: l2_mrs_res[k] = res && l2_name_is_seg(l2_mrs_name[k], name\data, 0U, name\length) != 0
            seen: seen + 1
        if: l2_mrs_res[k] = res
            slotix: slotix + 1
        k: k + 1
    ---
return: 0 - 1

# Is this span a field path whose root names a declaration, a bound result,
# or a Structure reference this occurrence already holds (an own field --
# FABLE-SONNET-FIELD-PATHS-20260923-113)? Own-field roots are tried first,
# the same priority order declaration/assignment/call resolution already
# uses (CORE.md 4): an own field can never share a name with a unit-level
# declaration or a bound result, so trying it first changes nothing for any
# root that was already recognized. \out_oi does not require the root's
# namespace type to be known -- an own field with no known Structure type
# is still a root (l2_is_path_head still routes it to the path machinery),
# it simply cannot be walked past segment 1; l2_path_kind/l2_emit_path
# refuse that explicitly instead of guessing, at the segment that needs it.
# out_root: -1 ordinary (out_ni/out_res/out_oi as before); -2 the literal
# root "node" (FABLE-SONNET-NODE-ROOT-20260923-121: M.parent, the callable
# occurrence's lexical parent -- the unit, for any method other than E
# itself; E has no parent, so "node" inside E resolves nothing here and the
# path fails downstream as an ordinary unresolved name); >=0 the literal
# root "for", value = the innermost enclosing for-frame's l2_for_* index
# (the for-frame's own Structure, read as CORE.md's "for\x" rule). node/for
# are ordinary roots of this dispatcher now, not reserved spelling prefixes
# -- an own field or formal literally named "node"/"for" (checked first,
# unchanged) still wins, matching this dispatcher's existing precedence.
# out_fi (Opus's D1, folded into -121): -1 unless out_ni came from a
# TYPED FORMAL's own nsty (the typed-formal branch below, D-28) -- l2_emit_path
# must then seed l2_pst from the formal's ACTUAL ARGUMENT value, never
# from ni treated as an ordinary unit-level declaration (that read the
# static declaration child, not the passed value: a formal root is a
# value like an own field's load, not a name in the unit's own scope).
# The statement being read (7b-3): its source place, for what a body root sees before it (l2_body_root).
fn: l2_here_at_method (int: mi; const: @(LmP0Node n)) int
    if: l2_here_mi != mi
        l2_here_source_mi: mi
    l2_here_mi: mi
return: l2_here_at(n)

fn: l2_here_at (const: @(LmP0Node n)) int
    l2_here_node: (cast: (@: LmP0Node) n)
    l2_here_on: 0
    if: n != 0 && n\span != 0
        l2_here: n\span\offset
        l2_here_on: 1
    ---
return: 0

# A CONTROL BODY AS A PATH ROOT (7b-3; L2 §10: nested bodies are nested field-only Structures, `M\for\y` is the same
# path; book "names": an unqualified name is the last occurrence; Q51: ordinary visibility is forward and down, access
# from outside is to the place of declaration; Q52: nothing but declared fields).  A body is the field of its enclosing
# body named by the head of its statement -- `for`, `while`, `if`, `else`, `catch` -- and a path root naming one is the
# last such body of method mi visible here: its enclosing body is in scope (the method's own level, or a body on the
# scope stack), and it is either on the scope stack itself (down: inside it) or written before the statement being read
# (forward: after its `end:`).  An anonymous block has no head and so no name.  -1 when none.
fn: l2_body_root (int: mi; const: @(char pd); size_t: off; size_t: len) int
    int: k 0
    int: best 0 - 1
    int: pk
    const: @: LmP0Node st
    if: mi < 0 || pd = 0 || len = 0U
        return: 0 - 1
    while: k < l2_for_n
        st: l2_for_stmt[k]
        pk: l2_for_parent[k]
        if: l2_for_mi[k] = mi && st != 0 && st\kind = c.LM_P0_NODE_FRAME && st\as != 0 && st\as\frame != 0 && st\as\frame\head != 0 && l2_name_is_seg(st\as\frame\head, pd, off, len) != 0 && (pk < 0 || l2_scope_has(l2_for_node[pk]) != 0) && (l2_scope_has(l2_for_node[k]) != 0 || l2_here_on = 0 || st\span = 0 || st\span\offset < l2_here)
            best: k
        k: k + 1
    ---
return: best

# The body a path root `t` names in method mi here, or -1 (l2_body_root).
fn: l2_body_named (int: mi; const: @(LmP0Text t)) int
    if: t = 0 || t\data = 0
        return: 0 - 1
return: l2_body_root(mi, t\data, 0U, t\length)

# A CONTROL BODY AS A LATER PATH SEGMENT (the 7b-3 rule one level down; L2 §10 `M\for\y`): after a method root a name is
# of that method's level, after a body of that body -- a declared field, or a body of that host named by its statement's
# head.  The body: the last one of method mi whose enclosing body is pk (-1: the method's own level) and whose head is
# the segment; where the path stands in mi itself (here_mi), one visible there -- on the scope stack, or written before
# the statement being read -- as for a root (l2_body_root).  -1 when none.
fn: l2_body_seg (int: mi; int: pk; const: @(char pd); size_t: off; size_t: len; int: here_mi) int
    int: k 0
    int: best 0 - 1
    const: @: LmP0Node st
    if: mi < 0 || pd = 0 || len = 0U
        return: 0 - 1
    while: k < l2_for_n
        st: l2_for_stmt[k]
        if: l2_for_mi[k] = mi && l2_for_parent[k] = pk && st != 0 && st\kind = c.LM_P0_NODE_FRAME && st\as != 0 && st\as\frame != 0 && st\as\frame\head != 0 && l2_name_is_seg(st\as\frame\head, pd, off, len) != 0 && (mi != here_mi || l2_scope_has(l2_for_node[k]) != 0 || l2_here_on = 0 || st\span = 0 || st\span\offset < l2_here)
            best: k
        k: k + 1
    ---
return: best

# Does `t` head some control body of the program -- a word a path may start with, as `node` is (l2_path_chain)?  Which
# body it names is l2_body_root's to say where the path stands.
fn: l2_body_head_word (const: @(LmP0Text t)) int
    int: k 0
    const: @: LmP0Node st
    if: t = 0 || t\data = 0
        return: 0
    while: k < l2_for_n
        st: l2_for_stmt[k]
        if: st != 0 && st\kind = c.LM_P0_NODE_FRAME && st\as != 0 && st\as\frame != 0 && st\as\frame\head != 0 && l2_name_is_seg(st\as\frame\head, t\data, 0U, t\length) != 0
            return: 1
        k: k + 1
    ---
return: 0

fn: l2_path_root (const: @(char pd); size_t: pn; @: int out_ni; @: int out_res; @: int out_oi; @: int out_root; @: int out_fi) int
    size_t: off 0U
    size_t: len 0U
    int: i 0
    int: fid
    LmP0Text: root_name
    \out_ni: 0 - 1
    \out_res: 0 - 1
    \out_oi: 0 - 1
    \out_root: 0 - 1
    \out_fi: 0 - 1
    if: l2_seg_count(pd, pn) < 2
        return: 1
    if: l2_seg_at(pd, pn, 0, @ off, @ len) != 0 || len = 0U
        return: 1
    root_name.data: (cast: (@: char) (pd + off))
    root_name.length: len
    if: l2_cur_mi >= 0
        \out_oi: l2_resolved_own(l2_cur_mi, @ root_name)
        if: \out_oi < 0
            \out_fi: l2_param_find(l2_cur_mi, @ root_name)
            if: \out_fi >= 0
                # K02c: a hidden input's schema may be a merge result's (tagged): the walk then reads its slot map
                # (res), as it does an own merge root's.
                \out_ni: l2_input_schema(l2_cur_mi, \out_fi)
                if: l2_schema_kind(\out_ni) = 2
                    \out_res: l2_schema_index(\out_ni)
                    \out_ni: 0 - 1
                ---
                return: 0
            ---
        ---
    if: \out_oi >= 0
        \out_res: l2_own_res(\out_oi)
        return: 0
    # A resolved method name as a path root denotes its occurrence
    # Structure (FABLE-SONNET-NODE-ROOT-20260923-121, author on the -67/-84
    # blocker: "test\field == test\[0]field" -- a method's own cell is
    # observed from outside its activation through the occurrence root,
    # unit child at l2_unit_base + method index, exactly l2_own_ctr's
    # existing formula for any own field of another method). out_root
    # <= -1000 encodes this (mi = -1000 - out_root), leaving -2 (node) and
    # >= 0 (for) unambiguous. Bracket indexing (M\[N]x for a second
    # activation) is not built -- the occurrence machinery does not yet
    # distinguish repeated activations at all, so only the bare (implicit
    # [0]) spelling is wired here.
    i: 0
    while: i < l2_m_n
        if: l2_name_is_seg(l2_m_name[i], pd, off, len) != 0
            \out_root: 0 - 1000 - i
        i: i + 1
    if: \out_root <= 0 - 1000
        # The selected execution entry can be the very same original namespace
        # body. Resolve its fields through that body's existing NSF contract,
        # not through the procedure's own rows, which do not describe Array or
        # borrowed callable fields. Current-self emission remains shared.
        fid: l2_m_nsof(0 - 1000 - \out_root)
        if: l2_ns_source_body(fid) != 0
            \out_ni: fid
            \out_root: 0 - 1
            return: 0
        ---
        l2_uses_node_for_root: 1
        return: 0
    # `node` is a method's lexical parent; a unit's root -- E, a part's root's procedure (§10) -- has none.
    if: len = 4U && memcmp(pd + off, "node", 4U) = 0 && l2_cur_mi >= 0 && l2_cur_mi != l2_e && l2_ns_part(l2_m_nsof(l2_cur_mi)) < 0
        \out_root: 0 - 2
        l2_uses_node_for_root: 1
        return: 0
    # A control body (7b-3, l2_body_root): `for`, `while`, `if`, `else`, `catch` -- inside it, or after its `end:`.
    fid: l2_body_root(l2_cur_mi, pd, off, len)
    if: fid >= 0
        \out_root: fid
        l2_uses_node_for_root: 1
        return: 0
    # D-28 (steps/defects.md, author's reading A): a formal parameter is
    # the nearest lexical binding for its own name and must shadow a
    # unit-level named Structure sharing that spelling -- tried and
    # returned on FIRST, ahead of the named-Structure/method-result loops
    # below, not as a fallback tried only once those already missed (the
    # order this sat in before, which let a typed formal's own name never
    # be seen at all whenever a unit-level Structure of the same spelling
    # also existed). \out_ni comes only from the formal's own DECLARED
    # type (l2_nsty_get, set at method registration when the formal's
    # declaration frame head is itself a known Structure name) -- never
    # inferred from the formal's NAME (norm §3: a type comes only from
    # the declaration, no name specials). A generically-typed formal
    # (e.g. the L1-style `@(Lmx x)` spelling, whose declared type is the
    # opaque Lmx, not a Structure) keeps \out_ni < 0 here: the root
    # itself is still recognized (\out_fi is set, so l2_emit_path_to's
    # existing oi<0&&fi>=0 branch correctly seeds from it), but a field
    # path continuing off it is a located refusal -- correct for a
    # genuinely opaque formal, not a gap this ticket papers over.
    if: l2_cur_mi >= 0
        i: 0
        while: i < l2_m_arity[l2_cur_mi]
            if: l2_fn(l2_cur_mi, i) != 0 && l2_name_is_seg(l2_fn(l2_cur_mi, i), pd, off, len) != 0
                \out_fi: i
                \out_ni: l2_nsty_get(l2_cur_mi, i)
            i: i + 1
        ---
    if: \out_fi >= 0
        return: 0
    # A local reference `@: T name` to a named Structure (D-76): its value is the Structure, the
    # root; out_root -3 - i names local i (-2 is node, <= -1000 a method, >= 0 a for).
    if: l2_cur_mi >= 0
        i: 0
        while: i < l2_ml_n && i < 990
            if: l2_ml_ns[i] >= 0 && l2_name_is_seg(l2_ml_nm[i], pd, off, len) != 0
                \out_root: 0 - 3 - i
                \out_ni: l2_ml_ns[i]
            i: i + 1
        ---
    if: \out_root <= 0 - 3 && \out_root > 0 - 1000
        return: 0
    i: 0
    while: i < l2_ns_n
        if: l2_ns_parent[i] < 0 && l2_ns_local[i] < 0 && l2_name_is_seg(l2_ns_name[i], pd, off, len) != 0
            \out_ni: i
        i: i + 1
    ---
    if: \out_ni < 0 && \out_res < 0
        return: 1
return: 0

# The l2_ns_slot_named/l2_mrs_slot_named contract (kind 0 size_t, 1 char, 2
# nested, 3 reference, 4 callable, 5 array; 6 is reserved for a namespace
# field kind Opus's S3 part 2 is adding to l2_nsf_kind's own table, a
# different space this shares the same "kind" variable with mid-walk, so
# this ticket's own new kind is 7, not 6, to keep the two unambiguous: a
# plain own-declared int (own_ty 0 -- a leaf l2_ns_slot_named/l2_nsf_kind
# never needed, since a named-Structure field can only be declared
# size_t:/char:, but an ordinary own declaration commonly is int:, and
# refusing every int:-typed E/for-frame field would have refused far more
# of the existing corpus than a narrow gap);
# out_ent the target ni for kind 2/3), but the search is l2_own_* by (mi,
# host) instead of l2_nsf_* by ni: node/for's segment 1 (FABLE-SONNET-
# NODE-ROOT-20260923-121) is a field of an own-declared scope (E's
# top-level own fields, or a for-frame's hosted own fields), not of a
# named Structure type. Returns the found own-index (never the arena
# offset -- l2_own_uchild/l2_own_fchild depend on l2_layout_owns, an
# emit-setup pass; l2_path_kind, a check-time caller, never reads the
# numeric value, only the found/not-found sign, so this stays timing-safe
# for both callers and lets l2_emit_path translate own-index to the real
# offset itself, only once it is safe to). A field whose own-declared
# type is none of these (pointer, callable, Structure-typed without a
# recorded nsty) is not mapped to a kind here and reads as not found --
# refusing is the honest state until that wider capability is built, not
# a wrong kind. Kinds 8 (unsigned) and 9 (ulong) reuse plain numeral
# parsing exactly like 0 (size_t) and 7 (int) -- see l2_path_rhs -- and
# store through lmx_unsigned_store_known/lmx_ulong_store_known, the same
# helpers l2_own_store_helper already names for an own field.
fn: l2_own_seg_scan (int: mi; const: @(LmP0Node host); const: @(char pd); size_t: off; size_t: len; @: int out_kind; @: int out_ent) int
    int: i 0
    int: j
    int: hit 0 - 1
    int: occurrence 0 - 1
    int: seen 0
    size_t: noff off
    size_t: nlen len
    \out_kind: 0 - 1
    \out_ent: 0 - 1
    if: l2_seg_split(pd, off, len, @ occurrence, @ noff, @ nlen) != 0
        return: 0 - 1
    while: i < l2_own_n
        if: l2_own_mi[i] = mi && l2_own_host[i] = (cast: (@: LmP0Node) host) && l2_own_name[i] != 0 && l2_own_name[i]\data != 0 && l2_own_name[i]\length = nlen && memcmp(l2_own_name[i]\data, pd + noff, nlen) = 0
            if: occurrence < 0
                if: l2_own_source_after(i, hit) != 0
                    hit: i
            ---
            else:
                seen: 0
                j: 0
                while: j < l2_own_n
                    if: j != i && l2_own_mi[j] = mi && l2_own_host[j] = host && l2_text_same(l2_own_name[j], l2_own_name[i]) != 0 && l2_own_source_after(i, j) != 0
                        seen: seen + 1
                    j: j + 1
                if: seen = occurrence
                    hit: i
            ---
        ---
        i: i + 1
    if: hit < 0
        return: 0 - 1
return: l2_own_seg_kind(hit, out_kind, out_ent)

# Classification is independent of name/occurrence selection. Both ordinary
# own paths and lexical-source paths read the same existing declaration row.
fn: l2_own_seg_kind (int: hit; @: int out_kind; @: int out_ent) int
    if: hit < 0 || hit >= l2_own_n
        return: -1
    \out_kind: l2_num_kind(l2_own_ty[hit])
    \out_ent: -1
    if: \out_kind >= 0
        return: hit
    if: l2_own_is_pointer(l2_own_ty[hit]) != 0 && l2_own_is_slot(hit) = 0
        \out_kind: 10
        \out_ent: l2_oc_ft(l2_own_ty[hit])
        return: hit
    if: l2_own_schema(hit) != -1 && l2_own_is_slot(hit) != 0
        \out_kind: 2
        \out_ent: l2_own_schema(hit)
        return: hit
return: 0 - 1

# One lexical source body supplies the occurrence order for all of its
# declarations, including named bodies with no own row. Resolve the existing
# producer by original P0 identity; never search a different scope by name.
# Metadata returns a source ordinal. Only project requests a committed child.
fn: l2_source_field_seg (int: mi; const: @(LmP0Node scope); const: @(char pd); size_t: off; size_t: len; int: project; @: int out_slot; @: int out_kind; @: int out_ent; @: int out_own; @: int out_ns) int
    const: @: LmP0Structure body 0
    const: @: LmP0Node source
    @: LmP0Field field
    @: LmP0Text name
    int: own
    int: ns
    int: row
    int: parent l2_m_nsof(mi)
    int: occurrence -1
    int: seen 0
    int: ordinal 0
    int: selected -1
    int: selected_own -1
    int: selected_ns -1
    size_t: noff off
    size_t: nlen len
    if: mi < 0 || mi >= l2_m_n || l2_seg_split(pd, off, len, @ occurrence, @ noff, @ nlen) != 0
        return: 1
    if: scope != 0
        body: l2_scope_block(scope)
    else:
        if: mi = l2_e
            body: l2_ruse_unit
        else:
            body: l2_ns_original_body(parent)
            if: body = 0 && l2_m_body[mi] != 0 && l2_m_body[mi]\as != 0
                body: l2_m_body[mi]\as\structure
        ---
    ---
    if: body = 0
        return: 1
    field: l2_next_active(body\first_field)
    while: field != 0
        source: l2_head_source_node(field\value)
        name: 0
        own: -1
        ns: -1
        row: 0
        while: row < l2_own_n
            if: l2_own_mi[row] = mi && l2_own_host[row] = scope && l2_head_source_node(l2_own_decl[row]) = source
                own: row
                name: l2_own_name[row]
            row: row + 1
        ---
        if: own < 0
            row: 0
            while: row < l2_ns_n
                if: l2_head_source_node(l2_ns_at[row]) = source && l2_ns_original_body(row) != 0
                    ns: row
                    name: l2_ns_name[row]
                row: row + 1
            ---
        ---
        if: name != 0 && name\data != 0 && name\length = nlen && memcmp(name\data, pd + noff, nlen) = 0
            if: occurrence < 0 || seen = occurrence
                selected: ordinal
                selected_own: own
                selected_ns: ns
            seen: seen + 1
        ---
        if: ordinal = c.INT_MAX
            l2_error(l2_src, field\value, "size overflow")
            return: -1
        ordinal: ordinal + 1
        field: l2_next_active(field\next)
    ---
    if: selected < 0
        return: 1
    \out_slot: selected
    if: selected_own >= 0
        if: l2_own_seg_kind(selected_own, out_kind, out_ent) < 0
            return: -1
        if: project != 0
            \out_slot: l2_graph_field_child(selected_own)
        if: out_own != 0
            \out_own: selected_own
    ---
    else:
        if: selected_ns < 0
            return: 1
        \out_kind: 2
        \out_ent: selected_ns
        if: out_ns != 0
            \out_ns: selected_ns
        # COUNT counts only operand topology and emits no child coordinate.
        # After it, never substitute this seed for an uncommitted place.
        if: project != 0 && l2_construct_phase != 0
            if: mi = l2_e && scope = 0
                \out_slot: l2_source_unit_slot(l2_ns_at[selected_ns])
            else:
                if: parent < 0 || l2_ns_parent[selected_ns] != parent
                    return: -1
                \out_slot: l2_ns_field_in_parent(selected_ns)
            ---
        ---
    ---
    if: \out_slot < 0
        return: -1
return: 0

# The path kind of a number field of own type ty (l2_own_seg_scan's codes), or -1.
fn: l2_num_kind (int: ty) int
    if: ty = 2
        return: 0
    if: ty = 1
        return: 1
    if: ty = 0
        return: 7
    if: ty = 3
        return: 8
    if: ty = 36
        return: 9
return: 0 - 1

# `node\name` in method mi (book §3; Codex, 2026-09-28): a value field of the BODY of mi's lexical parent -- never
# its args or return part, the signature's descriptors.  For a nested method the parent is its host's occurrence:
# an own field the host declares at method level, at its slot; or a formal of the host, as the body field the merge
# of a returned node appends for it after the host's width (l2_mad_emit) -- the host itself has no such field, so a
# direct call reads absence there (X1), never the args part.  For any other method, as l2_e_own_seg says.  0 and
# *slot, *kind, *ent (l2_own_seg_scan's kinds; a Structure the slot holds itself is kind 2), or 1.
# Resolve first; only an operand-producing consumer requests a physical child. Metadata
# carries the selected own/formal row, never a guessed future graph coordinate.
fn: l2_node_seg_resolve (int: mi; const: @(char pd); size_t: off; size_t: len; int: project; @: int out_slot; @: int out_kind; @: int out_ent; @: int out_own; @: int out_ns) int
    int: host
    int: oi
    int: ni
    int: j 0
    \out_slot: 0 - 1
    \out_kind: 0 - 1
    \out_ent: 0 - 1
    if: out_own != 0
        \out_own: 0 - 1
    if: out_ns != 0
        \out_ns: -1
    host: l2_mad_host_of(mi)
    ni: l2_m_nsof(mi)
    # A retained nested definition's lexical space is its real source owner.
    # Resolve that owner's declarations, not the program unit's same spelling.
    if: host < 0 && ni >= 0 && l2_ns_parent[ni] >= 0 && l2_ns_source_body(ni) != 0
        host: l2_ns_proc[l2_ns_parent[ni]]
        if: host < 0
            return: 1
        ---
    # Slice 2c-4: a method's own named Structure's procedure runs over S (lmx_call_prim(S, S): node = S's parent), and
    # S is a child of the Structure that holds its slot (l2_emit_local_ns): the method's occurrence -- `node\name` is a
    # field of the method's body, at its slot, as a nested method's is of its host's -- or, for S declared in a body,
    # that body's Structure: a field declared in that body.  Never a formal: that is the method's args part, which
    # `node` never names (a nested method's formal is the merge's appended field, below).
    if: host < 0 && l2_m_nsof(mi) >= 0 && l2_ns_local[l2_m_nsof(mi)] >= 0
        host: l2_ns_local[l2_m_nsof(mi)]
        oi: l2_own_of_local_ns(host, l2_m_nsof(mi))
        if: oi >= 0 && l2_own_host[oi] != 0
            return: l2_source_field_seg(host, l2_own_host[oi], pd, off, len, project, out_slot, out_kind, out_ent, out_own, out_ns)
        ---
    if: host < 0
        host: l2_m_part(mi)
        if: host >= 0
            if: l2_part_ns[host] < 0 || l2_ns_proc[l2_part_ns[host]] < 0
                return: 1
            host: l2_ns_proc[l2_part_ns[host]]
        else:
            host: l2_e
        ---
        return: l2_source_field_seg(host, 0, pd, off, len, project, out_slot, out_kind, out_ent, out_own, out_ns)
    ---
    oi: l2_source_field_seg(host, 0, pd, off, len, project, out_slot, out_kind, out_ent, out_own, out_ns)
    if: oi != 1
        return: oi
    ---
    if: l2_mad_host_of(mi) < 0
        return: 1
    while: j < l2_m_arity[host]
        if: l2_fn(host, j) != 0 && l2_name_is_seg(l2_fn(host, j), pd, off, len) != 0
            \out_slot: j
            if: project != 0
                \out_slot: l2_m_width(host) + j
            if: l2_nsty_get(host, j) >= 0
                \out_kind: 2
                \out_ent: l2_nsty_get(host, j)
                return: 0
            ---
            \out_kind: l2_num_kind(l2_own_ty_of_param(l2_ft(host, j)))
            if: \out_kind < 0
                return: 1
            return: 0
        ---
        j: j + 1
    ---
return: 1

fn: l2_node_seg (int: mi; const: @(char pd); size_t: off; size_t: len; @: int out_slot; @: int out_kind; @: int out_ent; @: int out_own) int
return: l2_node_seg_resolve(mi, pd, off, len, 1, out_slot, out_kind, out_ent, out_own, 0)

fn: l2_node_seg_meta (int: mi; const: @(char pd); size_t: off; size_t: len; @: int out_row; @: int out_kind; @: int out_ent; @: int out_own) int
return: l2_node_seg_resolve(mi, pd, off, len, 0, out_row, out_kind, out_ent, out_own, 0)

# The field `node\name` names in the method being read (l2_cur_mi): a field of its lexical parent -- for a
# method of the source the unit, whose fields are E's own; for a method of a program part its part's root,
# whose fields are that root's procedure's own (§10), and none when the part's root holds none.
fn: l2_e_own_seg (const: @(char pd); size_t: off; size_t: len; @: int out_kind; @: int out_ent) int
return: l2_e_own_seg_mi(l2_cur_mi, pd, off, len, out_kind, out_ent)

# The same for method mi.
fn: l2_e_own_seg_mi (int: mi; const: @(char pd); size_t: off; size_t: len; @: int out_kind; @: int out_ent) int
    int: k
    k: l2_m_part(mi)
    if: k >= 0 && l2_part_ns[k] >= 0 && l2_ns_proc[l2_part_ns[k]] >= 0
        return: l2_own_seg_scan(l2_ns_proc[l2_part_ns[k]], 0, pd, off, len, out_kind, out_ent)
    if: l2_e < 0 || k >= 0
        \out_kind: 0 - 1
        \out_ent: 0 - 1
        return: 0 - 1
return: l2_own_seg_scan(l2_e, 0, pd, off, len, out_kind, out_ent)

fn: l2_for_own_seg (int: fid; const: @(char pd); size_t: off; size_t: len; @: int out_kind; @: int out_ent) int
    if: fid < 0 || fid >= l2_for_n
        \out_kind: 0 - 1
        \out_ent: 0 - 1
        return: 0 - 1
return: l2_own_seg_scan(l2_for_mi[fid], l2_for_node[fid], pd, off, len, out_kind, out_ent)

# Walk a path without emitting: reports the leaf kind (0 size_t, 1 char,
# 2 nested, 3 reference, 4 callable) and, for a callable leaf, the method index
# in out_mi. Returns -1 when the path does not resolve.
# Does this path pass through, or end inside, a qualified branch? Used to
# refuse an update: const: immutable is enforced where the update is written,
# not left to the runtime.
fn: l2_path_in_eternal (const: @(char pd); size_t: pn) int
    size_t: off 0U
    size_t: len 0U
    int: ni 0 - 1
    int: res 0 - 1
    int: oi 0 - 1
    int: root 0 - 1
    int: fi 0 - 1
    int: segs
    int: i 1
    int: slot
    int: kind 0 - 1
    int: ent 0 - 1
    if: l2_path_root(pd, pn, @ ni, @ res, @ oi, @ root, @ fi) != 0
        return: 0
    if: ni >= 0 && l2_ns_eternal[ni] >= 0
        return: 1
    segs: l2_seg_count(pd, pn)
    while: i < segs
        if: l2_seg_at(pd, pn, i, @ off, @ len) != 0 || len = 0U
            return: 0
        slot: 0 - 1
        if: res >= 0
            slot: l2_mrs_slot_named(res, pd, off, len, @ kind, @ ent)
        if: res < 0 && ni >= 0
            slot: l2_ns_named_row(ni, pd, off, len, @ kind, @ ent)
        if: slot < 0
            return: 0
        if: (kind = 2 || kind = 3) && ent >= 0 && l2_ns_eternal[ent] >= 0
            return: 1
        if: kind = 2 || kind = 3
            ni: ent
            res: 0 - 1
            if: l2_schema_kind(ent) = 2
                res: l2_schema_index(ent)
                ni: -1
            ---
        ---
        i: i + 1
    ---
return: 0

fn: l2_path_kind (const: @(char pd); size_t: pn; @: int out_mi) int
return: l2_path_contract(pd, pn, out_mi, 0)

# One field walk carries the exact leaf machine type and its receiving model.
fn: l2_path_contract (const: @(char pd); size_t: pn; @: int out_mi; @: int out_model) int
return: l2_path_resolve_contract(pd, pn, out_mi, out_model, 0)

fn: l2_path_resolve_contract (const: @(char pd); size_t: pn; @: int out_mi; @: int out_model; @@: L2TypeContract out_contract) int
    size_t: off 0U
    size_t: len 0U
    int: ni 0 - 1
    int: res 0 - 1
    int: oi 0 - 1
    int: segs
    int: i 1
    int: slot
    int: kind 0 - 1
    int: ent 0 - 1
    int: root 0 - 1
    int: fi 0 - 1
    int: bh 0 - 1
    int: bm 0 - 1
    int: nb
    int: field_own
    @: L2Declaration declaration
    \out_mi: 0 - 1
    if: out_contract != 0
        \out_contract: 0
    if: out_model != 0
        \out_model: 0 - 1
    if: l2_path_root(pd, pn, @ ni, @ res, @ oi, @ root, @ fi) != 0
        return: 0 - 1
    # The host the next name is resolved in (l2_body_seg): a body root's body, a method root's own level.
    if: root >= 0
        bh: root
    if: root <= 0 - 1000
        bm: 0 - 1000 - root
    # An own-rooted path (FABLE-SONNET-FIELD-PATHS-20260923-113): walk it
    # like a namespace root once seeded with the own field's Structure type,
    # if known. Unknown (ni stays -1) refuses at segment 1 below, the same
    # "no Structure here" outcome an ordinary namespace path gives for a
    # non-Structure slot -- no separate error path needed.
    if: oi >= 0
        ni: l2_own_nsty_get(oi)
    segs: l2_seg_count(pd, pn)
    while: i < segs
        if: l2_seg_at(pd, pn, i, @ off, @ len) != 0 || len = 0U
            return: 0 - 1
        slot: 0 - 1
        field_own: 0 - 1
        if: res >= 0
            slot: l2_mrs_slot_named(res, pd, off, len, @ kind, @ ent)
        # node/for (FABLE-SONNET-NODE-ROOT-20260923-121): segment 1 of a
        # node-/for-rooted path is a field of an own-declared scope, found
        # through l2_own_seg_scan, not l2_ns_slot_named -- root is only
        # meaningful at i=1, ni takes over for any further segment exactly
        # as an ordinary own/ns root already does.
        if: i = 1 && root = 0 - 2
            if: l2_node_seg_meta(l2_cur_mi, pd, off, len, @ slot, @ kind, @ ent, @ field_own) != 0
                slot: 0 - 1
            ---
        nb: 0 - 1
        if: bh >= 0
            slot: l2_for_own_seg(bh, pd, off, len, @ kind, @ ent)
            field_own: slot
        if: bm >= 0
            slot: l2_own_seg_scan(bm, 0, pd, off, len, @ kind, @ ent)
            field_own: slot
        # A body of the host: an inline nested Structure (kind 2), the next name that body's.
        if: slot < 0 && bh >= 0
            nb: l2_body_seg(l2_for_mi[bh], bh, pd, off, len, l2_cur_mi)
        if: slot < 0 && bm >= 0
            nb: l2_body_seg(bm, 0 - 1, pd, off, len, l2_cur_mi)
        if: nb >= 0
            slot: nb
            kind: 2
            ent: 0 - 1
        ---
        if: res < 0 && ((i > 1 && bh < 0 && bm < 0) || root = 0 - 1 || (root <= 0 - 3 && root > 0 - 1000)) && ni < 0
            return: 0 - 1
        if: res < 0 && ((i > 1 && bh < 0 && bm < 0) || root = 0 - 1 || (root <= 0 - 3 && root > 0 - 1000)) && ni >= 0
            slot: l2_ns_named_row(ni, pd, off, len, @ kind, @ ent)
        if: slot < 0
            return: 0 - 1
        if: i + 1 = segs && out_contract != 0
            declaration: 0
            if: field_own >= 0
                declaration: l2_declaration(l2_own_decl[field_own])
            if: field_own < 0 && res < 0 && ni >= 0 && slot < l2_nsf_n && l2_nsf_owner[slot] = ni
                declaration: l2_declaration(l2_nsf_source[slot])
            # A slot of a merge result has the contract of the declaration that contributed it.
            if: field_own < 0 && res >= 0 && l2_mrs_slot_row(res, slot) >= 0
                declaration: l2_declaration(l2_nsf_source[l2_mrs_slot_row(res, slot)])
            if: declaration != 0
                \out_contract: declaration\contract
        ---
        bh: nb
        bm: 0 - 1
        # Through a reference field `@: T q` (D-76): on into its pointee T. A merge result's
        # slot has the pointee its contributing declaration names.
        if: i + 1 < segs && kind = 10 && res < 0
            ent: l2_field_pointee(ni, field_own, pd, off, len)
        if: i + 1 < segs && kind = 10 && res >= 0
            ent: l2_mrs_ref_pointee(res, slot)
        if: i + 1 < segs && kind != 2 && kind != 3 && (kind != 10 || ent < 0)
            return: 0 - 1
        if: i + 1 < segs
            ni: ent
            res: 0 - 1
            if: l2_schema_kind(ent) = 2
                res: l2_schema_index(ent)
                ni: -1
            ---
        ---
        i: i + 1
    ---
    if: (kind = 2 || kind = 3) && out_model != 0
        \out_model: ent
    if: kind = 4
        \out_mi: ent
    if: kind = 10 || kind = 11
        # The reference field's pointee type code (FABLE-SONNET-SEND-REF-
        # 20260925-172 commit 1), the same raw code l2_ptr_type_word/
        # l2_kernel_ptr_word/l2_resolve_type_atom give a formal or local --
        # out_mi doubles as this carrier (unused by any other caller for
        # these two kinds), so l2_field_path_read can convert it to an own-
        # storage pointer code (l2_own_ty_of_param) without a new out param.
        \out_mi: ent
        if: out_model != 0
            \out_model: l2_field_pointee(ni, field_own, pd, off, len)
        if: out_model != 0 && res >= 0
            \out_model: l2_mrs_ref_pointee(res, slot)
return: kind

# A resolved named root denotes this activation's occurrence when it names
# the current method, including a named Structure's existing procedure.
fn: l2_path_current (int: mi; int: ns; int: method) int
    if: mi < 0
        return: 0
    if: method = mi
        return: 1
    if: ns >= 0 && l2_ns_proc[ns] = mi
        return: 1
return: 0

# Emit the walk that leaves l2_pxp addressing the LEAF SLOT of the path.
fn: l2_emit_path (const: @(char pd); size_t: pn; int: mi; const: @(char ind); const: @(LmP0Node at); @: int out_kind) int
return: l2_emit_path_to(pd, pn, mi, ind, at, out_kind, 0)

# The same walk: descriptor leaves stay in l2_pst, primitive leaves in l2_pxp.
# arr_ok=1 additionally selects an Array descriptor cell for indexing;
# arr_ok=2 restricts the operand to a Structure for the existing merge route.
fn: l2_emit_path_to (const: @(char pd); size_t: pn; int: mi; const: @(char ind); const: @(LmP0Node at); @: int out_kind; int: arr_ok) int
    size_t: off 0U
    size_t: len 0U
    int: ni 0 - 1
    int: res 0 - 1
    int: oi 0 - 1
    int: segs
    int: i 1
    int: slot
    int: kind 0 - 1
    int: ent 0 - 1
    int: root 0 - 1
    int: fi 0 - 1
    int: bh 0 - 1
    int: bm 0 - 1
    int: nb
    int: projected
    @: L2GraphPlace stop
    int: field_own
    @: L2GraphField actual_field
    int: current 0
    int: view_mi mi
    int: view_key -1
    int: segocc
    []: char l2_proot_own 64
    L2Tx: l2_proot_tx
    @: L2Tx l2_proot l2_tx_local(@ l2_proot_tx, l2_proot_own, 64U)
    []: char sl 40
    if: l2_path_root(pd, pn, @ ni, @ res, @ oi, @ root, @ fi) != 0
        return: l2_error(l2_src, at, "unknown field path root")
    # The host the next name is resolved in, as l2_path_kind: a body root's body, a method root's own level.
    if: oi < 0 && root >= 0
        bh: root
    if: oi < 0 && root <= 0 - 1000
        bm: 0 - 1000 - root
    if: oi < 0 && fi < 0 && (root = 0 - 1 || root <= 0 - 1000)
        current: l2_path_current(mi, ni, bm)
    segs: l2_seg_count(pd, pn)
    # An own-rooted path (FABLE-SONNET-FIELD-PATHS-20260923-113): seed l2_pst
    # from a genuine load of the own field -- l2_emit_path_load already does
    # the null-check/typed-load an own cell needs, and l2_pst is
    # then just that loaded reference, handed to the same per-segment walk
    # below a namespace or bound-result root already uses unchanged.
    # §7b: a bare own field as the root is its working value -- the reference the activation holds (dirty.md §1.1: a
    # reference path keeps its graph contract from there on); a field with no working value is its cell.
    if: oi >= 0 && l2_own_cached(l2_work_mi, oi) != 0 && l2_own_load(oi, l2_proot) != 0
        return: 1
    if: oi >= 0 && l2_own_cached(l2_work_mi, oi) = 0 && l2_emit_path_load(mi, oi, ind, l2_proot) != 0
        return: 1
    if: oi >= 0 && c.fprintf(l2_out, "%sl2_pst: %s\n", ind, l2_proot\data) < 0
        return: 1
    if: oi >= 0
        ni: l2_own_nsty_get(oi)
    # A typed-formal root (Opus's D1, folded into -121): the formal's own
    # value IS l2_pst directly, a pointer argument already, not a name in
    # the unit's own scope -- ni here is only the formal's declared TYPE,
    # for the segment walk below, never a unit-level declaration to seed
    # from (that would read the static declaration child, not the passed
    # argument). Mirrors the own-field seed above; guards every ni>=0
    # branch after it so this and the ordinary named-declaration seed
    # never both fire for the same root.
    if: oi < 0 && fi >= 0 && l2_tok_formal(mi, fi, l2_proot) != 0
        return: 1
    if: oi < 0 && fi >= 0 && c.fprintf(l2_out, "%sl2_pst: %s\n%sif: l2_pst = 0\n", ind, l2_proot\data, ind) < 0
        return: 1
    # A local reference root (D-76): the local's own value is the Structure.
    if: oi < 0 && root <= 0 - 3 && root > 0 - 1000 && (l2_tok_tx(l2_proot, l2_ml_nm[0 - 3 - root]) != 0 || c.fprintf(l2_out, "%sl2_pst: (cast: (@: Lmx) %s)\n%sif: l2_pst = 0\n", ind, l2_proot\data, ind) < 0 || l2_emit_path_bail(mi, ind) != 0)
        return: 1
    if: current != 0 && c.fprintf(l2_out, "%sl2_pst: self\n", ind) < 0
        return: 1
    if: current = 0 && oi < 0 && fi < 0 && (root > 0 - 3 || root <= 0 - 1000) && ni >= 0 && l2_ns_eternal[ni] < 0 && c.fprintf(l2_out, "%sl2_pst: lmx_arena_ref_struct(%s, %uU)\n%sif: l2_pst = 0\n", ind, l2_unit_ref, (cast: (unsigned) (l2_ns_unit_slot(ni))), ind) < 0
        return: 1
    if: current = 0 && oi < 0 && fi < 0 && (root > 0 - 3 || root <= 0 - 1000) && ni >= 0 && l2_ns_eternal[ni] >= 0 && c.fprintf(l2_out, "%sl2_pst: lmx_arena_ref_struct(%s, %uU)\n%sif: l2_pst = 0\n", ind, l2_unit_ref, (cast: (unsigned) (l2_ebr_unit_slot(l2_ns_eternal[ni]))), ind) < 0
        return: 1
    if: oi < 0 && fi >= 0 && l2_emit_path_bail(mi, ind) != 0
        return: 1
    if: current = 0 && oi < 0 && fi < 0 && (root > 0 - 3 || root <= 0 - 1000) && ni >= 0 && l2_emit_path_bail(mi, ind) != 0
        return: 1
    # node/for (FABLE-SONNET-NODE-ROOT-20260923-121): node's value is the
    # method's own `node`, its lexical parent -- the unit, or for a method of a
    # program part its part's root (§10) -- needing no
    # arena hop to reach; for's value is the innermost enclosing for-frame's
    # own Structure, one hop from self at its already-laid-out child slot
    # (l2_for_uchild, safe here: l2_emit_path only ever runs after the
    # layout pass that fills it, never at check time).
    if: oi < 0 && root = 0 - 2 && c.fprintf(l2_out, "%sl2_pst: node\n", ind) < 0
        return: 1
    # 7b-3: a control body root is the prologue's handle of that body (l2_h<k>: self, then each enclosing body) -- at any
    # depth, inside the body or after its `end:`.
    if: oi < 0 && root >= 0 && c.fprintf(l2_out, "%sl2_pst: l2_h%d\n%sif: l2_pst = 0\n", ind, root, ind) < 0
        return: 1
    if: oi < 0 && root >= 0 && l2_emit_path_bail(mi, ind) != 0
        return: 1
    # A resolved method name as a root (FABLE-SONNET-NODE-ROOT-20260923-121,
    # author on the -67/-84 blocker): its occurrence, unit child at
    # l2_unit_base + that method's index -- l2_own_ctr's own formula for
    # any own field of another method, safe here for the same reason the
    # for-frame seed above is (post-layout only).
    if: current = 0 && oi < 0 && root <= 0 - 1000 && c.fprintf(l2_out, "%sl2_pst: lmx_arena_ref_struct(%s, %uU)\n%sif: l2_pst = 0\n", ind, l2_unit_ref, (cast: (unsigned) (l2_occ_slot(0 - 1000 - root))), ind) < 0
        return: 1
    if: current = 0 && oi < 0 && root <= 0 - 1000 && l2_emit_path_bail(mi, ind) != 0
        return: 1
    view_key: fi
    if: oi >= 0
        view_mi: l2_own_mi[oi]
        view_key: l2_d105_own_key(oi)
    ---
    # c.* / foreign member paths on formals and activation locals are emitted by
    # l2_raw_path via l2_ty_raw_c_members (FABLE-GROKBOT-C-MEMBER-ACCESS part1).
    # Structure-typed roots keep this L2 slot walk; do not divert Lmx projection owns.
    while: i < segs
        if: l2_seg_at(pd, pn, i, @ off, @ len) != 0 || len = 0U
            return: l2_error(l2_src, at, "malformed field path")
        slot: 0 - 1
        field_own: 0 - 1
        if: res >= 0
            slot: l2_mrs_slot_named(res, pd, off, len, @ kind, @ ent)
        if: i = 1 && root = 0 - 2 && l2_node_seg(l2_cur_mi, pd, off, len, @ slot, @ kind, @ ent, @ field_own) != 0
            slot: 0 - 1
        nb: 0 - 1
        if: bh >= 0
            slot: l2_for_own_seg(bh, pd, off, len, @ kind, @ ent)
            field_own: slot
            if: slot >= 0
                slot: l2_graph_field_child(slot)
            ---
        if: bm >= 0
            slot: l2_own_seg_scan(bm, 0, pd, off, len, @ kind, @ ent)
            field_own: slot
            if: slot >= 0
                slot: l2_graph_field_child(slot)
            ---
        # A body resolves lexically, but its physical suffix comes only from
        # the completed edge relation shared with the walker.
        projected: 0
        if: slot < 0 && bh >= 0
            nb: l2_body_seg(l2_for_mi[bh], bh, pd, off, len, l2_cur_mi)
        if: slot < 0 && bm >= 0
            nb: l2_body_seg(bm, 0 - 1, pd, off, len, l2_cur_mi)
        if: nb >= 0
            if: l2_for_place = 0 || l2_for_place[nb] = 0
                return: l2_error(l2_src, at, "internal: a control body has no graph place")
            stop: 0
            if: bh >= 0
                stop: l2_for_place[bh]
            if: l2_emit_graph_path(l2_for_place[nb], stop, mi, ind) != 0
                return: 1
            projected: 1
            slot: 0
            kind: 2
            ent: 0 - 1
        ---
        # A declaration's complete place, not its lexical header, determines
        # which real container holds its cell.
        if: field_own >= 0 && (bh >= 0 || bm >= 0 || (i = 1 && root = -2))
            actual_field: l2_graph_field(field_own)
            if: actual_field = 0
                return: 1
            stop: 0
            if: bh >= 0
                stop: l2_for_place[bh]
            if: i = 1 && root = -2 && l2_node_graph_stop(l2_cur_mi, @ stop) != 0
                return: 1
            if: l2_emit_graph_path(actual_field\holder, stop, mi, ind) != 0
                return: 1
        ---
        if: res < 0 && ((i > 1 && bh < 0 && bm < 0) || root = 0 - 1 || (root <= 0 - 3 && root > 0 - 1000)) && ni < 0
            return: l2_error(l2_src, at, "field path goes through a slot with no Structure")
        if: res < 0 && ((i > 1 && bh < 0 && bm < 0) || root = 0 - 1 || (root <= 0 - 3 && root > 0 - 1000)) && ni >= 0
            slot: l2_ns_slot_named(ni, pd, off, len, @ kind, @ ent)
        if: slot < 0
            return: l2_error(l2_src, at, "unknown field path segment")
        # The first field of an admitted input or own reference uses the same
        # completed correspondence. Later segments retain their structural path.
        # K01: the EDGE is the required field plus the half this use's own
        # selector names -- bare `name` is the value's LAST occurrence (the map's
        # second half), `[N]name` its occurrence N (the ordinal half).  Both
        # resolve to one required slot here; they are different candidate slots.
        c.sprintf(sl, "%uU", (cast: (unsigned) slot))
        if: view_key != -1 && l2_d105_sub(view_mi, view_key) != 0
            segocc: 0 - 1
            if: l2_seg_occurrence(pd, off, len, @ segocc) != 0
                return: l2_error(l2_src, at, "malformed field path segment")
            if: l2_d105_emit_slot(view_mi, view_key, slot, segocc < 0, ind) != 0
                return: 1
            c.sprintf(sl, "l2_dslot")
        ---
        if: i + 1 < segs && kind = 10 && res < 0
            ent: l2_field_pointee(ni, field_own, pd, off, len)
        if: i + 1 < segs && kind = 10 && res >= 0
            ent: l2_mrs_ref_pointee(res, slot)
        view_key: -1
        if: i + 1 < segs && kind = 10 && field_own >= 0
            view_mi: l2_own_mi[field_own]
            view_key: l2_d105_own_key(field_own)
        ---
        if: i + 1 < segs && kind != 2 && kind != 3 && (kind != 10 || ent < 0)
            return: l2_error(l2_src, at, "field path goes through a slot with no Structure")
        # Through a reference field (D-76): its pointer cell holds the pointee Structure.
        if: i + 1 < segs && kind = 10 && c.fprintf(l2_out, "%sl2_pxp: lmx_arena_ref_cell(l2_pst, %s)\n%sif: l2_pxp = 0\n", ind, sl, ind) < 0
            return: 1
        if: i + 1 < segs && kind = 10 && l2_emit_path_bail(mi, ind) != 0
            return: 1
        if: i + 1 < segs && kind = 10 && c.fprintf(l2_out, "%sl2_pst: (cast: (@: Lmx) lmx_pointer_value_known(l2_pxp[0]))\n%sif: l2_pst = 0\n", ind, ind) < 0
            return: 1
        if: i + 1 < segs && kind != 10 && projected = 0 && c.fprintf(l2_out, "%sl2_pst: lmx_arena_ref_struct(l2_pst, %s)\n%sif: l2_pst = 0\n", ind, sl, ind) < 0
            return: 1
        if: i + 1 < segs && projected = 0 && l2_emit_path_bail(mi, ind) != 0
            return: 1
        if: i + 1 < segs
            ni: ent
            res: 0 - 1
            if: l2_schema_kind(ent) = 2
                res: l2_schema_index(ent)
                ni: -1
            ---
        ---
        bh: nb
        bm: 0 - 1
        # K03 S7b: a merge operand (arr_ok 2) ends at a Structure field, kind 2 or 3: l2_pst is the Structure it holds.
        if: i + 1 = segs && arr_ok = 2 && kind != 2 && kind != 3
            return: l2_error(l2_src, at, "this merge operand form is not lowered yet")
        if: i + 1 = segs && arr_ok = 2 && c.fprintf(l2_out, "%sl2_pst: lmx_arena_ref_struct(l2_pst, %s)\n%sif: l2_pst = 0\n", ind, sl, ind) < 0
            return: 1
        if: i + 1 = segs && arr_ok = 2 && l2_emit_path_bail(mi, ind) != 0
            return: 1
        if: i + 1 = segs && arr_ok = 2
            \out_kind: kind
            i: i + 1
            continue
        ---
        if: i + 1 = segs && kind != 0 && kind != 1 && kind != 2 && kind != 3 && kind != 4 && kind != 7 && kind != 8 && kind != 9 && kind != 10 && kind != 11 && (arr_ok = 0 || (kind != 5 && kind != 6))
            return: l2_error(l2_src, at, "a field path must end at a primitive field")
        if: i + 1 = segs && (kind = 2 || kind = 3 || kind = 4) && projected = 0 && c.fprintf(l2_out, "%sl2_pst: lmx_arena_ref_struct(l2_pst, %s)\n%sif: l2_pst = 0\n", ind, sl, ind) < 0
            return: 1
        if: i + 1 = segs && (kind = 2 || kind = 3 || kind = 4) && projected = 0 && l2_emit_path_bail(mi, ind) != 0
            return: 1
        if: i + 1 = segs && kind != 2 && kind != 3 && kind != 4 && c.fprintf(l2_out, "%sl2_pxp: lmx_arena_ref_cell(l2_pst, %s)\n%sif: l2_pxp = 0\n", ind, sl, ind) < 0
            return: 1
        if: i + 1 = segs && kind != 2 && kind != 3 && kind != 4 && l2_emit_path_bail(mi, ind) != 0
            return: 1
        # A number's cell is never empty where it is held: an empty one is a place a partial copy does not hold
        # (READ-FIELD-CLOSURE), and a read or write through the path is refused, never taken as nothing.
        if: i + 1 = segs && (kind = 0 || kind = 1 || kind = 7 || kind = 8 || kind = 9) && (c.fprintf(l2_out, "%sif: l2_pxp[0] = 0\n", ind) < 0 || l2_emit_invariant(ind, "a field path reads an absent place") != 0)
            return: 1
        if: i + 1 = segs
            \out_kind: kind
        ---
        i: i + 1
    ---
return: 0

# Read-position field path, root \ field only (single hop): fresh\value, an
# ordinary formal's m\value, node\value, for\value, or a resolved method
# name's own\value (FABLE-SONNET-NODE-ROOT-20260923-121: node/for/an
# occurrence root are ordinary roots of this same dispatcher now, ni/root
# seeded by l2_path_kind's own l2_path_root call, nothing special needed
# here beyond widening this gate to admit them). FABLE-SONNET-FIELD-
# PATHS-20260923-113. A bound merge result is a root of the same kind (D-61,
# FABLE-OPUS-MERGE-PARTS-20260926-193): l2_path_root already resolves it and
# l2_path_kind/l2_emit_path walk its slot map, so `R\x` in an expression is
# the value `v: R\x` reads -- it used to be an unresolved name, or, for an
# all-caps R, a raw C name gcc refused. Returns -1 when left does not name an
# own field, a namespace-typed name, a merge result, node/for in a method
# other than E, or a method --
# not this mechanism's path. Once left DOES resolve this way, any later
# failure is a real error (1), never a silent fall-through: an unknown
# right or a non-primitive leaf ends in the same diagnostics l2_path_kind/
# l2_emit_path already give a write. Chained reads (a\b\c as a value, not
# an assignment target) are not wired here; only the write side
# (l2_emit_path's own per-segment loop) chains. No emission: shared by the
# check-time and emit-time callers.
fn: l2_field_path_check (int: mi; const: @(LmP0Text left); const: @(LmP0Text right); @: int out_kind) int
    []: char buf_own 1024
    @: char buf 0
    size_t: n
    int: leaf_mi
    \out_kind: 0 - 1
    # A segment is a name: `merged\[N]x` is the occurrence branch's, not this one's.
    if: mi < 0 || left = 0 || right = 0 || left\data = 0 || right\data = 0 || l2_ident(right) = 0
        return: 0 - 1
    if: l2_raw_c_root(mi, left) != 0
        return: -1
    if: l2_own_visible(mi, left) < 0 && l2_nsty_of_name(mi, left) < 0 && l2_mres_find(mi, left) < 0 && l2_text_eq(left, "node") = 0 && l2_body_named(mi, left) < 0
        return: 0 - 1
    buf: l2_text_room(left\length + right\length + 2U, buf_own, 1024U)
    if: buf = 0
        return: l2_alloc_or(l2_src, 0, "out of memory")
    memcpy((cast: (@: void) buf), (cast: (@: void) left\data), left\length)
    buf[left\length]: 92
    memcpy((cast: (@: void) (buf + left\length + 1U)), (cast: (@: void) right\data), right\length)
    n: left\length + right\length + 1U
    \out_kind: l2_path_kind(buf, n, @ leaf_mi)
    if: \out_kind != 0 && \out_kind != 1 && \out_kind != 2 && \out_kind != 3 && \out_kind != 4 && \out_kind != 7 && \out_kind != 8 && \out_kind != 9 && \out_kind != 10 && \out_kind != 11
        return: 1
return: 0

fn: l2_field_path_read (int: mi; const: @(LmP0Text left); const: @(LmP0Text right); const: @(char ind); const: @(LmP0Node at); @: L2Tx dest) int
    []: char buf_own 1024
    @: char buf 0
    size_t: n
    int: kind
    int: fpc
    if: dest = 0
        return: 1
    fpc: l2_field_path_check(mi, left, right, @ kind)
    # A refusal is said here too: the check's own words (l2_check_fields), where a position the check does not see
    # would otherwise leave a bare 1.
    if: fpc = 1 && kind < 0
        return: l2_error(l2_src, at, "unknown field path segment")
    if: fpc = 1
        return: l2_error(l2_src, at, "a field path must end at a primitive field")
    if: fpc != 0
        return: fpc
    buf: l2_text_room(left\length + right\length + 2U, buf_own, 1024U)
    if: buf = 0
        return: l2_alloc_or(l2_src, at, "out of memory")
    memcpy((cast: (@: void) buf), (cast: (@: void) left\data), left\length)
    buf[left\length]: 92
    memcpy((cast: (@: void) (buf + left\length + 1U)), (cast: (@: void) right\data), right\length)
    n: left\length + right\length + 1U
return: l2_path_text_read(mi, buf, n, ind, at, dest)

# The path buf[0..n), its leaf a value field, read into a temp named in dest (l2_emit_path walks it,
# any depth; the leaf cell is loaded as its kind's value).  One reading for a single hop
# (l2_field_path_read) and a deeper path in an expression (D-112/D-113).
# Stabilize the descriptor selected by the common field walk before another
# operand can overwrite its working register. This is an ordinary C local.
fn: l2_selected_occurrence_temp (const: @(char ind); @: L2Tx dest) int
    int: t l2_tn
    l2_tn: l2_tn + 1
    if: l2_tx_temp(dest, t) != 0
        return: 1
    if: c.fprintf(l2_out, "%s@: Lmx %s l2_pst\n", ind, dest\data) < 0
        return: 1
return: 0

fn: l2_path_text_read (int: mi; const: @(char buf); size_t: n; const: @(char ind); const: @(LmP0Node at); @: L2Tx dest) int
    int: kind
    int: t
    int: oty
    int: ent
    if: dest = 0
        return: 1
    if: l2_emit_path(buf, n, mi, ind, at, @ kind) != 0
        return: 1
    if: kind = 2 || kind = 3 || kind = 4
        return: l2_selected_occurrence_temp(ind, dest)
    if: c.fprintf(l2_out, "%sl2_xp: l2_pxp\n", ind) < 0
        return: 1
    t: l2_tn
    l2_tn: l2_tn + 1
    oty: l2_kind_cell_ty(kind)
    if: kind = 10 || kind = 11
        # A reference field leaf (FABLE-SONNET-SEND-REF-20260925-172 commit
        # 1, RESTORED in commit 4 after the author's ruling on Q26.2: a
        # slot holding a Structure's address directly makes that Structure
        # a CHILD of the holder; a reference (`@: T name`) is a reference
        # TO a reference, so the slot must hold a pointer CELL's address,
        # and reading it is l2_emit_cell_load's ordinary own-storage-cell
        # convention, one level removed from a bare primitive -- NOT a
        # direct deref of the slot itself (D-56's now-reverted shortcut,
        # which assumed the slot held the pointee directly; the letter's
        # OWN sender slot was the actual bug, not this kind's shape -- see
        # steps/send-ref-172.md commit 4). Its pointee code is not fixed
        # per kind the way a primitive's is, so re-derive it (l2_path_kind's
        # out_mi carries it for these two kinds) and convert formal/local
        # raw code -> own-storage code the same way any other declared
        # pointer own field does (l2_own_ty_of_param).
        ent: 0 - 1
        l2_path_kind(buf, n, @ ent)
        oty: l2_own_ty_of_param(ent)
    if: l2_emit_cell_load(oty, ind, t, at) != 0
        return: 1
    if: l2_tx_temp(dest, t) != 0
        return: l2_alloc_or(l2_src, at, "out of memory")
return: 0

# The value type a primitive field kind loads as (l2_emit_cell_load): size_t, char, int,
# unsigned, ulong; -1 for any other kind.

# D-112/D-113: a field path deeper than one field, written in value position -- P0 gives `m\in\x` as the
# atoms `m`, `\`, `in`, `\`, `x` -- joined into buf.  The number of fields it takes (5, 7, ...), or 0 when f
# starts no such path: a single hop stays l2_field_path_read's.
fn: l2_path_chain (@: LmP0Field f; @: char buf; size_t: cap; @: size_t out_n) int
    @: LmP0Field s
    @: LmP0Field g
    int: taken 1
    size_t: n 0U
    \out_n: 0U
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM || f\value\as = 0 || f\value\as\atom = 0
        return: 0
    # `node` and a control body's head (`for`, `while`, `if`, `else`, `catch`) are reserved -- no identifiers -- and roots
    # of a path all the same (l2_path_chain_check; which body, l2_body_root).
    if: l2_ident(f\value\as\atom) = 0 && l2_text_eq(f\value\as\atom, "node") = 0 && l2_body_head_word(f\value\as\atom) = 0
        return: 0
    if: f\value\as\atom\length + 1U > cap
        return: 0
    memcpy((cast: (@: void) buf), (cast: (@: void) f\value\as\atom\data), f\value\as\atom\length)
    n: f\value\as\atom\length
    s: l2_next_active(f\next)
    while: s != 0 && s\value != 0 && s\value\kind = c.LM_P0_NODE_ATOM && s\value\as != 0 && l2_is_slash(s\value\as\atom) != 0
        g: l2_next_active(s\next)
        # A later name may head a control body too (l2_path_kind: a body of the host).
        if: g = 0 || g\value = 0 || g\value\kind != c.LM_P0_NODE_ATOM || g\value\as = 0 || g\value\as\atom = 0 || (l2_ident(g\value\as\atom) = 0 && l2_body_head_word(g\value\as\atom) = 0)
            break
        if: n + 1U + g\value\as\atom\length + 1U > cap
            return: 0
        buf[n]: 92
        memcpy((cast: (@: void) (buf + n + 1U)), (cast: (@: void) g\value\as\atom\data), g\value\as\atom\length)
        n: n + 1U + g\value\as\atom\length
        taken: taken + 2
        s: l2_next_active(g\next)
    ---
    if: taken < 5
        return: 0
    buf[n]: 0
    \out_n: n
return: taken

# D-112/D-113: the path buf[0..n) rooted at `root` (a declared field, a named Structure, a bound merge
# result, node, for -- the roots of l2_field_path_check), walked to its leaf by the general path walk.
# -1: not a path of such a root; 0: its leaf is a value field (*out_kind); 1: its leaf is not a value
# field; 2: a segment names no field.
fn: l2_path_chain_check (int: mi; const: @(LmP0Text root); const: @(char buf); size_t: n; @: int out_kind) int
    int: leaf_mi
    int: root_ns
    int: root_result
    int: root_own
    int: root_body
    int: root_formal
    int: saved_cur l2_cur_mi
    int: status
    \out_kind: 0 - 1
    if: mi < 0 || root = 0 || root\data = 0 || buf = 0
        return: 0 - 1
    # A complete operand can include ordinary pointer indexing without any
    # structural-field step. Leave it to its selected binding's index route.
    if: l2_seg_count(buf, n) < 2
        return: -1
    if: l2_raw_c_root(mi, root) != 0
        return: -1
    # A missing tail is meaningful only after the ordinary root resolver
    # admits this root in the selected occurrence. A reserved spelling alone
    # does not establish a lexical parent or another addressable root.
    l2_cur_mi: mi
    status: l2_path_root(buf, n, @ root_ns, @ root_result, @ root_own, @ root_body, @ root_formal)
    l2_cur_mi: saved_cur
    if: status != 0
        return: 0 - 1
    \out_kind: l2_path_kind(buf, n, @ leaf_mi)
    if: \out_kind < 0
        return: 2
    if: \out_kind != 0 && \out_kind != 1 && \out_kind != 2 && \out_kind != 3 && \out_kind != 4 && \out_kind != 7 && \out_kind != 8 && \out_kind != 9 && \out_kind != 10 && \out_kind != 11
        return: 1
return: 0

fn: l2_kind_cell_ty (int: kind) int
    if: kind = 0
        return: 2
    if: kind = 1
        return: 1
    if: kind = 7
        return: 0
    if: kind = 8
        return: 3
    if: kind = 9
        return: 36
return: 0 - 1

# `merged\[N]x`: occurrence N of field x of bound merge result res, read into a temp named in
# dest -- the slot through the unit (l2_emit_path_to's merge-result root), then the cell.
fn: l2_mrs_occ_read (int: res; const: @(LmP0Text name); int: occ; int: mi; const: @(char ind); @: L2Tx dest; const: @(LmP0Node at)) int
    int: kind 0 - 1
    int: ent 0 - 1
    int: slot
    int: t
    []: char value_own 128
    L2Tx: value_tx
    @: L2Tx value l2_tx_local(@ value_tx, value_own, 128U)
    slot: l2_mrs_slot_nth(res, name, occ, @ kind, @ ent)
    if: slot < 0
        return: l2_error(l2_src, at, "merge occurrence index out of range")
    if: l2_kind_cell_ty(kind) < 0
        return: l2_error(l2_src, at, "a field path must end at a primitive field")
    if: l2_own_load(l2_mres_own[res], value) != 0 || c.fprintf(l2_out, "%sl2_pst: %s\n%sif: l2_pst = 0\n", ind, value\data, ind) < 0
        return: 1
    if: l2_emit_path_bail(mi, ind) != 0
        return: 1
    if: c.fprintf(l2_out, "%sl2_pxp: lmx_arena_ref_cell(l2_pst, %uU)\n%sif: l2_pxp = 0\n", ind, (cast: (unsigned) slot), ind) < 0
        return: 1
    if: l2_emit_path_bail(mi, ind) != 0
        return: 1
    if: c.fprintf(l2_out, "%sl2_xp: l2_pxp\n", ind) < 0
        return: 1
    t: l2_tn
    l2_tn: l2_tn + 1
    if: l2_emit_cell_load(l2_kind_cell_ty(kind), ind, t, at) != 0
        return: 1
return: l2_tx_temp(dest, t)

# INDEXED FIELD PATHS (S3, FABLE-OPUS-S3-MAIL-ARGS-20260923-122 part 2b; author Q10/Q15):
# `root\seg...[k]` and `root\seg...[k][j]`, where the path ends at an Array field of a
# declared Structure type -- kind 5, a fixed Array of int/char (`[]: T x N`), one index
# within its declared count; kind 6, `T: []: []: x`, an Array of references to T Arrays,
# one index (an inner Array: only inside length()) or two (an element).  The root is a
# typed one -- an own field or formal of a declared Structure type, or a unit-level
# declaration -- the ones whose segments are that type's fields; node/for/method roots
# and raw C paths stay with their own machinery.  Indices are decimal literals: L2 checks
# no bounds at run time (L2 spec 18.3), so a program guards with length().

# A decimal literal index (digits only).  0 = one, its value in out_v.
fn: l2_dec_literal (const: @(LmP0Text t); @: size_t out_v) int
    size_t: v 0U
    size_t: i 0U
    size_t: digit
    if: t = 0 || t\data = 0 || t\length = 0U || out_v = 0
        return: 1
    while: i < t\length
        if: t\data[i] < 48 || t\data[i] > 57
            return: 1
        digit: (cast: (size_t) (t\data[i] - 48))
        if: v > (((cast: (size_t) -1) - digit) / 10U)
            return: 1
        v: v * 10U + digit
        i: i + 1U
    ---
    \out_v: v
return: 0

# The leaf of a typed field path that is an Array field: its kind (5/6), element (0 int,
# 1 char) and, for kind 5, the declared count.  1 = the root is not a typed one, or the
# path does not end at an Array field.
fn: l2_path_arr_leaf (const: @(char pd); size_t: pn; @: int out_kind; @: int out_elem; @: size_t out_count) int
    int: kind 0 - 1
    int: ent 0 - 1
    int: row 0 - 1
    \out_kind: 0 - 1
    \out_elem: 0 - 1
    \out_count: 0U
    if: l2_path_field_leaf(pd, pn, @ kind, @ ent, @ row) != 0 || (kind != 5 && kind != 6)
        return: 1
    \out_kind: kind
    \out_elem: ent
    if: kind = 5
        \out_count: l2_nsf_val[row]
return: 0

# The declared Structure a typed field path ends at -- a nested written definition (kind 2) or
# a letter's payload of a named model (kind 3, l2_letter_ns_for) -- or -1.
fn: l2_path_struct_leaf (const: @(char pd); size_t: pn) int
    int: kind 0 - 1
    int: ent 0 - 1
    int: row 0 - 1
    if: l2_path_field_leaf(pd, pn, @ kind, @ ent, @ row) != 0 || (kind != 2 && kind != 3)
        return: -1
return: ent

# The leaf of a typed field path: its kind, its entity and the field row that declares it.
# 1 = the root is not a typed one, a step goes through a slot that is not a Structure, or a
# name is no declared field.
fn: l2_path_field_leaf (const: @(char pd); size_t: pn; @: int out_kind; @: int out_ent; @: int out_row) int
    size_t: off 0U
    size_t: len 0U
    int: ni 0 - 1
    int: res 0 - 1
    int: oi 0 - 1
    int: root 0 - 1
    int: fi 0 - 1
    int: segs
    int: i 1
    int: slot
    int: kind 0 - 1
    int: ent 0 - 1
    if: l2_path_root(pd, pn, @ ni, @ res, @ oi, @ root, @ fi) != 0
        return: 1
    if: oi >= 0
        ni: l2_own_nsty_get(oi)
    if: (ni < 0 && res < 0) || root != 0 - 1
        return: 1
    segs: l2_seg_count(pd, pn)
    while: i < segs
        if: l2_seg_at(pd, pn, i, @ off, @ len) != 0 || len = 0U
            return: 1
        # A merge result's slot is the field that contributed it (l2_mrs_slot_row); a slot with
        # no declaration is not a field of this route.
        if: res >= 0
            slot: l2_mrs_slot_row(res, l2_mrs_slot_named(res, pd, off, len, @ kind, @ ent))
        else:
            slot: l2_ns_named_row(ni, pd, off, len, @ kind, @ ent)
        ---
        if: slot < 0
            return: 1
        if: i + 1 < segs && kind != 2 && kind != 3
            return: 1
        if: i + 1 = segs
            \out_kind: kind
            \out_ent: ent
            \out_row: slot
        if: i + 1 < segs
            ni: ent
            res: 0 - 1
            if: l2_schema_kind(ent) = 2
                res: l2_schema_index(ent)
                ni: -1
            ---
        ---
        i: i + 1
    ---
return: 0

# One indexed field-path operand starting at f.  0 = one: the path text (pd, out_pn), its
# token count and the field after it, the leaf's kind and element, the number of indices
# (allow0 admits none, for length()) and the literal indices.  1 = the tokens are not
# this route's (not a typed root, or no index).  2 = they are, but unsupported: the path
# does not end at an Array field, an index is not a decimal literal, a kind-5 index is
# outside its declared count, or there are more indices than the field has levels.
# 3 = the root is a graph with no declared Structure type.
fn: l2_arr_operand (@: LmP0Field f; int: allow0; @: char pd; size_t: cap; @: size_t out_pn; @: int out_count; @@: LmP0Field out_after; @: int out_kind; @: int out_elem; @: int out_depth; @: size_t out_i0; @: size_t out_i1) int
    @: LmP0Field g
    @: LmP0Field nm
    @: LmP0Field idx
    @: LmP0Field cb
    size_t: pn 0U
    size_t: iv 0U
    size_t: i0 0U
    size_t: i1 0U
    size_t: count 0U
    int: n 1
    int: depth 0
    int: kind 0 - 1
    int: elem 0 - 1
    int: ni 0 - 1
    int: res 0 - 1
    int: oi 0 - 1
    int: root 0 - 1
    int: fi 0 - 1
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM || f\value\as = 0 || f\value\as\atom = 0 || l2_ident(f\value\as\atom) = 0 || pd = 0
        return: 1
    if: f\value\as\atom\length + 1U > cap
        return: 1
    memcpy((cast: (@: void) pd), (cast: (@: void) f\value\as\atom\data), f\value\as\atom\length)
    pn: f\value\as\atom\length
    g: l2_next_active(f\next)
    while: g != 0 && g\value != 0 && g\value\kind = c.LM_P0_NODE_ATOM && g\value\as != 0 && l2_is_slash(g\value\as\atom)
        nm: l2_next_active(g\next)
        if: nm = 0 || nm\value = 0 || nm\value\kind != c.LM_P0_NODE_ATOM || nm\value\as = 0 || l2_ident(nm\value\as\atom) = 0
            return: 1
        if: pn + 1U + nm\value\as\atom\length + 1U > cap
            return: 1
        pd[pn]: 92
        memcpy((cast: (@: void) (pd + pn + 1U)), (cast: (@: void) nm\value\as\atom\data), nm\value\as\atom\length)
        pn: pn + 1U + nm\value\as\atom\length
        n: n + 2
        g: l2_next_active(nm\next)
    ---
    if: n < 3
        return: 1
    if: allow0 = 0 && (g = 0 || g\value = 0 || g\value\kind != c.LM_P0_NODE_ATOM || g\value\as = 0 || l2_text_eq(g\value\as\atom, "[") = 0)
        return: 1
    if: l2_path_root(pd, pn, @ ni, @ res, @ oi, @ root, @ fi) != 0
        return: 1
    if: oi >= 0
        ni: l2_own_nsty_get(oi)
    # An own field holding a graph with no declared type (the letter receiveMessage gives an
    # untyped m): the path has no fields to walk.  A c.* raw root is not a graph and is left
    # to the raw-path machinery.
    if: oi >= 0 && ni < 0 && res < 0 && l2_own_is_graph(l2_own_ty[oi]) != 0
        return: 3
    if: (ni < 0 && res < 0) || root != 0 - 1
        return: 1
    # A typed root: from here the tokens are this route's, and a failure is its to report.
    if: l2_path_arr_leaf(pd, pn, @ kind, @ elem, @ count) != 0
        return: 2
    while: g != 0 && g\value != 0 && g\value\kind = c.LM_P0_NODE_ATOM && g\value\as != 0 && l2_text_eq(g\value\as\atom, "[")
        idx: l2_next_active(g\next)
        if: idx = 0 || idx\value = 0 || idx\value\kind != c.LM_P0_NODE_ATOM || idx\value\as = 0 || l2_dec_literal(idx\value\as\atom, @ iv) != 0
            return: 2
        cb: l2_next_active(idx\next)
        if: cb = 0 || cb\value = 0 || cb\value\kind != c.LM_P0_NODE_ATOM || cb\value\as = 0 || l2_text_eq(cb\value\as\atom, "]") = 0
            return: 2
        depth: depth + 1
        if: depth = 1
            i0: iv
        if: depth = 2
            i1: iv
        n: n + 3
        g: l2_next_active(cb\next)
    ---
    if: (kind = 5 && depth > 1) || (kind = 6 && depth > 2)
        return: 2
    \out_pn: pn
    \out_count: n
    \out_after: g
    \out_kind: kind
    \out_elem: elem
    \out_depth: depth
    \out_i0: i0
    \out_i1: i1
return: 0

# Emit an indexed operand: walk to the Array field's cell, take its descriptor and index
# it.  An element leaves dest an lvalue in the Array's own backing -- `l2_cpN[k]` -- so
# `@` before it addresses the element in graph storage (L2 spec 18.2), never a copy.  With
# want_len, dest is a size_t temporary holding the addressed Array's length.  A null
# descriptor takes the path's ordinary bail.
fn: l2_emit_arr_operand (int: mi; const: @(char pd); size_t: pn; int: kind; int: elem; int: depth; size_t: i0; size_t: i1; int: want_len; const: @(char ind); const: @(LmP0Node at); @: L2Tx dest) int
    int: t
    int: k 0
    []: char nm 64
    const: @(char ety) "int"
    if: dest = 0
        return: 1
    if: elem = 1
        ety: "char"
    if: l2_emit_path_to(pd, pn, mi, ind, at, @ k, 1) != 0
        return: 1
    if: k != kind
        return: l2_error(l2_src, at, "internal: the indexed path changed its leaf")
    t: l2_tn
    l2_tn: l2_tn + 1
    if: c.fprintf(l2_out, "%s@: VoidArray l2_ao%d (cast: (@: VoidArray) l2_pxp[0])\n%sif: l2_ao%d = 0\n", ind, t, ind, t) < 0
        return: 1
    if: l2_emit_path_bail(mi, ind) != 0
        return: 1
    if: want_len != 0 && depth = 0
        if: c.fprintf(l2_out, "%ssize_t: l2_t%d\n%sl2_t%d: l2_ao%d\\size\n", ind, t, ind, t, t) < 0
            return: 1
        return: l2_tx_temp(dest, t)
    ---
    if: kind = 5
        if: c.fprintf(l2_out, "%s@: %s l2_cp%d (cast: (@: %s) l2_ao%d\\data)\n", ind, ety, t, ety, t) < 0
            return: 1
        if: c.snprintf(nm, 64U, "l2_cp%d[%zuU]", t, i0) < 0
            return: 1
        return: l2_tx_set(dest, nm)
    ---
    if: c.fprintf(l2_out, "%s@@: void l2_as%d (cast: (@@: void) l2_ao%d\\data)\n%s@: VoidArray l2_ai%d (cast: (@: VoidArray) l2_as%d[%zuU])\n%sif: l2_ai%d = 0\n", ind, t, t, ind, t, t, i0, ind, t) < 0
        return: 1
    if: l2_emit_path_bail(mi, ind) != 0
        return: 1
    if: want_len != 0
        if: c.fprintf(l2_out, "%ssize_t: l2_t%d\n%sl2_t%d: l2_ai%d\\size\n", ind, t, ind, t, t) < 0
            return: 1
        return: l2_tx_temp(dest, t)
    ---
    if: c.fprintf(l2_out, "%s@: %s l2_cp%d (cast: (@: %s) l2_ai%d\\data)\n", ind, ety, t, ety, t) < 0
        return: 1
    if: c.snprintf(nm, 64U, "l2_cp%d[%zuU]", t, i1) < 0
        return: 1
return: l2_tx_set(dest, nm)

# length() of an indexed-route Array: `length(P)` (kind 5 or 6) or `length(P[k])` (the
# inner Array of kind 6).  0 = this route's and well formed; 1 = not this route's; 2 = its,
# but not an Array (an element, or a wrong shape).
fn: l2_arr_len_shape (const: @(LmP0Node node); @: char local; size_t: local_cap; @@: char out_pd; @: size_t out_pn; @: int out_kind; @: int out_elem; @: int out_depth; @: size_t out_i0) int
    @: LmP0Field first
    @: LmP0Field after
    int: n
    int: cnt 0
    int: kind 0 - 1
    int: elem 0 - 1
    int: depth 0
    size_t: pn 0U
    size_t: i0 0U
    size_t: i1 0U
    int: st
    @: char pd
    size_t: room
    if: node = 0 || l2_frame_head(node, "length") = 0 || node\as\frame\trailer != 0 || node\as\frame\body = 0 || node\as\frame\body\trailer != 0
        return: 1
    first: l2_next_active(node\as\frame\body\first_field)
    n: l2_count_active(node\as\frame\body)
    # The path's text of any length (l2_text_room); the caller reads it at *out_pd.
    room: l2_atoms_len(node\as\frame\body\first_field, -1) + 1U
    pd: l2_text_room(room, local, local_cap)
    if: pd = 0
        return: l2_alloc_or(l2_src, node, "out of memory")
    \out_pd: pd
    st: l2_arr_operand(first, 1, pd, room, @ pn, @ cnt, @ after, @ kind, @ elem, @ depth, @ i0, @ i1)
    if: st != 0
        return: st
    if: cnt != n || after != 0
        return: 2
    if: depth != 0 && (kind != 6 || depth != 1)
        return: 2
    \out_pn: pn
    \out_kind: kind
    \out_elem: elem
    \out_depth: depth
    \out_i0: i0
return: 0


# The former l2_slash_own/l2_slash_for shape (root \ name[...]) refuses
# unconditionally now, node/for included (FABLE-SONNET-NODE-ROOT-20260923-
# 121, author Q9): a root's suffix must denote an Array-typed field of the
# root's TYPE (FABLE-SONNET-ARRAY-WRITE-DISPATCH-20260923-119's rule),
# never a same-named sibling in mi's own table, whether the root is
# literally node/for or any other own-field/formal name -- neither is a
# spelling gate onto mi's own table anymore. Resolving right as a genuine
# Array-typed field of left's type through the namespace slots is a new
# capability (the field lives through l2_own_nsty_get/l2_ns_slot_named on
# left's type, not in mi's own table at all) no ticket has built yet.
# Refusing is the honest state; the caller's fallback (the ordinary
# field-path machinery) gives "unsupported index" for this shape.
fn: l2_own_array_root (int: mi; const: @(LmP0Text left); const: @(LmP0Text right)) int
return: 0 - 1

# Second phase of construction, once the whole unit has been read: a callable field's method is resolved (it may be
# defined below), and a qualified branch's binding is checked against ordinary storage (the branch's entries are
# marked eternal after its body is taken).  A binding's referent was resolved at its place (K03 NS-ROLES-2,
# l2_ns_bind_target): an ordinary named Structure is visible from its place on.
fn: l2_ns_resolve_refs (const: @(char path); const: @(LmP0Node at)) int
    int: k 0
    int: n
    int: pk
    const: @: char rpath
    const: @: LmP0Node rat
    while: k < l2_nsf_n
        # A field of a part's root (§10) is said in its part, at its name.
        rpath: path
        rat: at
        pk: l2_ns_part(l2_ns_top(l2_nsf_owner[k]))
        if: pk >= 0
            rpath: l2_part_path[pk]
            rat: l2_node_of_text(l2_ns_at[l2_part_ns[pk]]\as\frame\body, l2_nsf_fname[k])
        # Qualification admits an ADDRESS RANGE, not a promise. A binding out of a qualified branch into ordinary
        # mutable storage would make a reclaimable target reachable as a terminal: refused at its referent.
        if: l2_nsf_kind[k] = 10 && l2_nsf_val[k] != 0U && l2_ns_eternal[l2_nsf_owner[k]] >= 0 && l2_ns_eternal[(cast: (int) l2_nsf_val[k]) - 1] < 0
            return: l2_error(rpath, l2_ref_tail_node(l2_nsf_source[k]), "an eternal branch cannot reference mutable storage")
        if: l2_nsf_kind[k] = 4 && l2_nsf_ref[k] < 0
            n: l2_find_method(l2_nsf_name[k])
            if: n < 0
                return: l2_error(rpath, rat, "unknown callable field")
            if: l2_ns_eternal[l2_nsf_owner[k]] >= 0
                return: l2_error(path, at, "an eternal branch cannot hold a callable field")
            l2_nsf_ref[k]: n
        k: k + 1
    ---
return: 0

fn: l2_take_named (const: @(LmP0Node item); const: @(char path)) int
    if: item = 0 || item\as = 0 || item\as\frame = 0 || item\as\frame\body = 0
        return: l2_error(path, item, "unsupported body")
    if: l2_ident(item\as\frame\head) = 0
        return: l2_error(path, item, "unsupported body")
    # A `until:` closes a named Structure as its postcondition loop (the author, Q54; l2_ns_loop_body): it names no
    # end target.
    if: l2_fn_close(item\as\frame, item\as\frame\head, 0) != 0 && (item\as\frame\trailer = 0 || item\as\frame\trailer\spelling = 0 || l2_text_eq(item\as\frame\trailer\spelling, "until") = 0)
        return: l2_error(path, item, "end target does not match close target")
    if: l2_ns_find(item\as\frame\head) >= 0 && l2_ns_eternal[l2_ns_find(item\as\frame\head)] >= 0
        return: l2_error(path, item, "named Structure collides with a qualified branch")
    if: l2_ns_find(item\as\frame\head) >= 0
        return: l2_error(path, item, "duplicate named Structure")
    if: l2_ebr_find(item\as\frame\head) >= 0
        return: l2_error(path, item, "named Structure collides with a qualified branch")
    if: l2_site_method(0 - 1, item\as\frame\head) >= 0
        return: l2_error(path, item, "named Structure collides with a method")
return: l2_take_ns_body(item\as\frame\head, 0 - 1, item\as\frame\body, item, path)

fn: l2_take_eternal (const: @(LmP0Node item); const: @(char path)) int
    @: LmP0Node cur
    @: LmP0Node body
    @: LmP0Field f
    int: root
    cur: (cast: (@: LmP0Node) item)
    # K03 S5: `independent` written bare is its application with no argument, as `independent()`: no construction.
    if: l2_text_eq(l2_app_head(cur), "independent") != 0 && l2_count_active(l2_app_actuals(cur)) = 0
        return: l2_error(path, item, "independent takes one qualified construction")
    if: l2_frame_head(cur, "independent") = 0 || cur\as = 0 || cur\as\frame = 0 || cur\as\frame\body = 0
        return: l2_error(path, item, "unsupported body")
    if: l2_count_active(cur\as\frame\body) != 1
        return: l2_error(path, item, "independent takes one qualified construction")
    cur: l2_next_active(cur\as\frame\body\first_field)\value
    if: l2_frame_head(cur, "const") = 0 || cur\as = 0 || cur\as\frame = 0 || cur\as\frame\body = 0 || l2_count_active(cur\as\frame\body) != 1
        return: l2_error(path, item, "independent branch requires const")
    cur: l2_next_active(cur\as\frame\body\first_field)\value
    if: l2_frame_head(cur, "immutable") = 0 || cur\as = 0 || cur\as\frame = 0 || cur\as\frame\body = 0 || l2_count_active(cur\as\frame\body) != 1
        return: l2_error(path, item, "independent branch requires immutable")
    cur: l2_next_active(cur\as\frame\body\first_field)\value
    if: l2_frame_head(cur, "()") = 0 || cur\as = 0 || cur\as\frame = 0 || cur\as\frame\body = 0
        return: l2_error(path, item, "independent qualifies Structure construction")
    if: l2_count_active(cur\as\frame\body) != 2
        return: l2_error(path, item, "eternal branch takes a name and a body")
    f: l2_next_active(cur\as\frame\body\first_field)
    if: f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM || l2_bind_spelling(f\value\as\atom) = 0
        return: l2_error(path, item, "eternal branch needs a name")
    if: l2_bind_admit(f\value\as\atom, f\value, path) != 0
        return: 1
    body: l2_next_active(f\next)\value
    # The construction body arrives as a structure block, exactly like a fn
    # body. Its FIELDS are the ordinary named-Structure field model: size_t and
    # char leaves, inline nested Structures, and translation-known references.
    # Qualification decides storage admission and immutability, not shape.
    if: body = 0 || body\kind != c.LM_P0_NODE_STRUCTURE || body\as = 0 || body\as\structure = 0
        return: l2_error(path, item, "eternal branch takes a body block")
    if: l2_ns_find(f\value\as\atom) >= 0
        return: l2_error(path, item, "duplicate named Structure")
    if: l2_find_method(f\value\as\atom) >= 0
        return: l2_error(path, item, "named Structure collides with a method")
    if: l2_ebr_reserve(l2_ebr_n + 1) != 0
        return: l2_error(path, item, "out of memory")
    root: l2_ns_n
    if: l2_take_ns_body((cast: (@: LmP0Text) f\value\as\atom), 0 - 1, body\as\structure, item, path) != 0
        return: 1
    # Every entry the body created -- the root and each nested Structure --
    # belongs to this branch.
    while: root < l2_ns_n
        l2_ns_eternal[root]: l2_ebr_n
        root: root + 1
    ---
    l2_ebr_name[l2_ebr_n]: (cast: (@: LmP0Text) f\value\as\atom)
    l2_ebr_at[l2_ebr_n]: (cast: (@: LmP0Node) item)
    l2_ebr_leaf[l2_ebr_n]: 0
    l2_ebr_val[l2_ebr_n]: 0U
    l2_ebr_n: l2_ebr_n + 1
return: 0

fn: l2_end_text (const: @(LmP0Frame frame); const: @(LmP0Text name)) int
    @: LmP0Field field
    if: frame = 0 || frame\trailer = 0 || name = 0
        return: 0
    if: l2_text_eq(frame\trailer\spelling, "end") = 0
        return: 0
    if: frame\trailer\body = 0
        return: 0
    field: l2_next_active(frame\trailer\body\first_field)
    if: field = 0 || l2_next_active(field\next) != 0
        return: 0
    if: field\value = 0 || field\value\kind != c.LM_P0_NODE_ATOM
        return: 0
return: l2_text_same(field\value\as\atom, name)


fn: l2_typed_formal (const: @(LmP0Node node); const: @(char path); @@: LmP0Text out_name; @: int out_ty) int
    @: L2Declaration application
    @: LmP0Field first
    @: LmP0Text word
    int: depth
    int: qualified
    l2_last_cf_req: 0 - 1
    l2_last_cf_anon: 0
    if: out_ty = 0 || out_name = 0
        return: l2_error(path, node, "incompatible entry signature")
    # A callable signature written in place is the existing explicit fn contract.
    if: node != 0 && node\kind = c.LM_P0_NODE_FRAME && node\as != 0 && node\as\frame != 0 && node\as\frame\trailer = 0 && node\as\frame\body != 0 && node\as\frame\body\trailer = 0 && l2_count_active(node\as\frame\body) = 1
        first: l2_next_active(node\as\frame\body\first_field)
        if: first != 0 && l2_frame_head(first\value, "fn") != 0
            if: l2_bind_spelling(node\as\frame\head) = 0
                return: l2_error(path, node, "incompatible entry signature")
            if: l2_bind_admit(node\as\frame\head, node, path) != 0
                return: 1
            \out_ty: l2_graph_ft()
            if: \out_ty = 0
                return: l2_error(path, node, "out of memory")
            \out_name: node\as\frame\head
            l2_last_cf_anon: first\value
            return: 0
        ---
    ---
    application: l2_declaration(node)
    if: application = 0
        return: l2_error(path, node, "incompatible entry signature")
    if: application\candidate_count != 0 && (application\contract\kind != 3 || application\candidate_count != 1)
        return: l2_error(path, node, "incompatible entry signature")
    if: application\extent != 0
        return: l2_error(path, node, "incompatible entry signature")
    if: l2_contract_formal(application\contract, out_ty) != 0
        return: l2_error(path, node, "unknown type")
    # One signature contract has one internal representation as well as one
    # physical ABI. The executable reference receiver keeps its own storage
    # projection; only a nonexecuting signature uses the graph-input code.
    if: l2_declaration_model(node, 1) >= 0
        \out_ty: l2_graph_ft()
    if: l2_bind_admit(application\name, l2_bind_at(node, application\name), path) != 0
        return: 1
    \out_name: application\name
    word: l2_contract_leaf(application\contract, @ depth, @ qualified)
    if: depth = 0 && qualified = 0 && word != 0
        l2_last_cf_req: l2_site_method(l2_here_mi, word)
return: 0

# Type nodes of a complete declaration, compared on the translator Structure
# (kind, frame head, active fields). Not a source-line heuristic.
fn: l2_type_nodes_same (const: @(LmP0Node a); const: @(LmP0Node b)) int
    @: LmP0Field fa
    @: LmP0Field fb
    if: a = 0 && b = 0
        return: 1
    if: a = 0 || b = 0
        return: 0
    if: a\kind != b\kind
        return: 0
    if: a\kind = c.LM_P0_NODE_ATOM
        if: a\as = 0 || b\as = 0
            return: 0
        return: l2_text_same(a\as\atom, b\as\atom)
    if: a\kind = c.LM_P0_NODE_FRAME
        if: a\as = 0 || b\as = 0 || a\as\frame = 0 || b\as\frame = 0
            return: 0
        if: l2_text_same(a\as\frame\head, b\as\frame\head) = 0
            return: 0
        if: a\as\frame\body = 0 && b\as\frame\body = 0
            return: 1
        if: a\as\frame\body = 0 || b\as\frame\body = 0
            return: 0
        if: l2_count_active(a\as\frame\body) != l2_count_active(b\as\frame\body)
            return: 0
        fa: l2_next_active(a\as\frame\body\first_field)
        fb: l2_next_active(b\as\frame\body\first_field)
        while: fa != 0 && fb != 0
            if: l2_type_nodes_same(fa\value, fb\value) = 0
                return: 0
            fa: l2_next_active(fa\next)
            fb: l2_next_active(fb\next)
        ---
        return: 1
    if: a\kind = c.LM_P0_NODE_STRUCTURE
        if: a\as = 0 || b\as = 0 || a\as\structure = 0 || b\as\structure = 0
            return: 0
        if: l2_count_active(a\as\structure) != l2_count_active(b\as\structure)
            return: 0
        fa: l2_next_active(a\as\structure\first_field)
        fb: l2_next_active(b\as\structure\first_field)
        while: fa != 0 && fb != 0
            if: l2_type_nodes_same(fa\value, fb\value) = 0
                return: 0
            fa: l2_next_active(fa\next)
            fb: l2_next_active(fb\next)
        ---
        return: 1
return: 0

# A definition has a return trailer (one-line column-0 return) or a Structure
# body field. A complete declaration with neither is a forward or an import.
fn: l2_fn_defined (const: @(LmP0Node fn_node)) int
    @: LmP0Field field
    int: is_sub 0
    if: fn_node = 0 || fn_node\as = 0 || fn_node\as\frame = 0
        return: 0
    if: l2_frame_head(fn_node, "sub")
        is_sub: 1
    if: l2_frame_head(fn_node, "fn") = 0 && is_sub = 0
        return: 0
    if: l2_ret_tr(fn_node\as\frame) != 0
        return: 1
    if: fn_node\as\frame\body = 0
        return: 0
    field: l2_next_active(fn_node\as\frame\body\first_field)
    if: field = 0
        return: 0
    field: l2_next_active(field\next)
    if: field = 0
        return: 0
    if: is_sub = 0
        field: l2_next_active(field\next)
        if: field = 0
            return: 0
        ---
    field: l2_next_active(field\next)
    if: field = 0 || field\value = 0
        return: 0
    if: field\value\kind != c.LM_P0_NODE_STRUCTURE || field\value\as = 0
        return: 0
return: 1

fn: l2_params_types_same (const: @(LmP0Node a); const: @(LmP0Node b); const: @(char path); @: int out_same) int
    @: LmP0Field fa
    @: LmP0Field fb
    @: LmP0Text na 0
    @: LmP0Text nb 0
    int: ta 0
    int: tb 0
    if: out_same = 0
        return: 1
    \out_same: 0
    if: a = 0 || b = 0 || a\kind != c.LM_P0_NODE_STRUCTURE || b\kind != c.LM_P0_NODE_STRUCTURE || a\as = 0 || b\as = 0
        return: 0
    if: l2_count_active(a\as\structure) != l2_count_active(b\as\structure)
        return: 0
    fa: l2_next_active(a\as\structure\first_field)
    fb: l2_next_active(b\as\structure\first_field)
    while: fa != 0 && fb != 0
        na: 0
        nb: 0
        ta: 0
        tb: 0
        if: l2_typed_formal(fa\value, path, @ na, @ ta) != 0
            return: 1
        if: l2_typed_formal(fb\value, path, @ nb, @ tb) != 0
            return: 1
        if: ta != tb
            return: 0
        fa: l2_next_active(fa\next)
        fb: l2_next_active(fb\next)
    ---
    \out_same: 1
return: 0

fn: l2_unit_defined_fn (const: @(LmP0Node self); const: @(LmP0Text name)) @: LmP0Node
    @: LmP0Field field
    @: LmP0Node item
    @: LmP0Text nm
    if: l2_cur_unit = 0 || name = 0
        return: 0
    field: l2_next_active(l2_cur_unit\first_field)
    while: field != 0
        item: field\value
        if: item != self && (l2_frame_head(item, "fn") != 0 || l2_frame_head(item, "sub") != 0)
            nm: l2_os_fn_name(item)
            if: nm != 0 && l2_text_same(nm, name) != 0 && l2_fn_defined(item) != 0
                return: item
            ---
        ---
        field: l2_next_active(field\next)
    ---
return: 0

fn: l2_bind_same_unit_forward (const: @(LmP0Node fn_node); const: @(LmP0Text name); int: is_sub; const: @(LmP0Node params); const: @(LmP0Node ret_node); const: @(char path); @: int out_bound) int
    @: LmP0Node other
    @: LmP0Field field
    @: LmP0Node oparams 0
    @: LmP0Node oret 0
    int: osub 0
    int: same 0
    if: out_bound = 0
        return: 1
    \out_bound: 0
    other: l2_unit_defined_fn(fn_node, name)
    if: other = 0
        return: 0
    if: l2_frame_head(other, "sub")
        osub: 1
    if: osub != is_sub
        return: l2_error(path, fn_node, "incompatible entry signature")
    if: other\as = 0 || other\as\frame = 0 || other\as\frame\body = 0
        return: l2_error(path, fn_node, "incompatible entry signature")
    field: l2_next_active(other\as\frame\body\first_field)
    if: field = 0
        return: l2_error(path, fn_node, "incompatible entry signature")
    field: l2_next_active(field\next)
    if: field = 0
        return: l2_error(path, fn_node, "incompatible entry signature")
    oparams: field\value
    if: is_sub = 0
        field: l2_next_active(field\next)
        if: field = 0
            return: l2_error(path, fn_node, "incompatible entry signature")
        oret: field\value
        ---
    if: l2_params_types_same(params, oparams, path, @ same) != 0
        return: 1
    if: same = 0
        return: l2_error(path, fn_node, "incompatible entry signature")
    if: is_sub = 0 && l2_type_nodes_same(ret_node, oret) = 0
        return: l2_error(path, fn_node, "incompatible entry signature")
    \out_bound: 1
return: 0

# The one-descriptor model of a receiving contract. Only a nonexecuting
# signature admits the depth-zero spelling `T: name` as `@: T name`.
# Executable bodies still require an explicit reference receiver. Deeper
# references retain their extra level and are not paths into T itself.
fn: l2_declaration_model (const: @(LmP0Node decl); int: signature) int
    @: L2Declaration application l2_declaration(decl)
    if: application = 0
        return: 0 - 1
return: l2_contract_model(application\contract, signature)

fn: l2_contract_model (@: L2TypeContract contract; int: signature) int
return: l2_contract_model_depth(contract, signature, 0)

# A receiving place reached by indirection retains the original semantic
# contract. Removing pointer levels must not erase its structural model.
fn: l2_contract_model_depth (@: L2TypeContract contract; int: signature; int: indirect) int
    @: LmP0Text word
    int: depth
    int: qualified
    word: l2_contract_leaf(contract, @ depth, @ qualified)
    if: indirect < 0 || depth < indirect
        return: -1
    depth: depth - indirect
    if: word = 0 || (depth != 1 && (signature = 0 || depth != 0))
        return: 0 - 1
return: l2_type_model(word)

fn: l2_binding_contract (int: mi; const: @(LmP0Text name)) @: L2TypeContract
    int: own l2_resolved_own(mi, name)
    @: LmP0Node source 0
    @: L2Declaration declaration
    if: own >= 0
        source: l2_own_decl[own]
    else:
        source: l2_formal_decl(mi, name)
    declaration: l2_declaration(source)
    if: declaration = 0
        return: 0
return: declaration\contract

# The declaration node of method mi's formal named t -- its input in the header, `T: v`, `@: T v`, ..., the fields
# l2_collect_method read -- or 0.
fn: l2_formal_decl (int: mi; const: @(LmP0Text t)) @: LmP0Node
    @: LmP0Field f
    int: k
    int: j 0
    k: l2_formal_find(mi, t)
    if: k < 0 || mi >= l2_m_n || l2_m_node = 0 || l2_m_node[mi] = 0 || l2_m_node[mi]\as = 0 || l2_m_node[mi]\as\frame = 0 || l2_m_node[mi]\as\frame\body = 0
        return: 0
    f: l2_next_active(l2_m_node[mi]\as\frame\body\first_field)
    # A named method's header starts with its name; an anonymous header's first field is its inputs.
    if: f != 0 && f\value != 0 && f\value\kind = c.LM_P0_NODE_ATOM
        f: l2_next_active(f\next)
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_STRUCTURE || f\value\as = 0 || f\value\as\structure = 0
        return: 0
    f: l2_next_active(f\value\as\structure\first_field)
    while: f != 0 && j < k
        f: l2_next_active(f\next)
        j: j + 1
    ---
    if: f = 0
        return: 0
return: f\value

# Both signature spellings project to the same reference contract.
fn: l2_ref_formal_ns (const: @(LmP0Node decl)) int
return: l2_declaration_model(decl, 1)

# Whether an item of the unit above `stop` defines the named Structure t (l2_unit_role 5), read from the source --
# the answer before registration.  An ordinary named Structure is visible from its place on
# (docs/LMX_semantics.en.md#declaration-visibility), unlike a method (l2_unit_names_method, both ways).
fn: l2_unit_defines_struct (const: @(LmP0Text t); const: @(LmP0Node stop)) int
    @: LmP0Field f
    if: l2_cur_unit = 0 || t = 0 || l2_ident(t) = 0
        return: 0
    f: l2_next_active(l2_cur_unit\first_field)
    while: f != 0 && f\value != stop
        if: f\value != 0 && f\value\kind = c.LM_P0_NODE_FRAME && f\value\as != 0 && f\value\as\frame != 0 && f\value\as\frame\head != 0 && l2_text_same(f\value\as\frame\head, t) != 0 && l2_unit_role(f\value) = 5
            return: 1
        f: l2_next_active(f\next)
    ---
return: 0

# Implements port A2 (q37): `<host>(<formal>)`, the name of the descriptor-only method an anonymous
# callable formal's header is registered as.  Null when there is no memory.
fn: l2_anon_cf_name (const: @(LmP0Text host); const: @(LmP0Text formal)) @: LmP0Text
    @: char bytes 0
    @: LmP0Text t 0
    size_t: n
    if: host = 0 || formal = 0 || host\data = 0 || formal\data = 0
        return: 0
    n: host\length + formal\length + 2U
    bytes: (cast: (@: char) l2_xmalloc(n + 1U))
    t: (cast: (@: LmP0Text) l2_xmalloc(c.sizeof(c.LmP0Text)))
    if: bytes = 0 || t = 0
        if: bytes != 0
            l2_xfree((cast: (@: void) bytes))
        ---
        if: t != 0
            l2_xfree((cast: (@: void) t))
        ---
        return: 0
    ---
    memcpy(bytes, host\data, host\length)
    bytes[host\length]: 40
    memcpy(bytes + host\length + 1U, formal\data, formal\length)
    bytes[n - 1U]: 41
    bytes[n]: 0
    t\data: bytes
    t\length: n
return: t

# Two definitions of one method name in the program -- in one file or in two (§8): said at the second, with
# the other's place, as two source tables of one name are (l2_table_twice; REVIEW 70f869c, account 2).
fn: l2_dup_method (const: @(char path); const: @(LmP0Node at); int: other) int
    []: char place 64
    const: @: char src 0
    size_t: line 1U
    size_t: column 1U
    size_t: pn 0U
    if: other >= 0 && other < l2_m_n && l2_m_node[other] != 0 && l2_m_node[other]\span != 0
        line: l2_m_node[other]\span\line
        column: l2_m_node[other]\span\column
    ---
    src: l2_method_src(other, l2_src)
    if: src != 0
        pn: strlen(src)
    # The other source's path whole (FIXED-BLOCKS-AUDIT); its line and column are numbers.
    c.snprintf(place, 64U, ":%zu:%zu)", line, column)
return: l2_error_words(path, at, "duplicate definition (the other at ", src, pn, place, 0, 0U, "", 0, 0U, "")

# Collection publishes its own row before any recursive declarations. A
# bound forward declaration may publish none. Return that first source row,
# never a descendant or the preceding row; -1 means none, -2 a broken contract.
fn: l2_collected_row (int: first; const: @(LmP0Node node)) int
    if: first < 0 || first > l2_m_n
        return: 0 - 2
    if: first = l2_m_n
        return: 0 - 1
    if: l2_m_node[first] != node
        return: 0 - 2
return: first

# A header is read in its actual lexical parent, not in whichever body the
# preceding collection left active. Nested callable headers pass their parent.
fn: l2_collect_method (const: @(LmP0Node fn_node); const: @(char path); int: lexical_mi) int
    L2SourceSite: saved
    int: status
    int: restored
    if: l2_source_save(@ saved) != 0
        return: l2_alloc_or(path, fn_node, "out of memory")
    l2_own_excl: -1
    if: lexical_mi < 0
        l2_scope_n: 0
        l2_vis_from(fn_node)
    l2_here_at_method(lexical_mi, fn_node)
    status: l2_collect_method_body(fn_node, path, lexical_mi)
    restored: l2_source_restore(@ saved)
    l2_xfree((cast: (@: void) saved.scopes))
    if: restored != 0
        return: l2_alloc_or(path, fn_node, "out of memory")
return: status

fn: l2_collect_method_body (const: @(LmP0Node fn_node); const: @(char path); int: lexical_mi) int
    @: LmP0Field field
    const: @: LmP0Frame fr
    const: @: LmP0Node params
    const: @: LmP0Node body
    @: LmP0Field p
    @: LmP0Text fa 0
    @: LmP0Text nm 0
    unsigned: id
    int: ar
    int: j
    int: ty
    int: k
    int: is_sub 0
    int: sn 0
    int: return_depth 0
    int: bound 0
    const: @: LmP0Node rty
    const: @: LmP0Node rbase
    const: @: LmP0Node ret_node
    # Implements port A2: an anonymous callable formal's header, `fn: (inputs) result` with no name,
    # comes with the name its method is given (l2_anon_cf_name); the formals of this method that are
    # such headers are registered after it (cf_fn / cf_j).
    @: LmP0Text anon 0
    []: @(LmP0Node) cf_fn 8
    []: int cf_j 8
    @@: LmP0Node cfp_fn 0
    @: int cfp_j 0
    size_t: cf_psz
    size_t: cf_isz
    int: cf_n 0
    int: me 0
    int: cf_row
    @: LmP0Text cf_nm 0
    anon: l2_collect_anon_name
    l2_collect_anon_name: 0
    # K03 S5: `fn` or `sub` written bare is its application with no argument, as `fn()`: its header has no field, so
    # the header's count refuses it below the same way (k is 0).
    if: fn_node != 0 && fn_node\as != 0 && fn_node\as\frame = 0 && l2_app_head(fn_node) != 0 && anon = 0
        return: l2_error(path, fn_node, "incompatible entry signature")
    if: fn_node = 0 || fn_node\as = 0 || fn_node\as\frame = 0
        return: l2_error(path, fn_node, "unsupported body")
    if: l2_m_n >= c.INT_MAX
        l2_alloc_err: 2
        return: l2_error(path, fn_node, "size overflow")
    if: l2_meth_reserve(l2_m_n + 1) != 0
        if: l2_alloc_err = 2
            return: l2_error(path, fn_node, "size overflow")
        return: l2_error(path, fn_node, "out of memory")
    fr: fn_node\as\frame
    if: l2_frame_head(fn_node, "sub")
        is_sub: 1
    k: 0
    if: fr\body != 0
        k: l2_count_active(fr\body)
    if: anon = 0 && is_sub = 0 && k != 4 && k != 3
        return: l2_error(path, fn_node, "incompatible entry signature")
    if: anon != 0 && (is_sub != 0 || k != 2)
        return: l2_error(path, fn_node, "incompatible entry signature")
    if: is_sub != 0 && k != 3 && k != 2
        return: l2_error(path, fn_node, "incompatible entry signature")
    if: fr\body\trailer != 0
        return: l2_error(path, fn_node, "unsupported trailer")
    field: l2_next_active(fr\body\first_field)
    # An anonymous header has no name field: its first field is its inputs.
    nm: anon
    if: anon = 0 && (field\value = 0 || field\value\as = 0 || field\value\kind != c.LM_P0_NODE_ATOM)
        return: l2_error(path, fn_node, "incompatible entry signature")
    if: anon = 0 && l2_bind_spelling(field\value\as\atom) = 0
        return: l2_error(path, fn_node, "incompatible entry signature")
    if: anon = 0 && l2_bind_admit(field\value\as\atom, field\value, path) != 0
        return: 1
    if: anon = 0
        nm: field\value\as\atom
    if: fr\trailer != 0 && (anon != 0 || (l2_text_eq(fr\trailer\spelling, "end") = 0 && l2_text_eq(fr\trailer\spelling, "return") = 0))
        return: l2_error(path, fn_node, "unsupported trailer")
    if: anon = 0 && is_sub = 0 && l2_fn_close(fr, nm, "fn") != 0
        return: l2_error(path, fn_node, "end target does not match close target")
    if: anon = 0 && is_sub != 0 && l2_fn_close(fr, nm, "sub") != 0
        return: l2_error(path, fn_node, "end target does not match close target")
    if: l2_find_method(nm) >= 0
        return: l2_dup_method(path, fn_node, l2_find_method(nm))
    if: nm\length >= 63U
        return: l2_error(path, fn_node, "name too long")
    if: anon = 0
        field: l2_next_active(field\next)
    params: field\value
    if: params = 0 || params\kind != c.LM_P0_NODE_STRUCTURE || params\as = 0
        return: l2_error(path, fn_node, "incompatible entry signature")
    if: params\as\structure\trailer != 0
        return: l2_error(path, fn_node, "unsupported trailer")
    ar: l2_count_active(params\as\structure)
    if: ar < 0
        return: l2_error(path, fn_node, "incompatible entry signature")
    # A2: a place for each formal that may be written in place -- as many as the method has formals (FIXED-BLOCKS-AUDIT:
    # a fixed eight was a count the program did not choose).  The local places serve where they suffice.
    cf_psz: c.sizeof(@: char)
    cf_isz: c.sizeof(c.int)
    if: l2_mul_ok((cast: (size_t) ar), cf_psz) = 0
        l2_alloc_err: 2
        return: l2_error(path, fn_node, "size overflow")
    cfp_fn: (cast: (@@: LmP0Node) l2_text_room((cast: (size_t) ar) * cf_psz, (cast: (@: char) cf_fn), 8U * cf_psz))
    cfp_j: (cast: (@: int) l2_text_room((cast: (size_t) ar) * cf_isz, (cast: (@: char) cf_j), 8U * cf_isz))
    if: cfp_fn = 0 || cfp_j = 0
        return: l2_error(path, fn_node, "out of memory")
    if: l2_formals_alloc(l2_m_n, ar) != 0
        if: l2_alloc_err = 2
            return: l2_error(path, fn_node, "size overflow")
        return: l2_error(path, fn_node, "out of memory")
    p: l2_next_active(params\as\structure\first_field)
    j: 0
    while: j < ar
        ty: 0
        fa: 0
        if: p = 0 || l2_typed_formal(p\value, path, @ fa, @ ty) != 0
            l2_free_method(l2_m_n)
            return: 1
        if: fa = 0 || fa\length >= 63U
            l2_free_method(l2_m_n)
            return: l2_error(path, fn_node, "name too long")
        k: 0
        while: k < j
            if: l2_text_same(fa, l2_fn(l2_m_n, k))
                l2_free_method(l2_m_n)
                return: l2_error(path, p\value, "duplicate formal")
            k: k + 1
        if: l2_fn_set(l2_m_n, j, fa) != 0 || l2_ft_set(l2_m_n, j, ty) != 0
            l2_free_method(l2_m_n)
            return: l2_error(path, fn_node, "out of memory")
        if: l2_last_cf_req >= 0
            if: l2_cf_set(l2_m_n, j, l2_last_cf_req) != 0
                l2_free_method(l2_m_n)
                return: l2_error(path, fn_node, "out of memory")
            ---
            l2_last_cf_req: 0 - 1
        ---
        # A2: an anonymous header's method is registered after this one; its index is then known.
        if: l2_last_cf_anon != 0
            cfp_fn[cf_n]: l2_last_cf_anon
            cfp_j[cf_n]: j
            cf_n: cf_n + 1
            l2_last_cf_anon: 0
        ---
        # Nonexecuting signatures share one reference/model projection.
        if: l2_ref_formal_ns(p\value) >= 0
            if: l2_nsty_set(l2_m_n, j, l2_ref_formal_ns(p\value)) != 0
                l2_free_method(l2_m_n)
                return: l2_error(path, fn_node, "out of memory")
            ---
        ---
        p: l2_next_active(p\next)
        j: j + 1
    l2_m_arity[l2_m_n]: ar
    l2_m_dyn[l2_m_n]: 0
    l2_m_f0[l2_m_n]: 0
    l2_m_f1[l2_m_n]: 0
    if: ar >= 1
        l2_m_f0[l2_m_n]: l2_fn(l2_m_n, 0)
    if: ar >= 2
        l2_m_f1[l2_m_n]: l2_fn(l2_m_n, 1)
    field: l2_next_active(field\next)
    if: is_sub != 0
        l2_m_ret[l2_m_n]: 8
    if: is_sub = 0 && field\value = 0
        return: l2_error(path, fn_node, "incompatible entry signature")
    # Return descriptions use the same resolved type contract as inputs and
    # body declarations. A callable-return header keeps its existing semantic
    # signature projection, independent of machine pointer representation.
    if: is_sub = 0
        if: l2_frame_head(field\value, "fn") != 0
            if: l2_mad_sig(field\value) = 0
                return: l2_error(path, fn_node, "incompatible entry signature")
            l2_m_ret[l2_m_n]: 16
        else:
            if: l2_ret_type_node(field\value, @ ty) != 0
                return: l2_error(path, field\value, "unknown type")
            l2_m_ret[l2_m_n]: ty
        ---
    ---
    ret_node: 0
    if: is_sub = 0
        ret_node: field\value
        k: l2_contract_model(l2_contract_type(ret_node), 1)
        if: k >= 0 && l2_nsty_set(l2_m_n, 0 - 1, k) != 0
            return: l2_error(path, fn_node, "out of memory")
        field: l2_next_active(field\next)
    body: 0
    if: field != 0
        body: field\value
    if: anon = 0 && body = 0 && l2_ret_tr(fr) = 0
        bound: 0
        if: l2_bind_same_unit_forward(fn_node, nm, is_sub, params, ret_node, path, @ bound) != 0
            l2_free_method(l2_m_n)
            return: 1
        if: bound != 0
            l2_free_method(l2_m_n)
            return: 0
        # Descriptor-only contract: keep the METHOD row with null body (addr=0).
    ---
    if: body != 0 && (body\kind != c.LM_P0_NODE_STRUCTURE || body\as = 0)
        return: l2_error(path, fn_node, "unsupported body")
    if: body != 0 && body\as\structure\trailer != 0
        return: l2_error(path, fn_node, "unsupported trailer")
    if: l2_check_throws_list(body, path) != 0
        return: 1
    l2_m_name[l2_m_n]: nm
    l2_m_node[l2_m_n]: (cast: (@: LmP0Node) fn_node)
    l2_m_body[l2_m_n]: (cast: (@: LmP0Node) body)
    l2_m_sig[l2_m_n]: 0U
    l2_m_own[l2_m_n]: 0
    l2_m_sn[l2_m_n]: 0
    if: body != 0 && l2_collect_decls(body\as\structure, l2_m_n, path, 0, @ sn) != 0
        return: 1
    l2_m_sn[l2_m_n]: sn
    me: l2_m_n
    l2_m_n: l2_m_n + 1
    if: is_sub = 0 && ret_node != 0 && l2_frame_head(ret_node, "fn") != 0
        if: l2_mad_take_nested(me, (cast: (@: LmP0Node) body), path) != 0
            return: 1
        ---
    # Implements port A2 (q37): each callable formal written in place, `op(fn: (int: x) int)`, is
    # a descriptor-only method `<nm>(<formal>)` -- the formal's contract (l2_cf_set), exactly as a
    # bodiless `fn:` named in `(test3: f)` is.
    j: 0
    while: j < cf_n
        cf_nm: l2_anon_cf_name(nm, l2_fn(me, cfp_j[j]))
        if: cf_nm = 0
            return: l2_error(path, fn_node, "out of memory")
        l2_collect_anon_name: cf_nm
        cf_row: l2_m_n
        if: l2_collect_method(cfp_fn[j], path, lexical_mi) != 0
            return: 1
        cf_row: l2_collected_row(cf_row, cfp_fn[j])
        if: cf_row < 0
            return: l2_error(path, cfp_fn[j], "internal: callable descriptor collection lost its declaration row")
        if: l2_cf_set(me, cfp_j[j], cf_row) != 0
            return: l2_error(path, fn_node, "out of memory")
        j: j + 1
    ---
return: 0

# K03 S4 (the author, 2026-10-06): a word of the language in a value position -- the bare word or its Frame, one
# application (l2_app_actuals) -- meets the word's value contract here, one consumer for both spellings, said at the
# word.  An operator with a value goes on to its branch with its operands (2); applied to nothing it has none, its
# own refusal.  A loop or body word refuses as its Frame did; a receiver the translator does not build and a unit
# instruction say so as in a statement (l2_check_word_stmt); every other word gives no value.  0 is never answered:
# a word's value is always one of its branches'.
fn: l2_check_word_value (const: @(LmP0Node node); const: @(LmP0Text w); int: mi; const: @(char path)) int
    int: na l2_count_active(l2_app_actuals(node))
    if: l2_text_eq(w, "merge")
        if: na = 0
            return: l2_error(path, node, "merge needs at least one operand")
        return: l2_error(path, node, "merge expression is not lowered in this receiving context")
    if: l2_text_eq(w, "cast") || l2_text_eq(w, "sizeof") || l2_text_eq(w, "length")
        if: na != 0
            return: 2
        if: l2_text_eq(w, "cast")
            return: l2_error(path, node, "unsupported cast")
        if: l2_text_eq(w, "sizeof")
            return: l2_error(path, node, "sizeof: requires one operand")
        return: l2_error(path, node, "length requires one known primitive own array")
    if: l2_text_eq(w, "while") || l2_text_eq(w, "for") || l2_text_eq(w, "continue") || l2_text_eq(w, "break")
        return: l2_error(path, node, "unsupported loop")
    if: l2_text_eq(w, "if") || l2_text_eq(w, "else") || l2_text_eq(w, "return") || l2_text_eq(w, "fn") || l2_text_eq(w, "node")
        return: l2_error(path, node, "unsupported body")
    # implements has its value (§7): with operands its branch checks them (l2_check_implements); applied to nothing it
    # has none of its three.
    if: l2_text_eq(w, "implements")
        if: na != 0
            return: 2
        return: l2_error(path, node, "implements expects candidate, required, consumer")
    # The receivers the translator does not build (l2_check_word_stmt) and the unit instructions, as in a statement.
    if: l2_text_eq(w, "fm") || l2_text_eq(w, "synchronized") || l2_text_eq(w, "test") || l2_text_eq(w, "post") || l2_text_eq(w, "external")
        return: l2_error_name(path, node, "", w\data, w\length, " is not supported yet")
    if: l2_unit_word(w) != 0
        return: l2_error_name(path, node, "", w\data, w\length, " is a unit instruction: it stands at the root of the unit")
return: l2_error_name(path, node, "", w\data, w\length, " has no value")

fn: l2_check_primary (const: @(LmP0Node node); int: mi; const: @(char path)) int
    []: char lpd_own 1024
    @: char lpd 0
    size_t: lpn 0U
    int: lkind 0
    int: lelem 0
    int: ldepth 0
    size_t: li0 0U
    const: @: LmP0Frame call
    int: pni 0
    int: pres 0
    int: poi 0
    int: proot 0
    int: pfi 0
    int: pmi 0
    @: LmP0Field a0
    @: LmP0Field a1
    int: idx
    int: fi
    int: array_status
    int: raw
    int: raw_j
    size_t: array_index
    int: occ 0
    int: k 0
    @: LmP0Text onm 0
    []: char cast_ty_own 1024
    L2Tx: cast_ty_tx
    @: L2Tx cast_ty l2_tx_local(@ cast_ty_tx, cast_ty_own, 1024U)
    int: capn 0
    int: capk
    l2_here_at_method(mi, node)
    if: node = 0
        return: l2_error(path, node, "unsupported body")
    if: node\kind = c.LM_P0_NODE_ATOM
        k: l2_occ_head(node\as\atom, @ occ, @ onm)
        if: k = 2
            return: l2_error(path, node, "unsupported index")
        if: k = 0
            idx: l2_own_find_occ(mi, onm, occ)
            if: onm != 0
                l2_xfree((cast: (@: void) onm))
            if: idx < 0
                return: l2_error(path, node, "no such occurrence")
            if: l2_m_uses[l2_own_off(mi, idx)] = 0
                return: l2_error(path, node, "no such occurrence")
            return: 0
        ---
        raw: l2_prefix_deref(node\as\atom, mi, 0, cast_ty)
        if: raw = 0
            return: 0
        if: raw = 2
            return: l2_error(path, node, "invalid raw dereference")
        array_status: l2_own_index_head(node\as\atom, mi, @ idx, @ array_index)
        if: array_status = 0
            return: 0
        if: array_status = 2
            array_status: l2_dyn_own_index(mi, node\as\atom, @ idx, @ raw)
            if: array_status = 2
                return: l2_error(path, node, "mixed numeric types (a conversion)")
            if: array_status = 1
                return: 0
            return: l2_error(path, node, "own array index requires a supported integer expression")
        raw: l2_raw_head(node\as\atom, mi, @ raw_j)
        if: raw = 0
            return: 0
        if: l2_num(node\as\atom)
            return: 0
        if: l2_int_fits(node\as\atom)
            return: 0
        if: l2_signed_num(node\as\atom)
            return: 0
        if: l2_quoted(node\as\atom)
            return: 0
        if: node\as\atom\length >= 3U && node\as\atom\data[0] = 39 && node\as\atom\data[node\as\atom\length - 1U] = 39
            return: 0
        if: node\as\atom\length >= 2U && node\as\atom\data[0] = 99 && node\as\atom\data[1] = 46
            return: 0
        # A token that starts as a number and is none of the supported integer
        # spellings is a literal error at the literal. A leading zero starts a
        # C99 octal literal: 8 and 9 are not octal digits, and a valid octal
        # literal has no producer yet.
        if: node\as\atom\length > 1U && node\as\atom\data[0] = 48 && node\as\atom\data[1] >= 48 && node\as\atom\data[1] <= 57
            if: l2_octal_digits(node\as\atom) = 0
                return: l2_error(path, node, "not an integer literal: a leading zero starts an octal literal")
            return: l2_error(path, node, "an octal integer literal is not supported yet")
        if: node\as\atom\length > 0U && node\as\atom\data[0] >= 48 && node\as\atom\data[0] <= 57
            return: l2_error(path, node, "not a number literal")
        # K03 S4: a bare word of the language is its application with no argument (l2_check_word_value).
        if: l2_stmt_word_head(node, mi) != 0
            return: l2_check_word_value(node, l2_stmt_word_head(node, mi), mi, path)
        if: l2_ident(node\as\atom) = 0
            return: l2_error(path, node, "unsupported body")
        # A callable named where a value is consumed gives its result (plan §3 native gate (в);
        # FABLE-OPUS-RECEIVER-CONTRACT-20260924-139): it runs with no arguments, the check of
        # `m()` (l2_check_value_call).  So for a callable formal of this method and for a unit
        # method.  A callable formal of the CALLEE takes the occurrence itself instead; that
        # actual never reaches here (l2_check_call).
        idx: l2_param_find(mi, node\as\atom)
        if: idx >= 0 && l2_head_is_callable_formal(mi, node\as\atom) != 0
            return: l2_check_value_call(node, l2_cf_get(mi, idx), idx, mi, path)
        if: idx >= 0
            return: 0
        # K03 S6: a binding `b: tick` (NS-ROLES-1b) named as a value is tick's result -- its call with no arguments, on the
        # occurrence b holds -- checked as that call, as l2_prep and l2_rw_operand run it.
        if: l2_call_alias_own(mi, node\as\atom) >= 0
            return: l2_check_value_call(node, l2_rb_meth_of(l2_own_decl[l2_call_alias_own(mi, node\as\atom)]), 0 - 1, mi, path)
        if: l2_head_is_method_call(mi, node\as\atom) != 0
            return: l2_check_value_call(node, l2_site_method(mi, node\as\atom), 0 - 1, mi, path)
        # and a local this method body declares, which lives in its own
        # activation.
        if: l2_ml_find(node\as\atom) >= 0
            return: 0
        if: node\as\atom\length >= 2U && node\as\atom\data[0] = 99 && node\as\atom\data[1] = 46
            return: 0
        idx: l2_own_visible(mi, node\as\atom)
        # An Array expression is its existing descriptor reference. The
        # receiving contract checks that value; elements require indexing.
        if: idx >= 0 && l2_own_is_array(l2_own_ty[idx]) != 0
            return: 0
        if: idx >= 0 && l2_m_uses[l2_own_off(mi, idx)] != 0
            return: 0
        ---
        if: l2_slot_find(mi, node\as\atom) >= 0
            return: 0
        if: l2_ns_find(node\as\atom) >= 0
            return: 0
        if: l2_define_name(node\as\atom) != 0
            return: 0
        if: l2_mad_host_of(mi) >= 0 && l2_formal_find(l2_mad_host_of(mi), node\as\atom) >= 0
            return: 0
        if: l2_mad_host_of(mi) >= 0 && l2_mad_host_own(l2_mad_host_of(mi), node\as\atom) >= 0
            return: 0
        return: l2_error(path, node, "unresolved name")
    if: node\kind = c.LM_P0_NODE_FRAME && node\as != 0 && node\as\frame != 0 && l2_call_head_held(mi, node\as\frame\head) >= 0
        return: l2_check_held_call(node, l2_call_head_held(mi, node\as\frame\head), mi, path)
    if: node\kind = c.LM_P0_NODE_FRAME && l2_frame_head(node, "@")
        return: l2_check_addr(node, mi, path)
    # A prefix sign applied to a group, `-(a + b)`: the group is checked as the
    # expression it is, and the kind rule asks a number of it.
    if: l2_prefix_frame(node) != 0
        if: l2_count_active(node\as\frame\body) < 1
            return: l2_error(path, node, "a prefix sign needs an operand")
        if: l2_check_fields(node\as\frame\body\first_field, l2_count_active(node\as\frame\body), mi, path, node) != 0
            return: 1
        return: l2_prefix_kind_refused(node, mi, path)
    if: node\kind = c.LM_P0_NODE_STRUCTURE && node\as != 0
        return: l2_check_fields(node\as\structure\first_field, l2_count_active(node\as\structure), mi, path, node)
    if: node\kind != c.LM_P0_NODE_FRAME || node\as = 0 || node\as\frame = 0
        return: l2_error(path, node, "unsupported body")
    # K03 S4: a word's Frame is the word's application (l2_check_word_value); an operator with operands goes on.
    if: l2_stmt_word_head(node, mi) != 0
        k: l2_check_word_value(node, l2_stmt_word_head(node, mi), mi, path)
        if: k != 2
            return: k
        ---
    call: node\as\frame
    if: call\head = 0
        return: l2_error(path, node, "unknown method")
    if: l2_text_eq(call\head, "cast")
        if: call\body = 0 || call\trailer != 0 || call\body\trailer != 0 || l2_count_active(call\body) < 2
            return: l2_error(path, node, "unsupported cast")
        a0: l2_next_active(call\body\first_field)
        a1: l2_next_active(a0\next)
        if: l2_cast_type(a0\value, cast_ty) != 0
            return: l2_error(path, node, "unsupported cast type")
        if: l2_count_active(call\body) > 2
            return: l2_check_fields(a1, l2_count_active(call\body) - 1, mi, path, node)
        return: l2_check_primary(a1\value, mi, path)
    ---
    if: l2_text_eq(call\head, "sizeof")
        return: l2_check_sizeof(node, mi, path)
    ---
    if: l2_text_eq(call\head, "implements")
        return: l2_check_implements(node, path)
    # D-106: a callable formal of this method shadows a unit method of its name.
    idx: l2_call_head_method(mi, call\head, @ fi)
    # K03 S4: a named Structure's application runs its body and gives no value, as a sub's does.
    if: idx < 0 && l2_head_resolve(mi, call\head, 0, 0) = 5
        return: l2_error(path, node, "a callable without a result has no value")
    if: idx < 0 && l2_text_eq(call\head, "length")
        if: l2_array_length_own(node, mi) < 0 && l2_arr_len_shape(node, lpd_own, 1024U, @ lpd, @ lpn, @ lkind, @ lelem, @ ldepth, @ li0) != 0
            return: l2_error(path, node, "length requires one known primitive own array")
        return: 0
    if: idx < 0 && l2_is_known(call\head)
        # A foreign C call may take no arguments: c.rand(), c.abort(). The
        # parser gives it an empty body, and l2_check_fields refuses 0 fields.
        if: l2_c_stmt_door(call\head) != 0 && (call\body = 0 || l2_count_active(call\body) = 0)
            return: 0
        if: call\body = 0
            return: l2_error(path, node, "incompatible entry signature")
        return: l2_check_fields(call\body\first_field, l2_count_active(call\body), mi, path, node)
    if: idx < 0 && l2_ml_find(call\head) >= 0 && l2_ml_ty[l2_ml_find(call\head)] = 40
        if: call\trailer != 0 || call\body = 0 || call\body\trailer != 0
            return: l2_error(path, node, "unsupported trailer")
        if: l2_next_active(call\body\first_field) = 0
            return: 0
        return: l2_check_fields(call\body\first_field, l2_actual_count(call\body\first_field), mi, path, node)
    raw: l2_raw_head(call\head, mi, @ raw_j)
    if: idx < 0 && raw = 0
        if: call\body = 0
            return: l2_error(path, node, "incompatible entry signature")
        return: l2_check_fields(call\body\first_field, l2_count_active(call\body), mi, path, node)
    if: idx < 0 && call\head != 0 && call\head\data != 0 && l2_seg_count(call\head\data, call\head\length) > 1
        # Item 738: a path through a Structure capture of the model -- the capture says what is
        # wrong with it (past its field, no such field, a Structure field); a path it takes is the
        # walk's.
        if: l2_cap_path_head(mi, call\head) != 0
            capk: l2_cap_path_head(mi, call\head) - 1
            return: l2_cap_text(call\head, node, l2_mcap_name[capk], l2_mcap_ns[capk], 0, 0, @ capn)
        # The head is spelled as a path. Say which part of it failed rather
        # than calling the whole statement unsupported.
        if: l2_path_root(call\head\data, call\head\length, @ pni, @ pres, @ poi, @ proot, @ pfi) != 0
            return: l2_error(path, node, "unknown field path root")
        if: l2_path_kind(call\head\data, call\head\length, @ pmi) < 0
            return: l2_error(path, node, "unknown field path segment")
        return: l2_error(path, node, "a call path must end at a callable field")
    if: idx < 0
        return: l2_error(path, node, "unknown method")
    if: call\trailer != 0
        return: l2_error(path, node, "unsupported trailer")
    if: call\body = 0 || call\body\trailer != 0
        return: l2_error(path, node, "unsupported trailer")
return: l2_check_call(node, idx, fi, call\body, mi, path)

# The empty Structure given for Structure formal k of idx (D-23): `x: ()` binds x to it (l2_bind_calls), a
# Structure with no field -- P0 flattens the sole anonymous (), so it could not be written by position.
fn: l2_empty_actual (@: LmP0Field field; int: idx; int: k) int
    if: idx < 0 || k < 0 || field = 0 || l2_nsty_get(idx, k) < 0
        return: 0
return: l2_empty_struct(field\value)

fn: l2_emit_empty_actual (int: idx; int: k; int: mi; const: @(char ind); @: L2Tx dest) int
    int: tn
    int: ni
    ni: l2_nsty_get(idx, k)
    tn: l2_tn
    l2_tn: l2_tn + 1
    if: c.fprintf(l2_out, "%s@: Lmx l2_t%d\n%sl2_t%d: lmx_node_new_owned(l2_program_arena)\n%sif: l2_t%d = 0\n", ind, tn, ind, tn, ind, tn) < 0
        return: 1
    if: l2_emit_invariant(ind, "a fresh empty Structure did not allocate") != 0
        return: 1
    if: l2_tx_temp(dest, tn) != 0
        return: 1
    if: l2_emit_admit(mi, ni, dest\data, ind) != 0
        return: 1
return: 0

fn: l2_bound_nsty (int: mi; const: @(LmP0Text name)) int
return: l2_graph_nsty(mi, name)

# A field path name\seg\seg of any depth. 0: *out_ni is the leaf Structure.
# 1: located. 2: not this shape (the ordinary check still owns it).
fn: l2_actual_path (int: mi; @: LmP0Field a0; int: span; const: @(char path); const: @(LmP0Node at); @: int out_ni) int
    @: LmP0Field sl
    @: LmP0Field mem
    int: owner
    int: fx
    int: consumed
    []: char buf_own 128
    @: char buf 0
    int: capn 0
    int: capk
    if: span < 3 || (span % 2) = 0 || a0 = 0 || a0\value = 0 || a0\value\kind != c.LM_P0_NODE_ATOM || a0\value\as = 0 || a0\value\as\atom = 0
        return: 2
    sl: l2_next_active(a0\next)
    mem: 0
    if: sl != 0
        mem: l2_next_active(sl\next)
    if: sl = 0 || sl\value = 0 || sl\value\kind != c.LM_P0_NODE_ATOM || sl\value\as = 0 || l2_is_slash(sl\value\as\atom) = 0 || mem = 0 || mem\value = 0 || mem\value\kind != c.LM_P0_NODE_ATOM || mem\value\as = 0 || mem\value\as\atom = 0 || l2_ident(mem\value\as\atom) = 0
        return: 2
    owner: l2_bound_nsty(mi, a0\value\as\atom)
    # Item 738: through a Structure capture of the model the field is the capture's to check (a
    # Structure field is not copied, a name its type has not is refused); a value field is not this
    # shape.
    if: owner < 0 && l2_cap_named(mi, a0\value\as\atom) != 0
        capk: l2_cap_named(mi, a0\value\as\atom) - 1
        if: l2_cap_add(mem\value\as\atom\data, 0U, mem\value\as\atom\length, mem\value, l2_mcap_ns[capk], 0, 0, @ capn) != 0
            return: 1
        return: 2
    if: owner < 0
        return: l2_error(path, a0\value, "unresolved name")
    consumed: 3
    while: consumed <= span
        if: mem\value\as\atom\length = 0U || mem\value\as\atom\data = 0
            return: l2_error(path, mem\value, "unresolved name")
        buf: l2_text_room(mem\value\as\atom\length + 1U, buf_own, 128U)
        if: buf = 0
            return: l2_alloc_or(path, mem\value, "out of memory")
        memcpy(buf, mem\value\as\atom\data, mem\value\as\atom\length)
        buf[mem\value\as\atom\length]: 0
        fx: l2_ns_field_ix(owner, buf)
        if: fx < 0
            return: l2_error(path, mem\value, "unresolved name")
        if: (l2_nsf_kind[fx] != 2 && l2_nsf_kind[fx] != 3) || l2_nsf_ref[fx] < 0
            return: l2_error(path, mem\value, "a field path must end at a Structure")
        if: consumed = span
            \out_ni: l2_nsf_ref[fx]
            return: 0
        owner: l2_nsf_ref[fx]
        sl: l2_next_active(mem\next)
        mem: 0
        if: sl != 0
            mem: l2_next_active(sl\next)
        if: sl = 0 || sl\value = 0 || sl\value\kind != c.LM_P0_NODE_ATOM || sl\value\as = 0 || l2_is_slash(sl\value\as\atom) = 0 || mem = 0 || mem\value = 0 || mem\value\kind != c.LM_P0_NODE_ATOM || mem\value\as = 0 || mem\value\as\atom = 0 || l2_ident(mem\value\as\atom) = 0
            return: 2
        consumed: consumed + 2
    ---
return: 2

# The same path as a value: the child at the last Structure field.
# 0: dest holds it. 1: located or a prep failure. 2: not this shape.
fn: l2_emit_actual_path (int: mi; @: LmP0Field a0; int: span; const: @(char ind); const: @(LmP0Node at); @: L2Tx dest) int
    @: LmP0Field sl
    @: LmP0Field mem
    int: owner
    int: slot
    int: kind
    int: ent
    int: consumed
    int: nseg
    int: i
    int: s
    []: int slots_own 32
    @: int slots 0
    int: slots_cap 32
    @: int grown 0
    []: char buf_own 128
    @: char buf 0
    []: char cur_own 1024
    []: char nxt_own 1024
    []: char num 32
    L2Tx: cur_tx
    L2Tx: nxt_tx
    @: L2Tx cur @ cur_tx
    @: L2Tx nxt @ nxt_tx
    @: L2Tx swap 0
    if: dest = 0 || ind = 0 || span < 3 || (span % 2) = 0 || a0 = 0 || a0\value = 0 || a0\value\kind != c.LM_P0_NODE_ATOM || a0\value\as = 0 || a0\value\as\atom = 0
        return: 2
    sl: l2_next_active(a0\next)
    mem: 0
    if: sl != 0
        mem: l2_next_active(sl\next)
    if: sl = 0 || sl\value = 0 || sl\value\kind != c.LM_P0_NODE_ATOM || sl\value\as = 0 || l2_is_slash(sl\value\as\atom) = 0 || mem = 0 || mem\value = 0 || mem\value\kind != c.LM_P0_NODE_ATOM || mem\value\as = 0 || mem\value\as\atom = 0 || l2_ident(mem\value\as\atom) = 0
        return: 2
    owner: l2_bound_nsty(mi, a0\value\as\atom)
    if: owner < 0
        return: 2
    slots: slots_own
    consumed: 3
    nseg: 0
    while: consumed <= span
        if: mem\value\as\atom\data = 0 || mem\value\as\atom\length = 0U
            return: 2
        buf: l2_text_room(mem\value\as\atom\length + 1U, buf_own, 128U)
        if: buf = 0
            return: l2_alloc_or(l2_src, at, "out of memory")
        memcpy(buf, mem\value\as\atom\data, mem\value\as\atom\length)
        buf[mem\value\as\atom\length]: 0
        slot: l2_ns_slot_named(owner, buf, 0U, mem\value\as\atom\length, @ kind, @ ent)
        if: slot < 0 || (kind != 2 && kind != 3) || ent < 0
            return: 2
        # The names found so far, kept in twice the room (storage of the translation, released by l2_release).
        if: nseg >= slots_cap
            if: slots_cap > c.INT_MAX / 2
                l2_alloc_err: 2
                return: l2_alloc_or(l2_src, at, "size overflow")
            grown: (cast: (@: int) l2_text_room((cast: (size_t) slots_cap) * 2U * c.sizeof(c.int), 0, 0U))
            if: grown = 0
                return: l2_alloc_or(l2_src, at, "out of memory")
            memcpy((cast: (@: void) grown), (cast: (@: void) slots), (cast: (size_t) nseg) * c.sizeof(c.int))
            slots: grown
            slots_cap: slots_cap * 2
        ---
        slots[nseg]: slot
        nseg: nseg + 1
        if: consumed = span
            consumed: span + 1
        else:
            owner: ent
            sl: l2_next_active(mem\next)
            mem: 0
            if: sl != 0
                mem: l2_next_active(sl\next)
            if: sl = 0 || sl\value = 0 || sl\value\kind != c.LM_P0_NODE_ATOM || sl\value\as = 0 || l2_is_slash(sl\value\as\atom) = 0 || mem = 0 || mem\value = 0 || mem\value\kind != c.LM_P0_NODE_ATOM || mem\value\as = 0 || mem\value\as\atom = 0 || l2_ident(mem\value\as\atom) = 0
                return: 2
            consumed: consumed + 2
        ---
    ---
    if: nseg < 1
        return: 2
    if: l2_tx_open(cur, cur_own, 1024U) != 0 || l2_tx_open(nxt, nxt_own, 1024U) != 0 || l2_prep(a0\value, mi, ind, cur) != 0
        return: 1
    # Each name wraps the text so far: the next text is written from the current one, then they change places.
    i: 0
    while: i < nseg
        s: slots[i]
        if: c.snprintf(num, 32U, ", %uU)", (cast: (unsigned) s)) < 0 || l2_tx_join(nxt, "lmx_arena_ref_struct(", cur\data, num, 0, 0) != 0
            return: l2_alloc_or(l2_src, at, "out of memory")
        swap: cur
        cur: nxt
        nxt: swap
        i: i + 1
    ---
    if: l2_tx_set(dest, cur\data) != 0
        return: l2_alloc_or(l2_src, at, "out of memory")
return: 0

# 0: *out_ni is the Structure index of this actual. 1: a located error was
# reported. 2: not a Structure actual (a primitive expression stays on the
# ordinary check). A field path of any depth is the leaf Structure.
fn: l2_actual_ns (int: mi; @: LmP0Field a0; int: span; const: @(char path); const: @(LmP0Node at); @: int out_ni) int
    int: cmi
    int: formal
    int: owner
    int: fx
    size_t: off
    @: LmP0Text left
    []: char buf_own 128
    @: char buf 0
    L2Address: address_value
    @: L2Address address @ address_value
    int: address_status
    \out_ni: 0 - 1
    if: a0 = 0 || a0\value = 0 || out_ni = 0
        return: 2
    address_status: l2_address_operand(a0, span, mi, address)
    if: address_status = 1
        return: l2_error(path, a0\value, "unresolved addressable name")
    if: address_status = 0
        if: address\immutable != 0
            return: l2_error(path, a0\value, "the address of an eternal branch field cannot be taken")
        if: address\type < 0
            return: 2
        if: l2_pointer_depth(address\type) != 1
            return: l2_error(path, a0\value, "reference depth does not match the receiving contract")
        if: l2_colon_is_graph_ty(address\type) = 0
            return: l2_error(path, a0\value, "implements is false in function argument")
        if: address\kind = 1 && l2_own_schema(address\index) != -1
            \out_ni: l2_own_schema(address\index)
            return: 0
        if: address\model < 0
            return: 2
        \out_ni: address\model
        return: 0
    if: span = 1 && a0\value\kind = c.LM_P0_NODE_ATOM && a0\value\as != 0 && a0\value\as\atom != 0
        owner: l2_resolved_own(mi, a0\value\as\atom)
        if: owner >= 0 && l2_own_schema(owner) != -1
            \out_ni: l2_own_schema(owner)
            return: 0
        cmi: l2_ns_find_payload(a0\value\as\atom)
        if: cmi >= 0
            \out_ni: cmi
            return: 0
        cmi: l2_graph_nsty(mi, a0\value\as\atom)
        if: cmi >= 0
            \out_ni: cmi
            return: 0
        cmi: l2_call_head_method(mi, a0\value\as\atom, @ formal)
        if: cmi >= 0 && l2_nsty_get(cmi, 0 - 1) >= 0
            \out_ni: l2_nsty_get(cmi, 0 - 1)
            return: 0
        off: 0U
        if: a0\value\as\atom\data != 0 && a0\value\as\atom\length > 2U
            while: off < a0\value\as\atom\length && a0\value\as\atom\data[off] != 92
                off: off + 1U
            if: off > 0U && off + 1U < a0\value\as\atom\length
                buf: l2_text_room(a0\value\as\atom\length + 1U, buf_own, 128U)
                if: buf = 0
                    return: l2_alloc_or(path, a0\value, "out of memory")
                memcpy(buf, a0\value\as\atom\data, a0\value\as\atom\length)
                buf[a0\value\as\atom\length]: 0
                buf[off]: 0
                left: (cast: (@: LmP0Text) l2_xmalloc(c.sizeof(c.LmP0Text)))
                if: left = 0
                    return: l2_error(path, a0\value, "out of memory")
                left\data: buf
                left\length: off
                owner: l2_bound_nsty(mi, left)
                l2_xfree((cast: (@: void) left))
                if: owner < 0
                    return: l2_error(path, a0\value, "unresolved name")
                fx: l2_ns_field_ix(owner, buf + off + 1U)
                if: fx < 0
                    return: l2_error(path, a0\value, "unresolved name")
                if: (l2_nsf_kind[fx] != 2 && l2_nsf_kind[fx] != 3) || l2_nsf_ref[fx] < 0
                    return: l2_error(path, a0\value, "a field path must end at a Structure")
                \out_ni: l2_nsf_ref[fx]
                return: 0
            ---
        ---
        return: 2
    if: span = 1 && a0\value\kind = c.LM_P0_NODE_FRAME && a0\value\as != 0 && a0\value\as\frame != 0 && a0\value\as\frame\head != 0
        cmi: l2_call_head_method(mi, a0\value\as\frame\head, @ formal)
        if: cmi < 0
            return: 2
        owner: l2_nsty_get(cmi, 0 - 1)
        # RECEPTION-EDGE-DEBTS (c) (Codex, FABLE-CODEX-20261004-12): a result of opaque type (`@: void`) names no
        # Structure, and that is no rule asking for one.  It is the value the same call gives through a local
        # reference: no Structure actual by its type (2), a dynamic candidate (l2_reference_source: the callee's
        # result place), admitted where the input is formed; the call is evaluated once, into its temporary.
        if: owner < 0 && l2_m_ret[cmi] = 16
            return: 2
        if: owner < 0
            return: l2_error(path, at, "implements is false in function argument")
        \out_ni: owner
        return: 0
    if: span >= 3
        return: l2_actual_path(mi, a0, span, path, at, out_ni)
return: 2

# RECEPTION-EDGE-DEBTS (f): whether a returned value is of opaque type -- a name of `@: void`, or a call whose result is
# one -- and so holds what was given to it.
fn: l2_return_opaque (@: LmP0Field first; int: n; int: mi) int
    int: ty 0
    if: n != 1 || first = 0 || first\value = 0
        return: 0
    if: first\value\kind != c.LM_P0_NODE_ATOM && first\value\kind != c.LM_P0_NODE_FRAME
        return: 0
    if: l2_colon_value_ty(first\value, mi, @ ty) != 0
        return: 0
return: (cast: (int) (ty = 16))

# The callers of a return are not in this body, so the Consumer is the
# required descriptor. A type name, a bound variable, a call result, and a
# field path share that call.
fn: l2_admit_return (int: mi; @: LmP0Field first; int: n; const: @(char path); const: @(LmP0Node at)) int
    L2ReferenceSource: source
    int: req
    int: cand
    int: ast
    int: cmi
    req: l2_nsty_get(mi, 0 - 1)
    if: req < 0 || n < 1 || first = 0 || first\value = 0
        return: 0
    l2_reference_source(first, n, mi, @ source)
    cand: 0 - 1
    if: n = 1 && first\value\kind = c.LM_P0_NODE_FRAME && first\value\as != 0 && first\value\as\frame != 0 && first\value\as\frame\head != 0
        cmi: l2_find_method(first\value\as\frame\head)
        if: cmi >= 0
            cand: l2_nsty_get(cmi, 0 - 1)
            # RECEPTION-EDGE-DEBTS (f): a call's result of opaque type is admitted when the program runs (below).
            if: cand < 0 && l2_m_ret[cmi] = 16
                if: l2_d105_note(mi, mi, 0 - 1, first, n, at) != 0
                    return: 1
                return: l2_admit_site(mi)
            if: cand < 0
                return: l2_error(path, at, "implements is false in return value")
            # D-105 native: the result of cmi reaches this method's result.
            if: l2_d105_note(mi, mi, 0 - 1, first, n, at) != 0
                return: 1
            # DUPLICATE-STOP: the result of a call is a place that holds what its callee returned -- no proof of
            # its origin here; its admission when the program runs is this method's implicit `implements`.
            if: source.method >= 0 && l2_d105_dynamic(@ source) != 0
                return: l2_admit_site(mi)
            if: source.method >= 0
                return: 0
            return: l2_admit_implements(cand, req, req, 0, path, at, "return value")
        ---
    ---
    ast: l2_actual_ns(mi, first, n, path, at, @ cand)
    if: ast = 1
        return: 1
    if: ast = 2 && n = 1 && first\value\kind = c.LM_P0_NODE_ATOM && first\value\as != 0
        cand: l2_bound_nsty(mi, first\value\as\atom)
        if: cand >= 0
            ast: 0
        ---
    ---
    # RECEPTION-EDGE-DEBTS (f) (Codex, FABLE-CODEX-20261004-12: "absence of a named source schema is not proved
    # implements-false"): a value of opaque type holds what was given to it.  It is admitted when the program runs,
    # by the result's consuming contract -- every field of the result's type, the callers not being in this body --
    # and a refusal is this method's implicit `implements`; the declarations that reach it are the result's.
    if: ast = 2 && l2_return_opaque(first, n, mi) != 0
        if: l2_d105_note(mi, mi, 0 - 1, first, n, at) != 0
            return: 1
        return: l2_admit_site(mi)
    if: ast = 2
        return: l2_error(path, at, "implements is false in return value")
    # D-105 native: the value's type reaches this method's result (or its formal, passed on as it is).
    if: l2_d105_note(mi, mi, 0 - 1, first, n, at) != 0
        return: 1
    # DUPLICATE-STOP (Codex, FABLE-CODEX-20261004-12: "If current origin is not proved, use the common dynamic
    # admission rather than a defensive abort or assumed YES"): a formal or an own reference holds what was given to
    # it; its admission to the result when the program runs is this method's implicit `implements`.
    if: source.method >= 0 && l2_d105_dynamic(@ source) != 0
        return: l2_admit_site(mi)
    if: source.method >= 0
        return: 0
return: l2_admit_implements(cand, req, req, 0, path, at, "return value")

# A Structure field path as a return value, one field or deeper.
# 0: l2_tok holds the expression. 1: located failure. 2: not this shape.
fn: l2_emit_return_path (int: mi; @: LmP0Field first; int: n; const: @(char ind); const: @(LmP0Node at)) int
    if: ind = 0 || first = 0
        return: 2
return: l2_emit_actual_path(mi, first, n, ind, at, l2_tok)

# A CALL OF THE RESOLVED CALLEE idx (FABLE-OPUS-RECEIVER-CONTRACT-20260924-139): one check for
# every spelling of a call -- `m(args)`, `m: args`, the vertical form, and a bare atom `m`, which
# has no argument Structure (body 0) and so no actuals.  fi is the callable formal the call goes
# through, idx then being its required contract, or -1 for a unit method or a method path.
fn: l2_check_call (const: @(LmP0Node node); int: idx; int: fi; const: @(LmP0Structure body); int: mi; const: @(char path)) int
return: l2_check_call_at(node, l2_app_head(node), idx, fi, body, mi, path)

# The same check, the call's written head given: the node's own (l2_app_head), or the path a path operand writes,
# `Holder\tick` with no argument (K03 S6) -- node is then the path's first atom, where the call stands.
fn: l2_check_call_at (const: @(LmP0Node node); @: LmP0Text head; int: idx; int: fi; const: @(LmP0Structure body); int: mi; const: @(char path)) int
    L2ReferenceSource: source
    @: LmP0Field a0 0
    int: nact 0
    int: actual_span
    int: actual_i
    int: req_mi
    int: cand_mi
    int: cand_ns
    int: ast
    int: nst
    int: handled
    int: occ_mi 0 - 1
    int: k
    int: cf_kind 0
    int: cf_fi 0 - 1
    int: cf_cand 0 - 1
    int: ns_at 0 - 1
    int: vty 0
    # The actuals by formal coordinate: the body's projection.
    if: body != 0
        a0: l2_next_active(l2_call_actuals(body))
        nact: l2_actual_count(l2_call_actuals(body))
    ---
    # K03: a bare head writes no argument; a formal it leaves without one is said by the one binding (l2_bind_call),
    # as for `f()`.
    if: body = 0 && l2_m_arity[idx] > 0 && node != 0 && node\kind = c.LM_P0_NODE_ATOM && l2_bind_call_at(node, head, idx, 0 - 1, path) != 0
        return: 1
    if: nact != l2_m_arity[idx]
        return: l2_error(path, node, "incompatible entry signature")
    # Descriptor-only required method is legal as a formal contract; refuse bodiless only on direct calls.
    if: fi < 0 && l2_m_native(idx) = 0
        return: l2_error(path, node, "not callable")
    # Bit 1: a call of idx itself (by name or path).  Bit 2: a call through the callable formal fi,
    # whose contract is idx -- the callee is whichever method the actual names.
    if: fi < 0
        l2_m_edge[l2_edge_off(mi, idx)]: l2_m_edge[l2_edge_off(mi, idx)] | 1
    else:
        l2_m_edge[l2_edge_off(mi, idx)]: l2_m_edge[l2_edge_off(mi, idx)] | 2
    ---
    if: l2_check_throws_handled(mi, idx, path, node) != 0
        return: 1
    # A call through callable formal fi is noted as such (its count is fi + 1): in the fixed point of
    # dynamic inputs the methods that reach the formal stand in the place of its declaring method
    # (l2_dyn_site).
    if: fi < 0 && l2_note_call(mi, idx, node, path) != 0
        return: 1
    if: fi >= 0 && l2_wait_add(4, mi, (cast: (@: void) node), fi + 1, idx, node, path) != 0
        return: 1
    actual_i: 0
    while: a0 != 0
        actual_span: l2_expr_span(a0)
        # A callable formal takes the occurrence of the callable its actual names -- a reference,
        # checked against the formal's contract -- not a call (plan §3 native gate (г)).
        req_mi: l2_cf_get(idx, actual_i)
        # Through a callable formal the selected class admits a Structure input by its own model, and a class whose
        # Consumer does not admit it refuses it when selected: this method's implicit `implements`.
        if: fi >= 0 && req_mi < 0 && l2_nsty_get(idx, actual_i) >= 0 && l2_admit_site(mi) != 0
            return: l2_error(path, node, "internal: admission outside a method")
        if: req_mi >= 0
            if: actual_span = 1 && a0\value != 0 && l2_frame_head(a0\value, "merge") != 0
                if: l2_t7_from_actual(mi, idx, actual_i, a0\value, path) != 0
                    return: 1
                # K04 S3: the node the merge builds is formed as its model is (kind 5).
                if: l2_cfl_note(idx, mi, fi, actual_i, 5, l2_t7_actual_model(mi, a0\value), 0 - 1, node) != 0
                    return: 1
                ---
            else:
                cf_kind: 0
                cf_fi: 0 - 1
                cand_mi: l2_cf_actual(mi, a0, actual_span, @ cf_kind, @ cf_fi)
                # K04 S3: a held name -- a node of its model (kind 4), admitted by the model's signature.
                if: cand_mi < 0 && l2_cf_held(mi, a0, actual_span) >= 0
                    cf_fi: l2_cf_held(mi, a0, actual_span)
                    cf_kind: 4
                    cand_mi: l2_mad_held_model(cf_fi)
                ---
                if: cand_mi < 0 || l2_method_sig_compatible(cand_mi, req_mi) = 0
                    return: l2_error(path, node, "incompatible entry signature")
                if: cf_kind = 4 && l2_cfl_note(idx, mi, fi, actual_i, 4, cand_mi, cf_fi, node) != 0
                    return: 1
                # A unit method's occurrence is used by this call; a forwarded formal's is not known
                # here -- the caller of THIS method chose it.
                if: cf_kind = 1
                    l2_m_value_used[cand_mi]: 1
                # K04: what reaches the formal is recorded (l2_cfl_note): the method named, or the caller's
                # own formal handed on.
                if: cf_kind = 1 && l2_cfl_note(idx, mi, fi, actual_i, 1, cand_mi, 0 - 1, node) != 0
                    return: 1
                if: cf_kind = 2 && l2_cfl_note(idx, mi, fi, actual_i, 2, mi, cf_fi, node) != 0
                    return: 1
            ---
        ---
        # A callable WITHOUT a result is a REFERENCE value (docs #callables: a nonreturning callable
        # is transmitted by reference, not executed).  Where the receiving contract asks for a NUMBER
        # it is refused as any other reference is -- the phrase l2_check_value_convert_core uses --
        # and not as a callable that has nothing to give (K04, witness matrix row 7).  A RETURNING
        # callable is untouched: it executes, and its result is what a number place receives.
        if: req_mi < 0 && l2_nsty_get(idx, actual_i) < 0 && l2_prim_code_name(l2_ft(idx, actual_i)) != 0
            cf_cand: l2_cf_actual(mi, a0, actual_span, @ cf_kind, @ cf_fi)
            if: cf_cand >= 0 && l2_m_ret[cf_cand] = 8
                return: l2_error(path, a0\value, "a reference where a number is asked")
            ---
            # A name of a unit-level NAMED STRUCTURE is a reference like any other.  l2_colon_bound_ty
            # types an own field, a formal and a dynamic input, but NOT a unit Structure's name: typing
            # it there changed the meaning of that name for 55 unrelated callers (measured,
            # build/l2_harness/dk_k04c_full_01 -- `unit_named_struct_*`, `unit_s7_*` and others stopped
            # translating).  The one rule -- a number place refuses a reference -- is applied to that
            # atom here instead, where the receiving contract is a number.
            if: actual_span = 1 && a0\value != 0 && a0\value\kind = c.LM_P0_NODE_ATOM && a0\value\as != 0 && a0\value\as\atom != 0
                ns_at: l2_ns_find(a0\value\as\atom)
                if: ns_at >= 0 && l2_ns_parent[ns_at] < 0
                    return: l2_error(path, a0\value, "a reference where a number is asked")
                ---
            ---
        ---
        if: req_mi < 0 && l2_empty_actual(a0, idx, actual_i) != 0
            if: l2_admit_site(mi) != 0
                return: l2_error(path, node, "internal: admission outside a method")
            ---
        else:
            handled: 0
            occ_mi: 0 - 1
            nst: l2_nsty_get(idx, actual_i)
            # A no-result callable is a reference (docs #callables). An ordinary
            # nonprimitive formal admits that occurrence; it does not call it.
            if: req_mi < 0 && nst >= 0
                occ_mi: l2_occ_actual(mi, a0, actual_span)
            if: occ_mi >= 0
                if: l2_cfa_source(mi, idx, fi, actual_i, l2_schema_method(occ_mi), node) != 0
                    return: 1
                handled: 1
            ---
            if: req_mi < 0 && nst >= 0 && occ_mi < 0
                ast: l2_actual_ns(mi, a0, actual_span, path, node, @ cand_ns)
                if: ast = 1
                    return: 1
                if: ast = 0
                    l2_reference_source(a0, actual_span, mi, @ source)
                    if: source.method < 0 && l2_m_node[idx] != 0 && l2_m_node[idx]\as != 0
                        if: l2_admit_consumer_ix(cand_ns, nst, l2_fn(idx, actual_i), l2_m_node[idx]\as\frame, path, node, "function argument") != 0
                            return: 1
                        ---
                    else:
                        if: source.method < 0 && l2_admit_implements(cand_ns, nst, nst, 0, path, node, "function argument") != 0
                            return: 1
                        ---
                    ---
                    if: l2_cfa_note(mi, idx, fi, actual_i, a0, actual_span, node) != 0
                        return: 1
                    handled: 1
                ---
                # ARGUMENT-EDGE-REFERENCE-TYPE (RECEPTION-EDGE-DEBTS (e): "provided actual reference depth/type is
                # correct"): a name whose reference is a level deeper than the formal's, or of a type no Structure is
                # held in, is refused where it is given -- as a call's result of that type is (l2_actual_ns), and as an
                # assignment to a typed reference refuses the pair.  An opaque `@: void` and a graph reference pass.
                if: ast = 2 && actual_span = 1 && a0\value != 0 && a0\value\kind = c.LM_P0_NODE_ATOM && l2_colon_value_ty(a0\value, mi, @ vty) = 0 && l2_pointer_depth(vty) > 0 && l2_colon_is_graph_ty(vty) = 0 && vty != 16
                    return: l2_error(path, node, "implements is false in function argument")
                # (c): an actual that is a Frame and no Structure actual by its type -- a call's result of opaque type
                # (l2_actual_ns), a pointer cast -- reaches the formal from its source's place: the callee's result
                # place, whose sources its returns give (l2_d105_note_return), or the cast's operand.  The formal's
                # reads take them by name; before, they were read by position (CAST-ACTUAL-READ-BY-POSITION).
                if: ast = 2 && actual_span = 1 && a0\value != 0 && (a0\value\kind = c.LM_P0_NODE_FRAME || a0\value\kind = c.LM_P0_NODE_ATOM) && l2_cfa_note(mi, idx, fi, actual_i, a0, actual_span, node) != 0
                    return: 1
            ---
            # D-108: an actual admitted to a Structure-typed formal is checked as any other actual is --
            # a call in it records its edge (the throw closure reaches this caller) and meets the static
            # rule of §14; the admission above decided only its type.
            if: handled != 0 && occ_mi < 0 && (actual_span < 1 || l2_check_fields(a0, actual_span, mi, path, node) != 0)
                return: 1
            if: handled = 0 && req_mi < 0 && (actual_span < 1 || l2_check_fields(a0, actual_span, mi, path, node) != 0)
                return: 1
            if: handled = 0 && req_mi < 0 && nst < 0 && l2_empty_actual(a0, idx, actual_i) = 0 && l2_check_value_convert_field(a0, actual_span, l2_ft(idx, actual_i), mi, path) != 0
                return: 1
            # D-105 native: a bound name -- a formal, an own field -- of a named type is a source of that
            # type for the formal (l2_actual_ns resolves a type name or a path, not a bound name), or an edge
            # when it is a formal passed on as it is.  l2_d105_close builds its pair table by name and
            # refuses, located, a pair it cannot build.
            if: handled = 0 && req_mi < 0 && nst >= 0 && actual_span = 1 && a0\value != 0 && a0\value\kind = c.LM_P0_NODE_ATOM && a0\value\as != 0 && l2_bound_nsty(mi, a0\value\as\atom) >= 0
                if: l2_cfa_note(mi, idx, fi, actual_i, a0, actual_span, node) != 0
                    return: 1
            ---
            if: handled = 0 && actual_span = 1 && a0\value != 0 && a0\value\kind = c.LM_P0_NODE_ATOM && nst >= 0 && l2_m_node[idx] != 0 && l2_m_node[idx]\as != 0
                if: l2_admit_consumer_uses(a0\value\as\atom, nst, l2_fn(idx, actual_i), l2_m_node[idx]\as\frame, path, node, "function argument") != 0
                    return: 1
                ---
                if: l2_untyped_graph(mi, a0\value) != 0 && l2_admit_site(mi) != 0
                    return: l2_error(path, node, "internal: admission outside a method")
                ---
            ---
            if: actual_span = 1 && a0\value != 0 && a0\value\kind = c.LM_P0_NODE_ATOM
                if: l2_check_literal_kind(a0\value\as\atom, l2_lit_kind_from_ft(l2_ft(idx, actual_i)), path, node) != 0
                    return: 1
                ---
            ---
        ---
        # A candidate read from a reference place -- a formal, an input handed on, an own reference, a call's
        # result -- can be a value the translation has no layout for, a letter among them.  Its admission to a
        # Structure formal can then fail when the program runs, and the failure is this method's implicit
        # `implements`: the input is formed here (l2_emit_model_admit).
        if: req_mi < 0 && l2_nsty_get(idx, actual_i) >= 0 && l2_cf_get(idx, actual_i) < 0 && l2_empty_actual(a0, idx, actual_i) = 0
            l2_reference_source(a0, actual_span, mi, @ source)
            if: l2_d105_dynamic(@ source) != 0 && l2_admit_site(mi) != 0
                return: l2_error(path, node, "internal: admission outside a method")
            ---
            # The way such a candidate comes to the formal from a place of this method is an anchor edge
            # (l2_d105x_add): the identity entries of the reception follow the places it passed through.
            if: source.method >= 0 && l2_d105_dynamic(@ source) != 0 && l2_cfa_anchor(mi, idx, fi, actual_i, (source.method), (source.place)) != 0
                return: l2_alloc_or(path, node, "out of memory")
            ---
        # Opaque pointer formals carry possible source facts too. Their lack
        # of a receiving model does not erase a later forwarding admission.
        if: req_mi < 0 && l2_pointer_depth(l2_ft(idx, actual_i)) > 0 && l2_cfa_note(mi, idx, fi, actual_i, a0, actual_span, node) != 0
            return: 1
        k: 0
        while: k < actual_span && a0 != 0
            a0: l2_next_active(a0\next)
            k: k + 1
        actual_i: actual_i + 1
    ---
return: 0

# A CALLABLE IN VALUE POSITION (l2_check_primary): its result is the value, so it is called with
# no arguments (l2_check_call), and a callable without a result -- a sub, or a callable formal
# whose contract is one -- has no value to give (plan §3 native gate (б)).
fn: l2_check_value_call (const: @(LmP0Node node); int: idx; int: fi; int: mi; const: @(char path)) int
return: l2_check_value_call_at(node, l2_app_head(node), idx, fi, mi, path)

fn: l2_check_value_call_at (const: @(LmP0Node node); @: LmP0Text head; int: idx; int: fi; int: mi; const: @(char path)) int
    if: l2_m_ret[idx] = 8
        return: l2_error(path, node, "a callable without a result has no value")
return: l2_check_call_at(node, head, idx, fi, 0, mi, path)

# A call Frame whose callee has no result: a sub, or a callable formal whose contract is one.  As a
# value it has none to give (l2_check_fields); as a statement it is simply called.
fn: l2_frame_void_call (const: @(LmP0Node node); int: mi) int
    int: idx
    int: fi
    if: node = 0 || node\kind != c.LM_P0_NODE_FRAME || node\as = 0 || node\as\frame = 0
        return: 0
    # D-106: a callable formal of this method shadows a unit method of its name.
    idx: l2_call_head_method(mi, node\as\frame\head, @ fi)
    if: idx < 0
        return: 0
return: l2_m_ret[idx] = 8

fn: l2_check_expr (const: @(LmP0Node node); int: mi; const: @(char path)) int
return: l2_check_primary(node, mi, path)

fn: l2_ty_number (int: ty) int
    if: ty = -10 || ty = 0 || ty = 1 || ty = 2 || ty = 34 || ty = 36
        return: 1
    return: 0

# One numeric operand: an element of a primitive own array, a numeric literal,
# or a name whose bound type is already a number. 0 = consumed, out_after is
# the next field. 1 = not a number.
fn: l2_int_span (@: LmP0Field f; int: n; int: mi; @@: LmP0Field out_after) int
    int: k
    int: ty 0
    L2IndexedOperand: indexed_value
    @: L2IndexedOperand indexed @ indexed_value
    if: out_after = 0 || n < 1
        return: 1
    \out_after: 0
    k: l2_indexed_operand(f, n, mi, indexed)
    if: k > 1
        return: 1
    if: k = 0
        if: indexed\address != 0 || l2_ty_number(indexed\type) = 0
            return: 1
        \out_after: indexed\after
        return: 0
    ---
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM || f\value\as = 0
        return: 1
    if: l2_num(f\value\as\atom) != 0 || l2_signed_num(f\value\as\atom) != 0
        \out_after: l2_next_active(f\next)
        return: 0
    if: l2_ident(f\value\as\atom) != 0 && l2_colon_bound_ty(mi, f\value\as\atom, @ ty) = 0 && l2_ty_number(ty) != 0
        \out_after: l2_next_active(f\next)
        return: 0
    return: 1

# 0 = the run from f is `@ array[i]` plus at least one `+`/`-` number, and
# nothing follows that run. out_ty is the element pointer. 1 = not this shape.
fn: l2_ptr_arith_ty (@: LmP0Field f; int: count; int: mi; @: int out_ty) int
    int: pty
    int: nstep 0
    int: remaining count
    @: LmP0Field after
    @: LmP0Field op
    L2IndexedOperand: indexed_value
    @: L2IndexedOperand indexed @ indexed_value
    if: out_ty = 0 || f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM || f\value\as = 0
        return: 1
    if: l2_indexed_operand(f, count, mi, indexed) != 0 || indexed\address = 0
        return: 1
    pty: indexed\type
    if: pty < 0
        return: 1
    remaining: remaining - indexed\count
    f: indexed\after
    while: remaining >= 2 && f != 0 && f\value != 0 && f\value\kind = c.LM_P0_NODE_ATOM && f\value\as != 0 && (l2_text_eq(f\value\as\atom, "+") != 0 || l2_text_eq(f\value\as\atom, "-") != 0)
        op: l2_next_active(f\next)
        remaining: remaining - 1
        if: l2_int_span(op, remaining, mi, @ after) != 0
            return: 1
        while: remaining > 0 && op != after
            op: l2_next_active(op\next)
            remaining: remaining - 1
        if: op != after
            return: 1
        nstep: nstep + 1
        f: after
    ---
    if: nstep < 1 || remaining != 0
        return: 1
    \out_ty: pty
    return: 0

# Where a pointer result may land: an assignment whose head already has a
# type, or a method return (return codes brought into the value-type space
# the same way l2_colon_simple_ty does). 1 = this statement is not a landing.
fn: l2_ptr_land_ty (const: @(LmP0Node at); int: mi; @: int out_ty) int
    int: rt
    if: out_ty = 0 || at = 0 || mi < 0
        return: 1
    if: l2_frame_head(at, "return") != 0
        rt: l2_m_ret[mi]
        if: rt = 33
            rt: 34
        if: rt = 3
            rt: 12
        if: rt = 35
            rt: 3
        if: rt = 32
            rt: 17
        \out_ty: rt
        return: 0
    if: l2_is_asgn(at, mi) = 0 || at\as = 0 || at\as\frame = 0 || at\as\frame\head = 0
        return: 1
    return: l2_colon_bound_ty(mi, at\as\frame\head, out_ty)

fn: l2_check_fields (@: LmP0Field field; int: n; int: mi; const: @(char path); const: @(LmP0Node at)) int
    @: LmP0Field f
    []: char chbuf_own 256
    @: char chbuf 0
    size_t: room 0U
    size_t: chn 0U
    int: chain
    int: cck
    int: ck
    size_t: cpn 0U
    int: cpni 0
    int: cpres 0
    int: cpoi 0
    int: cproot 0
    int: cpfi 0
    int: fpk 0
    []: char cpbuf_own 1024
    @: char cpbuf 0
    int: cpraw
    int: cpraw_j 0
    int: cpleaf 0
    int: segocc 0 - 1
    size_t: sego 0U
    size_t: segl 0U
    size_t: segno 0U
    size_t: segnl 0U
    @: LmP0Field cpos
    @: LmP0Field p1
    @: LmP0Field p2
    @: LmP0Field p3
    @: LmP0Field p4
    @: LmP0Field p5
    int: i
    int: skip
    int: after 0
    int: have_value 0
    int: po
    int: fpc
    int: array_status
    size_t: array_index
    int: array_count
    []: char apd_own 1024
    @: char apd 0
    size_t: apn 0U
    int: acnt 0
    int: akind 0
    int: aelem 0
    int: adepth 0
    int: ast 1
    size_t: ai0 0U
    size_t: ai1 0U
    @: LmP0Field aafter 0
    @: LmP0Field aidx_f
    int: pty 0
    int: tty 0
    int: pcall
    int: prun
    @: char ptext 0
    LmP0Text: pword
    int: num_prev 0
    int: nprev 0
    int: nty 0
    L2Address: address_value
    @: L2Address address @ address_value
    int: address_status
    L2IndexedOperand: indexed_value
    @: L2IndexedOperand indexed @ indexed_value
    L2ArrayPlace: array_place
    # Type-dependent field/address checks replay as a whole at the original
    # statement and scope once hidden inputs close. A kind-only replay cannot
    # validate path roots, tails or receiving contracts.
    if: l2_waits(field, n, mi) != 0
        return: l2_wait_add(6, mi, (cast: (@: void) field), n, 0, at, path)
    address_status: l2_address_operand(field, n, mi, address)
    if: address_status = 1
        return: l2_error(path, at, "unresolved addressable name")
    if: address_status = 0
        if: address\immutable != 0
            return: l2_error(path, at, "the address of an eternal branch field cannot be taken")
        return: 0
    if: n <= 0
        return: l2_error(path, at, "unsupported body")
    if: l2_check_value_kinds(field, n, mi, path, at) != 0
        return: 1
    # K03 S6: a path operand that selects a callable is consumed as `Holder\tick()` is: its nullary call, checked by the
    # one call check with the path as the call's written head -- here the whole value, below one operand among others.
    pcall: l2_path_run_callee(field, n, mi, @ ptext)
    if: pcall >= 0 && l2_m_ret[pcall] != 8
        pword.data: ptext
        pword.length: strlen(ptext)
        pcall: l2_check_value_call_at(l2_next_active(field)\value, @ pword, pcall, 0 - 1, mi, path)
        l2_xfree((cast: (@: void) ptext))
        return: pcall
    if: ptext != 0
        l2_xfree((cast: (@: void) ptext))
        ptext: 0
    # A path's text of any length: the local buffers when the fields' text fits them, else storage of its size
    # (l2_text_room).  No builder below meets a capacity shorter than the text it joins.
    room: l2_atoms_len(field, -1) + 1U
    cpbuf: l2_text_room(room, cpbuf_own, 1024U)
    chbuf: l2_text_room(room, chbuf_own, 256U)
    apd: l2_text_room(room, apd_own, 1024U)
    if: cpbuf = 0 || chbuf = 0 || apd = 0
        return: l2_alloc_or(path, at, "out of memory")
    cpn: l2_join_path(field, n, cpbuf, room - 1U)
    if: cpn != 0U
        cpraw: l2_raw_path(cpbuf, cpn, mi, @ cpraw_j)
        if: cpraw = 0
            return: 0
        ---
    ---
    if: cpn != 0U && l2_path_root(cpbuf, cpn, @ cpni, @ cpres, @ cpoi, @ cproot, @ cpfi) = 0
        # A hidden Structure capture retains its copied-field contract. Its
        # model permits typing this root, but does not turn it into an ordinary
        # formal or bypass the capture-specific field/depth validation.
        if: cpoi < 0 && l2_cap_arg_ns(mi, cpfi) >= 0
            if: l2_cap_fields(mi, l2_dn(mi, cpfi - l2_m_arity[mi]), cpni, 0, 0) < 0
                return: 1
            return: 0
        # D-97: l2_path_root recognizes every formal as a root (D-28); a path continuing off a
        # formal with no Structure type (cpni < 0) that the c.* door did not open (cpraw above) is
        # the located refusal D-28 promises -- not an accepted run the expression pass then copies
        # as C member access.
        # K02c: a hidden input whose schema is a merge result's has no NAMED type (cpni < 0) but a slot map (cpres).
        if: cpfi >= 0 && cpni < 0 && cpres < 0 && cpoi < 0
            if: l2_free_path_refused(mi, cpfi, path, at) != 0
                return: 1
            return: l2_error(path, at, "unknown field path root")
        # The root resolves; so must every name after it (l2_path_kind, the walk the emitter makes) -- a name that
        # names nothing is refused where the path stands, not left to the emitter, whose read fails without a word; in
        # this check's own words and places: a single hop at its name, a deeper path at its start.
        if: l2_seg_count(cpbuf, cpn) = 2 && l2_path_kind(cpbuf, cpn, @ cpleaf) < 0
            # A named explicit occurrence that resolves to nothing keeps the
            # occurrence's own located refusal: the name atom after the bracket
            # group a merge result's index, or the occurrence a declaration
            # place does not have (an argument; unit_own_last_occurrence).
            sego: 0U
            segl: 0U
            segocc: 0 - 1
            if: l2_seg_at(cpbuf, cpn, 1, @ sego, @ segl) = 0 && l2_seg_split(cpbuf, sego, segl, @ segocc, @ segno, @ segnl) = 0 && segocc >= 0
                cpos: l2_next_active(l2_next_active(l2_next_active(field)\next)\next)
                if: cpos != 0 && cpos\value != 0 && cpos\value\kind = c.LM_P0_NODE_ATOM && cpos\value\as != 0 && cpos\value\as\atom != 0 && cpos\value\as\atom\data != 0 && cpos\value\as\atom\length = 1U && cpos\value\as\atom\data[0] = 91
                    cpos: l2_after_bracket(cpos)
                ---
                if: cpres >= 0
                    return: l2_error(path, cpos\value, "merge occurrence index out of range")
                return: l2_error(path, cpos\value, "no such occurrence")
            ---
            return: l2_error(path, l2_next_active(l2_next_active(l2_next_active(field)\next)\next)\value, "unresolved name")
        if: l2_seg_count(cpbuf, cpn) > 2 && l2_path_kind(cpbuf, cpn, @ cpleaf) < 0
            return: l2_error(path, l2_next_active(field)\value, "unknown field path segment")
        return: 0
    f: l2_next_active(field)
    i: 0
    while: i < n
        if: f = 0 || f\value = 0
            return: l2_error(path, at, "unsupported body")
        # Whether the field just before this one was a name bound to a number (below).
        nprev: num_prev
        num_prev: 0
        array_status: l2_array_span(f, n - i, mi, @ array_place)
        if: array_status = 3
            return: 1
        if: array_status = 2
            return: l2_error(path, f\value, "the Array element has no supported value contract")
        if: array_status = 0
            array_status: l2_check_fields((array_place.index.first), (array_place.index.count), mi, path, at)
            if: array_status = 0
                array_status: l2_check_receiving_value(at, (array_place.index.first), (array_place.index.count), 2, -1, 0, mi, path)
            l2_array_place_release(@ array_place)
            if: array_status != 0
                return: 1
            have_value: 1
            i: i + array_place.count
            f: l2_skip_span(f, (array_place.count))
            continue
        array_status: l2_indexed_operand(f, n - i, mi, indexed)
        if: array_status = 3
            return: l2_error(path, f\value, "mixed numeric types (a conversion)")
        if: array_status = 2
            return: l2_error(path, f\value, "own array index requires a supported integer expression")
        if: array_status = 0
            if: indexed\index != 0 && l2_check_expr(indexed\index, mi, path) != 0
                return: 1
            if: indexed\address != 0 && n - i > indexed\count && l2_ptr_arith_ty(f, n - i, mi, @ pty) = 0 && l2_ptr_land_ty(at, mi, @ tty) = 0
                if: l2_colon_types_compatible(tty, pty) = 0
                    return: l2_error(path, f\value, "assignment value has incompatible type")
                ---
            have_value: 1
            i: i + indexed\count
            f: indexed\after
            continue
        # An indexed field path (S3 part 2b): an element of a declared Array field.
        ast: l2_arr_operand(f, 0, apd, room, @ apn, @ acnt, @ aafter, @ akind, @ aelem, @ adepth, @ ai0, @ ai1)
        if: ast = 2
            return: l2_error(path, f\value, "an indexed field path needs decimal literal indices, within a fixed Array's count, into a declared Array field")
        if: ast = 3
            return: l2_error(path, f\value, "an indexed field path needs a root of a declared Structure type")
        if: ast = 0 && ((akind = 5 && adepth != 1) || (akind = 6 && adepth != 2))
            return: l2_error(path, f\value, "an inner Array is a value only inside length()")
        if: ast = 0
            have_value: 1
            i: i + acnt
            f: aafter
            continue
        prun: l2_operand_run(f, n - i)
        pcall: l2_path_run_callee(f, prun, mi, @ ptext)
        if: pcall >= 0
            pword.data: ptext
            pword.length: strlen(ptext)
            if: l2_m_ret[pcall] != 8
                pcall: l2_check_value_call_at(f\value, @ pword, pcall, 0 - 1, mi, path)
            else:
                pcall: 0
            ---
            l2_xfree((cast: (@: void) ptext))
            if: pcall != 0
                return: 1
            have_value: 1
            i: i + prun
            f: l2_skip_span(f, prun)
            continue
        skip: 0
        p1: 0
        p2: 0
        if: f\value\kind = c.LM_P0_NODE_ATOM
            p1: l2_next_active(f\next)
        if: p1 != 0 && p1\value != 0 && p1\value\kind = c.LM_P0_NODE_ATOM && l2_is_slash(p1\value\as\atom)
            p2: l2_next_active(p1\next)
        # A field path off an own field, a namespace-typed name, or node/for
        # (FABLE-SONNET-NODE-ROOT-20260923-121: node/for are ordinary roots
        # of the same dispatcher now, not a separate own-table check tried
        # first -- FABLE-SONNET-FIELD-PATHS-20260923-113 for the general
        # mechanism itself, which l2_field_path_check's own gate now also
        # admits them into).
        # D-112/D-113: a path deeper than one field (`m\in\x`, five atoms) is one value -- the general
        # path walk reads it to its leaf, as it does for `v: m\in\x`.  Its first hop alone is a
        # Structure field, which the single-hop check below would take for a name it cannot resolve.
        chain: l2_path_chain(f, chbuf, room, @ chn)
        if: chain > 0
            cck: l2_path_chain_check(mi, f\value\as\atom, chbuf, chn, @ fpk)
            if: cck = 1
                return: l2_error(path, f\value, "a field path must end at a primitive field")
            if: cck = 2 && l2_wait_name(mi, f\value\as\atom) = 0 && l2_free_path_refused(mi, l2_param_find(mi, f\value\as\atom), path, f\value) != 0
                return: 1
            if: cck = 2
                return: l2_error(path, f\value, "unknown field path segment")
            if: cck = 0
                have_value: 1
                i: i + chain
                ck: 0
                while: ck < chain && f != 0
                    f: l2_next_active(f\next)
                    ck: ck + 1
                ---
                continue
            ---
        ---
        fpc: 0 - 1
        if: p2 != 0 && p2\value != 0 && p2\value\kind = c.LM_P0_NODE_ATOM
            fpc: l2_field_path_check(mi, f\value\as\atom, p2\value\as\atom, @ fpk)
        if: fpc = 1
            return: l2_error(path, p2\value, "unresolved name")
        if: fpc = 0
            have_value: 1
            i: i + 3
            f: l2_next_active(p2\next)
            continue
        # A bound merge result as a path root with an occurrence index, `merged\[N]x`
        # (FABLE-OPUS-MERGE-ADDRESSING-20260924-154): occurrence N of field x in operand
        # order.  The unqualified `merged\x` (the last occurrence) is an ordinary path.
        if: f\value\kind = c.LM_P0_NODE_ATOM && l2_ident(f\value\as\atom) != 0 && l2_mres_find(mi, f\value\as\atom) >= 0 && p1 != 0 && p1\value != 0 && p1\value\kind = c.LM_P0_NODE_ATOM && l2_is_slash(p1\value\as\atom) && p2 != 0 && p2\value != 0 && p2\value\kind = c.LM_P0_NODE_ATOM && l2_text_eq(p2\value\as\atom, "[") != 0
            p3: l2_next_active(p2\next)
            p4: 0
            p5: 0
            if: p3 != 0
                p4: l2_next_active(p3\next)
            if: p4 != 0
                p5: l2_next_active(p4\next)
            if: p3 = 0 || p3\value = 0 || p3\value\kind != c.LM_P0_NODE_ATOM || l2_num(p3\value\as\atom) = 0 || p4 = 0 || p4\value = 0 || p4\value\kind != c.LM_P0_NODE_ATOM || l2_text_eq(p4\value\as\atom, "]") = 0 || p5 = 0 || p5\value = 0 || p5\value\kind != c.LM_P0_NODE_ATOM || l2_ident(p5\value\as\atom) = 0
                return: l2_error(path, p2\value, "unsupported index")
            if: l2_mrs_slot_nth(l2_mres_find(mi, f\value\as\atom), p5\value\as\atom, (cast: (int) l2_literal_value(p3\value\as\atom)), @ fpk, @ po) < 0
                return: l2_error(path, p5\value, "merge occurrence index out of range")
            if: l2_kind_cell_ty(fpk) < 0
                return: l2_error(path, p5\value, "a field path must end at a primitive field")
            have_value: 1
            i: i + 6
            f: l2_next_active(p5\next)
            continue
        # A method name as a path root denotes its occurrence (l2_path_root's
        # own method-occurrence branch, FABLE-SONNET-NODE-ROOT-20260923-121)
        # -- but l2_join_path's strict name\name\... alternation cannot carry
        # a bracket segment, so a root-qualified occurrence index is
        # recognized here at the flat-token level instead of inside
        # l2_path_root, reusing the two primitives every other occurrence
        # form already uses: l2_find_method (the root) and l2_own_find_occ
        # (the same lookup l2_occ_head's rootless `\[N]name` already calls).
        # `test\[N]name` picks occurrence N; unqualified `test\arg` is the
        # LAST occurrence (FABLE-SONNET-LAST-OCCURRENCE-20260924-164, author's
        # rule Q22.2 -- this replaces the -146 "occurrence 0" reading).
        if: f\value\kind = c.LM_P0_NODE_ATOM && l2_ident(f\value\as\atom) != 0 && l2_find_method(f\value\as\atom) >= 0 && p1 != 0 && p1\value != 0 && p1\value\kind = c.LM_P0_NODE_ATOM && l2_is_slash(p1\value\as\atom) && p2 != 0 && p2\value != 0 && p2\value\kind = c.LM_P0_NODE_ATOM && l2_text_eq(p2\value\as\atom, "[") != 0
            p3: l2_next_active(p2\next)
            p4: 0
            p5: 0
            if: p3 != 0
                p4: l2_next_active(p3\next)
            if: p4 != 0
                p5: l2_next_active(p4\next)
            if: p3 = 0 || p3\value = 0 || p3\value\kind != c.LM_P0_NODE_ATOM || l2_num(p3\value\as\atom) = 0 || p4 = 0 || p4\value = 0 || p4\value\kind != c.LM_P0_NODE_ATOM || l2_text_eq(p4\value\as\atom, "]") = 0 || p5 = 0 || p5\value = 0 || p5\value\kind != c.LM_P0_NODE_ATOM || l2_ident(p5\value\as\atom) = 0
                return: l2_error(path, p2\value, "unsupported index")
            po: l2_own_find_occ(l2_find_method(f\value\as\atom), p5\value\as\atom, (cast: (int) l2_literal_value(p3\value\as\atom)))
            if: po < 0 || l2_m_uses[l2_own_off(l2_find_method(f\value\as\atom), po)] = 0
                return: l2_error(path, p5\value, "no such occurrence")
            have_value: 1
            i: i + 6
            f: l2_next_active(p5\next)
            continue
        if: f\value\kind = c.LM_P0_NODE_ATOM && l2_ident(f\value\as\atom) != 0 && l2_find_method(f\value\as\atom) >= 0 && p1 != 0 && p1\value != 0 && p1\value\kind = c.LM_P0_NODE_ATOM && l2_is_slash(p1\value\as\atom) && p2 != 0 && p2\value != 0 && p2\value\kind = c.LM_P0_NODE_ATOM && l2_ident(p2\value\as\atom) != 0
            po: l2_own_find_last(l2_find_method(f\value\as\atom), p2\value\as\atom)
            if: po < 0 || l2_m_uses[l2_own_off(l2_find_method(f\value\as\atom), po)] = 0
                return: l2_error(path, p2\value, "unresolved name")
            have_value: 1
            i: i + 3
            f: l2_next_active(p2\next)
            continue
        if: p2 != 0 && p2\value != 0 && p2\value\kind = c.LM_P0_NODE_ATOM && f\value\as\atom\length + p2\value\as\atom\length + 1U < room
            memcpy(cpbuf, f\value\as\atom\data, f\value\as\atom\length)
            cpbuf[f\value\as\atom\length]: 92
            memcpy(cpbuf + f\value\as\atom\length + 1U, p2\value\as\atom\data, p2\value\as\atom\length)
            cpn: f\value\as\atom\length + p2\value\as\atom\length + 1U
            cpraw: l2_raw_path(cpbuf, cpn, mi, @ cpraw_j)
            if: cpraw = 0
                have_value: 1
                i: i + 3
                f: l2_next_active(p2\next)
                continue
            ---
        ---
        # D-97: a path off a formal, a slot or a method local that neither the L2 path dispatcher
        # (l2_field_path_check) nor the c.* door (l2_raw_path) opened is refused, located.  The
        # expression pass would copy `\` and the member name verbatim: `p\length` of `@: size_t p`
        # became `l2_p0_0\length`, and only gcc caught it.
        if: p2 != 0 && p2\value != 0 && p2\value\kind = c.LM_P0_NODE_ATOM && f\value\kind = c.LM_P0_NODE_ATOM && (l2_formal_find(mi, f\value\as\atom) >= 0 || l2_slot_find(mi, f\value\as\atom) >= 0 || l2_ml_find(f\value\as\atom) >= 0)
            return: l2_error(path, f\value, "unknown field path root")
        # A path through a free name that nothing in the method's sight declares, where no coordinate space is
        # established for the method's paths: refused where the path stands (l2_free_path_refused).
        if: p1 != 0 && p1\value != 0 && p1\value\kind = c.LM_P0_NODE_ATOM && l2_is_slash(p1\value\as\atom) && p2 != 0 && p2\value != 0 && p2\value\kind = c.LM_P0_NODE_ATOM && f\value\kind = c.LM_P0_NODE_ATOM && l2_ident(f\value\as\atom) != 0 && l2_wait_name(mi, f\value\as\atom) = 0 && l2_free_path_refused(mi, l2_param_find(mi, f\value\as\atom), path, f\value) != 0
            return: 1
        if: l2_addr_tail(f, @ p1, @ p2) = 0
            i: i + 2
            f: p2
            continue
        # An index after a number (`r[0]`, r an int): only an Array field is indexed, and its element is taken above; the
        # bracket was skipped here and C got an int indexed.
        if: nprev != 0 && f\value\kind = c.LM_P0_NODE_ATOM && l2_text_eq(f\value\as\atom, "[") != 0
            return: l2_error(path, f\value, "an index on a number: only an Array field is indexed")
        if: f\value\kind = c.LM_P0_NODE_ATOM && (l2_is_binop(f\value\as\atom) || l2_is_brack(f\value\as\atom) || l2_is_slash(f\value\as\atom) || l2_num(f\value\as\atom))
            skip: 1
        # An address prefix in flat-field position. What it addresses is checked
        # by the fields that follow it, like any other name or field read.
        if: f\value\kind = c.LM_P0_NODE_ATOM && l2_text_eq(f\value\as\atom, "@") && l2_addr_flat_eternal(f) != 0
            return: l2_error(path, f\value, "the address of an eternal branch field cannot be taken")
        if: f\value\kind = c.LM_P0_NODE_ATOM && l2_text_eq(f\value\as\atom, "@")
            skip: 1
            have_value: 0
        if: f\value\kind = c.LM_P0_NODE_ATOM && l2_is_binop(f\value\as\atom)
            have_value: 0
        if: f\value\kind = c.LM_P0_NODE_ATOM && l2_is_slash(f\value\as\atom)
            if: have_value != 0
                after: 1
            else:
                after: 0
            ---
        if: after != 0 && f\value\kind = c.LM_P0_NODE_ATOM && l2_is_slash(f\value\as\atom) = 0 && l2_ident(f\value\as\atom)
            skip: 1
            after: 0
            have_value: 1
        if: skip = 0 && l2_check_primary(f\value, mi, path) != 0
            return: 1
        if: skip = 0 && l2_frame_void_call(f\value, mi) != 0
            return: l2_error(path, f\value, "a callable without a result has no value")
        if: skip = 0
            have_value: 1
        # A name bound to a number -- int, char, size_t, unsigned, ulong; not a pointer, an Array, a Structure.
        if: skip = 0 && f\value\kind = c.LM_P0_NODE_ATOM && l2_ident(f\value\as\atom) != 0 && l2_colon_bound_ty(mi, f\value\as\atom, @ nty) = 0 && nty != 8 && l2_prim_code_name(nty) != 0
            num_prev: 1
        i: i + 1
        f: l2_next_active(f\next)
return: 0

# The formal code of a number path kind (l2_path_kind: 0 size_t, 1 char, 7 int, 8 unsigned, 9 ulong), or -1.
fn: l2_path_kind_ft (int: kind) int
    if: kind = 0
        return: 2
    if: kind = 1
        return: 1
    if: kind = 7
        return: 0
    if: kind = 8
        return: 34
    if: kind = 9
        return: 36
return: 0 - 1

# A WRITE THROUGH A PATH TO A NUMBER FIELD (OPUS-PATHWRITE-20260929-09): `b\v: value`, `M\x: value` -- the one value's
# kind, as any number place's (l2_check_value_convert_core): a text, a Structure (a reference), a callable without a
# result is refused at the value.  An operation is the field check's (l2_check_value_kinds).  A number of another type is
# not this check's: the path store makes no conversion edge (recorded, steps/working-state-7b.md §10).
fn: l2_check_path_write (const: @(LmP0Node stmt); int: mi; const: @(char path)) int
    int: kind
    int: chain_kind
    LmP0Text: root
    size_t: root_off
    size_t: root_len
    int: leaf_mi 0
    int: model 0 - 1
    int: vt 0
    int: to_ft
    int: n
    int: cok
    @: LmP0Field only
    const: @: LmP0Text h
    if: stmt = 0 || stmt\kind != c.LM_P0_NODE_FRAME || stmt\as = 0 || stmt\as\frame = 0 || stmt\as\frame\head = 0 || stmt\as\frame\body = 0
        return: 0
    h: stmt\as\frame\head
    n: l2_count_active(stmt\as\frame\body)
    if: h\data = 0 || h\length = 0U || l2_seg_count(h\data, h\length) < 2 || n < 1
        return: 0
    if: l2_head_is_call(stmt\as\frame\head, stmt\as\frame\body, stmt\as\frame\flags, mi) != 0
        return: 0
    # The root may be a free name the closure has not typed yet: the check waits for it, as an assignment's does
    # (l2_wait_run).  Typed, with no declaration in the method's sight and no coordinate space established, it
    # is refused as a read of such a path is (l2_free_path_refused).
    if: l2_seg_at(h\data, h\length, 0, @ root_off, @ root_len) = 0
        root.data: h\data + root_off
        root.length: root_len
        if: l2_wait_name(mi, @ root) != 0
            return: l2_wait_add(7, mi, (cast: (@: void) stmt), 0, 0, stmt, path)
        if: l2_free_path_refused(mi, l2_param_find(mi, @ root), path, stmt) != 0
            return: 1
    ---
    kind: l2_path_contract(h\data, h\length, @ leaf_mi, @ model)
    if: kind < 0 && l2_seg_at(h\data, h\length, 0, @ root_off, @ root_len) = 0
        root.data: h\data + root_off
        root.length: root_len
        if: l2_path_chain_check(mi, @ root, h\data, h\length, @ chain_kind) = 2
            return: l2_error(path, stmt, "unknown field path segment")
        ---
    if: kind = 10 || kind = 11
        return: l2_check_receiving_value(stmt, stmt\as\frame\body\first_field, n, leaf_mi, model, h, mi, path)
    to_ft: l2_path_kind_ft(kind)
    if: to_ft < 0
        return: 0
    if: n = 1
        only: l2_next_active(stmt\as\frame\body\first_field)
        if: only != 0 && only\value != 0 && only\value\kind = c.LM_P0_NODE_ATOM && only\value\as != 0 && l2_check_literal_kind(only\value\as\atom, l2_lit_kind_from_ft(to_ft), path, stmt) != 0
            return: 1
        # A number place: the bare name of a held callable is received as its result.
        if: l2_held_result_receive(mi, stmt\as\frame\body\first_field, n, (cast: (int) (l2_prim_code_name(to_ft) != 0)), path) != 0
            return: 1
        if: only = 0 || only\value = 0 || l2_colon_value_ty(only\value, mi, @ vt) != 0
            return: 0
        if: vt = 0 - 11
            return: l2_error(path, only\value, "a text where a number is asked")
        if: l2_colon_is_graph_ty(vt) != 0 && l2_cf_named(mi, only\value) = 0
            return: l2_error(path, only\value, "a reference where a number is asked")
        if: vt = 8
            return: l2_error(path, only\value, "a callable without a result has no value")
    ---
    if: n > 1
        vt: l2_native_composite_ty(stmt\as\frame\body\first_field, n, mi)
        if: vt = 0 - 3
            return: l2_error(path, stmt, "mixed numeric types (a conversion)")
    ---
    # A number of another type (OPUS-PATHCONV-20260929-10): the store's conversion edge, as an assignment's
    # (l2_colon_check_assignment) -- a converter is a receiver (Q33), the edge a call of it; a pair with no row is refused.
    if: vt < 0 || l2_prim_code_name(vt) = 0 || c.strcmp(l2_prim_code_name(vt), l2_prim_code_name(to_ft)) = 0
        return: 0
    cok: l2_colon_types_compatible(to_ft, vt)
    if: cok = 0 && l2_cv_gap = 3
        return: l2_cv_refused(path, stmt, "internal: a conversion refused without its reason")
    if: cok = 0 && l2_cv_gap = 5
        return: l2_error(path, stmt, "the program has no source table `primitive.convert`")
    if: cok = 0 && l2_cv_gap = 2
        return: l2_convert_norecv(path, stmt)
    if: cok = 0 && l2_cv_gap = 1
        return: l2_error(path, stmt, "mixed numeric types (a conversion)")
    if: cok = 0
        return: l2_error(path, stmt, "assignment value has incompatible type")
    if: l2_cv_used != 0 && l2_convert_edge(mi, path, stmt) != 0
        return: 1
return: 0

# THE KIND OF A VALUE IN AN OPERATION (the walk's rule -179, natively; OPUS-VALKIND-20260929-08): an operation of n >= 3
# fields typed by the native expression typer with its leaf kinds -- a text in a comparison or arithmetic, a Structure
# (a reference) in arithmetic, or compared with anything but the literal 0 or another reference, is refused at the
# operand, in the walk's words.  It went out as C converting a pointer into a number.
fn: l2_check_value_kinds (@: LmP0Field field; int: n; int: mi; const: @(char path); const: @(LmP0Node at)) int
    @: L2ValueSpan tok
    @: LmP0Node first_node
    int: m
    int: ty
    @: LmP0Node where
    @: LmP0Field lead
    L2ValueSpan: rest
    # A prefix sign makes an operation of two fields: `- p` is checked as every
    # operation is.
    if: field = 0 || n < 2
        return: 0
    # The operands of an operation receive numbers: the bare name of a held callable among them
    # is received as its result.
    if: l2_held_result_receive(mi, field, n, 0, path) != 0
        return: 1
    lead: l2_next_active(field)
    if: n < 3 && (lead = 0 || lead\value = 0 || lead\value\kind != c.LM_P0_NODE_ATOM || lead\value\as = 0 || l2_prefix_sign(lead\value\as\atom) = 0)
        return: 0
    if: l2_ptr_arith_ty(field, n, mi, @ ty) = 0
        return: 0
    # steps/free-names.md M2: an operation reading a dynamic input the closure has not typed yet waits for its type
    # (kind 3, l2_wait_kinds), as a consumed value does -- a condition has no other check that would.
    if: l2_waits(field, n, mi) != 0
        return: l2_wait_add(3, mi, (cast: (@: void) field), n, 0, field\value, path)
    tok: l2_value_spans(field, n, @ m)
    if: tok = 0
        return: 0
    if: m < 3 && l2_prefix_rest(tok, @ rest) != 0
        l2_xfree((cast: (@: void) tok))
        return: 0
    l2_kind_at: 0
    first_node: l2_span_node(tok, 0)
    ty: l2_native_expr_ty(tok, 0, m - 1, mi)
    l2_xfree((cast: (@: void) tok))
    where: l2_kind_at
    if: where = 0
        where: (cast: (@: LmP0Node) at)
    if: ty = 0 - 15
        return: l2_error(path, where, "a reference where a number is asked")
    if: ty = 0 - 16
        return: l2_error(path, where, "a text where a number is asked")
    if: ty = 0 - 17
        return: l2_error(path, where, "a reference compared with a number other than 0")
    # Class A: two numeric types in one operation are a conversion (-175), refused at the operation's first operand, as
    # a consumed value is (l2_check_value_convert_field) -- a condition's operation too, which nothing else checks.
    if: ty = 0 - 3
        return: l2_error(path, first_node, "mixed numeric types (a conversion)")
return: 0

# A bare callable uses the same source-site selector as a call head. A visible
# own/local binding wins, otherwise a formal's actual contract precedes the
# unit method. -1 excludes only this method/formal category of callable.
fn: l2_atom_callee (const: @(LmP0Text t); int: mi; @: int fi) int
return: l2_call_head_method(mi, t, fi)

# Does a bare atom denote a Structure: a formal, dynamic input, own field, slot or local whose type
# is a graph, or else a declared named Structure?
fn: l2_bare_structure (const: @(LmP0Text t); int: mi) int
    int: ty 0
    if: l2_colon_bound_ty(mi, t, @ ty) = 0
        return: l2_colon_is_graph_ty(ty)
return: l2_ns_find(t) >= 0

# steps/named-struct-exec.md, slices 2 and 3: the named Structure a bare atom executes -- its own
# name, not a field or a local bound to a Structure (l2_colon_bound_ty) -- or -1.  Only a unit-level
# one that is no qualified branch: its node is a unit child (l2_ns_rank).  In the root, and in a
# unit-level method, whose `node` is the unit (l2_unit_ref); a callable merge's nested method runs
# only walked, as its host's constructor (l2_mad_host_of), and stays refused.
fn: l2_ns_exec_named (const: @(LmP0Text t); int: mi) int
    int: ty 0
    int: ni
    if: t = 0 || l2_e < 0 || mi < 0 || l2_library_mode != 0
        return: 0 - 1
    if: mi != l2_e && l2_mad_host_of(mi) >= 0
        return: 0 - 1
    if: l2_colon_bound_ty(mi, t, @ ty) = 0
        return: 0 - 1
    ni: l2_ns_find(t)
    if: ni < 0 || l2_ns_parent[ni] >= 0 || l2_ns_eternal[ni] >= 0
        return: 0 - 1
return: ni

# steps/named-struct-exec.md §10-11, slice 4: the root's own field a bare atom executes -- a slot
# field of the unit declared `Model: v` (l2_own_is_slot) with Model an ordinary unit-level named
# Structure -- or -1.  Its value is a merge copy of Model, laid out as Model: every other way into
# such a field is refused today (another type, a call's result, a method's write -- §11).  A Structure
# formal and a reference field `@: Model r` are not ones: each can take a value admitted by names
# whose fields may be permuted (D-105), and Model's steps address slots.
fn: l2_ns_exec_field (const: @(LmP0Text t); int: mi) int
    int: oi
    int: ni
    if: t = 0 || l2_e < 0 || mi != l2_e || l2_library_mode != 0
        return: 0 - 1
    oi: l2_own_find_last(l2_e, t)
    # Not its unit child: the check pass runs before the layout (l2_layout_owns); the walk asks.
    if: oi < 0 || l2_own_mi[oi] != l2_e || l2_own_host[oi] != 0 || l2_own_fid[oi] >= 0 || l2_own_is_slot(oi) = 0
        return: 0 - 1
    ni: l2_own_call_origin(oi)
    if: ni < 0 || ni >= l2_ns_n || l2_ns_parent[ni] >= 0 || l2_ns_eternal[ni] >= 0
        return: 0 - 1
return: oi

# The named Structure a bare atom executes, by its own name (l2_ns_exec_named) or as the type of the
# root's field (l2_ns_exec_field), or -1.
fn: l2_ns_exec_any (const: @(LmP0Text t); int: mi) int
    int: oi
    if: l2_ns_exec_named(t, mi) >= 0
        return: l2_ns_exec_named(t, mi)
    oi: l2_ns_exec_field(t, mi)
    if: oi >= 0
        return: l2_own_call_origin(oi)
return: 0 - 1

# THE EXPRESSION STATEMENT (plan §3 "Expression statement и discard"; FABLE-OPUS-DISCARD-
# 20260924-147).  Any expression in statement position is evaluated and its value discarded: a
# bare atom, and a run of fields l2_expr_span groups into one expression -- P0 gives a statement
# line of several atoms (`2 + 2`, `g(m()) + 1`) as that many fields.  A bare atom resolves like
# any value, and the kind of its binding decides (FABLE-OPUS-RECEIVER-CONTRACT-20260924-139): a
# callable is called with no arguments -- the check of `m()`, l2_check_call -- a Structure is
# refused until executing one is settled (q20), any other value is evaluated and discarded,
# never called.  A run is an ordinary value expression (l2_check_fields).
fn: l2_check_discard (@: LmP0Field field; int: span; int: mi; const: @(char path)) int
    @: LmP0Node stmt
    int: idx
    int: fi 0
    int: prc
    @: char ptext 0
    LmP0Text: pword
    stmt: field\value
    # K03 S6: a path operand that selects a callable, written alone, is its nullary call (l2_path_run_callee), checked as
    # `Holder\tick()` is, its path the call's written head.
    if: span > 1
        idx: l2_path_run_callee(field, span, mi, @ ptext)
        if: idx >= 0
            pword.data: ptext
            pword.length: strlen(ptext)
            prc: l2_check_call_at(stmt, @ pword, idx, 0 - 1, 0, mi, path)
            l2_xfree((cast: (@: void) ptext))
            return: prc
        ---
    ---
    if: span != 1 || stmt\kind != c.LM_P0_NODE_ATOM
        return: l2_check_fields(field, span, mi, path, stmt)
    idx: l2_atom_callee(stmt\as\atom, mi, @ fi)
    if: idx >= 0
        return: l2_check_call(stmt, idx, fi, 0, mi, path)
    # A held callable named alone is its call with no actuals: the check of `p0()`.
    if: l2_call_head_held(mi, stmt\as\atom) >= 0
        return: l2_check_held_call(stmt, l2_call_head_held(mi, stmt\as\atom), mi, path)
    if: l2_check_primary(stmt, mi, path) != 0
        return: 1
    if: l2_bare_structure(stmt\as\atom, mi) != 0
        return: l2_check_struct_call(stmt, stmt\as\atom, mi, path)
return: 0

# The nullary call of the Structure bound to t -- by the bare atom t (l2_check_discard) or by `t()` on the existing
# binding (l2_empty_struct_assign_shape): one call (book §9 after 55c1abc: a callable, an ordinary named Structure
# included, is called, never assigned).  steps/named-struct-exec.md, slices 2 and 3: an ordinary named Structure's own
# name executes it -- at the root walked (l2_rw_ns_call), in a unit-level method natively (l2_emit_ns_exec) or walked
# under the knob -- and slice 4: so does the root's field declared `Model: v` (l2_rw_ns_var_call).  A Structure whose
# type is the empty Structure runs nothing (l2_struct_call_inert).  Any other Structure's call -- a Structure-typed
# field or local of a method, a nested or qualified Structure, a nested method's bare Structure, a value whose type is
# not declared -- is not built yet: refused where it stands.
# The first source place that calls merge result row `own`, kept for
# l2_copy_calls_verify.
fn: l2_copy_call_note (int: own; const: @(LmP0Node node); int: mi) int
    int: result l2_mres_of_own(own)
    if: result < 0 || l2_mres_called = 0 || l2_mres_called[result] != 0
        return: 0
    l2_mres_called[result]: (cast: (@: LmP0Node) node)
    l2_mres_called_mi[result]: mi
return: 0

fn: l2_own_addr_note (int: own) int
    @: int grown
    int: i 0
    while: i < l2_addr_own_n
        if: l2_addr_own[i] = own
            return: 0
        i: i + 1
    ---
    grown: (cast: (@: int) realloc((cast: (@: void) l2_addr_own), (cast: (size_t) (l2_addr_own_n + 1)) * c.sizeof(c.int)))
    if: grown = 0
        return: 1
    l2_addr_own: grown
    l2_addr_own[l2_addr_own_n]: own
    l2_addr_own_n: l2_addr_own_n + 1
return: 0

# Whether a row of the chain merge result `i` copies through is addressed: the
# row itself, every copied row before it, the definition row the chain ends at.
fn: l2_copy_chain_addressed (int: i) int
    int: hops 0
    int: from
    int: k
    while: i >= 0 && i < l2_mres_n && hops <= l2_mres_n
        if: l2_mres_addressed[i] != 0
            return: 1
        if: l2_mres_from = 0
            return: 0
        from: l2_mres_from[i]
        if: from < 0
            return: 0
        i: l2_mres_of_own(from)
        if: i < 0
            k: 0
            while: k < l2_addr_own_n
                if: l2_addr_own[k] = from
                    return: 1
                k: k + 1
            ---
        ---
        hops: hops + 1
    ---
return: 0

# Run once every body has been checked. A called merge copy has no proof of
# its current value when its own row, or a row it was copied from, is
# addressed: the address reaches the reference cell. The valid program is
# refused at its call, as an implementation limit, not as an admission failure.
fn: l2_copy_calls_verify (const: @(char path)) int
    int: i 0
    while: i < l2_mres_n
        if: l2_mres_called != 0 && l2_mres_called[i] != 0 && l2_copy_chain_addressed(i) != 0
            return: l2_error(l2_method_src(l2_mres_called_mi[i], path), l2_mres_called[i], "the called Structure's reference cell is addressed: calling its current value is not supported yet")
        i: i + 1
return: 0

fn: l2_check_struct_call (const: @(LmP0Node node); const: @(LmP0Text t); int: mi; const: @(char path)) int
    int: idx
    int: origin
    l2_copy_call_note(l2_resolved_own(mi, t), node, mi)
    idx: l2_ns_exec_any(t, mi)
    if: idx >= 0 && l2_ns_proc[idx] < 0
        return: l2_error(path, node, "internal: a named Structure executed without its procedure")
    if: idx >= 0
        l2_ns_exec[idx]: 1
        # §12: executing S calls its procedure -- an edge as any call's.
        l2_m_edge[l2_edge_off(mi, l2_ns_proc[idx])]: l2_m_edge[l2_edge_off(mi, l2_ns_proc[idx])] | 1
        return: l2_note_call(mi, l2_ns_proc[idx], node, path)
    # Slice 2c: a method's own named Structure the method executes -- its procedure, over the Structure at S's place.
    idx: l2_local_ns_callee(t, mi)
    if: idx >= 0
        origin: l2_own_call_origin(idx)
        l2_ns_exec[origin]: 1
        l2_m_edge[l2_edge_off(mi, l2_ns_proc[origin])]: l2_m_edge[l2_edge_off(mi, l2_ns_proc[origin])] | 1
        return: l2_note_call(mi, l2_ns_proc[origin], node, path)
    if: l2_struct_call_inert(t, mi) != 0
        return: 0
    # Slice 4 (§11): a Structure formal's value may be admitted by names with its fields permuted (D-105) -- Model's
    # steps would write the wrong ones.  A reference field keeps the refusal below for the same reason.
    if: mi >= 0 && l2_formal_find(mi, t) >= 0 && l2_nsty_get(mi, l2_formal_find(mi, t)) >= 0
        return: l2_error(path, node, "executing a Structure formal is not supported yet")
return: l2_error(path, node, "executing a named Structure is not supported yet")

# How many fields a statement that is an expression run takes: 0 when the field starts no run
# (a single Frame is a statement of its own kind; a single Structure is a nested body), else the
# l2_expr_span of the run -- one bare atom, or several fields read as one expression.
fn: l2_discard_run (@: LmP0Field field) int
    @: LmP0Node e
    int: n
    if: field = 0 || field\value = 0
        return: 0
    e: field\value
    n: l2_expr_span(field)
    if: e\kind = c.LM_P0_NODE_ATOM
        if: l2_text_eq(e\as\atom, "break") || l2_text_eq(e\as\atom, "continue") || l2_text_eq(e\as\atom, "return")
            return: 0
        return: n
    if: n > 1
        return: n
return: 0

# K03 (the author, 2026-10-06; docs/LMX_semantics.en.md#resolved-head-consumption): a statement applying word w of the
# language (l2_stmt_word_head) -- the bare word or its Frame -- meets the word's statement contract here, one consumer
# for every spelling: no written argument is the bare word's case and `w()`'s alike (l2_app_actuals), said at the word.
# A word whose written arguments the branches below read -- a condition, a declaration, a letter, a return value -- goes
# on to them (2).  0 checked, 1 refused (said).
fn: l2_check_word_stmt (const: @(LmP0Node stmt); const: @(LmP0Text w); const: @(LmP0Structure body); int: mi; const: @(char path); int: depth) int
    int: na l2_count_active(l2_app_actuals(stmt))
    int: msk 0
    int: msni 0
    @: LmP0Field first 0
    @: LmP0Text rnm 0
    if: l2_text_eq(w, "break") || l2_text_eq(w, "continue")
        if: na != 0
            return: l2_error_name(path, stmt, "", w\data, w\length, " takes no argument")
        if: l2_loop_depth = 0
            return: l2_error(path, stmt, "unsupported loop")
        return: 0
    # A trailer word closes the frame it follows. After a frame that is already closed P0 leaves it an ordinary item;
    # it is still not a statement, in the entry or in any body.
    if: l2_text_eq(w, "end") || l2_text_eq(w, "until")
        return: l2_error(path, stmt, "stray trailer: the frame above is already closed")
    # A `table:` with no `source` first builds a table when the program runs (REVIEW 7dad13b, answer 1): that receiver's
    # run-time body is not built yet (§8).
    if: l2_text_eq(w, "table")
        return: l2_error(path, stmt, "a table built at run time is not supported yet")
    # S1.3: a catch and its handler (l2_check_catch); S1.2: a throw (l2_check_throw).
    if: l2_text_eq(w, "catch")
        return: l2_check_catch(stmt, body, path, mi, depth)
    if: l2_text_eq(w, "throw")
        return: l2_check_throw(stmt, mi, path)
    # S1.2 (author Q13): `throws:` is the first item of a method head -- l2_collect_method took the list from there --
    # and nowhere else; with no name it lists nothing, as l2_check_throws_list says of `throws: ()`.
    if: l2_text_eq(w, "throws")
        if: na != 0 && l2_throws_frame(mi) = stmt
            return: 0
        if: mi >= 0 && mi < l2_m_n && l2_m_node[mi] != 0 && l2_m_body[mi] != 0 && l2_m_body[mi]\kind = c.LM_P0_NODE_STRUCTURE && l2_m_body[mi]\as != 0 && l2_m_body[mi]\as\structure != 0
            first: l2_next_active(l2_m_body[mi]\as\structure\first_field)
        if: na = 0 && first != 0 && first\value = stmt
            return: l2_error(path, stmt, "throws: lists the names that may leave the method")
        return: l2_error(path, stmt, "throws: must be the first item of a method head")
    # Receivers the translator does not build at all (`test`: K12-TEST; `post`: §28; `external`: L2 §18).
    if: l2_text_eq(w, "fm") || l2_text_eq(w, "synchronized") || l2_text_eq(w, "test") || l2_text_eq(w, "post") || l2_text_eq(w, "external")
        return: l2_error_name(path, stmt, "", w\data, w\length, " is not supported yet")
    # A unit instruction (l2_unit_word) stands at the unit's root, where l2_unit_role takes it; here it is no statement.
    if: l2_unit_word(w) != 0
        return: l2_error_name(path, stmt, "", w\data, w\length, " is a unit instruction: it stands at the root of the unit")
    # The operators whose application is a value: with operands, a statement receives none (a located limit); with
    # none, the operator's own refusal.
    if: l2_text_eq(w, "merge") || l2_text_eq(w, "length") || l2_text_eq(w, "cast") || l2_text_eq(w, "sizeof")
        if: na != 0
            return: l2_error_name(path, stmt, "", w\data, w\length, " expression is not lowered in this receiving context")
        if: l2_text_eq(w, "merge")
            return: l2_error(path, stmt, "merge needs at least one operand")
        if: l2_text_eq(w, "length")
            return: l2_error(path, stmt, "length requires one known primitive own array")
        if: l2_text_eq(w, "cast")
            return: l2_error(path, stmt, "unsupported cast")
        return: l2_error(path, stmt, "sizeof: requires one operand")
    if: na != 0
        return: 2
    # No written argument.  A bare `return` ends the walked root (mi = E): its value is its last evaluated expression
    # (plan §3); a method with a result returns a value.
    if: l2_text_eq(w, "return")
        if: mi != l2_e && l2_m_ret[mi] != 8
            return: l2_error(path, stmt, "unsupported body")
        return: 0
    if: l2_text_eq(w, "sendMessage")
        return: l2_msend_register(stmt, path, mi, @ msk, @ msni)
    if: l2_text_eq(w, "receiveMessage") && l2_receive_msg_shape(stmt, @ rnm, 0) = 2
        return: l2_error(path, stmt, "receiveMessage binds one or two names")
    if: l2_text_eq(w, "for")
        return: l2_error(path, stmt, "unsupported loop")
return: l2_error(path, stmt, "unsupported body")

fn: l2_check_body (const: @(LmP0Structure body); int: mi; const: @(char path); int: depth) int
    L2Address: receiver_place
    @: L2Declaration declaration
    LmP0Text: indirect_base
    LmP0Text: indirect_word
    int: indirect_levels
    int: indirect_type
    int: indirect_source
    int: indirect_depth
    int: indirect_const
    int: msk
    int: msni
    int: array_target
    int: array_status
    size_t: array_index
    L2ArrayPlace: array_place
    @: LmP0Field field
    @: LmP0Field nxt
    @: LmP0Node stmt
    const: @: LmP0Frame fr
    @: LmP0Field last
    int: n
    int: k
    int: rj 0
    int: raw 1
    int: ix 1
    int: pd 1
    []: char pdest_own 1024
    L2Tx: pdest_tx
    @: L2Tx pdest l2_tx_local(@ pdest_tx, pdest_own, 1024U)
    int: lty 0
    @: LmP0Text lnm 0
    int: cj
    int: letni
    @: LmP0Text cmodel
    @: LmP0Text cname
    @: LmP0Field send_field
    @: LmP0Field send_message
    @: LmP0Field send_part
    @: LmP0Node send_node
    int: send_count
    int: send_i
    @: LmP0Structure call_body 0
    int: call_result
    int: retained
    @: LmP0Text sw 0
    @: LmP0Node mg 0
    if: body = 0
        return: l2_error(path, 0, "unsupported body")
    field: l2_next_active(body\first_field)
    # An empty body -- `()`, an empty Structure's (steps/named-struct-exec.md §12) -- is a valid present
    # empty Structure (book §10): nothing to check.  It was refused here with no place (1:1).
    if: field = 0
        return: 0
    while: field != 0
        stmt: field\value
        l2_vis_stmt(mi, stmt)
        l2_q_at: stmt
        l2_here_at(stmt)
        l2_q_path: path
        retained: l2_ns_constructed_row(mi, stmt)
        if: retained = -2
            return: 1
        if: retained >= 0
            field: l2_next_active(field\next)
            continue
        if: l2_pap_on(mi) != 0 && l2_frame_head(stmt, "merge") != 0
            field: l2_next_active(field\next)
            continue
        if: l2_mad_on(mi) != 0 && l2_frame_head(stmt, "fn") != 0
            field: l2_next_active(field\next)
            continue
        # D-93: the host's `return: model` standing as a statement of its body (after other
        # statements, so not hung on the model's frame) is its build (l2_mad_host_body), not a call
        # of the model -- checked as a call, it was refused ("incompatible entry signature").
        if: l2_mad_on(mi) != 0 && l2_mad_is_return(stmt, l2_mad_model[mi]) != 0
            field: l2_next_active(field\next)
            continue
        # A method that returns a merge may do something first: that return is its build too, a statement of
        # its body.  The merge was checked where the method was recorded with it (l2_t7_fill).
        if: l2_t7_return_stmt(mi, stmt) != 0
            field: l2_next_active(field\next)
            continue
        if: l2_mad_declaring(stmt, mi) != 0
            if: l2_check_call(l2_receiver_call(stmt, 0), l2_store_host(stmt), 0 - 1, l2_receiver_call(stmt, 0)\as\frame\body, mi, path) != 0
                return: 1
            field: l2_next_active(field\next)
            continue
        ---
        # K03 S5: merge's construction (l2_merge_construction) with no operand -- `x: merge` as `x: merge()` -- is
        # refused by merge's contract at the merge, whatever the outer name is; with operands it is the merge
        # declaration below, its operands checked at emission.
        if: stmt != 0 && stmt\kind = c.LM_P0_NODE_FRAME && stmt\as != 0 && stmt\as\frame != 0 && l2_stmt_word_head(stmt, mi) = 0 && l2_merge_construction(stmt\as\frame) != 0
            mg: l2_next_active(stmt\as\frame\body\first_field)\value
            if: l2_count_active(l2_app_actuals(mg)) = 0
                return: l2_error(path, mg, "merge needs at least one operand")
            ---
        # K03 (the author, 2026-10-06): a statement whose head -- an atom's or a Frame's -- resolves to a word of the
        # language is that word's application: `break` and `break()`, `merge` and `merge()` are one application each,
        # their written arguments the Frame's body or none (l2_app_actuals); the word's contract decides, at the word
        # (l2_check_word_stmt).  A word whose arguments a branch below reads goes on to it.
        sw: l2_stmt_word_head(stmt, mi)
        if: sw != 0
            k: l2_check_word_stmt(stmt, sw, body, mi, path, depth)
            if: k = 1
                return: 1
            if: k = 0
                field: l2_next_active(field\next)
                continue
            ---
        # An expression statement (l2_check_discard); the walker moves past its whole run.
        n: l2_discard_run(field)
        if: n > 0
            if: l2_check_discard(field, n, mi, path) != 0
                return: 1
            field: l2_skip_span(field, n)
            continue
        # An anonymous `---` block is a nested executable body, like an if body (§14, Q14 K);
        # `()` is an empty one, with nothing to run.  One closed by `until` is a loop: its body may break and
        # continue, and its condition is checked in its scope (l2_block_until).
        if: stmt != 0 && stmt\kind = c.LM_P0_NODE_STRUCTURE && stmt\as != 0 && stmt\as\structure != 0 && l2_count_active(stmt\as\structure) = 0 && l2_block_until(stmt) = 0
            field: l2_next_active(field\next)
            continue
        if: stmt != 0 && stmt\kind = c.LM_P0_NODE_STRUCTURE && stmt\as != 0 && stmt\as\structure != 0
            if: l2_scope_push(stmt) != 0
                return: l2_alloc_or(path, stmt, "out of memory")
            if: l2_block_until(stmt) != 0
                l2_loop_depth: l2_loop_depth + 1
            if: l2_check_body(stmt\as\structure, mi, path, depth + 1) != 0
                if: l2_block_until(stmt) != 0
                    l2_loop_depth: l2_loop_depth - 1
                l2_scope_pop()
                return: 1
            if: l2_block_until(stmt) != 0
                l2_loop_depth: l2_loop_depth - 1
                if: l2_held_result_receive(mi, l2_block_until(stmt)\first_field, l2_count_active(l2_block_until(stmt)), 1, path) != 0
                    l2_scope_pop()
                    return: 1
                if: l2_check_fields(l2_block_until(stmt)\first_field, l2_count_active(l2_block_until(stmt)), mi, path, stmt) != 0
                    l2_scope_pop()
                    return: 1
                ---
            l2_scope_pop()
            field: l2_next_active(field\next)
            continue
        # 19.17 merge is an ordinary statement frame here. Its name operands are
        # checked at emission, where the qualified branch table is complete; a call
        # operand here, as any call in a value (K03 S7b, l2_check_merge_operands).
        if: l2_merge_declaration(body, stmt, mi) != 0
            if: l2_check_merge_operands(l2_merge_frame(stmt), mi, path) != 0
                return: 1
            field: l2_next_active(field\next)
            continue
        if: l2_frame_head(stmt, "[]") && (l2_own_array_count(stmt) = 0 || depth != l2_scope_n)
            return: l2_error(path, stmt, "unsupported own array declaration")
        if: stmt != 0 && stmt\kind = c.LM_P0_NODE_FRAME && stmt\as != 0 && stmt\as\frame != 0
            array_status: l2_array_place(stmt, mi, @ array_place)
            if: array_status = 3
                return: 1
            if: array_status = 2
                return: l2_error(path, stmt, "unsupported indexed Array operand contract")
            if: array_status = 0
                if: l2_check_array_place(stmt, mi, path, @ array_place) != 0
                    return: 1
                field: l2_next_active(field\next)
                continue
            ---
            array_status: l2_own_index_head(stmt\as\frame\head, mi, @ array_target, @ array_index)
            if: array_status = 2
                array_status: l2_dyn_own_index(mi, stmt\as\frame\head, @ array_target, @ rj)
                if: array_status = 2
                    return: l2_error(path, stmt, "mixed numeric types (a conversion)")
                if: array_status != 1
                    return: l2_error(path, stmt, "own array index requires a supported integer expression")
                array_status: 0
            if: array_status = 0
                fr: stmt\as\frame
                if: fr\body = 0 || fr\trailer != 0 || fr\body\trailer != 0
                    return: l2_error(path, stmt, "unsupported trailer")
                if: l2_check_fields(fr\body\first_field, l2_count_active(fr\body), mi, path, stmt) != 0
                    return: 1
                # A value of another number type has the store's conversion edge, as a write through a path has
                # (OPUS-PATHCONV-20260929-10): checked as a result or a formal is (l2_check_value_convert_field).
                if: l2_check_value_convert_field(fr\body\first_field, l2_count_active(fr\body), l2_ft_of_own(l2_rw_elem_ty(array_target)), mi, path) != 0
                    return: 1
                field: l2_next_active(field\next)
                continue
            array_target: l2_own_visible(mi, stmt\as\frame\head)
            if: array_target >= 0 && l2_own_is_array(l2_own_ty[array_target]) != 0
                return: l2_error(path, stmt, "own array use not yet supported")
        ---
        if: l2_frame_head(stmt, "if")
            fr: stmt\as\frame
            if: fr\body = 0
                return: l2_error(path, stmt, "unsupported body")
            if: fr\trailer != 0 && l2_end_named(fr, "if") = 0
                return: l2_error(path, stmt, "unsupported trailer")
            n: l2_count_active(fr\body)
            if: n < 2
                return: l2_error(path, stmt, "unsupported body")
            last: l2_next_active(fr\body\first_field)
            k: 1
            while: k < n
                last: l2_next_active(last\next)
                k: k + 1
            if: last = 0 || last\value = 0 || last\value\kind != c.LM_P0_NODE_STRUCTURE || last\value\as = 0
                return: l2_error(path, stmt, "unsupported body")
            # A condition receives a number: the bare name of a held callable is its result.
            if: l2_held_result_receive(mi, fr\body\first_field, n - 1, 1, path) != 0
                return: 1
            if: l2_check_fields(fr\body\first_field, n - 1, mi, path, stmt) != 0
                return: 1
            if: l2_scope_push(last\value) != 0
                return: l2_alloc_or(path, stmt, "out of memory")
            if: l2_check_body(last\value\as\structure, mi, path, depth + 1) != 0
                l2_scope_pop()
                return: 1
            l2_scope_pop()
            nxt: l2_next_active(field\next)
            if: nxt != 0 && l2_frame_head(nxt\value, "else") && nxt\value\as\frame\body = 0
                return: l2_error(path, nxt\value, "unsupported body")
            if: nxt != 0 && l2_frame_head(nxt\value, "else") && nxt\value\as\frame\trailer != 0 && l2_end_named(nxt\value\as\frame, "else") = 0
                return: l2_error(path, nxt\value, "unsupported trailer")
            if: nxt != 0 && l2_frame_head(nxt\value, "else")
                if: l2_scope_push(nxt\value) != 0
                    return: l2_alloc_or(path, nxt\value, "out of memory")
                if: l2_check_body(nxt\value\as\frame\body, mi, path, depth + 1) != 0
                    l2_scope_pop()
                    return: 1
                l2_scope_pop()
            if: nxt != 0 && l2_frame_head(nxt\value, "else")
                field: l2_next_active(nxt\next)
            if: nxt = 0 || l2_frame_head(nxt\value, "else") = 0
                field: nxt
            ---
        if: l2_frame_head(stmt, "while")
            fr: stmt\as\frame
            if: fr\body = 0
                return: l2_error(path, stmt, "unsupported body")
            if: fr\trailer != 0 && l2_end_named(fr, "while") = 0
                return: l2_error(path, stmt, "unsupported trailer")
            n: l2_count_active(fr\body)
            if: n < 2
                return: l2_error(path, stmt, "unsupported body")
            last: l2_next_active(fr\body\first_field)
            k: 1
            while: k < n
                last: l2_next_active(last\next)
                k: k + 1
            if: last = 0 || last\value = 0 || last\value\kind != c.LM_P0_NODE_STRUCTURE || last\value\as = 0
                return: l2_error(path, stmt, "unsupported body")
            # A condition receives a number: the bare name of a held callable is its result.
            if: l2_held_result_receive(mi, fr\body\first_field, n - 1, 1, path) != 0
                return: 1
            if: l2_check_fields(fr\body\first_field, n - 1, mi, path, stmt) != 0
                return: 1
            l2_loop_depth: l2_loop_depth + 1
            if: l2_scope_push(last\value) != 0
                l2_loop_depth: l2_loop_depth - 1
                return: l2_alloc_or(path, stmt, "out of memory")
            if: l2_check_body(last\value\as\structure, mi, path, depth + 1) != 0
                l2_scope_pop()
                l2_loop_depth: l2_loop_depth - 1
                return: 1
            l2_scope_pop()
            l2_loop_depth: l2_loop_depth - 1
            field: l2_next_active(field\next)
            continue
        if: l2_frame_head(stmt, "for")
            fr: stmt\as\frame
            if: l2_for_cstyle(stmt) = 0
                return: l2_error(path, stmt, "unsupported loop")
            if: fr\trailer != 0 && l2_end_named(fr, "for") = 0
                return: l2_error(path, stmt, "unsupported trailer")
            last: l2_next_active(fr\body\first_field)
            if: l2_scope_push(stmt) != 0
                return: l2_alloc_or(path, stmt, "out of memory")
            declaration: l2_declaration(last\value)
            if: declaration != 0 && declaration\candidate_count > 0
                if: l2_check_decl_candidate(last\value, mi, path) != 0
                    l2_scope_pop()
                    return: 1
                ---
            ---
            last: l2_next_active(last\next)
            if: last = 0 || last\value = 0 || last\value\kind != c.LM_P0_NODE_STRUCTURE || last\value\as = 0
                l2_scope_pop()
                return: l2_error(path, stmt, "unsupported body")
            if: l2_held_result_receive(mi, last\value\as\structure\first_field, l2_count_active(last\value\as\structure), 1, path) != 0
                l2_scope_pop()
                return: 1
            if: l2_check_fields(last\value\as\structure\first_field, l2_count_active(last\value\as\structure), mi, path, stmt) != 0
                l2_scope_pop()
                return: 1
            last: l2_next_active(last\next)
            if: last = 0 || last\value = 0 || l2_check_primary(last\value, mi, path) != 0
                l2_scope_pop()
                return: 1
            last: l2_next_active(last\next)
            last: l2_next_active(last\next)
            if: last = 0 || last\value = 0 || last\value\kind != c.LM_P0_NODE_STRUCTURE || last\value\as = 0
                l2_scope_pop()
                return: l2_error(path, stmt, "unsupported body")
            l2_loop_depth: l2_loop_depth + 1
            if: l2_check_body(last\value\as\structure, mi, path, depth + 1) != 0
                l2_loop_depth: l2_loop_depth - 1
                l2_scope_pop()
                return: 1
            l2_loop_depth: l2_loop_depth - 1
            l2_scope_pop()
            field: l2_next_active(field\next)
            continue
        if: l2_frame_head(stmt, "if") = 0 && stmt != 0 && stmt\as != 0 && stmt\as\frame != 0 && stmt\as\frame\head != 0 && l2_ml_array_head(stmt\as\frame\head) >= 0
            if: l2_index_head(stmt\as\frame\head, mi) != 0
                return: l2_error(path, stmt, "unsupported index")
            if: stmt\as\frame\body = 0 || l2_check_fields(stmt\as\frame\body\first_field, l2_count_active(stmt\as\frame\body), mi, path, stmt) != 0
                return: 1
            field: l2_next_active(field\next)
            continue
        ---
        if: l2_frame_head(stmt, "if") = 0 && l2_const_local_ty(stmt, @ lnm, @ lty) = 0 && l2_ml_find(lnm) >= 0
            if: l2_check_reference_init(stmt, mi, path) != 0
                return: 1
            field: l2_next_active(field\next)
            continue
        # A resolved fnptr local (type 40) is a call in any surface form:
        # parenthesized, colon, or vertical. Type-headed decl+init is l2_fnptr_local; later "f: value" is a call.
        if: l2_frame_head(stmt, "if") = 0 && stmt != 0 && stmt\as != 0 && stmt\as\frame != 0 && stmt\as\frame\head != 0 && l2_ml_find(stmt\as\frame\head) >= 0 && l2_ml_ty[l2_ml_find(stmt\as\frame\head)] = 40
            if: stmt\as\frame\body != 0 && l2_next_active(stmt\as\frame\body\first_field) != 0 && l2_check_fields(stmt\as\frame\body\first_field, l2_actual_count(stmt\as\frame\body\first_field), mi, path, stmt) != 0
                return: 1
            field: l2_next_active(field\next)
            continue
        if: l2_frame_head(stmt, "if") = 0 && l2_fnptr_local(stmt, @ lnm) = 0 && l2_ml_find(lnm) >= 0
            field: l2_next_active(field\next)
            continue
        if: l2_frame_head(stmt, "if") = 0 && l2_struct_local(stmt, @ lnm) = 0 && l2_ml_find(lnm) >= 0
            field: l2_next_active(field\next)
            continue
        # The walked root's typed reference `@: T r` (l2_root_ref_ns): its own field, counted and bound here as
        # `Model: m`'s is.
        if: l2_root_ref_ns(mi, stmt, @ cname) >= 0
            cj: l2_own_find_decl(mi, cname, stmt)
            l2_own_excl: cj
            k: l2_check_reference_init(stmt, mi, path)
            l2_own_excl: -1
            if: k != 0
                return: 1
            cj: l2_own_add(mi, cname, l2_graph_own(), path, stmt)
            if: cj < 0
                return: 1
            if: l2_own_off(mi, cj) = (cast: (size_t) -1)
                return: l2_error(path, stmt, "size overflow")
            if: l2_own_decl[cj] = stmt
                l2_m_uses[l2_own_off(mi, cj)]: 1
                l2_m_own[mi]: l2_m_own[mi] + 1
                if: l2_bind_own(mi, cj, path, stmt) != 0
                    return: 1
            ---
            if: l2_own_nsty_set(cj, l2_root_ref_ns(mi, stmt, @ cname)) != 0
                return: 1
            field: l2_next_active(field\next)
            continue
        cj: l2_own_ref_decl(stmt, mi)
        if: cj >= 0
            l2_own_excl: cj
            k: l2_check_reference_init(stmt, mi, path)
            l2_own_excl: -1
            if: k != 0
                return: 1
            field: l2_next_active(field\next)
            continue
        if: l2_frame_head(stmt, "if") = 0 && l2_ptr_local_ty(stmt, @ lnm, @ lty) = 2
            return: l2_error(path, l2_next_active(stmt\as\frame\body\first_field)\value, "unknown type")
        if: l2_frame_head(stmt, "if") = 0 && l2_ptr_local_ty(stmt, @ lnm, @ lty) = 0 && l2_ml_find(lnm) >= 0
            if: l2_check_reference_init(stmt, mi, path) != 0
                return: 1
            field: l2_next_active(field\next)
            continue
        # sendMessage is recorded for native emission in every compiled body.
        if: l2_frame_head(stmt, "sendMessage") != 0
            if: l2_msend_register(stmt, path, mi, @ msk, @ msni) != 0
                return: 1
            send_field: l2_next_active(stmt\as\frame\body\first_field)
            send_count: l2_count_active(stmt\as\frame\body)
            if: send_count > 1 && l2_check_fields(send_field, send_count - 1, mi, path, stmt) != 0
                return: 1
            send_message: l2_skip_span(send_field, send_count - 1)
            send_node: send_message\value
            send_part: l2_next_active(send_node\as\frame\body\first_field)
            send_i: 0
            while: send_part != 0
                send_node: send_part\value
                if: l2_msend_kind[l2_msend_off[msk] + send_i] = 1 && l2_check_fields(l2_next_active(send_node\as\frame\body\first_field), l2_count_active(send_node\as\frame\body), mi, path, send_node) != 0
                    return: 1
                send_part: l2_next_active(send_part\next)
                send_i: send_i + 1
            ---
            field: l2_next_active(field\next)
            continue
        # receiveMessage: m / receiveMessage: m Model (Q10; the two-name form,
        # FABLE-SONNET-SEND-REF-20260925-172 commit 2). A written output site
        # declares its own occurrence unless a source-visible explicit typed
        # target in this body is selected. Reexecution reuses that same site;
        # a second computed declaration never rebinds the first. A
        # letter's graph has no static Structure type of its own: into the
        # letter model own field it is admitted at run time (l2_emit_admit);
        # a formal or a hidden input of the body, whatever its spelling, is not
        # its target and does not refuse it: from its place on the output
        # shadows it, as any later declaration does (K03-OUTPUT-ORACLES-20261007-24;
        # docs #own's `fn: keep (int: n)`).  Set here too, not only in the
        # collection pre-pass (l2_collect_asgn_body): idempotent on a repeat,
        # and the only way this site's own l2_own_nsty_get check below sees
        # the type on a first declaration if that pre-pass has not run yet.
        if: l2_receive_msg_shape(stmt, @ cname, 0) = 2
            return: l2_error(path, stmt, "receiveMessage binds one or two names")
        if: l2_receive_msg_shape(stmt, @ cname, @ cmodel) = 0
            cj: l2_own_output_add(mi, cname, l2_graph_own(), path, stmt)
            if: cj < 0
                return: 1
            if: l2_receiver_output_place(stmt, mi, @ receiver_place) != 0
                return: l2_error(path, stmt, "internal: receiver output has no resolved storage place")
            cj: receiver_place.index
            if: cmodel != 0
                if: l2_letter_ns_for(cmodel, stmt, path, @ letni) != 0
                    return: 1
                if: l2_own_nsty_set(cj, letni) != 0
                    return: 1
                ---
            if: l2_own_nsty_get(cj) >= 0 && l2_admit_site(mi) != 0
                return: l2_error(path, stmt, "internal: admission outside a method")
            if: l2_own_off(mi, cj) = (cast: (size_t) -1)
                return: l2_error(path, stmt, "size overflow")
            if: l2_own_decl[cj] = stmt
                l2_m_uses[l2_own_off(mi, cj)]: 1
                l2_m_own[mi]: l2_m_own[mi] + 1
                if: l2_bind_own(mi, cj, path, stmt) != 0
                    return: 1
            ---
            field: l2_next_active(field\next)
            continue
        if: l2_frame_head(stmt, "if") = 0 && stmt != 0 && stmt\as != 0 && stmt\as\frame != 0 && stmt\as\frame\head != 0 && l2_ml_find(stmt\as\frame\head) >= 0
            if: stmt\as\frame\body = 0 || l2_check_fields(stmt\as\frame\body\first_field, l2_count_active(stmt\as\frame\body), mi, path, stmt) != 0
                return: 1
            if: l2_colon_check_assignment(stmt, mi, path) != 0
                return: 1
            # A typed reference `@: T r` to a named Structure is rebound after the admission of its value to T (the
            # emission's l2_emit_admit): the site puts the method on the throw channel.
            if: l2_ml_ns[l2_ml_find(stmt\as\frame\head)] >= 0 && l2_admit_site(mi) != 0
                return: 1
            field: l2_next_active(field\next)
            continue
        if: l2_frame_head(stmt, "if") = 0 && l2_unimpl_numeric(stmt) != 0
            return: l2_error(path, stmt, l2_unimpl_numeric(stmt))
        if: l2_frame_head(stmt, "if") = 0 && l2_own_decl_ty(stmt) != 0 && depth > 0 && l2_scope_n = 0
            return: l2_error(path, stmt, "unsupported own declaration")
        declaration: l2_declaration(stmt)
        if: l2_frame_head(stmt, "if") = 0 && l2_own_decl_ty(stmt) != 0
            if: l2_check_decl_candidate(stmt, mi, path) != 0
                return: 1
            ---
        ---
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt)
            field: l2_next_active(field\next)
        raw: 1
        ix: 1
        pd: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0
            pd: l2_check_indirect_write(stmt, mi, path)
            if: pd = 1
                return: 1
            if: pd = 0
                field: l2_next_active(field\next)
                continue
            pd: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && stmt\as != 0 && stmt\as\frame != 0 && stmt\as\frame\head != 0
            ix: l2_index_head(stmt\as\frame\head, mi)
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && (ix = 2 || ix = 3)
            return: l2_error(path, stmt, "unsupported index")
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && stmt\as != 0 && stmt\as\frame != 0
            raw: l2_raw_head(stmt\as\frame\head, mi, @ rj)
            pd: l2_prefix_deref(stmt\as\frame\head, mi, 0, pdest)
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && pd = 2
            return: l2_error(path, stmt, "invalid raw dereference")
        # `f()`/`f: ()`/closed empty vertical, name absent (FABLE-SONNET-
        # EMPTY-STRUCT-20260923-132): the empty Structure-body supplies its
        # own structural type -- declare f as a new, empty structural own
        # field through the ordinary declaration path, exactly like
        # `Model: fresh` two cases above minus a named model to record (no
        # l2_own_nsty_set: there is no name to look up, and an opaque,
        # no-namespace own field is exactly what a 0-field type has to be).
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_empty_struct_decl_shape(stmt, mi) != 0
            if: l2_local_ns_declare(stmt, mi, path) != 0
                return: 1
            field: l2_next_active(field\next)
            continue
        # A method's own named Structure, `S:` + number fields (l2_local_ns_shape, l2_local_ns_declare).
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_local_ns_shape(stmt, mi) != 0
            if: l2_local_ns_declare(stmt, mi, path) != 0
                return: 1
            field: l2_next_active(field\next)
            continue
        # `f()` -- one Frame with `f: ()` and the closed empty vertical -- when f already binds a Structure
        # (l2_empty_struct_assign_shape) is f's nullary call, as the bare atom f is (l2_check_struct_call; book §9
        # after 55c1abc: a callable, an ordinary named Structure included, is called, never assigned).
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_empty_struct_assign_shape(stmt, mi) != 0
            if: l2_check_struct_call(stmt, stmt\as\frame\head, mi, path) != 0
                return: 1
            field: l2_next_active(field\next)
            continue
        # `T: value` -- a value, a Structure of fields, a name bound before -- with T an existing named Structure: T is
        # called with the value (book §9 after 55c1abc: a callable, an ordinary named Structure included, is called,
        # never assigned), and an ordinary named Structure has no arguments (Q59): the argument is the arity refusal
        # of the resolved value, l2_struct_arity_error.  (`T()` is its nullary call, above; `T: fresh` is T's call
        # whatever fresh is -- an unknown actual is neither declared nor cloned, K03 NS-ROLES-2.)
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_is_asgn(stmt, mi) != 0 && stmt\as\frame\head != 0 && l2_ident(stmt\as\frame\head) != 0 && l2_param_find(mi, stmt\as\frame\head) < 0 && l2_own_visible(mi, stmt\as\frame\head) < 0 && l2_slot_find(mi, stmt\as\frame\head) < 0 && l2_ml_find(stmt\as\frame\head) < 0 && l2_ns_find(stmt\as\frame\head) >= 0 && stmt\as\frame\body != 0 && l2_count_active(stmt\as\frame\body) > 0
            return: l2_struct_arity_error(path, stmt, stmt\as\frame\head)
        # A bare colon frame whose head is not a call is an update only when
        # that head already has a typed mutable binding.  In particular,
        # `arg: 7` must not silently invent arg; the graph-construction role was
        # normalized to an explicit merge before reaching this check.
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_is_asgn(stmt, mi) != 0 && stmt\as\frame\head != 0 && l2_ident(stmt\as\frame\head) != 0 && l2_param_find(mi, stmt\as\frame\head) < 0 && l2_own_visible(mi, stmt\as\frame\head) < 0 && l2_slot_find(mi, stmt\as\frame\head) < 0 && l2_ml_find(stmt\as\frame\head) < 0
            return: l2_error(path, stmt, "assignment target must be a declared typed mutable value")
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_colon_check_assignment(stmt, mi, path) != 0
            return: 1
        # A nonprimitive formal -- `(@: T v)` or `(T: v)`, ONE reference transport in a signature (the book, "A signature
        # is not executed"; K03) -- is a reference binding in the body, rebound after the admission of its value to T, as
        # a typed reference local is (the ml branch above): the emission's l2_emit_admit before the formal's store; the
        # site puts the method on the throw channel.  The condition keys on the formal's model, the same for both
        # spellings; `v: w` is not v's call (a reference binding does not auto-call its referent).
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_is_asgn(stmt, mi) != 0 && l2_formal_find(mi, stmt\as\frame\head) >= 0 && l2_input_model(mi, l2_formal_find(mi, stmt\as\frame\head)) >= 0 && l2_admit_site(mi) != 0
            return: 1
        if: l2_is_asgn(stmt, mi) != 0
            cj: l2_own_visible(mi, stmt\as\frame\head)
            if: cj >= 0 && l2_own_is_slot(cj) = 0 && l2_own_nsty_get(cj) >= 0 && l2_admit_site(mi) != 0
                return: 1
            ---
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_check_path_write(stmt, mi, path) != 0
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && raw = 0 && rj < l2_m_arity[mi] && (l2_ft(mi, rj) >= 100 && l2_ft(mi, rj) - 100 < l2_foreign_n && l2_foreign_const[l2_ft(mi, rj) - 100] != 0)
            return: l2_error(path, stmt, "const write")
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && raw = 0 && rj < l2_m_arity[mi] && l2_ty_raw_c_members(l2_ft(mi, rj)) = 0
            return: l2_error(path, stmt, "unsupported body")
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && raw = 0 && rj >= l2_m_arity[mi] && rj < l2_m_arity[mi] + l2_m_sn[mi] && l2_ty_raw_c_members(l2_st[l2_slot_off(mi, rj - l2_m_arity[mi])]) = 0
            return: l2_error(path, stmt, "unknown foreign field")
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") = 0 && ix != 0 && pd != 0 && (stmt\as = 0 || stmt\as\frame = 0 || stmt\as\frame\head = 0 || (l2_own_visible(mi, stmt\as\frame\head) < 0 && l2_slot_find(mi, stmt\as\frame\head) < 0 && l2_find_method(stmt\as\frame\head) < 0 && l2_param_find(mi, stmt\as\frame\head) < 0 && raw != 0 && l2_is_known(stmt\as\frame\head) = 0 && l2_is_path_head(stmt\as\frame\head) = 0 && l2_cap_path_head(mi, stmt\as\frame\head) = 0))
            if: stmt\as\frame\head != 0 && stmt\as\frame\head\data != 0 && l2_seg_count(stmt\as\frame\head\data, stmt\as\frame\head\length) > 1
                return: l2_error(path, stmt, "unknown field path root")
            return: l2_error(path, stmt, "unsupported body")
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0
            fr: stmt\as\frame
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && fr\trailer != 0
            return: l2_error(path, stmt, "unsupported trailer")
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") = 0 && (fr\body = 0 || fr\body\trailer != 0)
            return: l2_error(path, stmt, "unsupported trailer")
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") && fr\body != 0 && fr\body\trailer != 0
            return: l2_error(path, stmt, "unsupported trailer")
        # A `sub:`'s, and a named Structure's (its procedure's, §12): one refusal in any place of the body.
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") && l2_m_ret[mi] = 8 && l2_count_active(fr\body) != 0
            return: l2_error(path, stmt, "return with a value in a callable that returns nothing")
        # FABLE-SONNET-DIAG-AND-INDEX-20260924-163 commit 1 (D-40): the same
        # "no result" refusal l2_check_value_call gives for a bare callable
        # atom, not the generic entry-signature text this branch used to
        # give for a call-shaped return whose callee is a sub.
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") && l2_count_active(fr\body) = 1 && l2_next_active(fr\body\first_field)\value != 0 && l2_next_active(fr\body\first_field)\value\kind = c.LM_P0_NODE_FRAME && l2_find_method(l2_next_active(fr\body\first_field)\value\as\frame\head) >= 0 && l2_m_ret[l2_find_method(l2_next_active(fr\body\first_field)\value\as\frame\head)] = 8
            return: l2_error(path, stmt, "a callable without a result has no value")
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_head_is_call(fr\head, fr\body, fr\flags, mi) != 0 && l2_check_primary(stmt, mi, path) != 0
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") = 0 && l2_head_is_call(fr\head, fr\body, fr\flags, mi) = 0 && l2_check_fields(fr\body\first_field, l2_count_active(fr\body), mi, path, stmt) != 0
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") && l2_check_return_literal(mi, fr\body, path, stmt) != 0
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") && l2_check_ret_convert(mi, fr\body, path) != 0
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") && l2_nsty_get(mi, 0 - 1) >= 0 && l2_count_active(fr\body) > 0
            if: l2_admit_return(mi, fr\body\first_field, l2_count_active(fr\body), path, stmt) != 0
                return: 1
            ---
        # The value of a `return:` is checked as any value is, a Structure result's too (the D-108 gate
        # for a return): a call in it records its edges and meets the static rule of §14.
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") && l2_count_active(fr\body) != 0 && l2_head_is_call(fr\head, fr\body, fr\flags, mi) = 0 && l2_check_fields(fr\body\first_field, l2_count_active(fr\body), mi, path, stmt) != 0
            return: 1
        if: l2_frame_head(stmt, "return") != 0 && l2_count_active(fr\body) != 0 && l2_d105_note_return(mi, fr\body\first_field, l2_count_active(fr\body), stmt) != 0
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0
            field: l2_next_active(field\next)
return: 0

fn: l2_parse_unit (const: @(char path)) int
    int: i 0
    int: registered_methods
    int: registered_ns
    # Source declarations precede schema consumers. A merge can consume a
    # visible local definition exactly as it consumes a unit definition;
    # scanning its operands before collecting that source would hide it.
    if: l2_collect_asgn_binds(path) != 0
        return: 1
    # Finish all original local definitions before dynamic/signature/count
    # passes freeze method cardinality. Nested bodies are discovered by the
    # same exact-source collection, never by a lazy COUNT registration.
    registered_methods: -1
    registered_ns: -1
    while: registered_methods != l2_m_n || registered_ns != l2_ns_n
        registered_methods: l2_m_n
        registered_ns: l2_ns_n
        i: 0
        while: i < l2_ns_n
            if: l2_ns_local[i] >= 0 && l2_ns_original_body(i) != 0 && l2_local_ns_proc(i, path) != 0
                return: 1
            i: i + 1
        if: l2_collect_asgn_binds(path) != 0
            return: 1
    ---
    # Reference fields are source declarations too. Consumers of a local
    # definition's schema must see their resolved callable/model target,
    # not snapshot a still-unresolved row into the merge correspondence.
    l2_vis_on: 0
    if: l2_ns_resolve_refs(path, 0) != 0
        return: 1
    # Bind actuals only after every original callable body and reference is
    # registered. An earlier traversal could resolve a local scalar under
    # its parent's method or destructively bind the wrong callable's inputs.
    if: l2_bind_calls(path) != 0
        return: 1
    # Merge results get their schemas after all original definitions exist,
    # but still before any body checking or dynamic/signature sizing. Both
    # scans retain the ordinary source-site visibility rules.
    i: 0
    while: i < l2_m_n
        l2_vis_method(i)
        if: l2_m_body[i] != 0 && l2_m_body[i]\as != 0 && l2_merge_scan(l2_m_body[i]\as\structure, i) != 0
            return: 1
        i: i + 1
    l2_vis_on: 0
    if: l2_collect_asgn_binds(path) != 0
        return: 1
    # Resolve newly collected reference declarations before their consumers
    # are checked. Already resolved rows retain their established bindings.
    l2_vis_on: 0
    if: l2_ns_resolve_refs(path, 0) != 0
        return: 1
    i: 0
    if: l2_dyn_local(path) != 0
        return: 1
    l2_m_throws: (cast: (@: int) calloc((cast: (size_t) (l2_m_n + 1)), c.sizeof(c.int)))
    if: l2_m_throws = 0
        return: l2_error(path, 0, "out of memory")
    l2_d105_reset()
    i: 0
    while: i < l2_m_n
        l2_vis_method(i)
        if: l2_m_body[i] != 0 && l2_m_body[i]\as != 0
            l2_m_throws[i]: l2_body_throws(l2_m_body[i]\as\structure, i)
        i: i + 1
    ---
    if: l2_pap_prepare(path) != 0
        return: 1
    i: 0
    while: i < l2_m_n
        l2_vis_method(i)
        if: l2_m_body[i] != 0 && l2_m_body[i]\as != 0 && l2_ml_rebuild(l2_m_body[i]\as\structure, i, path) != 0
            return: 1
        l2_cur_mi: i
        # An entry with no statement is an empty program; nothing to check.
        if: l2_m_body[i] != 0 && l2_m_body[i]\as != 0 && (i != l2_e || l2_e_n != 0) && l2_check_body(l2_m_body[i]\as\structure, i, l2_method_src(i, path), 0) != 0
            return: 1
        if: l2_check_ret_tr(i, l2_method_src(i, path), l2_ret_tr(l2_callable_source_frame(i)), l2_callable_source_node(i)) != 0
            return: 1
        i: i + 1
    l2_cur_mi: 0 - 1
    l2_vis_on: 0
    if: l2_throws_close() != 0
        return: 1
    if: l2_dyn_close(path) != 0
        return: 1
    # steps/free-names.md M2/M3: the checks that waited for the dynamic inputs' types run now.
    if: l2_wait_run(path) != 0
        return: 1
    if: l2_copy_calls_verify(path) != 0
        return: 1
    if: l2_collect_asgn_binds(path) != 0
        return: 1
    # The entry has no caller, so nothing can hand it a dynamic input: a name it
    # reads before anything above declares it is unresolved.
    if: l2_e >= 0 && l2_m_dyn[l2_e] != 0
        if: l2_dn(l2_e, 0) != 0
            c.fprintf(l1_stderr(), "l2trans detail: unresolved entry name=%.*s\n", (cast: (int) l2_dn(l2_e, 0)\length), l2_dn(l2_e, 0)\data)
        return: l2_error(path, l2_free_name_at(l2_e, 0, 0), "unresolved name")
    i: 0
    while: i < l2_m_n
        l2_m_sig[i]: l2_intern_mi(i)
        if: l2_m_sig[i] = 0U && l2_alloc_err = 2
            return: l2_error(path, l2_m_node[i], "size overflow")
        if: l2_m_sig[i] = 0U
            return: l2_error(path, l2_m_node[i], "out of memory")
        i: i + 1
    if: l2_m_n != 0 && l2_intern_prove(path, l2_m_node[0]) != 0
        return: 1
return: 0

fn: l2_tok_text (const: @(LmP0Text t); @: char dest; size_t: cap) int
    @: char buf 0
    size_t: n 0U
    int: rc
    if: t = 0 || t\data = 0 || dest = 0 || cap = 0U
        return: 1
    if: l2_triple_q(t) != 0
        if: l2_decode_triple_body(t, @ buf, @ n) != 0
            return: 1
        if: buf = 0
            return: l2_fmt_l1_string(dest, cap, "", 0U)
        rc: l2_fmt_l1_string(dest, cap, buf, n)
        l2_xfree((cast: (@: void) buf))
        return: rc
    if: t\length + 1U > cap
        return: 1
    memcpy(dest, t\data, t\length)
    dest[t\length]: 0
return: 0


# THE EXPRESSION TEXT (FIXED-BLOCKS-AUDIT; Codex 2026-10-06, OPUS-CODEX-20261005-01): one text the emitter builds,
# L2Tx -- `data` holding `len` bytes and a NUL in `cap` bytes, its owner's buffer while that suffices, then storage of
# the translation twice the room (l2_text_room, released by l2_release; a grown text's earlier storage stays until
# then, so no pointer into it dangles).  A text has no length but its own; a writer that formats into the text's
# room in place (l2_tok_tx) leaves the length to be taken from the NUL at the next write (len -1).  A reader takes
# `data` after the last write; no pointer into a text is held across a write to it.
fn: l2_tx_open (@: L2Tx t; @: char local; size_t: cap) int
    if: t = 0 || local = 0 || cap = 0U
        return: 1
    t\data: local
    t\len: 0U
    t\cap: cap
    local[0]: 0
return: 0

# The length of t's text: after a writer on a fixed buffer, the bytes before its NUL.
fn: l2_tx_len (@: L2Tx t) size_t
    if: t\len = (cast: (size_t) -1)
        t\len: strlen(t\data)
return: t\len

# Room for `more` bytes after the text and its NUL: twice the room until it is enough, in storage of the
# translation, the text kept.  0, or 1 with l2_alloc_err said (2 when the size overflows).
fn: l2_tx_room (@: L2Tx t; size_t: more) int
    size_t: len
    size_t: need
    size_t: cap
    @: char grown
    if: t = 0 || t\data = 0
        return: 1
    len: l2_tx_len(t)
    if: more > (cast: (size_t) -1) - len - 1U
        l2_alloc_err: 2
        return: 1
    need: len + more + 1U
    if: need <= t\cap
        return: 0
    cap: t\cap
    if: cap < 64U
        cap: 64U
    while: cap < need
        if: cap > (cast: (size_t) -1) / 2U
            cap: need
        else:
            cap: cap * 2U
        ---
    ---
    l2_room_tag: "text-growth"
    grown: l2_text_room(cap, 0, 0U)
    l2_room_tag: 0
    if: grown = 0
        return: 1
    memcpy(grown, t\data, len + 1U)
    t\data: grown
    t\cap: cap
return: 0

# The n bytes at a after t's text.
fn: l2_tx_catn (@: L2Tx t; const: @(char a); size_t: n) int
    size_t: len
    if: t = 0 || (a = 0 && n != 0U) || l2_tx_room(t, n) != 0
        return: 1
    len: l2_tx_len(t)
    if: n != 0U
        memcpy(t\data + len, a, n)
    t\len: len + n
    t\data[t\len]: 0
return: 0

fn: l2_tx_cat (@: L2Tx t; const: @(char a)) int
    if: a = 0
        return: 1
return: l2_tx_catn(t, a, strlen(a))

fn: l2_tx_clear (@: L2Tx t) int
    if: t = 0 || t\data = 0
        return: 1
    t\len: 0U
    t\data[0]: 0
return: 0

# t's text replaced by the text at a (never t's own).
fn: l2_tx_set (@: L2Tx t; const: @(char a)) int
    if: a = 0 || l2_tx_clear(t) != 0
        return: 1
return: l2_tx_cat(t, a)

# t's text replaced by p1, p2, p3, p4 and p5 in order (0 for none; none of them t's own).
fn: l2_tx_join (@: L2Tx t; const: @(char p1); const: @(char p2); const: @(char p3); const: @(char p4); const: @(char p5)) int
    if: l2_tx_clear(t) != 0
        return: 1
    if: p1 != 0 && l2_tx_cat(t, p1) != 0
        return: 1
    if: p2 != 0 && l2_tx_cat(t, p2) != 0
        return: 1
    if: p3 != 0 && l2_tx_cat(t, p3) != 0
        return: 1
    if: p4 != 0 && l2_tx_cat(t, p4) != 0
        return: 1
    if: p5 != 0 && l2_tx_cat(t, p5) != 0
        return: 1
return: 0

# t's text replaced by p0, the n bytes at a, and p1 (0 for none; none of them t's own).
fn: l2_tx_wrapn (@: L2Tx t; const: @(char p0); const: @(char a); size_t: n; const: @(char p1)) int
    if: l2_tx_clear(t) != 0
        return: 1
    if: p0 != 0 && l2_tx_cat(t, p0) != 0
        return: 1
    if: l2_tx_catn(t, a, n) != 0
        return: 1
    if: p1 != 0 && l2_tx_cat(t, p1) != 0
        return: 1
return: 0

# A text on its owner's buffer, opened (l2_tx_open): the text, or 0 when there is none to open.
fn: l2_tx_local (@: L2Tx t; @: char local; size_t: cap) @: L2Tx
    if: l2_tx_open(t, local, cap) != 0
        return: 0
return: t

# dest's text: `levels` indirections (`\`), the text at a, and the n bytes at b (a and b never dest's own).
fn: l2_prefix_levels (@: L2Tx dest; size_t: levels; const: @(char a); const: @(char b); size_t: n) int
    size_t: i 0U
    if: a = 0 || l2_tx_clear(dest) != 0
        return: 1
    while: i < levels
        if: l2_tx_cat(dest, "\\") != 0
            return: 1
        i: i + 1U
    ---
    if: l2_tx_cat(dest, a) != 0
        return: 1
return: l2_tx_catn(dest, b, n)

# t's text is the name of temporary k (l2_tok_temp's spelling).
fn: l2_tx_temp (@: L2Tx t; int: k) int
    []: char nm 32
    if: c.snprintf(nm, 32U, "l2_t%d", k) < 0
        return: 1
return: l2_tx_set(t, nm)

# An atom's text into t, as l2_tok_text writes it but of any length: a triple-quoted text as an L1 string (at
# most four bytes for each of its bytes, and its quotes).
fn: l2_tok_tx (@: L2Tx t; const: @(LmP0Text a)) int
    @: char buf 0
    size_t: n 0U
    int: rc
    if: t = 0 || a = 0 || a\data = 0 || l2_tx_clear(t) != 0
        return: 1
    if: l2_triple_q(a) != 0
        if: l2_decode_triple_body(a, @ buf, @ n) != 0
            return: 1
        if: n > ((cast: (size_t) -1) - 3U) / 4U
            l2_xfree((cast: (@: void) buf))
            l2_alloc_err: 2
            return: 1
        if: l2_tx_room(t, n * 4U + 3U) != 0
            l2_xfree((cast: (@: void) buf))
            return: 1
        if: buf = 0
            rc: l2_fmt_l1_string(t\data, t\cap, "", 0U)
        else:
            rc: l2_fmt_l1_string(t\data, t\cap, buf, n)
            l2_xfree((cast: (@: void) buf))
        ---
        t\len: (cast: (size_t) -1)
        return: rc
    ---
return: l2_tx_catn(t, a\data, a\length)

# Declare temp t with the type of own storage code oty and load the value cell l2_xp[0] into it.
# One emission for every reader of a value cell; a type without one is refused here, by name.
fn: l2_emit_cell_load (int: oty; const: @(char ind); int: t; const: @(LmP0Node at)) int
    if: ind = 0
        return: 1
    if: l2_own_store_helper(oty) = 0
        return: l2_error(l2_src, at, "type has no value cell to load from")
    # A number's cell is never empty where it is held: an empty one is a place a partial copy does not hold
    # (READ-FIELD-CLOSURE), and its read is refused, never read as nothing.
    if: (oty = 0 || oty = 1 || oty = 2 || oty = 3 || oty = 36) && (c.fprintf(l2_out, "%sif: l2_xp[0] = 0\n", ind) < 0 || l2_emit_invariant(ind, "a field reads an absent place") != 0)
        return: 1
    if: oty = 0 && c.fprintf(l2_out, "%sint: l2_t%d\n%sl2_t%d: lmx_int_value_known(l2_xp[0])\n", ind, t, ind, t) < 0
        return: 1
    if: oty = 1 && c.fprintf(l2_out, "%schar: l2_t%d\n%sl2_t%d: (cast: (char) lmx_char_value_known(l2_xp[0]))\n", ind, t, ind, t) < 0
        return: 1
    if: oty = 2 && c.fprintf(l2_out, "%ssize_t: l2_t%d\n%sl2_t%d: lmx_size_value_known(l2_xp[0])\n", ind, t, ind, t) < 0
        return: 1
    if: oty = 3 && c.fprintf(l2_out, "%sunsigned: l2_t%d\n%sl2_t%d: lmx_unsigned_value_known(l2_xp[0])\n", ind, t, ind, t) < 0
        return: 1
    if: oty = 36 && c.fprintf(l2_out, "%sulong: l2_t%d\n%sl2_t%d: lmx_ulong_value_known(l2_xp[0])\n", ind, t, ind, t) < 0
        return: 1
    if: l2_own_is_pointer(oty) != 0
        if: fputs(ind, l2_out) < 0 || l2_emit_own_pointer_type(l2_out, oty) != 0 || c.fprintf(l2_out, " l2_t%d\n%sl2_t%d: (cast: (", t, ind, t) < 0 || l2_emit_own_pointer_type(l2_out, oty) != 0 || fputs(") lmx_pointer_value_known(l2_xp[0]))\n", l2_out) < 0
            return: 1
    ---
return: 0

fn: l2_hidden_from (int: mi; int: callee; int: k; int: callee_self; const: @(char ind); @: L2Tx dest; const: @(LmP0Node at)) int
    @: LmP0Text nm
    int: ty
    int: pi
    int: oi
    int: fi
    int: ni
    []: char ref 64
    if: dest = 0 || callee < 0 || k < 0 || k >= l2_m_dyn[callee] || l2_tx_clear(dest) != 0
        return: 1
    nm: l2_dn(callee, k)
    ty: l2_dt(callee, k)
    # A3 with item 738: a Structure capture, from its host -- the Structure the host's name holds.
    if: l2_mad_host_of(callee) = mi && l2_cap_arg_ns(callee, l2_m_arity[callee] + k) >= 0
        return: l2_cap_host_src(mi, nm, ind, dest)
    pi: -1
    pi: l2_param_find(mi, nm)
    # K04 S2: an input this caller only forwards is its entry of refs, not a value (l2_hidden_forward), until a
    # field of that name declared in scope has bound it.
    if: pi >= l2_m_arity[mi] && l2_dyn_fwd(mi, pi - l2_m_arity[mi]) != 0 && l2_formal_row(mi, pi) < 0
        return: l2_hidden_forward(mi, pi, callee, k, callee_self, ind, dest, at)
    if: pi >= 0
        return: l2_tok_formal(mi, pi, dest)
    oi: -1
    oi: l2_own_visible(mi, nm)
    fi: -1
    if: oi >= 0 && l2_m_uses[l2_own_off(mi, oi)] != 0
        fi: l2_m_alias[l2_own_off(mi, oi)]
    if: fi >= 0
        return: l2_tok_formal(mi, fi, dest)
    if: oi >= 0 && l2_m_uses[l2_own_off(mi, oi)] != 0 && l2_own_load(oi, dest) != 0
        return: 1
    if: oi >= 0 && l2_m_uses[l2_own_off(mi, oi)] != 0
        return: 0
    # No caller binding: use the declaration in the selected callee's lexical
    # node.  This is deliberately after declared and inherited caller inputs,
    # and uses the captured occurrence rather than the translator-global unit.
    # Only the callee's eligible parent declaration supplies this fallback.
    # A future declaration in the callee body is not a visible source, and
    # the caller's position does not replace the callee's lexical context.
    ni: l2_ns_find(nm)
    if: ty = l2_graph_dt() && ni >= 0 && l2_ns_parent[ni] < 0 && callee_self >= 0
        if: c.snprintf(ref, 64U, "lmx_arena_ref_struct(l2_c%d\\parent, %uU)", callee_self, (cast: (unsigned) (l2_ns_unit_slot(ni)))) < 0
            return: 1
        return: l2_tx_set(dest, ref)
    # K04 S2: the caller has no binding of the name.  A callee that only forwards the input, or resolves it
    # itself, takes it absent; the lexical source read is then the reader's own.
    if: l2_hid_takes_absent(callee, k) != 0
        return: l2_tx_set(dest, "ABSENT")
return: l2_hidden_lex(mi, callee, k, callee_self, ind, dest, at)

# The callee's lexical cell of its number input k, read here in the caller: where the callee cannot take the
# input absent.
fn: l2_hidden_lex (int: mi; int: callee; int: k; int: callee_self; const: @(char ind); @: L2Tx dest; const: @(LmP0Node at)) int
    @: LmP0Text nm
    int: ty
    int: child
    int: t
    int: h
    []: char cur 64
    []: char cell 96
    []: char msg_own 128
    L2Tx: msg_tx
    @: L2Tx l2_hf_msg l2_tx_local(@ msg_tx, msg_own, 128U)
    if: mi < 0 || dest = 0 || callee < 0 || k < 0 || k >= l2_m_dyn[callee] || l2_hf_msg = 0 || l2_tx_clear(dest) != 0
        return: 1
    nm: l2_dn(callee, k)
    ty: l2_dt(callee, k)
    child: l2_own_lexical(callee, nm)
    if: child < 0
        return: l2_error_name(l2_src, at, "unbound dynamic input ", nm\data, nm\length, "")
    if: l2_graph_field_child(child) < 0 || l2_call_node = 0
        return: 1
    if: l2_own_from_expr(child, l2_hf_msg) != 0
        return: 1
    # The cell is reached in the lexical tree of the SELECTED occurrence (Codex, FABLE-CODEX-20261004-12): a
    # field of the unit through the parent of a unit method's occurrence, as the Structure above is.
    if: callee_self >= 0 && l2_m_unit_level(callee) != 0 && l2_own_mi[child] = l2_e && l2_graph_field(child) != 0 && l2_graph_field(child)\holder = 0
        if: c.snprintf(cell, 96U, "lmx_arena_ref_cell(l2_c%d\\parent, %zuU)", callee_self, l2_graph_field(child)\child) < 0 || l2_tx_set(l2_hf_msg, cell) != 0
            return: 1
    ---
    # A field held in a nested body of another occurrence has no alias in this activation: a method's aliases
    # are of its own places (l2_emit_graph_places).  Its holder is reached edge by edge from the occurrence that
    # owns it -- the unit through the selected occurrence's parent, as above, or as this method reaches that
    # owner (l2_own_ctr).
    if: l2_own_mi[child] != mi && l2_graph_field(child) != 0 && l2_graph_field(child)\holder != 0
        h: l2_tn
        l2_tn: l2_tn + 1
        if: c.sprintf(cur, "l2_lexh%d", h) < 0
            return: 1
        if: callee_self >= 0 && l2_m_unit_level(callee) != 0 && l2_own_mi[child] = l2_e
            if: c.fprintf(l2_out, "%s@: Lmx %s l2_c%d\\parent\n", ind, cur, callee_self) < 0
                return: 1
            ---
        else:
            if: c.fprintf(l2_out, "%s@: Lmx %s %s\n", ind, cur, l2_own_ctr(child)) < 0
                return: 1
            ---
        ---
        if: l2_emit_graph_holder(l2_graph_field(child)\holder, cur, ind) != 0 || c.snprintf(cell, 96U, "lmx_arena_ref_cell(%s, %zuU)", cur, l2_graph_field(child)\child) < 0 || l2_tx_set(l2_hf_msg, cell) != 0
            return: 1
    ---
    if: c.fprintf(l2_out, "%sl2_xp: %s\n%sif: l2_xp = 0\n", ind, l2_hf_msg\data, ind) < 0
        return: 1
    # A missing cell of a bound hidden input is a broken promise (D-87, as D-05 for a loaded own
    # field): X1, not a return of 0 that the caller would read as the callee's value.
    if: l2_emit_invariant(ind, "a dynamic input has no cell to read") != 0
        return: 1
    t: l2_tn
    l2_tn: l2_tn + 1
    if: l2_own_is_slot(child) != 0 && l2_emit_own_cell_load(child, ind, t, 0) != 0
        return: 1
    if: l2_own_is_slot(child) = 0 && l2_emit_cell_load(l2_own_of_dt(ty), ind, t, 0) != 0
        return: 1
return: l2_tx_temp(dest, t)

# The caller mi only forwards its input pi, a number, and the callee's input k takes that name.  Where the
# callee takes the input absent the entry goes on as it is.  Where it cannot, the entry goes on when present,
# and when absent the callee's lexical cell is read here into storage of the caller's activation.
fn: l2_hidden_forward (int: mi; int: pi; int: callee; int: k; int: callee_self; const: @(char ind); @: L2Tx dest; const: @(LmP0Node at)) int
    int: t
    @: char deep 0
    []: char lex_own 256
    L2Tx: lex_tx
    @: L2Tx lex l2_tx_local(@ lex_tx, lex_own, 256U)
    []: char decl_own 256
    L2Tx: decl_tx
    @: L2Tx decl l2_tx_local(@ decl_tx, decl_own, 256U)
    []: char name 64
    if: lex = 0 || decl = 0
        return: 1
    if: l2_hid_takes_absent(callee, k) != 0
        if: c.snprintf(name, 64U, "REF:l2_pr%d_%d", mi, pi) < 0
            return: 1
        return: l2_tx_set(dest, name)
    # A callee whose name has no lexical declaration has nothing to stand behind the entry: it is required of
    # the callers (l2_dyn_site refuses a chain no one supplies), and the entry goes on as it is.
    if: l2_own_lexical(callee, l2_dn(callee, k)) < 0
        if: c.snprintf(name, 64U, "REF:l2_pr%d_%d", mi, pi) < 0
            return: 1
        return: l2_tx_set(dest, name)
    t: l2_tn
    l2_tn: l2_tn + 1
    if: l2_bump_ind(ind, @ deep) != 0
        return: 1
    if: c.snprintf(name, 64U, "l2_hfb%d", t) < 0 || l2_value_decl_text(l2_input_ft(callee, l2_m_arity[callee] + k), 0, name, decl) != 0
        return: 1
    if: c.fprintf(l2_out, "%s%s\n%s@: void l2_hfr%d l2_pr%d_%d\n%sif: l2_hfr%d = 0\n", ind, decl\data, ind, t, mi, pi, ind, t) < 0
        return: 1
    if: l2_hidden_lex(mi, callee, k, callee_self, deep, lex, at) != 0
        return: 1
    if: c.fprintf(l2_out, "%sl2_hfb%d: %s\n%sl2_hfr%d: (cast: (@: void) (@ l2_hfb%d))\n%s---\n", deep, t, lex\data, deep, t, t, ind) < 0
        return: 1
    if: c.snprintf(name, 64U, "REF:l2_hfr%d", t) < 0
        return: 1
return: l2_tx_set(dest, name)

# Formal (or dynamic input) fi of mi as its code reads it here: its bound field's cell once bound
# (l2_formal_row, -189 c3b-2), the machine argument before.
fn: l2_tok_formal (int: mi; int: fi; @: L2Tx dest) int
    int: k l2_formal_row(mi, fi)
    []: char nm 48
    if: dest = 0
        return: 1
    if: k >= 0
        return: l2_own_load(k, dest)
    if: c.snprintf(nm, 48U, "l2_p%d_%d", mi, fi) < 0
        return: 1
return: l2_tx_set(dest, nm)

fn: l2_tok_slot (int: mi; int: si; @: L2Tx dest) int
    []: char nm 48
    if: dest = 0
        return: 1
    if: c.snprintf(nm, 48U, "l2_s%d_%d", mi, si) < 0
        return: 1
return: l2_tx_set(dest, nm)

# The logical value of a supported declared input, before machine ABI lowering.
# Signature descriptions do not create executable pointer-value bindings.
# Callable formals carry the whole occurrence; both structural signature
# spellings carry the same descriptor. Hidden-input category propagation and
# Array signature lowering remain separate implementation work: no machine
# pointer spelling is used to guess either category here.
fn: l2_input_is_descriptor (int: mi; int: k) int
    if: mi < 0 || k < 0 || k >= l2_m_arity[mi]
        return: 0
    if: l2_cf_get(mi, k) >= 0
        return: 1
return: (cast: (int) (l2_input_model(mi, k) >= 0))

# An Array value is its existing kernel descriptor, not its element backing.
# This projects the descriptor's actual C ABI through the ordinary type interner.
fn: l2_array_desc_ty () int
    LmP0Text: word
    word.data: "VoidArray"
    word.length: 9U
return: l2_foreign_intern(@ word, 1, 0)

# Resolve a name's existing storage once. Its category, not the spelling of
# an enclosing @ expression, determines whether addressing adds indirection.
fn: l2_address_path_text (@: LmP0Field first; int: count) @: char
    @: LmP0Field f l2_next_active(first)
    @: char text
    size_t: size 0U
    size_t: written
    int: i 0
    if: count < 3
        return: 0
    if: l2_rw_path_run(first, count) != count
        return: 0
    while: f != 0 && i < count
        if: f\value = 0 || f\value\as = 0 || f\value\kind != c.LM_P0_NODE_ATOM || f\value\as\atom = 0
            return: 0
        # Leave room for the terminator on every addition, without imposing
        # an unrelated fixed limit on the source path.
        if: f\value\as\atom\length > (cast: (size_t) -1) - size - 1U
            l2_alloc_err: 2
            return: 0
        size: size + f\value\as\atom\length
        f: l2_next_active(f\next)
        i: i + 1
    if: i != count
        return: 0
    text: (cast: (@: char) l2_xmalloc(size + 1U))
    if: text = 0
        return: 0
    # The shared operand-span recognizer already retains occurrence selectors
    # as part of this path. Preserve those tokens instead of reducing the
    # path to the old alternating name/slash-only spelling.
    written: 0U
    f: l2_next_active(first)
    i: 0
    while: i < count
        memcpy(text + written, f\value\as\atom\data, f\value\as\atom\length)
        written: written + f\value\as\atom\length
        f: l2_next_active(f\next)
        i: i + 1
    ---
    text[written]: 0
return: text

# Borrow the address operand's source span. The same path resolver supplies
# the exact declared field type to checking and native address emission.
fn: l2_address_target (@: LmP0Field first; int: count; int: mi; @: L2Address out) int
    @: LmP0Field f l2_next_active(first)
    @: char text
    int: leaf
    int: kind
    int: ft
    int: saved_mi
    if: f = 0 || f\value = 0 || f\value\as = 0
        return: 2
    if: count = 1 && f\value\kind = c.LM_P0_NODE_STRUCTURE && f\value\as\structure != 0
        return: l2_address_target(f\value\as\structure\first_field, l2_count_active(f\value\as\structure), mi, out)
    if: count = 1 && f\value\kind = c.LM_P0_NODE_ATOM && l2_ident(f\value\as\atom) != 0
        kind: l2_address_name(mi, f\value\as\atom, out)
        # The address of a merge result's own row names its reference cell.
        if: kind = 0 && out\kind = 1 && l2_mres_addressed != 0 && l2_mres_of_own(out\index) >= 0
            l2_mres_addressed[l2_mres_of_own(out\index)]: 1
        if: kind = 0 && out\kind = 1 && l2_mres_of_own(out\index) < 0 && l2_own_addr_note(out\index) != 0
            return: 2
        return: kind
    text: l2_address_path_text(first, count)
    if: text = 0
        return: 2
    saved_mi: l2_cur_mi
    l2_cur_mi: mi
    kind: l2_path_contract(text, strlen(text), @ leaf, 0)
    l2_cur_mi: saved_mi
    ft: l2_path_kind_ft(kind)
    if: kind = 10 || kind = 11
        ft: leaf
    if: ft < 0
        l2_xfree(text)
        return: 2
    out\kind: 6
    out\index: kind
    out\descriptor: 0
    out\model: -1
    out\type: l2_address_type(ft)
    out\target: first
    out\target_count: count
    out\immutable: l2_path_in_eternal(text, strlen(text))
    l2_xfree(text)
return: 0

fn: l2_address_name (int: mi; const: @(LmP0Text name); @: L2Address out) int
    int: i
    int: own
    out\kind: 0
    out\index: -1
    out\descriptor: 0
    out\model: -1
    out\type: -1
    out\target: 0
    out\target_count: 0
    out\immutable: 0
    if: name = 0 || l2_ident(name) = 0
        return: 1
    i: l2_param_find(mi, name)
    own: l2_resolved_own(mi, name)
    if: own >= 0 && l2_m_uses[l2_own_off(mi, own)] != 0
        out\kind: 1
        out\index: own
        out\descriptor: l2_own_is_slot(own)
        out\model: l2_own_nsty_get(own)
        out\type: l2_ft_of_own(l2_own_ty[own])
        if: l2_own_is_array(l2_own_ty[own]) != 0
            out\descriptor: 1
            out\model: -1
            out\type: l2_array_desc_ty()
        ---
    else:
        if: i >= 0
            out\kind: 2
            out\index: i
            out\descriptor: l2_input_is_descriptor(mi, i)
            out\type: l2_input_ft(mi, i)
            out\model: l2_nsty_get(mi, i)
        else:
            i: l2_slot_find(mi, name)
            if: i >= 0
                out\kind: 3
                out\index: i
                out\type: l2_st[l2_slot_off(mi, i)]
            else:
                i: l2_ml_find(name)
                if: i >= 0
                    out\kind: 4
                    out\index: i
                    out\type: l2_ml_ty[i]
                    out\model: l2_ml_ns[i]
                else:
                    i: l2_ns_find_payload(name)
                    if: i >= 0
                        out\kind: 5
                        out\index: i
                        out\descriptor: 1
                        out\model: i
                        out\type: l2_graph_ft()
    ---
    if: out\kind = 0
        return: 1
    if: out\descriptor != 0
        out\type: l2_formal_raw(out\type)
    else:
        out\type: l2_address_type(out\type)
    # A known machine location can have an opaque C type which the old local
    # metadata does not retain. Keep its type unknown, never int or void*;
    # its address still uses that actual C location.
return: 0

# The two P0 representations of the same unary operation share the location
# resolver. 2 means a different expression; 1 means a bad name/location.
fn: l2_address_node (const: @(LmP0Node node); int: mi; @: L2Address out) int
    if: node = 0 || node\as = 0
        return: 2
    if: node\kind = c.LM_P0_NODE_STRUCTURE && node\as\structure != 0
        return: l2_address_operand(node\as\structure\first_field, l2_count_active(node\as\structure), mi, out)
    if: l2_frame_head(node, "@") = 0 || node\as\frame\body = 0
        return: 2
return: l2_address_target(node\as\frame\body\first_field, l2_count_active(node\as\frame\body), mi, out)

# No evaluation occurs while resolving this view. Every consumer receives the
# exact same source span and index, with the caller's remaining count as bound.
fn: l2_head_rebase_body (@: LmP0Structure body; const: @(LmP0Span origin)) int
    @: LmP0Field field
    if: body = 0
        return: 0
    field: body\first_field
    while: field != 0
        l2_head_rebase_node(field\value, origin)
        field: field\next
    if: body\trailer != 0
        l2_head_rebase_body(body\trailer\body, origin)
return: 0

fn: l2_head_rebase_node (@: LmP0Node node; const: @(LmP0Span origin)) int
    @: LmP0Frame frame
    if: node = 0 || origin = 0
        return: 0
    if: node\span != 0
        if: node\span\line = 1U
            node\span\column: node\span\column + origin\column - 1U
        node\span\line: node\span\line + origin\line - 1U
        node\span\offset: node\span\offset + origin\offset
    if: node\as = 0
        return: 0
    if: node\kind = c.LM_P0_NODE_STRUCTURE
        return: l2_head_rebase_body(node\as\structure, origin)
    if: node\kind = c.LM_P0_NODE_FRAME
        frame: node\as\frame
        if: frame != 0
            l2_head_rebase_body(frame\body, origin)
            if: frame\trailer != 0 && (frame\body = 0 || frame\trailer != frame\body\trailer)
                l2_head_rebase_body(frame\trailer\body, origin)
            ---
        ---
    ---
return: 0

# P0 parses the original head bytes. Cache topology only; each use resolves
# names/contracts afresh in its original source environment. Deferred checks
# borrow this document until l2_application_free, never a temporary freed AST.
fn: l2_head_expression (const: @(LmP0Node stmt); @: int status) @: L2HeadExpression
    @: L2HeadExpression expression l2_head_expressions
    const: @: LmP0Diagnostic diagnostic
    @: LmP0Text head
    @: LmP0Node root
    @: LmP0Field open
    int: count
    int: prefix
    \status: 1
    if: stmt = 0 || stmt\kind != c.LM_P0_NODE_FRAME || stmt\as = 0 || stmt\as\frame = 0
        return: 0
    head: stmt\as\frame\head
    if: head = 0 || head\data = 0 || head\length = 0U || head\data[head\length - 1U] != 93
        return: 0
    while: expression != 0
        if: expression\source = stmt
            \status: 0
            return: expression
        expression: expression\allocated_next
    expression: (cast: (@: L2HeadExpression) l2_xmalloc(c.sizeof(c.L2HeadExpression)))
    if: expression = 0
        \status: 2
        l2_alloc_or(l2_src, stmt, "cannot allocate an indexed head")
        return: 0
    memset(expression, 0, c.sizeof(c.L2HeadExpression))
    if: lm_p0_parse_bytes(head\data, head\length, @ expression\document) != 0
        \status: 2
        diagnostic: lm_p0_document_diagnostic(expression\document)
        if: diagnostic != 0
            if: diagnostic\code = 1
                l2_alloc_err: 1
            l2_alloc_or(l2_src, stmt, diagnostic\message)
        else:
            if: expression\document = 0
                l2_alloc_err: 1
            l2_alloc_or(l2_src, stmt, "cannot parse an indexed head")
        ---
        lm_p0_document_destroy(expression\document)
        l2_xfree(expression)
        return: 0
    root: lm_p0_document_mutable_root(expression\document)
    if: root = 0 || root\kind != c.LM_P0_NODE_STRUCTURE || root\as = 0 || root\as\structure = 0
        lm_p0_document_destroy(expression\document)
        l2_xfree(expression)
        return: 0
    expression\body: root\as\structure
    count: l2_count_active(expression\body)
    prefix: l2_rw_path_run_mode(l2_next_active(expression\body\first_field), count, 0)
    open: l2_skip_span(expression\body\first_field, prefix)
    if: prefix < 1 || open = 0 || open\value = 0 || open\value\span = 0 || l2_field_index_group(open, count - prefix, @ expression\index, @ expression\after) = 0
        lm_p0_document_destroy(expression\document)
        l2_xfree(expression)
        return: 0
    expression\base.data: head\data
    expression\base.length: open\value\span\offset
    l2_head_rebase_node(root, stmt\span)
    expression\source: (cast: (@: LmP0Node) stmt)
    expression\allocated_next: l2_head_expressions
    l2_head_expressions: expression
    \status: 0
return: expression

# Resolve one Array place, never a raw pointer or a new Array-rank construct.
# 1 is another head; 2 is a resolved Array whose operand is not supported by
# the common value-contract producer yet; 3 is an already diagnosed failure.
# No physical slot is read here.
fn: l2_array_place (const: @(LmP0Node stmt); int: mi; @: L2ArrayPlace out) int
    int: status
    out\allocated_base: 0
    out\expression: l2_head_expression(stmt, @ status)
    if: status = 2
        return: 3
    if: out\expression = 0
        return: 1
    out\base: out\expression\base
    out\index: out\expression\index
    if: out\expression\after != 0
        return: 1
return: l2_array_place_contract(mi, out)

fn: l2_array_place_contract (int: mi; @: L2ArrayPlace out) int
    @: L2TypeContract contract 0
    int: method -1
    int: model -1
    int: saved l2_cur_mi
    out\own: l2_resolved_own(mi, @ out\base)
    if: out\own >= 0
        contract: l2_binding_contract(mi, @ out\base)
    else:
        l2_cur_mi: mi
        l2_path_resolve_contract((out\base.data), (out\base.length), @ method, @ model, @ contract)
        l2_cur_mi: saved
    ---
    if: contract = 0 || contract\kind != 1
        return: 1
    if: l2_contract_formal(contract\operand, @ out\type) != 0
        return: 2
    out\model: l2_contract_model(contract\operand, 0)
return: 0

# The very same place from an original expression span. Field selectors are
# resolved by the common path prefix; the following group supplies the index.
fn: l2_array_span (@: LmP0Field first; int: n; int: mi; @: L2ArrayPlace out) int
    int: prefix
    int: group
    int: status
    @: LmP0Field open
    @: LmP0Field after
    @: LmP0Field base
    @: char text
    out\allocated_base: 0
    out\expression: 0
    prefix: l2_rw_path_run_mode(l2_next_active(first), n, 0)
    open: l2_skip_span(first, prefix)
    if: prefix < 1 || prefix >= n
        return: 1
    group: l2_field_index_group(open, n - prefix, @ out\index, @ after)
    if: group = 0
        return: 1
    base: l2_next_active(first)
    if: prefix = 1
        if: base\value\kind != c.LM_P0_NODE_ATOM || base\value\as = 0 || base\value\as\atom = 0
            return: 1
        out\base.data: base\value\as\atom\data
        out\base.length: base\value\as\atom\length
    else:
        text: l2_address_path_text(first, prefix)
        if: text = 0
            l2_alloc_or(l2_src, base\value, "cannot allocate an Array operand path")
            return: 3
        out\base.data: text
        out\base.length: strlen(text)
        out\allocated_base: 1
    ---
    out\count: prefix + group
    status: l2_array_place_contract(mi, out)
    if: status != 0
        l2_array_place_release(out)
return: status

fn: l2_array_place_release (@: L2ArrayPlace place) int
    if: place\allocated_base != 0
        l2_xfree((cast: (@: void) (place\base.data)))
        place\allocated_base: 0
return: 0

fn: l2_check_array_place (const: @(LmP0Node stmt); int: mi; const: @(char path); const: @(L2ArrayPlace place)) int
    @: LmP0Frame frame stmt\as\frame
    const: @(L2ValueSpan index) @ place\index
    @: LmP0Field first
    const: @: LmP0Node value_at stmt
    if: frame\body = 0 || frame\trailer != 0 || frame\body\trailer != 0
        return: l2_error(path, stmt, "unsupported trailer")
    if: l2_path_in_eternal((place\base.data), (place\base.length)) != 0
        return: l2_error(path, stmt, "an eternal branch field cannot be updated")
    if: l2_check_fields(index\first, index\count, mi, path, stmt) != 0 || l2_check_receiving_value(l2_next_active(index\first)\value, index\first, index\count, 2, -1, 0, mi, path) != 0
        return: 1
    if: l2_check_fields(frame\body\first_field, l2_count_active(frame\body), mi, path, stmt) != 0
        return: 1
    first: l2_next_active(frame\body\first_field)
    if: first != 0
        value_at: first\value
return: l2_check_receiving_value(value_at, frame\body\first_field, l2_count_active(frame\body), place\type, place\model, 0, mi, path)

# Receiving conversion over the same bounded span used by ordinary actuals.
fn: l2_emit_received_span (@: LmP0Field first; int: n; int: ty; int: model; const: @(LmP0Node stmt); int: mi; const: @(char ind); @: L2Tx dest) int
    int: converted 2
    if: l2_pointer_depth(ty) = 0
        converted: l2_emit_value_convert_field(stmt, first, n, ty, mi, ind, dest)
    if: converted = 1
        return: 1
    if: converted = 0
        return: 0
return: l2_emit_reference_value(first, n, ty, model, mi, ind, dest)

fn: l2_emit_array_place (const: @(LmP0Node stmt); int: mi; const: @(char ind); const: @(L2ArrayPlace place)) int
    []: char target_own 128
    L2Tx: target_tx
    @: L2Tx target @ target_tx
    if: l2_tx_open(target, target_own, 128U) != 0 || l2_emit_array_place_operand(stmt, mi, ind, place, target) != 0
        return: 1
    if: l2_emit_received_span(stmt\as\frame\body\first_field, l2_count_active(stmt\as\frame\body), place\type, place\model, stmt, mi, ind, l2_tok) != 0
        return: 1
return: (cast: (int) (c.fprintf(l2_out, "%s%s: %s\n", ind, target\data, l2_tok\data) < 0))

fn: l2_emit_array_place_operand (const: @(LmP0Node stmt); int: mi; const: @(char ind); const: @(L2ArrayPlace place); @: L2Tx dest) int
    []: char descriptor_own 128
    L2Tx: descriptor_tx
    @: L2Tx descriptor @ descriptor_tx
    []: char name 64
    []: char declarator_own 1024
    L2Tx: declarator_tx
    @: L2Tx declarator l2_tx_local(@ declarator_tx, declarator_own, 1024U)
    []: char type_text_own 1024
    L2Tx: type_text_tx
    @: L2Tx type_text l2_tx_local(@ type_text_tx, type_text_own, 1024U)
    []: char index_value_own 1024
    L2Tx: index_value_tx
    @: L2Tx index_value @ index_value_tx
    int: kind
    int: temp l2_tn
    const: @(L2ValueSpan index) @ place\index
    l2_tn: l2_tn + 1
    if: l2_tx_open(descriptor, descriptor_own, 128U) != 0
        return: 1
    if: place\own >= 0 && l2_emit_array_desc(place\own, ind, descriptor) != 0
        return: 1
    if: place\own < 0
        if: l2_emit_path_to((place\base.data), (place\base.length), mi, ind, stmt, @ kind, 1) != 0 || c.fprintf(l2_out, "%s@: VoidArray l2_ai%d_desc (cast: (@: VoidArray) l2_pxp[0])\n", ind, temp) < 0
            return: 1
        if: c.fprintf(l2_out, "%sif: l2_ai%d_desc = 0\n", ind, temp) < 0 || l2_emit_path_bail(mi, ind) != 0
            return: 1
        if: c.snprintf(name, 64U, "l2_ai%d_desc", temp) < 0 || l2_tx_set(descriptor, name) != 0
            return: 1
    ---
    c.sprintf(name, "l2_ai%d_data", temp)
    if: l2_value_decl_text(place\type, 1, name, declarator) != 0 || l2_pointer_decl_text(place\type, 1, 0, type_text) != 0 || c.fprintf(l2_out, "%s%s (cast: (%s) %s\\data)\n", ind, declarator\data, type_text\data, descriptor\data) < 0
        return: 1
    if: l2_tx_open(index_value, index_value_own, 1024U) != 0 || l2_emit_received_span(index\first, index\count, 2, -1, stmt, mi, ind, index_value) != 0 || c.fprintf(l2_out, "%ssize_t: l2_ai%d_index %s\n", ind, temp, index_value\data) < 0
        return: 1
    if: c.snprintf(name, 64U, "l2_ai%d_data[l2_ai%d_index]", temp, temp) < 0
        return: 1
return: l2_tx_set(dest, name)

fn: l2_rw_array_place (const: @(LmP0Node stmt); const: @(L2ArrayPlace place); int: into; @: int out) int
    int: child
    if: l2_rw_array_place_operand(stmt, place, "LMX_WALK_OP_ELEMPUT", 4, into, out) != 0
        return: 1
    if: l2_rw_reference_receive(stmt\as\frame\body\first_field, l2_count_active(stmt\as\frame\body), l2_own_ty_of_param(place\type), place\model, \out, @ child) != 0
        return: 1
return: l2_rw_put(\out, 3, child)

fn: l2_rw_array_place_operand (const: @(LmP0Node stmt); const: @(L2ArrayPlace place); const: @(char op); int: width; int: into; @: int out) int
    @: int path 0
    int: capacity l2_seg_count((place\base.data), (place\base.length))
    int: status
    int: child
    const: @(L2ValueSpan index) @ place\index
    if: l2_rw_frame(into, op, width, out) != 0
        return: 1
    if: place\own >= 0
        status: l2_rw_own(\out, place\own, @ child)
    else:
        if: capacity < 0 || capacity > (c.INT_MAX - 6) / 3
            l2_alloc_err: 2
            return: l2_alloc_or(l2_src, stmt, "cannot allocate an Array operand path")
        if: l2_mul_ok((cast: (size_t) (6 + 3 * capacity)), c.sizeof(c.int)) = 0
            l2_alloc_err: 2
            return: l2_alloc_or(l2_src, stmt, "cannot allocate an Array operand path")
        path: (cast: (@: int) l2_xmalloc((cast: (size_t) (6 + 3 * capacity)) * c.sizeof(c.int)))
        if: path = 0
            return: l2_alloc_or(l2_src, stmt, "cannot allocate an Array operand path")
        status: l2_rw_path_resolve_sized(stmt, @ place\base, 1, 1, capacity, path)
        if: status = 0
            status: l2_rw_path_value(path, path[2], \out, @ child)
        l2_xfree(path)
    ---
    if: status != 0 || l2_rw_put(\out, 1, child) != 0 || l2_rw_reference_receive(index\first, index\count, 2, -1, \out, @ child) != 0 || l2_rw_put(\out, 2, child) != 0
        return: 1
return: 0

# The address of an Array place's element: ADDRESS over the very ELEM operand a
# read of that place has, with the pointer type as its witness. Nothing is read.
fn: l2_rw_array_place_address (const: @(LmP0Node at); const: @(L2ArrayPlace place); int: parent; @: int out) int
    int: value
    int: ty l2_address_type(place\type)
    if: ty < 0
        return: l2_rw_refuse(at, "the address of this Array element")
    if: l2_rw_frame(parent, "LMX_WALK_OP_ADDRESS", 3, out) != 0 || l2_rw_witness(\out, 2, l2_own_ty_of_param(ty), 0) != 0
        return: 1
    if: l2_rw_array_place_operand(at, place, "LMX_WALK_OP_ELEM", 3, \out, @ value) != 0
        return: 1
return: l2_rw_put(\out, 1, value)

fn: l2_indexed_clear (@: L2IndexedOperand out) int
    out\own: -1
    out\type: -1
    out\count: 0
    out\address: 0
    out\dynamic: -1
    out\literal: 0U
    out\index: 0
    out\after: 0
return: 0

fn: l2_indexed_type (@: L2IndexedOperand out) int
    int: ty l2_own_ty[out\own]
    @: L2Declaration declaration
    # Address the declared element, not any numeric promotion of a read.
    # The ordinary type contract retains pointer depth and qualifications.
    if: out\address != 0
        declaration: l2_declaration(l2_own_decl[out\own])
        if: declaration = 0 || declaration\contract = 0 || declaration\contract\kind != 1 || l2_contract_formal(declaration\contract\operand, @ out\type) != 0
            return: 2
        out\type: l2_address_type(out\type)
        if: out\type < 0
            return: 2
        return: 0
    out\type: l2_ft_of_own(l2_rw_elem_ty(out\own))
    if: ty = 8
        out\type: 34
    if: l2_oc_is_parray(ty) != 0
        out\type: l2_oc_ft(ty)
    if: out\type < 0
        return: 2
return: 0

fn: l2_indexed_atom (const: @(LmP0Text word); int: mi; @: L2IndexedOperand out) int
    int: status
    l2_indexed_clear(out)
    status: l2_own_index_head(word, mi, @ out\own, @ out\literal)
    if: status = 0
        out\count: 1
        return: l2_indexed_type(out)
    status: l2_dyn_own_index(mi, word, @ out\own, @ out\dynamic)
    if: status = 2
        return: 3
    if: status != 1
        return: 1
    out\count: 1
return: l2_indexed_type(out)

fn: l2_indexed_node (const: @(LmP0Node node); int: mi; @: L2IndexedOperand out) int
    int: count
    int: status
    l2_indexed_clear(out)
    if: node = 0 || node\as = 0
        return: 1
    if: node\kind = c.LM_P0_NODE_ATOM
        return: l2_indexed_atom(node\as\atom, mi, out)
    if: l2_frame_head(node, "@") = 0 || node\as\frame\body = 0
        return: 1
    count: l2_count_active(node\as\frame\body)
    status: l2_indexed_operand(node\as\frame\body\first_field, count, mi, out)
    if: status != 0
        return: status
    if: out\count != count || out\address != 0
        return: 2
    out\address: 1
    out\count: 1
    out\after: 0
return: l2_indexed_type(out)

# 0 resolved; 1 another operand; 2 unsupported indexed operand; 3 a numeric
# index of a different declared type. No token outside count is inspected.
fn: l2_indexed_operand (@: LmP0Field first; int: count; int: mi; @: L2IndexedOperand out) int
    @: LmP0Field f l2_next_active(first)
    @: LmP0Field base
    @: LmP0Field slash
    @: LmP0Field index
    @: LmP0Field after
    int: status
    int: ty
    l2_indexed_clear(out)
    if: count < 1 || f = 0 || f\value = 0 || f\value\as = 0
        return: 1
    if: f\value\kind = c.LM_P0_NODE_ATOM && l2_text_eq(f\value\as\atom, "@") != 0
        if: count < 2
            return: 1
        status: l2_indexed_operand(l2_next_active(f\next), count - 1, mi, out)
        if: status != 0
            return: status
        if: out\address != 0
            return: 2
        out\address: 1
        out\count: out\count + 1
        return: l2_indexed_type(out)
    status: l2_indexed_node(f\value, mi, out)
    if: status = 0
        out\after: l2_next_active(f\next)
        return: 0
    if: status != 1
        return: status
    if: count < 4 || f\value\kind != c.LM_P0_NODE_ATOM
        return: 1
    base: f
    out\own: l2_resolved_own(mi, f\value\as\atom)
    out\count: 4
    slash: l2_next_active(f\next)
    if: count >= 6 && slash != 0 && slash\value != 0 && slash\value\kind = c.LM_P0_NODE_ATOM && l2_is_slash(slash\value\as\atom)
        base: l2_next_active(slash\next)
        if: base = 0 || base\value = 0 || base\value\kind != c.LM_P0_NODE_ATOM
            return: 1
        out\own: l2_own_array_root(mi, f\value\as\atom, base\value\as\atom)
        out\count: 6
    ---
    if: out\own < 0 || l2_own_is_array(l2_own_ty[out\own]) = 0
        return: 1
    if: l2_index_tail(base, @ index, @ after) != 0
        return: 1
    out\after: after
    if: count > out\count && after != 0 && after\value != 0 && after\value\kind = c.LM_P0_NODE_ATOM && l2_text_eq(after\value\as\atom, "[") != 0
        return: 2
    if: index\value\kind = c.LM_P0_NODE_ATOM && index\value\as != 0
        if: l2_array_literal(out\own, index\value\as\atom, 0U, index\value\as\atom\length, @ out\literal) = 0
            return: l2_indexed_type(out)
        ---
    if: l2_colon_value_ty(index\value, mi, @ ty) != 0
        return: 2
    if: ty != 2
        if: l2_ty_number(ty) != 0
            return: 3
        return: 2
    out\index: index\value
return: l2_indexed_type(out)

fn: l2_emit_indexed (const: @(L2IndexedOperand operand); int: mi; const: @(char ind); @: L2Tx dest) int
    []: char index_own 64
    L2Tx: index_tx
    @: L2Tx index @ index_tx
    []: char num 32
    []: char value_own 1024
    L2Tx: value_tx
    @: L2Tx value @ value_tx
    []: char backing_own 1024
    L2Tx: backing_tx
    @: L2Tx backing l2_tx_local(@ backing_tx, backing_own, 1024U)
    int: temp
    if: l2_tx_open(value, value_own, 1024U) != 0 || l2_tx_open(index, index_own, 64U) != 0
        return: 1
    if: operand\dynamic >= 0 || operand\index != 0
        if: operand\dynamic >= 0 && l2_own_load(operand\dynamic, value) != 0
            return: 1
        if: operand\index != 0 && l2_prep(operand\index, mi, ind, value) != 0
            return: 1
        temp: l2_tn
        l2_tn: l2_tn + 1
        if: c.fprintf(l2_out, "%ssize_t: l2_t%d %s\n", ind, temp, value\data) < 0 || l2_tx_temp(index, temp) != 0
            return: 1
        ---
    else:
        if: c.snprintf(num, 32U, "%zuU", operand\literal) < 0 || l2_tx_set(index, num) != 0
            return: 1
    ---
    if: operand\address = 0
        return: l2_emit_array_load_at(operand\own, index\data, ind, dest)
    if: l2_emit_array_ptr(operand\own, ind, backing) != 0
        return: 1
return: l2_tx_join(dest, "@ ", backing\data, "[", index\data, "]")

fn: l2_address_operand (@: LmP0Field first; int: count; int: mi; @: L2Address out) int
    @: LmP0Field f l2_next_active(first)
    if: f = 0 || f\value = 0
        return: 2
    if: count = 1
        return: l2_address_node(f\value, mi, out)
    if: count < 2 || f\value\kind != c.LM_P0_NODE_ATOM || f\value\as = 0 || l2_text_eq(f\value\as\atom, "@") = 0
        return: 2
return: l2_address_target(l2_next_active(f\next), count - 1, mi, out)

fn: l2_emit_address (int: mi; const: @(L2Address address); const: @(char ind); @: L2Tx dest) int
    @: char text
    []: char type_text_own 256
    L2Tx: type_text_tx
    @: L2Tx type_text l2_tx_local(@ type_text_tx, type_text_own, 256U)
    []: char declaration_own 256
    L2Tx: declaration_tx
    @: L2Tx declaration l2_tx_local(@ declaration_tx, declaration_own, 256U)
    []: char name 48
    int: kind
    int: status
    int: temp
    if: type_text = 0 || declaration = 0
        return: 1
    if: address\kind = 6
        text: l2_address_path_text(address\target, address\target_count)
        if: text = 0
            return: 1
        status: l2_emit_path(text, strlen(text), mi, ind, l2_next_active(address\target)\value, @ kind)
        l2_xfree(text)
        if: status != 0 || l2_pointer_decl_text(address\type, 0, 0, type_text) != 0
            return: 1
        # A later actual/path reuses l2_pxp. Capture this address now, not
        # when the final call expression is printed after all its actuals.
        temp: l2_tn
        l2_tn: l2_tn + 1
        if: c.snprintf(name, 48U, "l2_t%d", temp) < 0 || l2_pointer_decl_text(address\type, 0, name, declaration) != 0
            return: 1
        if: c.fprintf(l2_out, "%s%s (cast: (%s) l2_pxp[0])\n", ind, declaration\data, type_text\data) < 0
            return: 1
        return: l2_tx_set(dest, name)
    if: address\kind = 1
        return: l2_own_addr(address\index, dest)
    if: address\kind = 2
        if: address\descriptor != 0
            return: l2_tok_formal(mi, address\index, dest)
        if: c.snprintf(name, 48U, "@ l2_p%d_%d", mi, address\index) < 0
            return: 1
        return: l2_tx_set(dest, name)
    if: address\kind = 3
        if: c.snprintf(name, 48U, "@ l2_s%d_%d", mi, address\index) < 0
            return: 1
        return: l2_tx_set(dest, name)
    if: address\kind = 4
        return: l2_tx_wrapn(dest, "@ ", l2_ml_nm[address\index]\data, l2_ml_nm[address\index]\length, 0)
    if: address\kind = 5
        return: l2_type_inst(address\index, dest)
return: 1

fn: l2_check_addr (const: @(LmP0Node node); int: mi; const: @(char path)) int
    @: LmP0Field f
    @: LmP0Field g
    @: LmP0Field h
    L2Address: address_value
    @: L2Address address @ address_value
    L2IndexedOperand: indexed_value
    @: L2IndexedOperand indexed @ indexed_value
    if: l2_indexed_node(node, mi, indexed) = 0
        if: indexed\index != 0
            return: l2_check_expr(indexed\index, mi, path)
        return: 0
    if: l2_address_node(node, mi, address) = 0
        if: address\immutable != 0
            return: l2_error(path, node, "the address of an eternal branch field cannot be taken")
        return: 0
    if: node = 0 || node\as = 0 || node\as\frame = 0 || node\as\frame\body = 0
        return: l2_error(path, node, "incompatible entry signature")
    # @ name \field: the address OF a field. An intrusive list walks with a
    # cursor that points at the next link itself, not at the node holding it.
    if: l2_count_active(node\as\frame\body) = 3
        f: l2_next_active(node\as\frame\body\first_field)
        g: l2_next_active(f\next)
        h: l2_next_active(g\next)
        if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM || g = 0 || g\value = 0 || g\value\kind != c.LM_P0_NODE_ATOM || l2_is_slash(g\value\as\atom) = 0 || h = 0 || h\value = 0 || h\value\kind != c.LM_P0_NODE_ATOM || l2_ident(h\value\as\atom) = 0
            return: l2_error(path, node, "incompatible entry signature")
        if: l2_addr_names_eternal(f, h) != 0
            return: l2_error(path, node, "the address of an eternal branch field cannot be taken")
        return: l2_check_primary(f\value, mi, path)
    if: l2_count_active(node\as\frame\body) != 1
        return: l2_error(path, node, "incompatible entry signature")
    f: l2_next_active(node\as\frame\body\first_field)
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM || l2_ident(f\value\as\atom) = 0
        return: l2_error(path, node, "incompatible entry signature")
    if: l2_address_name(mi, f\value\as\atom, address) = 0
        return: 0
return: l2_error(path, node, "unresolved name")

fn: l2_prep_addr (const: @(LmP0Node node); int: mi; const: @(char ind); @: L2Tx dest) int
    []: char nm_own 1024
    L2Tx: nm_tx
    @: L2Tx nm @ nm_tx
    L2Address: address_value
    @: L2Address address @ address_value
    if: node = 0 || dest = 0 || ind = 0 || node\as = 0 || node\as\frame = 0 || node\as\frame\body = 0
        return: 1
    if: l2_address_node(node, mi, address) = 0
        return: l2_emit_address(mi, address, ind, dest)
    # The remaining established foreign-field expression is checked by C;
    # a graph field has already used its resolved storage contract above.
    if: l2_count_active(node\as\frame\body) = 3
        if: l2_tx_open(nm, nm_own, 1024U) != 0 || l2_emit_fields(l2_next_active(node\as\frame\body\first_field), 3, mi, "", nm) != 0
            return: 1
        if: l2_tx_join(dest, "@ ", nm\data, 0, 0, 0) != 0
            return: l2_alloc_or(l2_src, node, "out of memory")
        return: 0
return: l2_error(l2_src, node, "unresolved addressable name")

# A word of a multi-word C type name in a cast: `unsigned long`, `long long`.
fn: l2_ctype_word (const: @(LmP0Text t)) int
return: l2_text_eq(t, "unsigned") || l2_text_eq(t, "signed") || l2_text_eq(t, "long") || l2_text_eq(t, "short") || l2_text_eq(t, "int") || l2_text_eq(t, "char") || l2_text_eq(t, "double")

# Cast checking and emission project one source type contract. Foreign C types
# remain C ABI types; they do not become an invented numeric literal class.
fn: l2_cast_resolve (const: @(LmP0Node node); @: int out_ty; @: L2Tx dest) int
    @: L2TypeContract contract
    @: LmP0Text word
    @: LmP0Text saved
    @: LmP0Field f
    @: LmP0Field g
    int: depth
    int: qualified
    int: ty
    if: node = 0 || node\as = 0 || out_ty = 0
        return: 1
    contract: l2_contract_type(node)
    if: contract = 0
        # Existing multi-word raw C type syntax is checked by C, not an L2
        # primitive conversion. It has no inferred L2 value type.
        if: node\kind != c.LM_P0_NODE_STRUCTURE || node\as\structure = 0 || l2_count_active(node\as\structure) != 2
            return: 1
        f: l2_next_active(node\as\structure\first_field)
        g: l2_next_active(f\next)
        if: f\value = 0 || g = 0 || g\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM || g\value\kind != c.LM_P0_NODE_ATOM || l2_ctype_word(f\value\as\atom) = 0 || l2_ctype_word(g\value\as\atom) = 0
            return: 1
        \out_ty: -12
        if: dest != 0 && (l2_tx_wrapn(dest, 0, f\value\as\atom\data, f\value\as\atom\length, " ") != 0 || l2_tx_catn(dest, g\value\as\atom\data, g\value\as\atom\length) != 0)
            return: 1
        return: 0
    word: l2_contract_leaf(contract, @ depth, @ qualified)
    if: word = 0
        return: 1
    if: l2_contract_formal(contract, @ ty) != 0
        # A cast is an explicit machine type position. Preserve its existing
        # foreign ABI spelling, including a type supplied by a predef header.
        saved: (cast: (@: LmP0Text) word)
        if: saved = 0 || (l2_c_stmt_door(saved) = 0 && l2_ident(saved) = 0)
            return: 1
        ty: l2_foreign_intern(saved, depth, qualified)
        if: ty < 100
            return: 1
        ---
    \out_ty: ty
    if: dest = 0
        return: 0
    if: l2_pointer_depth(ty) > 0
        return: l2_pointer_decl_text(ty, 0, 0, dest)
    if: ty >= 100
        return: l2_tok_tx(dest, l2_foreign_name[ty - 100])
    if: l2_prim_code_name(ty) = 0
        return: 1
return: l2_tx_set(dest, l2_prim_code_name(ty))

fn: l2_cast_type (const: @(LmP0Node node); @: L2Tx dest) int
    int: ty
return: l2_cast_resolve(node, @ ty, dest)

# True when a names exactly the n bytes at d.
fn: l2_text_is_bytes (const: @(LmP0Text a); const: @(char d); size_t: n) int
    if: a = 0 || a\data = 0 || d = 0 || a\length != n
        return: 0
return: memcmp(a\data, d, n) = 0

# sizeof: operand name bytes. Formals and scalar/array/pointer owns.
# Returns 2 when the name is not lowered here; caller may accept a type or refuse.
fn: l2_sizeof_name_bytes (const: @(LmP0Node node); const: @(char d); size_t: b; size_t: e; int: mi; const: @(char ind); @: L2Tx dest) int
    []: char l2_szt_own 1024
    L2Tx: l2_szt_tx
    @: L2Tx l2_szt l2_tx_local(@ l2_szt_tx, l2_szt_own, 1024U)
    []: char nm 64
    size_t: n 0U
    size_t: i 0U
    int: k 0
    int: oi -1
    int: t 0
    LmP0Text: name
    const: @(char word) 0
    if: d = 0 || dest = 0 || e <= b
        return: 2
    n: e - b
    if: d[b] != 95 && (d[b] < 65 || d[b] > 90) && (d[b] < 97 || d[b] > 122)
        return: 2
    i: b
    while: i < e
        if: d[i] != 95 && (d[i] < 65 || d[i] > 90) && (d[i] < 97 || d[i] > 122) && (d[i] < 48 || d[i] > 57)
            return: 2
        i: i + 1U
    name.data: (cast: (@: char) (d + b))
    name.length: n
    oi: l2_resolved_own(mi, @ name)
    if: oi < 0
        k: l2_param_find(mi, @ name)
        if: k >= 0
            if: c.snprintf(nm, 64U, "c.sizeof(l2_p%d_%d)", mi, k) < 0 || l2_tx_set(dest, nm) != 0
                return: l2_alloc_or(l2_src, node, "out of memory")
            return: 0
        ---
    if: oi < 0
        return: 2
    if: l2_own_is_array(l2_own_ty[oi]) != 0
        if: l2_own_count[oi] = 0
            return: l2_error(l2_src, node, "sizeof: requires a known own array length")
        # The count as it is written, of any length, times the element's size.
        if: l2_own_ty[oi] = 4
            word: " * c.sizeof(c.int))"
        if: l2_own_ty[oi] = 5
            word: " * c.sizeof(c.char))"
        if: l2_own_ty[oi] = 7
            word: " * c.sizeof(c.size_t))"
        if: l2_own_ty[oi] = 8
            word: " * c.sizeof(c.unsigned))"
        if: l2_own_ty[oi] = 37
            word: " * c.sizeof(c.ulong))"
        if: word = 0
            return: l2_error(l2_src, node, "sizeof: of this own array type not yet implemented")
        if: l2_tx_wrapn(dest, "(", l2_own_count[oi]\data, l2_own_count[oi]\length, word) != 0
            return: l2_alloc_or(l2_src, node, "out of memory")
        return: 0
    ---
    if: l2_own_is_pointer(l2_own_ty[oi]) != 0
        if: l2_m_uses[l2_own_off(mi, oi)] != 0
            if: l2_pointer_decl_text(l2_oc_ft(l2_own_ty[oi]), 0, 0, l2_szt) != 0
                return: 1
            if: l2_tx_join(dest, "c.sizeof(", l2_szt\data, ")", 0, 0) != 0
                return: l2_alloc_or(l2_src, node, "out of memory")
            return: 0
        ---
        # Unused pointer own has no generated C local; emit pointer-cell storage size.
        if: l2_tx_set(dest, "c.sizeof(@: void)") != 0
            return: l2_alloc_or(l2_src, node, "out of memory")
        return: 0
    ---
    if: l2_own_ty[oi] != 0 && l2_own_ty[oi] != 1 && l2_own_ty[oi] != 2 && l2_own_ty[oi] != 3 && l2_own_ty[oi] != 36
        return: l2_error(l2_src, node, "sizeof: of this own field type not yet implemented")
    t: l2_tn
    l2_tn: l2_tn + 1
    if: l2_own_ty[oi] = 0 && c.fprintf(l2_out, "%sint: l2_t%d 0\n", ind, t) < 0
        return: 1
    if: l2_own_ty[oi] = 1 && c.fprintf(l2_out, "%schar: l2_t%d 0\n", ind, t) < 0
        return: 1
    if: l2_own_ty[oi] = 2 && c.fprintf(l2_out, "%ssize_t: l2_t%d 0U\n", ind, t) < 0
        return: 1
    if: l2_own_ty[oi] = 3 && c.fprintf(l2_out, "%sunsigned: l2_t%d 0U\n", ind, t) < 0
        return: 1
    if: l2_own_ty[oi] = 36 && c.fprintf(l2_out, "%sulong: l2_t%d 0U\n", ind, t) < 0
        return: 1
    if: c.snprintf(nm, 64U, "c.sizeof(l2_t%d)", t) < 0 || l2_tx_set(dest, nm) != 0
        return: l2_alloc_or(l2_src, node, "out of memory")
return: 0)
# sizeof: receiver-operator (class length/cast): storage size in bytes.
# Not a callable. c.sizeof(...) stays raw C through the c.* door.
fn: l2_emit_sizeof (const: @(LmP0Node node); int: mi; const: @(char ind); @: L2Tx dest) int
    @: LmP0Frame call
    const: @: LmP0Text tn
    @: LmP0Field a0
    int: k
    int: ml
    int: si
    []: char nm 64
    @: LmP0Text at
    if: node = 0 || dest = 0 || node\kind != c.LM_P0_NODE_FRAME || node\as = 0 || node\as\frame = 0
        return: 1
    call: node\as\frame
    if: l2_text_eq(call\head, "sizeof") = 0
        return: 1
    if: call\body = 0 || call\trailer != 0 || call\body\trailer != 0 || l2_count_active(call\body) != 1
        return: l2_error(l2_src, node, "sizeof: requires one operand")
    a0: l2_next_active(call\body\first_field)
    if: a0 = 0 || a0\value = 0
        return: 1
    if: l2_sizeof_is_type(node) != 0
        tn: l2_sizeof_type_frame(a0\value)
        if: tn = 0
            return: l2_error(l2_src, a0\value, "sizeof: a type frame names a primitive type")
        # The frame as it is written, its head (`@`, `@@`, ...) of any depth.
        at: a0\value\as\frame\head
        if: l2_tx_wrapn(dest, "c.sizeof(", at\data, at\length, ": ") != 0 || l2_tx_catn(dest, tn\data, tn\length) != 0 || l2_tx_cat(dest, ")") != 0
            return: l2_alloc_or(l2_src, node, "out of memory")
        return: 0
    ---
    if: a0\value\kind != c.LM_P0_NODE_ATOM || a0\value\as = 0 || a0\value\as\atom = 0
        return: l2_error(l2_src, node, "sizeof: unsupported operand")
    # A type word (a C door's name among them) and the C door's name are written as they stand, into the expression's
    # text, of any length.
    at: a0\value\as\atom
    if: l2_prim_type_word(at) || (at\length > 2U && at\data[0] = 99 && at\data[1] = 46)
        if: l2_tx_wrapn(dest, "c.sizeof(", at\data, at\length, ")") != 0
            return: l2_alloc_or(l2_src, node, "out of memory")
        return: 0
    ---
    k: l2_sizeof_name_bytes(node, at\data, 0U, at\length, mi, ind, dest)
    if: k != 2
        return: k
    ml: l2_ml_find(at)
    if: ml >= 0
        if: l2_tx_wrapn(dest, "c.sizeof(", at\data, at\length, ")") != 0
            return: l2_alloc_or(l2_src, node, "out of memory")
        return: 0
    ---
    si: l2_slot_find(mi, at)
    if: si >= 0
        if: c.snprintf(nm, 64U, "c.sizeof(l2_s%d_%d)", mi, si) < 0 || l2_tx_set(dest, nm) != 0
            return: l2_alloc_or(l2_src, node, "out of memory")
        return: 0
    ---
    if: l2_ns_find(at) >= 0 || l2_site_method(mi, at) >= 0
        if: l2_tx_set(dest, "c.sizeof(@: void)") != 0
            return: l2_alloc_or(l2_src, node, "out of memory")
        return: 0
    ---
return: l2_error(l2_src, node, "unresolved name")

# Operand role is independent of successful type resolution. Scan, deferred
# checking and emission use the same existing sizeof type-frame boundary.
fn: l2_sizeof_is_type (const: @(LmP0Node node)) int
    @: LmP0Field operand
    if: node = 0 || node\kind != c.LM_P0_NODE_FRAME || node\as = 0 || node\as\frame = 0 || l2_frame_head(node, "sizeof") = 0 || node\as\frame\body = 0
        return: 0
    if: l2_count_active(node\as\frame\body) != 1
        return: 0
    operand: l2_next_active(node\as\frame\body\first_field)
    if: operand = 0 || operand\value = 0 || operand\value\kind != c.LM_P0_NODE_FRAME || operand\value\as = 0 || operand\value\as\frame = 0
        return: 0
return: (cast: (int) (l2_address_depth(operand\value\as\frame\head) != 0))

# The type a sizeof: type frame names (`@: T`, `@@: T`): its one atom when that is a primitive type
# word, 0 otherwise.  L1 lowers `c.sizeof(@: T)` to C `sizeof(T *)` for exactly these; any other
# name it reads as an address (`sizeof(&T)`).  Preserve the declared pointer type in sizeof.
fn: l2_sizeof_type_frame (const: @(LmP0Node frame)) const: @: LmP0Text
    @: LmP0Field f
    const: @: LmP0Text t
    if: frame = 0 || frame\kind != c.LM_P0_NODE_FRAME || frame\as = 0 || frame\as\frame = 0 || frame\as\frame\body = 0
        return: 0
    if: l2_count_active(frame\as\frame\body) != 1
        return: 0
    f: l2_next_active(frame\as\frame\body\first_field)
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM || f\value\as = 0
        return: 0
    t: f\value\as\atom
    if: l2_prim_type_word(t) != 0
        return: t
return: 0

fn: l2_check_sizeof (const: @(LmP0Node node); int: mi; const: @(char path)) int
    @: LmP0Frame call
    @: LmP0Field a0
    int: oi
    int: ml
    if: node = 0 || node\kind != c.LM_P0_NODE_FRAME || node\as = 0 || node\as\frame = 0
        return: 1
    call: node\as\frame
    if: l2_text_eq(call\head, "sizeof") = 0
        return: 1
    if: call\body = 0 || call\trailer != 0 || call\body\trailer != 0 || l2_count_active(call\body) != 1
        return: l2_error(path, node, "sizeof: requires one operand")
    a0: l2_next_active(call\body\first_field)
    if: a0 = 0 || a0\value = 0
        return: l2_error(path, node, "sizeof: requires one operand")
    if: l2_sizeof_is_type(node) != 0
        if: l2_sizeof_type_frame(a0\value) = 0
            return: l2_error(path, a0\value, "sizeof: a type frame names a primitive type")
        return: 0
    if: a0\value\kind != c.LM_P0_NODE_ATOM || a0\value\as = 0 || a0\value\as\atom = 0
        return: l2_error(path, node, "sizeof: unsupported operand")
    if: l2_prim_type_word(a0\value\as\atom)
        return: 0
    if: a0\value\as\atom\length > 2U && a0\value\as\atom\data[0] = 99 && a0\value\as\atom\data[1] = 46
        return: 0
    # D-10 (steps/defects.md): l2_own_find and l2_own_find_last differ only
    # in WHICH own-scope match they return when several exist (first vs
    # last); both share the exact same unit-fallback phase, so one finds
    # nothing only where the other does too. This site only asks whether
    # the name resolves at all -- a single try is enough.
    oi: l2_own_visible(mi, a0\value\as\atom)
    if: oi >= 0
        return: 0
    if: l2_param_find(mi, a0\value\as\atom) >= 0
        return: 0
    ml: l2_ml_find(a0\value\as\atom)
    if: ml >= 0
        return: 0
    if: l2_ns_find(a0\value\as\atom) >= 0 || l2_site_method(mi, a0\value\as\atom) >= 0
        return: 0
    if: l2_slot_find(mi, a0\value\as\atom) >= 0
        return: 0
return: l2_error(path, node, "unresolved name")

# Nullary invoke of METHOD idx (unit occurrence or formal occurrence self).
# call_sel 0 = unit method; 2 = callable formal at call_fi. Writes result token to dest.
# Structural METHOD signature equality for callable-formal admission.
fn: l2_cf_set (int: omi; int: fk; int: req) int
    int: i 0
    int: cap
    @: int nomi 0
    @: int nfk 0
    @: int nreq 0
    if: omi < 0 || fk < 0
        return: 1
    while: i < l2_cf_n
        if: l2_cf_omi[i] = omi && l2_cf_fk[i] = fk
            l2_cf_req[i]: req
            return: 0
        i: i + 1
    ---
    if: l2_cf_n >= l2_cf_cap
        cap: l2_cf_cap
        if: cap < 1
            cap: 8
        ---
        while: cap <= l2_cf_n
            if: cap > ((cast: (size_t) -1) / 2U)
                return: 1
            cap: cap * 2
        ---
        nomi: (cast: (@: int) l2_xmalloc((cast: (size_t) cap) * c.sizeof(c.int)))
        nfk: (cast: (@: int) l2_xmalloc((cast: (size_t) cap) * c.sizeof(c.int)))
        nreq: (cast: (@: int) l2_xmalloc((cast: (size_t) cap) * c.sizeof(c.int)))
        if: nomi = 0 || nfk = 0 || nreq = 0
            if: nomi != 0
                l2_xfree((cast: (@: void) nomi))
            ---
            if: nfk != 0
                l2_xfree((cast: (@: void) nfk))
            ---
            if: nreq != 0
                l2_xfree((cast: (@: void) nreq))
            ---
            return: 1
        ---
        if: l2_cf_n > 0
            memcpy((cast: (@: void) nomi), (cast: (@: void) l2_cf_omi), (cast: (size_t) l2_cf_n) * c.sizeof(c.int))
            memcpy((cast: (@: void) nfk), (cast: (@: void) l2_cf_fk), (cast: (size_t) l2_cf_n) * c.sizeof(c.int))
            memcpy((cast: (@: void) nreq), (cast: (@: void) l2_cf_req), (cast: (size_t) l2_cf_n) * c.sizeof(c.int))
        ---
        if: l2_cf_omi != 0
            l2_xfree((cast: (@: void) l2_cf_omi))
        ---
        if: l2_cf_fk != 0
            l2_xfree((cast: (@: void) l2_cf_fk))
        ---
        if: l2_cf_req != 0
            l2_xfree((cast: (@: void) l2_cf_req))
        ---
        l2_cf_omi: nomi
        l2_cf_fk: nfk
        l2_cf_req: nreq
        l2_cf_cap: cap
    ---
    l2_cf_omi[l2_cf_n]: omi
    l2_cf_fk[l2_cf_n]: fk
    l2_cf_req[l2_cf_n]: req
    l2_cf_n: l2_cf_n + 1
return: 0

# The callable occurrence an actual of a callable formal denotes, resolved in the CALLER's lexical
# context (plan K04; steps/callable-actual-projection-20260930.md §"Admission and binding category":
# resolution starts from the actual's binding, not from l2_find_method of an atom).  Two categories so
# far: a unit method -- the occurrence exists in the unit -- and a callable FORMAL of this method,
# whose own occurrence is what its caller handed it and is passed on unchanged (D-106: the resolved
# binding wins over a same-named unit method).  Returns the resolved contract method, -1 when the
# actual is not such an occurrence; out_kind: 1 a unit method's occurrence, 2 a forwarded formal
# (out_fi names it).
fn: l2_cf_actual (int: mi; const: @(LmP0Field a0); int: actual_span; @: int out_kind; @: int out_fi) int
    @: LmP0Text t
    LmP0Text: joined
    []: char jbuf_own 256
    @: char jbuf 0
    size_t: room 0U
    size_t: jn 0U
    int: fi
    int: cand
    \out_kind: 0
    \out_fi: 0 - 1
    t: 0
    if: a0 = 0 || a0\value = 0 || a0\value\as = 0
        return: 0 - 1
    if: actual_span = 1 && a0\value\kind = c.LM_P0_NODE_ATOM && a0\value\as\atom != 0
        t: a0\value\as\atom
    # A nullary Frame is the same occurrence as the bare atom. A Frame with
    # any active field is a call with arguments, not this occurrence.
    if: t = 0 && actual_span = 1 && a0\value\kind = c.LM_P0_NODE_FRAME && a0\value\as\frame != 0
        if: a0\value\as\frame\head = 0 || a0\value\as\frame\body = 0 || l2_count_active(a0\value\as\frame\body) != 0
            return: 0 - 1
        t: a0\value\as\frame\head
    ---
    # Value position splits Holder\other into the atom, the separator, and the
    # field. Joined, that span is the path a frame head already carries whole.
    if: t = 0 && actual_span >= 3
        room: l2_atoms_len((cast: (@: LmP0Field) a0), actual_span) + 1U
        jbuf: l2_text_room(room, jbuf_own, 256U)
        if: jbuf = 0
            return: 0 - 1
        jbuf[0]: 0
        jn: l2_join_path((cast: (@: LmP0Field) a0), actual_span, jbuf, room - 1U)
        if: jn != 0U
            joined.data: (cast: (@: char) jbuf)
            joined.length: jn
            t: @ joined
        ---
    ---
    if: t = 0
        return: 0 - 1
    cand: l2_call_head_method(mi, t, @ fi)
    if: cand < 0
        return: -1
    if: fi >= 0
        \out_kind: 2
        \out_fi: fi
        return: cand
    # A bare method name, or a path whose leaf is a callable field. The field's
    # method is that occurrence, a shared terminal, not a second copy.
    if: cand >= 0
        \out_kind: 1
    return: cand

# K04 S3: the actual of a callable formal that is a held name -- the node the name holds, of the model its
# store statement's method returns -- is handed as it is, as the occurrence a method's name is.  The held own,
# or -1.
fn: l2_cf_held (int: mi; const: @(LmP0Field a0); int: span) int
    int: oi
    if: a0 = 0 || span != 1 || a0\value = 0 || a0\value\kind != c.LM_P0_NODE_ATOM || a0\value\as = 0 || a0\value\as\atom = 0
        return: 0 - 1
    oi: l2_call_head_held(mi, a0\value\as\atom)
    if: oi < 0 || l2_mad_held_model(oi) < 0
        return: 0 - 1
return: oi

# The same resolution, for the native emitter: the occurrence expression of the actual, in the
# caller's code.  A method's name is the occurrence the unit this method reads holds; a path is the
# occurrence the path selects -- its leaf, a copy's own occurrence where the path runs through a copy,
# reached as a path call's head is (l2_emit_path), held in a temporary of its own (COPIED-CALLABLE-ACTUAL;
# l2_rw_callable_actual walked); a forwarded formal is whatever value that formal holds (l2_tok_formal),
# so nothing is invented for it.
fn: l2_cf_actual_emit (int: mi; const: @(LmP0Field a0); int: actual_span; const: @(char ind); @: L2Tx dest) int
    int: kind 0
    int: fi 0 - 1
    int: cand
    int: pk 0
    int: st
    int: t
    []: char nm 32
    @: char ptext 0
    cand: l2_cf_actual(mi, a0, actual_span, @ kind, @ fi)
    if: cand < 0
        # A held name: the node it holds.  In a method the name is a hidden input (Q52).
        fi: l2_cf_held(mi, a0, actual_span)
        if: fi < 0
            return: 1
        if: l2_param_find(mi, l2_own_name[fi]) >= 0
            return: l2_tok_formal(mi, l2_param_find(mi, l2_own_name[fi]), dest)
        return: l2_own_load(fi, dest)
    ---
    if: kind = 2
        return: l2_tok_formal(mi, fi, dest)
    if: actual_span >= 3
        ptext: l2_address_path_text((cast: (@: LmP0Field) a0), actual_span)
    if: actual_span = 1 && a0\value\kind = c.LM_P0_NODE_FRAME && a0\value\as\frame\head != 0 && l2_seg_count(a0\value\as\frame\head\data, a0\value\as\frame\head\length) >= 2
        ptext: (cast: (@: char) l2_xmalloc(a0\value\as\frame\head\length + 1U))
        if: ptext = 0
            return: l2_error(l2_src, a0\value, "out of memory")
        memcpy((cast: (@: void) ptext), (cast: (@: void) a0\value\as\frame\head\data), a0\value\as\frame\head\length)
        ptext[a0\value\as\frame\head\length]: 0
    ---
    if: ptext != 0
        st: l2_emit_path(ptext, strlen(ptext), mi, ind, a0\value, @ pk)
        l2_xfree((cast: (@: void) ptext))
        if: st != 0
            return: 1
        t: l2_tn
        l2_tn: l2_tn + 1
        if: c.fprintf(l2_out, "%s@: Lmx l2_ca%d l2_pst\n", ind, t) < 0 || c.snprintf(nm, 32U, "l2_ca%d", t) < 0
            return: 1
        return: l2_tx_set(dest, nm)
    ---
return: l2_tok_method_occ(cand, dest)

# A no-result unit-method occurrence supplied where a reference is received.
# Kind 2 is a forwarded formal: its value is not this method's own fields.
# A returning callable stays a call; its result is a different value.
fn: l2_occ_actual (int: mi; const: @(LmP0Field a0); int: span) int
    int: kind 0
    int: fi 0 - 1
    int: cand
    cand: l2_cf_actual(mi, a0, span, @ kind, @ fi)
    if: cand < 0 || kind != 1
        return: 0 - 1
    if: l2_m_ret[cand] != 8
        return: 0 - 1
return: cand

# Register the occurrence against the formal's model with the pair map built
# from the occurrence's own fields. The callee reads through that map.
fn: l2_emit_occ_admit (int: mi; int: req; int: cand; const: @(char value); const: @(char ind)) int
    int: p
    []: char rinst_own 320
    L2Tx: rinst_tx
    @: L2Tx rinst l2_tx_local(@ rinst_tx, rinst_own, 320U)
    []: char table 160
    # cand is the selected occurrence's existing schema. -1 alone is absent.
    if: req < 0 || cand = -1 || value = 0 || ind = 0
        return: 1
    if: l2_model_inst(mi, req, ind, rinst) != 0
        return: 1
    p: l2_d105_pair(cand, req)
    if: p < 0 || l2_d105_tnode(p, table) != 0
        return: 1
    if: c.fprintf(l2_out, "%sif: lmx_implements_register_map(l2_program_arena, (cast: (@: Lmx) %s), %s, %s, %uU, 0) != c.LMX_IMPLEMENTS_YES\n%s    c.fprintf(c.stderr, \"lmx: invariant: an occurrence was not admitted to its formal\\n\")\n%s    c.abort()\n", ind, value, rinst\data, table, (cast: (unsigned) l2_d105_width(req)), ind, ind) < 0
        return: 1
return: 0

# K09: a table of the flow grows by doubling; nothing about a program is counted against a fixed size.
fn: l2_cap_next (int: cap; int: need) int
    int: n cap
    if: n < 16
        n: 16
    while: n < need
        if: n > c.INT_MAX / 2
            return: 0 - 1
        n: n * 2
    ---
return: n

# `used` entries of `esz` bytes carried into a block of `cap` entries; the old block is freed.  0 and the old
# block kept when there is no memory.
fn: l2_vec_grow (@: void old; int: used; int: cap; size_t: esz) @: void
    @: void made
    if: cap <= 0 || used < 0 || used > cap || l2_mul_ok((cast: (size_t) cap), esz) = 0
        l2_alloc_err: 2
        return: 0
    l2_alloc_kind: 5
    made: l2_xmalloc((cast: (size_t) cap) * esz)
    if: made = 0
        return: 0
    if: used > 0 && old != 0
        memcpy(made, old, (cast: (size_t) used) * esz)
    if: old != 0
        l2_xfree(old)
return: made

fn: l2_cfl_reserve () int
    int: cap
    size_t: isz
    size_t: psz
    @: void p
    if: l2_cfl_n < l2_cfl_cap
        return: 0
    cap: l2_cap_next(l2_cfl_cap, l2_cfl_n + 1)
    if: cap < 0
        l2_alloc_err: 2
        return: 1
    isz: c.sizeof(c.int)
    psz: c.sizeof(@: char)
    p: l2_vec_grow((cast: (@: void) l2_cfl_callee), l2_cfl_n, cap, isz)
    if: p = 0
        return: 1
    l2_cfl_callee: (cast: (@: int) p)
    p: l2_vec_grow((cast: (@: void) l2_cfl_via), l2_cfl_n, cap, isz)
    if: p = 0
        return: 1
    l2_cfl_via: (cast: (@: int) p)
    p: l2_vec_grow((cast: (@: void) l2_cfl_via_fi), l2_cfl_n, cap, isz)
    if: p = 0
        return: 1
    l2_cfl_via_fi: (cast: (@: int) p)
    p: l2_vec_grow((cast: (@: void) l2_cfl_t), l2_cfl_n, cap, isz)
    if: p = 0
        return: 1
    l2_cfl_t: (cast: (@: int) p)
    p: l2_vec_grow((cast: (@: void) l2_cfl_kind), l2_cfl_n, cap, isz)
    if: p = 0
        return: 1
    l2_cfl_kind: (cast: (@: int) p)
    p: l2_vec_grow((cast: (@: void) l2_cfl_a), l2_cfl_n, cap, isz)
    if: p = 0
        return: 1
    l2_cfl_a: (cast: (@: int) p)
    p: l2_vec_grow((cast: (@: void) l2_cfl_a_fi), l2_cfl_n, cap, isz)
    if: p = 0
        return: 1
    l2_cfl_a_fi: (cast: (@: int) p)
    p: l2_vec_grow((cast: (@: void) l2_cfl_node), l2_cfl_n, cap, psz)
    if: p = 0
        return: 1
    l2_cfl_node: (cast: (@@: LmP0Node) p)
    l2_cfl_cap: cap
return: 0

fn: l2_cfr_reserve () int
    int: cap
