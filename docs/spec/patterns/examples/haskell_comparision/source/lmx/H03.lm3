Addition:
    int: first
    int: second
    return: int
    add:
        return: first + second

ClosureProbe:
    return: int
    run:
        throws: copy(partial\throws)
        @: add5 partial(Addition\add; (5))
        @: add100 partial(Addition\add; (100))
        int: saved 1000
        return: add5(1) * 1000000 + add100(1) * 1000 + add5(1)
