fn: lm_compiler_os_branch_for (int: mask; int: target) int
    if: mask = 0
        return: (cast: (int) (0))
    if: target = 1 && (mask = 1 || mask = 3)
        return: (cast: (int) (1))
    if: mask = 2 || mask = 3
        return: (cast: (int) (2))
    return: (cast: (int) (3))
end: lm_compiler_os_branch_for

fn: lm_compiler_os_root_branches (const: (@: root c.LmP0Node)) int
    @: field c.LmP0Field
    @: b c.LmP0Field
    int: wins 0
    int: defaults 0
    if: root = 0 || root\kind != c.LM_P0_NODE_STRUCTURE || root\as = 0 || root\as\structure = 0
        return: (cast: (int) (0))
    field: lm_compiler_next_active((cast: (@: c.LmP0Field) root\as\structure\first_field))
    while: field != 0 && lm_compiler_text_eq(lm_compiler_app_head((cast: (const: @: c.LmP0Node) field\value)), "os") = 0
        field: lm_compiler_next_active((cast: (@: c.LmP0Field) field\next))
    ---
    if: field = 0
        return: (cast: (int) (0))
    if: field\value != 0 && field\value\kind = c.LM_P0_NODE_FRAME && field\value\as != 0 && field\value\as\frame != 0 && field\value\as\frame\body != 0
        b: lm_compiler_next_active((cast: (@: c.LmP0Field) field\value\as\frame\body\first_field))
        while: b != 0
            if: lm_compiler_frame_head((cast: (const: @: c.LmP0Node) b\value), "win") != 0
                wins: 1
            if: lm_compiler_frame_head((cast: (const: @: c.LmP0Node) b\value), "default") != 0
                defaults: 2
            b: lm_compiler_next_active((cast: (@: c.LmP0Field) b\next))
        ---
    ---
    if: wins + defaults = 0
        return: (cast: (int) (1))
    return: (cast: (int) (wins + defaults))
