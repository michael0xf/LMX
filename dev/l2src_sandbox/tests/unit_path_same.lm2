# Paths to number fields of one type beside other operands: P's size_t v, the unit's k through `node`, and a method's
# own named Structure's w are each a value of their field's type -- `P\v + j`, `node\k + j`, `S\w + j`, and the
# condition `node\k = j + 2U` (all size_t).  2 + 2 + 3: Entry 7.
size_t: k 2U
P:
    size_t: v 2U
fn: m () size_t
    size_t: j 0U
    S:
        size_t: w 3U
    size_t: r 0U
    r: P\v + j
    r: r + node\k + j
    r: r + S\w + j
    if: node\k = j + 2U
        r: r + 0U
    return: r
end: m
size_t: out 0U
out: m()
int: code 0
if: out = 7U
    code: 7
sendMessage: exit(exit_code: code; stdout: ""; stderr: "")
return
