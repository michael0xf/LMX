+# Keep the CURRENT resolved source route in convergence, not an allocation
+# address or only the final schema. Equal leaf Models may still select
+# different formals, declaring fields, index contracts or projection maps.
+fn: l2_source_plan_path (@: L2Tx out; const: @(L2PathFact fact)) int
+    const: @: L2Path path
+    const: @: L2PathStep step
+    int: i 0
+    []: char text 192
+    if: fact = 0
+        return: l2_tx_cat(out, "P0\n")
+    path: @ fact\resolved
+    if: l2_source_plan_numbers(out, "P", fact\method, fact\source_method, fact\stage, path\root_kind, path\root, path\model_input) != 0 || l2_source_plan_numbers(out, "p", path\ni, path\res, path\oi, path\fi, path\n, path\indexed) != 0 || l2_source_plan_numbers(out, "l", path\leaf_kind, path\leaf_mi, path\leaf_model, path\leaf_ty, path\array_leaf, path\ref_follow) != 0 || l2_source_plan_numbers(out, "f", path\fail_seg, path\fail_why, path\names, path\run_count, path\names_run, path\in_eternal) != 0 || l2_source_plan_contract(out, path\leaf_level) != 0
+        return: 1
+    if: path\n < 0 || (path\n > 0 && path\steps = 0)
+        return: 1
+    while: i < path\n
+        step: path\steps + i
+        if: l2_source_plan_numbers(out, "t", step\locus, step\kind, step\row, step\nsrow, step\own, step\ns) != 0 || l2_source_plan_numbers(out, "u", step\formal, step\node_host, step\ent, step\pointee, step\view_model, step\model_context) != 0 || l2_source_plan_numbers(out, "w", step\host_ns, step\host_res, step\host_bm, step\host_bh, step\host_part, step\cell_ft) != 0 || l2_source_plan_numbers(out, "x", step\model_step, step\model_input, step\segocc, step\elem_ty, step\elem_model, (step\index.count)) != 0
+            return: 1
+        if: c.snprintf(text, 192U, "i%p:%p:%zu:%zu\n", (cast: (@: void) step\node_scope), (cast: (@: void) step\index.node), step\off, step\len) < 0 || l2_tx_cat(out, text) != 0 || l2_source_plan_contract(out, step\level) != 0
+            return: 1
+        i: i + 1
+    ---
+return: 0
+
