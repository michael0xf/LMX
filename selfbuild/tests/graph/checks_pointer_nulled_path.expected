---
    Observed:
        int: seen 1
        @: p 0
        @: q int
    end: Observed
---
sub: main () (
    A:
        int: v 1
    end: A
    int: x 5
)
    @: shared (node [] 0)
    :=: ((shared \ Observed) \ p) A
    :=: ((shared \ Observed) \ p) 0
    :=: ((shared \ Observed) \ q) (@ x)
    :=: ((shared \ Observed) \ q) 0
    :=: ((shared \ Observed) \ seen) 1
end: main
main:
