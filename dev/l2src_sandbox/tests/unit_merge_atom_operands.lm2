# K03d: the same spelling with SEVERAL operands (`R: merge Model B C`), the atom twin of
# unit_merge_added_repeat.  The operands after the receiver are the merge's operands in source order:
# B adds z, C's z goes INTO the slot B added, so R is {x, z} = {1, 3} -- two slots, not three, and
# `R\[0]z` is C's 3.  Success is 4 (= x + z).
Model:
    size_t: x 1U
end: Model

B:
    size_t: z 2U
end: B

C:
    size_t: z 3U
end: C

fn: m () int
    size_t: x
    size_t: z
    size_t: z0
    R: merge Model B C
    x: R\x
    z: R\z
    z0: R\[0]z
    if: x != 1U
        return: 81
    if: z != 3U
        return: 82
    if: z0 != 3U
        return: 83
    return: (cast: (int) (x + z))
end: m

sendMessage: exit(exit_code: m(); stdout: ""; stderr: "")
return
