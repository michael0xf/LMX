TopoProcedural:
    return: int
    run:
        throws: copy(TopoCount\run\throws) copy(TopoEnqueue\run\throws) copy(TopoRemove\run\throws)
        int: i 0
        while: i < n
            @: row graph[i]
            int: j 0
            while: j < length(row)
                TopoCount\run(0; row[j])
                j += 1
            i += 1
        ---
        i := 0
        while: i < n
            TopoEnqueue\run(i)
            i += 1
        ---
        while: head < tail
            @: row graph[queue[head]]
            head += 1
            int: j 0
            while: j < length(row)
                tail := TopoRemove\run(tail; row[j])
                j += 1
        ---
        return: 0
