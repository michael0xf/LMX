fn: lm_compiler_type_model (const: (@: word c.LmP0Text)) int
    @: own_excl_cell int (cast: (@: int) (@ c.l2_own_excl))
    @: here_mi_cell int (cast: (@: int) (@ c.l2_here_mi))
    @@: here_node_cell c.LmP0Node (cast: (@@: c.LmP0Node) (@ c.l2_here_node))
    @@: own_mi_cell int (cast: (@@: int) (@ c.l2_own_mi))
    int: own
    int: excluded own_excl_cell[0]
    if: here_mi_cell[0] >= 0
        # A declaration's receiving type is read before that declaration binds,
        # just like its candidate. Preserve an enclosing initializer exclusion.
        own: c.lm_compiler_own_find_decl(here_mi_cell[0], word, here_node_cell[0])
        if: own >= 0
            own_excl_cell[0]: own
        own: c.lm_compiler_resolved_own(here_mi_cell[0], word)
        own_excl_cell[0]: excluded
        if: own >= 0 && own_mi_cell[0][own] = here_mi_cell[0]
            return: (cast: (int) (lm_compiler_own_layout(own)))
        if: c.lm_compiler_param_find(here_mi_cell[0], word) >= 0
            return: (cast: (int) (-1))
    ---
    return: (cast: (int) (lm_compiler_ns_find(word)))
end: lm_compiler_type_model

fn: lm_compiler_contract_model (@: contract c.L2TypeContract; int: signature) int
    return: (cast: (int) (lm_compiler_contract_model_depth(contract, signature, 0)))
end: lm_compiler_contract_model

fn: lm_compiler_contract_model_depth (@: contract c.L2TypeContract; int: signature; int: indirect) int
    @: word c.LmP0Text
    int: depth
    int: qualified
    word: c.lm_compiler_contract_leaf(contract, @ depth, @ qualified)
    if: indirect < 0 || depth < indirect
        return: (cast: (int) (-1))
    depth: depth - indirect
    if: word = 0 || (depth != 1 && (signature = 0 || depth != 0))
        return: (cast: (int) (0 - 1))
    return: (cast: (int) (lm_compiler_contract_model_word(contract, word)))
end: lm_compiler_contract_model_depth

fn: lm_compiler_contract_element_ty (@: element c.L2TypeContract; @: out_ty int) int
