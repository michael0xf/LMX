predef: "l2src/lmx_interp.h.lm1"
predef: "l2src/lmx_walk.lm1"
predef: "l2src/lmx_call.lm1"

# L3 graph entry: recognises a callable, then one walk activation.
# Never METHOD.addr. Body nodes are walk roles (physical refs), not L3_NODE tags.

fn: lmx_interp_callable (@: LmxArena arena; @: Lmx node) int
return: lmx_call_ready(arena, node)

fn: lmx_interp_method (@: LmxArena arena; @: Lmx node) @: LmxMethod
return: lmx_call_method(arena, node)

fn: lmx_interp_map (int: st) int
    if: st = c.LMX_WALK_OK
        return: c.LMX_INTERP_OK
    if: st = c.LMX_WALK_NO_GRAPH
        return: c.LMX_INTERP_NO_GRAPH
    if: st = c.LMX_WALK_UNSUPPORTED
        return: c.LMX_INTERP_INVALID
    if: st = c.LMX_WALK_INVALID || st = c.LMX_WALK_CHECKPOINT || st = c.LMX_WALK_NOMEM
        return: c.LMX_INTERP_INVALID
return: c.LMX_INTERP_INVALID

fn: lmx_interp_apply (@: LmxWalkContext context; @: Lmx node; @@: void args; size_t: nargs) int
    int: st
    if: context = 0 || node = 0 || context\arena = 0
        return: c.LMX_INTERP_INVALID
    if: lmx_interp_callable(context\arena, node) != c.LMX_CALL_OK
        return: c.LMX_INTERP_INVALID
    if: lmx_call_callable(context\arena, node) = 0
        return: c.LMX_INTERP_INVALID
    st: lmx_walk_prepare(context, context\arena, context\plan_roles, node)
    if: st != c.LMX_WALK_OK
        return: lmx_interp_map(st)
return: lmx_interp_map(lmx_walk_run(context, node, args, nargs, 0))

fn: lmx_interp_run (@: LmxWalkContext context; @: Lmx node) int
return: lmx_interp_apply(context, node, 0, 0U)
