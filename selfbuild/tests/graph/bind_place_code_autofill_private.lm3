# A private receiving code place takes no autofill (R05, §6.1 item 4; Р114): x has no value, the read
# refuses 5.
(
    Observed:
        int: seen 0
)
fn: work () int
    private: int: x
    return: x
fn: caller () int
    int: x 7
    return: work()
sub: main ()
    @: shared node[0]
    shared\Observed\seen := caller()
main()
