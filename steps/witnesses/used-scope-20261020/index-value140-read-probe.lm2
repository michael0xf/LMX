fn: indexRead (@@: p void; int: index) @: void
    return: p[index]
end: indexRead
fn: indexReadTwice (@@@: p void; int: first; int: second) @: void
    return: p[first][second]
end: indexReadTwice
fn: scalarRead (@: p int; int: index) int
    return: p[index]
end: scalarRead
fn: deepRead (@@@@@@@: p void; int: index) @: void
    return: p[0][0][0][0][0][index]
end: deepRead
return
