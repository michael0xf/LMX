# Consumer = the declared type: every declared field is used.  The argv letter
# has mainArgs only, so a type that also declares `size` refuses it.
LongLetter:
    char: []: []: mainArgs
    size_t: size 0U
end: LongLetter

LongLetter: m
receiveMessage: m
sendMessage: exit(exit_code: 0; stdout: ""; stderr: "")
return
