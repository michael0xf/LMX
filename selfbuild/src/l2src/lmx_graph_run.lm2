# The interpreter of the clean graph (docs/kernel-implementation.ru.md §6; slice 309, the vertical slice of §11 item 0):
# it walks the statements of a root in field order and recognizes everything by addresses -- a word by the canonical
# address of its spelling (the words of the language are the state's, §6.2), a place by the region of the address a slot
# holds (§2.2), a name by the address -> name table of the arena (§5.1). Written names resolve against this traversal's
# activation and current lexical slots (§3.5, §5.2); no binding survives the traversal. Each expression operation is an
# ordinary Lmx of operand/operator/operand, or prefix/operand, nested by construction (§3.3). This consumer performs no
# precedence parsing and keeps no prepared expression representation. A write of a place is the
# kernel's one write (lmx_graph_assign_int): every assignment writes into the same cell, through the address-typed
# internal indirection when present. That indirection does not make the language place a reference.
#
# Statements of this slice: `name: expression` (a write of the int place named name) and `int: name expression` (a
# declaration with a computed initializer: the published value replaces the statement in its slot, §3.4). A Frame is
# the Lmx of its arguments named by its head (§3.3; the author 2026-11-09): its head is the name of that Lmx, its
# arguments are its fields from the first. A declaration of fn or sub stays in the graph as written; each traversal
# applies the receiver and creates, in its own initially clean namespace, the Structure named by the declaration's name
# argument with the parts args, return, var, body (lmx_graph_space_open, lmx_graph_fn_make).
# An omitted initializer promises no initial value; the kernel does not maintain a changing initialized state.
#
# A machine module (L2 section 20); the build writes its header, lmx_graph_run.h.lm1, from the exports named in
# bld_kernel_l2 (tools/build.lm2).
predef: "l2src/lmx_arena.h.lm1"
predef: "l2src/lmx_graph.h.lm1"
predef: "l2src/lmx_call.h.lm1"
predef: "l2src/lmx_graph_copy_owned.h.lm1"
predef: "l2src/lmx_pool.h.lm1"
predef: "l2src/lmx_arena_refs.h.lm1"
predef: "l2src/lmx_value_owned.h.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdlib.h>"
include: "<stdio.h>"
include: "<string.h>"

# The working cache belongs to one active traversal. Its rows refer to real own cells; numbers and dirty marks
# disappear on return. No cache or binding is stored in the Lmx graph.
fn: lmx_graph_work_row (@: frame c.LmxGraphFrame; @: name char) @: c.LmxGraphWork
    size_t: i 0U
    @: rows c.LmxGraphWork 0
    @: row c.LmxGraphWork 0
    if: frame = 0 || name = 0
        return: 0
    rows: frame\rows
    while: i < frame\count
        row: rows + i
        if: row\name = name
            return: row
        i: i + 1U
    ---
    return: 0
end: lmx_graph_work_row

fn: lmx_graph_work_load (@: g c.LmxGraph; @: row c.LmxGraphWork) int
    if: row = 0
        return: 3
    if: row\slot = (cast: (size_t) -1)
        return: 0
    if: (row\loaded & 1) = 0
        if: c.lmx_graph_value_int(g, row\cell, @ row\number) != 0
            return: 4
        row\loaded: row\loaded | 1
    return: 0
end: lmx_graph_work_load

# The field of data named name for a call: its place of that name, else its first field of that name (a named
# Structure); a Frame of a statement named by its head -- `x: x + 2` beside `int: x 4` -- is no second field. The count
# of its slots when none is.
fn: lmx_graph_data_slot (@: g c.LmxGraph; @: data c.Lmx; @: name char) size_t
    size_t: slot lmx_graph_place_slot(g, data, name)
    if: slot < c.lmx_graph_count(data)
        return: slot
    return: c.lmx_graph_named(g, data, name)
end: lmx_graph_data_slot

# Is a place named name in data after slot (two fields of one name are inadmissible as data)? 1 or 0.
fn: lmx_graph_data_twice (@: g c.LmxGraph; @: data c.Lmx; size_t: slot; @: name char) int
    size_t: i slot + 1U
    int: kind 0
    while: i < c.lmx_graph_count(data)
        kind: c.lmx_graph_kind(g, c.lmx_graph_get(data, i))
        if: (kind = 1 || kind = 3 || kind = 5 || kind = 6) && c.lmx_graph_slot_name(g, data, i) = name
            return: 1
        i: i + 1U
    ---
    return: 0
end: lmx_graph_data_twice

# Capture a directly consumed free input at entry. An int gets its own argument cell; a Structure/reference keeps
# its language reference value. The row lives only in this activation and does not become a field of var.
fn: lmx_graph_work_capture (@: g c.LmxGraph; @: frame c.LmxGraphFrame; @: name char) int
    @: args c.Lmx 0
    @: value void 0
    @: rows c.LmxGraphWork 0
    @: row c.LmxGraphWork 0
    size_t: capacity 0U
    int: kind 0
    int: number 0
    int: status 0
    size_t: slot 0U
    if: c.lmx_graph_method(g, (cast: (@: c.Lmx) frame\code)) != 0
        args: c.lmx_graph_method_args(g, (cast: (@: c.Lmx) frame\code))
    if: name = 0 || c.lmx_graph_formal(g, args, name) < c.lmx_graph_count(args)
        return: 0
    row: lmx_graph_work_row(frame, name)
    if: row != 0
        if: row\cell = 0 && frame\data != c.lmx_graph_method_var(g, (cast: (@: c.Lmx) frame\code))
            return: 3
        return: 0
    # An ordinary code/data call admits only directly used data fields, independent of their physical order.
    if: args = 0
        slot: lmx_graph_data_slot(g, (cast: (@: c.Lmx) frame\data), name)
        if: slot < c.lmx_graph_count(frame\data)
            return: lmx_graph_work_require(g, frame, name)
        ---
    ---
    value: lmx_graph_resolve(g, (cast: (@: c.Lmx) frame\code), name)
    if: value = 0
        return: 3
    kind: c.lmx_graph_kind(g, value)
    if: kind = 1 || kind = 3
        status: lmx_graph_named_int(g, (cast: (@: c.Lmx) frame\code), name, @ number)
        if: status != 0
            return: status
        value: c.lmx_graph_int(g, number)
        if: value = 0
            return: 4
        ---
    ---
    if: frame\count = frame\capacity
        capacity: (cast: (size_t) frame\capacity) * 2U + 8U
        rows: (cast: (@: c.LmxGraphWork) c.realloc((cast: (@: void) frame\rows), capacity * c.sizeof(c.LmxGraphWork)))
        if: rows = 0
            return: 4
        frame\rows: rows
        frame\capacity: capacity
    ---
    rows: frame\rows
    row: rows + (cast: (size_t) frame\count)
    c.memset((cast: (@: void) row), 0, c.sizeof(c.LmxGraphWork))
    row\name: name
    row\cell: value
    row\slot: (cast: (size_t) -1)
    frame\count: frame\count + 1U
    return: 0
end: lmx_graph_work_capture

# Bind a required int place to its actual data slot, by canonical name. No data is allocated or extended.
# Duplicate bare names are inadmissible. This map belongs only to the current activation.
fn: lmx_graph_work_require (@: g c.LmxGraph; @: frame c.LmxGraphFrame; @: name char) int
    @: rows c.LmxGraphWork frame\rows
    @: row c.LmxGraphWork lmx_graph_work_row(frame, name)
    size_t: slot lmx_graph_data_slot(g, (cast: (@: c.Lmx) frame\data), name)
    size_t: capacity 0U
    @: cell void 0
    if: name = 0
        return: 3
    if: row != 0
        if: row\slot = (cast: (size_t) -1)
            return: 3
        if: row\cell != 0 || frame\data = c.lmx_graph_method_var(g, (cast: (@: c.Lmx) frame\code))
            return: 0
        return: 3
    if: slot >= c.lmx_graph_count(frame\data) || lmx_graph_data_twice(g, (cast: (@: c.Lmx) frame\data), slot, name) != 0
        return: 3
    cell: c.lmx_graph_place_cell(g, frame\data, slot)
    if: c.lmx_graph_kind(g, cell) != 1
        return: 4
    if: frame\count = frame\capacity
        capacity: (cast: (size_t) frame\capacity) * 2U + 8U
        rows: (cast: (@: c.LmxGraphWork) c.realloc((cast: (@: void) rows), capacity * c.sizeof(c.LmxGraphWork)))
        if: rows = 0
            return: 4
        frame\rows: rows
        frame\capacity: capacity
    ---
    row: rows + (cast: (size_t) frame\count)
    c.memset((cast: (@: void) row), 0, c.sizeof(c.LmxGraphWork))
    row\name: name
    row\slot: slot
    row\cell: cell
    frame\count: frame\count + 1U
    return: 0
end: lmx_graph_work_require

# One body traversal captures free inputs and records needed own loads. After var, loading iterates only rows,
# never the body again. Nested methods are not scanned, and a selector is not an input; no transitive interface.
fn: lmx_graph_work_scan (@: g c.LmxGraph; @: frame c.LmxGraphFrame; @: body c.Lmx) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @@: queue c.Lmx 0
    size_t: count 0U
    size_t: cap 0U
    size_t: at 0U
    size_t: i 0U
    size_t: n 0U
    size_t: first 0U
    @: current c.Lmx 0
    @: raw void 0
    @: word char 0
    @: op char 0
    @: lead char 0
    @: row c.LmxGraphWork 0
    int: framed 0
    int: status c.lmx_graph_scan_add(@ queue, @ count, @ cap, body)
    while: at < count && status = 0
        current: queue[at]
        at: at + 1U
        if: c.lmx_graph_method(g, current) != 0
            continue
        n: c.lmx_graph_count(current)
        lead: c.lmx_graph_name_of(g, (cast: (@: void) current))
        # A Frame is its head and its arguments; the scanned body itself is its statements. Nested declarations and the
        # var part (data, its initializers run where they are written) are not scanned.
        framed: (cast: (int) (lead != 0 && current != body))
        if: framed != 0 && (lead = state\w_fn || lead = state\w_sub || lead = state\w_fm || lead = state\w_var)
            continue
        first: 0U
        if: framed != 0
            word: lead
            op: 0
            if: n != 0U
                op: c.lmx_graph_word_text(g, c.lmx_graph_get(current, 0U))
            ---
        else:
            word: c.lmx_graph_word_text(g, c.lmx_graph_get(current, 0U))
            op: c.lmx_graph_word_text(g, c.lmx_graph_get(current, 1U))
            lead: word
        ---
        if: framed = 0 && n = 2U && word = state\w_at
            raw: c.lmx_graph_get(current, 1U)
            while: c.lmx_graph_kind(g, raw) = 4 && c.lmx_graph_count((cast: (@: c.Lmx) raw)) = 1U && c.lmx_graph_name_of(g, raw) = 0
                raw: c.lmx_graph_get((cast: (@: c.Lmx) raw), 0U)
            word: c.lmx_graph_word_text(g, raw)
            if: word != 0
                status: lmx_graph_work_capture(g, frame, word)
                continue
            ---
        ---
        i: 0U
        if: framed != 0 && word = state\w_int
            word: c.lmx_graph_word_text(g, c.lmx_graph_get(current, 0U))
            if: c.lmx_graph_method(g, (cast: (@: c.Lmx) frame\code)) = 0
                status: lmx_graph_work_require(g, frame, word)
            else:
                status: lmx_graph_work_capture(g, frame, word)
            ---
            i: 1U
        else:
            # The head of a Frame names a place or a callable of this code: a free input, never a load by itself.
            if: framed != 0 && lmx_graph_language_word(state, word) = 0
                status: lmx_graph_work_capture(g, frame, word)
            ---
        ---
        while: i < n && status = 0
            if: framed = 0 && n = 3U && op = state\w_deref && i = 2U
                i: i + 1U
                continue
            raw: c.lmx_graph_get(current, i)
            # A named actual selects the callee's formal, never a free input of this caller.
            if: framed != 0 && c.lmx_graph_kind(g, raw) = 4 && c.lmx_graph_name_of(g, raw) = 0 && c.lmx_graph_word_text(g, c.lmx_graph_get((cast: (@: c.Lmx) raw), 0U)) = state\w_assign
                if: c.lmx_graph_method(g, (cast: (@: c.Lmx) c.lmx_graph_target(g, lmx_graph_resolve(g, (cast: (@: c.Lmx) frame\code), lead)))) != 0
                    if: c.lmx_graph_count((cast: (@: c.Lmx) raw)) != 3U
                        status: 5
                        break
                    raw: c.lmx_graph_get((cast: (@: c.Lmx) raw), 2U)
                ---
            ---
            # The written fields of an anonymous Structure operand of merge define their names; only their values are
            # read (lmx_graph_merge_literal, lmx_graph_work_scan_literal).
            if: framed != 0 && lead = state\w_merge && lmx_graph_merge_literal(g, (cast: (@: c.Lmx) frame\code), raw) != 0
                status: lmx_graph_work_scan_literal(g, frame, (cast: (@: c.Lmx) raw), @ queue, @ count, @ cap)
                i: i + 1U
                continue
            ---
            # A place of the body or of a control body in it (`int: absent 8` under if) is a declaration of this code:
            # ordinary code requires it of its data, a callable has it in its var.
            if: framed = 0 && (c.lmx_graph_kind(g, raw) = 1 || c.lmx_graph_kind(g, raw) = 3)
                word: c.lmx_graph_slot_name(g, current, i)
                if: word != 0
                    if: c.lmx_graph_method(g, (cast: (@: c.Lmx) frame\code)) = 0
                        status: lmx_graph_work_require(g, frame, word)
                    else:
                        status: lmx_graph_work_capture(g, frame, word)
                    ---
                    i: i + 1U
                    continue
                ---
            ---
            if: c.lmx_graph_kind(g, raw) = 4
                status: c.lmx_graph_scan_add(@ queue, @ count, @ cap, (cast: (@: c.Lmx) raw))
            else:
                word: c.lmx_graph_word_text(g, raw)
                if: word != 0 && lmx_graph_language_word(state, word) = 0
                    status: lmx_graph_work_capture(g, frame, word)
                    if: status = 0
                        row: lmx_graph_work_row(frame, word)
                        # Every word argument of a Frame is read; in an expression the left operand of `:=` is written,
                        # and the first field is read when it is an operand.
                        if: row != 0 && row\slot != (cast: (size_t) -1) && (framed != 0 || ((i != 1U || c.lmx_graph_word_text(g, c.lmx_graph_get(current, 0U)) != state\w_assign) && (i != 0U || n = 1U || op = state\w_plus || op = state\w_minus || op = state\w_star || op = state\w_slash || op = state\w_percent || op = state\w_deref || op = state\w_eq || op = state\w_ne || op = state\w_lt || op = state\w_le || op = state\w_gt || op = state\w_ge || op = state\w_and || op = state\w_or)))
                            row\loaded: row\loaded | 2
                        ---
                    ---
                ---
            ---
            i: i + 1U
        ---
    ---
    c.free((cast: (@: void) queue))
    return: status
end: lmx_graph_work_scan

fn: lmx_graph_work_flush (@: g c.LmxGraph) int
    @: active c.LmxActivation (cast: (@: c.LmxActivation) g\arena\activation)
    @: frame c.LmxGraphFrame 0
    @: rows c.LmxGraphWork 0
    @: row c.LmxGraphWork 0
    size_t: i 0U
    if: active = 0 || active\frame = 0
        return: 0
    frame: (cast: (@: c.LmxGraphFrame) active\frame)
    rows: frame\rows
    while: i < frame\count
        row: rows + i
        if: row\dirty != 0 && row\slot != (cast: (size_t) -1)
            if: c.lmx_graph_assign_int(g, frame\code, frame\data, row\slot, row\number) != 0
                return: 4
            row\dirty: 0
        ---
        i: i + 1U
    ---
    return: 0
end: lmx_graph_work_flush

fn: lmx_graph_work_finish (@: g c.LmxGraph; @: frame c.LmxGraphFrame; int: status) int
    int: published lmx_graph_work_flush(g)
    if: frame\activation != 0
        frame\activation\frame: frame\prior
    c.free((cast: (@: void) frame\rows))
    frame\rows: 0
    frame\count: 0U
    if: published != 0
        return: published
    return: status
end: lmx_graph_work_finish

# Open either a method's own var or an explicit code/data pair. The same rows cache and publish both.
fn: lmx_graph_work_open_data (@: g c.LmxGraph; @: code c.Lmx; @: data c.Lmx; @: frame c.LmxGraphFrame) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: model c.Lmx 0
    @: body c.Lmx code
    @: declaration c.Lmx 0
    @: active c.LmxActivation (cast: (@: c.LmxActivation) g\arena\activation)
    @: rows c.LmxGraphWork 0
    @: row c.LmxGraphWork 0
    size_t: i 0U
    size_t: slot 0U
    int: status 0
    if: frame = 0 || active = 0 || active\code != code
        return: 5
    if: c.lmx_graph_method(g, code) != 0
        model: c.lmx_graph_method_var(g, code)
        body: c.lmx_graph_method_body(g, code)
    else:
        model: (cast: (@: c.Lmx) c.lmx_graph_field(g, (cast: (@: void) code), state\w_var))
    ---
    c.memset((cast: (@: void) frame), 0, c.sizeof(c.LmxGraphFrame))
    frame\code: code
    frame\data: data
    frame\count: c.lmx_graph_count(model)
    frame\capacity: frame\count + 8U
    frame\rows: (cast: (@: c.LmxGraphWork) c.calloc(frame\capacity, c.sizeof(c.LmxGraphWork)))
    if: frame\rows = 0
        return: 4
    frame\activation: active
    frame\prior: active\frame
    active\frame: frame
    rows: frame\rows
    while: i < frame\count && status = 0
        row: rows + i
        row\name: c.lmx_graph_slot_name(g, model, i)
        # A computed declaration `int: name expression` (an Lmx named int, §3.3) is the place name before its publication;
        # a reference declaration `@: name T` in a var is not executed by this slice (5), as before.
        if: row\name = state\w_int && c.lmx_graph_kind(g, c.lmx_graph_get(model, i)) = 4
            declaration: (cast: (@: c.Lmx) c.lmx_graph_get(model, i))
            row\name: c.lmx_graph_word_text(g, c.lmx_graph_get(declaration, 0U))
        ---
        if: row\name = state\w_at && c.lmx_graph_kind(g, c.lmx_graph_get(model, i)) = 4
            status: 5
        slot: i
        if: data != model
            slot: lmx_graph_data_slot(g, data, (cast: (@: char) row\name))
            if: slot < c.lmx_graph_count(data) && lmx_graph_data_twice(g, data, slot, (cast: (@: char) row\name)) != 0
                status: 3
        ---
        row\slot: slot
        row\cell: c.lmx_graph_place_cell(g, data, slot)
        if: row\name = 0
            status: 5
        i: i + 1U
    ---
    if: status = 0
        status: lmx_graph_work_scan(g, frame, body)
    # Only the actual method var executes its retained initializers; arbitrary data is never filled by call.
    if: status = 0 && model != 0 && data = model && c.lmx_graph_method(g, code) != 0
        status: lmx_graph_call(g, data)
    rows: frame\rows
    i: 0U
    while: i < frame\count && status = 0
        row: rows + i
        if: row\slot != (cast: (size_t) -1)
            row\cell: c.lmx_graph_place_cell(g, data, row\slot)
            row\loaded: row\loaded & 2
            if: row\loaded != 0
                status: lmx_graph_work_load(g, row)
            ---
        ---
        i: i + 1U
    ---
    if: status != 0
        return: lmx_graph_work_finish(g, frame, status)
    return: 0
end: lmx_graph_work_open_data

fn: lmx_graph_work_open (@: g c.LmxGraph; @: code c.Lmx; @: frame c.LmxGraphFrame) int
    return: lmx_graph_work_open_data(g, code, c.lmx_graph_method_var(g, code), frame)
end: lmx_graph_work_open

# A bare int name reads the current working value before caller bindings and lexical graph data. Explicit paths
# still read published cells. Argument operands snapshot this value before the caller publishes at the call boundary.
fn: lmx_graph_named_int (@: g c.LmxGraph; @: scope c.Lmx; @: name char; @: out int) int
    @: active c.LmxActivation (cast: (@: c.LmxActivation) g\arena\activation)
    @: args c.Lmx 0
    @: row c.LmxGraphWork 0
    @: value void 0
    size_t: slot 0U
    int: status 0
    while: active != 0
        if: active\frame != 0 || c.lmx_graph_method(g, active\code) != 0
            if: active\frame != 0
                row: lmx_graph_work_row((cast: (@: c.LmxGraphFrame) active\frame), name)
                if: row != 0
                    if: row\slot = (cast: (size_t) -1)
                        return: c.lmx_graph_value_int(g, row\cell, out)
                    status: lmx_graph_work_load(g, row)
                    if: status = 0
                        out[0]: row\number
                    return: status
                ---
            ---
            if: c.lmx_graph_method(g, active\code) != 0
                args: c.lmx_graph_method_args(g, active\code)
                slot: c.lmx_graph_formal(g, args, name)
                if: slot < active\width && active\refs != 0
                    return: c.lmx_graph_value_int(g, active\refs[slot], out)
                ---
            ---
        ---
        active: active\parent
    ---
    # A name that answers nothing here -- none, or a field not reached yet (lmx_graph_space_reach) -- is unknown (3).
    value: lmx_graph_resolve(g, scope, name)
    if: value = 0
        return: 3
    return: c.lmx_graph_value_int(g, value, out)
end: lmx_graph_named_int

fn: lmx_graph_operand_name (@: g c.LmxGraph; @: scope c.Lmx; @: name char) @: void
    @: value void lmx_graph_resolve(g, scope, name)
    int: kind c.lmx_graph_kind(g, value)
    int: number 0
    if: kind = 1 || kind = 3
        if: lmx_graph_named_int(g, scope, name, @ number) != 0
            return: 0
        return: c.lmx_graph_int(g, number)
    return: value
end: lmx_graph_operand_name

# A typed declaration without a candidate verifies its already allocated local place; it reads no value and
# resets nothing. Own fields were collected by construction, formals were admitted by the call.
fn: lmx_graph_local_int (@: g c.LmxGraph; @: code c.Lmx; @: name char) int
    @: active c.LmxActivation (cast: (@: c.LmxActivation) g\arena\activation)
    @: row c.LmxGraphWork 0
    @: args c.Lmx 0
    size_t: slot 0U
    if: active = 0 || active\code != code
        return: 5
    if: active\frame != 0
        row: lmx_graph_work_row((cast: (@: c.LmxGraphFrame) active\frame), name)
        if: row != 0
            return: (cast: (int) (c.lmx_graph_kind(g, row\cell) != 1))
        ---
    ---
    if: c.lmx_graph_method(g, code) = 0
        return: 3
    args: c.lmx_graph_method_args(g, code)
    slot: c.lmx_graph_formal(g, args, name)
    if: active\refs != 0 && slot < active\width
        return: (cast: (int) (c.lmx_graph_kind(g, active\refs[slot]) != 1))
    return: 3
end: lmx_graph_local_int

# Check a known int destination without reading it or evaluating the RHS. No field is introduced here.
fn: lmx_graph_known_int (@: g c.LmxGraph; @: code c.Lmx; @: name char; int: mode) int
    @: active c.LmxActivation (cast: (@: c.LmxActivation) g\arena\activation)
    @: row c.LmxGraphWork 0
    @: args c.Lmx 0
    @: value void 0
    size_t: slot 0U
    if: name = 0
        return: 3
    if: mode != 0
        slot: lmx_graph_visible_slot(g, code, name)
        if: slot >= c.lmx_graph_count(code)
            # A known name that is no place of this block -- a function, a Structure -- refuses the write.
            if: lmx_graph_resolve(g, code, name) != 0
                return: 4
            return: 3
        value: c.lmx_graph_place_cell(g, code, slot)
    else:
        if: active = 0 || active\code != code
            return: 5
        if: active\frame != 0
            row: lmx_graph_work_row((cast: (@: c.LmxGraphFrame) active\frame), name)
        if: row != 0
            value: row\cell
        else:
            if: c.lmx_graph_method(g, code) != 0
                args: c.lmx_graph_method_args(g, code)
                slot: c.lmx_graph_formal(g, args, name)
                if: active\refs != 0 && slot < active\width
                    value: active\refs[slot]
                ---
            ---
            if: value = 0
                return: 3
            ---
        ---
    ---
    if: c.lmx_graph_kind(g, value) != 1
        return: 4
    return: 0
end: lmx_graph_known_int

# Explicit paths write the graph, even when they address this activation's data. They neither publish nor refresh
# bare working values (semantics, working-state); only a later bare write marks that working place dirty.
fn: lmx_graph_store_field (@: g c.LmxGraph; @: code c.Lmx; @: owner c.Lmx; size_t: slot; int: number) int
    if: c.lmx_graph_kind(g, (cast: (@: void) owner)) != 4
        return: 4
    return: c.lmx_graph_assign_int(g, code, owner, slot, number)
end: lmx_graph_store_field

fn: lmx_graph_eval_assignment (@: g c.LmxGraph; @: code c.Lmx; @: statement c.Lmx; int: mode) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: left void c.lmx_graph_get(statement, 1U)
    @: name char c.lmx_graph_word_text(g, left)
    @: path c.Lmx (cast: (@: c.Lmx) left)
    @: value void 0
    @: owner c.Lmx code
    size_t: slot 0U
    int: number 0
    int: status 0
    if: c.lmx_graph_count(statement) != 3U
        return: 2
    if: name != 0
        status: lmx_graph_known_int(g, code, name, mode)
        slot: lmx_graph_visible_slot(g, code, name)
    else:
        if: c.lmx_graph_kind(g, left) != 4 || c.lmx_graph_count(path) != 3U || c.lmx_graph_word_text(g, c.lmx_graph_get(path, 1U)) != state\w_deref
            return: 2
        status: lmx_graph_eval_value(g, code, c.lmx_graph_get(path, 0U), @ value)
        if: status != 0
            return: status
        # The owner of the written field: a Structure, or the target of a reference to it (the same instance).
        value: c.lmx_graph_target(g, value)
        if: c.lmx_graph_kind(g, value) != 4
            return: 4
        owner: (cast: (@: c.Lmx) value)
        slot: c.lmx_graph_named(g, owner, c.lmx_graph_word_text(g, c.lmx_graph_get(path, 2U)))
        if: slot >= c.lmx_graph_count(owner)
            return: 3
        if: c.lmx_graph_place_cell(g, owner, slot) = 0
            return: 4
        ---
    ---
    if: status != 0
        return: status
    status: lmx_graph_eval_number(g, code, c.lmx_graph_get(statement, 2U), @ number)
    if: status != 0
        return: status
    if: name != 0 && mode = 0
        return: lmx_graph_store_name(g, code, name, number)
    return: lmx_graph_store_field(g, code, owner, slot, number)
end: lmx_graph_eval_assignment

fn: lmx_graph_store_name (@: g c.LmxGraph; @: code c.Lmx; @: name char; int: number) int
    @: active c.LmxActivation (cast: (@: c.LmxActivation) g\arena\activation)
    @: row c.LmxGraphWork 0
    @: args c.Lmx 0
    size_t: slot 0U
    if: active = 0 || active\code != code
        return: 5
    if: active\frame != 0
        row: lmx_graph_work_row((cast: (@: c.LmxGraphFrame) active\frame), name)
        if: row != 0
            if: row\slot = (cast: (size_t) -1)
                if: c.lmx_graph_kind(g, row\cell) != 1
                    return: 4
                return: c.lmx_int_store_known(row\cell, number)
            row\number: number
            row\loaded: 1
            row\dirty: 1
            return: 0
        ---
    ---
    if: c.lmx_graph_method(g, code) = 0
        return: 3
    args: c.lmx_graph_method_args(g, code)
    slot: c.lmx_graph_formal(g, args, name)
    if: active\refs != 0 && slot < active\width && c.lmx_graph_kind(g, active\refs[slot]) = 1
        return: c.lmx_int_store_known(active\refs[slot], number)
    # An unbound name is not created by assignment; never write an outer lexical source by a bare assignment.
    return: 3
end: lmx_graph_store_name

# The answers of the interpreter: 0 done; 1 an address has no int representation where an int is needed; 2 a malformed
# expression (an operator without an operand, two operands in a row, an unknown token); 3 an unknown name; 4 a write
# refused (a slot that holds no int place); 5 a statement this slice does not execute; 6 division by zero.

# Resolve the current activation's formals, inherited inputs, then lexical graph fields. Each lookup consumes the
# current graph and the live activation chain; no binding is saved in the graph or reused by the next traversal.
fn: lmx_graph_resolve (@: g c.LmxGraph; @: scope c.Lmx; @: name char) @: void
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: activation c.LmxActivation 0
    @: active_frame c.LmxGraphFrame 0
    @: args c.Lmx 0
    @: row c.LmxGraphWork 0
    @: current c.Lmx scope
    @: part c.Lmx 0
    @: value void 0
    @: space c.LmxGraphSpace c.lmx_graph_space()
    @: head char 0
    size_t: slot 0U
    if: g = 0 || name = 0
        return: 0
    activation: (cast: (@: c.LmxActivation) g\arena\activation)
    while: activation != 0
        if: activation\frame != 0
            row: lmx_graph_work_row((cast: (@: c.LmxGraphFrame) activation\frame), name)
            if: row != 0
                return: row\cell
            ---
            if: activation = g\arena\activation && name = state\w_var
                active_frame: (cast: (@: c.LmxGraphFrame) activation\frame)
                return: (cast: (@: void) active_frame\data)
            ---
        ---
        if: c.lmx_graph_method(g, activation\code) != 0 && activation\refs != 0
            args: c.lmx_graph_method_args(g, activation\code)
            slot: c.lmx_graph_formal(g, args, name)
            if: slot < activation\width
                return: activation\refs[slot]
            ---
        ---
        activation: activation\parent
    ---
    # Lexical: each block of the chain of parents by the namespace of this traversal (its declarations, places and named
    # Structures); a callable's body block and its own fields; a declaration by the own fields of what it created in
    # this traversal; another Structure by its places.
    while: c.lmx_graph_kind(g, (cast: (@: void) current)) = 4
        value: c.lmx_graph_space_find(current, name)
        if: value != 0
            return: value
        if: c.lmx_graph_method(g, current) != 0
            value: c.lmx_graph_space_find(c.lmx_graph_method_body(g, current), name)
            if: value != 0
                return: value
            part: c.lmx_graph_method_var(g, current)
            slot: c.lmx_graph_formal(g, part, name)
            if: slot < c.lmx_graph_count(part)
                return: c.lmx_graph_get(part, slot)
            ---
        else:
            head: c.lmx_graph_name_of(g, (cast: (@: void) current))
            if: (head = state\w_fn || head = state\w_sub) && current\parent != 0
                part: (cast: (@: c.Lmx) c.lmx_graph_space_find((cast: (@: c.Lmx) current\parent), c.lmx_graph_word_text(g, c.lmx_graph_get(current, 0U))))
                if: c.lmx_graph_method(g, part) != 0 && part\parent = current
                    part: c.lmx_graph_method_var(g, part)
                    slot: c.lmx_graph_formal(g, part, name)
                    if: slot < c.lmx_graph_count(part)
                        return: c.lmx_graph_get(part, slot)
                    ---
                ---
            else:
                if: space = 0 || space\root != current
                    slot: lmx_graph_place_slot(g, current, name)
                    if: slot < c.lmx_graph_count(current)
                        return: c.lmx_graph_get(current, slot)
                    ---
                ---
            ---
        ---
        current: (cast: (@: c.Lmx) current\parent)
    ---
    return: 0
end: lmx_graph_resolve

# Shape/default preflight precedes evaluation of any actual. This migration executes int-returning fn bodies;
# explicit int own fields use the shared working-cache/publication mechanism. Other receiver/result forms refuse.
fn: lmx_graph_call_shape (@: g c.LmxGraph; @: code c.Lmx; size_t: actuals) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: args c.Lmx 0
    size_t: i actuals
    if: c.lmx_graph_method(g, code) = 0
        return: 5
    args: c.lmx_graph_method_args(g, code)
    if: actuals > c.lmx_graph_count(args)
        return: 5
    # An implementation boundary of this slice, not a norm: a result is executed when its written requirement is int.
    if: c.lmx_graph_has_result(g, code) != 0
        if: c.lmx_graph_word_text(g, c.lmx_graph_method_return(g, code)) != state\w_int
            return: 5
        ---
    ---
    while: i < c.lmx_graph_count(args)
        if: c.lmx_graph_kind(g, c.lmx_graph_get(args, i)) != 1
            return: 5
        i: i + 1U
    ---
    return: 0
end: lmx_graph_call_shape

# A call written with one positional actual that names a value without effects -- a name or a field path -- or that
# is a merge may give the whole argument structure (the book, whole-arguments): a Structure whose direct fields name the
# formals is supplied by its fields. The binder then checks the required formals once that value is known
# (lmx_graph_call_single), still before any argument effect; the operands of a merge written in the call are evaluated
# before that check, as for a held result. Literals, operations, addresses, calls and named actuals are ordinary
# actuals. 1 for such a call, 0 otherwise.
fn: lmx_graph_single_candidate (@: g c.LmxGraph; @: expression c.Lmx) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: raw void 0
    @: path c.Lmx 0
    int: kind 0
    if: g = 0 || state = 0 || c.lmx_graph_kind(g, (cast: (@: void) expression)) != 4 || c.lmx_graph_count(expression) != 1U
        return: 0
    raw: c.lmx_graph_get(expression, 0U)
    kind: c.lmx_graph_kind(g, raw)
    if: kind = 2
        return: 1
    if: kind != 4
        return: 0
    if: c.lmx_graph_name_of(g, raw) = state\w_merge
        return: 1
    if: c.lmx_graph_name_of(g, raw) != 0
        return: 0
    path: (cast: (@: c.Lmx) raw)
    if: c.lmx_graph_count(path) = 3U && c.lmx_graph_word_text(g, c.lmx_graph_get(path, 1U)) = state\w_deref
        return: 1
    return: 0
end: lmx_graph_single_candidate

# Bind written arguments to the selected method before evaluating any of them. The map and the seen set belong
# only to this call; labels are canonical name addresses and the map stores physical formal slots, not name codes.
fn: lmx_graph_bind_call (@: g c.LmxGraph; @: code c.Lmx; @: expression c.Lmx; @: bindings size_t) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: args c.Lmx 0
    @: argument c.Lmx 0
    @: raw void 0
    @: name char 0
    @: seen int 0
    size_t: count 0U
    size_t: width 0U
    size_t: i 0U
    size_t: slot 0U
    int: named 0
    int: status 0
    if: c.lmx_graph_method(g, code) = 0 || c.lmx_graph_kind(g, (cast: (@: void) expression)) != 4 || bindings = 0
        return: 5
    args: c.lmx_graph_method_args(g, code)
    width: c.lmx_graph_count(args)
    count: c.lmx_graph_count(expression)
    if: lmx_graph_call_shape(g, code, width) != 0
        return: 5
    # A possible whole argument structure -- an empty Structure included, which is the empty field chain of a nullary
    # or default-only call -- is matched with the formals by lmx_graph_call_single once its value is known.
    if: lmx_graph_single_candidate(g, expression) != 0
        return: 0
    if: count > width
        return: 5
    seen: (cast: (@: int) c.calloc(width + 1U, sizeof(int)))
    if: seen = 0
        return: 4
    while: i < count && status = 0
        raw: c.lmx_graph_get(expression, i)
        argument: (cast: (@: c.Lmx) raw)
        slot: i
        if: c.lmx_graph_kind(g, raw) = 4 && c.lmx_graph_name_of(g, raw) = 0 && c.lmx_graph_word_text(g, c.lmx_graph_get(argument, 0U)) = state\w_assign
            named: 1
            name: c.lmx_graph_word_text(g, c.lmx_graph_get(argument, 1U))
            if: c.lmx_graph_count(argument) != 3U || name = 0
                status: 5
            slot: c.lmx_graph_formal(g, args, name)
        else:
            if: named != 0
                status: 5
            ---
        ---
        if: slot >= width
            status: 5
        if: status = 0
            if: seen[slot] != 0
                status: 5
            else:
                seen[slot]: 1
                bindings[i]: slot
            ---
        ---
        i: i + 1U
    ---
    i: 0U
    while: i < width && status = 0
        if: seen[i] = 0 && c.lmx_graph_kind(g, c.lmx_graph_get(args, i)) != 1
            status: 5
        i: i + 1U
    ---
    c.free((cast: (@: void) seen))
    return: status
end: lmx_graph_bind_call

# The first structural receiving pass for the field-reading subset: compare the paths actually used from this
# formal against the written model and the candidate, by canonical names and address types. The temporary queue
# belongs only to this admission. It neither checks unused model fields nor depends on their positions.
# Follow a nested path rooted at this formal. 0 unrelated, 1 matched, -1 a required field/type is absent.
fn: lmx_graph_admit_path (@: g c.LmxGraph; @: expression void; @: name char; @: model void; @: candidate void; @@: wanted void; @@: found void) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: path c.Lmx 0
    @: field char 0
    int: status 0
    int: kind 0
    if: c.lmx_graph_word_text(g, expression) = name
        wanted[0]: model
        found[0]: candidate
        return: 1
    if: c.lmx_graph_kind(g, expression) != 4
        return: 0
    path: (cast: (@: c.Lmx) expression)
    if: c.lmx_graph_count(path) != 3U || c.lmx_graph_word_text(g, c.lmx_graph_get(path, 1U)) != state\w_deref
        return: 0
    status: lmx_graph_admit_path(g, c.lmx_graph_get(path, 0U), name, model, candidate, wanted, found)
    if: status != 1
        return: status
    field: c.lmx_graph_word_text(g, c.lmx_graph_get(path, 2U))
    wanted[0]: c.lmx_graph_field(g, wanted[0], field)
    found[0]: c.lmx_graph_field(g, found[0], field)
    kind: c.lmx_graph_kind(g, wanted[0])
    if: kind = 3
        kind: 1
    if: c.lmx_graph_kind(g, found[0]) = 3
        found[0]: c.lmx_arena_pointer_void_read(found[0])
    if: kind = 0 || kind != c.lmx_graph_kind(g, found[0])
        return: -1
    return: 1
end: lmx_graph_admit_path

fn: lmx_graph_admit_paths (@: g c.LmxGraph; @: code c.Lmx; @: name char; @: model void; @: candidate void) int
    @@: queue c.Lmx 0
    size_t: count 0U
    size_t: cap 0U
    size_t: at 0U
    size_t: i 0U
    @: current c.Lmx 0
    @: value void 0
    @: wanted void 0
    @: found void 0
    int: status 0
    if: c.lmx_graph_kind(g, model) != 4 || c.lmx_graph_kind(g, candidate) != 4
        return: 4
    status: c.lmx_graph_scan_add(@ queue, @ count, @ cap, c.lmx_graph_method_body(g, code))
    while: at < count && status = 0
        current: queue[at]
        at: at + 1U
        if: lmx_graph_admit_path(g, (cast: (@: void) current), name, model, candidate, @ wanted, @ found) < 0
            status: 4
        i: 0U
        while: i < c.lmx_graph_count(current) && status = 0
            value: c.lmx_graph_get(current, i)
            if: c.lmx_graph_kind(g, value) = 4
                status: c.lmx_graph_scan_add(@ queue, @ count, @ cap, (cast: (@: c.Lmx) value))
            i: i + 1U
        ---
    ---
    c.free((cast: (@: void) queue))
    return: status
end: lmx_graph_admit_paths

# Admit each already evaluated argument immediately, before evaluating the next. Int arguments receive independent
# cells; a Structure is checked using its field names. The caller's transient refs array carries the admitted values.
fn: lmx_graph_admit (@: g c.LmxGraph; @: code c.Lmx; size_t: index; @: actual void; @@: out void) int
    @: args c.Lmx c.lmx_graph_method_args(g, code)
    @: formal void c.lmx_graph_get(args, index)
    @: model void 0
    @: declaration c.Lmx 0
    int: kind (cast: (int) c.lmx_graph_kind(g, formal))
    int: status 0
    int: number 0
    if: out = 0
        return: 4
    if: kind = 1 || kind = 3
        if: c.lmx_graph_value_int(g, actual, @ number) != 0
            return: 4
        out[0]: c.lmx_graph_int(g, number)
        if: out[0] = 0
            return: 4
        return: 0
    if: kind != 4
        return: 5
    # A formal `T: name` -- the declaration Frame named by its requirement T, with the name as its argument (§3.3).
    declaration: (cast: (@: c.Lmx) formal)
    if: c.lmx_graph_count(declaration) != 1U || c.lmx_graph_formal_model(g, declaration) = 0
        return: 5
    model: lmx_graph_resolve(g, (cast: (@: c.Lmx) code\parent), c.lmx_graph_formal_model(g, declaration))
    status: lmx_graph_admit_paths(g, code, c.lmx_graph_formal_name(g, args, index), model, actual)
    if: status = 0
        out[0]: actual
    return: status
end: lmx_graph_admit

# Sequential statements over the current method activation. Bodies stay in the graph on every call.
# A control body is consumed in the same activation. Flow is the canonical word address, never an opcode or
# retained plan. mode 0 uses activation places; mode 1 is construction-root execution; mode 2 is its inline body.
fn: lmx_graph_block (@: g c.LmxGraph; @: code c.Lmx; @: body c.Lmx; size_t: from; size_t: to; int: mode; @: out int; @@: flow char) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: statement c.Lmx 0
    @: nested c.Lmx 0
    @: header c.Lmx 0
    @: head char 0
    @: name char 0
    @: target void 0
    @: raw void 0
    size_t: i from
    size_t: n 0U
    size_t: slot 0U
    int: number 0
    int: status 0
    int: kind 0
    int: nested_mode mode
    int: cleanup_status 0
    int: pending_result 0
    int: reached 0
    @: pending_flow char 0
    if: mode = 1
        nested_mode: 2
    while: i < to && status = 0 && flow[0] = 0
        raw: c.lmx_graph_get(body, i)
        kind: c.lmx_graph_kind(g, raw)
        # A field of the root answers its name from where the traversal reaches it: a place, a named Structure
        # (lmx_graph_space_reach); a statement or a definition runs.
        if: mode = 1
            reached: lmx_graph_space_reach(g, code, i)
            if: reached < 0
                return: 1
            if: reached > 0
                i: i + 1U
                continue
            ---
        ---
        # A declaration of an int place is that place (§3.2). Reached in a body, it runs at its written position: a
        # literal is written into the activation's own place, a place without a value is checked; in an inline body of
        # the root it writes the root's place; at the root it is the root's own place and stands.
        if: kind = 1 || kind = 3
            name: c.lmx_graph_slot_name(g, body, i)
            # The Structure's own place -- a field of code itself, shared by a post-loop body -- stands.
            if: name != 0 && mode = 0
                slot: lmx_graph_place_slot(g, code, name)
                if: slot < c.lmx_graph_count(code) && c.lmx_graph_get(code, slot) = raw
                    i: i + 1U
                    continue
                ---
            ---
            if: name != 0 && mode = 0
                status: lmx_graph_local_int(g, code, name)
                if: status = 0 && kind = 1
                    status: lmx_graph_store_name(g, code, name, c.lmx_int_value_known(raw))
                i: i + 1U
                continue
            ---
            if: name != 0 && mode = 2
                slot: lmx_graph_visible_slot(g, code, name)
                if: slot >= c.lmx_graph_count(code)
                    return: 3
                if: kind = 1
                    status: c.lmx_graph_assign_int(g, code, code, slot, c.lmx_int_value_known(raw))
                i: i + 1U
                continue
            ---
            if: name != 0 || kind = 3
                i: i + 1U
                continue
            ---
        ---
        if: kind = 5 || kind = 6
            i: i + 1U
            continue
        head: c.lmx_graph_word_text(g, raw)
        if: head = state\w_return
            if: c.lmx_graph_has_result(g, code) != 0
                return: 5
            flow[0]: head
            return: 0
        if: head = state\w_break || head = state\w_continue || head = state\w_redo
            flow[0]: head
            return: 0
        if: kind != 4
            if: mode = 0
                status: lmx_graph_eval_number(g, code, raw, @ number)
            i: i + 1U
            continue
        statement: (cast: (@: c.Lmx) raw)
        n: c.lmx_graph_count(statement)
        head: c.lmx_graph_name_of(g, raw)
        if: head = 0
            # An unnamed Lmx: the assignment `a := v`, an anonymous body, or an expression whose value is not used.
            if: n != 0U
                head: c.lmx_graph_word_text(g, c.lmx_graph_get(statement, 0U))
            if: head = state\w_assign
                status: lmx_graph_eval_assignment(g, code, statement, mode)
                i: i + 1U
                continue
            if: head = 0
                status: lmx_graph_block(g, code, statement, 0U, n, nested_mode, out, flow)
                i: i + 1U
                continue
            if: mode = 0
                status: lmx_graph_eval_number(g, code, raw, @ number)
            i: i + 1U
            continue
        # A declaration of fn or sub with written arguments created its Structure in this traversal when its block was
        # entered (lmx_graph_space_declarations); the receiver applied to arguments the traversal computes creates it
        # here, where the root reaches it (lmx_graph_fn_apply) -- in a body or an inline block that is open (5). The var
        # part of a Structure is its data; a named Structure of the root stands.
        if: head = state\w_fn || head = state\w_sub
            if: lmx_graph_fn_written(g, statement) = 0
                if: mode != 1
                    return: 5
                status: lmx_graph_fn_apply(g, code, i)
            ---
            i: i + 1U
            continue
        if: head = state\w_var
            i: i + 1U
            continue
        if: head = state\w_fm
            return: 5
        if: head = state\w_finally
            # Reaching this field registers its body in this scope. Recursing over the remaining statements makes
            # multiple registrations unwind in reverse order, without a persistent plan or a second graph.
            status: lmx_graph_block(g, code, body, i + 1U, to, mode, out, flow)
            pending_flow: flow[0]
            if: pending_flow = state\w_return
                pending_result: out[0]
            if: status != 0 || pending_flow = state\w_return
                cleanup_status: lmx_graph_work_flush(g)
                if: cleanup_status != 0
                    status: cleanup_status
                ---
            ---
            flow[0]: 0
            cleanup_status: lmx_graph_block(g, code, statement, 0U, n, nested_mode, out, flow)
            if: cleanup_status != 0
                return: cleanup_status
            if: flow[0] = 0
                flow[0]: pending_flow
                if: pending_flow = state\w_return
                    out[0]: pending_result
                ---
            ---
            return: status
        if: head = state\w_if
            if: n != 2U || c.lmx_graph_kind(g, c.lmx_graph_get(statement, 1U)) != 4
                return: 2
            status: lmx_graph_eval_number(g, code, c.lmx_graph_get(statement, 0U), @ number)
            if: status != 0
                return: status
            if: number != 0
                nested: (cast: (@: c.Lmx) c.lmx_graph_get(statement, 1U))
                status: lmx_graph_block(g, code, nested, 0U, c.lmx_graph_count(nested), nested_mode, out, flow)
            i: i + 1U
            if: i < to && c.lmx_graph_kind(g, c.lmx_graph_get(body, i)) = 4 && c.lmx_graph_name_of(g, c.lmx_graph_get(body, i)) = state\w_else
                statement: (cast: (@: c.Lmx) c.lmx_graph_get(body, i))
                if: number = 0 && status = 0
                    status: lmx_graph_block(g, code, statement, 0U, c.lmx_graph_count(statement), nested_mode, out, flow)
                i: i + 1U
            ---
            continue
        if: head = state\w_else
            return: 2
        if: head = state\w_while || head = state\w_for || head = state\w_until
            if: n != 2U || c.lmx_graph_kind(g, c.lmx_graph_get(statement, 1U)) != 4
                return: 2
            nested: (cast: (@: c.Lmx) c.lmx_graph_get(statement, 1U))
            header: (cast: (@: c.Lmx) c.lmx_graph_get(statement, 0U))
            if: head = state\w_for
                if: c.lmx_graph_kind(g, (cast: (@: void) header)) != 4 || c.lmx_graph_count(header) != 3U
                    return: 2
                status: lmx_graph_block(g, code, header, 0U, 1U, nested_mode, out, flow)
            while: status = 0 && flow[0] = 0
                number: 1
                if: head != state\w_until
                    if: head = state\w_for
                        status: lmx_graph_eval_number(g, code, c.lmx_graph_get(header, 1U), @ number)
                    else:
                        status: lmx_graph_eval_number(g, code, c.lmx_graph_get(statement, 0U), @ number)
                    ---
                ---
                if: status != 0 || number = 0
                    break
                while: status = 0
                    flow[0]: 0
                    status: lmx_graph_block(g, code, nested, 0U, c.lmx_graph_count(nested), nested_mode, out, flow)
                    if: flow[0] != state\w_redo
                        break
                ---
                if: status != 0 || flow[0] = state\w_return
                    break
                if: flow[0] = state\w_break
                    flow[0]: 0
                    break
                if: flow[0] = state\w_continue
                    flow[0]: 0
                if: head = state\w_for && flow[0] = 0
                    status: lmx_graph_block(g, code, header, 2U, 3U, nested_mode, out, flow)
                ---
                if: status = 0 && head = state\w_until && flow[0] = 0
                    status: lmx_graph_eval_number(g, code, c.lmx_graph_get(statement, 0U), @ number)
                    if: status != 0 || number != 0
                        break
                    ---
                ---
            ---
            i: i + 1U
            continue
        if: head = state\w_break || head = state\w_continue || head = state\w_redo
            if: n != 0U
                return: 5
            flow[0]: head
            return: 0
        if: head = state\w_return
            if: n = 0U
                if: c.lmx_graph_has_result(g, code) != 0
                    return: 5
                ---
            else:
                if: c.lmx_graph_has_result(g, code) = 0
                    return: 5
                status: lmx_graph_eval(g, code, statement, 0U, n, out)
            ---
            flow[0]: state\w_return
            return: status
        if: mode = 1
            status: lmx_graph_exec_statement(g, code, i)
            i: i + 1U
            continue
        if: head = state\w_call
            status: lmx_graph_eval_explicit_call(g, code, statement)
            i: i + 1U
            continue
        if: head = state\w_at
            return: 5
        if: head = state\w_include || head = state\w_predef
            i: i + 1U
            continue
        if: head = state\w_int
            head: c.lmx_graph_word_text(g, c.lmx_graph_get(statement, 0U))
            if: mode = 0
                status: lmx_graph_local_int(g, code, head)
            else:
                slot: lmx_graph_visible_slot(g, code, head)
                if: slot = c.lmx_graph_count(code)
                    return: 3
            ---
            if: status != 0 || n = 1U
                i: i + 1U
                continue
            status: lmx_graph_eval(g, code, statement, 1U, n, @ number)
        else:
            target: c.lmx_graph_target(g, lmx_graph_resolve(g, code, head))
            if: c.lmx_graph_method(g, (cast: (@: c.Lmx) target)) != 0
                status: lmx_graph_eval_call(g, code, statement, (cast: (@: c.Lmx) target), @ number)
                i: i + 1U
                continue
            status: lmx_graph_eval(g, code, statement, 0U, n, @ number)
        ---
        if: status = 0
            if: mode = 0
                status: lmx_graph_store_name(g, code, head, number)
            else:
                slot: lmx_graph_visible_slot(g, code, head)
                if: slot = c.lmx_graph_count(code)
                    return: 3
                status: c.lmx_graph_assign_int(g, code, code, slot, number)
            ---
        ---
        i: i + 1U
    ---
    return: status
end: lmx_graph_block

fn: lmx_graph_method_run (@: g c.LmxGraph; @: code c.Lmx; @: out int) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: body c.Lmx code
    @: flow char 0
    int: status 0
    if: c.lmx_graph_method(g, code) != 0
        body: c.lmx_graph_method_body(g, code)
    status: lmx_graph_block(g, code, body, 0U, c.lmx_graph_count(body), 0, out, @ flow)
    if: status != 0
        return: status
    if: flow != 0 && flow != state\w_return
        return: 5
    if: c.lmx_graph_has_result(g, code) != 0 && flow != state\w_return
        return: 5
    return: 0
end: lmx_graph_method_run

# Invoke with arguments that have already passed admission. Missing literal defaults are copied into this call's
# private places. Native and interpretation share the ordinary activation ABI; the signature graph remains intact.
fn: lmx_graph_invoke_data (@: g c.LmxGraph; @: code c.Lmx; @: data c.Lmx; @@: actuals void; size_t: count; @: bindings size_t; @: out int) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: args c.Lmx 0
    @: body c.Lmx 0
    @: statement c.Lmx 0
    @@: refs void 0
    @: returned void 0
    c.LmxActivation: activation
    c.LmxGraphFrame: frame
    size_t: width 0U
    size_t: i 0U
    size_t: slot 0U
    int: status 0
    if: c.lmx_graph_method(g, code) = 0 || out = 0
        return: 5
    args: c.lmx_graph_method_args(g, code)
    width: c.lmx_graph_count(args)
    if: bindings = 0
        status: lmx_graph_call_shape(g, code, count)
    else:
        status: lmx_graph_call_shape(g, code, width)
    ---
    if: status != 0 || count > width
        return: 5
    refs: (cast: (@@: void) c.calloc(width + 1U, sizeof(@: void)))
    if: refs = 0
        return: 4
    while: i < count && status = 0
        slot: i
        if: bindings != 0
            slot: bindings[i]
        if: slot >= width
            status: 5
        else:
            if: refs[slot] != 0 || actuals = 0 || actuals[i] = 0
                status: 5
            else:
                refs[slot]: actuals[i]
            ---
        ---
        i: i + 1U
    ---
    i: 0U
    while: i < width && status = 0
        if: refs[i] = 0
            if: c.lmx_graph_kind(g, c.lmx_graph_get(args, i)) != 1
                status: 5
            else:
                status: lmx_graph_admit(g, code, i, c.lmx_graph_get(args, i), @ refs[i])
            ---
        ---
        i: i + 1U
    ---
    if: status = 0
        status: lmx_graph_work_flush(g)
    if: status = 0
        if: code\native != 0
            status: c.lmx_call_prim(g\arena, code, data, refs, width, (cast: (@: void) out), @ returned)
        else:
            status: c.lmx_activation_push(g\arena, @ activation, 2, code, refs, 0, width, 0)
            if: status = 0
                status: lmx_graph_work_open_data(g, code, data, @ frame)
                if: status = 0
                    status: lmx_graph_method_run(g, code, out)
                    status: lmx_graph_work_finish(g, @ frame, status)
                ---
                c.lmx_activation_pop(g\arena, @ activation)
            ---
        ---
    ---
    c.free((cast: (@: void) refs))
    return: status
end: lmx_graph_invoke_data

fn: lmx_graph_invoke (@: g c.LmxGraph; @: code c.Lmx; @@: actuals void; size_t: count; @: out int) int
    return: lmx_graph_invoke_data(g, code, c.lmx_graph_method_var(g, code), actuals, count, 0, out)
end: lmx_graph_invoke

fn: lmx_graph_invoke_bound (@: g c.LmxGraph; @: code c.Lmx; @@: actuals void; size_t: count; @: bindings size_t; @: out int) int
    return: lmx_graph_invoke_data(g, code, c.lmx_graph_method_var(g, code), actuals, count, bindings, out)
end: lmx_graph_invoke_bound

# The call of one positional actual that names a value without effects (lmx_graph_single_candidate), once that value
# is known (the book, whole-arguments: one Structure is its chain of fields). A Structure whose every direct field names
# a formal of the selected callee, each formal at most once, while every formal without a field has its written
# default, is the whole argument structure when each field is accepted by its formal: the common admission of this
# subset (lmx_graph_admit -- an int formal reads an int, a model formal the first part of implements over the used
# paths) decides, field by field in the callee's order. An empty Structure is the empty chain: the call of a nullary or
# default-only callee. Otherwise the value is the ordinary first argument and every other formal needs its default. One
# method decides by its formals and the value's direct fields: no tree search, no second reading, no conversion table
# yet (an implementation boundary of this subset). The arrays belong only to this call. 0, or the refusal of the form
# (5) or of a reception.
fn: lmx_graph_call_single (@: g c.LmxGraph; @: code c.Lmx; @: given void; @: out int) int
    # A reference to a Structure stands for that Structure as the whole argument structure (lmx_graph_target).
    @: value void c.lmx_graph_target(g, given)
    @: args c.Lmx 0
    @: structure c.Lmx 0
    @: field void 0
    @: name char 0
    @@: values void 0
    @: bindings size_t 0
    @: from size_t 0
    size_t: width 0U
    size_t: n 0U
    size_t: i 0U
    size_t: slot 0U
    size_t: k 0U
    int: whole 0
    int: status 0
    if: c.lmx_graph_method(g, code) = 0 || out = 0
        return: 5
    args: c.lmx_graph_method_args(g, code)
    width: c.lmx_graph_count(args)
    values: (cast: (@@: void) c.calloc(width + 1U, sizeof(@: void)))
    bindings: (cast: (@: size_t) c.calloc(width + 1U, sizeof(size_t)))
    from: (cast: (@: size_t) c.calloc(width + 1U, sizeof(size_t)))
    if: values = 0 || bindings = 0 || from = 0
        status: 4
    if: status = 0 && c.lmx_graph_kind(g, value) = 4 && c.lmx_graph_method(g, (cast: (@: c.Lmx) value)) = 0
        structure: (cast: (@: c.Lmx) value)
        n: c.lmx_graph_count(structure)
        whole: 1
        # from[slot]: 1 + the index of the field that names the formal at slot, 0 for none.
        while: i < n && whole != 0
            name: c.lmx_graph_slot_name(g, structure, i)
            slot: c.lmx_graph_formal(g, args, name)
            if: name = 0 || slot >= width
                whole: 0
            else:
                if: from[slot] != 0U
                    whole: 0
                else:
                    from[slot]: i + 1U
                ---
            ---
            i: i + 1U
        ---
        i: 0U
        while: i < width && whole != 0
            if: from[i] = 0U && c.lmx_graph_kind(g, c.lmx_graph_get(args, i)) != 1
                whole: 0
            i: i + 1U
        ---
        # The reading is applicable when every field is accepted by its formal.
        i: 0U
        while: i < width && whole != 0
            if: from[i] != 0U
                field: c.lmx_graph_get(structure, from[i] - 1U)
                if: lmx_graph_admit(g, code, i, field, @ values[k]) != 0
                    whole: 0
                else:
                    bindings[k]: i
                    k: k + 1U
                ---
            ---
            i: i + 1U
        ---
    ---
    if: status = 0 && whole = 0
        k: 0U
        if: width = 0U
            status: 5
        i: 1U
        while: i < width && status = 0
            if: c.lmx_graph_kind(g, c.lmx_graph_get(args, i)) != 1
                status: 5
            i: i + 1U
        ---
        if: status = 0
            status: lmx_graph_admit(g, code, 0U, value, @ values[0])
        bindings[0]: 0U
        k: 1U
    ---
    if: status = 0
        status: lmx_graph_invoke_bound(g, code, values, k, bindings, out)
    c.free((cast: (@: void) values))
    c.free((cast: (@: void) bindings))
    c.free((cast: (@: void) from))
    return: status
end: lmx_graph_call_single

fn: lmx_graph_eval_call (@: g c.LmxGraph; @: scope c.Lmx; @: expression c.Lmx; @: code c.Lmx; @: out int) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    size_t: count (cast: (size_t) c.lmx_graph_count(expression))
    size_t: i 0U
    @@: values void (cast: (@@: void) c.calloc(count + 1U, sizeof(@: void)))
    @: bindings size_t (cast: (@: size_t) c.calloc(count + 1U, sizeof(size_t)))
    @: actual void 0
    @: raw void 0
    int: status 4
    if: values != 0 && bindings != 0
        status: lmx_graph_bind_call(g, code, expression, bindings)
    if: status = 0 && lmx_graph_single_candidate(g, expression) != 0
        status: lmx_graph_eval_value(g, scope, c.lmx_graph_get(expression, 0U), @ actual)
        if: status = 0
            status: lmx_graph_call_single(g, code, actual, out)
        c.free((cast: (@: void) values))
        c.free((cast: (@: void) bindings))
        return: status
    while: i < count && status = 0
        raw: c.lmx_graph_get(expression, i)
        if: c.lmx_graph_kind(g, raw) = 4 && c.lmx_graph_name_of(g, raw) = 0 && c.lmx_graph_word_text(g, c.lmx_graph_get((cast: (@: c.Lmx) raw), 0U)) = state\w_assign
            raw: c.lmx_graph_get((cast: (@: c.Lmx) raw), 2U)
        status: lmx_graph_eval_value(g, scope, raw, @ actual)
        if: status = 0
            status: lmx_graph_admit(g, code, bindings[i], actual, @ values[i])
        i: i + 1U
    ---
    if: status = 0
        status: lmx_graph_invoke_bound(g, code, values, count, bindings, out)
    c.free((cast: (@: void) values))
    c.free((cast: (@: void) bindings))
    return: status
end: lmx_graph_eval_call

# Evaluate an address-valued operand. A path returns the actual current field cell/Structure; arithmetic and a call
# create a result cell only where a receiving boundary needs an address. Arithmetic's intermediate ints stay local.
fn: lmx_graph_eval_value (@: g c.LmxGraph; @: scope c.Lmx; @: raw void; @@: out void) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: expression c.Lmx 0
    @: value void raw
    @: word char 0
    size_t: count 0U
    int: kind (cast: (int) c.lmx_graph_kind(g, raw))
    int: number 0
    int: status 0
    if: out = 0 || kind = 0
        return: 2
    if: kind = 2
        value: lmx_graph_operand_name(g, scope, c.lmx_graph_word_text(g, raw))
        if: value = 0
            return: 3
        ---
    else:
        if: kind = 4 && c.lmx_graph_name_of(g, raw) != 0
            # A Frame: merge builds a new Structure from its operands (the book, composition; lmx_graph_eval_merge); any
            # other is the application of its head, an int result in a new cell.
            if: c.lmx_graph_name_of(g, raw) = state\w_merge
                return: lmx_graph_eval_merge(g, scope, (cast: (@: c.Lmx) raw), out)
            status: lmx_graph_eval_number(g, scope, raw, @ number)
            if: status != 0
                return: status
            value: c.lmx_graph_int(g, number)
            if: value = 0
                return: 4
            ---
        else:
            if: kind = 4
                expression: (cast: (@: c.Lmx) raw)
                count: c.lmx_graph_count(expression)
                word: c.lmx_graph_word_text(g, c.lmx_graph_get(expression, 1U))
                if: count = 3U && word = state\w_deref
                    status: lmx_graph_eval_value(g, scope, c.lmx_graph_get(expression, 0U), @ value)
                    if: status != 0
                        return: status
                    value: c.lmx_graph_field(g, value, c.lmx_graph_word_text(g, c.lmx_graph_get(expression, 2U)))
                    if: value = 0
                        return: 3
                    ---
                else:
                    word: c.lmx_graph_word_text(g, c.lmx_graph_get(expression, 0U))
                    if: count = 2U && word = state\w_at
                        value: c.lmx_graph_get(expression, 1U)
                        if: c.lmx_graph_kind(g, value) = 2
                            value: lmx_graph_resolve(g, scope, c.lmx_graph_word_text(g, value))
                            status: 0
                            if: value = 0
                                status: 3
                            ---
                        else:
                            status: lmx_graph_eval_value(g, scope, value, @ value)
                        ---
                        if: status != 0
                            return: status
                        if: c.lmx_graph_kind(g, value) = 3
                            value: c.lmx_arena_pointer_void_read(value)
                        value: c.lmx_graph_ref_int(g, value)
                        if: value = 0
                            return: 4
                        ---
                    else:
                        if: count = 1U
                            return: lmx_graph_eval_value(g, scope, c.lmx_graph_get(expression, 0U), out)
                        status: lmx_graph_eval_number(g, scope, raw, @ number)
                        if: status != 0
                            return: status
                        value: c.lmx_graph_int(g, number)
                        if: value = 0
                            return: 4
                        ---
                    ---
                ---
            ---
        ---
    ---
    out[0]: value
    return: 0
end: lmx_graph_eval_value

# Consume the nested expression itself. No precedence parser or saved expression plan exists in either consumer.
fn: lmx_graph_eval_number (@: g c.LmxGraph; @: scope c.Lmx; @: raw void; @: out int) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: expression c.Lmx 0
    @: value void raw
    @: word char 0
    size_t: count 0U
    int: kind (cast: (int) c.lmx_graph_kind(g, raw))
    int: left 0
    int: right 0
    int: status 0
    if: kind = 2
        return: lmx_graph_named_int(g, scope, c.lmx_graph_word_text(g, raw), out)
    if: kind != 4
        return: c.lmx_graph_value_int(g, value, out)
    expression: (cast: (@: c.Lmx) raw)
    count: c.lmx_graph_count(expression)
    word: c.lmx_graph_name_of(g, raw)
    if: word != 0
        # A Frame in an operand position: the application of the callable its head names (directly or through a
        # reference to it), once; a merge or another head gives no int here.
        value: c.lmx_graph_target(g, lmx_graph_resolve(g, scope, word))
        if: c.lmx_graph_method(g, (cast: (@: c.Lmx) value)) != 0
            if: c.lmx_graph_has_result(g, (cast: (@: c.Lmx) value)) = 0
                return: 5
            return: lmx_graph_eval_call(g, scope, expression, (cast: (@: c.Lmx) value), out)
        ---
        if: word = state\w_merge || lmx_graph_language_word(state, word) != 0
            return: 2
        if: value = 0
            return: 3
        return: 2
    word: c.lmx_graph_word_text(g, c.lmx_graph_get(expression, 1U))
    if: count = 3U && word = state\w_deref
        status: lmx_graph_eval_value(g, scope, raw, @ value)
        if: status != 0
            return: status
        return: c.lmx_graph_value_int(g, value, out)
    if: count = 3U && (word = state\w_plus || word = state\w_minus || word = state\w_star || word = state\w_slash || word = state\w_percent || word = state\w_eq || word = state\w_ne || word = state\w_lt || word = state\w_le || word = state\w_gt || word = state\w_ge || word = state\w_and || word = state\w_or)
        status: lmx_graph_eval_number(g, scope, c.lmx_graph_get(expression, 0U), @ left)
        if: status != 0
            return: status
        if: (word = state\w_and && left = 0) || (word = state\w_or && left != 0)
            out[0]: (cast: (int) (left != 0))
            return: 0
        status: lmx_graph_eval_number(g, scope, c.lmx_graph_get(expression, 2U), @ right)
        if: status != 0
            return: status
        if: word = state\w_plus
            left: left + right
        if: word = state\w_minus
            left: left - right
        if: word = state\w_star
            left: left * right
        if: word = state\w_slash || word = state\w_percent
            if: right = 0
                return: 6
            if: word = state\w_slash
                left: left / right
            else:
                left: left % right
            ---
        ---
        if: word = state\w_eq
            left: (cast: (int) (left = right))
        if: word = state\w_ne
            left: (cast: (int) (left != right))
        if: word = state\w_lt
            left: (cast: (int) (left < right))
        if: word = state\w_le
            left: (cast: (int) (left <= right))
        if: word = state\w_gt
            left: (cast: (int) (left > right))
        if: word = state\w_ge
            left: (cast: (int) (left >= right))
        if: word = state\w_and
            left: (cast: (int) (left && right))
        if: word = state\w_or
            left: (cast: (int) (left || right))
        out[0]: left
        return: 0
    word: c.lmx_graph_word_text(g, c.lmx_graph_get(expression, 0U))
    if: count = 2U && (word = state\w_plus || word = state\w_minus || word = state\w_not)
        status: lmx_graph_eval_number(g, scope, c.lmx_graph_get(expression, 1U), out)
        if: status = 0 && word = state\w_minus
            out[0]: 0 - out[0]
        if: status = 0 && word = state\w_not
            out[0]: (cast: (int) (out[0] = 0))
        return: status
    if: count = 2U && word = state\w_deref
        status: lmx_graph_eval_value(g, scope, c.lmx_graph_get(expression, 1U), @ value)
        if: status != 0
            return: status
        if: c.lmx_graph_kind(g, value) != 5
            return: 2
        return: c.lmx_graph_value_int(g, c.lmx_arena_pointer_void_read(value), out)
    if: count = 1U
        return: lmx_graph_eval_number(g, scope, c.lmx_graph_get(expression, 0U), out)
    return: 2
end: lmx_graph_eval_number

# A receiving expression occupies one field: the builder has already put every operation into its ordinary Lmx.
fn: lmx_graph_eval (@: g c.LmxGraph; @: scope c.Lmx; @: expr c.Lmx; size_t: from; size_t: to; @: out int) int
    if: g = 0 || scope = 0 || expr = 0 || out = 0 || to != from + 1U
        return: 2
    return: lmx_graph_eval_number(g, scope, c.lmx_graph_get(expr, from), out)
end: lmx_graph_eval

# One statement: the Lmx at slot index of root, whose field 0 is a word. `int: name expression` publishes the value in a
# new int cell named name in that slot; `name: expression` writes the int place named name.
fn: lmx_graph_exec_statement (@: g c.LmxGraph; @: root c.Lmx; size_t: index) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: statement c.Lmx (cast: (@: c.Lmx) c.lmx_graph_get(root, index))
    @: head char 0
    @: name char 0
    @: cell void 0
    size_t: n 0U
    size_t: k 0U
    int: value 0
    int: r 0
    if: state = 0 || statement = 0
        return: 5
    n: c.lmx_graph_count(statement)
    head: c.lmx_graph_name_of(g, (cast: (@: void) statement))
    if: head = 0
        return: 5
    if: head = state\w_call
        return: lmx_graph_eval_explicit_call(g, root, statement)
    # The unit's C-door declarations (`include: "<stdio.h>"`, `predef: "l2src/x.h.lm1"`) stand: they tell a
    # translation which C headers and generated declarations the unit's machine code uses; the root runs nothing for them.
    if: head = state\w_include || head = state\w_predef
        return: 0
    # A declaration of fn or sub with written arguments created its Structure when the traversal began; the receiver
    # applied to arguments the traversal computes creates it now (lmx_graph_fn_apply).
    if: head = state\w_fn || head = state\w_sub
        return: lmx_graph_fn_apply(g, root, index)
    if: head = state\w_fm
        return: 5
    cell: lmx_graph_resolve(g, root, head)
    # A head naming a callable, directly or through a reference to it, applies it (the book :454, :1237).
    if: c.lmx_graph_method(g, (cast: (@: c.Lmx) c.lmx_graph_target(g, cell))) != 0
        return: lmx_graph_eval_call(g, root, statement, (cast: (@: c.Lmx) c.lmx_graph_target(g, cell)), @ value)
    if: n < 1U
        return: 5
    if: head = state\w_at
        # The initialized reference form of this int-only slice: @: p int @i. The words stay in the source graph;
        # resolving i belongs to this traversal, and the resulting p is an ordinary primitive pointer value.
        if: n != 3U || c.lmx_graph_word_text(g, c.lmx_graph_get(statement, 1U)) != state\w_int
            return: 5
        name: c.lmx_graph_word_text(g, c.lmx_graph_get(statement, 0U))
        if: name = 0
            return: 5
        r: lmx_graph_eval_value(g, root, c.lmx_graph_get(statement, 2U), @ cell)
        if: r != 0
            return: r
        if: c.lmx_graph_kind(g, cell) != 5
            return: 4
        return: c.lmx_graph_publish(g, root, index, cell)
    if: head = state\w_int
        name: c.lmx_graph_word_text(g, c.lmx_graph_get(statement, 0U))
        if: n < 2U || name = 0
            return: 5
        r: lmx_graph_eval(g, root, statement, 1U, n, @ value)
        if: r != 0
            return: r
        cell: c.lmx_graph_int(g, value)
        if: cell = 0
            return: 4
        return: c.lmx_graph_publish(g, root, index, cell)
    k: lmx_graph_visible_slot(g, root, head)
    # A written field `name: value` whose name is not known defines the place by its value (the book, composition of
    # place and value; lmx_graph_define), e.g. a held merge result.
    if: k >= c.lmx_graph_count(root) && n = 1U && cell = 0 && lmx_graph_language_word(state, head) = 0 && c.lmx_graph_language_receiver(head) = 0
        r: lmx_graph_eval_value(g, root, c.lmx_graph_get(statement, 0U), @ cell)
        if: r != 0
            return: r
        return: c.lmx_graph_define(g, root, index, cell)
    if: k >= c.lmx_graph_count(root)
        return: 3
    r: lmx_graph_eval(g, root, statement, 0U, n, @ value)
    if: r != 0
        return: r
    if: c.lmx_graph_assign_int(g, root, root, k, value) != 0
        return: 4
    return: 0
end: lmx_graph_exec_statement

# The execution of a root: its fields in order; a field holding a primitive is a value and stands; a field holding an
# unnamed Lmx whose field 0 is a word is a statement and runs; a named Lmx (a data Structure) stands. 0, or the first
# statement's answer.
fn: lmx_graph_run (@: g c.LmxGraph; @: root c.Lmx) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: flow char 0
    int: number 0
    int: status 0
    int: opened 0
    if: g = 0 || root = 0
        return: 5
    status: lmx_graph_space_open(g, root, @ opened)
    if: status != 0
        return: status
    status: lmx_graph_block(g, root, root, 0U, c.lmx_graph_count(root), 1, @ number, @ flow)
    if: status = 0 && flow != 0 && flow != state\w_return
        status: 5
    lmx_graph_space_close(opened)
    return: status
end: lmx_graph_run

# Dispatch the current clean graph. Native uses the existing common nullary call boundary; with no entry the clean
# interpreter gets a fresh activation frame, discarded on return. No previous traversal's bindings are retained.
fn: lmx_graph_call (@: g c.LmxGraph; @: root c.Lmx) int
    c.LmxActivation: activation
    int: value 0
    int: status 0
    int: opened 0
    if: g = 0 || c.lmx_graph_kind(g, (cast: (@: void) root)) != 4
        return: 5
    status: lmx_graph_space_open(g, root, @ opened)
    if: status != 0
        return: status
    if: root\native != 0
        status: c.lmx_call0(g\arena, root, @ value)
    else:
        status: 5
        if: c.lmx_activation_push(g\arena, @ activation, 2, root, 0, 0, 0U, 0) = 0
            status: lmx_graph_run(g, root)
            c.lmx_activation_pop(g\arena, @ activation)
        ---
    ---
    lmx_graph_space_close(opened)
    return: status
end: lmx_graph_call



# Explicit call selects actual code and data at runtime. A missing shorthand var is null, never code or a new Lmx.
fn: lmx_graph_eval_explicit_call (@: g c.LmxGraph; @: scope c.Lmx; @: expression c.Lmx) int
    @: code void 0
    @: data void 0
    size_t: count c.lmx_graph_count(expression)
    int: status 0
    if: count < 1U || count > 2U
        return: 5
    status: lmx_graph_eval_value(g, scope, c.lmx_graph_get(expression, 0U), @ code)
    if: status = 0 && count = 2U
        status: lmx_graph_eval_value(g, scope, c.lmx_graph_get(expression, 1U), @ data)
    if: status != 0
        return: status
    return: lmx_graph_call_data(g, (cast: (@: c.Lmx) code), (cast: (@: c.Lmx) data), (cast: (int) (count = 1U)))
end: lmx_graph_eval_explicit_call

fn: lmx_graph_call_data (@: g c.LmxGraph; @: given_code c.Lmx; @: given_data c.Lmx; int: shorthand) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    # A reference to a Structure or a callable stands for its target as the code or the data (lmx_graph_target).
    @: code c.Lmx (cast: (@: c.Lmx) c.lmx_graph_target(g, (cast: (@: void) given_code)))
    @: data c.Lmx (cast: (@: c.Lmx) c.lmx_graph_target(g, (cast: (@: void) given_data)))
    c.LmxActivation: activation
    c.LmxGraphFrame: frame
    @: returned void 0
    size_t: slot 0U
    size_t: i 0U
    int: number 0
    int: status 0
    if: c.lmx_graph_kind(g, (cast: (@: void) code)) != 4
        return: 5
    if: shorthand != 0
        if: c.lmx_graph_method(g, code) != 0
            data: c.lmx_graph_method_var(g, code)
        else:
            slot: c.lmx_graph_named(g, code, state\w_var)
            data: (cast: (@: c.Lmx) c.lmx_graph_get(code, slot))
            i: slot + 1U
            while: i < c.lmx_graph_count(code)
                if: c.lmx_graph_slot_name(g, code, i) = state\w_var
                    return: 3
                i: i + 1U
            ---
        ---
    ---
    if: (data != 0 || shorthand = 0) && c.lmx_graph_kind(g, (cast: (@: void) data)) != 4
        return: 5
    # Callable arguments retain their own contract; this explicit nullary form has no actual arguments.
    if: c.lmx_graph_method(g, code) != 0
        return: lmx_graph_invoke_data(g, code, data, 0, 0U, 0, @ number)
    status: lmx_graph_work_flush(g)
    if: status != 0
        return: status
    if: code\native != 0
        return: c.lmx_call_prim(g\arena, code, data, 0, 0U, (cast: (@: void) @ number), @ returned)
    status: c.lmx_activation_push(g\arena, @ activation, 2, code, 0, 0, 0U, 0)
    if: status = 0
        status: lmx_graph_work_open_data(g, code, data, @ frame)
        if: status = 0
            status: lmx_graph_method_run(g, code, @ number)
            status: lmx_graph_work_finish(g, @ frame, status)
        ---
        c.lmx_activation_pop(g\arena, @ activation)
    ---
    return: status
end: lmx_graph_call_data

# ---- merge in the clean graph (the book, composition and whole-arguments; kernel §6.4) -----------------------------
# The author 2026-11-08 (LMX_blog/2026-11-08.md): a head naming a function is applied once and its result is the
# operand -- a slot of the model never intercepts the call; a Frame whose head names no function describes a structure.
# Operands are evaluated once, left to right, by their general meaning; their composition is one kernel operation
# (lmx_graph_merge_values) shared by the interpreter and native code.

# A word of the language: the state's words, none of which names a place.
fn: lmx_graph_language_word (@: state c.LmxGraphState; @: word char) int
    if: state = 0 || word = 0
        return: 0
    if: word = state\w_int || word = state\w_plus || word = state\w_minus || word = state\w_star || word = state\w_slash || word = state\w_percent || word = state\w_at || word = state\w_deref || word = state\w_fn || word = state\w_sub || word = state\w_assign || word = state\w_return || word = state\w_call || word = state\w_var
        return: 1
    if: word = state\w_eq || word = state\w_ne || word = state\w_lt || word = state\w_le || word = state\w_gt || word = state\w_ge || word = state\w_and || word = state\w_or || word = state\w_not || word = state\w_if || word = state\w_else || word = state\w_while || word = state\w_for || word = state\w_break
        return: 1
    if: word = state\w_continue || word = state\w_redo || word = state\w_until || word = state\w_finally || word = state\w_merge || word = state\w_include || word = state\w_predef || word = state\w_fm
        return: 1
    return: 0
end: lmx_graph_language_word

# A written field of an anonymous Structure in this subset, by its form only: `name: value` (the Frame [name, value],
# 1), `int: name value` or `int: name` (2). Its name word and value (0 for none) in the outs; 0 for any other form. The
# role of the head is decided by the resolution of the caller.
fn: lmx_graph_literal_field (@: g c.LmxGraph; @: raw void; @@: name char; @@: value void) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: field c.Lmx 0
    @: head char 0
    size_t: n 0U
    int: kind 0
    name[0]: 0
    value[0]: 0
    if: g = 0 || state = 0
        return: 0
    kind: c.lmx_graph_kind(g, raw)
    # A declaration of an int place in the Structure is that place (§3.2): `int: name value` or `int: name`.
    if: kind = 1 || kind = 3
        if: kind = 3
            name[0]: c.lmx_graph_name_of(g, c.lmx_arena_pointer_void_read(raw))
        else:
            name[0]: c.lmx_graph_name_of(g, raw)
            value[0]: raw
        ---
        if: name[0] = 0 || lmx_graph_language_word(state, name[0]) != 0
            return: 0
        return: 2
    if: kind != 4
        return: 0
    field: (cast: (@: c.Lmx) raw)
    n: c.lmx_graph_count(field)
    head: c.lmx_graph_name_of(g, raw)
    if: head = 0
        return: 0
    if: head = state\w_int
        if: n != 1U && n != 2U
            return: 0
        name[0]: c.lmx_graph_word_text(g, c.lmx_graph_get(field, 0U))
        if: name[0] = 0 || lmx_graph_language_word(state, name[0]) != 0
            return: 0
        if: n = 2U
            value[0]: c.lmx_graph_get(field, 1U)
        return: 2
    if: n != 1U || lmx_graph_language_word(state, head) != 0
        return: 0
    name[0]: head
    value[0]: c.lmx_graph_get(field, 0U)
    return: 1
end: lmx_graph_literal_field

# An anonymous Structure written as an operand of merge (the book, whole-arguments: the inner parentheses form a
# Structure with the field a): an unnamed Lmx all of whose fields are written fields of this subset, the empty one
# included. `name: value` whose head names a callable is that application, so such an Lmx is no literal. 1 or 0.
fn: lmx_graph_merge_literal (@: g c.LmxGraph; @: scope c.Lmx; @: raw void) int
    @: literal c.Lmx 0
    @: name char 0
    @: value void 0
    size_t: i 0U
    int: form 0
    if: g = 0 || c.lmx_graph_kind(g, raw) != 4 || c.lmx_graph_name_of(g, raw) != 0
        return: 0
    literal: (cast: (@: c.Lmx) raw)
    if: c.lmx_graph_method(g, literal) != 0
        return: 0
    while: i < c.lmx_graph_count(literal)
        form: lmx_graph_literal_field(g, c.lmx_graph_get(literal, i), @ name, @ value)
        if: form = 0
            return: 0
        if: form = 1 && c.lmx_graph_method(g, (cast: (@: c.Lmx) lmx_graph_resolve(g, scope, name))) != 0
            return: 0
        i: i + 1U
    ---
    return: 1
end: lmx_graph_merge_literal

# A bare operand of merge describing a structure: a Frame whose head word names no callable, such as `v: 9` for an
# unknown v (the author 2026-11-08: such a Frame may simply describe a structure; expressions are structures in the tree
# too). It is that structure, not a supply of a model slot. Its fields are unnamed (the head word and the arguments), and
# how unnamed fields compose is the open part asked of the author with the fn/return parts: both consumers refuse it with
# the form answer (5). 1 or 0.
fn: lmx_graph_merge_description (@: g c.LmxGraph; @: scope c.Lmx; @: raw void) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: frame c.Lmx 0
    @: head char 0
    if: g = 0 || state = 0 || c.lmx_graph_kind(g, raw) != 4
        return: 0
    frame: (cast: (@: c.Lmx) raw)
    head: c.lmx_graph_name_of(g, raw)
    if: c.lmx_graph_count(frame) < 1U || head = 0 || lmx_graph_language_word(state, head) != 0
        return: 0
    if: c.lmx_graph_method(g, (cast: (@: c.Lmx) c.lmx_graph_target(g, lmx_graph_resolve(g, scope, head)))) != 0
        return: 0
    return: 1
end: lmx_graph_merge_description

# The value of a written anonymous Structure: a new Structure with one place per written field, in order (the book,
# composition of place and value: an unknown name is defined by its field; `int: a 5` and `a: int: 5` bind alike). A
# name that already resolves -- an assignment or a call under the normal rules -- and a name repeated in the literal are
# open in this subset (5). The places come from lmx_graph_merge_literal_put. 0 and the Structure in out.
fn: lmx_graph_merge_literal_open (@: g c.LmxGraph; @: scope c.Lmx; @: literal c.Lmx; @@: out void) int
    @: name char 0
    @: other char 0
    @: value void 0
    @: made c.Lmx 0
    size_t: n 0U
    size_t: i 0U
    size_t: j 0U
    int: form 0
    if: out = 0 || lmx_graph_merge_literal(g, scope, (cast: (@: void) literal)) = 0
        return: 5
    out[0]: 0
    n: c.lmx_graph_count(literal)
    while: i < n
        form: lmx_graph_literal_field(g, c.lmx_graph_get(literal, i), @ name, @ value)
        if: lmx_graph_resolve(g, scope, name) != 0
            return: 5
        j: 0U
        while: j < i
            form: lmx_graph_literal_field(g, c.lmx_graph_get(literal, j), @ other, @ value)
            if: other = name
                return: 5
            j: j + 1U
        ---
        i: i + 1U
    ---
    made: c.lmx_graph_lmx(g, 0, n)
    if: made = 0
        return: 4
    out[0]: (cast: (@: void) made)
    return: 0
end: lmx_graph_merge_literal_open

# The place of written field index of the constructed literal: a new int place holding the value's int (a literal of the
# code is not shared with a place, §3.2) or, for `int: name`, a place without a value; named at its cell. 0; 4 for the
# value of `int: name value` that has no int, or without memory; 5 for `name: value` with a value of another kind (open).
fn: lmx_graph_merge_literal_put (@: g c.LmxGraph; @: literal c.Lmx; @: made c.Lmx; size_t: index; @: value void) int
    @: name char 0
    @: written void 0
    @: place void 0
    @: cell void 0
    int: form 0
    int: number 0
    if: g = 0 || literal = 0 || made = 0 || index >= c.lmx_graph_count(literal) || index >= c.lmx_graph_count(made)
        return: 5
    form: lmx_graph_literal_field(g, c.lmx_graph_get(literal, index), @ name, @ written)
    if: form = 0
        return: 5
    if: written = 0
        place: c.lmx_graph_uninit_int(g)
        if: place = 0
            return: 4
        cell: c.lmx_arena_pointer_void_read(place)
    else:
        if: form = 1 && c.lmx_graph_kind(g, value) = 5
            # `name: @x` defines a reference place: a new int reference to the same cell, not the evaluated one.
            place: c.lmx_graph_ref_int(g, c.lmx_arena_pointer_void_read(value))
            cell: place
        else:
            if: c.lmx_graph_value_int(g, value, @ number) != 0
                if: form = 2
                    return: 4
                return: 5
            ---
            place: c.lmx_graph_int(g, number)
            cell: place
        ---
    ---
    if: place = 0 || cell = 0 || c.lmx_graph_name_address(g, cell, name) != 0 || c.lmx_graph_put(made, index, place) != 0
        return: 4
    return: 0
end: lmx_graph_merge_literal_put

# The used graph of the operands admits the copy: int places, int references, written names (word primitives),
# Structures -- callables included --, references to them and empty slots; another primitive kind is open (5). A written
# name or a callable resolves names through its lexical chain, so then chain is 1 and the copy takes the needed lexical
# ancestors along. 4 for an operand that is no Structure, or without memory. The visited set is this check's.
fn: lmx_graph_merge_check (@: g c.LmxGraph; @@: values void; size_t: n; @: chain int) int
    @@: seen c.Lmx 0
    @: current c.Lmx 0
    @: value void 0
    size_t: count 0U
    size_t: cap 0U
    size_t: at 0U
    size_t: i 0U
    int: kind 0
    int: status 0
    chain[0]: 0
    while: i < n && status = 0
        kind: c.lmx_graph_kind(g, values[i])
        if: kind != 4
            status: 4
        else:
            if: c.lmx_graph_scan_add(@ seen, @ count, @ cap, (cast: (@: c.Lmx) values[i])) != 0
                status: 4
            ---
        ---
        i: i + 1U
    ---
    while: at < count && status = 0
        current: seen[at]
        at: at + 1U
        if: c.lmx_graph_method(g, current) != 0
            chain[0]: 1
        i: 0U
        while: i < c.lmx_graph_count(current) && status = 0
            value: c.lmx_graph_get(current, i)
            kind: c.lmx_graph_kind(g, value)
            if: kind = 3 || kind = 5
                if: c.lmx_graph_kind(g, c.lmx_arena_pointer_void_read(value)) != 1
                    status: 5
                ---
            else:
                # A reference to a Structure or a callable: its target belongs to the used graph too.
                if: kind = 4 || kind = 6
                    if: c.lmx_graph_scan_add(@ seen, @ count, @ cap, (cast: (@: c.Lmx) c.lmx_graph_target(g, value))) != 0
                        status: 4
                    ---
                else:
                    if: kind = 2
                        chain[0]: 1
                    else:
                        if: kind != 1 && value != 0
                            status: 5
                        ---
                    ---
                ---
            ---
            i: i + 1U
        ---
    ---
    c.free((cast: (@: void) seen))
    return: status
end: lmx_graph_merge_check

# The copy of one value reached by merge through the one map (kernel §6.4): an int place keeps its form (a direct cell;
# a place without a value as its copied cell and a new pointer of the same type), an int reference points at the copy of
# its cell, a reference to an Lmx at the copy of its target (the operand root's copy is R, a cycle meets its copy), a data
# Structure gets a new Lmx of its count whose slots the caller fills from the work list; the copies'
# name rows keep the canonical names. A value already copied answers its copy. 0 and the copy in out; 4 without memory;
# 5 for a kind whose copy is open.
fn: lmx_graph_merge_copy (@: g c.LmxGraph; @: map c.LmxCopyMap; @: value void; @@@: work c.Lmx; @: count size_t; @: cap size_t; @@: out void) int
    @: copy void 0
    @: referent void 0
    @: target void 0
    @: name char 0
    int: kind 0
    int: number 0
    int: status 0
    out[0]: 0
    if: value = 0
        return: 0
    copy: c.lmx_copy_map_get(map, value)
    if: copy != 0
        out[0]: copy
        return: 0
    kind: c.lmx_graph_kind(g, value)
    if: kind = 1
        if: c.lmx_graph_value_int(g, value, @ number) != 0
            return: 4
        copy: c.lmx_graph_int(g, number)
    else:
        if: kind = 3 || kind = 5 || kind = 6
            referent: c.lmx_arena_pointer_void_read(value)
            if: (kind = 6 && c.lmx_graph_kind(g, referent) != 4) || (kind != 6 && c.lmx_graph_kind(g, referent) != 1)
                return: 5
            status: lmx_graph_merge_copy(g, map, referent, work, count, cap, @ target)
            if: status != 0
                return: status
            if: kind = 3
                copy: c.lmx_graph_uninit_int_at(g, target)
            else:
                if: kind = 5
                    copy: c.lmx_graph_ref_int(g, target)
                else:
                    copy: c.lmx_graph_ref_lmx(g, (cast: (@: c.Lmx) target))
                ---
            ---
        else:
            if: kind = 2
                copy: c.lmx_graph_word_of(g, c.lmx_graph_word_text(g, value))
            else:
                # A Structure, a callable included: a new Lmx of its count, filled from the work list. The new Lmx has no
                # native entry; reusing one needs a proven compatible contract (L2 §13), so a copied callable is
                # dispatched by the interpreter.
                if: kind != 4
                    return: 5
                copy: (cast: (@: void) c.lmx_graph_lmx(g, 0, c.lmx_graph_count((cast: (@: c.Lmx) value))))
                if: copy != 0 && c.lmx_graph_scan_add(work, count, cap, (cast: (@: c.Lmx) value)) != 0
                    return: 4
                ---
            ---
        ---
    ---
    if: copy = 0
        return: 4
    name: c.lmx_graph_name_of(g, value)
    if: name != 0 && c.lmx_graph_name_address(g, copy, name) != 0
        return: 4
    if: c.lmx_copy_map_put(map, value, copy) != 0
        return: 4
    out[0]: copy
    return: 0
end: lmx_graph_merge_copy

# A named field of a later operand written into the slot of the result it names, as at an assignment: an int place takes
# the field's int and the same cell is written (§3.2); a word place takes a later word. 4 for a field without an int; 5
# when the slot holds no int or word place (replacing a Structure or a reference slot is open, except the composed parts
# of a callable, lmx_graph_merge_level).
fn: lmx_graph_merge_write (@: g c.LmxGraph; @: result c.Lmx; size_t: slot; @: value void) int
    @: word void 0
    @: name char 0
    int: kind c.lmx_graph_kind(g, c.lmx_graph_get(result, slot))
    int: number 0
    # A word place takes the later word: a new word cell named as the place (a word cell holds its spelling, §4).
    if: kind = 2 && c.lmx_graph_kind(g, value) = 2
        name: c.lmx_graph_slot_name(g, result, slot)
        word: c.lmx_graph_word_of(g, c.lmx_graph_word_text(g, value))
        if: word = 0 || (name != 0 && c.lmx_graph_name_address(g, word, name) != 0) || c.lmx_graph_put(result, slot, word) != 0
            return: 4
        return: 0
    if: kind != 1 && kind != 3
        return: 5
    if: c.lmx_graph_value_int(g, value, @ number) != 0
        return: 4
    if: c.lmx_graph_assign_int(g, result, result, slot, number) != 0
        return: 4
    return: 0
end: lmx_graph_merge_write

# A later field that names an int place of the result it does not provide is that place in the one source -> copy map
# (the review of 325): its value answers the result's place and its cell -- the cell behind a place without a value
# included -- the result's cell, so a reference to it reached by the copy goes to the result's place. A source already
# mapped keeps its first copy. 0, or 4 without memory.
fn: lmx_graph_merge_alias (@: g c.LmxGraph; @: map c.LmxCopyMap; @: field void; @: place void) int
    @: cell void field
    @: target void place
    if: c.lmx_graph_kind(g, place) = 3
        target: c.lmx_arena_pointer_void_read(place)
    if: c.lmx_graph_kind(g, field) = 3
        if: c.lmx_copy_map_get(map, field) = 0 && c.lmx_copy_map_put(map, field, place) != 0
            return: 4
        cell: c.lmx_arena_pointer_void_read(field)
    ---
    if: c.lmx_copy_map_get(map, cell) = 0 && c.lmx_copy_map_put(map, cell, target) != 0
        return: 4
    return: 0
end: lmx_graph_merge_alias

# merge of evaluated operands (the book, composition; L2 §13; kernel §6.4). The result R has the layout of the model
# (operand 0), then the new fields in operand order; a named field of a later operand naming a slot of R is written into
# that slot by the admission of an assignment, any other is appended, so the model's field numbers do not move. One
# source -> copy map serves all operands: every operand root maps to R (the instance obtained by copying and
# composition), shared targets and cycles stay shared, the copies' name rows keep the canonical names, and a copied
# Structure's parent is the copy of its parent where that was copied. The order makes merged places one place: R's int
# places are copied first, then every later field naming one of them is that place in the map (lmx_graph_merge_alias),
# and only then are references, Structures and new fields copied, so a reference reaches R's place in any field order.
# A copy with written names or callables takes their needed lexical ancestors along, whole, through the same map up to
# parent 0, and R's parent is the copy of the model's parent; a copy without them resolves no name through a parent, so R
# has none (parent 0, which is no arena-root object). The place of execution never gives one. The operands stay
# unchanged. When the model is the Structure of fn or sub, its parts that later operands give as Structures are
# composed recursively by the same rules (lmx_graph_merge_level). 0 and R in out; 4 for an operand that is no Structure
# or a refused write; 5 for an open form.
fn: lmx_graph_merge_level (@: g c.LmxGraph; @: map c.LmxCopyMap; @@@: work c.Lmx; @: count size_t; @: cap size_t; @@@: nested c.Lmx; @: ncount size_t; @: ncap size_t; @@: values void; size_t: n; @@: out void) int
    @@: names char 0
    @@: first void 0
    @@: parts void 0
    @: from_k size_t 0
    @: from_j size_t 0
    @: composed int 0
    @: model c.Lmx 0
    @: operand c.Lmx 0
    @: result c.Lmx 0
    @: copy void 0
    @: held void 0
    @: part void 0
    @: name char 0
    size_t: m 0U
    size_t: room 0U
    size_t: total 0U
    size_t: i 0U
    size_t: j 0U
    size_t: k 0U
    size_t: p 0U
    size_t: slot 0U
    int: kind 0
    int: callable 0
    int: status 0
    out[0]: 0
    model: (cast: (@: c.Lmx) values[0])
    callable: c.lmx_graph_fn_result(g, values[0])
    m: c.lmx_graph_count(model)
    room: m
    k: 1U
    while: k < n
        room: room + c.lmx_graph_count((cast: (@: c.Lmx) values[k]))
        k: k + 1U
    ---
    names: (cast: (@@: char) c.calloc(room + 1U, sizeof(@: char)))
    first: (cast: (@@: void) c.calloc(room + 1U, sizeof(@: void)))
    parts: (cast: (@@: void) c.calloc(n + 1U, sizeof(@: void)))
    from_k: (cast: (@: size_t) c.calloc(room + 1U, sizeof(size_t)))
    from_j: (cast: (@: size_t) c.calloc(room + 1U, sizeof(size_t)))
    composed: (cast: (@: int) c.calloc(room + 1U, sizeof(int)))
    if: names = 0 || first = 0 || parts = 0 || from_k = 0 || from_j = 0 || composed = 0
        c.free((cast: (@: void) names))
        c.free((cast: (@: void) first))
        c.free((cast: (@: void) parts))
        c.free((cast: (@: void) from_k))
        c.free((cast: (@: void) from_j))
        c.free((cast: (@: void) composed))
        return: 4
    # The field set of R before its fixed Lmx, with the field that first provides each slot -- its value and its position
    # (operand, field), local data of this merge: the model's slots, then each named field of a later operand that names no
    # slot so far, in operand order. A later supply is told from the first fill by its position, not by its address: the
    # same source given again later (merge(M; N; M)) is written again in operand order. An unnamed field of a later operand
    # is matched by no name and is open here (5).
    while: i < m
        names[i]: c.lmx_graph_slot_name(g, model, i)
        first[i]: c.lmx_graph_get(model, i)
        from_k[i]: 0U
        from_j[i]: i
        i: i + 1U
    ---
    total: m
    k: 1U
    while: k < n && status = 0
        operand: (cast: (@: c.Lmx) values[k])
        j: 0U
        while: j < c.lmx_graph_count(operand) && status = 0
            name: c.lmx_graph_slot_name(g, operand, j)
            if: name = 0
                status: 5
            else:
                i: 0U
                while: i < total && names[i] != name
                    i: i + 1U
                ---
                if: i = total
                    names[total]: name
                    first[total]: c.lmx_graph_get(operand, j)
                    from_k[total]: k
                    from_j[total]: j
                    total: total + 1U
                ---
            ---
            j: j + 1U
        ---
        k: k + 1U
    ---
    if: status = 0
        result: c.lmx_graph_lmx(g, 0, total)
        if: result = 0
            status: 4
    ---
    k: 0U
    while: k < n && status = 0
        if: c.lmx_copy_map_put(map, values[k], (cast: (@: void) result)) != 0
            status: 4
        k: k + 1U
    ---
    # R's int places first: a slot whose first source is an int place gets its copy.
    i: 0U
    while: i < total && status = 0
        kind: c.lmx_graph_kind(g, first[i])
        if: kind = 1 || kind = 3
            status: lmx_graph_merge_copy(g, map, first[i], work, count, cap, @ copy)
            if: status = 0 && c.lmx_graph_put(result, i, copy) != 0
                status: 4
            ---
        ---
        i: i + 1U
    ---
    # Every later field naming an int place of R it does not provide is that place in the map.
    k: 1U
    while: k < n && status = 0
        operand: (cast: (@: c.Lmx) values[k])
        j: 0U
        while: j < c.lmx_graph_count(operand) && status = 0
            held: c.lmx_graph_get(operand, j)
            slot: c.lmx_graph_named(g, result, c.lmx_graph_slot_name(g, operand, j))
            kind: c.lmx_graph_kind(g, held)
            if: slot < total && (from_k[slot] != k || from_j[slot] != j) && (kind = 1 || kind = 3)
                kind: c.lmx_graph_kind(g, c.lmx_graph_get(result, slot))
                if: kind = 1 || kind = 3
                    status: lmx_graph_merge_alias(g, map, held, c.lmx_graph_get(result, slot))
                ---
            ---
            j: j + 1U
        ---
        k: k + 1U
    ---
    # The other slots by their first source: references, Structures and new fields now reach merged places. A part of the
    # Structure of fn or sub (lmx_graph_fn_result) that is a Structure -- directly or through a reference -- and that later
    # operands give again as Structures is the composition of those parts by this same level, through the same map (the
    # book, composition of the structural parts: `merge(f1; f2)` with a descriptor f2 gives the signature of both and the
    # body of f1); the slot keeps the model's form (a named reference stays one, to the composition).
    i: 0U
    while: i < total && status = 0
        if: c.lmx_graph_get(result, i) = 0 && first[i] != 0
            p: 0U
            if: callable != 0 && c.lmx_graph_kind(g, c.lmx_graph_target(g, first[i])) = 4
                parts[0]: c.lmx_graph_target(g, first[i])
                p: 1U
                k: 1U
                while: k < n
                    operand: (cast: (@: c.Lmx) values[k])
                    slot: c.lmx_graph_named(g, operand, names[i])
                    if: slot < c.lmx_graph_count(operand) && (from_k[i] != k || from_j[i] != slot) && c.lmx_graph_kind(g, c.lmx_graph_target(g, c.lmx_graph_get(operand, slot))) = 4
                        parts[p]: c.lmx_graph_target(g, c.lmx_graph_get(operand, slot))
                        p: p + 1U
                    ---
                    k: k + 1U
                ---
            ---
            if: p > 1U
                composed[i]: 1
                status: lmx_graph_merge_level(g, map, work, count, cap, nested, ncount, ncap, parts, p, @ part)
                if: status = 0 && c.lmx_graph_scan_add(nested, ncount, ncap, (cast: (@: c.Lmx) parts[0])) != 0
                    status: 4
                if: status = 0 && c.lmx_graph_kind(g, first[i]) = 6
                    part: c.lmx_graph_ref_lmx(g, (cast: (@: c.Lmx) part))
                    if: part = 0
                        status: 4
                    ---
                ---
                if: status = 0 && names[i] != 0 && c.lmx_graph_name_address(g, part, names[i]) != 0
                    status: 4
                if: status = 0 && c.lmx_graph_put(result, i, part) != 0
                    status: 4
                ---
            else:
                status: lmx_graph_merge_copy(g, map, first[i], work, count, cap, @ copy)
                if: status = 0 && c.lmx_graph_put(result, i, copy) != 0
                    status: 4
            ---
        ---
        i: i + 1U
    ---
    # The writes of later fields into the slots they name but do not provide, in operand order; a composed part was
    # given by its composition.
    k: 1U
    while: k < n && status = 0
        operand: (cast: (@: c.Lmx) values[k])
        j: 0U
        while: j < c.lmx_graph_count(operand) && status = 0
            held: c.lmx_graph_get(operand, j)
            i: 0U
            name: c.lmx_graph_slot_name(g, operand, j)
            while: i < total && names[i] != name
                i: i + 1U
            ---
            if: i < total && (from_k[i] != k || from_j[i] != j) && composed[i] = 0
                status: lmx_graph_merge_write(g, result, i, held)
            ---
            j: j + 1U
        ---
        k: k + 1U
    ---
    c.free((cast: (@: void) names))
    c.free((cast: (@: void) first))
    c.free((cast: (@: void) parts))
    c.free((cast: (@: void) from_k))
    c.free((cast: (@: void) from_j))
    c.free((cast: (@: void) composed))
    if: status = 0
        out[0]: (cast: (@: void) result)
    return: status
end: lmx_graph_merge_level

fn: lmx_graph_merge_values (@: g c.LmxGraph; @@: values void; size_t: n; @@: out void) int
    c.LmxCopyMap: map
    @@: work c.Lmx 0
    @@: nested c.Lmx 0
    @: model c.Lmx 0
    @: operand c.Lmx 0
    @: result c.Lmx 0
    @: child c.Lmx 0
    @: copy void 0
    @: name char 0
    size_t: count 0U
    size_t: cap 0U
    size_t: ncount 0U
    size_t: ncap 0U
    size_t: at 0U
    size_t: i 0U
    size_t: j 0U
    int: mapped 0
    int: chain 0
    int: status 0
    if: g = 0 || values = 0 || out = 0 || n = 0U
        return: 5
    out[0]: 0
    # An operand that is a reference to a Structure or a callable stands for its target, in both consumers (the operand
    # array is this evaluation's).
    while: i < n
        values[i]: c.lmx_graph_target(g, values[i])
        i: i + 1U
    ---
    status: lmx_graph_merge_check(g, values, n, @ chain)
    if: status != 0
        return: status
    model: (cast: (@: c.Lmx) values[0])
    if: c.lmx_copy_map_init(@ map) != 0
        return: 4
    mapped: 1
    status: lmx_graph_merge_level(g, @ map, @ work, @ count, @ cap, @ nested, @ ncount, @ ncap, values, n, @ copy)
    result: (cast: (@: c.Lmx) copy)
    # One operand: R is the copy of that root, so a named root's copy keeps its name row with the same name pointer
    # (kernel §5.1), and a copied lexical ancestor's slot of the root answers that name at R -- the body's own name
    # finds the copy. A new place for R is then a named reference to it (lmx_graph_define). A composition of several
    # roots is named by what receives it (`fn: new_name merge(f1, f2)`), not here.
    if: status = 0 && n = 1U
        name: c.lmx_graph_name_of(g, values[0])
        if: name != 0 && c.lmx_graph_name_address(g, (cast: (@: void) result), name) != 0
            status: 4
        ---
    ---
    # The lexical chain of a copy with written names or callables: the model's parent, the parent of the model of every
    # composed part and the source parent of every copied Structure are copied too, as ordinary Lmx through the same map,
    # whole -- their fields, references and cycles -- up to parent 0 (the book :1205-1207; kernel §6.4). Not the whole
    # arena: the reachable closure of what is copied. The source's mutable ancestors are never borrowed, and the place of
    # this merge gives no parent.
    if: status = 0 && chain != 0 && model\parent != 0
        status: lmx_graph_merge_copy(g, @ map, (cast: (@: void) model\parent), @ work, @ count, @ cap, @ copy)
    i: 0U
    while: i < ncount && status = 0
        if: chain != 0 && nested[i]\parent != 0
            status: lmx_graph_merge_copy(g, @ map, (cast: (@: void) nested[i]\parent), @ work, @ count, @ cap, @ copy)
        i: i + 1U
    ---
    at: 0U
    while: at < count && status = 0
        operand: work[at]
        child: (cast: (@: c.Lmx) c.lmx_copy_map_get(@ map, (cast: (@: void) operand)))
        j: 0U
        while: j < c.lmx_graph_count(operand) && status = 0
            status: lmx_graph_merge_copy(g, @ map, c.lmx_graph_get(operand, j), @ work, @ count, @ cap, @ copy)
            if: status = 0 && c.lmx_graph_put(child, j, copy) != 0
                status: 4
            ---
            j: j + 1U
        ---
        if: status = 0 && chain != 0 && operand\parent != 0
            status: lmx_graph_merge_copy(g, @ map, (cast: (@: void) operand\parent), @ work, @ count, @ cap, @ copy)
        at: at + 1U
    ---
    # Parent edges once every copy exists, a parent reached after its child included. R's parent is the copy of the
    # model's parent when the chain was needed, otherwise none; a composed part's is the copy of its model's parent.
    at: 0U
    while: at < count && status = 0
        operand: work[at]
        child: (cast: (@: c.Lmx) c.lmx_copy_map_get(@ map, (cast: (@: void) operand)))
        child\parent: (cast: (@: c.Lmx) c.lmx_copy_map_get(@ map, (cast: (@: void) operand\parent)))
        at: at + 1U
    ---
    i: 0U
    while: i < ncount && status = 0
        child: (cast: (@: c.Lmx) c.lmx_copy_map_get(@ map, (cast: (@: void) nested[i])))
        if: child != 0
            child\parent: (cast: (@: c.Lmx) c.lmx_copy_map_get(@ map, (cast: (@: void) nested[i]\parent)))
        i: i + 1U
    ---
    if: status = 0 && chain != 0
        child: (cast: (@: c.Lmx) c.lmx_copy_map_get(@ map, (cast: (@: void) model\parent)))
        if: child != result
            result\parent: child
        ---
    ---
    if: mapped != 0
        c.lmx_copy_map_dispose(@ map)
    c.free((cast: (@: void) work))
    c.free((cast: (@: void) nested))
    if: status = 0
        out[0]: (cast: (@: void) result)
    return: status
end: lmx_graph_merge_values

# One operand of merge, evaluated once in its order: the constructed value of a written anonymous Structure, or any other
# expression in its general meaning -- a name, a path, a nested merge, a call (a head naming a callable is applied once,
# whatever slot the model has). The description of a structure by a bare Frame is open (5). 0 and the value in out.
fn: lmx_graph_merge_operand (@: g c.LmxGraph; @: scope c.Lmx; @: raw void; @@: out void) int
    @: literal c.Lmx 0
    @: made void 0
    @: name char 0
    @: written void 0
    @: value void 0
    size_t: i 0U
    int: form 0
    int: status 0
    out[0]: 0
    if: lmx_graph_merge_literal(g, scope, raw) != 0
        literal: (cast: (@: c.Lmx) raw)
        status: lmx_graph_merge_literal_open(g, scope, literal, @ made)
        while: status = 0 && i < c.lmx_graph_count(literal)
            form: lmx_graph_literal_field(g, c.lmx_graph_get(literal, i), @ name, @ written)
            value: 0
            if: written != 0
                status: lmx_graph_eval_value(g, scope, written, @ value)
            ---
            if: status = 0
                status: lmx_graph_merge_literal_put(g, literal, (cast: (@: c.Lmx) made), i, value)
            ---
            i: i + 1U
        ---
        if: status = 0
            out[0]: made
        ---
        return: status
    if: lmx_graph_merge_description(g, scope, raw) != 0
        return: 5
    return: lmx_graph_eval_value(g, scope, raw, out)
end: lmx_graph_merge_operand

# merge(operand; ...): the operands once, left to right, then their composition. The operand array is this evaluation's.
fn: lmx_graph_eval_merge (@: g c.LmxGraph; @: scope c.Lmx; @: expression c.Lmx; @@: out void) int
    @@: values void 0
    size_t: n 0U
    size_t: i 0U
    int: status 0
    if: g = 0 || out = 0 || c.lmx_graph_count(expression) < 1U
        return: 5
    n: c.lmx_graph_count(expression)
    values: (cast: (@@: void) c.calloc(n + 1U, sizeof(@: void)))
    if: values = 0
        return: 4
    while: i < n && status = 0
        status: lmx_graph_merge_operand(g, scope, c.lmx_graph_get(expression, i), @ values[i])
        i: i + 1U
    ---
    if: status = 0
        status: lmx_graph_merge_values(g, values, n, out)
    c.free((cast: (@: void) values))
    return: status
end: lmx_graph_eval_merge

# For the body scan: the written fields of an anonymous Structure operand of merge define their names, never free inputs
# of the body; a value Lmx joins the scan queue and a value word is a read input.
fn: lmx_graph_work_scan_literal (@: g c.LmxGraph; @: frame c.LmxGraphFrame; @: literal c.Lmx; @@@: queue c.Lmx; @: count size_t; @: cap size_t) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: name char 0
    @: written void 0
    @: word char 0
    @: row c.LmxGraphWork 0
    size_t: i 0U
    int: form 0
    int: status 0
    while: i < c.lmx_graph_count(literal) && status = 0
        form: lmx_graph_literal_field(g, c.lmx_graph_get(literal, i), @ name, @ written)
        if: c.lmx_graph_kind(g, written) = 4
            status: c.lmx_graph_scan_add(queue, count, cap, (cast: (@: c.Lmx) written))
        else:
            word: c.lmx_graph_word_text(g, written)
            if: word != 0 && lmx_graph_language_word(state, word) = 0
                status: lmx_graph_work_capture(g, frame, word)
                row: lmx_graph_work_row(frame, word)
                if: status = 0 && row != 0 && row\slot != (cast: (size_t) -1)
                    row\loaded: row\loaded | 2
                ---
            ---
        ---
        i: i + 1U
    ---
    return: status
end: lmx_graph_work_scan_literal

# ---- The receivers fn and sub in a traversal (§3.4, §5.2; the author 2026-11-09) ---------------------------------
# The graph keeps a declaration `fn: name args return [var] body` as written: the Frame of the receiver fn, an Lmx named
# fn with its arguments. Each traversal -- the interpreter's run, a translation, a native run of an emitted program --
# begins with an empty namespace (lmx_graph_space_push) and applies the receiver: the Structure named by the value of
# the name argument with the parts args, return, var, body (sub: args, var, body) is created in this traversal and
# answers its name in the declaration's block. The namespace and its rows are freed at the end of the traversal, and the
# next traversal creates its own Structure from the written declaration; a Structure the program holds by an ordinary
# reference of the graph stays an ordinary live value (§5.2).

# The slot of lmx holding the place named name -- an int place, a place without a value, a reference place (a Frame
# named by its head is no place) --, or the count of its slots when none is.
fn: lmx_graph_place_slot (@: g c.LmxGraph; @: lmx c.Lmx; @: name char) size_t
    size_t: n c.lmx_graph_count(lmx)
    size_t: i 0U
    int: kind 0
    if: g = 0 || name = 0
        return: n
    while: i < n
        kind: c.lmx_graph_kind(g, c.lmx_graph_get(lmx, i))
        if: (kind = 1 || kind = 3 || kind = 5 || kind = 6) && c.lmx_graph_slot_name(g, lmx, i) = name
            return: i
        i: i + 1U
    ---
    return: n
end: lmx_graph_place_slot

# The own fields a body declares (the book :691, :695; the author 2026-11-08: every own field is visible from the first
# line): the names of the int places declared in the body and in its inline control bodies (if, else, while, for,
# until, finally; a for header) -- a place `int: name [literal]` or a Frame `int: name expression` --, never in a nested
# declaration or in the data of a call. Appended to names without duplicates; the list belongs to this construction.
# 0, or 1 without memory.
fn: lmx_graph_fn_own (@: g c.LmxGraph; @: value void; @@@: names char; @: count size_t; @: capacity size_t) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: current c.Lmx 0
    @: head char 0
    @: name char 0
    @@: grown char 0
    size_t: i 0U
    size_t: j 0U
    int: kind c.lmx_graph_kind(g, value)
    int: status 0
    if: kind = 1
        name: c.lmx_graph_name_of(g, value)
    else:
        if: kind = 3
            name: c.lmx_graph_name_of(g, c.lmx_arena_pointer_void_read(value))
        else:
            if: kind != 4
                return: 0
            current: (cast: (@: c.Lmx) value)
            head: c.lmx_graph_name_of(g, value)
            if: head = state\w_int
                name: c.lmx_graph_word_text(g, c.lmx_graph_get(current, 0U))
            else:
                if: head != 0 && head != state\w_if && head != state\w_else && head != state\w_while && head != state\w_for && head != state\w_until && head != state\w_finally
                    return: 0
                while: i < c.lmx_graph_count(current) && status = 0
                    status: lmx_graph_fn_own(g, c.lmx_graph_get(current, i), names, count, capacity)
                    i: i + 1U
                ---
                return: status
            ---
        ---
    ---
    if: name = 0
        return: 0
    while: j < count[0] && names[0][j] != name
        j: j + 1U
    ---
    if: j < count[0]
        return: 0
    if: count[0] = capacity[0]
        grown: (cast: (@@: char) c.realloc((cast: (@: void) names[0]), (capacity[0] * 2U + 8U) * sizeof(@: char)))
        if: grown = 0
            return: 1
        names[0]: grown
        capacity[0]: capacity[0] * 2U + 8U
    ---
    names[0][count[0]]: name
    count[0]: count[0] + 1U
    return: 0
end: lmx_graph_fn_own

# The var of the Structure fn/sub creates: a new Lmx under it, named var, holding the copy of the fields of the written
# var -- through one source -> copy map in which the written var is the new var, so that the places, references and
# Structures of the written var keep their sharing, nesting and cycles in the copy, and the needed lexical ancestors of
# what it reaches come along as in merge (kernel §6.4) -- and then a new place
# without a value for every own field of the body that is no formal and no field of the written var. The set of fields is known before the Lmx is made; no initializer runs here
# (they run at their written places). 0 and the var in out; 1 without memory; 4 or 5 for a written field whose copy is
# refused or open (lmx_graph_merge_copy).
fn: lmx_graph_fn_var (@: g c.LmxGraph; @: owner c.Lmx; @: args c.Lmx; @: written c.Lmx; @: body c.Lmx; @@: out c.Lmx) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    c.LmxCopyMap: map
    @@: work c.Lmx 0
    @@: names char 0
    @: vars c.Lmx 0
    @: copy void 0
    @: child c.Lmx 0
    @: operand c.Lmx 0
    @: place void 0
    @: source void (cast: (@: void) written)
    size_t: capacity 0U
    size_t: explicit 0U
    size_t: own 0U
    size_t: kept 0U
    size_t: wcount 0U
    size_t: wcap 0U
    size_t: at 0U
    size_t: i 0U
    size_t: j 0U
    int: status 0
    int: mapped 0
    int: chain 0
    out[0]: 0
    if: written != 0
        explicit: c.lmx_graph_count(written)
    capacity: explicit + 8U
    names: (cast: (@@: char) c.calloc(capacity, sizeof(@: char)))
    if: names = 0
        return: 1
    # The own fields are those the statements of the body declare, whatever Structure holds them (the body of a written
    # declaration is anonymous; the part body of a prepared Structure is its Frame `body: (...)`).
    while: body != 0 && i < c.lmx_graph_count(body) && status = 0
        status: lmx_graph_fn_own(g, c.lmx_graph_get(body, i), @ names, @ own, @ capacity)
        i: i + 1U
    ---
    i: 0U
    while: i < own && status = 0
        if: c.lmx_graph_formal(g, args, names[i]) >= c.lmx_graph_count(args) && (written = 0 || c.lmx_graph_formal(g, written, names[i]) >= explicit)
            names[kept]: names[i]
            kept: kept + 1U
        ---
        i: i + 1U
    ---
    if: status = 0
        vars: c.lmx_graph_lmx(g, owner, explicit + kept)
        if: vars = 0 || c.lmx_graph_name_address(g, (cast: (@: void) vars), state\w_var) != 0
            status: 1
        ---
    ---
    # The used graph of the written var admits the copy and tells whether it resolves names through a lexical chain
    # (written names or callables), as for merge (lmx_graph_merge_check).
    if: status = 0 && explicit != 0
        status: lmx_graph_merge_check(g, @ source, 1U, @ chain)
        if: status = 4
            status: 1
        ---
    ---
    if: status = 0 && explicit != 0
        if: c.lmx_copy_map_init(@ map) != 0
            status: 1
        else:
            mapped: 1
            # The written var is the new var in the map before any field is copied (as an operand root is its result in
            # lmx_graph_merge_values): a reference to the written var, or a cycle through it, reaches the new var.
            if: c.lmx_copy_map_put(@ map, (cast: (@: void) written), (cast: (@: void) vars)) != 0
                status: 1
            ---
        ---
    ---
    i: 0U
    while: i < explicit && status = 0
        status: lmx_graph_merge_copy(g, @ map, c.lmx_graph_get(written, i), @ work, @ wcount, @ wcap, @ copy)
        if: status = 0 && c.lmx_graph_put(vars, i, copy) != 0
            status: 1
        i: i + 1U
    ---
    while: at < wcount && status = 0
        operand: work[at]
        child: (cast: (@: c.Lmx) c.lmx_copy_map_get(@ map, (cast: (@: void) operand)))
        j: 0U
        while: j < c.lmx_graph_count(operand) && status = 0
            status: lmx_graph_merge_copy(g, @ map, c.lmx_graph_get(operand, j), @ work, @ wcount, @ wcap, @ copy)
            if: status = 0 && c.lmx_graph_put(child, j, copy) != 0
                status: 1
            j: j + 1U
        ---
        # A copied Structure whose source parent lies outside the written var -- a Structure the var reaches by a
        # reference -- takes that parent along when the copy resolves names through its chain: the parent is copied
        # through the same map, whole, up to parent 0 (kernel §6.4, as lmx_graph_merge_values); the written var's own
        # place in such a parent is the new var.
        if: status = 0 && chain != 0 && operand\parent != 0
            status: lmx_graph_merge_copy(g, @ map, (cast: (@: void) operand\parent), @ work, @ wcount, @ wcap, @ copy)
        at: at + 1U
    ---
    # Parent edges once every copy exists, as in merge: a copied Structure keeps the nesting of its source -- its parent is
    # the copy of its source's parent, the written var's children the new var's --; a source parent is none only when the
    # copy needs no chain (no written name or callable). The new var itself is under F, whose lexical chain it has.
    at: 0U
    while: at < wcount && status = 0
        operand: work[at]
        child: (cast: (@: c.Lmx) c.lmx_copy_map_get(@ map, (cast: (@: void) operand)))
        if: child != 0
            child\parent: (cast: (@: c.Lmx) c.lmx_copy_map_get(@ map, (cast: (@: void) operand\parent)))
        at: at + 1U
    ---
    i: 0U
    while: i < kept && status = 0
        place: c.lmx_graph_uninit_int(g)
        if: place = 0 || c.lmx_graph_name_address(g, c.lmx_arena_pointer_void_read(place), names[i]) != 0 || c.lmx_graph_put(vars, explicit + i, place) != 0
            status: 1
        i: i + 1U
    ---
    if: mapped != 0
        c.lmx_copy_map_dispose(@ map)
    c.free((cast: (@: void) work))
    c.free((cast: (@: void) names))
    if: status = 0
        out[0]: vars
    return: status
end: lmx_graph_fn_var

# The Structure the receiver fn or sub creates from its arguments (the author 2026-11-09: in the namespace of the
# traversal the structure name(args(), return(), var(), body()), by the rule by which `int: i 5` creates i): an Lmx of
# the FN pool role (§2.2 lmx:result) under the declaration, named by the value of the name argument, with the fields
# args, return (fn), var and body (none in a descriptor). A Structure part is a reference to that argument, named by the
# part -- the argument keeps its address, parent and namelessness (the reference's name is the reference's); the word of
# a result requirement is its own word cell, as every primitive place has its own cell; var is lmx_graph_fn_var. The
# native entry a translation installed on the declaration is the entry of what it creates (no other native code
# exists: the Structures a running program creates otherwise are interpreted). 0 and the Structure in out; 1 without
# memory; 5 for an argument of another kind.
fn: lmx_graph_fn_make (@: g c.LmxGraph; @: decl c.Lmx; @: name char; @: args c.Lmx; @: result void; @: written c.Lmx; @: body c.Lmx; int: with_result; @@: out c.Lmx) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: made c.Lmx 0
    @: vars c.Lmx 0
    @: part void 0
    size_t: count 2U
    size_t: at 0U
    int: status 0
    out[0]: 0
    if: g = 0 || state = 0 || decl = 0 || name = 0 || c.lmx_graph_kind(g, (cast: (@: void) args)) != 4
        return: 5
    if: (body != 0 && c.lmx_graph_kind(g, (cast: (@: void) body)) != 4) || (written != 0 && c.lmx_graph_kind(g, (cast: (@: void) written)) != 4)
        return: 5
    if: with_result != 0
        count: count + 1U
        if: c.lmx_graph_kind(g, result) != 2 && c.lmx_graph_kind(g, result) != 4
            return: 5
        ---
    ---
    if: body != 0
        count: count + 1U
    made: (cast: (@: c.Lmx) c.lmx_struct_new_role_profiled(decl, g\arena, 0, c.LMX_POOL_ROLE_FN))
    if: made = 0 || c.lmx_arena_refs_open_owned(g\arena, made, count) != 0 || c.lmx_graph_name_address(g, (cast: (@: void) made), name) != 0
        return: 1
    part: c.lmx_graph_ref_lmx(g, args)
    if: part = 0 || c.lmx_graph_name_address(g, part, state\w_args) != 0 || c.lmx_graph_put(made, at, part) != 0
        return: 1
    at: at + 1U
    if: with_result != 0
        if: c.lmx_graph_kind(g, result) = 2
            part: c.lmx_graph_word_of(g, c.lmx_graph_word_text(g, result))
        else:
            part: c.lmx_graph_ref_lmx(g, (cast: (@: c.Lmx) result))
        ---
        if: part = 0 || c.lmx_graph_name_address(g, part, state\w_return) != 0 || c.lmx_graph_put(made, at, part) != 0
            return: 1
        at: at + 1U
    ---
    status: lmx_graph_fn_var(g, made, args, written, body, @ vars)
    if: status != 0
        return: status
    if: c.lmx_graph_put(made, at, (cast: (@: void) vars)) != 0
        return: 1
    at: at + 1U
    if: body != 0
        part: c.lmx_graph_ref_lmx(g, body)
        if: part = 0 || c.lmx_graph_name_address(g, part, state\w_body) != 0 || c.lmx_graph_put(made, at, part) != 0
            return: 1
        ---
    ---
    made\native: decl\native
    out[0]: made
    return: 0
end: lmx_graph_fn_make

# Is decl (a Frame named fn or sub) a declaration with written arguments -- a positional form of the receiver's contract
# whose Structure arguments are anonymous Structures as written: fn [name, args, return], [name, args, return, body],
# [name, args, return, var, body]; sub [name, args, body], [name, args, var, body]? Its Structure is created when its
# block is entered (lmx_graph_space_declarations) and answers in the whole block (the book :435). A form whose arguments
# the traversal computes -- the whole prepared Structure, a name with a Structure of the parts -- is applied where the
# traversal reaches it (lmx_graph_fn_apply). 1 or 0.
fn: lmx_graph_fn_written (@: g c.LmxGraph; @: decl c.Lmx) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: head char 0
    @: part void 0
    size_t: n 0U
    size_t: first 2U
    size_t: i 1U
    if: g = 0 || state = 0 || c.lmx_graph_kind(g, (cast: (@: void) decl)) != 4
        return: 0
    head: c.lmx_graph_name_of(g, (cast: (@: void) decl))
    n: c.lmx_graph_count(decl)
    if: head = state\w_fn
        if: n < 3U || n > 5U
            return: 0
        ---
        first: 3U
    else:
        if: head != state\w_sub || n < 3U || n > 4U
            return: 0
        ---
    ---
    if: c.lmx_graph_kind(g, c.lmx_graph_get(decl, 0U)) != 2
        return: 0
    # args, and var and body after the result of fn: anonymous Structures as written.
    while: i < n
        if: i = 1U || i >= first
            part: c.lmx_graph_get(decl, i)
            if: c.lmx_graph_kind(g, part) != 4 || c.lmx_graph_name_of(g, part) != 0
                return: 0
            ---
        ---
        i: i + 1U
    ---
    return: 1
end: lmx_graph_fn_written

# The receiver fn or sub applied to the arguments of its declaration Frame in the positions of its contract -- fn: [name,
# args, return] (the interface descriptor), [name, args, return, body], [name, args, return, var, body]; sub: [name,
# args, body], [name, args, var, body] --: the Structure it creates (lmx_graph_fn_make) answers the name in the block
# scope of this traversal, then the declarations of its body answer theirs in the body's block. The receiver's other
# forms -- the whole argument structure, and a name with a Structure of the parts (the author 2026-11-09: receivers with
# different numbers of arguments have one name) -- are applied where the traversal reaches them (lmx_graph_fn_apply).
# 0, 1 without memory, 5 for another form.
fn: lmx_graph_space_declare (@: g c.LmxGraph; @: scope c.Lmx; @: decl c.Lmx) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: head char c.lmx_graph_name_of(g, (cast: (@: void) decl))
    @: name char c.lmx_graph_word_text(g, c.lmx_graph_get(decl, 0U))
    @: args c.Lmx 0
    @: result void 0
    @: written c.Lmx 0
    @: body c.Lmx 0
    @: made c.Lmx 0
    size_t: n c.lmx_graph_count(decl)
    int: with_result 0
    int: status 0
    if: state = 0 || name = 0 || n < 3U
        return: 5
    args: (cast: (@: c.Lmx) c.lmx_graph_get(decl, 1U))
    if: head = state\w_fn
        with_result: 1
        result: c.lmx_graph_get(decl, 2U)
        if: n = 4U
            body: (cast: (@: c.Lmx) c.lmx_graph_get(decl, 3U))
        if: n = 5U
            written: (cast: (@: c.Lmx) c.lmx_graph_get(decl, 3U))
            body: (cast: (@: c.Lmx) c.lmx_graph_get(decl, 4U))
        ---
        if: n > 5U
            return: 5
        ---
    else:
        if: n = 3U
            body: (cast: (@: c.Lmx) c.lmx_graph_get(decl, 2U))
        if: n = 4U
            written: (cast: (@: c.Lmx) c.lmx_graph_get(decl, 2U))
            body: (cast: (@: c.Lmx) c.lmx_graph_get(decl, 3U))
        ---
        if: n > 4U
            return: 5
    ---
    # The Structure arguments as written: anonymous Structures (a Frame there is another form of the contract).
    if: c.lmx_graph_kind(g, (cast: (@: void) args)) != 4 || c.lmx_graph_name_of(g, (cast: (@: void) args)) != 0
        return: 5
    if: body != 0 && (c.lmx_graph_kind(g, (cast: (@: void) body)) != 4 || c.lmx_graph_name_of(g, (cast: (@: void) body)) != 0)
        return: 5
    if: written != 0 && (c.lmx_graph_kind(g, (cast: (@: void) written)) != 4 || c.lmx_graph_name_of(g, (cast: (@: void) written)) != 0)
        return: 5
    status: lmx_graph_fn_make(g, decl, name, args, result, written, body, with_result, @ made)
    if: status != 0
        return: status
    if: c.lmx_graph_space_put(scope, name, (cast: (@: void) made)) != 0
        return: 1
    if: body != 0
        status: lmx_graph_space_declarations(g, body)
    return: status
end: lmx_graph_space_declare

# Every declaration Frame of fn or sub with written arguments (lmx_graph_fn_written) among the fields of a block creates
# its Structure in this traversal before the block runs: the names of fn and sub are visible in both directions of their
# block (the book :435). The receiver applied to arguments the traversal computes creates its Structure where the
# traversal reaches it (lmx_graph_fn_apply), and the name answers from there on.
fn: lmx_graph_space_declarations (@: g c.LmxGraph; @: block c.Lmx) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: value void 0
    @: head char 0
    size_t: i 0U
    int: status 0
    while: i < c.lmx_graph_count(block) && status = 0
        value: c.lmx_graph_get(block, i)
        head: c.lmx_graph_name_of(g, value)
        if: c.lmx_graph_kind(g, value) = 4 && (head = state\w_fn || head = state\w_sub) && lmx_graph_fn_written(g, (cast: (@: c.Lmx) value)) != 0
            status: lmx_graph_space_declare(g, block, (cast: (@: c.Lmx) value))
        i: i + 1U
    ---
    return: status
end: lmx_graph_space_declarations

# The value a Structure gives for the part name of a receiver -- the one model of a Frame (§3.3), as at the root
# (lmx_graph_root_structure): the field named name; a reference answers its target; a Frame `name: value` whose single
# field is a value -- a word, an unnamed int, a reference, an unnamed Lmx -- answers that value; any other field (a
# place, a word place, a named Structure of fields) answers itself. Whatever made the Structure -- written code, merge, a
# function a receiver created -- it is read as it is. 0 when it has no field named name.
fn: lmx_graph_fn_part (@: g c.LmxGraph; @: structure c.Lmx; @: name char) @: void
    @: value void 0
    @: field void 0
    size_t: slot 0U
    int: kind 0
    if: g = 0 || structure = 0 || name = 0
        return: 0
    slot: c.lmx_graph_named(g, structure, name)
    if: slot >= c.lmx_graph_count(structure)
        return: 0
    value: c.lmx_graph_get(structure, slot)
    if: c.lmx_graph_kind(g, value) = 6
        return: c.lmx_graph_target(g, value)
    if: c.lmx_graph_kind(g, value) != 4 || c.lmx_graph_count((cast: (@: c.Lmx) value)) != 1U
        return: value
    field: c.lmx_graph_get((cast: (@: c.Lmx) value), 0U)
    kind: c.lmx_graph_kind(g, field)
    if: kind = 6
        return: c.lmx_graph_target(g, field)
    if: kind = 2 || ((kind = 1 || kind = 4) && c.lmx_graph_name_of(g, field) = 0)
        return: field
    return: value
end: lmx_graph_fn_part

# The receiver fn or sub applied where the traversal reaches its Frame at field index of the root, to arguments the
# traversal computes (the author 2026-11-09: "в любой момент можем подставить заготовленную структуру ресиверу fn и это
# будет объявлением функции в namespace"): one argument -- the whole prepared Structure, whose fields give the
# arguments name, args, return (fn), var and body (`fn: prepared`) --, or two -- the written name, which is not
# evaluated, and a Structure of the parts (`fn: new_name merge(f1, f2)`; a field name of that Structure is an ordinary
# field, not the name). Each part is read by lmx_graph_fn_part, whatever made the Structure; lmx_graph_fn_make creates F
# as for a written declaration -- one constructor, its var by lmx_graph_fn_var (the parts as given, var completed by
# the own fields of the body) -- and from here on the name answers it in this block. The written name is checked before
# the Structure is evaluated; the evaluation is the expression's own, once. A declaration with written arguments created
# its F when the block was entered (0 here). 0; 1 without memory; 3 for an unknown name; 4 for a name that already
# answers in this block; 5 for a form this slice does not execute (another count of arguments, another field, no name,
# args or result, a body or an inline block: a repeated activation would bind the name again).
fn: lmx_graph_fn_apply (@: g c.LmxGraph; @: scope c.Lmx; size_t: index) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: space c.LmxGraphSpace c.lmx_graph_space()
    @: w_name char c.lmx_graph_intern("name", 4U)
    @: decl c.Lmx 0
    @: parts c.Lmx 0
    @: value void 0
    @: word void 0
    @: name char 0
    @: head char 0
    @: field char 0
    @: args c.Lmx 0
    @: result void 0
    @: written c.Lmx 0
    @: body c.Lmx 0
    @: made c.Lmx 0
    size_t: n 0U
    size_t: i 0U
    int: with_result 0
    int: status 0
    if: g = 0 || state = 0 || scope = 0 || w_name = 0 || index >= c.lmx_graph_count(scope)
        return: 5
    decl: (cast: (@: c.Lmx) c.lmx_graph_get(scope, index))
    head: c.lmx_graph_name_of(g, (cast: (@: void) decl))
    if: c.lmx_graph_kind(g, (cast: (@: void) decl)) != 4 || (head != state\w_fn && head != state\w_sub)
        return: 5
    if: lmx_graph_fn_written(g, decl) != 0
        return: 0
    if: space = 0 || space\root != scope
        return: 5
    n: c.lmx_graph_count(decl)
    if: n != 1U && n != 2U
        return: 5
    if: n = 2U
        name: c.lmx_graph_word_text(g, c.lmx_graph_get(decl, 0U))
        if: name = 0
            return: 5
        if: c.lmx_graph_space_find(scope, name) != 0
            return: 4
    ---
    status: lmx_graph_eval_value(g, scope, c.lmx_graph_get(decl, n - 1U), @ value)
    if: status != 0
        return: status
    value: c.lmx_graph_target(g, value)
    if: c.lmx_graph_kind(g, value) != 4
        return: 5
    parts: (cast: (@: c.Lmx) value)
    # Every field of the Structure gives a part of this receiver's contract (sub has no result).
    while: i < c.lmx_graph_count(parts)
        field: c.lmx_graph_slot_name(g, parts, i)
        if: field != w_name && field != state\w_args && field != state\w_var && field != state\w_body && (field != state\w_return || head != state\w_fn)
            return: 5
        i: i + 1U
    ---
    if: n = 1U
        word: lmx_graph_fn_part(g, parts, w_name)
        if: c.lmx_graph_kind(g, word) != 2
            return: 5
        name: c.lmx_graph_word_text(g, word)
        if: name = 0
            return: 5
        if: c.lmx_graph_space_find(scope, name) != 0
            return: 4
    ---
    args: (cast: (@: c.Lmx) lmx_graph_fn_part(g, parts, (cast: (@: char) state\w_args)))
    written: (cast: (@: c.Lmx) lmx_graph_fn_part(g, parts, (cast: (@: char) state\w_var)))
    body: (cast: (@: c.Lmx) lmx_graph_fn_part(g, parts, (cast: (@: char) state\w_body)))
    if: head = state\w_fn
        with_result: 1
        result: lmx_graph_fn_part(g, parts, (cast: (@: char) state\w_return))
        if: result = 0
            return: 5
    ---
    if: args = 0
        return: 5
    status: lmx_graph_fn_make(g, decl, name, args, result, written, body, with_result, @ made)
    if: status != 0
        return: status
    if: c.lmx_graph_space_put(scope, name, (cast: (@: void) made)) != 0
        return: 1
    if: body != 0
        status: lmx_graph_space_declarations(g, body)
    return: status
end: lmx_graph_fn_apply

# Does the named Lmx at field index of the root, reached now, stand for a named Structure (a data or code block) rather
# than a statement? The one model of a Frame (grammar §2, the book :426, :443): its head is resolved now, in the
# namespace of this traversal as it stands at this field. It is a Structure when its name is no word of the language and
# answers nothing now, and its fields are no single value. A single field that is a value -- a literal, a word, a
# reference, an unnamed Lmx, merge or a Frame applying what answers a callable now (`r: h(3)` after `h: f`) -- makes it
# the definition `name: value`; a place, a Frame on a place (an assignment), a statement of the language or a Frame on a
# name that answers nothing (a nested block) makes it a block. Nothing is decided before the traversal reaches the
# field. 1 or 0.
fn: lmx_graph_root_structure (@: g c.LmxGraph; @: root c.Lmx; size_t: index) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: value void c.lmx_graph_get(root, index)
    @: name char c.lmx_graph_name_of(g, value)
    @: field void 0
    @: head char 0
    int: kind 0
    if: state = 0 || name = 0 || c.lmx_graph_kind(g, value) != 4 || lmx_graph_language_word(state, name) != 0 || c.lmx_graph_language_receiver(name) != 0 || lmx_graph_resolve(g, root, name) != 0
        return: 0
    if: c.lmx_graph_count((cast: (@: c.Lmx) value)) != 1U
        return: 1
    field: c.lmx_graph_get((cast: (@: c.Lmx) value), 0U)
    kind: c.lmx_graph_kind(g, field)
    if: kind = 2 || kind = 5 || kind = 6
        return: 0
    if: kind = 1 || kind = 3
        return: (cast: (int) (c.lmx_graph_slot_name(g, (cast: (@: c.Lmx) value), 0U) != 0))
    if: kind != 4
        return: 0
    head: c.lmx_graph_name_of(g, field)
    if: head = 0 || head = state\w_merge
        return: 0
    if: c.lmx_graph_method(g, (cast: (@: c.Lmx) c.lmx_graph_target(g, lmx_graph_resolve(g, root, head)))) != 0
        return: 0
    return: 1
end: lmx_graph_root_structure

# The traversal reaches field index of the root (§5.2; the book :443: an ordinary field is visible forward from its
# declaration, at the root of a file too -- a slot allocated before does not open its name to an earlier statement;
# the visibility from the first line belongs to the completed var of a method). A place answers its name from here on --
# the first written field of a name keeps it, a repeated declaration does not re-bind --, and so does a named Structure
# (lmx_graph_root_structure). Both consumers call it at the field, the translator in its translation namespace and in
# the program it emits. 1 when the field stands (a place, a named Structure, a primitive value), 0 when it is a statement
# or a definition to run (a word as `return` included), -1 without memory.
fn: lmx_graph_space_reach (@: g c.LmxGraph; @: root c.Lmx; size_t: index) int
    @: value void 0
    @: name char 0
    int: kind 0
    if: g = 0 || root = 0 || index >= c.lmx_graph_count(root)
        return: 0
    value: c.lmx_graph_get(root, index)
    kind: c.lmx_graph_kind(g, value)
    if: kind = 1 || kind = 3 || kind = 5 || kind = 6
        name: c.lmx_graph_slot_name(g, root, index)
        if: name != 0 && c.lmx_graph_space_find(root, name) = 0
            if: c.lmx_graph_space_put(root, name, value) != 0
                return: -1
            ---
        ---
        return: 1
    if: kind != 4 || lmx_graph_root_structure(g, root, index) = 0
        return: 0
    if: c.lmx_graph_space_put(root, c.lmx_graph_name_of(g, value), value) != 0
        return: -1
    return: 1
end: lmx_graph_space_reach

# The slot of the place named name of block that answers name now (lmx_graph_space_reach entered it), or the count of
# its slots: a write by a bare name reaches only a visible place.
fn: lmx_graph_visible_slot (@: g c.LmxGraph; @: block c.Lmx; @: name char) size_t
    size_t: slot lmx_graph_place_slot(g, block, name)
    if: slot < c.lmx_graph_count(block) && c.lmx_graph_space_find(block, name) != c.lmx_graph_get(block, slot)
        return: c.lmx_graph_count(block)
    return: slot
end: lmx_graph_visible_slot

# Begin the namespace of a traversal of root (§5.2): when no traversal is live, a new empty table and the Structures of
# the declarations of fn and sub created in it (they answer in their whole block); the places and named Structures of the
# root answer from their fields on, as the traversal reaches them (lmx_graph_space_reach). A traversal begun inside a live
# one goes on with it. opened[0] says which (the argument of lmx_graph_space_close). 0; 1 without memory;
# 5 for a declaration form this slice does not execute.
fn: lmx_graph_space_open (@: g c.LmxGraph; @: root c.Lmx; @: opened int) int
    int: status 0
    if: g = 0 || root = 0 || opened = 0
        return: 5
    opened[0]: c.lmx_graph_space_push(root)
    if: opened[0] < 0
        opened[0]: 0
        return: 1
    if: opened[0] = 1
        status: lmx_graph_space_declarations(g, root)
        if: status != 0
            c.lmx_graph_space_pop(opened[0])
            opened[0]: 0
        ---
    ---
    return: status
end: lmx_graph_space_open

# End the namespace lmx_graph_space_open began (opened: its answer in opened[0]); its rows are freed.
sub: lmx_graph_space_close (int: opened)
    c.lmx_graph_space_pop(opened)
    return
end: lmx_graph_space_close
