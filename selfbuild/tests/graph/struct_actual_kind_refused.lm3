# Entry Main. An actual of a kind its input does not receive fails the pair at the admission: one reading reached
# admission and none is admitted -- 4 (step 21.7 K2). `Sum\add(Box)`: Box is a Structure, the first input `a` receives
# an int, and the field of Box names no input. BEFORE is written, `Counter\steps` stays 0, AFTER is not.
# Norm: the book #structural-call; #declaration-selection (the admission of each actual at its input).
int: before 0
Counter:
    int: steps 0
end: Counter
Sum:
    int: a 1
    int: b 2
    add:
        Counter\steps := Counter\steps + a * 10 + b
    end: add
end: Sum
Box:
    int: q 1
end: Box
int: after 0
Main:
    node\before := 1
    Sum\add(Box)
    node\after := 2
