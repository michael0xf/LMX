# The occurrence selected by an explicit path call is the one it executes on.
# Merge copies the occurrence A's field `fn: M` reaches, so R holds its own M.
# `A\M()` and `R\M()` count A's and R's apart: A 1, 2, 3, 4 and R 1, 2, 3.
A:
    fn: M
    int: tag 1
end: A

fn: M () int
    int: hits
    hits: hits + 1
    return: hits
end: M

fn: probe () int
    R: merge: A
    A\M()
    int: a2 A\M()
    int: r1 R\M() + 0
    int: a3 0
    a3: A\M()
    R\M()
    int: r3 R\M()
    if: a2 != 2
        return: 81
    if: r1 != 1
        return: 82
    if: a3 != 3
        return: 83
    if: r3 != 3
        return: 84
    if: A\M() != 4
        return: 85
    return: 7
end: probe

sendMessage: exit(exit_code: probe(); stdout: ""; stderr: "")
return
