+      "foreign": "package PerlComparison::Records;\nuse strict;\nuse warnings;\nuse Scalar::Util qw(refaddr reftype blessed);\nsub clone_data {\n    my ($value, $seen) = @_;\n    return $value unless ref $value;\n    blessed($value) and die \"MergeType\\n\";\n    my $address = refaddr($value);\n    return $seen->{$address} if exists $seen->{$address};\n    my $kind = reftype($value);\n    if ($kind eq 'HASH') {\n        my $out = {};\n        $seen->{$address} = $out;\n        for my $key (keys %$value) { $out->{$key} = clone_data($value->{$key}, $seen) }\n        return $out;\n    }\n    if ($kind eq 'ARRAY') {\n        my $out = [];\n        $seen->{$address} = $out;\n        for my $item (@$value) { push @$out, clone_data($item, $seen) }\n        return $out;\n    }\n    if ($kind eq 'SCALAR' || $kind eq 'REF') {\n        my $target;\n        my $out = \\$target;\n        $seen->{$address} = $out;\n        $target = clone_data($$value, $seen);\n        return $out;\n    }\n    die \"MergeType\\n\";\n}\nsub derive_record {\n    my ($base, $extension) = @_;\n    ref($base) eq 'HASH' && ref($extension) eq 'HASH' or die \"MergeType\\n\";\n    my %seen;\n    my $model = clone_data($base, \\%seen);\n    my $extra = clone_data($extension, \\%seen);\n    for my $key (keys %$extra) { $model->{$key} = $extra->{$key} }\n    my %group;\n    for my $key (keys %$model) { $group{$key} = $model->{$key} }\n    return \\%group;\n}\n1;\n",
+      "contract": "Новый результат по модели base с заменой одноимённых совместимых полей extension. Дополнительная Perl-реализация показывает общий map копирования data-графа: вложенные HASH/ARRAY/SCALAR-ссылки, разделяемые цели и циклы поддержаны, вход не меняется. В клиенте P12 требуется только плоская запись настроек; там штатный хеш Perl достаточно точно реализует задачу.",
+      "boundary": "LMX derive вызывает базовую операцию языка merge: весь графовый копировщик уже входит в язык. Perl-реализация самостоятельно копирует data-граф одним refaddr-map и накладывает поля. Контейнер результата отделён от копии модели; внутренние ссылки остаются связаны с общей картой копирования.",
+      "limitations": "Сравнение data-профиля не переносит на Perl lexical parent, нативные реализации, protected/independent/immutable, типовую совместимость имён и порядок модельных индексов LMX. Неподдерживаемые host-объекты/код отвергаются MergeType, а не молча теряются. Полную семантику merge определяет LMX_semantics.en.md, раздел The common graph-copying map. Для P12 идентичность изменяемых вложенных графов не является обещанным результатом.",
