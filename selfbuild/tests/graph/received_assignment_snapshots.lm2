# A dynamic receiving place selects numeric input or literal Structure.
# An unused optional input must not be promoted into the caller's locals.
fn: State () int (
    int: k 5
    int: out 0
    @: held ()
    int: calls 0
    fn: change () int
        node\k := 8
        node\calls := node\calls + 1
        return: 1
    fn: leaf () int
        return: k
    fn: number () int (int: prepared change())
        node\out := (k)
        return: node\out
    fn: literal () int (int: prepared change())
        node\held := (k)
        return: leaf()
)
    return: 0
int: prepared State()
@: Number State\data\number
@: Literal State\data\literal
int: numeric Number()
State\data\k := 5
int: structural Literal()
int: held_n length(State\data\held)
int: outside State\data\k
int: changes State\data\calls
