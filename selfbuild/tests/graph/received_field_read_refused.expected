---
    Observed:
        int: before 1
    end: Observed
---
int: calls 1
fn: touch () int
    :=: (node \ calls) ((node \ calls) + 1)
    return: 7
end: touch
Holder:
    int: p (touch)
end: Holder
int: before 0
:=: before 1
sub: main ()
    @: shared (node [] 0)
    :=: ((shared \ Observed) \ before) before
    int: observed (length (Holder \ p))
    :=: before 2
end: main
main:
