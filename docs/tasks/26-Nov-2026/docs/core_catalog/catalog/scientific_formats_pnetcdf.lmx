# Canonical compact LMX proposal. Columns are positional; ids are table-local.
# Reader/schema: ../CATALOG_FORMAT.ru.md. No publication or runtime proof.
C99Catalog_scientific_formats_pnetcdf:
    int: schemaVersion 2
    int: tableChunkSize 32
    char[]: componentId "scientific_formats:pnetcdf"
    @: component ("d";(("availability";("s";"compiled C99 static target; original and trimmed sources verified with real one-rank MPI-IO CDF-1/2/5 roundtrip; multi-rank execution not verified"));("build_module";("s";"extensions/scientific_pnetcdf"));("canonical_header_map";("d";(("vendor/pnetcdf/src/include/pnetcdf.h.in";("s";"pnetcdf.h")))));("cmake_targets";("l";(("s";"LMX::pnetcdf"))));("commit";("n"));("dependencies";("l";(("s";"External MPI C implementation with MPI-IO; not bundled"))));("headers";("l";(("s";"third_party/lmx_c99_compact/vendor/pnetcdf/src/include/pnetcdf.h.in"))));("id";("s";"scientific_formats:pnetcdf"));("implemented_public_count";("i";924));("implemented_public_groups";("d";(("cdl_hdr";("i";9));("ncmpi";("i";915)))));("license";("s";"NetCDF-style permissive PnetCDF license AND MIT AND Unicode data notice (embedded utf8proc)"));("licenses_notices";("l";(("s";"vendor/pnetcdf/COPYRIGHT");("s";"vendor/pnetcdf/COPYING");("s";"vendor/pnetcdf/src/drivers/common/utf8proc.h");("s";"vendor/pnetcdf/src/drivers/common/UTF8PROC_LICENSE.md"))));("notes";("l";(("s";"CDF-5 is the 64-bit data format selected by NC_64BIT_DATA, with CDF\\005 magic, including NC_INT64/NC_UINT64. It is not an HDF5-backed format or a separate netCDF library version.");("s";"Production public header is generated by configure from pnetcdf.h.in in the build/install include directory. The template contains all C API names; MPI headers and host ABI are not vendored.");("s";"The same MPI installation must supply compile-time types and runtime. Collective operations and request lifetimes need explicit communicator ownership in LMX wrappers.");("s";"The standalone portable CMake adapter requires a POSIX configure/make environment and an m4 build tool. No source fetching or regeneration from the internet.");("s";"A guarded source-view edit removes a semantically empty object/function pointer comparison from ncmpi_inq_libvers; version objects and public ABI remain intact.");("s";"The retained CDF roundtrip source supports arbitrary rank count; one-rank execution is available here, multi-rank execution is separately gated and must not be inferred.");("s";"Two upstream-declared ubyte attribute aliases missing from the archive are supplied by src/ubyte_aliases.c as direct calls to uchar implementations; all 915 ncmpi declarations now have linkable definitions.");("s";"PNETCDF_RELAX_COORD_BOUND=1 and PNETCDF_ERANGE_FILL=1; LMX_PNETCDF_INSTALL_PREFIX exports the generated prefix and lmx_pnetcdf_build is the ExternalProject dependency.");("s";"The adapter uses retained release configure with --disable-maintainer-mode. Unused GPL Autoconf Archive ax_* macro sources are omitted; their exception applies to configure output, not raw macro redistribution. Numeric-conversion M4 inputs remain."))));("paths";("l";(("s";"vendor/pnetcdf"))));("public_headers";("l";(("s";"vendor/pnetcdf/src/include/pnetcdf.h.in"))));("selected_profile";("s";"Production C API with MPI-IO, CDF-1 classic, CDF-2 64-bit offset, CDF-5 64-bit data; C++/Fortran/GIO/ADIOS/netCDF4/burst/subfiling disabled"));("source_archives";("l";(("d";(("names";("l";(("s";"pnetcdf-1.15.1.tar.gz"))));("sha256";("s";"169c6adab08ba49154f14261225992601c573971b823c2066008a8ff57973f8a")))))));("source_validation";("s";"source_census_only_not_link_test"));("surface_patterns";("l";(("s";"vendor/pnetcdf/src/include/pnetcdf.h.in"))));("targets";("l";(("s";"LMX::pnetcdf"))));("urls";("l";(("s";"https://parallel-netcdf.github.io/Release/pnetcdf-1.15.1.tar.gz");("s";"https://parallel-netcdf.github.io/"))));("version";("s";"1.15.1"))))
