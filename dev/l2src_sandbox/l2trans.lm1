                return: 1
            ---
        if: c.fprintf(l2_out, "        l2_fkid: lmx_struct_new_profiled(l2_entry_leaf, l2_program_arena, lmx_range_profile(l2_program_arena, (cast: (@: void) l2_entry_leaf)))\n        if: l2_fkid = 0\n            return: 1\n        l2_b%d: l2_fkid\n", k) < 0
            fclose(l2_out)
            return: 1
        if: l2_for_nkid[k] > 0 && c.fprintf(l2_out, "        if: lmx_arena_refs_open_profiled(l2_program_arena, l2_fkid, %uU, lmx_range_profile(l2_program_arena, (cast: (@: void) l2_fkid))) != 0\n            return: 1\n", (cast: (unsigned) l2_for_nkid[k])) < 0
            fclose(l2_out)
            return: 1
        if: l2_for_uchild[k] >= 0 && c.fprintf(l2_out, "        if: lmx_arena_ref_store(l2_entry_leaf, %uU, (cast: (@: void) l2_fkid)) != 0\n            return: 1\n", (cast: (unsigned) l2_for_uchild[k])) < 0
            fclose(l2_out)
            return: 1
        if: c.fprintf(l2_out, "        l2_entry_leaf: l2_fkid\n") < 0
            fclose(l2_out)
            return: 1
        oi: 0
        while: oi < l2_own_n
            if: l2_own_fid[oi] = k && c.fprintf(l2_out, "        l2_entry_slot: lmx_arena_ref_cell(l2_entry_leaf, %uU)\n        if: l2_entry_slot = 0\n            return: 1\n", (cast: (unsigned) l2_own_fchild[oi])) < 0
                fclose(l2_out)
                return: 1
            if: l2_own_fid[oi] = k && l2_emit_cell_new(oi, "l2_entry_leaf", (cast: (size_t) l2_own_fchild[oi]), 0, "        ", "l2_entry_slot", "return: 1", 0) != 0
                fclose(l2_out)
                return: 1
            oi: oi + 1
        ---
        k: k + 1
    ---
    # §10: the occurrence of a method of a program part whose root is built is that root's child -- the `node`
    # the method runs under (lmx_call_node) -- once the root exists.
    i: 0
    while: i < l2_m_n
        if: i != l2_e && l2_method_source_own(i) < 0 && l2_m_part(i) >= 0 && l2_part_ns[l2_m_part(i)] >= 0 && c.fprintf(l2_out, "        l2_entry_leaf: lmx_arena_ref_struct(l2_entry_unit, %uU)\n        if: l2_entry_leaf = 0 || l2_nsp[%d] = 0\n            return: 1\n        l2_entry_leaf\\parent: l2_nsp[%d]\n", (cast: (unsigned) (l2_occ_slot(i))), l2_part_ns[l2_m_part(i)], l2_part_ns[l2_m_part(i)]) < 0
            fclose(l2_out)
            return: 1
        i: i + 1
    ---
    # Book §3 (Codex, 2026-09-28): every callable occurrence keeps the immediately enclosing Structure as its
    # `parent` -- a nested method's is its host's occurrence, the `node` it runs under, capturing or not; a
    # file-level method's stays the unit.
    i: 0
    while: i < l2_m_n
        if: l2_method_source_own(i) < 0 && l2_mad_host_of(i) >= 0 && c.fprintf(l2_out, "        l2_entry_leaf: lmx_arena_ref_struct(l2_entry_unit, %uU)\n        if: l2_entry_leaf = 0 || lmx_arena_ref_struct(l2_entry_unit, %uU) = 0\n            return: 1\n        l2_entry_leaf\\parent: lmx_arena_ref_struct(l2_entry_unit, %uU)\n", (cast: (unsigned) (l2_occ_slot(i))), (cast: (unsigned) (l2_occ_slot(l2_mad_host_of(i)))), (cast: (unsigned) (l2_occ_slot(l2_mad_host_of(i))))) < 0
            fclose(l2_out)
            return: 1
        i: i + 1
    ---
    if: l2_d105_emit_tables() != 0
        fclose(l2_out)
        return: 1
    if: l2_place_tables_emit() != 0
        fclose(l2_out)
        return: 1
    if: l2_mexec_emit_maps() != 0
        fclose(l2_out)
        return: 1
    # Fill the already allocated namespace reference places through the same
    # producer used by projected local source occurrences.  The letters' payload
    # copies wait for the end of construction (l2_ns_payload_pass).
    l2_ns_payload_pass: 1
    k: 0
    while: k < l2_ns_n
        if: l2_ns_in_body(k) = 0 && l2_emit_ns_refs(k) != 0
            fclose(l2_out)
            return: 1
        k: k + 1
    ---
    l2_ns_payload_pass: 0
    if: l2_source_fields_emit(0, -1) != 0
        fclose(l2_out)
        return: 1
    # All physical holders and unit reference fields now exist. Fill a local
    # field Structure through its completed GraphField, including hosted
    # declarations. Original local procedures have already been allocated by
    # the same source producer, so their fields must not be constructed again.
    k: 0
    while: k < l2_own_n
        i: l2_own_mi[k]
        oi: l2_m_nsof(i)
        if: oi >= 0 && l2_ns_local[oi] >= 0
            k: k + 1
            continue
        if: l2_source_owns(k) = 0 && l2_atom_value_stmt(l2_own_decl[k], i) != 0 && l2_emit_method_atom(k) != 0
            fclose(l2_out)
            return: 1
        if: l2_source_owns(k) = 0 && l2_field_own_stmt(l2_own_decl[k], i) != 0 && l2_emit_method_fields(k) != 0
            fclose(l2_out)
            return: 1
        k: k + 1
    ---
    # Source FILL runs for programs and libraries before any profile is sealed.
    # Each typed operation record uses its actual source frame's profile.
    if: l2_library_mode = 0 && fputs("        lmx_walk_program_bind()\n", l2_out) < 0
        fclose(l2_out)
        return: 1
    if: l2_library_mode = 0 && l2_ebr_n > 0 && c.fprintf(l2_out, "        lmx_walk_program_qualify(l2_program_qualified_roots, %dU)\n", l2_ebr_n) < 0
        fclose(l2_out)
        return: 1
    # Then each walkable method's frames, into its occurrence (-193 T4a).
    if: l2_rw_methods_emit(2) != 0
        fclose(l2_out)
        return: 1
    # Every method occurrence, including a callable declared inside an inline
    # body, is now attached to its source graph. Only now address that
    # occurrence to install header parts and its native word: an earlier path
    # through the host's not-yet-built body has no physical target.
    i: 0
    while: i < l2_m_n
        if: l2_method_body_result(i) >= 0
            i: i + 1
            continue
        ---
        if: l2_emit_parts(i) != 0
            fclose(l2_out)
            return: 1
        i: i + 1
    if: lm_compiler_consumer_calls_emit(l2_expr_sites, 0, -1, l2_ruse_e_edge, l2_ruse_e_level, l2_source_containers, l2_out) != 0 || l2_source_layouts_emit(0, -1) != 0 || l2_emit_fallback_seeds() != 0 || l2_source_seeds_emit(0, -1) != 0
        fclose(l2_out)
        return: 1
    if: l2_emit_shell_anchor() != 0
        fclose(l2_out)
        return: 1
    # §10: the graph is completely filled now, but no selected profile has
    # been sealed. Pass exact method occurrences (not inferred from native or
    # pool identity) and numeric source pointer categories to one read-only
    # preflight. They are machine scratch, never fields of the graph.
    if: l2_ebr_n > 0
        if: c.fprintf(l2_out, "        []: @(Lmx) l2_qual_methods %d\n        []: @(Lmx) l2_qual_prior %d\n        []: int l2_qual_opaque %d\n", l2_m_n, l2_ebr_n, l2_foreign_n + 1) < 0
            fclose(l2_out)
            return: 1
        ---
        i: 0
        while: i < l2_m_n
            if: i != l2_e && l2_m_nsof(i) < 0
                if: c.fprintf(l2_out, "        l2_qual_methods[%d]: ", qn) < 0 || l2_emit_build_occ(i) != 0 || fputs("\n", l2_out) < 0
                    fclose(l2_out)
                    return: 1
                ---
                qn: qn + 1
            ---
            i: i + 1
        ---
        if: c.fprintf(l2_out, "        l2_qual_opaque[%d]: %d\n", on, lm_compiler_msg_ref_ty()) < 0
            fclose(l2_out)
            return: 1
        ---
        on: on + 1
        i: 0
        while: i < l2_foreign_n
            if: lm_compiler_foreign_opaque(i) != 0
                if: c.fprintf(l2_out, "        l2_qual_opaque[%d]: %d\n", on, 100 + i) < 0
                    fclose(l2_out)
                    return: 1
                ---
                on: on + 1
            ---
            i: i + 1
        ---
    ---
    # Complete the actual ranges of each exact physical profile, not a list
    # of presumed cell types. Multiple range entries may name the same pool;
    # sealing is idempotent and changes neither the index nor any address.
    # The profile's Structure range remains required by the constructor.
    # Stage23 QUALIFIED-ORIGINAL-SOURCE (steps/qualified-original-source-20261010.md, the located construction
    # diagnostic): a static branch the preflight rejects is a construction failure of the program, said at the
    # branch's own site -- the file (l2_node_file: the part the branch was read from, or the source), line and column
    # of its retained P0 node (l2_ebr_at[k]) -- and by its cause: out of memory (LMX_QUALIFY_NOMEM) or a retained data
    # reference the qualification does not admit (LMX_QUALIFY_INVALID).  The file is a quoted argument, never part of
    # the format.  A nonzero construction status before sealing and publication, no throw and no catch result.
    k: 0
    while: k < l2_ebr_n
        bline: 1U
        bcol: 1U
        if: l2_ebr_at != 0 && l2_ebr_at[k] != 0 && l2_ebr_at[k]\span != 0
            bline: l2_ebr_at[k]\span\line
            bcol: l2_ebr_at[k]\span\column
        ---
        if: c.fprintf(l2_out, "        l2_qual_status: lmx_qualify_tree_preflight_full(l2_program_arena, l2_ebr%u, l2_qual_prior, %uU, l2_qual_methods, %uU, l2_qual_opaque, %uU)\n        if: l2_qual_status = c.LMX_QUALIFY_NOMEM\n            c.fprintf(c.stderr, \"lmx: %%s:%zu:%zu: qualification of the branch failed: out of memory\\n\", ", (cast: (unsigned) k), (cast: (unsigned) k), (cast: (unsigned) qn), (cast: (unsigned) on), bline, bcol) < 0 || lm_compiler_emit_cstr_chars(l2_node_file(l2_src, l2_ebr_at[k])) != 0
            fclose(l2_out)
            return: 1
        if: c.fprintf(l2_out, ")\n            return: 1\n        if: l2_qual_status != c.LMX_QUALIFY_OK\n            c.fprintf(c.stderr, \"lmx: %%s:%zu:%zu: qualification of the branch failed: a retained data reference is not admitted (branch %u)\\n\", ", bline, bcol, (cast: (unsigned) k)) < 0 || lm_compiler_emit_cstr_chars(l2_node_file(l2_src, l2_ebr_at[k])) != 0
            fclose(l2_out)
            return: 1
        if: fputs(")\n            return: 1\n", l2_out) < 0
            fclose(l2_out)
            return: 1
        ---
        if: c.fprintf(l2_out, "        l2_profile_pool: lmx_arena_find_profiled(l2_program_arena, c.LMX_KIND_STRUCT, c.LMX_TYPE_STRUCT, l2_eprofile%u)\n        if: l2_profile_pool = 0\n            return: 1\n        l2_profile_index: 0U\n        while: l2_profile_index < lmx_arena_index_len(l2_program_arena)\n            l2_profile_range: lmx_arena_index_data(l2_program_arena) + l2_profile_index\n            l2_profile_pool: l2_profile_range\\array\n            if: l2_profile_pool != 0 && l2_profile_pool\\profile = l2_eprofile%u\n                if: lmx_pool_seal(l2_profile_pool) != 0\n                    return: 1\n            ---\n            l2_profile_index: l2_profile_index + 1U\n        ---\n", (cast: (unsigned) k), (cast: (unsigned) k)) < 0
            fclose(l2_out)
            return: 1
        k: k + 1
        if: c.fprintf(l2_out, "        l2_qual_prior[%uU]: l2_eprofile%u\n", (cast: (unsigned) (k - 1)), (cast: (unsigned) (k - 1))) < 0
            fclose(l2_out)
            return: 1
        ---
    ---
    # Receiver identities and shared roles are stable for the whole program,
    # including when a sealed qualified subtree is skipped by graph tracing.
    if: fputs("        l2_profile_index: 0U\n        while: l2_profile_index < lmx_arena_index_len(l2_program_arena)\n            l2_profile_range: lmx_arena_index_data(l2_program_arena) + l2_profile_index\n            l2_profile_pool: l2_profile_range\\array\n            if: l2_profile_pool != 0 && l2_profile_pool\\profile = l2_entry_unit\n                if: lmx_pool_seal(l2_profile_pool) != 0\n                    return: 1\n            ---\n            l2_profile_index: l2_profile_index + 1U\n        ---\n", l2_out) < 0
        fclose(l2_out)
        return: 1
    # The synthesized letters' payload copies (kind 3), made once construction is complete and the qualified
    # branches are sealed: each copies its model and the lexical chain the copy hangs under, which keeps every
    # qualified branch itself (l2_emit_keep; the copier retains only sealed exact profiles).
    l2_ns_payload_pass: 2
    k: 0
    while: k < l2_ns_n
        if: l2_ns_in_body(k) = 0 && l2_emit_ns_refs(k) != 0
            fclose(l2_out)
            return: 1
        k: k + 1
    ---
    l2_ns_payload_pass: 0
    if: c.fprintf(l2_out, "        if: %uU != %uU\n            return: 1\n", l2_intern_again, l2_sigv) < 0
        fclose(l2_out)
        return: 1
    # Publishing source never appends runtime fields. The host constructs the
    # Thread separately; a library's construction publishes the unit to no one but its caller.
    if: l2_library_mode = 0 && fputs("        l2_entry_unit\\parent: 0\n        l2_program_unit: l2_entry_unit\n", l2_out) < 0
        fclose(l2_out)
        return: 1
    # E runs once for the instance as R0's turn runs a program's entry (lmx_thread.lm1: the unit is the owner and the code,
    # through its native word): the declarations initialize this instance's own fields. Nothing else of the unit runs, and
    # no Message, Thread or module cell learns of the unit: the owner holds it through the export's result.
    if: l2_library_mode != 0 && fputs("        l2_entry_unit\\parent: 0\n        l2_construct_status: lmx_call_prim(l2_program_arena, l2_entry_unit, l2_entry_unit, 0, 0U, 0, @ l2_construct_out)\n        if: l2_construct_status != 0\n            \\out: l2_construct_out\n            return: l2_construct_status\n        if: lmx_msg_poll_escape() != 0\n            return: 0\n        \\out: (cast: (@: void) l2_entry_unit)\n", l2_out) < 0
        fclose(l2_out)
        return: 1
    if: l2_m_arity[0] != 0 && c.fprintf(l2_out, "        if: %zuU = 0U\n            return: 1\n", l2_m_f0[0]\length) < 0
        fclose(l2_out)
        return: 1
    if: fputs("        # Closed-unit devirtualization: translator-bound child indices, no graph mutations after construction. Runtime does not memcmp formals. Evaluation order of actuals is materialized into temps before each call boundary. Hidden through-args, when present, follow declared formals in intern name order.\n", l2_out) < 0
        fclose(l2_out)
        return: 1
    if: l2_library_mode != 0 && fputs("        return: 0\n", l2_out) < 0
        fclose(l2_out)
        return: 1
    if: l2_library_mode = 0 && fputs("        return: 0\n    end: l2_program_build\nend: external\n", l2_out) < 0
        fclose(l2_out)
        return: 1
    if: l2_library_mode != 0 && (fputs("    end: ", l2_out) < 0 || fputs(l2_construct_name, l2_out) < 0 || fputs("\nend: external\n", l2_out) < 0)
        fclose(l2_out)
        return: 1
    if: l2_build_text_end() != 0
        fclose(l2_out)
        return: 1
    if: l2_library_mode = 0
        # main is the launch (lmx_root_launch): the host reserves R0 with this unit's field count, the
        # builder installs the unit in R0's own arena and graph, and the exit is R0's exit letter or
        # the mapping of its success.
        if: c.fprintf(l2_out, "external:\n    fn: main (int: argc; @@: char argv) int\n        LmxRoot: l2_program_root\n        return: lmx_root_launch(@ l2_program_root, argc, argv, l2_program_build, %uU, lmx_root_settings, 5000U, (cast: (@: void) c.stdout), (cast: (@: void) c.stderr))\n    end: main\nend: external\n", kids) < 0
            fclose(l2_out)
            return: 1
    ---
    if: l2_emit_pointer_cell_definitions() != 0
        fclose(l2_out)
        return: 1
    if: fclose(l2_out) != 0
        c.remove(l2_pub_tmp)
        return: 1
    # All emitters share this transaction. An optional query's fatal error
    # cannot publish partial/new L1 or replace an existing good destination.
    if: l2_translation_failed(l2_src, l2_here_node) != 0
        c.remove(l2_pub_tmp)
        return: 1
return: l2_pub_commit(out_path)

# The program's C must be compiled for the target it was translated for (L2 section 20: one target for L2, its L1
# and its C). An os program's L1 carries an os block whose OTHER platform's section declares a cell initialised by an
# identifier no header declares, so a C translation unit of another target is refused at compile time, naming the
# target of the translation, never given the other platform's selection.

# Whether s can name a library's construction export (`--construct NAME`): a C identifier outside the l2_ and lmx_
# prefixes of the generated and kernel symbols. 1 yes, 0 no.

# The program's translation (L2 section 20): one translation into out_path. An os block selects its branch for
# the target where the source is first read (l2_translate); the other branches are not translated.
fn: l2_translate_program (const: @(char in_path); const: @(char out_path)) int
    int: r
    l2_os_select: 0
    l2_os_mask: 0
    r: l2_translate(in_path, out_path)
    l2_os_select: 0
    l2_snap_free()
return: r

external:
    fn: main (int: argc; @@: char argv) int
        int: r
        int: a 1
        @: FILE af
        const: @: char lg
        const: @: char rt
        c.setvbuf(l1_stdout(), 0, c._IONBF, 0)
        c.setvbuf(l1_stderr(), 0, c._IONBF, 0)
        # The test knob `--walk-methods` (-193 T4a): a method with frames gets native 0.
        if: argc >= a + 3 && c.strcmp(argv[a], "--walk-methods") = 0
            l2_walk_methods: 1
            a: a + 1
        ---
        # The library profile is selected here, never inferred from the unit.
        if: argc >= a + 3 && c.strcmp(argv[a], "--library") = 0
            l2_library_flag: 1
            a: a + 1
        ---
        # A library's construction export is named by the build, never derived from the unit or its path.
        if: l2_library_flag != 0 && argc >= a + 4 && c.strcmp(argv[a], "--construct") = 0
            l2_construct_name: argv[a + 1]
            a: a + 2
        ---
        # The constructions the build links into this program, each by its export's exact name.
        while: argc >= a + 4 && c.strcmp(argv[a], "--provider") = 0
            if: l2_provider_names = 0
                l2_provider_names: (cast: (@@: char) calloc((cast: (size_t) argc), c.sizeof(@: char)))
            if: l2_provider_names = 0
                fputs("l2trans error: out of memory\n", l1_stderr())
                return: 1
            l2_provider_names[l2_provider_n]: argv[a + 1]
            l2_provider_n: l2_provider_n + 1
            a: a + 2
        ---
        # The machine functions a library exports with a direct C-compatible entry (S8.2, L2 section 20), each by its
        # exact name, and the header its machine module writes.
        while: argc >= a + 4 && c.strcmp(argv[a], "--machine") = 0
            if: l2_machine_names = 0
                l2_machine_names: (cast: (@@: char) calloc((cast: (size_t) argc), c.sizeof(@: char)))
            if: l2_machine_names = 0
                fputs("l2trans error: out of memory\n", l1_stderr())
                return: 1
            l2_machine_names[l2_machine_n]: argv[a + 1]
            l2_machine_n: l2_machine_n + 1
            a: a + 2
        ---
        if: argc >= a + 4 && c.strcmp(argv[a], "--header") = 0
            l2_header_path: argv[a + 1]
            a: a + 2
        ---
        # The snapshot's test flag (l2_snap_touch): `--snap-touch FILE`.
        if: argc >= a + 4 && c.strcmp(argv[a], "--snap-touch") = 0
            l2_snap_touch: c.atoi(argv[a + 1])
            a: a + 2
        ---
        if: argc < a + 2
            fputs("usage: l2trans.exe [--walk-methods] [--library (--construct NAME | --machine NAME ... [--header FILE])] [--provider NAME ...] [--snap-touch FILE] <source.lm2> [<part.lm2> ...] <output.lm1>\n", l1_stderr())
            return: 1
        if: l2_library_flag != 0 && l2_machine_n = 0 && lm_compiler_construct_name_ok(l2_construct_name) = 0
            fputs("l2trans error: a library translation needs --construct NAME: a C name, not l2_ or lmx_, of its construction export\n", l1_stderr())
            return: 1
        # A machine module (S8.2) is a library with no construction: a unit whose functions are entered by C alone.
        if: l2_machine_n > 0 && (l2_library_flag = 0 || l2_construct_name != 0)
            fputs("l2trans error: --machine NAME is a machine module's: a library translation with no --construct\n", l1_stderr())
            return: 1
        if: l2_header_path != 0 && l2_machine_n = 0
            fputs("l2trans error: --header FILE is a machine module's: it needs --machine NAME\n", l1_stderr())
            return: 1
        int: mk 0
        int: mj 0
        while: mk < l2_machine_n
            if: c.strncmp(l2_machine_names[mk], "l2_", 3U) = 0
                c.fprintf(l1_stderr(), "l2trans error: --machine %s: a machine function's C name is not l2_, the translator's own\n", l2_machine_names[mk])
                return: 1
            mj: 0
            while: mj < mk
                if: c.strcmp(l2_machine_names[mj], l2_machine_names[mk]) = 0
                    c.fprintf(l1_stderr(), "l2trans error: --machine %s is given twice\n", l2_machine_names[mk])
                    return: 1
                mj: mj + 1
            ---
            mk: mk + 1
        ---
        int: pk 0
        int: pj 0
        while: pk < l2_provider_n
            if: lm_compiler_construct_name_ok(l2_provider_names[pk]) = 0
                c.fprintf(l1_stderr(), "l2trans error: --provider %s: a provider is a construction export's C name, not l2_ or lmx_\n", l2_provider_names[pk])
                return: 1
            pj: 0
            while: pj < pk
                if: c.strcmp(l2_provider_names[pj], l2_provider_names[pk]) = 0
                    c.fprintf(l1_stderr(), "l2trans error: --provider %s is given twice\n", l2_provider_names[pk])
                    return: 1
                pj: pj + 1
            ---
            pk: pk + 1
        ---
        # The program (steps/table-receiver.md §8, Q46): the source, the files named after it -- its parts --
        # and the output last.
        l2_part_path: argv + a + 1
        l2_part_n: argc - a - 2
        rt: c.getenv("L2_RUNTIME_ROOT")
        if: rt != 0 && rt[0] != 0
            l2_rt_root: rt
        if: c.getenv("L2_FAIL_MALLOC") != 0
            l2_fail_left: c.atoi(c.getenv("L2_FAIL_MALLOC"))
        if: c.getenv("L2_ALLOC_TRACE") != 0
            l2_alloc_trace: c.fopen(c.getenv("L2_ALLOC_TRACE"), "wb")
        r: l2_translate_program(argv[a], argv[argc - 1])
        # A failure that printed no located diagnostic is still a failure the
        # user must see; a silent exit 1 names nothing to fix.  It is an invariant break of the
        # translator (D-112): every refusal says where and why -- this line names the step that did
        # not, and exits 3, apart from a refusal's 1.
        if: r != 0 && l2_diag_n = 0
            c.fprintf(l1_stderr(), "l2trans error: %s: internal: a refusal said nothing (a step failed without a located diagnostic)\n", argv[a])
            r: 3
        # The other half of that invariant (slice 2 of the receiver `table`, REVIEW of its CHECK): what says an
        # error refuses.  A translation that said one and still succeeded would leave an "l2trans error:" line
        # with an L1 file behind it -- a place that said why it cannot answer and let the translation go on.
        # No place does that today; this names the step that would, removes its output and exits 3.
        if: r = 0 && l2_diag_n != 0
            c.fprintf(l1_stderr(), "l2trans error: %s: internal: a diagnostic was said and the translation went on\n", argv[a])
            c.remove(argv[argc - 1])
            r: 3
        l2_release()
        if: l2_alloc_trace != 0
            fclose(l2_alloc_trace)
            l2_alloc_trace: 0
        lg: c.getenv("L2_ALLOC_LOG")
        if: lg != 0
            af: c.fopen(lg, "wb")
            if: af != 0
                c.fprintf(af, "n=%d free=%d live=%d fail_at=%d fail_kind=%d err=%d\n", l2_alloc_n, l2_free_n, l2_alloc_live, l2_alloc_fail_at, l2_alloc_fail_kind, l2_alloc_err)
                fclose(af)
            ---
        ---
    return: r
end: external
