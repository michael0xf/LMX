fn: lm_compiler_reference_path_projection (const: (@: path c.L2Path); @: out c.L2ReferenceSource) int
    @: own_n_cell int (cast: (@: int) (@ c.l2_own_n))
    @@: own_ty_cell int (cast: (@@: int) (@ c.l2_own_ty))
    @@: own_mi_cell int (cast: (@@: int) (@ c.l2_own_mi))
    @: nsf_n_cell int (cast: (@: int) (@ c.l2_nsf_n))
    @@: nsf_kind_cell int (cast: (@@: int) (@ c.l2_nsf_kind))
    @: e_cell int (cast: (@: int) (@ c.l2_e))
    @: step c.L2PathStep
    int: own
    int: row
    if: path = 0 || out = 0 || path\n < 1 || path\steps = 0 || path\fail_why != 0
        return: (cast: (int) (1))
    out\origin: 0
    out\origin_count: 0
    out\origin_method: -1
    step: path\steps + (path\n - 1)
    if: step\formal >= 0 && step\node_host >= 0
        return: (cast: (int) (c.lm_compiler_reference_input_source((cast: (int) (step\node_host)), (cast: (int) (step\formal)), out)))
    own: step\own
    if: own >= 0
        if: own >= own_n_cell[0] || c.lm_compiler_own_nsty_get(own) < 0 || c.lm_compiler_pointer_depth(c.lm_compiler_ft_of_own(own_ty_cell[0][own])) != 1
            return: (cast: (int) (1))
        out\schema: c.lm_compiler_own_schema(own)
        out\path: 0
        out\layout: 0 - 1
        out\method: own_mi_cell[0][own]
        out\place: c.lm_compiler_d105_own_key(own)
        return: (cast: (int) (0))
    ---
    # The common resolver already retained the complete leaf contract,
    # including an indexed or composed reference. Do not require a named
    # declaration row to keep that contract, and never infer physical origin
    # from it. Array storage is not its element's giving namespace.
    if: path\array_leaf != 0 || path\leaf_model = -1 || c.lm_compiler_pointer_depth(c.lm_compiler_path_rec_leaf_ft(path)) != 1
        return: (cast: (int) (1))
    out\schema: path\leaf_model
    out\path: 0
    out\layout: -1
    out\method: -1
    out\place: -1
    # A real declaration row additionally supplies its existing flow key.
    # Absence of that key does not erase the resolved logical leaf Model.
    row: step\nsrow
    if: row >= 0 && row < nsf_n_cell[0] && nsf_kind_cell[0][row] = 10
        out\method: e_cell[0]
        out\place: lm_compiler_d105_field_key(row)
