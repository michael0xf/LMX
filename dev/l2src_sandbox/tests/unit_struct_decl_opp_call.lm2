include: "l1src/p0.lm1.h"

# Opposite: ordinary same-unit call must not be swallowed as struct decl.
fn: add (int: a) int
    return: a + 1
end: add

fn: probe () int
    return: add(1)
end: probe

if: probe() != 2
    sendMessage: exit(exit_code: 81; stdout: ""; stderr: "")
    return
sendMessage: exit(exit_code: 7; stdout: ""; stderr: "")
return
