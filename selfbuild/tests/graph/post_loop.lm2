# The post-loop witnesses retain their results; ordinary Structures are declared in main's data (M11.5v).
# The multi-line data group uses the same P0 stream parser as the rest of the source.
fn: repeat () int
    int: i 0
    ---
        i := i + 1
    until: i = 3
    return: i

fn: condition () int (int: calls 0)
    calls := calls + 1
    return: calls >= 2

fn: transitions () int
    int: attempt 0
    ---
        attempt := attempt + 1
        if: attempt = 1
            redo()
        if: attempt = 2
            continue()
    until: condition()
    return: attempt

fn: leave () int
    int: n 0
    ---
        n := n + 1
        break()
    until: condition()
    return: n

fn: early () int
    ---
        return: 9
    until: condition()

fn: body_fields () int
    late := 4
    ---
        int: late
    until: late = 4
    return: late

fn: bare_body () int
    int: i 1
    ---
        i
    until: 1
    return: i

sub: main () (
    Repeat:
        x := x + 1
    until: x = 2
    Data:
        int: x 0
    RepeatOwn:
        data:
            int: x 0
        code:
            ---
                x := x + 1
            until: x = 2
    end: RepeatOwn
    # The own declaration is reached on each pass; it is not a persistent loop counter.
    Self:
        int: x 0
        x := x + 2
    until: x = 2
    int: result 0
    int: before_call 0
    int: after_call 0
    int: transitioned 0
    int: left 0
    int: early_result 0
    int: from_body 0
    int: condition_calls 0
    int: root_value 0
    int: own_before 0
    int: own_after 0
    int: same_data 0
    int: bare_result 0
)
    result := repeat()
    before_call := Data\x
    call: Data Repeat
    after_call := Data\x
    transitioned := transitions()
    left := leave()
    early_result := early()
    from_body := body_fields()
    condition_calls := condition\data\calls
    ---
        root_value := root_value + 1
        continue()
    until: root_value = 2
    own_before := RepeatOwn\data\x
    call: RepeatOwn\data RepeatOwn\code
    own_after := RepeatOwn\data\x
    call: Self Self
    same_data := Self\x
    bare_result := bare_body()
main()
int: result main\data\result
int: before_call main\data\before_call
int: after_call main\data\after_call
int: transitioned main\data\transitioned
int: left main\data\left
int: early_result main\data\early_result
int: from_body main\data\from_body
int: condition_calls main\data\condition_calls
int: root_value main\data\root_value
int: own_before main\data\own_before
int: own_after main\data\own_after
int: same_data main\data\same_data
int: bare_result main\data\bare_result
