    return: (cast: (int) ((cast: (int) (c.fprintf(out_cell[0], "%sif: l2_result_context != 0\n%s    lmx_value_context_copy(l2_result_context, @ l2_cv%d)\n%s---\n", ind, ind, source_context, ind) < 0))))
end: lm_compiler_emit_result_context

fn: lm_compiler_mqopaque_count () int
    int@: foreign_n_cell (cast: (int@) (@ c.l2_foreign_n))
    int: i 0
    int: n 1
    while: i < foreign_n_cell[0]
        if: lm_compiler_foreign_opaque(i) != 0
            n := n + 1
        i := i + 1
    ---
    return: (cast: (int) (n))
end: lm_compiler_mqopaque_count

fn: lm_compiler_emit_send (int: k; int: proto; char@: prefix; int@: count_arr; int@: off_arr; int@: kind_arr; c.LmP0Text@@: text_arr; int@: has_ref_arr) int
    c.FILE@@: out_cell (cast: (c.FILE@@) (@ c.l2_out))
    int: j
    int: nf
    int: has_ref
    nf := count_arr[k]
    has_ref := has_ref_arr[k]
    if: proto != 0
        return: (cast: (int) ((cast: (int) (c.fprintf(out_cell[0], "    fn: %s%d (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out; @: LmxArena lmx_call_arena; @: Lmx lmx_call_code; @: LmxWalkValue lmx_input_values; @: LmxWalkValue lmx_result_context) int\n", prefix, k) < 0))))
    if: c.fprintf(out_cell[0], "fn: %s%d (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out; @: LmxArena lmx_call_arena; @: Lmx lmx_call_code; @: LmxWalkValue lmx_input_values; @: LmxWalkValue lmx_result_context) int\n", prefix, k) < 0
        return: (cast: (int) (1))
    if: c.fputs("    @: LmxThread t lmx_thread_current()\n    @: LmxArena a (cast: (@: LmxArena) calloc(1U, c.sizeof(c.LmxArena)))\n    @: LmxMsg m 0\n    @: Lmx g 0\n    @: Lmx p 0\n    @: void cell 0\n    @: LmxArray text 0\n    @: LmxArray source_text 0\n    if: t = 0 || a = 0 || lmx_arena_open(a) != 0\n        l2_send_fail()\n", out_cell[0]) < 0
        return: (cast: (int) (1))
    if: c.fprintf(out_cell[0], "    if: nargs != %dU || (nargs != 0U && refs = 0)\n        l2_send_fail()\n    m: (cast: (@: LmxMsg) lmx_arena_take(a, c.sizeof(c.LmxMsg), c.LMX_DOMAIN_KIND_MSG_RECORD, c.LMX_DOMAIN_MSG_RECORD))\n    g: lmx_node_new_owned(a)\n    p: lmx_node_new_owned(a)\n    if: m = 0 || g = 0 || p = 0 || lmx_arena_refs_open_owned(a, g, 2U) != 0 || lmx_arena_refs_open_owned(a, p, %dU) != 0\n        l2_send_fail()\n", (nf + has_ref), nf) < 0
        return: (cast: (int) (1))
    j := 0
    while: j < nf
        if: kind_arr[off_arr[k] + j] = 1 && c.fprintf(out_cell[0], "    cell: lmx_int_new_owned(a)\n    if: cell = 0 || refs[%d] = 0 || lmx_int_store_known(cell, lmx_int_value_known(refs[%d])) != 0 || lmx_arena_ref_store(a, p, %dU, cell) != 0\n        l2_send_fail()\n", j, j, j) < 0
            return: (cast: (int) (1))
        if: kind_arr[off_arr[k] + j] = 2 && c.fprintf(out_cell[0], "    if: refs[%d] = 0\n        l2_send_fail()\n    source_text: (cast: (@: LmxArray) lmx_pointer_value_known(refs[%d]))\n    if: source_text = 0 || lmx_domain_kind(lmx_call_arena, (cast: (@: void) source_text)) != c.LMX_KIND_ARRAY || lmx_type_base(lmx_domain_type(lmx_call_arena, (cast: (@: void) source_text))) != c.LMX_TYPE_ARRAY_OF_CHAR || (source_text\\array.size != 0U && source_text\\array.data = 0)\n        l2_send_fail()\n    text: lmx_array_new_child_profiled(p, c.LMX_TYPE_ARRAY_OF_CHAR, (source_text\\array.size), a, 0)\n    if: text = 0 || lmx_arena_ref_store(a, p, %dU, (cast: (@: void) text)) != 0\n        l2_send_fail()\n    if: source_text\\array.size != 0U\n        memcpy((text\\array.data), (source_text\\array.data), (source_text\\array.size))\n    ---\n", j, j, j) < 0
            return: (cast: (int) (1))
        j := j + 1
    ---
    # The sender slot is a pointer CELL holding the current Message's address, not the address
    # itself (FABLE-SONNET-SEND-REF-20260925-172 commit 4, author's Q26.2 ruling: a reference is a
    # reference TO a reference -- storing the raw address directly would make the sender a CHILD of
    # the letter, and its domain would then disagree with a receiving field's own prototype cell at
    # admission, D-56's real cause). Same cell type D-52's kind-10/11 cells get from
    # l2_ptr_cell_type (LMX_TYPE_MSG_REF) so a receiver's `m\sender` field agrees.
    if: c.fprintf(out_cell[0], "    cell: lmx_pointer_new_owned(c.LMX_TYPE_MSG_REF, a)\n    if: cell = 0 || lmx_pointer_store_known(cell, (cast: (@: void) lmx_thread_message(t))) != 0 || lmx_arena_ref_store(a, g, 0U, cell) != 0 || lmx_arena_ref_store(a, g, 1U, (cast: (@: void) p)) != 0\n        l2_send_fail()\n    m\\running: 1\n    m\\success: 0\n    m\\handoff_ready: 0\n    m\\graph: g\n") < 0
        return: (cast: (int) (1))
    if: has_ref != 0
        if: c.fprintf(out_cell[0], "    if: lmx_service_post(lmx_child_service(t), lmx_pointer_value_known(refs[%d]), m, a) != c.LMX_SERVICE_OK\n        l2_send_fail()\n    return: 0\n", nf) < 0
            return: (cast: (int) (1))
        ---
    else:
        if: c.fputs("    if: lmx_service_post(lmx_child_service(t), (cast: (@: void) lmx_thread_parent(t)), m, a) != c.LMX_SERVICE_OK\n        l2_send_fail()\n    return: 0\n", out_cell[0]) < 0
            return: (cast: (int) (1))
        ---
    ---
    return: (cast: (int) ((cast: (int) (c.fprintf(out_cell[0], "end: %s%d\n\n", prefix, k) < 0))))
end: lm_compiler_emit_send

fn: lm_compiler_emit_source_name (const: (char@: key); const: (c.LmP0Text@: text); const: (char@: ind); const: (char@: fail); const: (char@: fail2)) int
    c.FILE@@: out_cell (cast: (c.FILE@@) (@ c.l2_out))
    if: text = 0 || text\length = 0U
        return: (cast: (int) (0))
    # IDENTIFIER-CODES: the occurrence's name is the code of its spelling, read from the unit's table.
    if: c.fprintf(out_cell[0], "%sif: lmx_source_name_set(l2_program_arena, (cast: (@: void) %s), ", ind, key) < 0 || lm_compiler_emit_unit_id_text(text) != 0
        return: (cast: (int) (1))
    if: c.fprintf(out_cell[0], ") != 0\n%s    %s\n", ind, fail) < 0
        return: (cast: (int) (1))
    if: fail2 != 0 && c.fprintf(out_cell[0], "%s    %s\n", ind, fail2) < 0
        return: (cast: (int) (1))
    return: (cast: (int) (0))
end: lm_compiler_emit_source_name

fn: lm_compiler_emit_method_part_name (int: slot; const: (char@: name)) int
    c.FILE@@: out_cell (cast: (c.FILE@@) (@ c.l2_out))
    if: slot < 0 || name = 0
        return: (cast: (int) (1))
    if: c.fprintf(out_cell[0], "        if: lmx_source_name_set(l2_program_arena, (cast: (@: void) lmx_arena_ref_cell(l2_entry_leaf, %uU)), ", (cast: (unsigned) slot)) < 0 || lm_compiler_emit_unit_id(name, c.strlen(name)) != 0
        return: (cast: (int) (1))
    return: (cast: (int) (c.fputs(") != 0\n            return: 1\n", out_cell[0]) < 0))
end: lm_compiler_emit_method_part_name

fn: lm_compiler_emit_source_failure (const: (char@: ind); const: (char@: fail); const: (char@: fail2)) int
    c.FILE@@: out_cell (cast: (c.FILE@@) (@ c.l2_out))
    if: c.fprintf(out_cell[0], "%s    %s\n", ind, fail) < 0
        return: (cast: (int) (1))
    if: fail2 != 0 && c.fprintf(out_cell[0], "%s    %s\n", ind, fail2) < 0
        return: (cast: (int) (1))
    return: (cast: (int) (0))
end: lm_compiler_emit_source_failure

# A defined fn/sub has its ordinary parts also when its only code is a
# return trailer. Reuse the implementation reader used by native emission;
# a bodyless interface still has no implementation and gains no invented body.
fn: lm_compiler_fn_parts_on (int: mi) int
    int@: m_n_cell (cast: (int@) (@ c.l2_m_n))
    c.LmP0Node@@@: m_node_cell (cast: (c.LmP0Node@@@) (@ c.l2_m_node))
    if: mi < 0 || mi >= m_n_cell[0] || m_node_cell[0][mi] = 0 || c.lm_compiler_m_native(mi) = 0
        return: 0
return: (cast: (int) (c.lm_compiler_frame_head(m_node_cell[0][mi], "fn") != 0 || c.lm_compiler_frame_head(m_node_cell[0][mi], "sub") != 0))

fn: lm_compiler_mad_is_return (const: (c.LmP0Node@: stmt); int: model) int
    c.LmP0Field@: only
    if: model < 0 || c.lm_compiler_frame_head(stmt, "return") = 0 || stmt\as\frame\body = 0 || c.lm_compiler_count_active(stmt\as\frame\body) != 1
        return: (cast: (int) (0))
    only := c.lm_compiler_next_active(stmt\as\frame\body\first_field)
    if: only = 0 || only\value = 0 || only\value\kind != c.LM_P0_NODE_ATOM || only\value\as = 0
        return: (cast: (int) (0))
    return: (cast: (int) (lm_compiler_find_method((cast: (const: c.LmP0Text@) (only\value\as\atom))) = model))
end: lm_compiler_mad_is_return

fn: lm_compiler_mad_tr_is (const: (c.LmP0Structure@: tr); int: model) int
    c.LmP0Field@: only
    if: tr = 0 || model < 0 || c.lm_compiler_count_active(tr) != 1
        return: (cast: (int) (0))
    only := c.lm_compiler_next_active(tr\first_field)
    if: only = 0 || only\value = 0 || only\value\kind != c.LM_P0_NODE_ATOM || only\value\as = 0
        return: (cast: (int) (0))
    return: (cast: (int) (lm_compiler_find_method((cast: (const: c.LmP0Text@) (only\value\as\atom))) = model))
end: lm_compiler_mad_tr_is

fn: lm_compiler_mad_trailer_return (int: mi; int: model) int
    c.LmP0Node@@@: m_node_cell (cast: (c.LmP0Node@@@) (@ c.l2_m_node))
    c.LmP0Field@: f
    if: m_node_cell[0][mi] = 0 || m_node_cell[0][mi]\as = 0 || m_node_cell[0][mi]\as\frame = 0
        return: (cast: (int) (0))
    if: lm_compiler_mad_tr_is(c.lm_compiler_source_ret_tr(m_node_cell[0][mi]\as\frame), model) != 0
        return: (cast: (int) (1))
    if: m_node_cell[0][mi]\as\frame\body = 0
        return: (cast: (int) (0))
    f := c.lm_compiler_next_active(m_node_cell[0][mi]\as\frame\body\first_field)
    if: f != 0
        f := c.lm_compiler_next_active(f\next)
    if: f != 0
        f := c.lm_compiler_next_active(f\next)
    if: f = 0 || f\value = 0 || c.lm_compiler_frame_head(f\value, "fn") = 0
        return: (cast: (int) (0))
    return: (cast: (int) (lm_compiler_mad_tr_is(c.lm_compiler_source_ret_tr(f\value\as\frame), model)))
end: lm_compiler_mad_trailer_return

fn: lm_compiler_receiver_call (const: (c.LmP0Node@: stmt); c.LmP0Text@@: out_name) c.LmP0Node@
    c.LmP0Node@: g
    g := c.lm_compiler_receiver_frame(stmt, out_name)
    if: g != 0 && lm_compiler_find_method((cast: (const: c.LmP0Text@) (g\as\frame\head))) >= 0
        return: (cast: (c.LmP0Node@) (g))
    if: out_name != 0
        \out_name := 0
    return: (cast: (c.LmP0Node@) (0))
end: lm_compiler_receiver_call

fn: lm_compiler_store_host (const: (c.LmP0Node@: stmt)) int
    const: (c.LmP0Node@: call_node lm_compiler_receiver_call(stmt, 0))
    if: call_node = 0
        return: (cast: (int) (-1))
    return: (cast: (int) (lm_compiler_find_method((cast: (const: c.LmP0Text@) (call_node\as\frame\head)))))
end: lm_compiler_store_host

fn: lm_compiler_store_name (const: (c.LmP0Node@: stmt)) c.LmP0Text@
    c.LmP0Text@: name 0
    if: lm_compiler_receiver_call(stmt, @ name) = 0
        return: (cast: (c.LmP0Text@) (0))
    return: (cast: (c.LmP0Text@) (name))
end: lm_compiler_store_name

fn: lm_compiler_mad_hdr_arity (int: mi) int
    c.LmP0Node@@@: m_node_cell (cast: (c.LmP0Node@@@) (@ c.l2_m_node))
    c.LmP0Field@: f
    c.LmP0Node@: h
    if: m_node_cell[0][mi] = 0 || m_node_cell[0][mi]\as = 0 || m_node_cell[0][mi]\as\frame = 0 || m_node_cell[0][mi]\as\frame\body = 0
        return: (cast: (int) (0))
    f := c.lm_compiler_next_active(m_node_cell[0][mi]\as\frame\body\first_field)
    if: f != 0
        f := c.lm_compiler_next_active(f\next)
    if: f != 0
        f := c.lm_compiler_next_active(f\next)
    if: f = 0 || f\value = 0 || c.lm_compiler_frame_head(f\value, "fn") = 0 || f\value\as\frame\body = 0
        return: (cast: (int) (0))
    h := f\value
    f := c.lm_compiler_next_active(h\as\frame\body\first_field)
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_STRUCTURE || f\value\as = 0
        return: (cast: (int) (0))
    return: (cast: (int) (c.lm_compiler_count_active(f\value\as\structure)))
end: lm_compiler_mad_hdr_arity

fn: lm_compiler_num_read_text (int: ty; const: (char@: p); c.L2Tx@: dest) int
    const: (char@: f "lmx_int_value_known(")
    const: (char@: e ")")
    if: ty = 1
        f := "(cast: (char) lmx_char_value_known("
        e := "))"
    if: ty = 2
        f := "lmx_size_value_known("
    if: ty = 3
        f := "lmx_unsigned_value_known("
    if: ty = 36
        f := "lmx_ulong_value_known("
    return: (cast: (int) (c.lm_compiler_tx_join(dest, f, p, e, 0, 0)))
end: lm_compiler_num_read_text

fn: lm_compiler_mad_cap_emit_walk (int: ri; int: slot) int
    c.FILE@@: out_cell (cast: (c.FILE@@) (@ c.l2_out))
    if: c.fprintf(out_cell[0], "    l2_mad_cell: lmx_pointer_value_known(refs[%uU])\n    if: lmx_arena_ref_store((cast: (@: LmxArena) owner), l2_madc, %uU, l2_mad_cell) != 0\n        c.abort()\n", (cast: (unsigned) ri), (cast: (unsigned) slot)) < 0
        return: (cast: (int) (1))
    return: (cast: (int) (0))
end: lm_compiler_mad_cap_emit_walk

fn: lm_compiler_t7_host_sig (int: mi) c.LmP0Node@
    c.LmP0Node@@@: m_node_cell (cast: (c.LmP0Node@@@) (@ c.l2_m_node))
    c.LmP0Field@: f
    if: m_node_cell[0][mi] = 0 || m_node_cell[0][mi]\as = 0 || m_node_cell[0][mi]\as\frame = 0 || m_node_cell[0][mi]\as\frame\body = 0
        return: (cast: (c.LmP0Node@) (0))
    f := c.lm_compiler_next_active(m_node_cell[0][mi]\as\frame\body\first_field)
    if: f != 0
        f := c.lm_compiler_next_active(f\next)
    if: f != 0
        f := c.lm_compiler_next_active(f\next)
    if: f = 0 || f\value = 0 || c.lm_compiler_frame_head(f\value, "fn") = 0
        return: (cast: (c.LmP0Node@) (0))
    return: (cast: (c.LmP0Node@) (f\value))
end: lm_compiler_t7_host_sig

fn: lm_compiler_emit_public_sig (int: mi) int
    c.FILE@@: out_cell (cast: (c.FILE@@) (@ c.l2_out))
    int@@: m_arity_cell (cast: (int@@) (@ c.l2_m_arity))
    int: j 0
    int: ty
    int: oty
    int: rt lm_compiler_sig_ret(mi)
    const: (char@: sep "")
    if: c.fputs(" (", out_cell[0]) < 0
        return: (cast: (int) (1))
    while: j < m_arity_cell[0][mi]
        ty := lm_compiler_ft(mi, j)
        # D-101: a declared graph formal holds the graph code, spelled as l2_emit_formal spells it
        # (l2_formal_raw); read raw, l2_emit_foreign_named got an index past its table
        # and the translation failed with no located diagnostic.  The result goes through
        # l2_sig_ret for the same reason (-137 part 2).
        ty := lm_compiler_formal_raw(ty)
        if: j != 0
            sep := "; "
        if: ty = 0 && c.fprintf(out_cell[0], "%sint: ", sep) < 0
            return: (cast: (int) (1))
        if: ty = 1 && c.fprintf(out_cell[0], "%schar: ", sep) < 0
            return: (cast: (int) (1))
        if: ty = 2 && c.fprintf(out_cell[0], "%ssize_t: ", sep) < 0
            return: (cast: (int) (1))
        if: ty = 34 && c.fprintf(out_cell[0], "%sunsigned: ", sep) < 0
            return: (cast: (int) (1))
        if: ty = 36 && c.fprintf(out_cell[0], "%sulong: ", sep) < 0
            return: (cast: (int) (1))
        if: ty = 3 && c.fprintf(out_cell[0], "%sconst: @(char ", sep) < 0
            return: (cast: (int) (1))
        if: ty = 9 && c.fprintf(out_cell[0], "%s@: size_t ", sep) < 0
            return: (cast: (int) (1))
        if: ty = 11 && c.fprintf(out_cell[0], "%s@: int ", sep) < 0
            return: (cast: (int) (1))
        if: ty = 12 && c.fprintf(out_cell[0], "%s@: char ", sep) < 0
            return: (cast: (int) (1))
        if: ty = 16 && c.fprintf(out_cell[0], "%s@: void ", sep) < 0
            return: (cast: (int) (1))
        if: ty = 17 && c.fprintf(out_cell[0], "%s@@: char ", sep) < 0
            return: (cast: (int) (1))
        if: ty = 18 && c.fprintf(out_cell[0], "%s@@: void ", sep) < 0
            return: (cast: (int) (1))
        if: ty = 19 && c.fprintf(out_cell[0], "%s@@: int ", sep) < 0
            return: (cast: (int) (1))
        if: ty = 20 && c.fprintf(out_cell[0], "%s@@: size_t ", sep) < 0
            return: (cast: (int) (1))
        if: ty = 24 && c.fprintf(out_cell[0], "%s@@: unsigned ", sep) < 0
            return: (cast: (int) (1))
        if: ty = 39 && c.fprintf(out_cell[0], "%s@@: ulong ", sep) < 0
            return: (cast: (int) (1))
        if: ty = 25 && c.fprintf(out_cell[0], "%s@: unsigned ", sep) < 0
            return: (cast: (int) (1))
        if: ty = 38 && c.fprintf(out_cell[0], "%s@: ulong ", sep) < 0
            return: (cast: (int) (1))
        if: ty >= 100
            if: lm_compiler_emit_foreign_named(out_cell[0], ty, sep, lm_compiler_fn(mi, j)) != 0
                return: (cast: (int) (1))
            ---
        else:
            if: ty != 0 && ty != 1 && ty != 2 && ty != 3 && ty != 9 && ty != 11 && ty != 12 && ty != 16 && ty != 17 && ty != 18 && ty != 19 && ty != 20 && ty != 24 && ty != 25 && ty != 34 && ty != 36 && ty != 38 && ty != 39
                c.fprintf(c.l1_stderr(), "l2trans: a library signature cannot spell formal type %d\n", ty)
                return: (cast: (int) (1))
            if: c.lm_compiler_write_text(out_cell[0], lm_compiler_fn(mi, j)) != 0
                return: (cast: (int) (1))
            if: ty = 3 && c.fputs(")", out_cell[0]) < 0
                return: (cast: (int) (1))
        ---
        j := j + 1
    ---
    if: rt = 2 && c.fputs(") size_t", out_cell[0]) < 0
        return: (cast: (int) (1))
    if: rt = 33 && c.fputs(") unsigned", out_cell[0]) < 0
        return: (cast: (int) (1))
    if: rt = 36 && c.fputs(") ulong", out_cell[0]) < 0
        return: (cast: (int) (1))
    if: rt = 3 && c.fputs(") @: char", out_cell[0]) < 0
        return: (cast: (int) (1))
    if: rt = 16 && c.fputs(") @: void", out_cell[0]) < 0
        return: (cast: (int) (1))
    if: rt = 35 && c.fputs(") const: @(char)", out_cell[0]) < 0
        return: (cast: (int) (1))
    if: rt = 32 && c.fputs(") @@: char", out_cell[0]) < 0
        return: (cast: (int) (1))
    if: rt >= 100 && lm_compiler_emit_foreign_return(out_cell[0], rt) != 0
        return: (cast: (int) (1))
    if: rt = 8 && c.fputs(")", out_cell[0]) < 0
        return: (cast: (int) (1))
    if: lm_compiler_ret_uns(mi) = 0 && rt != 3 && rt != 8 && rt != 16 && rt != 32 && rt != 35 && rt < 100 && c.fputs(") int", out_cell[0]) < 0
        return: (cast: (int) (1))
    return: (cast: (int) (0))
end: lm_compiler_emit_public_sig

# The own type of a typed merge operand, by its head word (`int: a 5`).  The operand written name first, `a: int: 5`,
# is withdrawn (plan M9; the author, 2026-11-10).
fn: lm_compiler_merge_typed_own (const: (c.LmP0Node@: d)) int
    int: kind c.lm_compiler_lit_field_kind(d)
    if: kind < 0
        return: (cast: (int) (0 - 1))
    return: (cast: (int) (lm_compiler_own_ty_of_param(c.lm_compiler_path_kind_ft(kind))))
end: lm_compiler_merge_typed_own

fn: lm_compiler_foreign_opaque (int: i) int
    int@: foreign_n_cell (cast: (int@) (@ c.l2_foreign_n))
    int@@: foreign_depth_cell (cast: (int@@) (@ c.l2_foreign_depth))
    c.LmP0Text@@@: foreign_name_cell (cast: (c.LmP0Text@@@) (@ c.l2_foreign_name))
    if: i < 0 || i >= foreign_n_cell[0]
        return: (cast: (int) (0))
    return: (cast: (int) ((cast: (int) (foreign_depth_cell[0][i] > 0 && lm_compiler_foreign_native_void(i) = 0 && c.lm_compiler_text_eq(foreign_name_cell[0][i], "char") = 0 && c.lm_compiler_text_eq(foreign_name_cell[0][i], "size_t") = 0 && c.lm_compiler_text_eq(foreign_name_cell[0][i], "int") = 0 && c.lm_compiler_text_eq(foreign_name_cell[0][i], "void") = 0 && c.lm_compiler_text_eq(foreign_name_cell[0][i], "unsigned") = 0 && c.lm_compiler_text_eq(foreign_name_cell[0][i], "ulong") = 0))))
end: lm_compiler_foreign_opaque

fn: lm_compiler_emit_merge_profile (const: (char@: ind); int: msf; int: k) int
    c.FILE@@: out_cell (cast: (c.FILE@@) (@ c.l2_out))
    return: (cast: (int) ((cast: (int) (c.fprintf(out_cell[0], "%sl2_mprofiles[l2_mprofile_n%d]: lmx_merge_retain_profile(l2_program_arena, l2_mops[%dU])\n%sif: l2_mprofiles[l2_mprofile_n%d] != 0\n%s    l2_mprofile_n%d: l2_mprofile_n%d + 1U\n%s---\n", ind, msf, k, ind, msf, ind, msf, msf, ind) < 0))))
