# A program with two os blocks: the program reads one os block (several blocks are OPEN).
os:
    win:
        fn: os_one () int
            return: 1
        end: os_one
    default:
        fn: os_one () int
            return: 1
        end: os_one
end: os
os:
    win:
        fn: os_two () int
            return: 2
        end: os_two
    default:
        fn: os_two () int
            return: 2
        end: os_two
end: os
sendMessage: exit(exit_code: os_one(); stdout: ""; stderr: "")
return
