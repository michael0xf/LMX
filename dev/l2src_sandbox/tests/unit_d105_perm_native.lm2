# D-105 slice 1 (the author's Q39, 2026-09-27): the text of unit_walk_d105_perm.lm2 without
# --walk-methods.  `rd` and `wr` stay native, and a native method reads a Model formal at Model's own
# slots -- the native slice of D-105 is later -- so the walked root refuses to hand them `o: Other`:
# "an admission to a Structure type", located at the call.
Model:
    size_t: a 1U
    size_t: b 2U
end: Model
Other:
    size_t: b 20U
    size_t: a 10U
end: Other
fn: rd (Model: m) size_t
return: m\a
fn: wr (Model: m; size_t: v) size_t
    m\a: v
    return: m\b
Other: o
Model: mm
size_t: got 0U
int: ok 7
got: rd(o)
if: got != 10U
    ok: 1
got: rd(mm)
if: got != 1U
    ok: 2
got: wr(o 11U)
if: got != 20U
    ok: 3
if: o\a != 11U
    ok: 4
if: o\b != 20U
    ok: 5
sendMessage: exit(exit_code: ok; stdout: ""; stderr: "")
return
