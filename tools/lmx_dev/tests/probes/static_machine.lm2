# A machine module of one function, for the hosted CHECK with its context, by the frontend's command line alone (the
# service passes no library context): with the export named, the check passes; with a name no function of the module
# has, the module's own rules refuse it; without --library, --machine is refused before anything is read.
fn: static_probe_passed (size_t: deadline; size_t: now) int
    if: now - deadline < 100U
        return: 1
    return: 0
end: static_probe_passed
