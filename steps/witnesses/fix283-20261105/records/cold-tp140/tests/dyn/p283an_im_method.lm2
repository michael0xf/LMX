# Slice 283 probe: a method called on an immutable value writes its Structure's field.  Entry 7.
Holder:
    int: n 1
    fn: set_n () int
        ---
            node\n: 9
            return: 90
            catch: interpreter ()
                return: 3
        ---
    end: set_n
end: Holder
fn: m () int
    b: immutable: merge(Holder)
    return: b\set_n()
end: m
int: r m()
int: code 7
if: r != 3
