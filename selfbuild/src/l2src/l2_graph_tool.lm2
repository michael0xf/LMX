# The graph tool of the kernel implementation specification (docs/kernel-implementation.ru.md, EN beside it; slice 309,
# the vertical slice of §11 item 0): the emitter of a program over the clean graph (§7) and the command line of the
# tool tools/graph_trans.lm2, which runs the kernel's interpreter over the same graph (lmx_graph_run.lm2, §6). The
# graph is built by the common builder (src/l2src/l2_graph_build.lm2, §1a, §3), which the frontend hosted by the
# runtime shares (slice 338). The new path stands beside the old pipeline and does not touch its emission.
#
# The emitter is a consumer of the clean graph: it reads the graph, not the parse tree. It writes the L1 of a program
# (the form the pipeline's L1 translator and gcc build and the driver runs): the generated initialization of the same
# graph through the common constructor (lmx_graph_*; §1a), the program hooks the driver expects, and the native body of
# the root over the same cells (§7) -- or, in the forced mode, a body that hands the root to the kernel's interpreter.
# The emitter resolves written names itself, at translation, with its own table of the declarations it has emitted and
# the names of the built graph (§3.5, §5.2); the emitted native reads and writes places by their slots.
#
# A machine module (L2 section 20) of the program tools/graph_trans.lm2: built by `lmxtool build-graph` (bld_graph,
# tools/build.lm2) after the builder's module, with the P0 parser's modules of the stage; its exports are named
# there.
predef: "l1src/p0.h.lm1"
predef: "l1src/parser.lm1"
predef: "l2src/lmx_arena.h.lm1"
predef: "l2src/lmx_graph.h.lm1"
predef: "l2src/lmx_graph_run.h.lm1"
predef: "l2src/lmx_graph_copy_owned.h.lm1"
predef: "l2src/l2_graph_build.h.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdio.h>"
include: "<stdlib.h>"
include: "<string.h>"

# ---- The emitter: clean graph -> the L1 of a program (§7) ---------------------------------------------------------

# A spelling as an L1 string literal: a quote and a backslash escaped.
sub: lm_graph_emit_quoted_bytes (@: f c.FILE; @: text char; size_t: count; int: single_line)
    size_t: i 0U
    c.fputc(34, f)
    while: i < count
        if: single_line != 0 && text[i] = 10
            c.fputs("\\n", f)
        else:
            if: single_line != 0 && text[i] = 13
                c.fputs("\\r", f)
            else:
                if: single_line != 0 && text[i] = 9
                    c.fputs("\\t", f)
                else:
                    if: text[i] = 92 || text[i] = 34
                        c.fputc(92, f)
                    c.fputc((cast: (int) text[i]), f)
        ---
        i := i + 1U
    c.fputc(34, f)
return

sub: lm_graph_emit_quoted (@: f c.FILE; @: text char)
    lm_graph_emit_quoted_bytes(f, text, c.strlen(text), 0)
return

# The row of the name table for the value, if any, as a name call after its construction into the L1 local `local`.
fn: lm_graph_emit_name_row (@: g c.LmxGraph; @: f c.FILE; @: address void; @: local char) int
    @: name char (cast: (@: char) c.lmx_graph_name_of(g, address))
    if: name = 0
        return: 0
    c.fprintf(f, "        if: lmx_graph_name(l2_g, %s, ", local)
    lm_graph_emit_quoted(f, name)
    c.fprintf(f, ", %zuU) != 0\n            return: 1\n", (cast: (size_t) c.strlen(name)))
    return: 0
end: lm_graph_emit_name_row

# One temporary source-address map covers the emitted graph, primitives and uninitialized referents. Each live
# address is allocated once; subsequent edges use that generated local. The map is destroyed by this translation.
fn: lm_graph_emit_value (@: g c.LmxGraph; @: f c.FILE; @: value void; @: holder char; size_t: k; @: map c.LmxCopyMap; @: next size_t) int
    int: kind (cast: (int) c.lmx_graph_kind(g, value))
    @: inner c.Lmx 0
    @: text char 0
    @: referent void 0
    @: local char (cast: (@: char) c.malloc(96U))
    size_t: id (cast: (size_t) c.lmx_copy_map_get(map, value))
    size_t: target 0U
    size_t: n 0U
    size_t: j 0U
    int: status 0
    if: local = 0 || value = 0
        c.free(local)
        return: 1
    if: id = 0U
        id := next[0]
        next[0] := id + 1U
        if: c.lmx_copy_map_put(map, value, (cast: (@: void) id)) != 0
            c.free(local)
            return: 1
        c.fprintf(f, "        @: void l2_gv%zu 0\n", id)
        if: kind = 1
            c.fprintf(f, "        l2_gv%zu: lmx_graph_int(l2_g, %d)\n", id, c.lmx_int_value_known(value))
        else:
            if: kind = 3
                referent := c.lmx_arena_pointer_void_read(value)
                target := (cast: (size_t) c.lmx_copy_map_get(map, referent))
                if: target = 0U
                    target := next[0]
                    next[0] := target + 1U
                    status := c.lmx_copy_map_put(map, referent, (cast: (@: void) target))
                    c.fprintf(f, "        @: void l2_gv%zu lmx_int_new_profiled(arena, 0)\n", target)
                c.fprintf(f, "        l2_gv%zu: lmx_arena_pointer_cells_profiled(arena, LMX_TYPE_UNINIT_INT, 0, sizeof(@: void), lmx_arena_pointer_void_read, lmx_arena_pointer_void_write, 1U)\n        if: l2_gv%zu = 0 || l2_gv%zu = 0 || lmx_arena_pointer_void_write(l2_gv%zu, l2_gv%zu) != 0\n            return: 1\n", id, id, target, id, target)
                c.snprintf(local, 96U, "l2_gv%zu", target)
                if: status = 0
                    status := lm_graph_emit_name_row(g, f, referent, local)
                ---
            else:
                if: kind = 2
                    text := c.lmx_graph_word_text(g, value)
                    if: text = 0
                        status := 1
                    else:
                        c.fprintf(f, "        l2_gv%zu: lmx_graph_word(l2_g, ", id)
                        lm_graph_emit_quoted(f, text)
                        c.fprintf(f, ", %zuU)\n", (cast: (size_t) c.strlen(text)))
                    ---
                else:
                    if: kind = 4
                        inner := (cast: (@: c.Lmx) value)
                        n := c.lmx_graph_count(inner)
                        c.fprintf(f, "        l2_gv%zu: (cast: (@: void) lmx_graph_lmx(l2_g, 0, %zuU))\n", id, n)
                        c.snprintf(local, 96U, "(cast: (@: Lmx) l2_gv%zu)", id)
                        while: j < n && status = 0
                            status := lm_graph_emit_value(g, f, c.lmx_graph_get(inner, j), local, j, map, next)
                            j := j + 1U
                        ---
                    else:
                        status := 1
                    ---
                ---
            ---
        ---
        c.fprintf(f, "        if: l2_gv%zu = 0\n            return: 1\n", id)
        c.snprintf(local, 96U, "l2_gv%zu", id)
        if: status = 0 && kind != 3
            status := lm_graph_emit_name_row(g, f, value, local)
        ---
    ---
    if: status = 0
        c.fprintf(f, "        if: lmx_graph_put(%s, %zuU, l2_gv%zu) != 0\n            return: 1\n", holder, k, id)
    c.free(local)
    return: status
end: lm_graph_emit_value

# All graph addresses exist before lexical parent edges are installed, including
# a parent reached after its child. Use the emission's existing local labels to
# order these writes independently of the source-address hash buckets.
fn: lm_graph_emit_parents (@: g c.LmxGraph; @: f c.FILE; @: map c.LmxCopyMap; size_t: limit) int
    @: keys c.VoidDynamicArray @ map\keys
    @: base c.VoidArray (cast: (@: c.VoidArray) keys)
    @: vals c.VoidArray (cast: (@: c.VoidArray) (@ map\vals))
    @@: sources void (cast: (@@: void) base\data)
    @@: labels void (cast: (@@: void) vals\data)
    @@: ordered c.Lmx (cast: (@@: c.Lmx) c.calloc(limit, sizeof(@: c.Lmx)))
    @: current c.Lmx 0
    size_t: i 0U
    size_t: id 1U
    size_t: parent 0U
    int: status 0
    if: ordered = 0
        return: 1
    while: i < keys\capacity
        if: sources[i] != 0 && c.lmx_graph_kind(g, sources[i]) = 4
            ordered[(cast: (size_t) labels[i])] := (cast: (@: c.Lmx) sources[i])
        i := i + 1U
    while: id < limit
        current := ordered[id]
        if: current = 0
            id := id + 1U
            continue
        parent := (cast: (size_t) c.lmx_copy_map_get(map, (cast: (@: void) current\parent)))
        if: current\parent != 0 && parent = 0U
            status := 1
            break
        c.fprintf(f, "        l2_method: (cast: (@: Lmx) l2_gv%zu)\n", id)
        if: current\parent = 0
            c.fputs("        l2_method\\parent: 0\n", f)
        else:
            c.fprintf(f, "        l2_method\\parent: (cast: (@: Lmx) l2_gv%zu)\n", parent)
        id := id + 1U
    c.free((cast: (@: void) ordered))
return: status

# The name a root application of fn or sub gives (lmx_graph_fn_apply), as far as the translation reads it: the written
# name the binder takes (lmx_graph_fn_decl_name), or the name part of the prepared Structure the translation's namespace
# answers by the written word (lmx_graph_fn_part); 0 when only the program knows it (a Structure an expression computes).
fn: lm_graph_emit_fn_name (@: g c.LmxGraph; @: root c.Lmx; @: decl c.Lmx) @: char
    @: value void 0
    @: name char c.lmx_graph_fn_decl_name(g, decl)
    if: name != 0
        return: name
    if: c.lmx_graph_count(decl) != 1U || c.lmx_graph_kind(g, c.lmx_graph_get(decl, 0U)) != 2
        return: 0
    value := c.lmx_graph_target(g, c.lmx_graph_resolve(g, root, c.lmx_graph_word_text(g, c.lmx_graph_get(decl, 0U))))
    if: c.lmx_graph_kind(g, value) != 4
        return: 0
    value := c.lmx_graph_fn_part(g, (cast: (@: c.Lmx) value), c.lmx_graph_intern("name", 4U))
    if: c.lmx_graph_kind(g, value) != 2
        return: 0
    return: c.lmx_graph_word_text(g, value)
end: lm_graph_emit_fn_name

# Is name in the emitter's declaration table: a place a declaration of this code gives when it runs? 1 or 0.
fn: lm_graph_emit_known (@@: decl_names char; size_t: decl_n; @: name char) int
    size_t: i 0U
    while: i < decl_n
        if: decl_names[i] = name
            return: 1
        i := i + 1U
    ---
    return: 0
end: lm_graph_emit_known

# The translation's message for a structural form on a known place that is no Structure (the book,
# forms-declare-or-call): the emitted code refuses the form where the program reaches it, as the interpreter does (8).
sub: lm_graph_emit_refused (@: head char)
    c.fprintf(c.stderr, "graph: emit: the form `%s: ...` on the known place %s declares nothing and assigns nothing; write its value with `:=`\n", head, head)
    return
end: lm_graph_emit_refused

# The emitter's table of the declarations its native body has emitted so far (§3.5: the translator's own resolution,
# a table of its traversal): a declaration with a computed initializer names its slot from its statement on.
fn: lm_graph_emit_resolve (@: g c.LmxGraph; @: root c.Lmx; @@: decl_names char; @: decl_slots size_t; size_t: decl_n; @: name char) size_t
    size_t: i 0U
    while: i < decl_n
        if: decl_names[i] = name
            return: decl_slots[i]
        i := i + 1U
    ---
    # A place of the root is written by its name above and below its line: the only record of the name in the root's
    # registry, when it is a place (lmx_graph_visible_slot; plan M11 5a).
    return: c.lmx_graph_visible_slot(g, root, name)
end: lm_graph_emit_resolve

# Emit the address of a written substructure relative to this native activation's code. These field coordinates
# belong to emitted code only; the source graph has no saved lookup plan. Code mutation invalidates this entry.
fn: lm_graph_emit_address (@: g c.LmxGraph; @: f c.FILE; @: scope c.Lmx; @: target c.Lmx) int
    @: parent c.Lmx 0
    size_t: i 0U
    if: target = scope
        c.fputs("lmx_call_code", f)
        return: 0
    if: target = 0
        return: 3
    # The body of the Structure the receiver created: the native code reaches it through that Structure's own part (the
    # Structure of the running traversal, lmx_call_code), never through a coordinate of the translation's Structure.
    if: c.lmx_graph_method(g, scope) != 0 && target = c.lmx_graph_method_code(g, scope)
        c.fputs("lmx_graph_method_code(l2_g, lmx_call_code)", f)
        return: 0
    parent := (cast: (@: c.Lmx) target\parent)
    if: parent = 0
        return: 3
    while: i < c.lmx_graph_count(parent) && c.lmx_graph_get(parent, i) != (cast: (@: void) target)
        i := i + 1U
    ---
    if: i >= c.lmx_graph_count(parent)
        return: 3
    c.fputs("(cast: (@: Lmx) lmx_graph_get(", f)
    if: lm_graph_emit_address(g, f, scope, parent) != 0
        return: 3
    c.fprintf(f, ", %zuU))", i)
    return: 0
end: lm_graph_emit_address

# The head of a Frame read when the code runs: the name of its Lmx (§3.3), the canonical spelling.
fn: lm_graph_emit_head (@: g c.LmxGraph; @: f c.FILE; @: scope c.Lmx; @: expression c.Lmx) int
    c.fputs("lmx_graph_name_of(l2_g, (cast: (@: void) ", f)
    if: lm_graph_emit_address(g, f, scope, expression) != 0
        return: 3
    c.fputs("))", f)
    return: 0
end: lm_graph_emit_head

fn: lm_graph_emit_word (@: g c.LmxGraph; @: f c.FILE; @: scope c.Lmx; @: expression c.Lmx; size_t: index) int
    c.fputs("lmx_graph_word_text(l2_g, lmx_graph_get(", f)
    if: lm_graph_emit_address(g, f, scope, expression) != 0
        return: 3
    c.fprintf(f, ", %zuU))", index)
    return: 0
end: lm_graph_emit_word

# Calls compile argument evaluation and immediate admission in source order. The common invocation owns only the
# activation and default places; it dispatches the native method body, not an interpreter wrapper.
# The native emitter carries only its current temporary counter and error/return destinations. These are
# compiler traversal data; no cleanup stack, code or dispatch IDs are stored in the program graph.
sub: lm_graph_emit_leave_text (@: buffer char; int: label; int: status)
    if: label < 0
        c.snprintf(buffer, 64U, "return: %d", status)
    else:
        c.snprintf(buffer, 64U, "goto: l2_label%d", label)
    ---
    return
end: lm_graph_emit_leave_text

fn: lm_graph_emit_call (@: g c.LmxGraph; @: f c.FILE; @: scope c.Lmx; @: expression c.Lmx; @: temps int; @@: decl_names char; @: decl_slots size_t; size_t: decl_n; @: temp int) int
    c.LmxGraphEmitScratch: leave_storage
    @: leave_failure char (cast: (@: char) leave_storage\failure)
    lm_graph_emit_leave_text(leave_failure, temps[1], 1)
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    size_t: count (cast: (size_t) c.lmx_graph_count(expression))
    size_t: i 0U
    @: actual void 0
    @: holder c.Lmx expression
    size_t: at 0U
    int: call_id temps[0]
    int: value 0
    int: status 0
    temps[0] := temps[0] + 1
    # The callee as the interpreter takes it: the resolved head, or the target of a reference to a callable.
    c.fprintf(f, "        @: Lmx l2_call%d (cast: (@: Lmx) lmx_graph_target(l2_g, lmx_graph_resolve(l2_g, lmx_call_code, ", call_id)
    status := lm_graph_emit_head(g, f, scope, expression)
    c.fprintf(f, ")))\n        []: size_t l2_binding%d %zuU\n        if: lmx_graph_bind_call(l2_g, lmx_call_code, l2_call%d, (cast: (@: Lmx) ", call_id, count + 1U, call_id)
    if: status = 0
        status := lm_graph_emit_address(g, f, scope, expression)
    # One positional actual naming a value without effects: the same kernel call as the interpreter's decides at run
    # time whether its Structure is the whole argument structure (lmx_graph_call_single).
    if: status = 0 && c.lmx_graph_single_candidate(g, scope, expression) != 0
        c.fprintf(f, "), l2_binding%d) != 0\n            %s\n", call_id, leave_failure)
        actual := c.lmx_graph_get(expression, 0U)
        if: c.lmx_graph_kind(g, actual) = 4 && c.lmx_graph_name_of(g, actual) = 0
            # A grouped head may resolve differently in the live caller.
            # Read its value by the same reader as the walker after preflight;
            # the selected callee then receives that value or its direct fields.
            value := temps[0]
            temps[0] := temps[0] + 1
            c.fprintf(f, "        @: void l2_v%d 0\n        if: lmx_graph_eval_value(l2_g, lmx_call_code, lmx_graph_get(", value)
            status := lm_graph_emit_address(g, f, scope, expression)
            c.fprintf(f, ", 0U), @ l2_v%d) != 0\n            %s\n", value, leave_failure)
        else:
            status := lm_graph_emit_operand(g, f, scope, expression, 0U, temps, decl_names, decl_slots, decl_n, @ value)
        c.fprintf(f, "        int: l2_t%d 0\n        if: lmx_graph_call_single(l2_g, l2_call%d, l2_v%d, @ l2_t%d) != 0\n            %s\n", call_id, call_id, value, call_id, leave_failure)
        temp[0] := call_id
        return: status
    c.fprintf(f, "), l2_binding%d) != 0\n            %s\n        []: @(void) l2_args%d %zuU\n", call_id, leave_failure, call_id, count + 1U)
    while: i < count && status = 0
        holder := expression
        at := i
        actual := c.lmx_graph_get(expression, at)
        if: c.lmx_graph_kind(g, actual) = 4 && c.lmx_graph_name_of(g, actual) = 0 && c.lmx_graph_word_text(g, c.lmx_graph_get((cast: (@: c.Lmx) actual), 0U)) = state\w_assign
            if: c.lmx_graph_count((cast: (@: c.Lmx) actual)) != 3U
                return: 5
            holder := (cast: (@: c.Lmx) actual)
            at := 2U
        actual := c.lmx_graph_get(holder, at)
        if: c.lmx_graph_kind(g, actual) = 4 && c.lmx_graph_name_of(g, actual) = 0 && c.lmx_graph_group_expression(g, scope, actual) = 0
            value := temps[0]
            temps[0] := temps[0] + 1
            c.fprintf(f, "        @: void l2_v%d 0\n        if: lmx_graph_read_actual(l2_g, lmx_call_code, l2_call%d, l2_binding%d[%zuU], lmx_graph_get(", value, call_id, call_id, i)
            status := lm_graph_emit_address(g, f, scope, holder)
            c.fprintf(f, ", %zuU), @ l2_v%d) != 0\n            %s\n", at, value, leave_failure)
        else:
            status := lm_graph_emit_operand(g, f, scope, holder, at, temps, decl_names, decl_slots, decl_n, @ value)
            c.fprintf(f, "        if: lmx_graph_admit(l2_g, l2_call%d, l2_binding%d[%zuU], l2_v%d, @ l2_v%d) != 0\n            %s\n", call_id, call_id, i, value, value, leave_failure)
        c.fprintf(f, "        l2_args%d[%zuU]: l2_v%d\n", call_id, i, value)
        i := i + 1U
    ---
    c.fprintf(f, "        int: l2_t%d 0\n        if: lmx_graph_invoke_bound(l2_g, l2_call%d, l2_args%d, %zuU, l2_binding%d, @ l2_t%d) != 0\n            %s\n", call_id, call_id, call_id, count, call_id, call_id, leave_failure)
    temp[0] := call_id
    return: status
end: lm_graph_emit_call

# Compile an operand's address. Field paths preserve Structure values for receiving; only arithmetic/call results
# need a new result cell. Formal places are addressed directly in the current activation.
fn: lm_graph_emit_operand (@: g c.LmxGraph; @: f c.FILE; @: scope c.Lmx; @: holder c.Lmx; size_t: index; @: temps int; @@: decl_names char; @: decl_slots size_t; size_t: decl_n; @: temp int) int
    c.LmxGraphEmitScratch: leave_storage
    @: leave_failure char (cast: (@: char) leave_storage\failure)
    lm_graph_emit_leave_text(leave_failure, temps[1], 1)
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: raw void c.lmx_graph_get(holder, index)
    @: expression c.Lmx 0
    @: args c.Lmx 0
    @: word char c.lmx_graph_word_text(g, raw)
    size_t: count 0U
    size_t: slot 0U
    int: kind (cast: (int) c.lmx_graph_kind(g, raw))
    int: value 0
    int: number 0
    int: status 0
    # A Frame: merge builds its Structure; another is the application of its head, an int result in a new cell.
    if: kind = 4 && c.lmx_graph_name_of(g, raw) != 0
        if: c.lmx_graph_name_of(g, raw) = state\w_merge
            return: lm_graph_emit_merge(g, f, scope, (cast: (@: c.Lmx) raw), temps, decl_names, decl_slots, decl_n, temp)
        status := lm_graph_emit_number(g, f, scope, holder, index, temps, decl_names, decl_slots, decl_n, @ number)
        if: status != 0
            return: status
        value := temps[0]
        temps[0] := temps[0] + 1
        c.fprintf(f, "        @: void l2_v%d lmx_graph_int(l2_g, l2_t%d)\n        if: l2_v%d = 0\n            %s\n", value, number, value, leave_failure)
        temp[0] := value
        return: 0
    if: kind = 4 && c.lmx_graph_group_expression(g, scope, raw) != 0
        expression := (cast: (@: c.Lmx) raw)
        count := c.lmx_graph_count(expression)
        # The index of a Structure, `base[index]` (the book, structure-index), as the interpreter reads it: the base's
        # value and the index's number, then the kernel's read of the slot.
        if: count = 3U && c.lmx_graph_word_text(g, c.lmx_graph_get(expression, 1U)) = state\w_index
            status := lm_graph_emit_operand(g, f, scope, expression, 0U, temps, decl_names, decl_slots, decl_n, @ value)
            if: status != 0
                return: status
            status := lm_graph_emit_number(g, f, scope, expression, 2U, temps, decl_names, decl_slots, decl_n, @ number)
            if: status != 0
                return: status
            c.fprintf(f, "        if: lmx_graph_index(l2_g, l2_v%d, l2_t%d, @ l2_v%d) != 0\n            %s\n", value, number, value, leave_failure)
            temp[0] := value
            return: 0
        if: count = 3U && c.lmx_graph_word_text(g, c.lmx_graph_get(expression, 1U)) = state\w_deref
            status := lm_graph_emit_operand(g, f, scope, expression, 0U, temps, decl_names, decl_slots, decl_n, @ value)
            if: status != 0
                return: status
            # The path step, through an atom too, as the interpreter takes it (lmx_graph_step; plan M11 5a).
            c.fputs("        if: lmx_graph_step(l2_g, l2_v", f)
            c.fprintf(f, "%d, ", value)
            if: lm_graph_emit_word(g, f, scope, expression, 2U) != 0
                return: 3
            c.fprintf(f, ", @ l2_v%d) != 0\n            %s\n", value, leave_failure)
            temp[0] := value
            return: 0
        word := c.lmx_graph_word_text(g, c.lmx_graph_get(expression, 0U))
        if: count = 2U && word = state\w_at
            if: c.lmx_graph_kind(g, c.lmx_graph_get(expression, 1U)) = 2
                value := temps[0]
                temps[0] := temps[0] + 1
                c.fprintf(f, "        @: void l2_v%d lmx_graph_resolve(l2_g, lmx_call_code, ", value)
                status := lm_graph_emit_word(g, f, scope, expression, 1U)
                c.fputs(")\n", f)
            else:
                status := lm_graph_emit_operand(g, f, scope, expression, 1U, temps, decl_names, decl_slots, decl_n, @ value)
            ---
            if: status != 0
                return: status
            c.fprintf(f, "        if: lmx_graph_kind(l2_g, l2_v%d) = 3\n            l2_v%d: lmx_arena_pointer_void_read(l2_v%d)\n        l2_v%d: lmx_graph_ref_int(l2_g, l2_v%d)\n        if: l2_v%d = 0\n            %s\n", value, value, value, value, value, value, leave_failure)
            temp[0] := value
            return: 0
        if: count = 1U && c.lmx_graph_method(g, (cast: (@: c.Lmx) c.lmx_graph_target(g, c.lmx_graph_resolve(g, scope, word)))) = 0
            return: lm_graph_emit_operand(g, f, scope, expression, 0U, temps, decl_names, decl_slots, decl_n, temp)
        status := lm_graph_emit_number(g, f, scope, holder, index, temps, decl_names, decl_slots, decl_n, @ number)
        if: status != 0
            return: status
        value := temps[0]
        temps[0] := temps[0] + 1
        c.fprintf(f, "        @: void l2_v%d lmx_graph_int(l2_g, l2_t%d)\n        if: l2_v%d = 0\n            %s\n", value, number, value, leave_failure)
        temp[0] := value
        return: 0
    value := temps[0]
    temps[0] := temps[0] + 1
    if: kind = 2
        if: c.lmx_graph_method(g, scope) != 0
            args := c.lmx_graph_method_args(g, scope)
        slot := c.lmx_graph_formal(g, args, word)
        if: args != 0 && slot < c.lmx_graph_count(args)
            c.fprintf(f, "        @: void l2_v%d refs[%zuU]\n", value, slot)
        else:
            c.fprintf(f, "        @: void l2_v%d lmx_graph_operand_name(l2_g, lmx_call_code, ", value)
            if: lm_graph_emit_word(g, f, scope, holder, index) != 0
                return: 3
            c.fputs(")\n", f)
        ---
    else:
        c.fprintf(f, "        @: void l2_v%d lmx_graph_get(", value)
        if: lm_graph_emit_address(g, f, scope, holder) != 0
            return: 3
        c.fprintf(f, ", %zuU)\n", index)
    ---
    c.fprintf(f, "        if: l2_v%d = 0\n            %s\n", value, leave_failure)
    temp[0] := value
    return: 0
end: lm_graph_emit_operand

# Compile one nested numeric expression. All grouping/precedence is already represented by its child Lmx fields.
fn: lm_graph_emit_number (@: g c.LmxGraph; @: f c.FILE; @: scope c.Lmx; @: holder c.Lmx; size_t: index; @: temps int; @@: decl_names char; @: decl_slots size_t; size_t: decl_n; @: temp int) int
    c.LmxGraphEmitScratch: leave_storage
    @: leave_failure char (cast: (@: char) leave_storage\failure)
    lm_graph_emit_leave_text(leave_failure, temps[1], 1)
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: raw void c.lmx_graph_get(holder, index)
    @: expression c.Lmx 0
    @: word char 0
    @: method void 0
    size_t: count 0U
    size_t: slot 0U
    int: kind (cast: (int) c.lmx_graph_kind(g, raw))
    int: left 0
    int: right 0
    int: value 0
    int: status 0
    int: finish 0
    if: kind = 1
        left := temps[0]
        temps[0] := temps[0] + 1
        c.fprintf(f, "        int: l2_t%d %d\n", left, c.lmx_int_value_known(raw))
        temp[0] := left
        return: 0
    if: kind = 2
        left := temps[0]
        temps[0] := temps[0] + 1
        c.fprintf(f, "        int: l2_t%d 0\n        if: lmx_graph_named_int(l2_g, lmx_call_code, ", left)
        status := lm_graph_emit_word(g, f, scope, holder, index)
        c.fprintf(f, ", @ l2_t%d) != 0\n            %s\n", left, leave_failure)
        temp[0] := left
        return: status
    if: kind = 4 && c.lmx_graph_name_of(g, raw) != 0
        # A Frame: the application of the callable its head names when this translation resolves it; a head it cannot
        # resolve names a place the code declares when it runs (a reference to a callable or to a merge result) or none:
        # its call is then resolved, bound and dispatched by the kernel when the code runs, as by the interpreter -- the
        # callee's native entry, or the interpreter for a Structure without one; a missing name fails there. No merge is
        # computed ahead of execution.
        expression := (cast: (@: c.Lmx) raw)
        word := c.lmx_graph_name_of(g, raw)
        # The receiver typeof (the book, get-type), as the interpreter reads it: the code asks the kernel for the type of
        # the region that holds the address its one argument stands for; a written zero is the null address.
        if: word = state\w_typeof
            if: c.lmx_graph_count(expression) != 1U
                return: 5
            left := temps[0]
            temps[0] := temps[0] + 1
            method := c.lmx_graph_get(expression, 0U)
            if: c.lmx_graph_kind(g, method) = 1 && c.lmx_graph_name_of(g, method) = 0 && c.lmx_int_value_known(method) = 0
                c.fprintf(f, "        int: l2_t%d %d\n", left, c.LMX_TYPE_NONE)
                temp[0] := left
                return: 0
            status := lm_graph_emit_operand(g, f, scope, expression, 0U, temps, decl_names, decl_slots, decl_n, @ value)
            if: status != 0
                return: status
            c.fprintf(f, "        int: l2_t%d 0\n        if: lmx_graph_address_type(l2_g, l2_v%d, @ l2_t%d) != 0\n            %s\n", left, value, left, leave_failure)
            temp[0] := left
            return: 0
        # The receiver length (the book, structure-index): the code asks the kernel for the number of the fields of the
        # Structure its one argument stands for.
        if: word = state\w_length
            if: c.lmx_graph_count(expression) != 1U
                return: 5
            status := lm_graph_emit_operand(g, f, scope, expression, 0U, temps, decl_names, decl_slots, decl_n, @ value)
            if: status != 0
                return: status
            left := temps[0]
            temps[0] := temps[0] + 1
            c.fprintf(f, "        int: l2_t%d 0\n        if: lmx_graph_length(l2_g, l2_v%d, @ l2_t%d) != 0\n            %s\n", left, value, left, leave_failure)
            temp[0] := left
            return: 0
        # The receiver fncall (the book, call-receivers): the launch of the code it is given, with its result.
        if: word = state\w_fncall
            return: lm_graph_emit_fncall(g, f, scope, expression, temps, decl_names, decl_slots, decl_n, temp)
        method := c.lmx_graph_target(g, c.lmx_graph_resolve(g, scope, word))
        if: c.lmx_graph_method(g, (cast: (@: c.Lmx) method)) != 0
            if: c.lmx_graph_has_result(g, (cast: (@: c.Lmx) method)) = 0
                return: 5
            return: lm_graph_emit_call(g, f, scope, expression, temps, decl_names, decl_slots, decl_n, temp)
        if: method = 0 && c.lmx_graph_language_word(state, word) = 0
            return: lm_graph_emit_call(g, f, scope, expression, temps, decl_names, decl_slots, decl_n, temp)
        # The record that launches an ordinary Structure, directly or through a reference place, gives no result (R22):
        # the code refuses it where it reaches it, as the interpreter does (5).
        if: c.lmx_graph_kind(g, method) = 4 && c.lmx_graph_language_word(state, word) = 0
            left := temps[0]
            temps[0] := temps[0] + 1
            c.fprintf(f, "        int: l2_t%d 0\n        if: 1\n            %s\n", left, leave_failure)
            temp[0] := left
            return: 0
        ---
        return: 2
    if: kind = 4
        expression := (cast: (@: c.Lmx) raw)
        count := c.lmx_graph_count(expression)
        word := c.lmx_graph_word_text(g, c.lmx_graph_get(expression, 1U))
        if: count = 3U && (word = state\w_plus || word = state\w_minus || word = state\w_star || word = state\w_slash || word = state\w_percent || word = state\w_eq || word = state\w_ne || word = state\w_lt || word = state\w_le || word = state\w_gt || word = state\w_ge || word = state\w_and || word = state\w_or)
            status := lm_graph_emit_number(g, f, scope, expression, 0U, temps, decl_names, decl_slots, decl_n, @ left)
            if: status != 0
                return: status
            if: word = state\w_and || word = state\w_or
                finish := temps[0]
                temps[0] := temps[0] + 1
                c.fprintf(f, "        l2_t%d: (l2_t%d != 0)\n", left, left)
                if: word = state\w_and
                    c.fprintf(f, "        if: l2_t%d = 0\n            goto: l2_label%d\n", left, finish)
                else:
                    c.fprintf(f, "        if: l2_t%d != 0\n            goto: l2_label%d\n", left, finish)
                ---
            ---
            status := lm_graph_emit_number(g, f, scope, expression, 2U, temps, decl_names, decl_slots, decl_n, @ right)
            if: status != 0
                return: status
            if: word = state\w_slash || word = state\w_percent
                c.fprintf(f, "        if: l2_t%d = 0\n            %s\n", right, leave_failure)
            c.fprintf(f, "        l2_t%d: l2_t%d %s l2_t%d\n", left, left, word, right)
            if: word = state\w_and || word = state\w_or
                c.fprintf(f, "        l2_label%d:\n", finish)
            temp[0] := left
            return: 0
        word := c.lmx_graph_word_text(g, c.lmx_graph_get(expression, 0U))
        if: count = 2U && (word = state\w_plus || word = state\w_minus || word = state\w_not)
            status := lm_graph_emit_number(g, f, scope, expression, 1U, temps, decl_names, decl_slots, decl_n, @ left)
            if: status != 0
                return: status
            if: word = state\w_minus
                c.fprintf(f, "        l2_t%d: 0 - l2_t%d\n", left, left)
            if: word = state\w_not
                c.fprintf(f, "        l2_t%d: (l2_t%d = 0)\n", left, left)
            temp[0] := left
            return: 0
        if: count = 2U && word = state\w_deref
            status := lm_graph_emit_operand(g, f, scope, expression, 1U, temps, decl_names, decl_slots, decl_n, @ value)
            if: status != 0
                return: status
            left := temps[0]
            temps[0] := temps[0] + 1
            c.fprintf(f, "        int: l2_t%d 0\n        if: lmx_graph_kind(l2_g, l2_v%d) != 5\n            %s\n        if: lmx_graph_value_int(l2_g, lmx_arena_pointer_void_read(l2_v%d), @ l2_t%d) != 0\n            %s\n", left, value, leave_failure, value, left, leave_failure)
            temp[0] := left
            return: 0
        if: count = 1U
            return: lm_graph_emit_number(g, f, scope, expression, 0U, temps, decl_names, decl_slots, decl_n, temp)
        # A field path gives the int of its place; the index of a Structure gives an address, which has no int: the code
        # refuses it when it runs, as the interpreter does.
        if: count != 3U || (c.lmx_graph_word_text(g, c.lmx_graph_get(expression, 1U)) != state\w_deref && c.lmx_graph_word_text(g, c.lmx_graph_get(expression, 1U)) != state\w_index)
            return: 2
        ---
    ---
    status := lm_graph_emit_operand(g, f, scope, holder, index, temps, decl_names, decl_slots, decl_n, @ value)
    if: status != 0
        return: status
    left := temps[0]
    temps[0] := temps[0] + 1
    c.fprintf(f, "        int: l2_t%d 0\n        if: lmx_graph_value_int(l2_g, l2_v%d, @ l2_t%d) != 0\n            %s\n", left, value, left, leave_failure)
    temp[0] := left
    return: 0
end: lm_graph_emit_number

fn: lm_graph_emit_expr (@: g c.LmxGraph; @: f c.FILE; @: root c.Lmx; @: expr c.Lmx; size_t: from; size_t: to; @: temps int; @@: decl_names char; @: decl_slots size_t; size_t: decl_n; @: temp int) int
    if: to != from + 1U
        return: 2
    return: lm_graph_emit_number(g, f, root, expr, from, temps, decl_names, decl_slots, decl_n, temp)
end: lm_graph_emit_expr

# The written value of actual index of a launch record, as the interpreter takes it (lmx_graph_launch_actual): the
# operand of `name := value` -- its holder and index in out --, or the actual itself.
sub: lm_graph_launch_actual (@: g c.LmxGraph; @: expression c.Lmx; size_t: index; @@: holder c.Lmx; @: at size_t)
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: raw void c.lmx_graph_get(expression, index)
    holder[0] := expression
    at[0] := index
    if: state != 0 && c.lmx_graph_kind(g, raw) = 4 && c.lmx_graph_name_of(g, raw) = 0 && c.lmx_graph_count((cast: (@: c.Lmx) raw)) = 3U && c.lmx_graph_word_text(g, c.lmx_graph_get((cast: (@: c.Lmx) raw), 0U)) = state\w_assign
        holder[0] := (cast: (@: c.Lmx) raw)
        at[0] := 2U
    ---
    return
end: lm_graph_launch_actual

# An operand of a launch that stands for a Structure -- the arguments, the data, the code --, actual index of a launch
# record, as the interpreter takes it (lmx_graph_launch_operand): an anonymous Structure written in parentheses is that
# Structure as written (lmx_graph_merge_literal), the code reads it from its place in the graph; any other operand is
# evaluated (lm_graph_emit_operand). The value in the void temporary in temp.
fn: lm_graph_emit_launch_operand (@: g c.LmxGraph; @: f c.FILE; @: scope c.Lmx; @: expression c.Lmx; size_t: index; @: temps int; @@: decl_names char; @: decl_slots size_t; size_t: decl_n; @: temp int) int
    @: holder c.Lmx 0
    size_t: at 0U
    int: value 0
    lm_graph_launch_actual(g, expression, index, @ holder, @ at)
    if: c.lmx_graph_merge_literal(g, scope, c.lmx_graph_get(holder, at)) != 0
        value := temps[0]
        temps[0] := temps[0] + 1
        c.fprintf(f, "        @: void l2_v%d lmx_graph_get(", value)
        if: lm_graph_emit_address(g, f, scope, holder) != 0
            return: 3
        c.fprintf(f, ", %zuU)\n", at)
        temp[0] := value
        return: 0
    ---
    return: lm_graph_emit_operand(g, f, scope, holder, at, temps, decl_names, decl_slots, decl_n, temp)
end: lm_graph_emit_launch_operand

# call in native code (the book, call-receivers): the forms [code], [data code], [args data code], given by position or
# by name through `:=` -- the translation binds the record by the interpreter's one binder (lmx_graph_launch_formals;
# R22). The operands are evaluated in the order they are written (lm_graph_emit_launch_operand); the launch is the
# kernel's own (lmx_graph_call_data, lmx_graph_launch), shared with the interpreter. No form: the code refuses the record
# where it reaches it, as the interpreter does (5).
fn: lm_graph_emit_explicit_call (@: g c.LmxGraph; @: f c.FILE; @: scope c.Lmx; @: expression c.Lmx; @: temps int; @@: decl_names char; @: decl_slots size_t; size_t: decl_n) int
    c.LmxGraphEmitScratch: leave_storage
    @: leave_failure char (cast: (@: char) leave_storage\failure)
    lm_graph_emit_leave_text(leave_failure, temps[1], 1)
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @@: formals char 0
    @: head char 0
    size_t: count c.lmx_graph_count(expression)
    size_t: i 0U
    int: code -1
    int: data -1
    int: args -1
    int: value 0
    int: status 0
    if: state = 0
        return: 5
    formals := (cast: (@@: char) c.calloc(count + 1U, sizeof(@: char)))
    if: formals = 0
        return: 4
    head := state\w_call
    status := c.lmx_graph_launch_formals(g, head, expression, formals)
    if: status = 5
        c.free((cast: (@: void) formals))
        c.fprintf(f, "        if: 1\n            %s\n", leave_failure)
        return: 0
    ---
    while: status = 0 && i < count
        status := lm_graph_emit_launch_operand(g, f, scope, expression, i, temps, decl_names, decl_slots, decl_n, @ value)
        if: formals[i] = state\w_args
            args := value
        if: formals[i] = state\w_data
            data := value
        if: formals[i] = state\w_code
            code := value
        i := i + 1U
    ---
    c.free((cast: (@: void) formals))
    if: status != 0
        return: status
    # [args data code]: the parts of a launch without a result (lmx_graph_launch).
    if: args >= 0
        c.fprintf(f, "        if: l2_v%d = 0 || l2_v%d = 0 || l2_v%d = 0 || lmx_graph_launch(l2_g, (cast: (@: Lmx) l2_v%d), (cast: (@: Lmx) l2_v%d), 0, (cast: (@: Lmx) l2_v%d), 0) != 0\n            %s\n", args, data, code, args, data, code, leave_failure)
        return: 0
    # [data code]: the code over the data (the author 2026-11-11, LMX_blog/2026-11-11.md#data-before-code).
    if: data >= 0
        c.fprintf(f, "        if: lmx_graph_call_data(l2_g, (cast: (@: Lmx) l2_v%d), (cast: (@: Lmx) l2_v%d), 0) != 0\n            %s\n", data, code, leave_failure)
        return: 0
    # [code]: the code alone; it selects its data (lmx_graph_call_data, shorthand).
    c.fprintf(f, "        if: lmx_graph_call_data(l2_g, 0, (cast: (@: Lmx) l2_v%d), 1) != 0\n            %s\n", code, leave_failure)
    return: 0
end: lm_graph_emit_explicit_call

# fncall in native code (the book, call-receivers): `fncall(args data return code)`, `fncall(data return code)`,
# `fncall(return code)`, given by position or by name through `:=` -- the translation binds the record by the
# interpreter's one binder (lmx_graph_launch_formals; R22). The operands are evaluated in the order they are written:
# the arguments, the data and the code as operands of a launch (lm_graph_emit_launch_operand); the description of the
# result is the word of the language written there, or the word a value holds when the code runs (the return part of a
# callable); the launch is the kernel's own (lmx_graph_launch), shared with the interpreter. The result is the int
# temporary in temp.
fn: lm_graph_emit_fncall (@: g c.LmxGraph; @: f c.FILE; @: scope c.Lmx; @: expression c.Lmx; @: temps int; @@: decl_names char; @: decl_slots size_t; size_t: decl_n; @: temp int) int
    c.LmxGraphEmitScratch: leave_storage
    @: leave_failure char (cast: (@: char) leave_storage\failure)
    lm_graph_emit_leave_text(leave_failure, temps[1], 1)
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @@: formals char 0
    @: holder c.Lmx 0
    @: word char 0
    size_t: count c.lmx_graph_count(expression)
    size_t: i 0U
    size_t: at 0U
    int: args -1
    int: data -1
    int: described -1
    int: code 0
    int: value 0
    int: left 0
    int: status 0
    if: state = 0
        return: 5
    formals := (cast: (@@: char) c.calloc(count + 1U, sizeof(@: char)))
    if: formals = 0
        return: 4
    word := state\w_fncall
    status := c.lmx_graph_launch_formals(g, word, expression, formals)
    word := 0
    # No form of fncall: the code refuses it where it reaches it, as the interpreter does (5).
    if: status = 5
        c.free((cast: (@: void) formals))
        left := temps[0]
        temps[0] := temps[0] + 1
        c.fprintf(f, "        int: l2_t%d 0\n        if: 1\n            %s\n", left, leave_failure)
        temp[0] := left
        return: 0
    ---
    while: status = 0 && i < count
        if: formals[i] = state\w_return
            lm_graph_launch_actual(g, expression, i, @ holder, @ at)
            word := c.lmx_graph_word_text(g, c.lmx_graph_description_value(g, c.lmx_graph_get(holder, at)))
            if: word = 0 || c.lmx_graph_language_word(state, word) = 0
                word := 0
                status := lm_graph_emit_operand(g, f, scope, holder, at, temps, decl_names, decl_slots, decl_n, @ described)
            ---
        else:
            status := lm_graph_emit_launch_operand(g, f, scope, expression, i, temps, decl_names, decl_slots, decl_n, @ value)
            if: formals[i] = state\w_args
                args := value
            if: formals[i] = state\w_data
                data := value
            if: formals[i] = state\w_code
                code := value
        ---
        i := i + 1U
    ---
    c.free((cast: (@: void) formals))
    if: status != 0
        return: status
    left := temps[0]
    temps[0] := temps[0] + 1
    c.fprintf(f, "        int: l2_t%d 0\n        if: l2_v%d = 0", left, code)
    if: args >= 0
        c.fprintf(f, " || l2_v%d = 0", args)
    if: data >= 0
        c.fprintf(f, " || l2_v%d = 0", data)
    if: word = 0
        c.fprintf(f, " || lmx_graph_word_text(l2_g, l2_v%d) = 0", described)
    c.fputs(" || lmx_graph_launch(l2_g, ", f)
    if: args >= 0
        c.fprintf(f, "(cast: (@: Lmx) l2_v%d), ", args)
    else:
        c.fputs("0, ", f)
    ---
    if: data >= 0
        c.fprintf(f, "(cast: (@: Lmx) l2_v%d), ", data)
    else:
        c.fputs("0, ", f)
    ---
    if: word != 0
        lm_graph_emit_quoted_word(f, word)
    else:
        c.fprintf(f, "lmx_graph_word_text(l2_g, l2_v%d)", described)
    ---
    c.fprintf(f, ", (cast: (@: Lmx) l2_v%d), @ l2_t%d) != 0\n            %s\n", code, left, leave_failure)
    temp[0] := left
    return: 0
end: lm_graph_emit_fncall

# One proxy records the pending transfer and reaches either the cleanup body or its final dispatch. The word is
# the same canonical arena string used by the interpreter. A failing cleanup retains the pending error.
sub: lm_graph_emit_pending (@: f c.FILE; int: id; int: label; int: destination; @: word char; int: failed)
    c.fprintf(f, "        l2_label%d:\n", label)
    if: failed != 0
        c.fprintf(f, "        l2_pending_error%d: 1\n", id)
    if: word != 0
        c.fprintf(f, "        l2_pending_word%d: l2_pending_words%d\\w_%s\n", id, id, word)
    c.fprintf(f, "        goto: l2_label%d\n", destination)
    return
end: lm_graph_emit_pending

# Registration protects the remaining statements of this scope. All their exits pass through this cleanup;
# the cleanup itself targets a separate dispatch, so it cannot run itself again. Outer registrations still apply.
fn: lm_graph_emit_finally (@: g c.LmxGraph; @: f c.FILE; @: code c.Lmx; @: body c.Lmx; size_t: at; size_t: to; @: cleanup c.Lmx; int: mode; int: exit_label; int: again_label; int: step_label; @: temps int) int
    int: id temps[0]
    int: saved_failure temps[1]
    int: saved_return temps[2]
    int: protected_exit -1
    int: protected_again -1
    int: protected_step -1
    int: cleanup_mode mode
    int: status 0
    c.LmxGraphEmitScratch: leave_storage
    @: leave_failure char (cast: (@: char) leave_storage\failure)
    @: leave_return char (cast: (@: char) leave_storage\returned)
    lm_graph_emit_leave_text(leave_failure, saved_failure, 1)
    lm_graph_emit_leave_text(leave_return, saved_return, 0)
    temps[0] := id + 12
    if: exit_label >= 0
        protected_exit := id + 3
    if: again_label >= 0
        protected_again := id + 4
    if: step_label >= 0
        protected_step := id + 5
    c.fprintf(f, "        int: l2_pending_error%d 0\n        @: char l2_pending_word%d 0\n        @: LmxGraphState l2_pending_words%d lmx_graph_state()\n", id, id, id)
    temps[1] := id + 1
    temps[2] := id + 2
    if: mode = 1
        status := lm_graph_emit_statements_from(g, f, code, at + 1U, temps)
    else:
        status := lm_graph_emit_block(g, f, code, body, at + 1U, to, mode, protected_exit, protected_again, protected_step, temps)
    ---
    temps[1] := saved_failure
    temps[2] := saved_return
    if: status != 0
        return: status
    c.fprintf(f, "        goto: l2_label%d\n", id)
    lm_graph_emit_pending(f, id, id + 1, id, 0, 1)
    lm_graph_emit_pending(f, id, id + 2, id, "return", 0)
    if: exit_label >= 0
        lm_graph_emit_pending(f, id, id + 3, id, "break", 0)
        protected_exit := id + 8
    if: again_label >= 0
        lm_graph_emit_pending(f, id, id + 4, id, "redo", 0)
        protected_again := id + 9
    if: step_label >= 0
        lm_graph_emit_pending(f, id, id + 5, id, "continue", 0)
        protected_step := id + 10
    c.fprintf(f, "        l2_label%d:\n        if: l2_pending_error%d != 0 || l2_pending_word%d = l2_pending_words%d\\w_return\n            if: lmx_graph_work_flush(l2_g) != 0\n                l2_pending_error%d: 1\n        ---\n", id, id, id, id, id)
    temps[1] := id + 6
    temps[2] := id + 7
    if: mode = 1
        cleanup_mode := 2
    status := lm_graph_emit_block(g, f, code, cleanup, 0U, c.lmx_graph_count(cleanup), cleanup_mode, protected_exit, protected_again, protected_step, temps)
    temps[1] := saved_failure
    temps[2] := saved_return
    if: status != 0
        return: status
    c.fprintf(f, "        goto: l2_label%d\n", id + 11)
    lm_graph_emit_pending(f, id, id + 6, id + 11, 0, 1)
    lm_graph_emit_pending(f, id, id + 7, id + 11, "return", 0)
    if: exit_label >= 0
        lm_graph_emit_pending(f, id, id + 8, id + 11, "break", 0)
    if: again_label >= 0
        lm_graph_emit_pending(f, id, id + 9, id + 11, "redo", 0)
    if: step_label >= 0
        lm_graph_emit_pending(f, id, id + 10, id + 11, "continue", 0)
    c.fprintf(f, "        l2_label%d:\n        if: l2_pending_error%d != 0\n            %s\n        if: l2_pending_word%d = l2_pending_words%d\\w_return\n            %s\n", id + 11, id, leave_failure, id, id, leave_return)
    if: exit_label >= 0
        c.fprintf(f, "        if: l2_pending_word%d = l2_pending_words%d\\w_break\n            goto: l2_label%d\n", id, id, exit_label)
    if: again_label >= 0
        c.fprintf(f, "        if: l2_pending_word%d = l2_pending_words%d\\w_redo\n            goto: l2_label%d\n", id, id, again_label)
    if: step_label >= 0
        c.fprintf(f, "        if: l2_pending_word%d = l2_pending_words%d\\w_continue\n            goto: l2_label%d\n", id, id, step_label)
    return: 0
end: lm_graph_emit_finally

# The field a written path `owner\field` names, emitted for a write through it as the interpreter finds it
# (lmx_graph_path_field): the owner's value, then the Structure holding the place the path's last step names -- through
# an atom too -- and its slot (lmx_graph_step_place), a place there. The temporary of that Structure in owner_out; the
# slot is l2_s<owner>. 0, 2 for no path, or the answer of the owner's emission.
fn: lm_graph_emit_field_place (@: g c.LmxGraph; @: f c.FILE; @: code c.Lmx; @: left void; @: temps int; @@: decl_names char; @: decl_slots size_t; size_t: decl_n; @: owner_out int) int
    c.LmxGraphEmitScratch: leave_storage
    @: leave_failure char (cast: (@: char) leave_storage\failure)
    lm_graph_emit_leave_text(leave_failure, temps[1], 1)
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: path c.Lmx (cast: (@: c.Lmx) left)
    int: owner 0
    int: status 0
    if: state = 0 || c.lmx_graph_kind(g, left) != 4 || c.lmx_graph_count(path) != 3U || c.lmx_graph_word_text(g, c.lmx_graph_get(path, 1U)) != state\w_deref
        return: 2
    status := lm_graph_emit_operand(g, f, code, path, 0U, temps, decl_names, decl_slots, decl_n, @ owner)
    if: status != 0
        return: status
    # The Structure holding the written place and its slot, as in the interpreter: the owner, or the target of a
    # reference to it; through an atom, the record the atom refers to.
    c.fprintf(f, "        size_t: l2_s%d 0U\n        if: lmx_graph_step_place(l2_g, l2_v%d, ", owner, owner)
    status := lm_graph_emit_word(g, f, code, path, 2U)
    c.fprintf(f, ", @ l2_v%d, @ l2_s%d) != 0\n            %s\n        if: lmx_graph_place_cell(l2_g, (cast: (@: Lmx) l2_v%d), l2_s%d) = 0\n            %s\n", owner, owner, leave_failure, owner, owner, leave_failure)
    owner_out[0] := owner
    return: status
end: lm_graph_emit_field_place

# A statement written on a path head, `owner\field: tail` (c.lmx_graph_path_head), emitted as the interpreter answers
# it (lmx_graph_eval_path_statement): no such form writes the field -- `owner\field := value` does -- and none of its
# other readings is executed by this slice (a callable applied through a path, a Structure declared again through it),
# so the code fails where the program reaches the statement, whatever its tail.
fn: lm_graph_emit_path_statement (@: g c.LmxGraph; @: f c.FILE; @: code c.Lmx; @: statement c.Lmx; @: temps int; @@: decl_names char; @: decl_slots size_t; size_t: decl_n) int
    c.LmxGraphEmitScratch: leave_storage
    @: leave_failure char (cast: (@: char) leave_storage\failure)
    lm_graph_emit_leave_text(leave_failure, temps[1], 1)
    c.fputs("graph: emit: a form on a path declares nothing and assigns nothing in this slice; write a value with `:=`\n", c.stderr)
    c.fprintf(f, "        if: 1\n            %s\n", leave_failure)
    return: 0
end: lm_graph_emit_path_statement

# Compile the same visible assignment Lmx. Resolve/check the destination before the RHS, then generate its numeric
# computation directly. The helpers write normal working places or graph cells; they never interpret the RHS.
fn: lm_graph_emit_assignment (@: g c.LmxGraph; @: f c.FILE; @: code c.Lmx; @: statement c.Lmx; int: mode; @: temps int; @@: decl_names char; @: decl_slots size_t; size_t: decl_n) int
    c.LmxGraphEmitScratch: leave_storage
    @: leave_failure char (cast: (@: char) leave_storage\failure)
    lm_graph_emit_leave_text(leave_failure, temps[1], 1)
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: left void c.lmx_graph_get(statement, 1U)
    @: name char c.lmx_graph_word_text(g, left)
    int: owner 0
    int: value 0
    int: source 0
    int: status 0
    if: state = 0 || c.lmx_graph_count(statement) != 3U
        return: 2
    # A write through the index of a Structure, `base[index] := value` (the book, structure-index), as the interpreter
    # runs it (lmx_graph_eval_index_write): the base and the index, then the value's address, then the kernel's
    # admission and slot write.
    if: name = 0 && c.lmx_graph_index_form(g, left) != 0
        status := lm_graph_emit_operand(g, f, code, (cast: (@: c.Lmx) left), 0U, temps, decl_names, decl_slots, decl_n, @ owner)
        if: status != 0
            return: status
        status := lm_graph_emit_number(g, f, code, (cast: (@: c.Lmx) left), 2U, temps, decl_names, decl_slots, decl_n, @ value)
        if: status != 0
            return: status
        status := lm_graph_emit_operand(g, f, code, statement, 2U, temps, decl_names, decl_slots, decl_n, @ source)
        if: status != 0
            return: status
        c.fprintf(f, "        if: lmx_graph_index_write(l2_g, lmx_call_code, l2_v%d, l2_t%d, l2_v%d) != 0\n            %s\n", owner, value, source, leave_failure)
        return: 0
    if: name != 0
        c.fputs("        if: lmx_graph_known_int(l2_g, lmx_call_code, ", f)
        status := lm_graph_emit_word(g, f, code, statement, 1U)
        c.fprintf(f, ", %d) != 0\n            %s\n", mode, leave_failure)
    else:
        status := lm_graph_emit_field_place(g, f, code, left, temps, decl_names, decl_slots, decl_n, @ owner)
    ---
    if: status != 0
        return: status
    status := lm_graph_emit_number(g, f, code, statement, 2U, temps, decl_names, decl_slots, decl_n, @ value)
    if: status != 0
        return: status
    if: name != 0
        if: mode = 0
            c.fputs("        if: lmx_graph_store_name(l2_g, lmx_call_code, ", f)
            status := lm_graph_emit_word(g, f, code, statement, 1U)
            c.fprintf(f, ", l2_t%d) != 0\n            %s\n", value, leave_failure)
        else:
            c.fputs("        if: lmx_graph_store_field(l2_g, lmx_call_code, lmx_call_code, lmx_graph_visible_slot(l2_g, lmx_call_code, ", f)
            status := lm_graph_emit_word(g, f, code, statement, 1U)
            c.fprintf(f, "), l2_t%d) != 0\n            %s\n", value, leave_failure)
        ---
    else:
        c.fprintf(f, "        if: lmx_graph_store_field(l2_g, lmx_call_code, (cast: (@: Lmx) l2_v%d), l2_s%d, l2_t%d) != 0\n            %s\n", owner, owner, value, leave_failure)
    ---
    return: status
end: lm_graph_emit_assignment

fn: lm_graph_emit_statements_from (@: g c.LmxGraph; @: f c.FILE; @: root c.Lmx; size_t: from; @: temps int) int
    c.LmxGraphEmitScratch: leave_storage
    @: leave_failure char (cast: (@: char) leave_storage\failure)
    lm_graph_emit_leave_text(leave_failure, temps[1], 1)
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    size_t: n (cast: (size_t) c.lmx_graph_count(root))
    @@: decl_names char c.calloc(n + 1U, sizeof(@: char))
    @: decl_slots size_t c.calloc(n + 1U, c.sizeof(c.size_t))
    size_t: decl_n 0U
    size_t: i 0U
    size_t: m 0U
    size_t: end_at 0U
    @: next c.Lmx 0
    @: value void 0
    @: inner c.Lmx 0
    @: head char 0
    @: name char 0
    int: temp 0
    int: r 0
    int: finish -1
    int: kind 0
    int: reached 0
    if: state = 0 || decl_names = 0 || decl_slots = 0
        return: 5
    # Earlier computed declarations have already been published by the time this continuation is entered.
    while: i < from
        value := c.lmx_graph_get(root, i)
        head := c.lmx_graph_name_of(g, value)
        if: c.lmx_graph_kind(g, value) = 4 && head != 0
            inner := (cast: (@: c.Lmx) value)
            if: head = state\w_int || head = state\w_at
                decl_names[decl_n] := c.lmx_graph_word_text(g, c.lmx_graph_get(inner, 0U))
                decl_slots[decl_n] := i
                decl_n := decl_n + 1U
            else:
                # A root application of fn or sub before the continuation gave its name (lmx_graph_fn_apply).
                if: (head = state\w_fn || head = state\w_sub) && c.lmx_graph_fn_written(g, inner) = 0
                    name := lm_graph_emit_fn_name(g, root, inner)
                    if: name != 0
                        decl_names[decl_n] := name
                        decl_slots[decl_n] := i
                        decl_n := decl_n + 1U
                    ---
                ---
            ---
        ---
        i := i + 1U
    ---
    while: i < n
        value := c.lmx_graph_get(root, i)
        kind := c.lmx_graph_kind(g, value)
        # A place of the root stands (lmx_graph_space_reach): it answers its name in the whole root, in the translation
        # now and in the program when it runs.
        if: kind = 1 || kind = 3 || kind = 5 || kind = 6
            if: c.lmx_graph_space_reach(g, root, i) < 0
                return: 1
            c.fprintf(f, "        if: lmx_graph_space_reach(l2_g, lmx_call_code, %zuU) < 0\n            %s\n", i, leave_failure)
            i := i + 1U
            continue
        if: kind != 4
            i := i + 1U
            continue
        inner := (cast: (@: c.Lmx) value)
        m := c.lmx_graph_count(inner)
        head := c.lmx_graph_name_of(g, value)
        if: head = 0
            # An unnamed Lmx: the assignment `a := v` or an anonymous body.
            if: m != 0U
                head := c.lmx_graph_word_text(g, c.lmx_graph_get(inner, 0U))
            if: head = state\w_assign
                r := lm_graph_emit_assignment(g, f, root, inner, 1, temps, decl_names, decl_slots, decl_n)
                if: r != 0
                    return: r
                i := i + 1U
                continue
            if: head = 0
                r := lm_graph_emit_block(g, f, root, root, i, i + 1U, 2, -1, -1, -1, temps)
                if: r != 0
                    return: r
            ---
            i := i + 1U
            continue
        # A declaration of fn or sub with written arguments created its Structure when the block was entered, in both
        # namespaces. The receiver applied to arguments the program computes runs where the program reaches it: the code
        # calls the kernel's application (lmx_graph_fn_apply), and the function it creates is interpreted -- the
        # translation creates no Structure and no native code for it.
        if: head = state\w_fn || head = state\w_sub
            if: c.lmx_graph_fn_written(g, inner) = 0
                c.fprintf(f, "        if: lmx_graph_fn_apply(l2_g, lmx_call_code, %zuU) != 0\n            %s\n", i, leave_failure)
                # The name it gives answers a function from here on when the program runs: a statement on it applies it,
                # a field applying it is decided then (the declaration table, lm_graph_emit_defined).
                name := lm_graph_emit_fn_name(g, root, inner)
                if: name != 0
                    decl_names[decl_n] := name
                    decl_slots[decl_n] := i
                    decl_n := decl_n + 1U
                ---
            ---
            i := i + 1U
            continue
        # A form `Name: tail` on a name this code does not declare when it runs is read as the interpreter reads it
        # (lmx_graph_root_declares), in the translation's namespace. A declaration of a Structure is declared when the
        # program reaches the field, by the kernel's own operation -- the translation changes nothing of the graph --,
        # and its name answers the Structure in the translation from here on; `Name: merge(...)` after the receiver
        # built the Structure in native code (lmx_graph_root_declare). The form on a known place that is no Structure
        # declares nothing and writes nothing: the code refuses it where the program reaches it, as the interpreter
        # does (8).
        if: lm_graph_emit_known(decl_names, decl_n, head) = 0
            reached := c.lmx_graph_root_declares(g, root, i)
            if: reached = 1
                if: m = 1U && c.lmx_graph_name_of(g, c.lmx_graph_get(inner, 0U)) = state\w_merge
                    c.fprintf(f, "        if: lmx_graph_root_declares(l2_g, lmx_call_code, %zuU) != 1\n            %s\n", i, leave_failure)
                    r := lm_graph_emit_merge(g, f, root, (cast: (@: c.Lmx) c.lmx_graph_get(inner, 0U)), temps, decl_names, decl_slots, decl_n, @ temp)
                    if: r != 0
                        return: r
                    c.fprintf(f, "        if: lmx_graph_root_declare(l2_g, lmx_call_code, %zuU, l2_v%d) != 0\n            %s\n", i, temp, leave_failure)
                else:
                    c.fprintf(f, "        if: lmx_graph_space_reach(l2_g, lmx_call_code, %zuU) != 1\n            %s\n", i, leave_failure)
                ---
                if: c.lmx_graph_space_put(root, head, value) != 0
                    return: 1
                i := i + 1U
                continue
            if: reached < 0
                lm_graph_emit_refused(head)
                c.fprintf(f, "        if: 1\n            %s\n", leave_failure)
                i := i + 1U
                continue
            ---
        ---
        if: head = state\w_fm
            return: 5
        if: head = state\w_finally
            r := lm_graph_emit_finally(g, f, root, root, i, n, inner, 1, -1, -1, -1, temps)
            c.free((cast: (@: void) decl_names))
            c.free((cast: (@: void) decl_slots))
            return: r
        if: head = state\w_if || head = state\w_else || head = state\w_while || head = state\w_for || head = state\w_until || head = state\w_return
            end_at := i + 1U
            if: head = state\w_if && end_at < n && c.lmx_graph_kind(g, c.lmx_graph_get(root, end_at)) = 4
                if: c.lmx_graph_name_of(g, c.lmx_graph_get(root, end_at)) = state\w_else
                    end_at := end_at + 1U
                ---
            ---
            r := lm_graph_emit_block(g, f, root, root, i, end_at, 2, -1, -1, -1, temps)
            if: r != 0
                return: r
            i := end_at
            continue
        # The unit's C-door declarations stand; the program runs nothing for them (lmx_graph_exec_statement).
        if: head = state\w_include || head = state\w_predef
            i := i + 1U
            continue
        if: head = state\w_call
            r := lm_graph_emit_explicit_call(g, f, root, inner, temps, decl_names, decl_slots, decl_n)
            if: r != 0
                return: r
            i := i + 1U
            continue
        # fncall written as a statement: the launch runs and its result is not used.
        if: head = state\w_fncall
            r := lm_graph_emit_fncall(g, f, root, inner, temps, decl_names, decl_slots, decl_n, @ temp)
            if: r != 0
                return: r
            i := i + 1U
            continue
        if: c.lmx_graph_method(g, (cast: (@: c.Lmx) c.lmx_graph_target(g, c.lmx_graph_resolve(g, root, head)))) != 0
            r := lm_graph_emit_call(g, f, root, inner, temps, decl_names, decl_slots, decl_n, @ temp)
            if: r != 0
                return: r
            i := i + 1U
            continue
        if: head = state\w_at
            # `@: name value`: a reference place for the Structure or the callable the value stands for, as the
            # interpreter reads it (lmx_graph_exec_statement) -- the same kernel operation at run time.
            if: m = 2U
                name := c.lmx_graph_word_text(g, c.lmx_graph_get(inner, 0U))
                if: name = 0
                    return: 5
                r := lm_graph_emit_operand(g, f, root, inner, 1U, temps, decl_names, decl_slots, decl_n, @ temp)
                if: r != 0
                    return: r
                c.fprintf(f, "        l2_c: lmx_graph_lmx_ref_of(l2_g, l2_v%d)\n        if: l2_c = 0 || lmx_graph_publish(l2_g, lmx_call_code, %zuU, l2_c) != 0\n            %s\n", temp, i, leave_failure)
                decl_names[decl_n] := name
                decl_slots[decl_n] := i
                decl_n := decl_n + 1U
                i := i + 1U
                continue
            ---
            if: m != 3U || c.lmx_graph_word_text(g, c.lmx_graph_get(inner, 1U)) != state\w_int
                return: 5
            name := c.lmx_graph_word_text(g, c.lmx_graph_get(inner, 0U))
            if: name = 0
                return: 5
            r := lm_graph_emit_operand(g, f, root, inner, 2U, temps, decl_names, decl_slots, decl_n, @ temp)
            if: r != 0
                return: r
            # The place takes an int reference, or the address an index of a Structure read when it is an int cell's.
            c.fprintf(f, "        l2_c: lmx_graph_int_ref_of(l2_g, l2_v%d)\n        if: l2_c = 0 || lmx_graph_publish(l2_g, lmx_call_code, %zuU, l2_c) != 0\n            %s\n", temp, i, leave_failure)
            decl_names[decl_n] := name
            decl_slots[decl_n] := i
            decl_n := decl_n + 1U
            i := i + 1U
            continue
        if: head = state\w_int
            name := c.lmx_graph_word_text(g, c.lmx_graph_get(inner, 0U))
            if: m < 2U || name = 0
                return: 5
            r := lm_graph_emit_expr(g, f, root, inner, 1U, m, temps, decl_names, decl_slots, decl_n, @ temp)
            if: r != 0
                return: r
            c.fprintf(f, "        l2_c: lmx_graph_int(l2_g, l2_t%d)\n        if: l2_c = 0 || lmx_graph_publish(l2_g, lmx_call_code, %zuU, l2_c) != 0\n            %s\n", temp, i, leave_failure)
            decl_names[decl_n] := name
            decl_slots[decl_n] := i
            decl_n := decl_n + 1U
            i := i + 1U
            continue
        # Another statement of the language is none this slice executes at the root.
        if: lm_graph_emit_known(decl_names, decl_n, head) = 0
            return: 5
        # A form on a place this code declares when it runs. A place that may hold a callable then -- a reference place
        # `@: name value`, a function a root application of fn or sub gives (lm_graph_emit_defined) -- applies it, as
        # the interpreter does (lmx_graph_exec_statement). Any other place is no Structure: the form declares nothing
        # and writes nothing (the book, forms-declare-or-call), whatever its tail, and the code refuses it where the
        # program reaches it -- so the translation of the call reading is never stopped by it.
        finish := -1
        if: lm_graph_emit_defined(g, root, decl_names, decl_slots, decl_n, head) != 0
            r := lm_graph_emit_apply_or(g, f, root, inner, temps, decl_names, decl_slots, decl_n, @ finish)
            if: r != 0
                return: r
            c.fprintf(f, "        %s\n        l2_label%d:\n", leave_failure, finish)
        else:
            lm_graph_emit_refused(head)
            c.fprintf(f, "        if: 1\n            %s\n", leave_failure)
        ---
        i := i + 1U
    ---
    c.free((cast: (@: void) decl_names))
    c.free((cast: (@: void) decl_slots))
    return: 0
end: lm_graph_emit_statements_from

fn: lm_graph_emit_statements (@: g c.LmxGraph; @: f c.FILE; @: root c.Lmx; @: temps int) int
    return: lm_graph_emit_statements_from(g, f, root, 0U, temps)
end: lm_graph_emit_statements

# Native method statements compute their own arithmetic/calls. The shared kernel only owns admission, working
# cells and publication. Every return/error passes through the entry wrapper's work_finish.
fn: lm_graph_emit_block (@: g c.LmxGraph; @: f c.FILE; @: code c.Lmx; @: body c.Lmx; size_t: from; size_t: to; int: mode; int: exit_label; int: again_label; int: step_label; @: temps int) int
    c.LmxGraphEmitScratch: leave_storage
    @: leave_failure char (cast: (@: char) leave_storage\failure)
    lm_graph_emit_leave_text(leave_failure, temps[1], 1)
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: statement c.Lmx 0
    @: head char 0
    @: name char 0
    @: target void 0
    size_t: i from
    size_t: n 0U
    @: leave_return char (cast: (@: char) leave_storage\returned)
    lm_graph_emit_leave_text(leave_return, temps[2], 0)
    int: result 0
    int: status 0
    int: kind 0
    int: number 0
    int: test_label 0
    int: body_label 0
    int: next_label 0
    int: end_label 0
    int: target_label -1
    int: finish -1
    @: nested c.Lmx 0
    @: header c.Lmx 0
    @: raw void 0
    while: i < to && status = 0
        raw := c.lmx_graph_get(body, i)
        kind := c.lmx_graph_kind(g, raw)
        # A declaration of an int place in a body runs at its written position (§3.2), at every reach, as in the
        # interpreter (plan M11 5a, B5, B10): a literal declaration writes into the activation's place what stands in its
        # slot when the line runs -- read from the graph then, not the value the translation saw --, a place without a
        # value is checked; in an inline body of the root the root's place is written.
        if: kind = 1 || kind = 3
            name := c.lmx_graph_slot_name(g, body, i)
            if: name != 0 && mode = 0
                c.fputs("        if: lmx_graph_local_int(l2_g, lmx_call_code, ", f)
                lm_graph_emit_quoted_word(f, name)
                c.fprintf(f, ") != 0\n            %s\n", leave_failure)
                if: kind = 1
                    number := temps[0]
                    temps[0] := temps[0] + 1
                    c.fprintf(f, "        int: l2_t%d 0\n        if: lmx_graph_value_int(l2_g, lmx_graph_get(", number)
                    if: lm_graph_emit_address(g, f, code, body) != 0
                        return: 3
                    c.fprintf(f, ", %zuU), @ l2_t%d) != 0\n            %s\n", i, number, leave_failure)
                    c.fputs("        if: lmx_graph_store_name(l2_g, lmx_call_code, ", f)
                    lm_graph_emit_quoted_word(f, name)
                    c.fprintf(f, ", l2_t%d) != 0\n            %s\n", number, leave_failure)
                ---
            ---
            if: name != 0 && mode = 2 && kind = 1
                c.fputs("        if: lmx_graph_assign_int(l2_g, lmx_call_code, lmx_call_code, lmx_graph_visible_slot(l2_g, lmx_call_code, ", f)
                lm_graph_emit_quoted_word(f, name)
                c.fprintf(f, "), %d) != 0\n            %s\n", c.lmx_int_value_known(raw), leave_failure)
            ---
            i := i + 1U
            continue
        if: kind = 5 || kind = 6
            i := i + 1U
            continue
        if: kind != 4
            head := c.lmx_graph_word_text(g, raw)
            target_label := -1
            if: head = state\w_break
                target_label := exit_label
            if: head = state\w_continue
                target_label := step_label
            if: head = state\w_redo
                target_label := again_label
            if: head = state\w_return
                if: c.lmx_graph_has_result(g, code) != 0
                    return: 5
                c.fprintf(f, "        %s\n", leave_return)
                return: 0
            if: head = state\w_break || head = state\w_continue || head = state\w_redo
                if: target_label < 0
                    return: 5
                c.fprintf(f, "        goto: l2_label%d\n", target_label)
            else:
                if: mode = 0
                    status := lm_graph_emit_number(g, f, code, body, i, temps, 0, 0, 0U, @ result)
                ---
            ---
            i := i + 1U
            continue
        statement := (cast: (@: c.Lmx) raw)
        n := c.lmx_graph_count(statement)
        head := c.lmx_graph_name_of(g, raw)
        if: head = 0
            if: n != 0U
                head := c.lmx_graph_word_text(g, c.lmx_graph_get(statement, 0U))
            if: head = state\w_assign
                status := lm_graph_emit_assignment(g, f, code, statement, mode, temps, 0, 0, 0U)
                i := i + 1U
                continue
            # A statement on a path head, `owner\field: value`: the write of that field, as the interpreter runs it.
            if: head = 0 && c.lmx_graph_path_head(g, raw) != 0
                status := lm_graph_emit_path_statement(g, f, code, statement, temps, 0, 0, 0U)
                i := i + 1U
                continue
            if: head = 0
                status := lm_graph_emit_block(g, f, code, statement, 0U, n, mode, exit_label, again_label, step_label, temps)
                i := i + 1U
                continue
            if: mode = 0
                status := lm_graph_emit_number(g, f, code, body, i, temps, 0, 0, 0U, @ result)
            i := i + 1U
            continue
        # A declaration of fn or sub with written arguments created its Structure when its block was entered; the receiver
        # applied to computed arguments in a body or an inline block is open, as in the interpreter (5).
        if: head = state\w_fn || head = state\w_sub
            if: c.lmx_graph_fn_written(g, statement) = 0
                return: 5
            i := i + 1U
            continue
        if: head = state\w_fm
            return: 5
        if: head = state\w_finally
            return: lm_graph_emit_finally(g, f, code, body, i, to, statement, mode, exit_label, again_label, step_label, temps)
        if: head = state\w_if
            if: n != 2U || c.lmx_graph_kind(g, c.lmx_graph_get(statement, 1U)) != 4
                return: 2
            end_label := temps[0]
            next_label := end_label + 1
            temps[0] := temps[0] + 2
            status := lm_graph_emit_number(g, f, code, statement, 0U, temps, 0, 0, 0U, @ result)
            c.fprintf(f, "        if: l2_t%d = 0\n            goto: l2_label%d\n", result, next_label)
            nested := (cast: (@: c.Lmx) c.lmx_graph_get(statement, 1U))
            if: status = 0
                status := lm_graph_emit_block(g, f, code, nested, 0U, c.lmx_graph_count(nested), mode, exit_label, again_label, step_label, temps)
            c.fprintf(f, "        goto: l2_label%d\n        l2_label%d:\n", end_label, next_label)
            i := i + 1U
            if: i < to && c.lmx_graph_kind(g, c.lmx_graph_get(body, i)) = 4 && c.lmx_graph_name_of(g, c.lmx_graph_get(body, i)) = state\w_else
                statement := (cast: (@: c.Lmx) c.lmx_graph_get(body, i))
                if: status = 0
                    status := lm_graph_emit_block(g, f, code, statement, 0U, c.lmx_graph_count(statement), mode, exit_label, again_label, step_label, temps)
                i := i + 1U
            ---
            c.fprintf(f, "        l2_label%d:\n", end_label)
            continue
        if: head = state\w_else
            return: 2
        if: head = state\w_while || head = state\w_for || head = state\w_until
            if: n != 2U || c.lmx_graph_kind(g, c.lmx_graph_get(statement, 1U)) != 4
                return: 2
            nested := (cast: (@: c.Lmx) c.lmx_graph_get(statement, 1U))
            header := (cast: (@: c.Lmx) c.lmx_graph_get(statement, 0U))
            test_label := temps[0]
            body_label := test_label + 1
            next_label := test_label + 2
            end_label := test_label + 3
            temps[0] := temps[0] + 4
            if: head = state\w_for
                if: c.lmx_graph_kind(g, (cast: (@: void) header)) != 4 || c.lmx_graph_count(header) != 3U
                    return: 2
                status := lm_graph_emit_block(g, f, code, header, 0U, 1U, mode, exit_label, again_label, step_label, temps)
            if: head = state\w_until
                c.fprintf(f, "        goto: l2_label%d\n", body_label)
            c.fprintf(f, "        l2_label%d:\n", test_label)
            if: status = 0
                if: head = state\w_for
                    status := lm_graph_emit_number(g, f, code, header, 1U, temps, 0, 0, 0U, @ result)
                else:
                    status := lm_graph_emit_number(g, f, code, statement, 0U, temps, 0, 0, 0U, @ result)
                ---
            ---
            if: head = state\w_until
                c.fprintf(f, "        if: l2_t%d != 0\n            goto: l2_label%d\n        l2_label%d:\n", result, end_label, body_label)
            else:
                c.fprintf(f, "        if: l2_t%d = 0\n            goto: l2_label%d\n        l2_label%d:\n", result, end_label, body_label)
            ---
            if: status = 0
                status := lm_graph_emit_block(g, f, code, nested, 0U, c.lmx_graph_count(nested), mode, end_label, body_label, next_label, temps)
            c.fprintf(f, "        l2_label%d:\n", next_label)
            if: status = 0 && head = state\w_for
                status := lm_graph_emit_block(g, f, code, header, 2U, 3U, mode, exit_label, again_label, step_label, temps)
            c.fprintf(f, "        goto: l2_label%d\n        l2_label%d:\n", test_label, end_label)
            i := i + 1U
            continue
        if: head = state\w_break || head = state\w_continue || head = state\w_redo
            if: n != 0U
                return: 5
            target_label := exit_label
            if: head = state\w_continue
                target_label := step_label
            if: head = state\w_redo
                target_label := again_label
            if: target_label < 0
                return: 5
            c.fprintf(f, "        goto: l2_label%d\n", target_label)
            i := i + 1U
            continue
        if: head = state\w_return
            if: n = 0U
                if: c.lmx_graph_has_result(g, code) != 0
                    c.fprintf(f, "        %s\n", leave_failure)
                else:
                    c.fprintf(f, "        %s\n", leave_return)
                ---
                return: 0
            if: c.lmx_graph_has_result(g, code) = 0
                return: 5
            status := lm_graph_emit_expr(g, f, code, statement, 0U, n, temps, 0, 0, 0U, @ result)
            c.fprintf(f, "        l2_result[0]: l2_t%d\n        %s\n", result, leave_return)
            return: status
        if: head = state\w_call
            status := lm_graph_emit_explicit_call(g, f, code, statement, temps, 0, 0, 0U)
            i := i + 1U
            continue
        # fncall written as a statement: the launch runs and its result is not used.
        if: head = state\w_fncall
            status := lm_graph_emit_fncall(g, f, code, statement, temps, 0, 0, 0U, @ result)
            i := i + 1U
            continue
        if: head = state\w_at
            return: 5
        if: head = state\w_include || head = state\w_predef
            i := i + 1U
            continue
        if: mode != 0
            target := c.lmx_graph_target(g, c.lmx_graph_resolve(g, code, head))
            if: c.lmx_graph_method(g, (cast: (@: c.Lmx) target)) != 0
                status := lm_graph_emit_call(g, f, code, statement, temps, 0, 0, 0U, @ result)
                i := i + 1U
                continue
            # A head this translation cannot resolve: the kernel decides when the code runs whether the statement
            # applies a callable, as the interpreter does (lm_graph_emit_apply_or).
            finish := -1
            if: target = 0 && head != state\w_int && c.lmx_graph_language_word(state, head) = 0
                status := lm_graph_emit_apply_or(g, f, code, statement, temps, 0, 0, 0U, @ finish)
            if: head = state\w_int
                c.fputs("        if: lmx_graph_visible_slot(l2_g, lmx_call_code, ", f)
                status := lm_graph_emit_word(g, f, code, statement, 0U)
                c.fprintf(f, ") = lmx_graph_count(lmx_call_code)\n            %s\n", leave_failure)
                if: n > 1U && status = 0
                    status := lm_graph_emit_expr(g, f, code, statement, 1U, n, temps, 0, 0, 0U, @ result)
                    c.fputs("        if: lmx_graph_assign_int(l2_g, lmx_call_code, lmx_call_code, lmx_graph_visible_slot(l2_g, lmx_call_code, ", f)
                    if: status = 0
                        status := lm_graph_emit_word(g, f, code, statement, 0U)
                    c.fprintf(f, "), l2_t%d) != 0\n            %s\n", result, leave_failure)
                ---
            else:
                # No structural form writes a place (the book, forms-declare-or-call): behind the call reading, or on a
                # head the translation knows as a place or a Structure, the code refuses the form where the program
                # reaches it, as the interpreter does (8 for a place that is no Structure, else 5).
                if: finish >= 0
                    c.fprintf(f, "        %s\n", leave_failure)
                else:
                    if: c.lmx_graph_resolve(g, code, head) != 0 && c.lmx_graph_kind(g, c.lmx_graph_resolve(g, code, head)) != 4
                        lm_graph_emit_refused(head)
                    c.fprintf(f, "        if: 1\n            %s\n", leave_failure)
                ---
            ---
            if: finish >= 0
                c.fprintf(f, "        l2_label%d:\n", finish)
            i := i + 1U
            continue
        if: head = state\w_int
            c.fputs("        if: lmx_graph_local_int(l2_g, lmx_call_code, ", f)
            status := lm_graph_emit_word(g, f, code, statement, 0U)
            c.fprintf(f, ") != 0\n            %s\n", leave_failure)
            if: status = 0 && n > 1U
                status := lm_graph_emit_expr(g, f, code, statement, 1U, n, temps, 0, 0, 0U, @ result)
                c.fputs("        if: lmx_graph_store_name(l2_g, lmx_call_code, ", f)
                if: status = 0
                    status := lm_graph_emit_word(g, f, code, statement, 0U)
                c.fprintf(f, ", l2_t%d) != 0\n            %s\n", result, leave_failure)
            ---
            i := i + 1U
            continue
        target := c.lmx_graph_target(g, c.lmx_graph_resolve(g, code, head))
        if: c.lmx_graph_method(g, (cast: (@: c.Lmx) target)) != 0
            status := lm_graph_emit_call(g, f, code, statement, temps, 0, 0, 0U, @ result)
        else:
            # A head this translation cannot resolve, or resolves to an ordinary Structure, and that is no formal of this
            # method: the kernel decides when the code runs whether the statement applies a callable or launches a
            # Structure -- the launch's data and inputs answer before the levels this translation sees (lmx_graph_resolve;
            # lm_graph_emit_apply_or).
            finish := -1
            if: (target = 0 || c.lmx_graph_kind(g, target) = 4) && c.lmx_graph_language_word(state, head) = 0 && lm_graph_emit_formal(g, code, head) = 0
                status := lm_graph_emit_apply_or(g, f, code, statement, temps, 0, 0, 0U, @ finish)
            # No structural form writes a place (the book, forms-declare-or-call): behind the call reading, or on a
            # formal, a place or a Structure the translation knows, the code refuses the form where the program reaches
            # it, as the interpreter does (8 for a place that is no Structure, else 5).
            if: finish >= 0
                c.fprintf(f, "        %s\n        l2_label%d:\n", leave_failure, finish)
            else:
                if: lm_graph_emit_formal(g, code, head) != 0 || (c.lmx_graph_resolve(g, code, head) != 0 && c.lmx_graph_kind(g, c.lmx_graph_resolve(g, code, head)) != 4)
                    lm_graph_emit_refused(head)
                c.fprintf(f, "        if: 1\n            %s\n", leave_failure)
            ---
        ---
        i := i + 1U
    ---
    return: status
end: lm_graph_emit_block

# A canonical spelling as the L1 of the same canonical word when the code runs: lmx_graph_intern of its bytes, which
# answers the process's canonical address of that spelling (§4).
sub: lm_graph_emit_quoted_word (@: f c.FILE; @: name char)
    c.fputs("lmx_graph_intern(", f)
    lm_graph_emit_quoted(f, name)
    c.fprintf(f, ", %zuU)", (cast: (size_t) c.strlen(name)))
    return
end: lm_graph_emit_quoted_word

fn: lm_graph_emit_method_body (@: g c.LmxGraph; @: f c.FILE; @: code c.Lmx; @: temps int) int
    @: body c.Lmx code
    int: status 0
    if: c.lmx_graph_method(g, code) != 0
        body := c.lmx_graph_method_code(g, code)
    status := lm_graph_emit_block(g, f, code, body, 0U, c.lmx_graph_count(body), 0, -1, -1, -1, temps)
    if: status = 0
        c.fprintf(f, "        return: %d\n", c.lmx_graph_has_result(g, code))
    return: status
end: lm_graph_emit_method_body

# The consumer collects method addresses once from the completed graph. This list belongs only to this translation,
# not to construction and not to a future execution. Emit and install reuse it without walking all children twice.
fn: lm_graph_collect_methods (@: g c.LmxGraph; @: root c.Lmx; @@@: methods c.Lmx; @: methods_count size_t) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @@: queue c.Lmx 0
    size_t: count 0U
    size_t: capacity 0U
    size_t: method_capacity 0U
    size_t: at 0U
    size_t: i 0U
    @: current c.Lmx 0
    @: made c.Lmx 0
    @: value void 0
    @: head char 0
    int: status c.lmx_graph_scan_add(@ queue, @ count, @ capacity, root)
    while: at < count && status = 0
        current := queue[at]
        at := at + 1U
        head := c.lmx_graph_name_of(g, (cast: (@: void) current))
        if: (head = state\w_fn || head = state\w_sub) && current\parent != 0
            made := (cast: (@: c.Lmx) c.lmx_graph_space_find((cast: (@: c.Lmx) current\parent), c.lmx_graph_fn_decl_name(g, current)))
            if: c.lmx_graph_method(g, made) != 0 && made\parent = current
                status := c.lmx_graph_scan_add(methods, methods_count, @ method_capacity, made)
            ---
        ---
        i := 0U
        while: i < c.lmx_graph_count(current) && status = 0
            value := c.lmx_graph_get(current, i)
            if: c.lmx_graph_kind(g, value) = 4
                status := c.lmx_graph_scan_add(@ queue, @ count, @ capacity, (cast: (@: c.Lmx) value))
            i := i + 1U
        ---
    ---
    c.free((cast: (@: void) queue))
    return: status
end: lm_graph_collect_methods

fn: lm_graph_emit_methods (@: g c.LmxGraph; @: f c.FILE; @: scope c.Lmx; @@: methods c.Lmx; size_t: count; int: install) int
    @: current c.Lmx 0
    size_t: i 0U
    int: label 0
    c.LmxGraphEmitScratch: temp_storage
    @: temps int (cast: (@: int) temp_storage\control)
    temps[0] := 0
    temps[1] := -1
    temps[2] := -1
    int: status 0
    while: i < count && status = 0
        current := methods[i]
        label := (cast: (int) i)
        if: install != 0
            # The entry goes on the declaration (the Frame of the graph): the Structure each traversal creates from it
            # takes it (lmx_graph_fn_make); the data a traversal makes runs its initializers through the interpreter.
            c.fputs("        l2_method: ", f)
            status := lm_graph_emit_address(g, f, scope, (cast: (@: c.Lmx) current\parent))
            c.fprintf(f, "\n        l2_method\\native: (cast: (LmxEntry) lm_graph_method%d)\n", label)
        else:
            temps[0] := 0
            temps[1] := -1
            temps[2] := -1
            c.fprintf(f, "external:\n    fn: lm_graph_body%d (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out; @: LmxArena lmx_call_arena; @: Lmx lmx_call_code; @: LmxWalkValue input; @: LmxWalkValue result) int\n        @: LmxGraph l2_g lmx_graph_find(lmx_call_arena)\n        @: int l2_result (cast: (@: int) dest)\n        if: l2_g = 0 || l2_result = 0\n            return: 1\n", label)
            if: status = 0
                status := lm_graph_emit_method_body(g, f, current, temps)
            c.fprintf(f, "    end: lm_graph_body%d\nend: external\n\nexternal:\n", label)
            c.fprintf(f, "    fn: lm_graph_method%d (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out; @: LmxArena lmx_call_arena; @: Lmx lmx_call_code; @: LmxWalkValue input; @: LmxWalkValue result) int\n        @: LmxGraph l2_g lmx_graph_find(lmx_call_arena)\n        LmxGraphFrame: l2_frame\n        int: l2_status 0\n        if: l2_g = 0\n            return: 1\n        l2_status: lmx_graph_work_open_data(l2_g, lmx_call_code, (cast: (@: Lmx) owner), @ l2_frame)\n        if: l2_status != 0\n            return: 1\n        l2_status: lm_graph_body%d(owner, refs, nargs, dest, out, lmx_call_arena, lmx_call_code, input, result)\n        return: lmx_graph_work_finish(l2_g, @ l2_frame, l2_status)\n    end: lm_graph_method%d\nend: external\n\n", label, label, label)
        ---
        i := i + 1U
    ---
    return: status
end: lm_graph_emit_methods

# The L1 of the program of root at out_path (§7): the kernel headers, the program hooks the driver expects, the body of
# the root -- native (its statements over the cells of the graph) or forced (the kernel's interpreter over the same
# graph) -- which prints the graph before and after between GRAPH markers, the generated initialization of the clean
# graph in R0's arena and root (l2_program_build), and main as the host's launch. 0, or the failing answer.
fn: lm_graph_emit_program (@: g c.LmxGraph; @: root c.Lmx; const: (@: out_path char); int: forced; int: check_root; int: runs) int
    @: f c.FILE 0
    @: value void 0
    size_t: n (cast: (size_t) c.lmx_graph_count(root))
    size_t: i 0U
    c.LmxCopyMap: emitted
    size_t: next 2U
    c.LmxGraphEmitScratch: temp_storage
    @: temps int (cast: (@: int) temp_storage\control)
    temps[0] := 0
    temps[1] := -1
    temps[2] := -1
    int: r 0
    @@: methods c.Lmx 0
    size_t: methods_count 0U
    size_t: host_fields n
    if: check_root != 0
        host_fields := 1U
    int: opened 0
    if: g = 0 || root = 0 || out_path = 0 || runs < 1
        return: 5
    # The translation is a traversal of the graph: its namespace begins empty and ends with the translation.
    r := c.lmx_graph_space_open(g, root, @ opened)
    if: r != 0
        return: r
    f := c.fopen(out_path, "wb")
    if: f = 0
        c.lmx_graph_space_close(opened)
        return: 5
    c.fputs("# Generated by the graph tool of slice 309 (src/l2src/l2_graph_tool.lm2): the program of a clean graph.\n", f)
    c.fputs("predef: \"l2src/lmx_arena_refs.h.lm1\" \"l2src/lmx_value_owned.h.lm1\" \"l2src/lmx.h.lm1\" \"l2src/lmx_message.h.lm1\" \"l2src/lmx_root.h.lm1\" \"l2src/lmx_call.h.lm1\" \"l2src/lmx_clock.h.lm1\" \"l2src/lmx_ids.h.lm1\" \"l2src/lmx_arena.h.lm1\" \"l2src/lmx_graph.h.lm1\" \"l2src/lmx_graph_run.h.lm1\"\n", f)
    if: check_root != 0
        c.fputs("predef: \"l2src/lmx_thread.h.lm1\"\n", f)
    c.fputs("include: \"<stdio.h>\" \"<stdlib.h>\"\n\n@: LmxArena l2_program_arena 0\n@: Lmx l2_program_unit 0\n@: Lmx l2_program_root_graph 0\n\nfn: l2_program_graph () @: Lmx\nreturn: l2_program_root_graph\n\nfn: l2_program_qualified_count () size_t\nreturn: 0U\n\nfn: l2_program_qualified_at (size_t: index) @: Lmx\nreturn: 0\n\n", f)
    # Declare each native temporary where its first value is emitted. The emitter needs no temporary file or second
    # copy of the body; its traversal-local counter only supplies distinct L1 names.
    if: forced = 0
        r := lm_graph_collect_methods(g, root, @ methods, @ methods_count)
        if: r = 0
            r := lm_graph_emit_methods(g, f, root, methods, methods_count, 0)
        if: r != 0
            c.fclose(f)
            c.free((cast: (@: void) methods))
            c.lmx_graph_space_close(opened)
            return: r
        ---
    ---
    c.fputs("external:\n    fn: lm_graph_root (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out; @: LmxArena lmx_call_arena; @: Lmx lmx_call_code; @: LmxWalkValue lmx_input_values; @: LmxWalkValue lmx_result_context) int\n        @: LmxGraph l2_g 0\n        @: void l2_c 0\n        l2_g: lmx_graph_find(lmx_call_arena)\n", f)
    c.fputs("        if: l2_g = 0 || lmx_call_code = 0\n            return: 1\n", f)
    if: check_root = 0
        c.fputs("        if: lmx_graph_dump_marked(l2_g, lmx_call_code, c.stdout, \"BEFORE\") != 0\n            return: 1\n", f)
    if: forced = 0
        r := lm_graph_emit_statements(g, f, root, temps)
        if: r != 0
            c.fclose(f)
            c.free((cast: (@: void) methods))
            c.lmx_graph_space_close(opened)
            return: r
        ---
    else:
        c.fputs("        if: lmx_graph_run(l2_g, lmx_call_code) != 0\n            return: 1\n", f)
    ---
    if: check_root = 0
        c.fputs("        if: lmx_graph_dump_marked(l2_g, lmx_call_code, c.stdout, \"AFTER\") != 0\n            return: 1\n", f)
    c.fputs("        return: 0\n    end: lm_graph_root\nend: external\n\n", f)
    # The root's entry: the run of the program is a traversal with its own namespace (lmx_graph_space_open), shared
    # when it is entered inside a live one.
    c.fputs("external:\n    fn: lm_graph_body (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out; @: LmxArena lmx_call_arena; @: Lmx lmx_call_code; @: LmxWalkValue lmx_input_values; @: LmxWalkValue lmx_result_context) int\n        @: LmxGraph l2_g lmx_graph_find(lmx_call_arena)\n        int: l2_opened 0\n        int: l2_status 0\n        if: l2_g = 0 || lmx_call_code = 0\n            return: 1\n        if: lmx_graph_space_open(l2_g, lmx_call_code, @ l2_opened) != 0\n            return: 1\n        l2_status: lm_graph_root(owner, refs, nargs, dest, out, lmx_call_arena, lmx_call_code, lmx_input_values, lmx_result_context)\n        lmx_graph_space_close(l2_opened)\n        return: l2_status\n    end: lm_graph_body\nend: external\n\n", f)
    # Only emit-check supplies a test host. The body keeps the language rule: returning 0 is NOT Message success.
    # Like the `run` command's host, this separate adapter completes its own test after a successful body. Ordinary
    # `emit` gets no adapter and still fails R0 when the source supplies neither success nor an exit Message.
    if: check_root != 0
        c.fprintf(f, "external:\n    fn: lm_graph_check_root (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out; @: LmxArena arena; @: Lmx code; @: LmxWalkValue input; @: LmxWalkValue result) int\n        @: LmxGraph g lmx_graph_find(arena)\n        @: Lmx unit (cast: (@: Lmx) lmx_graph_get(code, 0U))\n        int: status 0\n        int: count 0\n        if: g = 0 || unit = 0 || lmx_graph_dump_marked(g, unit, c.stdout, \"BEFORE\") != 0\n            return: 1\n        while: count < %d && status = 0\n            status: lmx_graph_call(g, unit)\n            count: count + 1\n        ---\n        if: lmx_graph_dump_marked(g, unit, c.stdout, \"AFTER\") != 0\n            return: 1\n        if: status != 0\n            return: status\n        @: LmxThread thread lmx_thread_current()\n        @: LmxMsg message lmx_thread_message(thread)\n        if: message = 0\n            return: 1\n        message\\success: (cast: (LmxFlag) 1)\n        return: 0\n    end: lm_graph_check_root\nend: external\n\n", runs)
    # Ordinary emission builds the program in R0. A private emit-check host owns a separate program root, so clearing
    # the program's native entry cannot erase the adapter or change the program's lexical parent.
    c.fputs("external:\n    fn: l2_program_build (@: LmxArena arena; @: Lmx graph; @: Lmx settings) int\n        @: LmxGraph l2_g 0\n        @: void l2_c 0\n        @: Lmx lmx_call_code 0\n        @: Lmx l2_method 0\n", f)
    c.fputs("        l2_g: lmx_graph_open(arena)\n        if: l2_g = 0 || graph = 0\n            return: 1\n        l2_program_arena: arena\n        l2_program_root_graph: graph\n        l2_program_unit: graph\n", f)
    if: check_root != 0
        c.fprintf(f, "        l2_program_unit: lmx_graph_lmx(l2_g, 0, %zuU)\n        if: l2_program_unit = 0 || lmx_graph_put(graph, 0U, (cast: (@: void) l2_program_unit)) != 0\n            return: 1\n", n)
    c.fputs("        @: void l2_gv1 (cast: (@: void) l2_program_unit)\n", f)
    r := c.lmx_copy_map_init(@ emitted)
    if: r = 0
        r := c.lmx_copy_map_put(@ emitted, (cast: (@: void) root), (cast: (@: void) 1U))
    while: i < n && r = 0
        value := c.lmx_graph_get(root, i)
        r := lm_graph_emit_value(g, f, value, "l2_program_unit", i, @ emitted, @ next)
        i := i + 1U
    ---
    if: r = 0
        r := lm_graph_emit_parents(g, f, @ emitted, next)
    c.lmx_copy_map_dispose(@ emitted)
    if: r != 0
        c.fclose(f)
        c.free((cast: (@: void) methods))
        c.lmx_graph_space_close(opened)
        return: 5
    ---
    if: forced = 0
        c.fputs("        lmx_call_code: l2_program_unit\n", f)
        r := lm_graph_emit_methods(g, f, root, methods, methods_count, 1)
        if: r != 0
            c.fclose(f)
            c.free((cast: (@: void) methods))
            c.lmx_graph_space_close(opened)
            return: r
        ---
    ---
    c.fputs("        l2_program_unit\\native: (cast: (LmxEntry) lm_graph_body)\n", f)
    if: check_root != 0
        c.fputs("        graph\\native: (cast: (LmxEntry) lm_graph_check_root)\n", f)
    c.fputs("        return: 0\n    end: l2_program_build\nend: external\n\n", f)
    c.fprintf(f, "external:\n    fn: main (int: argc; @@: char argv) int\n        LmxRoot: l2_program_root\n        return: lmx_root_launch(@ l2_program_root, argc, argv, l2_program_build, %zuU, lmx_root_settings, 5000U, (cast: (@: void) c.stdout), (cast: (@: void) c.stderr))\n    end: main\nend: external\n", host_fields)
    c.free((cast: (@: void) methods))
    c.lmx_graph_space_close(opened)
    if: c.fclose(f) != 0
        return: 5
    return: 0
end: lm_graph_emit_program

# ---- The command line of tools/graph_trans.lm2 ---------------------------------------------------------------------

# `run FILE`: the clean graph of FILE in a fresh arena, printed before and after the kernel's interpreter ran it
# (GRAPH-BEFORE / GRAPH-AFTER markers). 0, or the interpreter's answer (printed).
fn: lm_graph_run_file (const: (@: path char); int: runs) int
    @: arena c.LmxArena (cast: (@: c.LmxArena) c.calloc(1U, c.sizeof(c.LmxArena)))
    @: g c.LmxGraph 0
    @: root c.Lmx 0
    int: r 0
    int: count 0
    if: arena = 0
        return: 1
    if: c.lmx_arena_open(arena) != 0
        c.fputs("graph: cannot open an arena\n", c.stderr)
        return: 1
    g := c.lmx_graph_open(arena)
    if: g = 0
        return: 1
    r := lm_graph_build_file(g, path, @ root)
    if: r != 0
        c.fprintf(c.stderr, "graph: build answered %d\n", r)
        return: r
    if: c.lmx_graph_dump_marked(g, root, c.stdout, "BEFORE") != 0
        c.fputs("graph: the graph does not print\n", c.stderr)
        return: 1
    while: count < runs && r = 0
        r := c.lmx_graph_call(g, root)
        count := count + 1
    ---
    if: r != 0
        c.fprintf(c.stderr, "graph: run answered %d\n", r)
    if: c.lmx_graph_dump_marked(g, root, c.stdout, "AFTER") != 0
        c.fputs("graph: the graph does not print\n", c.stderr)
        return: 1
    c.lmx_graph_close(g)
    c.lmx_arena_release(arena)
    c.free((cast: (@: void) arena))
    return: r
end: lm_graph_run_file

# `emit FILE OUT.lm1 native|forced`: the clean graph of FILE emitted as the L1 of a program (lm_graph_emit_program).
fn: lm_graph_emit_file (const: (@: path char); const: (@: out_path char); int: forced; int: check_root; int: runs) int
    @: arena c.LmxArena (cast: (@: c.LmxArena) c.calloc(1U, c.sizeof(c.LmxArena)))
    @: g c.LmxGraph 0
    @: root c.Lmx 0
    int: r 0
    if: arena = 0
        return: 1
    if: c.lmx_arena_open(arena) != 0
        c.fputs("graph: cannot open an arena\n", c.stderr)
        return: 1
    g := c.lmx_graph_open(arena)
    if: g = 0
        return: 1
    r := lm_graph_build_file(g, path, @ root)
    if: r != 0
        c.fprintf(c.stderr, "graph: build answered %d\n", r)
        return: r
    r := lm_graph_emit_program(g, root, out_path, forced, check_root, runs)
    if: r != 0
        c.fprintf(c.stderr, "graph: emit answered %d\n", r)
    c.lmx_graph_close(g)
    c.lmx_arena_release(arena)
    c.free((cast: (@: void) arena))
    return: r
end: lm_graph_emit_file

# `p0 FILE`: the P0 tree of FILE as the parser dumps it (the builder's input, for the record of a slice).  A file that
# does not parse prints the parser's diagnostic -- its number, line and column, as the P0 tests record them
# (tests/parser: `P0 parse error N at L:C`) -- and answers 2.
fn: lm_graph_p0_open (const: (@: path char); @@: out_document c.LmP0Document) int
    @: doc c.LmP0Document 0
    @: diag c.LmP0Diagnostic 0
    out_document[0] := 0
    if: c.lm_p0_parse_file(path, @ doc) != 0
        if: doc != 0
            diag := (cast: (@: c.LmP0Diagnostic) c.lm_p0_document_diagnostic(doc))
        ---
        if: diag != 0
            c.fprintf(c.stderr, "P0 parse error %d at %zu:%zu: %s\n", (cast: (int) (diag\code)), (cast: (size_t) (diag\line)), (cast: (size_t) (diag\column)), (cast: (@: char) (diag\message)))
        else:
            c.fprintf(c.stderr, "graph: %s: cannot read or parse\n", path)
        ---
        if: doc != 0
            c.lm_p0_document_destroy(doc)
        return: 2
    out_document[0] := doc
return: 0

fn: lm_graph_p0_file (const: (@: path char)) int
    @: doc c.LmP0Document 0
    @: dump char 0
    if: lm_graph_p0_open(path, @ doc) != 0
        return: 2
    dump := c.lm_p0_dump_alloc(doc)
    if: dump != 0
        c.fputs(dump, c.stdout)
        c.lm_p0_free((cast: (@: void) dump))
    ---
    c.lm_p0_document_destroy(doc)
return: 0

# M8 observes a written sole anonymous group without changing its boundary or
# guessing its head's semantic role. Mix payload is counted separately.
fn: lm_graph_groups_sole (@: body c.LmP0Structure) int
    @: only c.LmP0Field 0
    @: item c.LmP0Node 0
    if: body = 0 || body\field_count != 1U
        return: 0
    only := (cast: (@: c.LmP0Field) body\first_field)
    if: only = 0 || only\value = 0
        return: 0
    item := (cast: (@: c.LmP0Node) only\value)
    if: item\kind != c.LM_P0_NODE_STRUCTURE || item\as = 0 || item\as\structure = 0 || (item\flags & (c.LM_P0_NODE_INACTIVE | c.LM_P0_NODE_MIX | c.LM_P0_NODE_POSITIONAL_SKIP)) != 0U
        return: 0
return: (cast: (int) (item\as\structure\trailer = 0))

sub: lm_graph_groups_row (@: out c.FILE; @: path char; @: kind char; int: metadata; @: owner c.LmP0Node; @: head c.LmP0Text; unsigned: flags; @: count size_t)
    c.fprintf(out, "%s\t%s\t%d\t%zu\t%zu\t%zu\t%u\t", path, kind, metadata, (cast: (size_t) owner\span\offset), (cast: (size_t) owner\span\line), (cast: (size_t) owner\span\column), flags)
    lm_graph_emit_quoted_bytes(out, (cast: (@: char) head\data), (cast: (size_t) head\length), 1)
    c.fputc(10, out)
    count[0] := count[0] + 1U
return

sub: lm_graph_groups_trailer (@: out c.FILE; @: path char; @: owner c.LmP0Node; @: tail c.LmP0Trailer; int: metadata; @: count size_t)
    if: tail = 0
        return
    if: lm_graph_groups_sole((cast: (@: c.LmP0Structure) tail\body)) != 0
        lm_graph_groups_row(out, path, "trailer", metadata, owner, (cast: (@: c.LmP0Text) tail\spelling), (cast: (unsigned) tail\flags), count)
    lm_graph_groups_structure(out, path, (cast: (@: c.LmP0Structure) tail\body), metadata, count)
return

sub: lm_graph_groups_node (@: out c.FILE; @: path char; @: item c.LmP0Node; int: metadata; @: count size_t)
    if: item = 0
        return
    if: (item\flags & c.LM_P0_NODE_MIX) != 0U
        metadata := 1
    if: item\kind = c.LM_P0_NODE_FRAME && item\as != 0 && item\as\frame != 0
        @: frame c.LmP0Frame (cast: (@: c.LmP0Frame) item\as\frame)
        if: lm_graph_groups_sole((cast: (@: c.LmP0Structure) frame\body)) != 0
            lm_graph_groups_row(out, path, "frame", metadata, item, (cast: (@: c.LmP0Text) frame\head), (cast: (unsigned) frame\flags), count)
        lm_graph_groups_structure(out, path, (cast: (@: c.LmP0Structure) frame\body), metadata, count)
        lm_graph_groups_trailer(out, path, item, (cast: (@: c.LmP0Trailer) frame\trailer), metadata, count)
    if: item\kind = c.LM_P0_NODE_STRUCTURE && item\as != 0 && item\as\structure != 0
        @: structure c.LmP0Structure (cast: (@: c.LmP0Structure) item\as\structure)
        lm_graph_groups_structure(out, path, structure, metadata, count)
        lm_graph_groups_trailer(out, path, item, (cast: (@: c.LmP0Trailer) structure\trailer), metadata, count)
    if: item\marks != 0
        lm_graph_groups_structure(out, path, (cast: (@: c.LmP0Structure) item\marks), 1, count)
return

sub: lm_graph_groups_structure (@: out c.FILE; @: path char; @: structure c.LmP0Structure; int: metadata; @: count size_t)
    @: field c.LmP0Field 0
    if: structure != 0
        field := (cast: (@: c.LmP0Field) structure\first_field)
    while: field != 0
        lm_graph_groups_node(out, path, (cast: (@: c.LmP0Node) field\value), metadata, count)
        field := (cast: (@: c.LmP0Field) field\next)
return

fn: lm_graph_groups_read (const: (@: path char); @: count size_t) @: char
    @: file c.FILE c.fopen(path, "rb")
    c.LmP0FileScratch: scratch
    @: text char 0
    size_t: got 0U
    count[0] := 0U
    if: file = 0
        return: 0
    if: c.fseek(file, 0, c.SEEK_END) != 0
        c.fclose(file)
        return: 0
    scratch\file_size := c.ftell(file)
    if: scratch\file_size < 0 || c.fseek(file, 0, c.SEEK_SET) != 0
        c.fclose(file)
        return: 0
    count[0] := (cast: (size_t) scratch\file_size)
    text := (cast: (@: char) c.malloc(count[0] + 1U))
    if: text != 0
        got := c.fread(text, 1U, count[0], file)
        if: got != count[0]
            c.free(text)
            text := 0
    ---
    c.fclose(file)
    if: text != 0
        text[count[0]] := (cast: (char) 0)
return: text

# Relative paths come from the selected tracked-source list, not a filesystem traversal of build directories.
fn: lm_graph_groups_list (@: root char; @: list char; @: output char) int
    size_t: n 0U
    @: text char lm_graph_groups_read(list, @ n)
    @: file c.FILE 0
    @: full char 0
    @: doc c.LmP0Document 0
    size_t: root_length c.strlen(root)
    size_t: at 0U
    size_t: start 0U
    size_t: stop 0U
    size_t: files 0U
    size_t: groups 0U
    int: failed 0
    if: text = 0
        return: 2
    file := c.fopen(output, "rb")
    if: file != 0
        c.fclose(file)
        c.free(text)
        c.fprintf(c.stderr, "groups: output already exists: %s\n", output)
        return: 2
    file := c.fopen(output, "wb")
    if: file = 0
        c.free(text)
        return: 2
    c.fputs("# file\tkind\tmetadata\toffset\tline\tcolumn\tflags\thead\n", file)
    while: at < n
        start := at
        while: at < n && text[at] != 10 && text[at] != 13
            at := at + 1U
        stop := at
        if: at < n && text[at] = 13
            at := at + 1U
        if: at < n && text[at] = 10
            at := at + 1U
        text[stop] := (cast: (char) 0)
        if: stop > start && text[start] != 35
            files := files + 1U
            full := (cast: (@: char) c.malloc(root_length + 1U + stop - start + 1U))
            if: full = 0
                failed := failed + 1
            else:
                c.memcpy(full, root, root_length)
                full[root_length] := (cast: (char) 47)
                c.memcpy(full + root_length + 1U, text + start, stop - start + 1U)
                if: lm_graph_p0_open(full, @ doc) != 0
                    c.fprintf(c.stderr, "groups: %s\n", full)
                    failed := failed + 1
                else:
                    lm_graph_groups_node(file, text + start, (cast: (@: c.LmP0Node) c.lm_p0_document_root(doc)), 0, @ groups)
                    c.lm_p0_document_destroy(doc)
                    doc := 0
            ---
            c.free(full)
            full := 0
    ---
    if: files = 0 || c.ferror(file) != 0
        failed := failed + 1
    if: c.fclose(file) != 0
        failed := failed + 1
    c.free(text)
    c.printf("GROUP-REPORT %zu files, %zu groups, %d failed\n", files, groups, failed)
return: failed

# One line of the intern witness: INTERN-CHECK <what> PASS|FAIL. 0 for a pass, 1 for a failure.
fn: lm_graph_intern_report (const: (@: what char); int: ok) int
    if: ok != 0
        c.fprintf(c.stdout, "INTERN-CHECK %s PASS\n", what)
        return: 0
    c.fprintf(c.stdout, "INTERN-CHECK %s FAIL\n", what)
    return: 1
end: lm_graph_intern_report

# The spelling "s<i>" (i below 1000000), NUL-terminated, into buf of at least 12 bytes: the distinct spellings of the
# growth part of the intern witness.
sub: lm_graph_intern_spelling (@: buf char; int: i)
    int: k 1
    int: d 100000
    int: started 0
    int: digit 0
    buf[0] := (cast: (char) 115)
    while: d > 0
        digit := (i / d) % 10
        if: digit != 0 || started != 0 || d = 1
            buf[k] := (cast: (char) (48 + digit))
            k := k + 1
            started := 1
        ---
        d := d / 10
    ---
    buf[k] := (cast: (char) 0)
    return
end: lm_graph_intern_spelling

# `intern`: the witness of section 4 of the specification for this slice. One spelling is one address of the `text`
# region of the arena that owns the string state: the word x written in two live arenas is two word cells of two arenas
# holding one spelling address; that address is classified in the owner's region and in neither graph's arena; it does
# not move while the index grows through its first capacities (300 further spellings); a heap string is no spelling.
# 0 when every line passes, else 1.
fn: lm_graph_intern_check () int
    @: a1 c.LmxArena (cast: (@: c.LmxArena) c.calloc(1U, c.sizeof(c.LmxArena)))
    @: a2 c.LmxArena (cast: (@: c.LmxArena) c.calloc(1U, c.sizeof(c.LmxArena)))
    @: buf char (cast: (@: char) c.calloc(16U, 1U))
    @: g1 c.LmxGraph 0
    @: g2 c.LmxGraph 0
    @: w1 void 0
    @: w2 void 0
    @: t1 char 0
    @: t2 char 0
    @: first char 0
    @: again char 0
    int: i 0
    int: grown 1
    int: fails 0
    if: a1 = 0 || a2 = 0 || buf = 0
        return: 1
    if: c.lmx_arena_open(a1) != 0 || c.lmx_arena_open(a2) != 0
        c.fputs("graph: cannot open an arena\n", c.stderr)
        return: 1
    g1 := c.lmx_graph_open(a1)
    g2 := c.lmx_graph_open(a2)
    if: g1 = 0 || g2 = 0
        return: 1
    w1 := c.lmx_graph_word(g1, "x", 1U)
    w2 := c.lmx_graph_word(g2, "x", 1U)
    t1 := c.lmx_graph_word_text(g1, w1)
    t2 := c.lmx_graph_word_text(g2, w2)
    fails := fails + lm_graph_intern_report("two-word-cells", (cast: (int) (w1 != 0 && w2 != 0 && w1 != w2 && c.lmx_graph_kind(g1, w1) = 2 && c.lmx_graph_kind(g2, w2) = 2)))
    fails := fails + lm_graph_intern_report("one-spelling-address-from-two-arenas", (cast: (int) (t1 != 0 && t1 = t2 && c.strcmp(t1, "x") = 0)))
    fails := fails + lm_graph_intern_report("spelling-in-the-owner-text-region", c.lmx_graph_intern_owned(t1))
    fails := fails + lm_graph_intern_report("spelling-in-neither-graph-arena", (cast: (int) (c.lmx_graph_kind(g1, (cast: (@: void) t1)) = 0 && c.lmx_graph_kind(g2, (cast: (@: void) t1)) = 0)))
    fails := fails + lm_graph_intern_report("heap-string-is-no-spelling", (cast: (int) (c.lmx_graph_intern_owned(buf) = 0)))
    first := c.lmx_graph_intern("s0", 2U)
    while: i < 300
        lm_graph_intern_spelling(buf, i)
        if: c.lmx_graph_intern(buf, c.strlen(buf)) = 0
            grown := 0
        i := i + 1
    ---
    again := c.lmx_graph_intern("x", 1U)
    fails := fails + lm_graph_intern_report("index-grown-by-300-spellings", grown)
    fails := fails + lm_graph_intern_report("address-stable-after-growth", (cast: (int) (again = t1 && first != 0 && c.lmx_graph_intern("s0", 2U) = first && c.lmx_graph_intern("s299", 4U) != 0 && c.lmx_graph_intern_owned(c.lmx_graph_intern("s299", 4U)) != 0)))
    c.lmx_graph_close(g1)
    c.lmx_graph_close(g2)
    c.lmx_arena_release(a1)
    c.lmx_arena_release(a2)
    c.free((cast: (@: void) a1))
    c.free((cast: (@: void) a2))
    c.free((cast: (@: void) buf))
    if: fails != 0
        return: 1
    return: 0
end: lm_graph_intern_check

# A real native entry whose distinct answer proves that dispatch used the entry, not the walker.
fn: lm_graph_native_probe (@: owner void; @@: refs void; size_t: nargs; @: dest void; @@: out void; @: arena c.LmxArena; @: code c.Lmx; @: input c.LmxWalkValue; @: result c.LmxWalkValue) int
    return: 77
end: lm_graph_native_probe

fn: lm_graph_mutation_report (const: (@: what char); int: ok) int
    if: ok != 0
        c.printf("MUTATION-CHECK %s PASS\n", what)
        return: 0
    c.printf("MUTATION-CHECK %s FAIL\n", what)
    return: 1
end: lm_graph_mutation_report

# The data of a created function reaches, by a reference, a Structure C whose lexical parent P lies outside the written
# data (the review of 332R): the copy keeps that chain -- the copy of C has a copy of P for its parent, through the same
# map (kernel §6.4), never the source's mutable P and never none --, and the sources stay as they were.
fn: lm_graph_mutation_var_chain (@: g c.LmxGraph) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: outer c.Lmx 0
    @: inner c.Lmx 0
    @: written c.Lmx 0
    @: args c.Lmx 0
    @: body c.Lmx 0
    @: decl c.Lmx 0
    @: made c.Lmx 0
    @: vars c.Lmx 0
    @: copied c.Lmx 0
    @: held void 0
    @: kept void 0
    @: link void 0
    @: k void 0
    @: word void 0
    @: name char 0
    @: field char 0
    int: value 0
    int: status 5
    outer := c.lmx_graph_lmx(g, 0, 2U)
    inner := c.lmx_graph_lmx(g, outer, 1U)
    written := c.lmx_graph_lmx(g, 0, 1U)
    args := c.lmx_graph_lmx(g, 0, 0U)
    body := c.lmx_graph_lmx(g, 0, 0U)
    decl := c.lmx_graph_lmx(g, 0, 0U)
    k := c.lmx_graph_int(g, 7)
    if: state = 0 || outer = 0 || inner = 0 || written = 0 || args = 0 || body = 0 || decl = 0 || k = 0
        return: 1
    link := c.lmx_graph_ref_lmx(g, inner)
    if: link = 0 || c.lmx_graph_name(g, k, "k", 1U) != 0 || c.lmx_graph_name(g, (cast: (@: void) outer), "P", 1U) != 0 || c.lmx_graph_name(g, (cast: (@: void) inner), "C", 1U) != 0 || c.lmx_graph_name(g, link, "c", 1U) != 0
        return: 1
    if: c.lmx_graph_put(outer, 0U, k) != 0 || c.lmx_graph_put(outer, 1U, (cast: (@: void) inner)) != 0 || c.lmx_graph_put(inner, 0U, c.lmx_graph_word(g, "k", 1U)) != 0 || c.lmx_graph_put(written, 0U, link) != 0
        return: 1
    name := c.lmx_graph_intern("probe", 5U)
    field := c.lmx_graph_intern("k", 1U)
    word := c.lmx_graph_word(g, "int", 3U)
    if: name = 0 || field = 0 || word = 0
        return: 1
    status := c.lmx_graph_fn_make(g, decl, name, args, word, written, body, 1, @ made)
    if: status = 0
        vars := c.lmx_graph_method_data(g, made)
    if: vars != 0 && c.lmx_graph_count(vars) = 1U
        held := c.lmx_graph_get(vars, 0U)
        copied := (cast: (@: c.Lmx) c.lmx_graph_target(g, held))
    ---
    if: copied != 0 && copied\parent != 0
        kept := c.lmx_graph_field(g, (cast: (@: void) copied\parent), field)
    return: lm_graph_mutation_report("var-copy-keeps-the-lexical-chain-of-a-reached-structure", (cast: (int) (status = 0 && c.lmx_graph_kind(g, held) = 6 && copied != inner && copied\parent != 0 && copied\parent != outer && kept != k && c.lmx_graph_value_int(g, kept, @ value) = 0 && value = 7 && inner\parent = outer && c.lmx_graph_target(g, c.lmx_graph_get(written, 0U)) = (cast: (@: void) inner))))
end: lm_graph_mutation_var_chain

# Shared code, a data alias to its literal, and a cycle are ordinary Lmx slots. There is no retained reverse index.
fn: lm_graph_mutation_check () int
    @: arena c.LmxArena (cast: (@: c.LmxArena) c.calloc(1U, c.sizeof(c.LmxArena)))
    @: g c.LmxGraph 0
    @: scope c.Lmx 0
    @: a c.Lmx 0
    @: b c.Lmx 0
    @: data c.Lmx 0
    @: fresh c.Lmx 0
    @: statement c.Lmx 0
    @: expression c.Lmx 0
    @: x void 0
    @: literal void 0
    @: uninit void 0
    @: same_cell void 0
    @: plus void 0
    @: minus void 0
    int: value 0
    int: status 0
    int: fails 0
    if: arena = 0 || c.lmx_arena_open(arena) != 0
        return: 1
    g := c.lmx_graph_open(arena)
    scope := c.lmx_graph_lmx(g, 0, 5U)
    a := c.lmx_graph_lmx(g, scope, 2U)
    b := c.lmx_graph_lmx(g, scope, 2U)
    data := c.lmx_graph_lmx(g, scope, 1U)
    fresh := c.lmx_graph_lmx(g, scope, 1U)
    statement := c.lmx_graph_lmx(g, a, 1U)
    expression := c.lmx_graph_lmx(g, statement, 3U)
    x := c.lmx_graph_int(g, 5)
    literal := c.lmx_graph_int(g, 1)
    uninit := c.lmx_graph_uninit_int(g)
    plus := c.lmx_graph_word(g, "+", 1U)
    minus := c.lmx_graph_word(g, "-", 1U)
    if: scope = 0 || a = 0 || b = 0 || data = 0 || fresh = 0 || statement = 0 || expression = 0 || x = 0 || literal = 0 || uninit = 0 || plus = 0 || minus = 0
        return: 1
    if: c.lmx_graph_name(g, x, "x", 1U) != 0
        return: 1
    if: c.lmx_graph_put(scope, 0U, (cast: (@: void) a)) != 0 || c.lmx_graph_put(scope, 1U, (cast: (@: void) b)) != 0 || c.lmx_graph_put(scope, 2U, (cast: (@: void) data)) != 0 || c.lmx_graph_put(scope, 3U, (cast: (@: void) fresh)) != 0 || c.lmx_graph_put(scope, 4U, (cast: (@: void) scope)) != 0
        return: 1
    if: c.lmx_graph_put(a, 0U, x) != 0 || c.lmx_graph_put(a, 1U, (cast: (@: void) statement)) != 0 || c.lmx_graph_put(b, 0U, x) != 0 || c.lmx_graph_put(b, 1U, (cast: (@: void) statement)) != 0 || c.lmx_graph_put(data, 0U, literal) != 0 || c.lmx_graph_put(fresh, 0U, uninit) != 0
        return: 1
    if: c.lmx_graph_name(g, (cast: (@: void) statement), "x", 1U) != 0 || c.lmx_graph_put(statement, 0U, (cast: (@: void) expression)) != 0 || c.lmx_graph_put(expression, 0U, c.lmx_graph_word(g, "x", 1U)) != 0 || c.lmx_graph_put(expression, 1U, plus) != 0 || c.lmx_graph_put(expression, 2U, literal) != 0
        return: 1
    a\native := (cast: (c.LmxEntry) c.lm_graph_native_probe)
    b\native := (cast: (c.LmxEntry) c.lm_graph_native_probe)
    fresh\native := (cast: (c.LmxEntry) c.lm_graph_native_probe)
    same_cell := c.lmx_graph_place_cell(g, fresh, 0U)
    status := c.lmx_graph_assign_int(g, scope, fresh, 0U, 5)
    fails := fails + lm_graph_mutation_report("first-write-preserves-slot-pointer-cell-and-entry", (cast: (int) (status = 0 && c.lmx_graph_get(fresh, 0U) = uninit && c.lmx_graph_kind(g, uninit) = 3 && c.lmx_arena_pointer_void_read(uninit) = same_cell && c.lmx_graph_kind(g, same_cell) = 1 && fresh\native != 0 && c.lmx_graph_read_int(g, fresh, 0U, @ value) = 0 && value = 5)))
    status := c.lmx_graph_assign_int(g, scope, fresh, 0U, 7)
    fails := fails + lm_graph_mutation_report("later-write-preserves-slot-pointer-cell-and-entry", (cast: (int) (status = 0 && c.lmx_graph_get(fresh, 0U) = uninit && c.lmx_arena_pointer_void_read(uninit) = same_cell && fresh\native != 0 && c.lmx_graph_value_int(g, same_cell, @ value) = 0 && value = 7)))
    status := c.lmx_graph_assign_int(g, scope, a, 0U, 9)
    fails := fails + lm_graph_mutation_report("ordinary-data-write-preserves-both-entries", (cast: (int) (status = 0 && a\native != 0 && b\native != 0 && c.lmx_graph_read_int(g, b, 0U, @ value) = 0 && value = 9)))
    fails := fails + lm_graph_mutation_report("preserved-entry-is-dispatched", (cast: (int) (c.lmx_graph_call(g, a) = 77)))
    status := c.lmx_graph_write_slot(g, scope, expression, 1U, (cast: (@: void) (@ value)))
    fails := fails + lm_graph_mutation_report("foreign-value-refused-before-publication", (cast: (int) (status != 0 && c.lmx_graph_get(expression, 1U) = plus && a\native != 0 && b\native != 0)))
    status := c.lmx_graph_assign_int(g, scope, data, 0U, 7)
    fails := fails + lm_graph_mutation_report("literal-written-through-data-alias-clears-both", (cast: (int) (status = 0 && a\native = 0 && b\native = 0 && fresh\native != 0)))
    status := c.lmx_graph_call(g, a)
    fails := fails + lm_graph_mutation_report("fresh-walk-reads-updated-literal", (cast: (int) (status = 0 && c.lmx_graph_read_int(g, a, 0U, @ value) = 0 && value = 16)))
    status := c.lmx_graph_call(g, b)
    fails := fails + lm_graph_mutation_report("second-shared-code-walk", (cast: (int) (status = 0 && c.lmx_graph_read_int(g, b, 0U, @ value) = 0 && value = 23)))
    a\native := (cast: (c.LmxEntry) c.lm_graph_native_probe)
    b\native := (cast: (c.LmxEntry) c.lm_graph_native_probe)
    status := c.lmx_graph_write_slot(g, scope, expression, 1U, minus)
    fails := fails + lm_graph_mutation_report("operator-write-clears-both-not-unrelated-entry", (cast: (int) (status = 0 && a\native = 0 && b\native = 0 && fresh\native != 0)))
    status := c.lmx_graph_call(g, a)
    fails := fails + lm_graph_mutation_report("fresh-walk-reads-updated-operator", (cast: (int) (status = 0 && c.lmx_graph_read_int(g, a, 0U, @ value) = 0 && value = 16)))
    fails := fails + lm_graph_mutation_var_chain(g)
    fails := fails + lm_graph_mutation_report("activation-state-discarded", (cast: (int) (arena\activation = 0)))
    c.lmx_graph_close(g)
    c.lmx_arena_release(arena)
    c.free((cast: (@: void) arena))
    if: fails != 0
        return: 1
    return: 0
end: lm_graph_mutation_check

# Mutate the published Point/take witness through the same write API. The sentinel proves whether native survives;
# once code changes, invocation must execute the current body with a fresh activation and untouched formal slots.
fn: lm_graph_method_mutation (const: (@: path char)) int
    @: arena c.LmxArena (cast: (@: c.LmxArena) c.calloc(1U, c.sizeof(c.LmxArena)))
    @: g c.LmxGraph 0
    @: root c.Lmx 0
    @: point c.Lmx 0
    @: method c.Lmx 0
    @: args c.Lmx 0
    @: body c.Lmx 0
    @: statement c.Lmx 0
    @: expression c.Lmx 0
    @: product c.Lmx 0
    @: formal c.Lmx 0
    @: required void 0
    @@: values void (cast: (@@: void) c.calloc(2U, sizeof(@: void)))
    size_t: reached 0U
    int: status 0
    int: answer 0
    int: fails 0
    int: opened 0
    if: values = 0 || arena = 0 || c.lmx_arena_open(arena) != 0
        return: 1
    g := c.lmx_graph_open(arena)
    if: g = 0 || lm_graph_build_file(g, path, @ root) != 0
        return: 1
    # One traversal: the Structure the receiver fn creates for the declaration of take in its namespace, and the fields
    # of the root reached in order up to the call in r (lmx_graph_space_reach) -- Point answers there, as it does when
    # the traversal runs that call.
    if: c.lmx_graph_space_open(g, root, @ opened) != 0
        return: 1
    while: reached < c.lmx_graph_count(root)
        if: c.lmx_graph_space_reach(g, root, reached) < 0
            return: 1
        reached := reached + 1U
    point := (cast: (@: c.Lmx) c.lmx_graph_get(root, 0U))
    method := (cast: (@: c.Lmx) c.lmx_graph_target(g, c.lmx_graph_resolve(g, root, c.lmx_graph_intern("take", 4U))))
    if: c.lmx_graph_method(g, method) = 0
        return: 1
    args := c.lmx_graph_method_args(g, method)
    body := c.lmx_graph_method_code(g, method)
    statement := (cast: (@: c.Lmx) c.lmx_graph_get(body, 0U))
    expression := (cast: (@: c.Lmx) c.lmx_graph_get(statement, 0U))
    product := (cast: (@: c.Lmx) c.lmx_graph_get(expression, 0U))
    required := c.lmx_graph_get(args, 1U)
    method\native := (cast: (c.LmxEntry) c.lm_graph_native_probe)
    status := c.lmx_graph_assign_int(g, root, point, 0U, 3)
    fails := fails + lm_graph_mutation_report("method-data-write-preserves-entry", (cast: (int) (status = 0 && method\native != 0)))
    status := c.lmx_graph_admit(g, method, 0U, (cast: (@: void) point), @ values[0])
    status := status + c.lmx_graph_admit(g, method, 1U, c.lmx_graph_int(g, 1), @ values[1])
    if: status = 0
        status := c.lmx_graph_invoke(g, method, values, 2U, @ answer)
    fails := fails + lm_graph_mutation_report("method-preserved-native-is-dispatched", (cast: (int) (status = 77)))
    status := c.lmx_graph_assign_int(g, root, product, 2U, 20)
    fails := fails + lm_graph_mutation_report("method-body-literal-clears-entry", (cast: (int) (status = 0 && method\native = 0)))
    status := c.lmx_graph_invoke(g, method, values, 2U, @ answer)
    fails := fails + lm_graph_mutation_report("method-fresh-body-result61", (cast: (int) (status = 0 && answer = 61)))
    method\native := (cast: (c.LmxEntry) c.lm_graph_native_probe)
    status := c.lmx_graph_write_slot(g, root, expression, 1U, c.lmx_graph_word(g, "-", 1U))
    fails := fails + lm_graph_mutation_report("method-body-operator-clears-entry", (cast: (int) (status = 0 && method\native = 0)))
    status := c.lmx_graph_invoke(g, method, values, 2U, @ answer)
    fails := fails + lm_graph_mutation_report("method-next-body-result59", (cast: (int) (status = 0 && answer = 59)))
    method\native := (cast: (c.LmxEntry) c.lm_graph_native_probe)
    formal := (cast: (@: c.Lmx) c.lmx_graph_get(args, 0U))
    status := c.lmx_graph_write_slot(g, root, formal, 0U, c.lmx_graph_word(g, "Point", 5U))
    fails := fails + lm_graph_mutation_report("method-written-formal-clears-entry", (cast: (int) (status = 0 && method\native = 0)))
    fails := fails + lm_graph_mutation_report("method-formal-and-activation-lifetime", (cast: (int) (required = c.lmx_graph_get(args, 1U) && c.lmx_graph_kind(g, required) = 3 && arena\activation = 0)))
    c.lmx_graph_space_close(opened)
    c.free((cast: (@: void) values))
    c.lmx_graph_close(g)
    c.lmx_arena_release(arena)
    c.free((cast: (@: void) arena))
    return: (cast: (int) (fails != 0))
end: lm_graph_method_mutation

# The tool's commands: run, emit, emit-check, p0, intern, mutation, method-mutation. args[0] is the program, args[1]
# the command. The exit: 0 done, else the answer; 2 for a usage error.
fn: lm_graph_main (@@: args char; int: n) int
    int: forced 0
    int: check_root 0
    int: runs 1
    if: n >= 3 && c.strcmp(args[1], "method-mutation") = 0
        return: lm_graph_method_mutation(args[2])
    if: n >= 2 && c.strcmp(args[1], "mutation") = 0
        return: lm_graph_mutation_check()
    if: n >= 2 && c.strcmp(args[1], "intern") = 0
        return: lm_graph_intern_check()
    if: n >= 3 && c.strcmp(args[1], "run") = 0
        if: n >= 4
            runs := c.atoi(args[3])
        if: runs < 1
            return: 2
        return: lm_graph_run_file(args[2], runs)
    if: n >= 3 && c.strcmp(args[1], "p0") = 0
        return: lm_graph_p0_file(args[2])
    if: n = 5 && c.strcmp(args[1], "groups") = 0
        return: lm_graph_groups_list(args[2], args[3], args[4])
    if: n >= 5 && (c.strcmp(args[1], "emit") = 0 || c.strcmp(args[1], "emit-check") = 0)
        check_root := (cast: (int) (c.strcmp(args[1], "emit-check") = 0))
        if: c.strcmp(args[4], "forced") = 0
            forced := 1
        else:
            if: c.strcmp(args[4], "native") != 0
                c.fputs("graph_trans: emit takes native or forced\n", c.stderr)
                return: 2
            ---
        ---
        if: n >= 6
            runs := c.atoi(args[5])
        if: runs < 1
            return: 2
        return: lm_graph_emit_file(args[2], args[3], forced, check_root, runs)
    c.fputs("graph_trans: usage: run FILE [COUNT] | emit|emit-check FILE OUT.lm1 native|forced [COUNT] | p0 FILE | groups ROOT LIST NEW_OUT | intern\n", c.stderr)
    return: 2
end: lm_graph_main

# merge(operand; ...) in native code: each operand once, in order, by its own route -- the constructed value of a written
# anonymous Structure through the kernel's literal calls, a nested merge, any other operand address (a call included,
# applied once) -- then the one composition of the kernel (lmx_graph_merge_values), shared with the interpreter. A bare
# Frame describing a structure is refused at run time by the kernel's own predicate, with the interpreter's form answer.
# The emitted code computes no merge ahead of execution: the result is built when the code runs.
fn: lm_graph_emit_merge (@: g c.LmxGraph; @: f c.FILE; @: scope c.Lmx; @: expression c.Lmx; @: temps int; @@: decl_names char; @: decl_slots size_t; size_t: decl_n; @: temp int) int
    c.LmxGraphEmitScratch: leave_storage
    @: leave_failure char (cast: (@: char) leave_storage\failure)
    lm_graph_emit_leave_text(leave_failure, temps[1], 1)
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: raw void 0
    @: literal c.Lmx 0
    @: element c.Lmx 0
    size_t: n (cast: (size_t) c.lmx_graph_count(expression))
    size_t: j 0U
    size_t: i 0U
    size_t: at 0U
    int: ops temps[0]
    int: made 0
    int: value 0
    int: status 0
    temps[0] := temps[0] + 1
    c.fprintf(f, "        []: @(void) l2_ops%d %zuU\n", ops, n + 1U)
    while: j < n && status = 0
        raw := c.lmx_graph_get(expression, j)
        if: c.lmx_graph_merge_literal(g, scope, raw) != 0
            literal := (cast: (@: c.Lmx) raw)
            made := temps[0]
            temps[0] := temps[0] + 1
            c.fprintf(f, "        @: void l2_v%d 0\n        if: lmx_graph_merge_literal_open(l2_g, lmx_call_code, ", made)
            status := lm_graph_emit_address(g, f, scope, literal)
            c.fprintf(f, ", @ l2_v%d) != 0\n            %s\n", made, leave_failure)
            i := 0U
            while: i < c.lmx_graph_count(literal) && status = 0
                # A field of the literal: a place `int: name [literal]` is its own value (the literal cell) or none; a
                # Frame `int: name value` has its value second, a Frame `@: name int value` third
                # (lmx_graph_literal_field).
                value := -1
                if: c.lmx_graph_kind(g, c.lmx_graph_get(literal, i)) = 1
                    status := lm_graph_emit_operand(g, f, scope, literal, i, temps, decl_names, decl_slots, decl_n, @ value)
                ---
                if: c.lmx_graph_kind(g, c.lmx_graph_get(literal, i)) = 4
                    element := (cast: (@: c.Lmx) c.lmx_graph_get(literal, i))
                    at := 1U
                    if: c.lmx_graph_name_of(g, (cast: (@: void) element)) = state\w_at
                        at := 2U
                    ---
                    if: at < c.lmx_graph_count(element)
                        status := lm_graph_emit_operand(g, f, scope, element, at, temps, decl_names, decl_slots, decl_n, @ value)
                    ---
                ---
                if: status = 0
                    c.fputs("        if: lmx_graph_merge_literal_put(l2_g, ", f)
                    status := lm_graph_emit_address(g, f, scope, literal)
                    if: value < 0
                        c.fprintf(f, ", (cast: (@: Lmx) l2_v%d), %zuU, 0) != 0\n            %s\n", made, i, leave_failure)
                    else:
                        c.fprintf(f, ", (cast: (@: Lmx) l2_v%d), %zuU, l2_v%d) != 0\n            %s\n", made, i, value, leave_failure)
                    ---
                ---
                i := i + 1U
            ---
            value := made
        else:
            if: c.lmx_graph_merge_description(g, scope, raw) != 0
                value := temps[0]
                temps[0] := temps[0] + 1
                c.fprintf(f, "        @: void l2_v%d 0\n        if: lmx_graph_merge_description(l2_g, lmx_call_code, (cast: (@: void) ", value)
                status := lm_graph_emit_address(g, f, scope, (cast: (@: c.Lmx) raw))
                c.fprintf(f, ")) != 0\n            %s\n", leave_failure)
            else:
                status := lm_graph_emit_operand(g, f, scope, expression, j, temps, decl_names, decl_slots, decl_n, @ value)
            ---
        ---
        c.fprintf(f, "        l2_ops%d[%zuU]: l2_v%d\n", ops, j, value)
        j := j + 1U
    ---
    value := temps[0]
    temps[0] := temps[0] + 1
    c.fprintf(f, "        @: void l2_v%d 0\n        if: lmx_graph_merge_values(l2_g, l2_ops%d, %zuU, @ l2_v%d) != 0\n            %s\n", value, ops, n, value, leave_failure)
    temp[0] := value
    return: status
end: lm_graph_emit_merge

# 1 when name is a place of this native root that may hold a callable when the code runs (the emitter's declaration
# table, a table of its translation): a function a root application of fn or sub gives, or a reference place
# `@: name value` -- its target, a Structure or a callable, exists only then. The place itself is found then by the
# kernel's resolution. An int place and a reference to an int (`int: name value`, `@: name int value`) are never such.
fn: lm_graph_emit_defined (@: g c.LmxGraph; @: root c.Lmx; @@: decl_names char; @: decl_slots size_t; size_t: decl_n; @: name char) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: statement c.Lmx 0
    @: head char 0
    size_t: i 0U
    if: state = 0 || name = 0 || decl_names = 0 || decl_slots = 0
        return: 0
    while: i < decl_n
        if: decl_names[i] = name
            statement := (cast: (@: c.Lmx) c.lmx_graph_get(root, decl_slots[i]))
            # A function a root application of fn or sub creates when the code runs (lmx_graph_fn_apply).
            head := c.lmx_graph_name_of(g, (cast: (@: void) statement))
            if: head = state\w_fn || head = state\w_sub
                return: 1
            return: (cast: (int) (head = state\w_at && c.lmx_graph_count(statement) = 2U))
        i := i + 1U
    ---
    return: 0
end: lm_graph_emit_defined

# A statement whose head names a place known only when the code runs: when that place holds a callable, directly or
# through a reference to it, the statement applies it as the interpreter does (lmx_graph_exec_statement,
# lmx_graph_block) -- the common resolve/bind/invoke of lm_graph_emit_call --; when the head is an ordinary Structure
# the record launches there (lmx_graph_launch_head: through a reference place wherever the record stands, by the
# Structure's own name in code separated from its data; R21, R22), the record launches it -- the forms [] and [data]
# bound by the translation as by the interpreter (lmx_graph_launch_formals), the data an operand of a launch, the launch
# of the receiver call (lmx_graph_call_data); a record that gives no form is refused where it launches (5). Either
# reading jumps past the other reading of the statement, which the caller emits next and closes with the label in
# finish. 0, or the answer of an emission.
fn: lm_graph_emit_apply_or (@: g c.LmxGraph; @: f c.FILE; @: scope c.Lmx; @: statement c.Lmx; @: temps int; @@: decl_names char; @: decl_slots size_t; size_t: decl_n; @: finish int) int
    c.LmxGraphEmitScratch: leave_storage
    @: leave_failure char (cast: (@: char) leave_storage\failure)
    lm_graph_emit_leave_text(leave_failure, temps[1], 1)
    @@: formals char 0
    size_t: count c.lmx_graph_count(statement)
    int: other temps[0]
    int: structure 0
    int: data -1
    int: result 0
    int: status 0
    temps[0] := temps[0] + 4
    finish[0] := other + 1
    structure := other + 3
    c.fputs("        if: lmx_graph_method(l2_g, (cast: (@: Lmx) lmx_graph_target(l2_g, lmx_graph_resolve(l2_g, lmx_call_code, ", f)
    status := lm_graph_emit_head(g, f, scope, statement)
    c.fprintf(f, ")))) = 0\n            goto: l2_label%d\n", other)
    if: status = 0
        status := lm_graph_emit_call(g, f, scope, statement, temps, decl_names, decl_slots, decl_n, @ result)
    c.fprintf(f, "        goto: l2_label%d\n        l2_label%d:\n", other + 1, other)
    if: status = 0
        c.fprintf(f, "        @: void l2_v%d lmx_graph_launch_head(l2_g, lmx_call_code, ", structure)
        status := lm_graph_emit_head(g, f, scope, statement)
        c.fprintf(f, ")\n        if: l2_v%d = 0\n            goto: l2_label%d\n", structure, other + 2)
    ---
    if: status = 0
        formals := (cast: (@@: char) c.calloc(count + 1U, sizeof(@: char)))
        status := 4
        if: formals != 0
            status := c.lmx_graph_launch_formals(g, 0, statement, formals)
        if: status = 5
            status := 0
            c.fprintf(f, "        if: 1\n            %s\n", leave_failure)
        else:
            if: status = 0 && count = 1U
                status := lm_graph_emit_launch_operand(g, f, scope, statement, 0U, temps, decl_names, decl_slots, decl_n, @ data)
            if: status = 0 && data >= 0
                c.fprintf(f, "        if: lmx_graph_call_data(l2_g, (cast: (@: Lmx) l2_v%d), (cast: (@: Lmx) l2_v%d), 0) != 0\n            %s\n", data, structure, leave_failure)
            if: status = 0 && data < 0
                c.fprintf(f, "        if: lmx_graph_call_data(l2_g, 0, (cast: (@: Lmx) l2_v%d), 1) != 0\n            %s\n", structure, leave_failure)
        ---
        c.free((cast: (@: void) formals))
    ---
    c.fprintf(f, "        goto: l2_label%d\n        l2_label%d:\n", other + 1, other + 2)
    return: status
end: lm_graph_emit_apply_or

# 1 when name is a formal of the method code: a place of its activation, an int place in this subset
# (lmx_graph_call_shape), which a statement writes and never applies.
fn: lm_graph_emit_formal (@: g c.LmxGraph; @: code c.Lmx; @: name char) int
    @: args c.Lmx 0
    if: c.lmx_graph_method(g, code) = 0 || name = 0
        return: 0
    args := c.lmx_graph_method_args(g, code)
    return: (cast: (int) (c.lmx_graph_formal(g, args, name) < c.lmx_graph_count(args)))
end: lm_graph_emit_formal
