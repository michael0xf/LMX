predef: "l2src/lmx_walk.lm1"
predef: "l2src/lmx_pool.lm1"
predef: "l2src/lmx_arena.lm1"
predef: "l2src/lmx_arena_blocks.lm1"
predef: "l2src/lmx_implements.lm1"
predef: "l2src/lmx_chars_owned.lm1"
predef: "l2src/lmx_array_owned.lm1"
predef: "l2src/lmx_array_ref_owned.lm1"
predef: "l2src/lmx_graph_copy_owned.lm1"
predef: "l2src/lmx_value_owned.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdio.h>" "<stdlib.h>" "<string.h>"

# -188 k.2: SET writes the instance cell; cross-method AT M\x sees it.
# Mutant: write off-instance / working-copy-only -> M\x stays stale -> RED.

@: LmxArena ga 0
@: Lmx groles 0
@: LmxWalkContext gctx 0
@: LmxWalkValue gv 0
int: broken 0
int: checks 0
int: failures 0

sub: check (int: ok; const: @(char label))
    checks: checks + 1
    if: ok = 0
        failures: failures + 1
        c.printf("FAIL %s\n", label)
    ---
end: check

fn: fr (@: Lmx parent; size_t: slot; int: op; size_t: children) @: Lmx
    @: Lmx n lmx_walk_frame(ga, groles, parent, op, children)
    if: n = 0 || lmx_arena_ref_store(parent, slot, (cast: (@: void) n)) != 0
        broken: broken + 1
        return: 0
    ---
return: n

fn: pl (@: Lmx parent; size_t: slot; size_t: children) @: Lmx
    @: Lmx n lmx_walk_plain(ga, parent, children)
    if: n = 0 || lmx_arena_ref_store(parent, slot, (cast: (@: void) n)) != 0
        broken: broken + 1
        return: 0
    ---
return: n

sub: ref (@: Lmx code; size_t: slot; @: Lmx target)
    if: code = 0 || target = 0 || lmx_arena_ref_store(code, slot, (cast: (@: void) target)) != 0
        broken: broken + 1
    ---
end: ref

sub: sz (@: Lmx code; size_t: slot; size_t: value)
    if: code = 0 || lmx_walk_store_size(ga, code, slot, value) != c.LMX_WALK_OK
        broken: broken + 1
    ---
end: sz

fn: icell (@: Lmx holder; size_t: slot; int: value) @: void
    if: holder = 0 || lmx_walk_store_int(ga, holder, slot, value) != c.LMX_WALK_OK
        broken: broken + 1
        return: 0
    ---
return: lmx_arena_ref_value(holder, slot)

fn: lit (@: Lmx parent; size_t: slot; int: value) @: Lmx
    @: Lmx n fr(parent, slot, c.LMX_WALK_OP_LIT, 2U)
    if: n != 0 && lmx_walk_store_int(ga, n, 1U, value) != c.LMX_WALK_OK
        broken: broken + 1
    ---
return: n

fn: own (@: Lmx parent; size_t: slot; @: Lmx holder; size_t: index) @: Lmx
    @: Lmx n fr(parent, slot, c.LMX_WALK_OP_OWN, 3U)
    ref(n, 1U, holder)
    sz(n, 2U, index)
return: n

# k.4: a walked callable occurrence is just the ordinary body Structure -- no descriptor;
# `native` stays 0 by construction. `children` now counts body steps only, so every call
# site below shrinks by one and every stored slot index moves down by one.
fn: mk_m (@: Lmx unit; size_t: slot; size_t: children) @: Lmx
return: pl(unit, slot, children)

fn: go (@: Lmx m) int
    if: m = 0 || gctx = 0 || gv = 0
        return: c.LMX_WALK_INVALID
return: lmx_walk_run(gctx, m, 0, 0U, gv)

fn: main () int
    LmxArena: arena
    LmxArena: context_arena
    LmxPool: context_cells
    LmxScratch: store
    LmxWalkContext: context
    @: Lmx unit 0
    @: Lmx writer 0
    @: Lmx reader 0
    @: Lmx n 0
    @: Lmx e 0
    @: void xcell 0
    int: st 0
    int: r 0

    memset((cast: (@: void) (@ arena)), 0, c.sizeof(c.LmxArena))
    if: lmx_arena_open(@ arena) != 0
        return: 2
    ga: @ arena
    groles: lmx_walk_roles_open(ga)
    memset((cast: (@: void) (@ context_arena)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ context_cells)), 0, c.sizeof(c.LmxPool))
    memset((cast: (@: void) (@ store)), 0, c.sizeof(c.LmxScratch))
    if: lmx_arena_open(@ context_arena) != 0 || lmx_scratch_open(@ store, @ context_arena, @ context_cells, 16U) != c.LMX_SCRATCH_OK
        return: 2
    context.arena: ga
    context.scratch: @ store
    context.roles: groles
    context.immutable_profile: 0
    context.classified: 0U
    gctx: @ context
    gv: (cast: (@: LmxWalkValue) calloc(1U, c.sizeof(c.LmxWalkValue)))
    if: gv = 0 || groles = 0
        return: 2

    unit: lmx_node_new_owned(ga)
    if: unit = 0 || lmx_arena_refs_open_owned(ga, unit, 16U) != 0
        return: 2
    ---

    # writer: own x 0;  x: 7;  return: reader()
    # reader: return: writer\x
    # k.4: no descriptor slot -- writer's own field x moves to slot 0, SET to slot 1, RET
    # to slot 2; reader's RET to slot 0. CALL gains a 4th leading child (rtype); 0 here
    # since reader is walked, not native -- lmx_walk_call never reads rtype off that path.
    writer: mk_m(unit, 0U, 3U)
    reader: mk_m(unit, 1U, 1U)
    xcell: icell(writer, 0U, 0)
    n: fr(writer, 1U, c.LMX_WALK_OP_SET, 3U)
    own(n, 1U, writer, 0U)
    lit(n, 2U, 7)
    n: fr(writer, 2U, c.LMX_WALK_OP_RET, 2U)
    e: fr(n, 1U, c.LMX_WALK_OP_CALL, 4U)
    ref(e, 1U, reader)
    ref(e, 2U, reader)
    # rtype (child 3) left 0 -- reader is walked, not native, so lmx_walk_call never
    # reads it on that path; a fresh frame's slots are 0 until stored.
    n: fr(reader, 0U, c.LMX_WALK_OP_RET, 2U)
    e: fr(n, 1U, c.LMX_WALK_OP_AT, 3U)
    ref(e, 1U, writer)
    sz(e, 2U, 0U)

    check(broken = 0, "fixture built")
    st: go(writer)
    r: 0
    if: st = c.LMX_WALK_OK && gv\present != 0 && gv\ref != 0
        r: lmx_int_value_known(gv\ref)
    ---
    check(st = c.LMX_WALK_OK && r = 7, "reader AT writer\\x sees 7 after SET (mutant off-instance -> RED)")
    check(xcell != 0 && lmx_int_value_known(xcell) = 7, "writer cell x = 7 in graph (mutant working-copy-only -> RED)")

    if: failures != 0
        c.printf("%d/%d FAILED\n", failures, checks)
        return: 1
    ---
    c.printf("OK %d checks\n", checks)
return: 0
