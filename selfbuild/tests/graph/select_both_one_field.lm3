# §9.8: W and E fit one declaration with one formal: a one-field S whose field is a Structure is two
# candidates, ambiguity; opening is no longer only an attempt after W (TZ §9.3, the book #selection-examples).
(
    Observed:
        int: seen 0
)
@: shared data[0]
@: Model ()
fn: f (@: s Model) int
    shared\Observed\seen := 1
    return: 1
sub: main () (
    A(int: x 1)
    S(@: s A)
)
    f(S)
main()
