predef: "lmx_chars_owned.h.lm1"
predef: "l2src/lmx_pool.h.lm1"
include: "<stdlib.h>"

# The character table of a Message: 256 consecutive cells of the arena's array of char
# primitives, filled with 0..255.  Its cells are laid out once and addressed by value
# (14.7's settled half -- two fields holding the same character hold the same address, and
# assigning such a field changes the REFERENCE, never the cell).  The array is the arena's:
# the first table makes it with exactly the 256 cells asked for, and every later table
# takes 256 more cells of the SAME array -- one more interval of it, one more entry naming
# the same descriptor, never an array of its own.  The storage is the arena's, the
# descriptor says KIND_PRIMITIVE / CHAR, and the arena's index names that descriptor for
# every cell.
fn: lmx_chars_new_owned (@: LmxArena arena) @: char
    size_t: index 0U
    @: char table
    if: arena = 0
        return: 0
    table: (cast: (@: char) lmx_arena_take_n(arena, c.sizeof(c.char), c.LMX_KIND_PRIMITIVE, c.LMX_TYPE_CHAR, 256U))
    if: table = 0
        return: 0
    while: index < 256U
        table[index]: (cast: (char) index)
        index: index + 1U
    ---
return: table

fn: lmx_char_cell_known (@: char table; int: value) @: void
    if: table = 0 || value < 0 || value > 255
        return: 0
    return: (cast: (@: void) (table + value))

fn: lmx_char_rebind_known (@: void cell; int: value) @: void
    @: char byte (cast: (@: char) cell)
    int: previous
    if: cell = 0 || value < 0 || value > 255
        return: 0
    previous: (cast: (int) byte[0]) & 255
    return: (cast: (@: void) (byte - previous + value))
