# Plan M11 5v: the declarations of ordinary Structures live in the data part of main; the root holds places and the call main().
fn: choose (int: x) int
    if: x < 3
        return: 10
    else:
        return: 20
end: choose
fn: loops () int
    int: i 0
    int: sum 0
    while: 0
        return: 999
    while: i < 5
        i := i + 1
        if: i = 2
            continue()
        sum := sum + i
    for: (i := 0; i < 3; i := i + 1)
        sum := sum + 10
    return: sum
int: low choose(2)
int: high choose(3)
int: loop_result loops()
fn: mark () int (int: calls 0)
    calls := calls + 1
    return: calls
fn: short () int
    int: result 0
    if: 0 && mark()
        result := 100
    if: 1 || mark()
        result := result + 1
    if: mark() = 1 && mark() = 2
        result := result + 10
    return: result + (!0) + (3 >= 3) + (4 > 3) + (2 <= 3) + (1 != 2)
fn: jumps () int
    int: sum 0
    int: visits 0
    int: again 0
    for: (int: i 0; i < 5; i := i + 1)
        visits := visits + 1
        if: i = 1 && again = 0
            again := 1
            redo()
        if: i = 2
            continue()
        if: i = 3
            break()
        sum := sum + i + 1
    return: sum * 10 + visits
fn: inline_fields () int
    late := 9
    if: 0
        int: late 30
    while: 1
        if: late = 9
            return: late
    end: while
    return: 0
fn: nested_loops () int
    int: i 0
    int: sum 0
    while: i < 2
        int: j 0
        while: j < 3
            j := j + 1
            if: j = 2
                break
            sum := sum + 1
        i := i + 1
    return: sum * 10 + i
sub: main () (
    Code:
        while: x < 3 (x := x + 1)
        if: x = 3 (y := x * 10)
        else: (y := 99)
    Data:
        int: x 0
        int: y 0
)
    call: Data Code
int: short_result short()
int: call_count mark\data\calls
int: jump_result jumps()
int: visible_inline inline_fields()
int: nested_result nested_loops()
main()
int: data_x main\data\Data\x
int: data_result main\data\Data\y
int: root_loop 0
while: root_loop < 2
    root_loop := root_loop + 1
    mark()
if: root_loop = 2
    root_loop := 12
else:
    root_loop := 99
int: final_calls mark\data\calls
