        if: pi >= m_arity_cell[0][rw_mi_cell[0]] && c.lm_compiler_dyn_fwd(rw_mi_cell[0], pi - m_arity_cell[0][rw_mi_cell[0]]) != 0
            if: c.lm_compiler_hid_takes_absent(idx, k) != 0 || c.lm_compiler_own_lexical(idx, nm) < 0
                kind[0]: 1
                chosen[0]: pi
                return: 0
            ---
            kind[0]: 4
            chosen[0]: pi
            return: 0
        ---
        kind[0]: 5
        chosen[0]: pi
        return: 0
    ---
    if: pi >= 0 && rw_mi_cell[0] = e_cell[0]
        return: (cast: (int) (c.lm_compiler_rw_refuse(source_node, "a call of a method with dynamic inputs")))
    oi: c.lm_compiler_own_visible(rw_mi_cell[0], nm)
