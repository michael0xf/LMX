predef: "lmx_arena_refs.h.lm1"
predef: "l2src/lmx_pool.h.lm1"
include: "<stdlib.h>" "<limits.h>"

# The payload IS the void * child-pointer array of one Structure (ABI 3.3).  It is an
# array of the arena like every other -- "ЧЕМ МАССИВЫ ОТЛИЧАЮТСЯ ОТ ВСЕГО ОСТАЛЬНОГО?
# НИЧЕМ!!!" (Mikhail, 2026-09-17) -- so it has a descriptor and an entry in the arena's
# index, and a slot ADDRESS classifies as CHILDREN: a storage location, not the child
# stored in it.  What types a child is the child's own VALUE, classified on its own
# (SPEC 2: "The address of the pointer slot &children[i] is a storage location, not the
# address used to identify the child's type").  The structure's `data` holds the base;
# nothing else is stored anywhere to say what a slot is.  Slots start null; construction
# stores each child's typed address afterwards.
#
# This function is the CREATION step for this structure's child block, so it is the one
# that sets data and len: the count is given once, here, and never changes afterwards
# (SPEC 2, ABI 14.22).  There is no later writer of either field.
fn: lmx_arena_refs_open_owned (@: LmxArena arena; @: Lmx parent; size_t: children) int
    size_t: slot c.sizeof(@: void)
    size_t: bytes
    @: LmxPool array
    if: arena = 0 || parent = 0 || children = 0U
        return: 1
    if: parent\data != 0 || parent\len != 0
        return: 1
    # len is int: the child count must be representable (SPEC 2).
    if: children > (cast: (size_t) c.INT_MAX)
        return: 1
    if: children > ((cast: (size_t) -1) / slot)
        return: 1
    bytes: children * slot
    # The slot array is an array of the arena like every other: the arena allocates it,
    # owns it and classifies it (KIND_CHILDREN with TYPE_REFS), so this constructor
    # prepares no storage of its own and a refusal leaves the arena untouched.
    array: lmx_pool_make(arena, bytes, slot, c.LMX_KIND_CHILDREN, c.LMX_TYPE_REFS)
    if: array = 0
        return: 1
    ---
    parent\data: (cast: (@: void) lmx_chunk_data(array\head))
    parent\len: (cast: (int) children)
return: 0

# Slot address for a compiler-proven child index. Null only for a null
# parent/data or an out-of-range index; the slot's current value may itself be
# null before construction has stored a child.
fn: lmx_arena_ref_cell (@: Lmx parent; size_t: index) @@: void
    if: parent = 0 || parent\data = 0 || parent\len < 0
        return: 0
    if: index >= (cast: (size_t) parent\len)
        return: 0
    return: (cast: (@@: void) parent\data) + index

fn: lmx_arena_ref_value (@: Lmx parent; size_t: index) @: void
    @@: void slot lmx_arena_ref_cell(parent, index)
    if: slot = 0
        return: 0
    return: \slot

# Rebinds one child reference (ABI 14.22). The referenced object is not
# touched; the previous referent is neither freed nor retained here.
fn: lmx_arena_ref_store (@: Lmx parent; size_t: index; @: void value) int
    @@: void slot lmx_arena_ref_cell(parent, index)
    if: slot = 0
        return: 1
    \slot: value
    return: 0

fn: lmx_arena_ref_struct (@: Lmx parent; size_t: index) @: Lmx
    return: (cast: (@: Lmx) lmx_arena_ref_value(parent, index))
