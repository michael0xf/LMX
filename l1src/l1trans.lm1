predef: "l1src/parser.lm1"
predef: "l2src/l1_backend_text.h.lm1"
predef: "l2src/l1_backend_state_helpers.h.lm1"
include: "<stdio.h>" "<string.h>" "<stdlib.h>" "<limits.h>" "<errno.h>"
os:
    win:
        include: "<windows.h>" "<direct.h>"
        fn: l1_replace_file (const: @(char tmp); const: @(char out_path)) int
            if: c.MoveFileExA(tmp, out_path, 1U) = 0
                return: 1
        return: 0
        fn: l1_getcwd (@: char buffer; size_t: size) @: char
        return: c._getcwd(buffer, size)
        fn: l1_path_is_absolute (const: @(char path)) int
            if: path = 0 || path[0] = 0
                return: 0
            if: (path[0] = 47 || path[0] = 92) && (path[1] = 47 || path[1] = 92)
                return: 1
            if: path[1] = 58 && (path[2] = 47 || path[2] = 92)
                return: 1
        return: 0
    default:
        include: "<unistd.h>"
        fn: l1_replace_file (const: @(char tmp); const: @(char out_path)) int
            if: c.rename(tmp, out_path) != 0
                return: 1
        return: 0
        fn: l1_getcwd (@: char buffer; size_t: size) @: char
        return: c.getcwd(buffer, size)
        fn: l1_path_is_absolute (const: @(char path)) int
            if: path = 0 || path[0] = 0
                return: 0
        return: path[0] = 47
end: os

# Import tables hold existing LmP0Text array/string descriptors (length/data).
# Each descriptor owns exactly its path bytes plus the C boundary NUL.
import: "l1src/l1_backend_state.lm1"

prototype:
    fn: l1_unit_id_from_source (@: char dst; size_t: cap; const: @(char in_path); const: @(char path); const: @(LmP0Node node)) int
    fn: l1_hdr_include_path (@: char dst; size_t: cap; const: @(char in_path); const: @(LmP0Node node)) int
    fn: l1_hdr_register_path (const: @(char in_path); int: depth) int
    fn: l1_path_is_absolute (const: @(char path)) int
    fn: l1_getcwd (@: char buffer; size_t: size) @: char
    fn: l1_emit_define (@: FILE out; const: @(LmP0Frame frame); const: @(char path); const: @(LmP0Node owner); int: ifndef_default) int
    fn: l1_emit_fn (@: FILE out; const: @(LmP0Frame frame); const: @(char path); int: is_sub) int
    fn: l1_commit_temp (@: FILE out; const: @(char tmp); const: @(char out_path)) int
    fn: l1_emit_call_frame (@: FILE out; const: @(LmP0Frame frame); const: @(char path); const: @(LmP0Node node)) int
    fn: l1_emit_expr (@: FILE out; const: @(LmP0Structure body); const: @(char path); int: as_cond) int
    fn: l1_emit_assign_index (@: FILE out; const: @(char data); size_t: n; const: @(char path); const: @(LmP0Node node)) int
    fn: l1_emit_cast (@: FILE out; const: @(LmP0Structure body); const: @(char path)) int
    fn: l1_emit_arg_list (@: FILE out; const: @(LmP0Structure body); const: @(char path)) int
    fn: l1_emit_ifdef (@: FILE out; const: @(LmP0Frame frame); const: @(char path); int: as_stmt; int: depth; const: @(LmP0Node owner)) int
    fn: l1_emit_import (@: FILE out; const: @(LmP0Frame frame); const: @(char path); int: depth) int
    fn: l1_emit_item (@: FILE out; const: @(LmP0Node node); const: @(char path); int: in_l1; int: depth) int
    fn: l1_emit_stmt (@: FILE out; const: @(LmP0Node node); const: @(char path)) int
    fn: l1_emit_data_decl (@: FILE out; const: @(LmP0Node node); const: @(char path); int: force_const) int
    fn: l1_emit_extern_decl (@: FILE out; const: @(LmP0Frame frame); const: @(char path)) int
    fn: l1_emit_immutable (@: FILE out; const: @(LmP0Frame frame); const: @(char path); const: @(LmP0Node node)) int
    fn: l1_emit_repeat_scalar (@: FILE out; const: @(LmP0Text head); const: @(LmP0Structure body); const: @(char path); const: @(LmP0Node node); int: force_const) int
    fn: l1_emit_repeat_pointer (@: FILE out; const: @(LmP0Frame template); const: @(LmP0Structure body); const: @(char path); const: @(LmP0Node node); int: force_const) int
    fn: l1_emit_repeat_array (@: FILE out; const: @(LmP0Frame template); const: @(LmP0Structure body); const: @(char path); const: @(LmP0Node node); int: force_const) int
    fn: l1_emit_bracket_array (@: FILE out; const: @(LmP0Frame frame); const: @(char path); int: force_const) int
    fn: l1_emit_c_array (@: FILE out; const: @(LmP0Frame frame); const: @(char path); int: force_const) int
    fn: l1_emit_switch (@: FILE out; const: @(LmP0Frame frame); const: @(char path); const: @(LmP0Node node)) int
    fn: l1_emit_block (@: FILE out; const: @(LmP0Structure body); const: @(char path)) int
    fn: l1_emit_l1_body (@: FILE out; const: @(LmP0Structure body); const: @(char path); int: depth) int
    fn: l1_emit_implicit_l1 (@: FILE out; const: @(LmP0Node root); const: @(char path); int: depth) int
    fn: l1_emit_throw (@: FILE out; const: @(LmP0Frame frame); const: @(char path); const: @(LmP0Node node)) int
    fn: l1_emit_catch (@: FILE out; const: @(LmP0Frame frame); const: @(char path); const: @(LmP0Node node)) int
    fn: l1_emit_throw_dispatch (@: FILE out; const: @(LmP0Text name); const: @(char path); const: @(LmP0Node node)) int
    fn: l1_emit_finallies (@: FILE out; const: @(char path); int: until_depth) int
end: prototype

import: "l2src/l1_backend_text.lm1"
import: "l2src/l1_backend_state_helpers.lm1"


















fn: l1_commit_temp (@: FILE out; const: @(char tmp); const: @(char out_path)) int
    if: out != 0 && c.fclose(out) != 0
        c.remove(tmp)
        c.fprintf(c.stderr, "l1trans error: cannot write %s\n", out_path)
        return: 1
    if: l1_replace_file(tmp, out_path) != 0
        c.remove(tmp)
        c.fprintf(c.stderr, "l1trans error: cannot write %s\n", out_path)
        return: 1
return: 0





fn: l1_emit_call_frame (@: FILE out; const: @(LmP0Frame frame); const: @(char path); const: @(LmP0Node node)) int
    size_t: deref
    size_t: slash
    int: deref_call_wrap 0
    const: @: LmP0Text head
    if: frame = 0
        return: 1
    head: frame\head
    if: l1_fn_is_throwing(head) != 0
        if: l1_throw_ok = 0
            return: l1_error(path, node, "throwing call must be a statement or the entire assignment")
        l1_throw_ok: 0
    ---
    deref: l1_slash_prefix_len(head)
    if: deref = 0U
        if: l1_c_ident(out, head, path, node) != 0
            return: 1
        ---
    else:
        slash: deref
        while: slash < head\length && head\data[slash] != 92
            slash: slash + 1U
        if: slash < head\length
            if: l1_emit_prefixed_path(out, head, deref, path, node) != 0
                return: 1
            ---
        else:
            if: deref = head\length
                return: l1_error(path, node, "prefix dereference expects an operand")
            if: l1_emit_stars(out, deref) != 0 || l1_write_cstr(out, "(") != 0
                return: 1
            if: l1_c_ident_from(out, head, deref, path, node) != 0
                return: 1
            deref_call_wrap: 1
        ---
    ---
    if: l1_write_cstr(out, "(") != 0
        return: 1
    if: l1_emit_arg_list(out, frame\body, path) != 0
        return: 1
    if: l1_write_cstr(out, ")") != 0
        return: 1
    if: deref_call_wrap != 0
        return: l1_write_cstr(out, ")")
return: 0

fn: l1_emit_assign_index (@: FILE out; const: @(char data); size_t: n; const: @(char path); const: @(LmP0Node node)) int
    @: LmP0Document document 0
    const: @: LmP0Node root
    int: status
    if: data = 0 || n = 0U
        return: l1_error(path, node, "assignment target index must not be empty")
    status: lm_p0_parse_bytes(data, n, @ document)
    if: status != 0 || document = 0
        if: document != 0
            lm_p0_document_destroy(document)
        return: l1_error(path, node, "assignment target index parse failed")
    root: lm_p0_document_root(document)
    if: root = 0 || root\kind != c.LM_P0_NODE_STRUCTURE || root\as = 0 || root\as\structure = 0 || root\as\structure\first_field = 0
        lm_p0_document_destroy(document)
        return: l1_error(path, node, "assignment target index must not be empty")
    status: l1_emit_expr(out, root\as\structure, path, 0)
    lm_p0_document_destroy(document)
return: status

fn: l1_emit_assign_head (@: FILE out; const: @(LmP0Text head); const: @(char path); const: @(LmP0Node node)) int
    size_t: start 0U
    size_t: deref 0U
    size_t: root_start
    size_t: root_end
    size_t: i
    size_t: close_index
    size_t: field_end
    size_t: c_prefix 0U
    size_t: name_start
    size_t: name_end
    if: out = 0 || head = 0 || head\data = 0
        return: 1
    while: c_prefix < head\length && head\data[c_prefix] = 92
        c_prefix: c_prefix + 1U
    if: c_prefix + 2U <= head\length && head\data[c_prefix] = 99 && head\data[c_prefix + 1U] = 46
        start: c_prefix + 2U
    if: start != 0U
        if: c_prefix != 0U && (l1_write_cstr(out, "(") != 0 || l1_emit_stars(out, c_prefix) != 0)
            return: 1
        i: start
        while: i < head\length
            if: head\data[i] = 91
                if: l1_assign_index_close(head, i, @ close_index) = 0
                    return: l1_error(path, node, "unclosed index in assignment target")
                if: l1_write_cstr(out, "[") != 0 || l1_emit_assign_index(out, head\data + i + 1U, close_index - i - 1U, path, node) != 0 || l1_write_cstr(out, "]") != 0
                    return: 1
                i: close_index + 1U
                continue
            if: head\data[i] = 92
                if: l1_write_cstr(out, "->") != 0
                    return: 1
                ---
            else:
                if: l1_write_span(out, head\data + i, 1U) != 0
                    return: 1
                ---
            i: i + 1U
        if: c_prefix != 0U && l1_write_cstr(out, ")") != 0
            return: 1
        return: 0
    ---
    while: start + deref < head\length && head\data[start + deref] = 92
        deref: deref + 1U
    root_start: start + deref
    root_end: root_start
    while: root_end < head\length && head\data[root_end] != 92 && head\data[root_end] != 91
        root_end: root_end + 1U
    if: root_end = root_start
        return: l1_error(path, node, "dereferenced assignment target expects a name")
    # A quoted root name is quoted exactly so that it may BE a reserved word,
    # and the quotes are not part of the C identifier. The whole-text rule in
    # l1_c_ident_from does not reach here: this root is a span inside a head
    # that may continue with a field follow or an index, so the continuation
    # position stays root_end while only the written span loses its quotes.
    name_start: root_start
    name_end: root_end
    if: root_end - root_start >= 2U && head\data[root_start] = 96 && head\data[root_end - 1U] = 96
        name_start: root_start + 1U
        name_end: root_end - 1U
    else:
        if: l1_span_is_reserved(head\data, root_start, root_end - root_start) != 0
            return: l1_error(path, node, "reserved L1 name")
        ---
    ---
    if: deref != 0U
        if: l1_write_cstr(out, "(") != 0 || l1_emit_stars(out, deref) != 0
            return: 1
        ---
    ---
    if: l1_write_span(out, head\data + name_start, name_end - name_start) != 0
        return: 1
    if: deref != 0U && l1_write_cstr(out, ")") != 0
        return: 1
    i: root_end
    while: i < head\length
        if: head\data[i] = 91
            if: l1_assign_index_close(head, i, @ close_index) = 0
                return: l1_error(path, node, "unclosed index in assignment target")
            if: l1_write_cstr(out, "[") != 0
                return: 1
            if: l1_emit_assign_index(out, head\data + i + 1U, close_index - i - 1U, path, node) != 0
                return: 1
            if: l1_write_cstr(out, "]") != 0
                return: 1
            ---
            i: close_index + 1U
            continue
        ---
        if: head\data[i] != 92
            return: l1_error(path, node, "malformed assignment target")
        if: l1_write_cstr(out, "->") != 0
            return: 1
        i: i + 1U
        field_end: i
        while: field_end < head\length && head\data[field_end] != 92 && head\data[field_end] != 91
            field_end: field_end + 1U
        if: field_end = i
            return: l1_error(path, node, "field-follow missing name")
        if: l1_span_is_reserved(head\data, i, field_end - i) != 0
            return: l1_error(path, node, "reserved L1 name")
        if: l1_write_span(out, head\data + i, field_end - i) != 0
            return: 1
        i: field_end
return: 0

fn: l1_emit_expr (@: FILE out; const: @(LmP0Structure body); const: @(char path); int: as_cond) int
    @: LmP0Field field
    const: @: LmP0Node node
    const: @: LmP0Node next_node
    const: @: LmP0Node prev_node 0
    int: first 1
    int: after_operand 0
    int: deref_wrap 0
    int: skip_space 0
    if: out = 0
        return: 1
    if: body = 0
        return: 0
    field: body\first_field
    while: field != 0
        node: field\value
        if: l1_node_ignored(node) = 0
            if: after_operand != 0
                while: deref_wrap != 0
                    if: l1_write_cstr(out, ")") != 0
                        return: 1
                    deref_wrap: deref_wrap - 1
                ---
            ---
            if: first = 0
                if: prev_node != 0 && node != 0 && prev_node\kind = c.LM_P0_NODE_ATOM && node\kind = c.LM_P0_NODE_ATOM && l1_nodes_adjacent(prev_node, node) && l1_glue_pair(prev_node\as\atom, node\as\atom)
                    if: l1_write_text(out, node\as\atom) != 0
                        return: 1
                    ---
                    prev_node: node
                    first: 0
                    field: field\next
                    continue
                ---
                skip_space: 0
                if: node != 0 && node\kind = c.LM_P0_NODE_ATOM
                    if: l1_text_eq(node\as\atom, "[") || l1_text_eq(node\as\atom, "]")
                        skip_space: 1
                    ---
                    if: l1_is_incdec_atom(node\as\atom) && after_operand != 0
                        skip_space: 1
                    ---
                ---
                if: prev_node != 0 && prev_node\kind = c.LM_P0_NODE_ATOM
                    if: l1_text_eq(prev_node\as\atom, "[")
                        skip_space: 1
                    ---
                    if: l1_is_incdec_atom(prev_node\as\atom) && node != 0 && node\kind = c.LM_P0_NODE_ATOM
                        if: l1_is_infix_atom(node\as\atom) = 0 && l1_is_unary_prefix_atom(node\as\atom) = 0 && l1_is_incdec_atom(node\as\atom) = 0 && l1_text_eq(node\as\atom, "\\") = 0 && l1_text_eq(node\as\atom, "[") = 0 && l1_text_eq(node\as\atom, "]") = 0
                            skip_space: 1
                        ---
                    ---
                ---
                if: skip_space = 0
                    if: l1_write_cstr(out, " ") != 0
                        return: 1
                    ---
                ---
            ---
            first: 0
            if: node = 0
                return: l1_error(path, 0, "empty expression field")
            if: node\kind = c.LM_P0_NODE_ATOM
                next_node: 0
                if: field\next != 0
                    next_node: field\next\value
                ---
                if: l1_atom_is_raw_string(node)
                    if: l1_emit_atom_node(out, node, path) != 0
                        return: 1
                    after_operand: 1
                    prev_node: node
                    field: field\next
                    continue
                ---
                if: l1_text_eq(node\as\atom, "\\")
                    if: after_operand != 0 && prev_node != 0 && l1_nodes_adjacent(prev_node, node) != 0
                        if: l1_write_cstr(out, "->") != 0
                            return: 1
                        ---
                    else:
                        if: l1_write_cstr(out, "(*") != 0
                            return: 1
                        deref_wrap: deref_wrap + 1
                        after_operand: 0
                        ---
                    ---
                else:
                    if: l1_text_eq(node\as\atom, "[")
                        if: l1_write_cstr(out, "[") != 0
                            return: 1
                        after_operand: 0
                    else:
                        if: l1_text_eq(node\as\atom, "]")
                            if: l1_write_cstr(out, "]") != 0
                                return: 1
                            after_operand: 1
                        else:
                            if: l1_is_incdec_atom(node\as\atom)
                                if: l1_write_text(out, node\as\atom) != 0
                                    return: 1
                                ---
                            else:
                                if: l1_text_eq(node\as\atom, "=") && (next_node = 0 || next_node\kind != c.LM_P0_NODE_ATOM || l1_nodes_adjacent(node, next_node) = 0 || l1_text_eq(next_node\as\atom, "=") = 0)
                                    if: l1_write_cstr(out, "==") != 0
                                        return: 1
                                    after_operand: 0
                                else:
                                    if: l1_emit_atom_node(out, node, path) != 0
                                        return: 1
                                    if: l1_is_infix_atom(node\as\atom) || l1_is_unary_prefix_atom(node\as\atom)
                                        after_operand: 0
                                    else:
                                        after_operand: 1
                                    ---
                                ---
                            ---
                        ---
                    ---
                ---
                prev_node: node
            else:
                if: node\kind = c.LM_P0_NODE_FRAME
                    prev_node: node
                    after_operand: 1
                    if: l1_text_eq(node\as\frame\head, "cast")
                        if: l1_emit_cast(out, node\as\frame\body, path) != 0
                            return: 1
                        ---
                    else:
                        if: l1_emit_call_frame(out, node\as\frame, path, node) != 0
                            return: 1
                    ---
                else:
                    if: node\kind = c.LM_P0_NODE_STRUCTURE
                        prev_node: node
                        after_operand: 1
                        if: l1_write_cstr(out, "(") != 0
                            return: 1
                        if: l1_emit_expr(out, node\as\structure, path, as_cond) != 0
                            return: 1
                        if: l1_write_cstr(out, ")") != 0
                            return: 1
                        ---
                    else:
                        return: l1_error(path, node, "unsupported expression node")
        ---
        field: field\next
    while: deref_wrap != 0
        if: l1_write_cstr(out, ")") != 0
            return: 1
        deref_wrap: deref_wrap - 1
return: 0

fn: l1_emit_expr_range (@: FILE out; @: LmP0Field start; @: LmP0Field stop; const: @(char path); int: as_cond) int
    @: LmP0Field field
    const: @: LmP0Node node
    const: @: LmP0Node next_node
    const: @: LmP0Node prev_node 0
    int: first 1
    int: after_operand 0
    int: deref_wrap 0
    int: skip_space 0
    field: start
    while: field != 0 && field != stop
        node: field\value
        if: l1_node_ignored(node) = 0
            if: after_operand != 0
                while: deref_wrap != 0
                    if: l1_write_cstr(out, ")") != 0
                        return: 1
                    deref_wrap: deref_wrap - 1
                ---
            ---
            if: first = 0
                if: prev_node != 0 && node != 0 && prev_node\kind = c.LM_P0_NODE_ATOM && node\kind = c.LM_P0_NODE_ATOM && l1_nodes_adjacent(prev_node, node) && l1_glue_pair(prev_node\as\atom, node\as\atom)
                    if: l1_write_text(out, node\as\atom) != 0
                        return: 1
                    ---
                    prev_node: node
                    first: 0
                    field: field\next
                    continue
                ---
                skip_space: 0
                if: node != 0 && node\kind = c.LM_P0_NODE_ATOM
                    if: l1_text_eq(node\as\atom, "[") || l1_text_eq(node\as\atom, "]")
                        skip_space: 1
                    ---
                    if: l1_is_incdec_atom(node\as\atom) && after_operand != 0
                        skip_space: 1
                    ---
                ---
                if: prev_node != 0 && prev_node\kind = c.LM_P0_NODE_ATOM
                    if: l1_text_eq(prev_node\as\atom, "[")
                        skip_space: 1
                    ---
                    if: l1_is_incdec_atom(prev_node\as\atom) && node != 0 && node\kind = c.LM_P0_NODE_ATOM
                        if: l1_is_infix_atom(node\as\atom) = 0 && l1_is_unary_prefix_atom(node\as\atom) = 0 && l1_is_incdec_atom(node\as\atom) = 0 && l1_text_eq(node\as\atom, "\\") = 0 && l1_text_eq(node\as\atom, "[") = 0 && l1_text_eq(node\as\atom, "]") = 0
                            skip_space: 1
                        ---
                    ---
                ---
                if: skip_space = 0
                    if: l1_write_cstr(out, " ") != 0
                        return: 1
                    ---
                ---
            ---
            first: 0
            if: node = 0
                return: l1_error(path, 0, "empty expression field")
            if: node\kind = c.LM_P0_NODE_ATOM
                next_node: 0
                if: field\next != 0 && field\next != stop
                    next_node: field\next\value
                ---
                if: l1_atom_is_raw_string(node)
                    if: l1_emit_atom_node(out, node, path) != 0
                        return: 1
                    after_operand: 1
                    prev_node: node
                    field: field\next
                    continue
                ---
                if: l1_text_eq(node\as\atom, "\\")
                    if: after_operand != 0 && prev_node != 0 && l1_nodes_adjacent(prev_node, node) != 0
                        if: l1_write_cstr(out, "->") != 0
                            return: 1
                        ---
                    else:
                        if: l1_write_cstr(out, "(*") != 0
                            return: 1
                        deref_wrap: deref_wrap + 1
                        after_operand: 0
                        ---
                    ---
                else:
                    if: l1_text_eq(node\as\atom, "[")
                        if: l1_write_cstr(out, "[") != 0
                            return: 1
                        after_operand: 0
                    else:
                        if: l1_text_eq(node\as\atom, "]")
                            if: l1_write_cstr(out, "]") != 0
                                return: 1
                            after_operand: 1
                        else:
                            if: l1_is_incdec_atom(node\as\atom)
                                if: l1_write_text(out, node\as\atom) != 0
                                    return: 1
                                ---
                            else:
                                if: l1_text_eq(node\as\atom, "=") && (next_node = 0 || next_node\kind != c.LM_P0_NODE_ATOM || l1_nodes_adjacent(node, next_node) = 0 || l1_text_eq(next_node\as\atom, "=") = 0)
                                    if: l1_write_cstr(out, "==") != 0
                                        return: 1
                                    after_operand: 0
                                else:
                                    if: l1_emit_atom_node(out, node, path) != 0
                                        return: 1
                                    if: l1_is_infix_atom(node\as\atom) || l1_is_unary_prefix_atom(node\as\atom)
                                        after_operand: 0
                                    else:
                                        after_operand: 1
                                    ---
                                ---
                            ---
                        ---
                    ---
                ---
                prev_node: node
            else:
                if: node\kind = c.LM_P0_NODE_FRAME
                    prev_node: node
                    after_operand: 1
                    if: l1_text_eq(node\as\frame\head, "cast")
                        if: l1_emit_cast(out, node\as\frame\body, path) != 0
                            return: 1
                        ---
                    else:
                        if: l1_emit_call_frame(out, node\as\frame, path, node) != 0
                            return: 1
                    ---
                else:
                    if: node\kind = c.LM_P0_NODE_STRUCTURE
                        prev_node: node
                        after_operand: 1
                        if: l1_write_cstr(out, "(") != 0
                            return: 1
                        if: l1_emit_expr(out, node\as\structure, path, as_cond) != 0
                            return: 1
                        if: l1_write_cstr(out, ")") != 0
                            return: 1
                        ---
                    else:
                        return: l1_error(path, node, "unsupported expression node")
        ---
        field: field\next
    while: deref_wrap != 0
        if: l1_write_cstr(out, ")") != 0
            return: 1
        deref_wrap: deref_wrap - 1
return: 0

fn: l1_emit_cast (@: FILE out; const: @(LmP0Structure body); const: @(char path)) int
    @: LmP0Field field
    @: LmP0Field inner
    if: body = 0
        return: l1_error(path, 0, "cast missing type")
    field: body\first_field
    while: field != 0 && l1_node_ignored(field\value)
        field: field\next
    if: field = 0 || field\value = 0
        return: l1_error(path, 0, "cast missing type")
    if: l1_write_cstr(out, "((") != 0
        return: 1
    if: field\value\kind = c.LM_P0_NODE_STRUCTURE
        inner: field\value\as\structure\first_field
        while: inner != 0 && l1_node_ignored(inner\value)
            inner: inner\next
        if: inner = 0 || inner\value = 0
            return: l1_error(path, field\value, "cast missing type")
        if: l1_emit_type_token(out, inner\value, path) != 0
            return: 1
        inner: inner\next
        while: inner != 0 && l1_node_ignored(inner\value)
            inner: inner\next
        while: inner != 0 && inner\value != 0 && inner\value\kind = c.LM_P0_NODE_ATOM && l1_is_type_name(inner\value\as\atom)
            if: l1_write_cstr(out, " ") != 0
                return: 1
            if: l1_write_type_spelling(out, inner\value\as\atom, path, inner\value) != 0
                return: 1
            inner: inner\next
            while: inner != 0 && l1_node_ignored(inner\value)
                inner: inner\next
            ---
        ---
        if: l1_write_cstr(out, ")") != 0
            return: 1
        if: inner != 0
            if: l1_emit_expr_range(out, inner, 0, path, 0) != 0
                return: 1
            ---
        ---
    else:
        if: l1_emit_type_token(out, field\value, path) != 0
            return: 1
        if: l1_write_cstr(out, ")") != 0
            return: 1
        if: field\value\kind = c.LM_P0_NODE_FRAME && l1_text_eq(field\value\as\frame\head, "const") = 0 && l1_pointer_depth(field\value\as\frame\head) = 0U && l1_is_type_name(field\value\as\frame\head)
            if: field\value\as\frame\body != 0
                if: l1_emit_expr(out, field\value\as\frame\body, path, 0) != 0
                    return: 1
                ---
            ---
        ---
    ---
    field: field\next
    while: field != 0 && l1_node_ignored(field\value)
        field: field\next
    if: field != 0
        if: l1_emit_expr_range(out, field, 0, path, 0) != 0
            return: 1
        ---
    ---
return: l1_write_cstr(out, ")")


fn: l1_emit_one_expr (@: FILE out; @@: LmP0Field cursor; @: LmP0Field stop; const: @(char path)) int
    @: LmP0Field field
    @: LmP0Field next
    const: @: LmP0Node node
    const: @: LmP0Node next_node
    const: @: LmP0Node prior_node 0
    int: infix 0
    int: deref_wrap 0
    int: had_prefix 0
    field: l1_active_field(cursor[0], stop)
    if: field = 0 || field\value = 0
        return: l1_error(path, 0, "empty expression")
    node: field\value
    while: node != 0 && node\kind = c.LM_P0_NODE_ATOM
        if: l1_text_eq(node\as\atom, "\\")
            if: l1_write_cstr(out, "(") != 0
                return: 1
            while: field != 0 && field\value != 0 && field\value\kind = c.LM_P0_NODE_ATOM && l1_text_eq(field\value\as\atom, "\\")
                if: l1_write_cstr(out, "*") != 0
                    return: 1
                field: l1_active_field(field\next, stop)
            if: field = 0 || field\value = 0
                return: l1_error(path, node, "prefix dereference expects an operand")
            deref_wrap: deref_wrap + 1
            had_prefix: 1
            node: field\value
            continue
        ---
        if: l1_is_incdec_atom(node\as\atom)
            if: had_prefix != 0
                if: l1_write_cstr(out, " ") != 0
                    return: 1
                ---
            ---
            if: l1_write_text(out, node\as\atom) != 0
                return: 1
            had_prefix: 1
            field: l1_active_field(field\next, stop)
            if: field = 0 || field\value = 0
                return: l1_error(path, node, "unary operator expects an operand")
            node: field\value
            continue
        ---
        if: l1_text_eq(node\as\atom, "!") || l1_text_eq(node\as\atom, "~") || l1_text_eq(node\as\atom, "@") || l1_text_eq(node\as\atom, "-") || l1_text_eq(node\as\atom, "+") || l1_text_eq(node\as\atom, "*")
            if: l1_text_eq(node\as\atom, "@")
                if: l1_write_cstr(out, "&") != 0
                    return: 1
                ---
            else:
                if: l1_c_ident(out, node\as\atom, path, node) != 0
                    return: 1
                ---
            ---
            had_prefix: 1
            field: l1_active_field(field\next, stop)
            if: field = 0 || field\value = 0
                return: l1_error(path, node, "unary operator expects an operand")
            node: field\value
            continue
        ---
        break
    ---
    if: node\kind = c.LM_P0_NODE_ATOM
        if: l1_atom_is_raw_string(node)
            if: l1_emit_atom_node(out, node, path) != 0
                return: 1
            ---
        else:
            if: l1_text_eq(node\as\atom, "=")
                if: l1_write_cstr(out, "==") != 0
                    return: 1
                ---
            else:
                if: l1_text_eq(node\as\atom, "\\")
                    if: l1_write_cstr(out, "->") != 0
                        return: 1
                    ---
                else:
                    if: l1_emit_atom_node(out, node, path) != 0
                        return: 1
                    ---
                ---
            ---
        ---
        field: field\next
    else:
        if: node\kind = c.LM_P0_NODE_FRAME
            if: l1_text_eq(node\as\frame\head, "cast")
                if: l1_emit_cast(out, node\as\frame\body, path) != 0
                    return: 1
                ---
            else:
                if: l1_pointer_depth(node\as\frame\head) != 0U && l1_at_frame_is_type(node\as\frame) != 0
                    if: l1_emit_type_token(out, node, path) != 0
                        return: 1
                    ---
                else:
                    if: l1_text_eq(node\as\frame\head, "@")
                        if: l1_write_cstr(out, "&") != 0
                            return: 1
                        if: l1_emit_arg_list(out, node\as\frame\body, path) != 0
                            return: 1
                        ---
                    else:
                        if: l1_emit_call_frame(out, node\as\frame, path, node) != 0
                            return: 1
                        ---
                    ---
            ---
            field: field\next
        else:
            if: node\kind = c.LM_P0_NODE_STRUCTURE
                if: l1_write_cstr(out, "(") != 0
                    return: 1
                if: l1_emit_expr(out, node\as\structure, path, 0) != 0
                    return: 1
                if: l1_write_cstr(out, ")") != 0
                    return: 1
                field: field\next
            else:
                return: l1_error(path, node, "unsupported expression node")
            ---
        ---
    ---
    prior_node: node
    field: l1_active_field(field, stop)
    while: field != 0
        node: field\value
        if: node = 0
            break
        if: node\kind = c.LM_P0_NODE_ATOM && l1_text_eq(node\as\atom, "\\") && (prior_node = 0 || l1_nodes_adjacent(prior_node, node) = 0)
            break
        if: node\kind = c.LM_P0_NODE_ATOM && l1_text_eq(node\as\atom, "\\")
            while: deref_wrap != 0
                if: l1_write_cstr(out, ")") != 0
                    return: 1
                deref_wrap: deref_wrap - 1
            ---
            if: l1_write_cstr(out, "->") != 0
                return: 1
            field: l1_active_field(field\next, stop)
            if: field = 0 || field\value = 0 || field\value\kind != c.LM_P0_NODE_ATOM
                return: l1_error(path, node, "field-follow missing name")
            if: l1_c_ident(out, field\value\as\atom, path, field\value) != 0
                return: 1
            prior_node: field\value
            field: l1_active_field(field\next, stop)
            continue
        ---
        if: node\kind = c.LM_P0_NODE_ATOM && l1_text_eq(node\as\atom, "[")
            if: l1_write_cstr(out, "[") != 0
                return: 1
            field: field\next
            cursor[0]: field
            if: l1_emit_one_expr(out, cursor, stop, path) != 0
                return: 1
            field: l1_active_field(cursor[0], stop)
            if: field = 0 || field\value = 0 || field\value\kind != c.LM_P0_NODE_ATOM || l1_text_eq(field\value\as\atom, "]") = 0
                return: l1_error(path, node, "index missing ]")
            if: l1_write_cstr(out, "]") != 0
                return: 1
            prior_node: field\value
            field: l1_active_field(field\next, stop)
            continue
        ---
        if: node\kind = c.LM_P0_NODE_ATOM && l1_is_incdec_atom(node\as\atom)
            if: l1_write_text(out, node\as\atom) != 0
                return: 1
            prior_node: node
            field: l1_active_field(field\next, stop)
            continue
        ---
        infix: 0
        if: node\kind = c.LM_P0_NODE_ATOM && l1_is_infix_atom(node\as\atom)
            infix: 1
        ---
        if: infix = 0
            while: deref_wrap != 0
                if: l1_write_cstr(out, ")") != 0
                    return: 1
                deref_wrap: deref_wrap - 1
            ---
            break
        while: deref_wrap != 0
            if: l1_write_cstr(out, ")") != 0
                return: 1
            deref_wrap: deref_wrap - 1
        ---
        next: l1_active_field(field\next, stop)
        next_node: 0
        if: next != 0
            next_node: next\value
        ---
        if: l1_write_cstr(out, " ") != 0
            return: 1
        if: next_node != 0 && next_node\kind = c.LM_P0_NODE_ATOM && l1_nodes_adjacent(node, next_node) && l1_glue_pair(node\as\atom, next_node\as\atom)
            if: l1_write_text(out, node\as\atom) != 0
                return: 1
            if: l1_write_text(out, next_node\as\atom) != 0
                return: 1
            field: next\next
        else:
            if: l1_text_eq(node\as\atom, "=")
                if: l1_write_cstr(out, "==") != 0
                    return: 1
                ---
            else:
                if: l1_c_ident(out, node\as\atom, path, node) != 0
                    return: 1
                ---
            ---
            field: field\next
        ---
        if: l1_write_cstr(out, " ") != 0
            return: 1
        cursor[0]: field
        if: l1_emit_one_expr(out, cursor, stop, path) != 0
            return: 1
        field: l1_active_field(cursor[0], stop)
    while: deref_wrap != 0
        if: l1_write_cstr(out, ")") != 0
            return: 1
        deref_wrap: deref_wrap - 1
    ---
    cursor[0]: field
return: 0

fn: l1_emit_arg_list (@: FILE out; const: @(LmP0Structure body); const: @(char path)) int
    @: LmP0Field field
    int: first 1
    if: body = 0
        return: 0
    field: l1_active_field(body\first_field, 0)
    while: field != 0
        if: first = 0
            if: l1_write_cstr(out, ", ") != 0
                return: 1
            ---
        ---
        first: 0
        if: l1_emit_one_expr(out, @ field, 0, path) != 0
            return: 1
        field: l1_active_field(field, 0)
return: 0




fn: l1_emit_inits (@: FILE out; @: LmP0Field start; const: @(char path)) int
    @: LmP0Field field
    int: first 1
    int: any 0
    field: start
    while: field != 0
        if: l1_node_ignored(field\value) = 0
            if: first = 0
                if: l1_write_cstr(out, ", ") != 0
                    return: 1
                ---
            ---
            first: 0
            any: 1
            if: field\value = 0
                return: l1_error(path, 0, "empty initializer")
            if: field\value\kind = c.LM_P0_NODE_ATOM
                if: l1_emit_atom_node(out, field\value, path) != 0
                    return: 1
                ---
            else:
                if: field\value\kind = c.LM_P0_NODE_STRUCTURE || (field\value\kind = c.LM_P0_NODE_FRAME && l1_text_eq(field\value\as\frame\head, "[]"))
                    if: l1_write_cstr(out, "{") != 0
                        return: 1
                    if: field\value\kind = c.LM_P0_NODE_FRAME
                        if: l1_emit_inits(out, field\value\as\frame\body\first_field, path) != 0
                            return: 1
                        ---
                    else:
                        if: l1_emit_inits(out, field\value\as\structure\first_field, path) != 0
                            return: 1
                    ---
                    if: l1_write_cstr(out, "}") != 0
                        return: 1
                    ---
                else:
                    # A cast is a legal initializer element: `(cast: (char) 255)` in a
                    # byte table.  Without this the initializer emitter refused it
                    # ("unsupported initializer"), which the fmt_buf conversion hit.
                    if: field\value\kind = c.LM_P0_NODE_FRAME && l1_text_eq(field\value\as\frame\head, "cast")
                        if: l1_emit_cast(out, field\value\as\frame\body, path) != 0
                            return: 1
                        ---
                    else:
                        return: l1_error(path, field\value, "unsupported initializer")
                    ---
        ---
        field: field\next
    if: any = 0
        return: 0
return: 0

fn: l1_emit_c_array (@: FILE out; const: @(LmP0Frame frame); const: @(char path); int: force_const) int
    @: LmP0Field field
    @: LmP0Field extra
    @: LmP0Field body_field
    const: @: LmP0Node inner
    const: @: LmP0Node type_node
    const: @: LmP0Node name_node
    const: @: LmP0Text decl_head
    int: is_const 0
    size_t: pointer_depth 0U
    int: nested_form 0
    size_t: i 0U
    if: frame = 0 || frame\body = 0
        return: l1_error(path, 0, "c.array without body")
    field: frame\body\first_field
    while: field != 0 && l1_node_ignored(field\value)
        field: field\next
    if: field = 0 || field\value = 0
        return: l1_error(path, 0, "c.array missing contents")
    inner: field\value
    extra: field\next
    while: extra != 0 && l1_node_ignored(extra\value)
        extra: extra\next
    if: force_const != 0
        is_const: 1
    ---
    if: inner\kind = c.LM_P0_NODE_FRAME && l1_text_eq(inner\as\frame\head, "const")
        is_const: 1
        if: extra != 0
            return: l1_error(path, inner, "const c.array expects exactly one bracket-head array declaration")
        field: 0
        if: inner\as\frame\body != 0
            field: inner\as\frame\body\first_field
        ---
        while: field != 0 && l1_node_ignored(field\value)
            field: field\next
        if: field = 0 || field\value = 0 || field\value\kind != c.LM_P0_NODE_FRAME
            return: l1_error(path, inner, "const c.array expects exactly one bracket-head array declaration")
        extra: field\next
        while: extra != 0 && l1_node_ignored(extra\value)
            extra: extra\next
        if: extra != 0
            return: l1_error(path, inner, "const c.array expects exactly one bracket-head array declaration")
        inner: field\value
        ---
    else:
        if: extra != 0
            return: l1_error(path, inner, "c.array expects exactly one bracket-head array declaration")
        ---
    ---
    if: inner\kind != c.LM_P0_NODE_FRAME || inner\as\frame\head = 0 || inner\as\frame\head\length < 2U || inner\as\frame\head\data[0] != 91
        return: l1_error(path, inner, "c.array expects [N] extent")
    decl_head: inner\as\frame\head
    if: inner\as\frame\body = 0
        return: l1_error(path, inner, "c.array missing type")
    body_field: inner\as\frame\body\first_field
    while: body_field != 0 && l1_node_ignored(body_field\value)
        body_field: body_field\next
    if: body_field = 0 || body_field\value = 0
        return: l1_error(path, inner, "c.array missing type")
    type_node: 0
    name_node: 0
    if: body_field\value\kind = c.LM_P0_NODE_FRAME
        nested_form: 1
        pointer_depth: l1_pointer_depth(body_field\value\as\frame\head)
        if: pointer_depth = 0U && l1_is_type_name(body_field\value\as\frame\head) = 0
            return: l1_error(path, body_field\value, "c.array missing type")
        extra: body_field\next
        while: extra != 0 && l1_node_ignored(extra\value)
            extra: extra\next
        if: extra != 0
            return: l1_error(path, inner, "c.array expects exactly one bracket-head array declaration")
        field: 0
        if: body_field\value\as\frame\body != 0
            field: body_field\value\as\frame\body\first_field
        ---
        while: field != 0 && l1_node_ignored(field\value)
            field: field\next
        if: pointer_depth != 0
            if: field = 0 || field\value = 0
                return: l1_error(path, body_field\value, "c.array missing type")
            type_node: field\value
            field: field\next
            while: field != 0 && l1_node_ignored(field\value)
                field: field\next
            ---
        else:
            type_node: body_field\value
        ---
        if: field = 0 || field\value = 0 || field\value\kind != c.LM_P0_NODE_ATOM
            return: l1_error(path, inner, "c.array missing name")
        name_node: field\value
        body_field: field\next
        ---
    else:
        type_node: body_field\value
        body_field: body_field\next
        while: body_field != 0 && l1_node_ignored(body_field\value)
            body_field: body_field\next
        if: body_field = 0 || body_field\value = 0
            return: l1_error(path, inner, "c.array missing name")
        name_node: body_field\value
        body_field: body_field\next
    ---
    if: is_const != 0
        if: l1_write_cstr(out, "const ") != 0
            return: 1
        ---
    ---
    if: nested_form != 0 && name_node\kind = c.LM_P0_NODE_ATOM
        if: l1_emit_type_token(out, type_node, path) != 0
            return: 1
        if: l1_write_cstr(out, " ") != 0
            return: 1
        i: 0
        while: i < pointer_depth
            if: l1_write_cstr(out, "*") != 0
                return: 1
            i: i + 1
        ---
        if: l1_write_ident(out, name_node\as\atom, path, name_node) != 0
            return: 1
        ---
    else:
        if: name_node\kind = c.LM_P0_NODE_FRAME
            if: l1_emit_type_token(out, name_node, path) != 0
                return: 1
            if: name_node\as\frame\body != 0 && name_node\as\frame\body\first_field != 0 && name_node\as\frame\body\first_field\value != 0 && name_node\as\frame\body\first_field\value\kind = c.LM_P0_NODE_ATOM
                if: l1_write_cstr(out, " ") != 0
                    return: 1
                if: l1_write_ident(out, name_node\as\frame\body\first_field\value\as\atom, path, name_node\as\frame\body\first_field\value) != 0
                    return: 1
                ---
            ---
            ---
        else:
            if: l1_emit_type_token(out, type_node, path) != 0
                return: 1
            if: l1_write_cstr(out, " ") != 0
                return: 1
            if: name_node\kind != c.LM_P0_NODE_ATOM
                return: l1_error(path, name_node, "c.array name is not an identifier")
            if: l1_write_ident(out, name_node\as\atom, path, name_node) != 0
                return: 1
            ---
        ---
    ---
    if: l1_write_cstr(out, "[") != 0
        return: 1
    if: l1_write_bracket_extent(out, decl_head, path, inner) != 0
        return: 1
    while: body_field != 0 && l1_node_ignored(body_field\value)
        body_field: body_field\next
    if: nested_form = 0 && decl_head != 0 && decl_head\length = 2U && body_field != 0 && body_field\value != 0 && body_field\value\kind = c.LM_P0_NODE_ATOM
        if: l1_ident_is_reserved(body_field\value\as\atom) != 0
            return: l1_error(path, body_field\value, "reserved L1 name")
        ---
        if: l1_write_text(out, body_field\value\as\atom) != 0
            return: 1
        body_field: body_field\next
        while: body_field != 0 && l1_node_ignored(body_field\value)
            body_field: body_field\next
        ---
    ---
    if: l1_write_cstr(out, "]") != 0
        return: 1
    if: body_field != 0
        if: l1_write_cstr(out, " = {") != 0
            return: 1
        if: body_field\value != 0 && body_field\value\kind = c.LM_P0_NODE_STRUCTURE && (body_field\next = 0 || l1_node_ignored(body_field\next\value))
            if: l1_emit_inits(out, body_field\value\as\structure\first_field, path) != 0
                return: 1
            ---
        else:
            if: l1_emit_inits(out, body_field, path) != 0
                return: 1
            ---
        ---
        if: l1_write_cstr(out, "}") != 0
            return: 1
    ---
return: l1_write_cstr(out, ";\n")

fn: l1_emit_bracket_array (@: FILE out; const: @(LmP0Frame frame); const: @(char path); int: force_const) int
    @: LmP0Field field
    @: LmP0Field extra
    @: LmP0Field walk
    const: @: LmP0Node type_node
    const: @: LmP0Node name_node
    @: LmP0Field extent_field
    if: frame = 0 || frame\body = 0
        return: l1_error(path, 0, "array without body")
    field: frame\body\first_field
    while: field != 0 && l1_node_ignored(field\value)
        field: field\next
    if: field = 0
        return: l1_error(path, 0, "array missing type")
    type_node: field\value
    field: field\next
    while: field != 0 && l1_node_ignored(field\value)
        field: field\next
    extra: field
    while: field != 0 && field\value != 0 && field\value\kind = c.LM_P0_NODE_ATOM && l1_is_type_name(field\value\as\atom)
        field: field\next
        while: field != 0 && l1_node_ignored(field\value)
            field: field\next
        ---
    ---
    if: field = 0 || field\value = 0 || field\value\kind != c.LM_P0_NODE_ATOM
        return: l1_error(path, type_node, "array missing name")
    name_node: field\value
    field: field\next
    while: field != 0 && l1_node_ignored(field\value)
        field: field\next
    if: force_const != 0
        if: l1_write_cstr(out, "const ") != 0
            return: 1
        ---
    ---
    if: l1_emit_type_token(out, type_node, path) != 0
        return: 1
    walk: extra
    while: walk != 0 && walk\value != name_node
        if: l1_node_ignored(walk\value) = 0 && walk\value != 0 && walk\value\kind = c.LM_P0_NODE_ATOM
            if: l1_write_cstr(out, " ") != 0
                return: 1
            if: l1_write_type_spelling(out, walk\value\as\atom, path, walk\value) != 0
                return: 1
            ---
        ---
        walk: walk\next
    ---
    if: l1_write_cstr(out, " ") != 0
        return: 1
    if: l1_write_ident(out, name_node\as\atom, path, name_node) != 0
        return: 1
    int: rank 0
    size_t: hi 0U
    if: frame\head != 0 && frame\head\data != 0
        while: hi + 1U < frame\head\length && frame\head\data[hi] = 91 && frame\head\data[hi + 1U] = 93
            rank: rank + 1
            hi: hi + 2U
        ---
    ---
    if: rank = 0
        rank: 1
    ---
    while: rank > 0
        if: l1_write_cstr(out, "[") != 0
            return: 1
        if: field = 0 || field\value = 0 || field\value\kind != c.LM_P0_NODE_ATOM || l1_text_eq(field\value\as\atom, "[]")
            return: l1_error(path, name_node, "array missing extent")
        if: l1_ident_is_reserved(field\value\as\atom) != 0
            return: l1_error(path, field\value, "reserved L1 name")
        ---
        # D-95: an extent `c.NAME` is the C constant NAME, as l1_write_bracket_extent writes
        # `c.array: [c.NAME]:` -- not the text `c.NAME`, which is no C expression.
        if: l1_text_starts(field\value\as\atom, "c.") != 0 && field\value\as\atom\length > 2U
            if: l1_write_span(out, field\value\as\atom\data + 2U, field\value\as\atom\length - 2U) != 0
                return: 1
            ---
        else:
            if: l1_write_text(out, field\value\as\atom) != 0
                return: 1
            ---
        ---
        field: field\next
        while: field != 0 && l1_node_ignored(field\value)
            field: field\next
        ---
        if: l1_write_cstr(out, "]") != 0
            return: 1
        rank: rank - 1
    ---
    if: field != 0
        if: l1_write_cstr(out, " = {") != 0
            return: 1
        if: field\value != 0 && field\value\kind = c.LM_P0_NODE_STRUCTURE && (field\next = 0 || l1_node_ignored(field\next\value))
            if: l1_emit_inits(out, field\value\as\structure\first_field, path) != 0
                return: 1
            ---
        else:
            if: l1_emit_inits(out, field, path) != 0
                return: 1
            ---
        ---
        if: l1_write_cstr(out, "}") != 0
            return: 1
    ---
return: l1_write_cstr(out, ";\n")

fn: l1_emit_for_init (@: FILE out; const: @(LmP0Node node); const: @(char path)) int
    @: LmP0Field field
    if: node = 0
        return: 0
    if: node\kind = c.LM_P0_NODE_FRAME && l1_is_type_name(node\as\frame\head)
        if: l1_write_type_spelling(out, node\as\frame\head, path, node) != 0
            return: 1
        if: node\as\frame\body = 0 || node\as\frame\body\first_field = 0
            return: 0
        field: node\as\frame\body\first_field
        if: l1_write_cstr(out, " ") != 0
            return: 1
        if: field\value != 0 && field\value\kind = c.LM_P0_NODE_ATOM
            if: l1_write_ident(out, field\value\as\atom, path, field\value) != 0
                return: 1
            ---
        ---
        field: field\next
        while: field != 0 && l1_node_ignored(field\value)
            field: field\next
        if: field != 0
            if: l1_write_cstr(out, " = ") != 0
                return: 1
            return: l1_emit_expr_range(out, field, 0, path, 0)
        ---
        return: 0
    if: node\kind = c.LM_P0_NODE_FRAME
        if: l1_c_ident(out, node\as\frame\head, path, node) != 0
            return: 1
        if: l1_write_cstr(out, " = ") != 0
            return: 1
        return: l1_emit_expr(out, node\as\frame\body, path, 0)
    if: node\kind = c.LM_P0_NODE_STRUCTURE
        return: l1_emit_expr(out, node\as\structure, path, 0)
return: l1_error(path, node, "unsupported for-init")

fn: l1_emit_clause_stmts (@: FILE out; const: @(LmP0Structure body); const: @(char path)) int
    @: LmP0Field field
    if: body = 0
        return: 0
    field: body\first_field
    while: field != 0
        if: l1_node_ignored(field\value) = 0
            if: l1_emit_stmt(out, field\value, path) != 0
                return: 1
            ---
        ---
        field: field\next
return: 0

fn: l1_emit_switch (@: FILE out; const: @(LmP0Frame frame); const: @(char path); const: @(LmP0Node node)) int
    @: LmP0Field last
    @: LmP0Field field
    @: LmP0Field pre
    const: @: LmP0Node clause
    @: LmP0Field clast
    int: saw_default 0
    if: frame = 0
        return: 1
    last: l1_last_active_field(frame\body)
    if: last = 0 || last\value = 0 || last\value\kind != c.LM_P0_NODE_STRUCTURE
        return: l1_error(path, node, "switch without body")
    if: l1_write_cstr(out, "    switch (") != 0
        return: 1
    if: l1_emit_expr_range(out, frame\body\first_field, last, path, 1) != 0
        return: 1
    if: l1_write_cstr(out, ") {\n") != 0
        return: 1
    field: last\value\as\structure\first_field
    while: field != 0
        clause: field\value
        if: l1_node_ignored(clause) = 0
            if: clause = 0 || clause\kind != c.LM_P0_NODE_FRAME
                return: l1_error(path, clause, "switch body expects case/default frames")
            if: l1_text_eq(clause\as\frame\head, "default")
                if: saw_default != 0
                    return: l1_error(path, clause, "switch has duplicate default")
                saw_default: 1
                if: l1_write_cstr(out, "    default: ;\n") != 0
                    return: 1
                if: l1_emit_clause_stmts(out, clause\as\frame\body, path) != 0
                    return: 1
                ---
            else:
                if: l1_text_eq(clause\as\frame\head, "case") = 0
                    return: l1_error(path, clause, "switch body expects case/default frames")
                clast: l1_last_active_field(clause\as\frame\body)
                if: clast = 0
                    return: l1_error(path, clause, "case expects an expression")
                if: clast\value != 0 && clast\value\kind = c.LM_P0_NODE_STRUCTURE
                    pre: clause\as\frame\body\first_field
                    while: pre != 0 && pre != clast && l1_node_ignored(pre\value)
                        pre: pre\next
                    if: pre = 0 || pre = clast
                        return: l1_error(path, clause, "case expects an expression")
                    if: l1_write_cstr(out, "    case ") != 0
                        return: 1
                    if: l1_emit_expr_range(out, clause\as\frame\body\first_field, clast, path, 0) != 0
                        return: 1
                    if: l1_write_cstr(out, ": ;\n") != 0
                        return: 1
                    if: l1_emit_stmt(out, clast\value, path) != 0
                        return: 1
                    ---
                else:
                    if: clast\value != 0 && clast\value\kind = c.LM_P0_NODE_FRAME && l1_is_keyword(clast\value\as\frame\head) != 0
                        return: l1_error(path, clause, "case expects an expression")
                    if: l1_write_cstr(out, "    case ") != 0
                        return: 1
                    if: l1_emit_expr(out, clause\as\frame\body, path, 0) != 0
                        return: 1
                    if: l1_write_cstr(out, ": ;\n") != 0
                        return: 1
                    ---
                ---
            ---
        ---
        field: field\next
    if: l1_write_cstr(out, "    }\n") != 0
        return: 1
return: l1_validate_end_trailer(frame, path, node)


fn: l1_emit_finallies (@: FILE out; const: @(char path); int: until_depth) int
    @: LmP0Field field
    int: saved
    if: l1_has_fin = 0 || l1_fin_depth < until_depth
        return: 0
    saved: l1_in_finally
    l1_in_finally: 1
    field: l1_fin_f
    while: field != 0
        if: l1_node_ignored(field\value) = 0
            if: l1_emit_stmt(out, field\value, path) != 0
                l1_in_finally: saved
                return: 1
            ---
        ---
        field: field\next
    l1_in_finally: saved
return: 0




fn: l1_emit_throw_leave (@: FILE out; const: @(char path)) int
    if: l1_emit_finallies(out, path, 1) != 0
        return: 1
    if: l1_cur_void != 0
        return: l1_write_cstr(out, "    return;\n")
return: l1_write_cstr(out, "    return 0;\n")

fn: l1_emit_throw_dispatch (@: FILE out; const: @(LmP0Text name); const: @(char path); const: @(LmP0Node node)) int
    int: fn_i
    int: n
    int: j 0
    int: code
    int: pad
    if: l1_in_finally != 0
        return: 0
    fn_i: l1_fn_find(name)
    if: fn_i < 0 || l1_fn_thn[fn_i] = 0
        return: 0
    n: l1_fn_thn[fn_i]
    while: j < n
        code: l1_fn_th[fn_i * 8 + j]
        pad: l1_catch_find_code(code)
        if: pad >= 0
            if: c.fprintf(out, "    if (l1_throw_code == %d) goto l1_catch_%d;\n", code, l1_ca_ids[pad]) < 0
                return: 1
            ---
        else:
            if: l1_cur_has_throw(code) = 0
                return: l1_error(path, node, "throw is not caught and is not in throws")
            if: c.fprintf(out, "    if (l1_throw_code == %d) {\n", code) < 0
                return: 1
            if: l1_emit_throw_leave(out, path) != 0
                return: 1
            if: l1_write_cstr(out, "    }\n") != 0
                return: 1
            ---
        ---
        j: j + 1
return: 0


fn: l1_emit_throw (@: FILE out; const: @(LmP0Frame frame); const: @(char path); const: @(LmP0Node node)) int
    @: LmP0Field field
    const: @: LmP0Frame throw_frame
    @: LmP0Field arg
    @: LmP0Field cursor
    int: code
    int: slot 0
    if: frame = 0 || frame\body = 0
        return: l1_error(path, node, "throw expects Name(arguments)")
    field: frame\body\first_field
    while: field != 0 && l1_node_ignored(field\value)
        field: field\next
    if: field = 0 || field\value = 0 || field\value\kind != c.LM_P0_NODE_FRAME
        return: l1_error(path, node, "throw expects Name(arguments)")
    arg: field\next
    while: arg != 0 && l1_node_ignored(arg\value)
        arg: arg\next
    if: arg != 0
        return: l1_error(path, node, "throw expects a single Name(arguments) form")
    throw_frame: field\value\as\frame
    if: throw_frame = 0 || throw_frame\head = 0
        return: l1_error(path, node, "throw expects Name(arguments)")
    if: l1_ident_is_reserved(throw_frame\head) != 0
        return: l1_error(path, field\value, "reserved L1 name")
    code: l1_throw_intern(throw_frame\head)
    if: code = 0
        return: l1_error(path, field\value, "too many throw names")
    if: l1_cur_has_throw(code) = 0
        return: l1_error(path, field\value, "throw is not in the current throws set")
    if: l1_emit_throw_channel(out) != 0
        return: 1
    arg: 0
    if: throw_frame\body != 0
        arg: throw_frame\body\first_field
    ---
    while: arg != 0
        if: l1_node_ignored(arg\value) = 0
            if: slot >= 8
                return: l1_error(path, arg\value, "throw payload is limited to 8 arguments")
            if: c.fprintf(out, "    l1_throw_payload[%d] = (long)(", slot) < 0
                return: 1
            cursor: arg
            if: l1_emit_one_expr(out, @ cursor, 0, path) != 0
                return: 1
            if: l1_write_cstr(out, ");\n") != 0
                return: 1
            slot: slot + 1
            arg: cursor
            continue
        ---
        arg: arg\next
    if: l1_arity_bind(code, slot, path, field\value) != 0
        return: 1
    if: c.fprintf(out, "    l1_throw_code = %d;\n", code) < 0
        return: 1
return: l1_emit_throw_leave(out, path)

fn: l1_emit_catch (@: FILE out; const: @(LmP0Frame frame); const: @(char path); const: @(LmP0Node node)) int
    @: LmP0Field name_field
    @: LmP0Field params_field
    @: LmP0Field body_field
    int: pad
    int: id
    int: code
    if: frame = 0 || frame\body = 0
        return: l1_error(path, node, "catch expects Name (parameters)")
    name_field: frame\body\first_field
    while: name_field != 0 && l1_node_ignored(name_field\value)
        name_field: name_field\next
    if: name_field = 0 || name_field\value = 0 || name_field\value\kind != c.LM_P0_NODE_ATOM
        return: l1_error(path, node, "catch expects a throw name")
    params_field: name_field\next
    while: params_field != 0 && l1_node_ignored(params_field\value)
        params_field: params_field\next
    if: params_field = 0 || params_field\value = 0 || params_field\value\kind != c.LM_P0_NODE_STRUCTURE
        return: l1_error(path, node, "catch expects Name (parameters)")
    body_field: params_field\next
    while: body_field != 0 && l1_node_ignored(body_field\value)
        body_field: body_field\next
    pad: l1_catch_find(name_field\value\as\atom, 0)
    if: pad < 0
        return: l1_error(path, node, "catch was not registered in this block")
    id: l1_ca_ids[pad]
    if: l1_emit_throw_channel(out) != 0
        return: 1
    if: c.fprintf(out, "    goto l1_after_catch_%d;\n", id) < 0
        return: 1
    if: c.fprintf(out, "l1_catch_%d: ;\n", id) < 0
        return: 1
    if: l1_write_cstr(out, "    {\n") != 0
        return: 1
    if: l1_emit_catch_params(out, params_field\value\as\structure, path) != 0
        return: 1
    code: l1_throw_intern(name_field\value\as\atom)
    if: code = 0
        return: l1_error(path, name_field\value, "too many throw names")
    if: l1_arity_bind(code, l1_count_catch_params(params_field\value\as\structure), path, node) != 0
        return: 1
    if: l1_write_cstr(out, "        l1_throw_code = 0;\n") != 0
        return: 1
    if: body_field != 0
        if: body_field\value != 0 && body_field\value\kind = c.LM_P0_NODE_STRUCTURE && (body_field\next = 0 || l1_node_ignored(body_field\next\value))
            if: l1_emit_block(out, body_field\value\as\structure, path) != 0
                return: 1
            ---
        else:
            while: body_field != 0
                if: l1_node_ignored(body_field\value) = 0
                    if: l1_emit_stmt(out, body_field\value, path) != 0
                        return: 1
                    ---
                ---
                body_field: body_field\next
            ---
        ---
    ---
    if: l1_write_cstr(out, "    }\n") != 0
        return: 1
    if: c.fprintf(out, "l1_after_catch_%d: ;\n", id) < 0
        return: 1
return: 0

fn: l1_emit_data_decl (@: FILE out; const: @(LmP0Node node); const: @(char path); int: force_const) int
    @: LmP0Frame frame
    @: LmP0Field field
    @: LmP0Field const_init
    const: @: LmP0Node name_node
    const: @: LmP0Text head
    size_t: pointer_depth
    if: node = 0 || node\kind != c.LM_P0_NODE_FRAME
        return: l1_error(path, node, "declaration expects a frame")
    frame: node\as\frame
    head: frame\head
    field: 0
    const_init: 0
    while: l1_text_eq(head, "const")
        if: frame\body = 0 || frame\body\first_field = 0 || frame\body\first_field\value = 0 || frame\body\first_field\value\kind != c.LM_P0_NODE_FRAME
            return: l1_error(path, node, "const declaration missing type")
        if: const_init = 0
            const_init: frame\body\first_field\next
            while: const_init != 0 && l1_node_ignored(const_init\value)
                const_init: const_init\next
            ---
        ---
        frame: frame\body\first_field\value\as\frame
        if: frame = 0
            return: l1_error(path, node, "const declaration missing type")
        head: frame\head
        force_const: 1
    ---
    if: force_const != 0
        if: l1_write_cstr(out, "    const ") != 0
            return: 1
        ---
    else:
        if: l1_write_cstr(out, "    ") != 0
            return: 1
        ---
    ---
    if: frame\body != 0
        field: frame\body\first_field
    if: l1_pointer_depth(head) != 0U
        pointer_depth: l1_pointer_depth(head)
        if: field = 0 || field\value = 0
            return: l1_error(path, node, "pointer declaration missing type")
        if: l1_emit_type_token(out, field\value, path) != 0
            return: 1
        if: l1_write_cstr(out, " ") != 0 || l1_emit_stars(out, pointer_depth) != 0
            return: 1
        field: field\next
        while: field != 0 && l1_node_ignored(field\value)
            field: field\next
        ---
    else:
        if: l1_write_type_spelling(out, head, path, node) != 0
            return: 1
        ---
    ---
    # For const: declarations, the name lives in const_init (captured at :3284
    # during const unwrapping), while `field` traverses the type node's body.
    # If the type node has no name in its own body, fall back to const_init.
    if: field = 0 && const_init != 0
        field: const_init
        const_init: 0
    ---
    if: field = 0 || field\value = 0 || field\value\kind != c.LM_P0_NODE_ATOM
        return: l1_error(path, node, "declaration expects a name")
    name_node: field\value
    if: l1_write_cstr(out, " ") != 0
        return: 1
    if: l1_write_ident(out, name_node\as\atom, path, name_node) != 0
        return: 1
    field: field\next
    while: field != 0 && l1_node_ignored(field\value)
        field: field\next
    if: const_init != 0
        field: const_init
    ---
    if: field != 0
        if: l1_write_cstr(out, " = ") != 0
            return: 1
        if: l1_emit_expr_range(out, field, 0, path, 0) != 0
            return: 1
        ---
    ---
return: l1_write_cstr(out, ";\n")

fn: l1_emit_immutable (@: FILE out; const: @(LmP0Frame frame); const: @(char path); const: @(LmP0Node node)) int
    @: LmP0Field field
    const: @: LmP0Node child
    const: @: LmP0Text ch
    @: LmP0Frame inherit
    @: LmP0Frame current
    @: LmP0Frame nextf
    int: saw 0
    if: frame = 0
        return: l1_error(path, node, "immutable expects declarations")
    if: l1_validate_end_trailer(frame, path, node) != 0
        return: 1
    field: 0
    inherit: 0
    if: frame\body != 0
        field: frame\body\first_field
    ---
    while: field != 0
        child: field\value
        current: 0
        if: inherit != 0 && child != 0 && child\kind = c.LM_P0_NODE_STRUCTURE
            current: inherit
        ---
        nextf: 0
        if: child != 0 && child\kind = c.LM_P0_NODE_FRAME && l1_frame_is_repeatable(child\as\frame)
            nextf: child\as\frame
        else:
            if: current != 0
                nextf: current
            ---
        ---
        if: l1_node_ignored(child) = 0
            if: current != 0
                if: l1_pointer_depth(current\head) != 0U
                    if: l1_emit_repeat_pointer(out, current, child\as\structure, path, child, 1) != 0
                        return: 1
                    ---
                else:
                    if: l1_text_eq(current\head, "[]")
                        if: l1_emit_repeat_array(out, current, child\as\structure, path, child, 1) != 0
                            return: 1
                        ---
                    else:
                        if: l1_emit_repeat_scalar(out, current\head, child\as\structure, path, child, 1) != 0
                            return: 1
                        ---
                    ---
                ---
                saw: 1
            else:
                if: child = 0 || child\kind != c.LM_P0_NODE_FRAME
                    return: l1_error(path, child, "immutable expects declarations")
                ch: child\as\frame\head
                if: l1_text_eq(ch, "immutable")
                    if: l1_emit_immutable(out, child\as\frame, path, child) != 0
                        return: 1
                    ---
                else:
                    if: l1_text_eq(ch, "c.array")
                        if: l1_write_cstr(out, "    ") != 0
                            return: 1
                        if: l1_emit_c_array(out, child\as\frame, path, 1) != 0
                            return: 1
                        ---
                    else:
                        if: l1_text_eq(ch, "[]") || l1_text_starts(ch, "[]")
                            if: l1_write_cstr(out, "    ") != 0
                                return: 1
                            if: l1_emit_bracket_array(out, child\as\frame, path, 1) != 0
                                return: 1
                            ---
                        else:
                            if: l1_text_eq(ch, "const") || l1_pointer_depth(ch) != 0U || l1_is_type_name(ch)
                                if: l1_emit_data_decl(out, child, path, 1) != 0
                                    return: 1
                                ---
                            else:
                                return: l1_error(path, child, "immutable does not qualify this form")
                            ---
                        ---
                    ---
                ---
                saw: 1
            ---
        ---
        inherit: nextf
        field: field\next
    if: saw = 0
        return: l1_error(path, node, "immutable expects declarations")
return: 0

fn: l1_emit_thread_local (@: FILE out; const: @(LmP0Frame frame); const: @(char path); const: @(LmP0Node node)) int
    @: LmP0Field field
    const: @: LmP0Node child
    const: @: LmP0Text ch
    int: saw 0
    if: frame = 0
        return: l1_error(path, node, "thread_local expects declarations")
    if: l1_validate_end_trailer(frame, path, node) != 0
        return: 1
    field: 0
    if: frame\body != 0
        field: frame\body\first_field
    ---
    while: field != 0
        child: field\value
        if: l1_node_ignored(child) = 0
            if: child = 0 || child\kind != c.LM_P0_NODE_FRAME
                return: l1_error(path, child, "thread_local expects declarations")
            ch: child\as\frame\head
            if: l1_text_eq(ch, "const") || l1_pointer_depth(ch) != 0U || l1_is_type_name(ch) || l1_text_eq(ch, "foreign")
                if: l1_write_cstr(out, "    _Thread_local ") != 0
                    return: 1
                if: l1_emit_data_decl(out, child, path, 0) != 0
                    return: 1
                ---
            else:
                if: l1_text_eq(ch, "[]") || l1_text_starts(ch, "[]")
                    if: l1_write_cstr(out, "    _Thread_local ") != 0
                        return: 1
                    if: l1_emit_bracket_array(out, child\as\frame, path, 0) != 0
                        return: 1
                    ---
                else:
                    return: l1_error(path, child, "thread_local does not qualify this form")
                ---
            ---
            saw: 1
        ---
        field: field\next
    ---
    if: saw = 0
        return: l1_error(path, node, "thread_local expects declarations")
return: 0

fn: l1_emit_stmt (@: FILE out; const: @(LmP0Node node); const: @(char path)) int
    const: @: LmP0Frame frame
    @: LmP0Field field
    @: LmP0Field last
    @: LmP0Field first_active
    @: LmP0Field cond_field
    const: @: LmP0Node name_node
    const: @: LmP0Text head
    @: LmP0Field const_init 0
    int: i
    if: l1_node_ignored(node)
        return: 0
    if: node = 0
        return: 1
    if: node\kind = c.LM_P0_NODE_STRUCTURE
        return: l1_emit_block(out, node\as\structure, path)
    if: node\kind = c.LM_P0_NODE_ATOM
        if: l1_text_eq(node\as\atom, "continue")
            return: l1_write_cstr(out, "    continue;\n")
        if: l1_text_eq(node\as\atom, "break")
            return: l1_write_cstr(out, "    break;\n")
        if: l1_text_eq(node\as\atom, "return")
            if: l1_emit_finallies(out, path, 1) != 0
                return: 1
            return: l1_write_cstr(out, "    return;\n")
        i: l1_fn_find(node\as\atom)
        if: i >= 0 && l1_fn_ar[i] = 0
            if: l1_ident_is_reserved(node\as\atom) != 0
                return: l1_error(path, node, "reserved L1 name")
            if: l1_write_cstr(out, "    ") != 0
                return: 1
            if: l1_write_ident(out, node\as\atom, path, node) != 0
                return: 1
            if: l1_write_cstr(out, "();\n") != 0
                return: 1
            return: l1_emit_throw_dispatch(out, node\as\atom, path, node)
        ---
        return: l1_error(path, node, "unsupported statement atom")
    if: node\kind != c.LM_P0_NODE_FRAME
        return: l1_error(path, node, "statement must be a frame")
    frame: node\as\frame
    head: frame\head
    if: l1_text_eq(head, "end")
        return: 0
    if: l1_text_eq(head, "include")
        return: l1_emit_include(out, frame, path)
    if: l1_text_eq(head, "return")
        if: l1_emit_finallies(out, path, 1) != 0
            return: 1
        if: l1_write_cstr(out, "    return ") != 0
            return: 1
        if: l1_emit_expr(out, frame\body, path, 0) != 0
            return: 1
        return: l1_write_cstr(out, ";\n")
    if: l1_text_eq(head, "continue")
        return: l1_write_cstr(out, "    continue;\n")
    if: l1_text_eq(head, "break")
        return: l1_write_cstr(out, "    break;\n")
    if: l1_text_eq(head, "switch")
        return: l1_emit_switch(out, frame, path, node)
    if: l1_text_eq(head, "goto")
        return: l1_emit_goto(out, frame, path, node)
    if: l1_text_eq(head, "throw")
        return: l1_emit_throw(out, frame, path, node)
    if: l1_text_eq(head, "catch")
        return: l1_emit_catch(out, frame, path, node)
    if: l1_text_eq(head, "finally")
        if: frame\body = 0 || frame\body\first_field = 0
            return: l1_error(path, node, "finally expects a cleanup body")
        if: l1_has_fin != 0
            return: l1_error(path, node, "too many finally registrations")
        l1_fin_f: frame\body\first_field
        l1_fin_depth: l1_blk_d
        l1_has_fin: 1
        return: 0
    if: l1_text_eq(head, "throws")
        if: l1_allow_throws != 0
            l1_allow_throws: 0
            return: 0
        return: l1_error(path, node, "throws is only valid immediately after the function header")
    if: l1_text_eq(head, "case") || l1_text_eq(head, "default")
        return: l1_error(path, node, "case/default outside switch")
    if: l1_text_eq(head, "if")
        last: l1_last_active_field(frame\body)
        if: last = 0 || last\value = 0 || last\value\kind != c.LM_P0_NODE_STRUCTURE
            return: l1_error(path, node, "if without body")
        if: l1_write_cstr(out, "    if (") != 0
            return: 1
        if: l1_emit_expr_range(out, frame\body\first_field, last, path, 1) != 0
            return: 1
        if: l1_write_cstr(out, ") {\n") != 0
            return: 1
        if: l1_emit_stmt(out, last\value, path) != 0
            return: 1
        return: l1_write_cstr(out, "    }\n")
    if: l1_text_eq(head, "else")
        if: l1_write_cstr(out, "    else {\n") != 0
            return: 1
        if: l1_emit_block(out, frame\body, path) != 0
            return: 1
        return: l1_write_cstr(out, "    }\n")
    if: l1_text_eq(head, "while")
        last: l1_last_active_field(frame\body)
        if: last = 0 || last\value = 0 || last\value\kind != c.LM_P0_NODE_STRUCTURE
            return: l1_error(path, node, "while without body")
        if: l1_write_cstr(out, "    while (") != 0
            return: 1
        if: l1_emit_expr_range(out, frame\body\first_field, last, path, 1) != 0
            return: 1
        if: l1_write_cstr(out, ") {\n") != 0
            return: 1
        if: l1_emit_stmt(out, last\value, path) != 0
            return: 1
        return: l1_write_cstr(out, "    }\n")
    if: l1_text_eq(head, "for")
        first_active: 0
        last: 0
        cond_field: 0
        field: 0
        if: frame\body != 0
            field: frame\body\first_field
        ---
        while: field != 0
            if: l1_node_ignored(field\value) = 0
                if: first_active = 0
                    first_active: field
                ---
                last: field
            ---
            field: field\next
        if: first_active = 0 || last = 0 || last\value = 0 || last\value\kind != c.LM_P0_NODE_STRUCTURE
            return: l1_error(path, node, "for without body")
        field: first_active\next
        while: field != 0 && field != last
            if: l1_node_ignored(field\value) = 0 && field\value != 0 && field\value\kind = c.LM_P0_NODE_STRUCTURE && cond_field = 0
                cond_field: field
            ---
            field: field\next
        if: l1_write_cstr(out, "    for (") != 0
            return: 1
        if: l1_emit_for_init(out, first_active\value, path) != 0
            return: 1
        if: l1_write_cstr(out, "; ") != 0
            return: 1
        if: cond_field != 0 && cond_field\value != 0 && cond_field\value\kind = c.LM_P0_NODE_STRUCTURE
            if: l1_emit_expr(out, cond_field\value\as\structure, path, 1) != 0
                return: 1
            ---
        ---
        if: l1_write_cstr(out, "; ") != 0
            return: 1
        if: cond_field != 0
            if: l1_emit_expr_range(out, cond_field\next, last, path, 0) != 0
                return: 1
            ---
        ---
        if: l1_write_cstr(out, ") {\n") != 0
            return: 1
        if: l1_emit_stmt(out, last\value, path) != 0
            return: 1
        return: l1_write_cstr(out, "    }\n")
    if: l1_text_eq(head, "[]") || l1_text_starts(head, "[]")
        if: l1_write_cstr(out, "    ") != 0
            return: 1
        return: l1_emit_bracket_array(out, frame, path, 0)
    if: l1_text_eq(head, "ifdef")
        return: l1_emit_ifdef(out, frame, path, 1, 0, node)
    if: l1_text_eq(head, "immutable")
        return: l1_emit_immutable(out, frame, path, node)
    if: l1_text_eq(head, "thread_local")
        return: l1_emit_thread_local(out, frame, path, node)
    if: l1_text_eq(head, "c.array")
        if: l1_write_cstr(out, "    ") != 0
            return: 1
        return: l1_emit_c_array(out, frame, path, 0)
    if: l1_text_eq(head, "const") || l1_pointer_depth(head) != 0U || l1_is_type_name(head)
        return: l1_emit_data_decl(out, node, path, 0)
    if: (frame\flags & c.LM_P0_FRAME_COLON) != 0U && l1_is_keyword(head) = 0 && l1_head_is_unknown_type(head)
        return: l1_error(path, node, "unknown type name")
    if: l1_is_keyword(head) = 0 && (frame\flags & c.LM_P0_FRAME_COLON) != 0U && (l1_text_starts(head, "c.") = 0 || l1_head_looks_assignable_target(head) != 0)
        field: 0
        if: frame\body != 0
            field: frame\body\first_field
        ---
        while: field != 0 && l1_node_ignored(field\value)
            field: field\next
        if: field = 0
            if: l1_ident_is_reserved(head) != 0
                return: l1_error(path, node, "reserved L1 name")
            if: l1_write_cstr(out, "    ") != 0
                return: 1
            if: l1_write_ident(out, head, path, node) != 0
                return: 1
            return: l1_write_cstr(out, ": ;\n")
        if: l1_write_cstr(out, "    ") != 0
            return: 1
        if: l1_emit_assign_head(out, head, path, node) != 0
            return: 1
        if: l1_write_cstr(out, " = ") != 0
            return: 1
        field: 0
        last: 0
        if: frame\body != 0
            field: frame\body\first_field
        ---
        while: field != 0 && l1_node_ignored(field\value)
            field: field\next
        if: field != 0
            last: field\next
            while: last != 0 && l1_node_ignored(last\value)
                last: last\next
            ---
        ---
        l1_throw_ok: 0
        if: field != 0 && last = 0 && field\value != 0 && field\value\kind = c.LM_P0_NODE_FRAME && l1_fn_is_throwing(field\value\as\frame\head) != 0
            l1_throw_ok: 1
        ---
        if: l1_emit_expr(out, frame\body, path, 0) != 0
            l1_throw_ok: 0
            return: 1
        l1_throw_ok: 0
        if: l1_write_cstr(out, ";\n") != 0
            return: 1
        if: field != 0 && last = 0 && field\value != 0 && field\value\kind = c.LM_P0_NODE_FRAME
            return: l1_emit_throw_dispatch(out, field\value\as\frame\head, path, field\value)
        ---
        return: 0
    if: l1_write_cstr(out, "    ") != 0
        return: 1
    if: l1_c_ident(out, head, path, node) != 0
        return: 1
    if: l1_write_cstr(out, "(") != 0
        return: 1
    if: l1_emit_arg_list(out, frame\body, path) != 0
        return: 1
    if: l1_write_cstr(out, ");\n") != 0
        return: 1
return: l1_emit_throw_dispatch(out, head, path, node)


fn: l1_emit_repeat_scalar (@: FILE out; const: @(LmP0Text head); const: @(LmP0Structure body); const: @(char path); const: @(LmP0Node node); int: force_const) int
    @: LmP0Field field
    const: @: LmP0Node name_node
    if: force_const != 0
        if: l1_write_cstr(out, "    const ") != 0
            return: 1
        ---
    else:
        if: l1_write_cstr(out, "    ") != 0
            return: 1
        ---
    ---
    if: l1_write_type_spelling(out, head, path, node) != 0
        return: 1
    field: 0
    if: body != 0
        field: body\first_field
    ---
    while: field != 0 && l1_node_ignored(field\value)
        field: field\next
    if: field = 0 || field\value = 0 || field\value\kind != c.LM_P0_NODE_ATOM
        return: l1_error(path, node, "repeated declaration expects a name")
    name_node: field\value
    if: l1_write_cstr(out, " ") != 0
        return: 1
    if: l1_write_ident(out, name_node\as\atom, path, name_node) != 0
        return: 1
    field: field\next
    while: field != 0 && l1_node_ignored(field\value)
        field: field\next
    if: field != 0
        if: l1_write_cstr(out, " = ") != 0
            return: 1
        if: l1_emit_expr_range(out, field, 0, path, 0) != 0
            return: 1
    ---
return: l1_write_cstr(out, ";\n")

fn: l1_emit_repeat_pointer (@: FILE out; const: @(LmP0Frame template); const: @(LmP0Structure body); const: @(char path); const: @(LmP0Node node); int: force_const) int
    @: LmP0Field tfield
    @: LmP0Field nfield
    const: @: LmP0Node type_node
    const: @: LmP0Node name_node
    size_t: pointer_depth
    tfield: 0
    if: template != 0 && template\body != 0
        tfield: template\body\first_field
    ---
    while: tfield != 0 && l1_node_ignored(tfield\value)
        tfield: tfield\next
    nfield: 0
    if: body != 0
        nfield: body\first_field
    ---
    while: nfield != 0 && l1_node_ignored(nfield\value)
        nfield: nfield\next
    if: template = 0 || tfield = 0 || tfield\value = 0 || nfield = 0 || nfield\value = 0 || nfield\value\kind != c.LM_P0_NODE_ATOM
        return: l1_error(path, node, "repeated @ declaration expects type template and name")
    type_node: tfield\value
    if: nfield\next != 0 && nfield\value\kind = c.LM_P0_NODE_ATOM && l1_is_type_name(nfield\value\as\atom)
        type_node: nfield\value
        nfield: nfield\next
        while: nfield != 0 && l1_node_ignored(nfield\value)
            nfield: nfield\next
        if: nfield = 0 || nfield\value = 0 || nfield\value\kind != c.LM_P0_NODE_ATOM
            return: l1_error(path, node, "repeated @ declaration override expects a variable name")
    ---
    name_node: nfield\value
    if: force_const != 0
        if: l1_write_cstr(out, "    const ") != 0
            return: 1
        ---
    else:
        if: l1_write_cstr(out, "    ") != 0
            return: 1
        ---
    ---
    if: l1_emit_type_token(out, type_node, path) != 0
        return: 1
    pointer_depth: l1_pointer_depth(template\head)
    if: pointer_depth = 0U
        return: l1_error(path, node, "repeated @ declaration expects pointer template")
    if: l1_write_cstr(out, " ") != 0 || l1_emit_stars(out, pointer_depth) != 0
        return: 1
    if: l1_write_cstr(out, " ") != 0
        return: 1
    if: l1_write_ident(out, name_node\as\atom, path, name_node) != 0
        return: 1
    nfield: nfield\next
    while: nfield != 0 && l1_node_ignored(nfield\value)
        nfield: nfield\next
    if: nfield != 0
        if: l1_write_cstr(out, " = ") != 0
            return: 1
        if: l1_emit_expr_range(out, nfield, 0, path, 0) != 0
            return: 1
    ---
return: l1_write_cstr(out, ";\n")

fn: l1_emit_repeat_array (@: FILE out; const: @(LmP0Frame template); const: @(LmP0Structure body); const: @(char path); const: @(LmP0Node node); int: force_const) int
    @: LmP0Field tfield
    @: LmP0Field nfield
    @: LmP0Field efield
    const: @: LmP0Node type_node
    const: @: LmP0Node name_node
    tfield: 0
    if: template != 0 && template\body != 0
        tfield: template\body\first_field
    ---
    while: tfield != 0 && l1_node_ignored(tfield\value)
        tfield: tfield\next
    nfield: 0
    if: body != 0
        nfield: body\first_field
    ---
    while: nfield != 0 && l1_node_ignored(nfield\value)
        nfield: nfield\next
    if: template = 0 || tfield = 0 || tfield\value = 0 || nfield = 0 || nfield\value = 0 || nfield\value\kind != c.LM_P0_NODE_ATOM
        return: l1_error(path, node, "repeated [] declaration expects a variable name")
    type_node: tfield\value
    if: nfield\next != 0 && nfield\value\kind = c.LM_P0_NODE_ATOM && l1_is_type_name(nfield\value\as\atom)
        type_node: nfield\value
        nfield: nfield\next
        while: nfield != 0 && l1_node_ignored(nfield\value)
            nfield: nfield\next
        if: nfield = 0 || nfield\value = 0 || nfield\value\kind != c.LM_P0_NODE_ATOM
            return: l1_error(path, node, "repeated [] declaration override expects a variable name")
    ---
    name_node: nfield\value
    efield: nfield\next
    while: efield != 0 && l1_node_ignored(efield\value)
        efield: efield\next
    if: efield = 0 || efield\value = 0 || efield\value\kind != c.LM_P0_NODE_ATOM || l1_text_eq(efield\value\as\atom, "[]")
        return: l1_error(path, node, "repeated [] declaration expects an extent")
    if: force_const != 0
        if: l1_write_cstr(out, "    const ") != 0
            return: 1
        ---
    else:
        if: l1_write_cstr(out, "    ") != 0
            return: 1
        ---
    ---
    if: l1_emit_type_token(out, type_node, path) != 0
        return: 1
    if: l1_write_cstr(out, " ") != 0
        return: 1
    if: l1_write_ident(out, name_node\as\atom, path, name_node) != 0
        return: 1
    if: l1_write_cstr(out, "[") != 0
        return: 1
    if: l1_ident_is_reserved(efield\value\as\atom) != 0
        return: l1_error(path, efield\value, "reserved L1 name")
    ---
    if: l1_write_text(out, efield\value\as\atom) != 0
        return: 1
    if: l1_write_cstr(out, "]") != 0
        return: 1
    efield: efield\next
    while: efield != 0 && l1_node_ignored(efield\value)
        efield: efield\next
    if: efield != 0
        if: l1_write_cstr(out, " = {") != 0
            return: 1
        if: efield\value != 0 && efield\value\kind = c.LM_P0_NODE_STRUCTURE && (efield\next = 0 || l1_node_ignored(efield\next\value))
            if: l1_emit_inits(out, efield\value\as\structure\first_field, path) != 0
                return: 1
            ---
        else:
            if: l1_emit_inits(out, efield, path) != 0
                return: 1
            ---
        ---
        if: l1_write_cstr(out, "}") != 0
            return: 1
    ---
return: l1_write_cstr(out, ";\n")

fn: l1_emit_block (@: FILE out; const: @(LmP0Structure body); const: @(char path)) int
    @: LmP0Field field
    const: @: LmP0Node node
    @: LmP0Frame inherit
    @: LmP0Frame current
    @: LmP0Frame next
    if: body = 0
        return: 0
    l1_blk_d: l1_blk_d + 1
    if: l1_register_catches(body\first_field, path) != 0
        l1_blk_d: l1_blk_d - 1
        return: 1
    ---
    field: body\first_field
    inherit: 0
    while: field != 0
        node: field\value
        current: 0
        if: inherit != 0 && node != 0 && node\kind = c.LM_P0_NODE_STRUCTURE
            current: inherit
        ---
        next: 0
        if: node != 0 && node\kind = c.LM_P0_NODE_FRAME && l1_frame_is_repeatable(node\as\frame)
            next: node\as\frame
        else:
            if: current != 0
                next: current
            ---
        ---
        if: l1_node_ignored(node) = 0
            if: current != 0
                if: l1_pointer_depth(current\head) != 0U
                    if: l1_emit_repeat_pointer(out, current, node\as\structure, path, node, 0) != 0
                        return: 1
                    ---
                else:
                    if: l1_text_eq(current\head, "[]")
                        if: l1_emit_repeat_array(out, current, node\as\structure, path, node, 0) != 0
                            return: 1
                        ---
                    else:
                        if: l1_emit_repeat_scalar(out, current\head, node\as\structure, path, node, 0) != 0
                            return: 1
                        ---
                    ---
                ---
            else:
                if: l1_emit_stmt(out, node, path) != 0
                    return: 1
                ---
            ---
        ---
        inherit: next
        field: field\next
    if: l1_emit_finallies(out, path, l1_blk_d) != 0
        l1_blk_d: l1_blk_d - 1
        return: 1
    ---
    l1_fin_pop_depth()
    l1_catch_pop()
    l1_blk_d: l1_blk_d - 1
return: 0

fn: l1_emit_fn (@: FILE out; const: @(LmP0Frame frame); const: @(char path); int: is_sub) int
    @: LmP0Field field
    const: @: LmP0Node name_node
    const: @: LmP0Node params_node
    const: @: LmP0Node third
    const: @: LmP0Node fourth
    const: @: LmP0Node extra
    const: @: LmP0Node ret_node
    const: @: LmP0Node body_node
    const: @: LmP0Text fn_name
    @: LmP0Field throws_field
    @: LmP0Field rest_field
    @: LmP0Field pf
    int: only_throws 0
    int: ar
    int: fn_i
    if: frame = 0 || frame\body = 0
        return: l1_error(path, 0, "fn without body")
    field: frame\body\first_field
    name_node: 0
    params_node: 0
    third: 0
    fourth: 0
    extra: 0
    while: field != 0
        if: l1_node_ignored(field\value) = 0
            if: name_node = 0
                name_node: field\value
            else:
                if: params_node = 0
                    params_node: field\value
                else:
                    if: third = 0
                        third: field\value
                    else:
                        if: fourth = 0
                            fourth: field\value
                        else:
                            extra: field\value
        ---
        field: field\next
    if: extra != 0
        return: l1_error(path, extra, "unexpected field after function body")
    if: name_node = 0
        return: l1_error(path, 0, "fn missing name")
    fn_name: 0
    if: name_node\kind = c.LM_P0_NODE_ATOM
        fn_name: name_node\as\atom
    else:
        if: name_node\kind = c.LM_P0_NODE_FRAME
            fn_name: name_node\as\frame\head
            if: params_node = 0
                params_node: name_node
                third: 0
                fourth: 0
            ---
        ---
    ---
    if: fn_name = 0
        return: l1_error(path, name_node, "fn name is not an identifier")
    ar: 0
    pf: 0
    if: params_node != 0 && params_node\kind = c.LM_P0_NODE_STRUCTURE && params_node\as\structure != 0
        pf: params_node\as\structure\first_field
        while: pf != 0
            if: l1_node_ignored(pf\value) = 0
                ar: ar + 1
            ---
            pf: pf\next
        ---
    ---
    fn_i: l1_fn_ensure(fn_name)
    if: fn_i >= 0
        l1_fn_ar[fn_i]: ar
    ---
    ret_node: 0
    body_node: 0
    l1_cur_void: is_sub
    l1_cur_thn: 0
    l1_allow_throws: 0
    only_throws: 0
    if: is_sub != 0
        body_node: third
        if: fourth != 0
            return: l1_error(path, fourth, "sub has no return-type slot")
        if: body_node != 0 && body_node\kind != c.LM_P0_NODE_STRUCTURE
            return: l1_error(path, body_node, "sub body must be a block")
        ---
    else:
        ret_node: third
        body_node: fourth
        if: ret_node = 0
            return: l1_error(path, name_node, "fn missing return type")
        if: body_node != 0 && body_node\kind != c.LM_P0_NODE_STRUCTURE
            return: l1_error(path, body_node, "fn body must be a block")
        ---
    ---
    throws_field: 0
    rest_field: 0
    if: body_node != 0 && body_node\as\structure != 0
        throws_field: body_node\as\structure\first_field
        while: throws_field != 0 && l1_node_ignored(throws_field\value)
            throws_field: throws_field\next
        if: throws_field != 0 && throws_field\value != 0 && throws_field\value\kind = c.LM_P0_NODE_FRAME && l1_text_eq(throws_field\value\as\frame\head, "throws")
            if: l1_record_throws(throws_field\value\as\frame, fn_name, path, throws_field\value) != 0
                return: 1
            if: l1_head_is(fn_name, "main") != 0
                return: l1_error(path, throws_field\value, "main cannot declare throws")
            l1_allow_throws: 1
            rest_field: throws_field\next
            while: rest_field != 0 && l1_node_ignored(rest_field\value)
                rest_field: rest_field\next
            if: rest_field = 0 && (frame\trailer = 0 || frame\trailer\spelling = 0 || l1_text_eq(frame\trailer\spelling, "return") = 0)
                only_throws: 1
            ---
        ---
    ---
    if: l1_cur_thn != 0 && only_throws = 0
        if: l1_emit_throw_channel(out) != 0
            return: 1
        ---
    ---
    if: is_sub != 0
        if: l1_write_cstr(out, "void") != 0
            return: 1
        ---
    else:
        if: l1_emit_type_token(out, ret_node, path) != 0
            return: 1
        ---
    ---
    if: l1_write_cstr(out, " ") != 0
        return: 1
    if: l1_write_ident(out, fn_name, path, name_node) != 0
        return: 1
    if: l1_write_cstr(out, "(") != 0
        return: 1
    if: l1_emit_param_list(out, params_node, path) != 0
        return: 1
    if: (body_node = 0 || only_throws != 0) && (frame\trailer = 0 || frame\trailer\spelling = 0 || (l1_text_eq(frame\trailer\spelling, "return") = 0 && l1_text_eq(frame\trailer\spelling, "end") = 0))
        return: l1_write_cstr(out, ");\n")
    if: l1_write_cstr(out, ")\n{\n") != 0
        return: 1
    if: body_node != 0
        if: l1_emit_block(out, body_node\as\structure, path) != 0
            return: 1
        ---
    ---
    if: frame\trailer != 0 && frame\trailer\spelling != 0 && frame\trailer\spelling\length != 0U && l1_text_eq(frame\trailer\spelling, "return")
        if: l1_emit_finallies(out, path, 1) != 0
            return: 1
        if: l1_write_cstr(out, "    return ") != 0
            return: 1
        if: l1_emit_expr(out, frame\trailer\body, path, 0) != 0
            return: 1
        if: l1_write_cstr(out, ";\n") != 0
            return: 1
    ---
    if: l1_write_cstr(out, "}\n") != 0
        return: 1
    if: is_sub = 0 && l1_validate_fn_close(frame, fn_name, "fn", path, name_node) != 0
        return: 1
    if: is_sub != 0 && l1_validate_fn_close(frame, fn_name, "sub", path, name_node) != 0
        return: 1
return: 0

fn: l1_getcwd_owned () @: char
    @: char buffer 0
    @: char grown
    size_t: capacity 64U
    while: 1
        grown: (cast: (@: char) c.realloc((cast: (@: void) buffer), capacity))
        if: grown = 0
            c.free(buffer)
            return: 0
        buffer: grown
        if: l1_getcwd(buffer, capacity) != 0
            return: buffer
        if: c.errno != c.ERANGE || capacity > ((cast: (size_t) c.INT_MAX) / 2U)
            c.free(buffer)
            return: 0
        capacity: capacity * 2U
    ---
return: 0

fn: l1_emit_os (@: FILE out; const: @(LmP0Frame frame); const: @(char path); int: depth) int
    @: LmP0Field field
    @: LmP0Field inner
    if: l1_write_cstr(out, "#ifdef _WIN32\n") != 0
        return: 1
    if: frame != 0 && frame\body != 0
        field: frame\body\first_field
        while: field != 0
            if: l1_node_ignored(field\value) = 0 && field\value != 0 && field\value\kind = c.LM_P0_NODE_FRAME && l1_text_eq(field\value\as\frame\head, "win") && field\value\as\frame\body != 0
                inner: field\value\as\frame\body\first_field
                while: inner != 0
                    if: l1_emit_item(out, inner\value, path, 1, depth) != 0
                        return: 1
                    inner: inner\next
                ---
            ---
            field: field\next
        ---
    ---
    if: l1_write_cstr(out, "#else\n") != 0
        return: 1
    if: frame != 0 && frame\body != 0
        field: frame\body\first_field
        while: field != 0
            if: l1_node_ignored(field\value) = 0 && field\value != 0 && field\value\kind = c.LM_P0_NODE_FRAME && l1_text_eq(field\value\as\frame\head, "default") && field\value\as\frame\body != 0
                inner: field\value\as\frame\body\first_field
                while: inner != 0
                    if: l1_emit_item(out, inner\value, path, 1, depth) != 0
                        return: 1
                    inner: inner\next
                ---
            ---
            field: field\next
        ---
    ---
return: l1_write_cstr(out, "#endif\n")

fn: l1_emit_ifdef_body (@: FILE out; const: @(LmP0Structure body); const: @(char path); int: as_stmt; int: depth) int
    @: LmP0Field field
    if: body = 0
        return: 0
    if: as_stmt != 0
        return: l1_emit_block(out, body, path)
    field: body\first_field
    while: field != 0
        if: l1_node_ignored(field\value) = 0
            if: l1_emit_item(out, field\value, path, 1, depth) != 0
                return: 1
        ---
        field: field\next
return: 0

fn: l1_emit_ifdef (@: FILE out; const: @(LmP0Frame frame); const: @(char path); int: as_stmt; int: depth; const: @(LmP0Node owner)) int
    @: LmP0Field field
    const: @: LmP0Node node
    const: @: LmP0Frame branch
    int: opened 0
    int: emitted_default 0
    if: frame = 0
        return: 1
    field: 0
    if: frame\body != 0
        field: frame\body\first_field
    ---
    while: field != 0
        node: field\value
        if: l1_node_ignored(node) = 0
            if: node = 0 || node\kind != c.LM_P0_NODE_FRAME
                return: l1_error(path, node, "ifdef receiver expects condition/default frames")
            branch: node\as\frame
            if: l1_text_eq(branch\head, "default")
                if: emitted_default != 0
                    return: l1_error(path, node, "ifdef receiver has duplicate default branch")
                emitted_default: 1
                if: opened != 0
                    if: l1_write_cstr(out, "#else\n") != 0
                        return: 1
                    ---
                ---
            else:
                if: emitted_default != 0
                    return: l1_error(path, node, "ifdef default branch must be last")
                if: opened != 0
                    if: l1_write_cstr(out, "#elif ") != 0
                        return: 1
                    ---
                else:
                    if: l1_write_cstr(out, "#if ") != 0
                        return: 1
                    ---
                ---
                if: l1_write_ifdef_condition(out, branch\head, path, node) != 0
                    return: 1
                if: l1_write_cstr(out, "\n") != 0
                    return: 1
                opened: 1
            ---
            if: l1_emit_ifdef_body(out, branch\body, path, as_stmt, depth) != 0
                return: 1
            if: l1_validate_end_trailer(branch, path, node) != 0
                return: 1
        ---
        field: field\next
    if: opened != 0
        if: l1_write_cstr(out, "#endif\n") != 0
            return: 1
        ---
    ---
    if: l1_validate_end_trailer(frame, path, owner) != 0
        return: 1
return: 0

fn: l1_emit_define (@: FILE out; const: @(LmP0Frame frame); const: @(char path); const: @(LmP0Node owner); int: ifndef_default) int
    @: LmP0Field field
    @: LmP0Field param
    const: @: LmP0Node node
    const: @: LmP0Frame call
    const: @: LmP0Text atom
    size_t: start 0U
    size_t: n 0U
    int: first_param 1
    if: frame = 0
        return: 1
    field: 0
    if: frame\body != 0
        field: frame\body\first_field
    ---
    while: field != 0 && l1_node_ignored(field\value)
        field: field\next
    if: field != 0 && field\value != 0 && field\value\kind = c.LM_P0_NODE_FRAME
        if: ifndef_default != 0 || l1_hdr_emitting = 0
            return: l1_error(path, owner, "function-like macro")
        call: field\value\as\frame
        atom: call\head
        if: atom = 0 || atom\data = 0 || atom\length = 0U || atom\data[0] = 34 || atom\data[0] = 39
            return: l1_error(path, field\value, "define receiver expects macro name as identifier atom")
        n: atom\length
        if: n >= 2U && atom\data[0] = 96 && atom\data[n - 1U] = 96
            start: 1U
            n: n - 2U
        ---
        if: n = 0U
            return: l1_error(path, field\value, "define receiver expects macro name as identifier atom")
        if: l1_ident_is_reserved(atom) != 0
            return: l1_error(path, field\value, "reserved L1 name")
        ---
        if: l1_write_cstr(out, "#define ") != 0
            return: 1
        if: l1_write_span(out, atom\data + start, n) != 0
            return: 1
        if: l1_write_cstr(out, "(") != 0
            return: 1
        param: 0
        if: call\body != 0
            param: call\body\first_field
        ---
        while: param != 0
            if: l1_node_ignored(param\value) = 0
                if: param\value = 0 || param\value\kind != c.LM_P0_NODE_ATOM
                    return: l1_error(path, param\value, "function-like macro parameter expects an identifier")
                atom: param\value\as\atom
                if: atom = 0 || atom\data = 0 || atom\length = 0U || atom\data[0] = 34 || atom\data[0] = 39
                    return: l1_error(path, param\value, "function-like macro parameter expects an identifier")
                start: 0U
                n: atom\length
                if: n >= 2U && atom\data[0] = 96 && atom\data[n - 1U] = 96
                    start: 1U
                    n: n - 2U
                ---
                if: n = 0U || l1_ident_is_reserved(atom) != 0
                    return: l1_error(path, param\value, "function-like macro parameter expects an identifier")
                ---
                if: first_param = 0
                    if: l1_write_cstr(out, ", ") != 0
                        return: 1
                    ---
                ---
                first_param: 0
                if: l1_write_span(out, atom\data + start, n) != 0
                    return: 1
                ---
            ---
            param: param\next
        ---
        if: l1_write_cstr(out, ")") != 0
            return: 1
        field: field\next
    else:
        if: field = 0 || field\value = 0 || field\value\kind != c.LM_P0_NODE_ATOM
            if: ifndef_default != 0
                return: l1_error(path, owner, "ifndef-default receiver expects macro name as first atom")
            return: l1_error(path, owner, "define receiver expects macro name as first atom")
        atom: field\value\as\atom
        if: atom = 0 || atom\data = 0 || atom\length = 0U || atom\data[0] = 34 || atom\data[0] = 39
            if: ifndef_default != 0
                return: l1_error(path, field\value, "ifndef-default receiver expects macro name as identifier atom")
            return: l1_error(path, field\value, "define receiver expects macro name as identifier atom")
        n: atom\length
        if: n >= 2U && atom\data[0] = 96 && atom\data[n - 1U] = 96
            start: 1U
            n: n - 2U
        ---
        if: n = 0U
            if: ifndef_default != 0
                return: l1_error(path, field\value, "ifndef-default receiver expects macro name as identifier atom")
            return: l1_error(path, field\value, "define receiver expects macro name as identifier atom")
        if: l1_ident_is_reserved(atom) != 0
            return: l1_error(path, field\value, "reserved L1 name")
        ---
        if: ifndef_default != 0
            if: l1_write_cstr(out, "#ifndef ") != 0
                return: 1
            if: l1_write_span(out, atom\data + start, n) != 0
                return: 1
            if: l1_write_cstr(out, "\n") != 0
                return: 1
        ---
        if: l1_write_cstr(out, "#define ") != 0
            return: 1
        if: l1_write_span(out, atom\data + start, n) != 0
            return: 1
        field: field\next
    ---
    while: field != 0
        if: l1_node_ignored(field\value) = 0
            node: field\value
            if: node = 0
                if: ifndef_default != 0
                    return: l1_error(path, node, "ifndef-default receiver expects atom tokens")
                return: l1_error(path, node, "define receiver expects atom tokens")
            if: node\kind = c.LM_P0_NODE_STRUCTURE && l1_hdr_emitting != 0 && ifndef_default = 0
                if: l1_write_cstr(out, " ") != 0
                    return: 1
                if: l1_emit_define_repl_structure(out, node\as\structure, path, node) != 0
                    return: 1
                ---
            else:
                if: node\kind != c.LM_P0_NODE_ATOM
                    if: ifndef_default != 0
                        return: l1_error(path, node, "ifndef-default receiver expects atom tokens")
                    return: l1_error(path, node, "define receiver expects atom tokens")
                atom: node\as\atom
                if: atom = 0 || atom\data = 0
                    if: ifndef_default != 0
                        return: l1_error(path, node, "ifndef-default receiver expects atom tokens")
                    return: l1_error(path, node, "define receiver expects atom tokens")
                start: 0U
                n: atom\length
                if: n >= 2U && atom\data[0] = 96 && atom\data[n - 1U] = 96
                    start: 1U
                    n: n - 2U
                ---
                if: l1_ident_is_reserved(atom) != 0
                    return: l1_error(path, node, "reserved L1 name")
                ---
                if: l1_write_cstr(out, " ") != 0
                    return: 1
                if: l1_write_span(out, atom\data + start, n) != 0
                    return: 1
                ---
            ---
        ---
        field: field\next
    if: l1_write_cstr(out, "\n") != 0
        return: 1
    if: ifndef_default != 0
        if: l1_write_cstr(out, "#endif\n") != 0
            return: 1
    ---
return: l1_validate_end_trailer(frame, path, owner)






fn: l1_emit_l1_body (@: FILE out; const: @(LmP0Structure body); const: @(char path); int: depth) int
    @: LmP0Field field
    if: body = 0
        return: 0
    field: body\first_field
    while: field != 0
        if: l1_fn_register_node(field\value, path) != 0
            return: 1
        field: field\next
    field: body\first_field
    while: field != 0
        if: l1_node_ignored(field\value) = 0 && field\value != 0 && field\value\kind = c.LM_P0_NODE_FRAME && l1_text_eq(field\value\as\frame\head, "predef")
            if: l1_emit_import(out, field\value\as\frame, path, depth) != 0
                return: 1
            ---
        ---
        field: field\next
    field: body\first_field
    while: field != 0
        if: l1_node_ignored(field\value) = 0 && (field\value = 0 || field\value\kind != c.LM_P0_NODE_FRAME || l1_text_eq(field\value\as\frame\head, "predef") = 0)
            if: l1_emit_item(out, field\value, path, 1, depth) != 0
                return: 1
            ---
        ---
        field: field\next
return: 0

fn: l1_emit_implicit_l1 (@: FILE out; const: @(LmP0Node root); const: @(char path); int: depth) int
    if: root = 0
        return: l1_error(path, 0, "empty implicit L1 body")
    if: l1_fn_register_node(root, path) != 0
        return: 1
    if: l1_validate_implicit_node(root, path, 1) != 0
        return: 1
    if: root\kind = c.LM_P0_NODE_STRUCTURE
        if: root\as\structure = 0 || root\as\structure\first_field = 0
            return: l1_error(path, 0, "empty implicit L1 body")
        return: l1_emit_l1_body(out, root\as\structure, path, depth)
    if: root\kind = c.LM_P0_NODE_FRAME && l1_text_eq(root\as\frame\head, "predef")
        return: l1_emit_import(out, root\as\frame, path, depth)
return: l1_emit_item(out, root, path, 1, depth)




fn: l1_hdr_include_path (@: char dst; size_t: cap; const: @(char in_path); const: @(LmP0Node node)) int
    size_t: n 0U
    if: dst = 0 || cap < 8U
        return: 1
    if: l1_unit_id_from_source(dst, cap, in_path, in_path, node) != 0
        return: 1
    n: c.strlen(dst)
    if: n < 6U || l1_path_is_h_lm1(dst) = 0
        return: l1_error(in_path, node, "generated header name too long")
    c.memcpy(dst + n - 6U, ".lm1.h", 6U)
return: 0

fn: l1_hdr_register_unit (const: @(LmP0Node root); const: @(char path); int: depth) int
    @: LmP0Field field
    @: LmP0Field inner
    const: @: LmP0Node node
    @: LmP0Text resolved 0
    int: status
    finally:
        l1_path_text_delete(resolved)
    if: root = 0 || root\kind != c.LM_P0_NODE_STRUCTURE
        return: l1_error(path, root, "header unit expects a structure body")
    field: root\as\structure\first_field
    while: field != 0
        node: field\value
        if: l1_node_ignored(node) = 0 && node != 0 && node\kind = c.LM_P0_NODE_FRAME && l1_text_eq(node\as\frame\head, "predef")
            inner: 0
            if: node\as\frame\body != 0
                inner: node\as\frame\body\first_field
            ---
            while: inner != 0
                if: l1_node_ignored(inner\value) = 0
                    if: inner\value = 0 || inner\value\kind != c.LM_P0_NODE_ATOM
                        return: l1_error(path, inner\value, "import expects a string path")
                    l1_path_text_delete(resolved)
                    resolved: l1_import_path_text(inner\value\as\atom, path)
                    if: resolved = 0
                        return: l1_error(path, inner\value, "cannot allocate import path")
                    if: l1_path_is_h_lm1(resolved\data) = 0
                        return: l1_error(path, inner\value, "header unit predef expects a header source")
                    status: l1_hdr_register_path(resolved\data, depth + 1)
                    if: status != 0
                        return: status
                    ---
                ---
                inner: inner\next
            ---
        else:
            if: l1_hdr_check_item(node, path) != 0
                return: 1
            ---
        ---
        field: field\next
return: 0


fn: l1_hdr_register_path (const: @(char in_path); int: depth) int
    @: LmP0Document document 0
    const: @: LmP0Node root
    int: status
    if: in_path = 0 || l1_path_is_h_lm1(in_path) = 0
        return: l1_error(in_path, 0, "header unit predef expects a header source")
    if: l1_imp_find(l1_imp_act, l1_imp_actn, in_path) >= 0
        c.fprintf(c.stderr, "l1trans error: import cycle %s\n", in_path)
        return: 1
    if: l1_imp_find(l1_imp_done, l1_imp_donen, in_path) >= 0
        return: 0
    if: l1_imp_push(1, in_path) != 0
        return: l1_error(in_path, 0, "cannot store import path")
    status: lm_p0_parse_file(in_path, @ document)
    if: status != 0
        c.fprintf(c.stderr, "l1trans error: cannot read import %s\n", in_path)
        lm_p0_document_destroy(document)
        l1_imp_pop()
        return: 1
    root: lm_p0_document_root(document)
    if: root = 0
        lm_p0_document_destroy(document)
        c.fprintf(c.stderr, "l1trans error: %s:1:1: empty implicit L1 body\n", in_path)
        l1_imp_pop()
        return: 1
    if: l1_hdr_register_unit(root, in_path, depth) != 0
        lm_p0_document_destroy(document)
        l1_imp_pop()
        return: 1
    if: l1_hdr_mark_unit_emitted(root, in_path) != 0
        lm_p0_document_destroy(document)
        l1_imp_pop()
        return: 1
    lm_p0_document_destroy(document)
    l1_imp_pop()
    if: l1_imp_push(0, in_path) != 0
        return: l1_error(in_path, 0, "cannot store import path")
return: 0

fn: l1_emit_imported (@: FILE out; const: @(char in_path); int: depth) int
    @: LmP0Document document 0
    const: @: char saved_src
    size_t: saved_n
    const: @: LmP0Node root
    @: LmP0Field field
    int: status
    @: char hdr_name 0
    size_t: hdr_cap 0U
    finally:
        c.free(hdr_name)
    if: l1_imp_find(l1_imp_act, l1_imp_actn, in_path) >= 0
        c.fprintf(c.stderr, "l1trans error: import cycle %s\n", in_path)
        return: 1
    if: l1_imp_find(l1_imp_done, l1_imp_donen, in_path) >= 0
        return: 0
    if: l1_imp_push(1, in_path) != 0
        return: l1_error(in_path, 0, "cannot store import path")
    status: lm_p0_parse_file(in_path, @ document)
    if: status != 0
        c.fprintf(c.stderr, "l1trans error: cannot read import %s\n", in_path)
        lm_p0_document_destroy(document)
        l1_imp_pop()
        return: 1
    root: lm_p0_document_root(document)
    if: l1_path_is_lm1(in_path) != 0
        if: root = 0
            lm_p0_document_destroy(document)
            c.fprintf(c.stderr, "l1trans error: %s:1:1: empty implicit L1 body\n", in_path)
            l1_imp_pop()
            return: 1
        ---
    else:
        if: l1_path_is_lm2(in_path) = 0
            lm_p0_document_destroy(document)
            c.fprintf(c.stderr, "l1trans error: %s:1:1: l1trans expects a .lm1 or .lm2 source\n", in_path)
            l1_imp_pop()
            return: 1
        if: root = 0 || l1_scan_l1(root) = 0
            lm_p0_document_destroy(document)
            c.fprintf(c.stderr, "l1trans error: %s:1:1: missing L1 body\n", in_path)
            l1_imp_pop()
            return: 1
        ---
    ---
    if: l1_path_is_h_lm1(in_path) != 0
        hdr_cap: l1_path_capacity(c.strlen(in_path), 0U)
        if: hdr_cap = 0
            lm_p0_document_destroy(document)
            l1_imp_pop()
            return: l1_error(in_path, 0, "cannot allocate header path")
        hdr_name: (cast: (@: char) c.malloc(hdr_cap))
        if: hdr_name = 0
            lm_p0_document_destroy(document)
            l1_imp_pop()
            return: l1_error(in_path, 0, "cannot allocate header path")
        if: l1_hdr_include_path(hdr_name, hdr_cap, in_path, root) != 0
            lm_p0_document_destroy(document)
            l1_imp_pop()
            return: 1
        if: l1_hdr_register_unit(root, in_path, depth) != 0
            lm_p0_document_destroy(document)
            l1_imp_pop()
            return: 1
        if: l1_write_cstr(out, "#include \"") != 0
            lm_p0_document_destroy(document)
            l1_imp_pop()
            return: 1
        if: l1_write_cstr(out, hdr_name) != 0
            lm_p0_document_destroy(document)
            l1_imp_pop()
            return: 1
        if: l1_write_cstr(out, "\"\n") != 0
            lm_p0_document_destroy(document)
            l1_imp_pop()
            return: 1
        lm_p0_document_destroy(document)
        l1_imp_pop()
        if: l1_imp_push(0, in_path) != 0
            return: l1_error(in_path, 0, "cannot store import path")
        return: 0
    ---
    saved_src: l1_src
    saved_n: l1_srcn
    l1_src: 0
    l1_srcn: 0
    if: l1_src_load(in_path) != 0
        l1_src: saved_src
        l1_srcn: saved_n
        lm_p0_document_destroy(document)
        l1_imp_pop()
        return: 1
    ---
    if: l1_path_is_lm1(in_path) != 0
        if: l1_emit_implicit_l1(out, root, in_path, depth) != 0
            l1_src_release()
            l1_src: saved_src
            l1_srcn: saved_n
            lm_p0_document_destroy(document)
            l1_imp_pop()
            return: 1
        ---
    else:
        if: root\kind = c.LM_P0_NODE_STRUCTURE
            field: root\as\structure\first_field
            while: field != 0
                if: l1_emit_item(out, field\value, in_path, 0, depth) != 0
                    l1_src_release()
                    l1_src: saved_src
                    l1_srcn: saved_n
                    lm_p0_document_destroy(document)
                    l1_imp_pop()
                    return: 1
                field: field\next
            ---
        else:
            if: l1_emit_item(out, root, in_path, 0, depth) != 0
                l1_src_release()
                l1_src: saved_src
                l1_srcn: saved_n
                lm_p0_document_destroy(document)
                l1_imp_pop()
                return: 1
            ---
        ---
    ---
    l1_src_release()
    l1_src: saved_src
    l1_srcn: saved_n
    lm_p0_document_destroy(document)
    l1_imp_pop()
    if: l1_imp_push(0, in_path) != 0
        return: l1_error(in_path, 0, "cannot store import path")
return: 0

fn: l1_emit_import (@: FILE out; const: @(LmP0Frame frame); const: @(char path); int: depth) int
    @: LmP0Field field
    const: @: LmP0Node node
    @: LmP0Text resolved 0
    int: status
    finally:
        l1_path_text_delete(resolved)
    if: frame = 0 || frame\body = 0
        return: l1_error(path, 0, "import without path")
    field: frame\body\first_field
    while: field != 0
        node: field\value
        if: l1_node_ignored(node) = 0
            if: node = 0 || node\kind != c.LM_P0_NODE_ATOM
                return: l1_error(path, node, "import expects a string path")
            l1_path_text_delete(resolved)
            resolved: l1_import_path_text(node\as\atom, path)
            if: resolved = 0
                return: l1_error(path, node, "cannot allocate import path")
            status: l1_emit_imported(out, resolved\data, depth + 1)
            if: status != 0
                return: status
            ---
        ---
        field: field\next
return: 0

fn: l1_emit_item (@: FILE out; const: @(LmP0Node node); const: @(char path); int: in_l1; int: depth) int
    @: LmP0Field field
    if: l1_node_ignored(node)
        return: 0
    if: node = 0 || node\kind != c.LM_P0_NODE_FRAME
        return: 0
    if: l1_text_eq(node\as\frame\head, "L1")
        return: l1_emit_l1_body(out, node\as\frame\body, path, depth)
    if: in_l1 = 0
        if: l1_text_eq(node\as\frame\head, "L2") || l1_text_eq(node\as\frame\head, "L3") || l1_text_eq(node\as\frame\head, "end")
            return: 0
        return: 0
    if: l1_text_eq(node\as\frame\head, "include")
        return: l1_emit_include(out, node\as\frame, path)
    if: l1_text_eq(node\as\frame\head, "extern")
        return: l1_emit_extern_decl(out, node\as\frame, path)
    # foreign: <name> -- the name is a type the included C header declares (FILE is
    # the hardcoded precedent).  It registers the name so fields, params and aliases
    # can use it, and emits nothing: the C spelling is the name itself.
    if: l1_text_eq(node\as\frame\head, "foreign")
        return: 0
    if: l1_text_eq(node\as\frame\head, "import") || l1_text_eq(node\as\frame\head, "predef")
        return: l1_emit_import(out, node\as\frame, path, depth)
    if: l1_text_eq(node\as\frame\head, "os")
        return: l1_emit_os(out, node\as\frame, path, depth)
    if: l1_text_eq(node\as\frame\head, "ifdef")
        return: l1_emit_ifdef(out, node\as\frame, path, 0, depth, node)
    if: l1_head_is(node\as\frame\head, "define")
        return: l1_emit_define(out, node\as\frame, path, node, 0)
    if: l1_head_is(node\as\frame\head, "ifndef-default")
        return: l1_emit_define(out, node\as\frame, path, node, 1)
    if: l1_text_eq(node\as\frame\head, "prototype")
        if: node\as\frame\body = 0
            return: 0
        field: node\as\frame\body\first_field
        while: field != 0
            if: l1_emit_item(out, field\value, path, in_l1, depth) != 0
                return: 1
            field: field\next
        return: 0
    if: l1_text_eq(node\as\frame\head, "external")
        if: node\as\frame\body = 0 || node\as\frame\body\first_field = 0
            return: l1_error(path, node, "external without fn")
        return: l1_emit_item(out, node\as\frame\body\first_field\value, path, in_l1, depth)
    if: l1_text_eq(node\as\frame\head, "fn")
        return: l1_emit_fn(out, node\as\frame, path, 0)
    if: l1_text_eq(node\as\frame\head, "sub")
        return: l1_emit_fn(out, node\as\frame, path, 1)
    if: l1_text_eq(node\as\frame\head, "end")
        return: 0
    if: l1_pointer_depth(node\as\frame\head) != 0U || l1_text_eq(node\as\frame\head, "const") || l1_is_type_name(node\as\frame\head) || l1_text_eq(node\as\frame\head, "c.array") || l1_text_starts(node\as\frame\head, "[]") || l1_text_eq(node\as\frame\head, "immutable") || l1_text_eq(node\as\frame\head, "thread_local")
        return: l1_emit_stmt(out, node, path)
    if: l1_text_eq(node\as\frame\head, "win") || l1_text_eq(node\as\frame\head, "default")
        return: 0
    if: l1_text_eq(node\as\frame\head, "L2") || l1_text_eq(node\as\frame\head, "L3")
        return: 0
    if: (node\as\frame\flags & c.LM_P0_FRAME_COLON) != 0U && l1_head_is_unknown_type(node\as\frame\head)
        return: l1_error(path, node, "unknown type name")
return: l1_error(path, node, "unsupported L1 form")


fn: l1_emit_extern_decl (@: FILE out; const: @(LmP0Frame frame); const: @(char path)) int
    # extern: <a data declaration> -- a DECLARATION of an object whose definition
    # belongs to another translation unit (the L2 unit globals, lmx_turn_running).
    # L1 had only definitions, so the parser's ABI adapters could not be written in
    # it at all; the object grammar after `extern:` is the ordinary one.
    @: LmP0Field field
    if: frame = 0 || frame\body = 0
        return: l1_error(path, 0, "extern declaration missing")
    field: frame\body\first_field
    while: field != 0 && l1_node_ignored(field\value)
        field: field\next
    if: field = 0 || field\value = 0
        return: l1_error(path, 0, "extern declaration missing")
    if: l1_write_cstr(out, "extern ") != 0
        return: 1
    return: l1_emit_data_decl(out, field\value, path, 0)





fn: l1_unit_id_from_source (@: char dst; size_t: cap; const: @(char in_path); const: @(char path); const: @(LmP0Node node)) int
    @: char cwd 0
    @: char abs_in 0
    @: char abs_root 0
    @: char norm 0
    const: @: char root
    size_t: root_n 0U
    size_t: in_n 0U
    size_t: root_cap 0U
    size_t: in_cap 0U
    finally:
        c.free(cwd)
        c.free(abs_in)
        c.free(abs_root)
        c.free(norm)
    if: in_path = 0
        return: l1_error(path, node, "missing source path")
    if: l1_unit_root_set != 0
        root: l1_unit_root
    else:
        cwd: l1_getcwd_owned()
        if: cwd = 0
            return: l1_error(path, node, "cannot read current directory")
        root: cwd
    ---
    root_cap: l1_path_capacity(c.strlen(root), 0U)
    if: root_cap = 0
        return: l1_error(path, node, "cannot allocate unit root path")
    abs_root: (cast: (@: char) c.malloc(root_cap))
    if: abs_root = 0
        return: l1_error(path, node, "cannot allocate unit root path")
    if: l1_path_norm_into(abs_root, root_cap, root, path, node) != 0
        return: 1
    in_cap: l1_path_capacity(c.strlen(abs_root), c.strlen(in_path))
    if: in_cap = 0
        return: l1_error(path, node, "cannot allocate source path")
    abs_in: (cast: (@: char) c.malloc(in_cap))
    if: abs_in = 0
        return: l1_error(path, node, "cannot allocate source path")
    if: l1_path_is_absolute(in_path) != 0
        if: l1_path_norm_into(abs_in, in_cap, in_path, path, node) != 0
            return: 1
        ---
    else:
        norm: (cast: (@: char) c.malloc(in_cap))
        if: norm = 0
            return: l1_error(path, node, "cannot allocate source path")
        c.snprintf(abs_in, in_cap, "%s/%s", abs_root, in_path)
        if: l1_path_norm_into(norm, in_cap, abs_in, path, node) != 0
            return: 1
        c.strcpy(abs_in, norm)
    ---
    root_n: c.strlen(abs_root)
    in_n: c.strlen(abs_in)
    if: in_n < root_n || l1_ascii_ieq_prefix(abs_in, abs_root, root_n) = 0
        return: l1_error(path, node, "source outside the unit root")
    if: in_n = root_n
        return: l1_error(path, node, "source outside the unit root")
    if: abs_in[root_n] != 47
        return: l1_error(path, node, "source outside the unit root")
    if: l1_path_norm_into(dst, cap, abs_in + root_n + 1U, path, node) != 0
        return: 1
return: 0


fn: l1_emit_hdr_field_decl (@: FILE out; const: @(LmP0Node node); const: @(char path); int: with_indent; int: force_const) int
    @: LmP0Field field
    @: LmP0Field extra
    @: LmP0Frame frame
    const: @: LmP0Text head
    const: @: LmP0Node name_node
    const: @: LmP0Node child
    int: rank 0
    size_t: hi 0U
    int: i 0
    int: saw 0
    size_t: pointer_depth
    if: node = 0 || node\kind != c.LM_P0_NODE_FRAME
        return: l1_error(path, node, "struct field expects a declaration frame")
    frame: node\as\frame
    head: frame\head
    if: l1_text_eq(head, "union")
        return: l1_error(path, node, "union")
    if: l1_text_eq(head, "immutable")
        if: l1_validate_end_trailer(frame, path, node) != 0
            return: 1
        field: 0
        if: frame\body != 0
            field: frame\body\first_field
        ---
        while: field != 0
            child: field\value
            if: l1_node_ignored(child) = 0
                if: child = 0 || child\kind != c.LM_P0_NODE_FRAME
                    return: l1_error(path, child, "immutable expects declarations")
                if: l1_emit_hdr_field_decl(out, child, path, 1, 1) != 0
                    return: 1
                saw: 1
            ---
            field: field\next
        if: saw = 0
            return: l1_error(path, node, "immutable expects declarations")
        return: 0
    if: with_indent != 0
        if: l1_write_cstr(out, "    ") != 0
            return: 1
        ---
    ---
    field: 0
    if: frame\body != 0
        field: frame\body\first_field
    ---
    while: field != 0 && l1_node_ignored(field\value)
        field: field\next
    if: l1_text_eq(head, "const")
        if: l1_write_cstr(out, "const ") != 0
            return: 1
        if: field = 0 || field\value = 0 || field\value\kind != c.LM_P0_NODE_FRAME
            return: l1_error(path, node, "const declaration missing type")
        return: l1_emit_hdr_field_decl(out, field\value, path, 0, 0)
    if: force_const != 0
        if: l1_write_cstr(out, "const ") != 0
            return: 1
        ---
    ---
    if: l1_text_eq(head, "[]") || l1_text_starts(head, "[]")
        rank: 0
        hi: 0U
        if: head != 0 && head\data != 0
            while: hi + 1U < head\length && head\data[hi] = 91 && head\data[hi + 1U] = 93
                rank: rank + 1
                hi: hi + 2U
            ---
        ---
        if: rank = 0
            rank: 1
        ---
        extra: field
        i: 0
        while: i < rank + 2
            if: extra != 0
                extra: extra\next
            ---
            while: extra != 0 && l1_node_ignored(extra\value)
                extra: extra\next
            i: i + 1
        ---
        if: extra != 0
            return: l1_error(path, extra\value, "struct field array cannot have initializer")
        return: l1_emit_bracket_array(out, frame, path, 0)
    if: l1_pointer_depth(head) != 0U
        pointer_depth: l1_pointer_depth(head)
        if: field = 0 || field\value = 0
            return: l1_error(path, node, "pointer declaration missing type")
        if: field\value\kind = c.LM_P0_NODE_ATOM
            if: l1_write_type_spelling(out, field\value\as\atom, path, field\value) != 0
                return: 1
            ---
        else:
            if: l1_emit_type_token(out, field\value, path) != 0
                return: 1
            ---
        ---
        if: l1_write_cstr(out, " ") != 0 || l1_emit_stars(out, pointer_depth) != 0 || l1_write_cstr(out, " ") != 0
            return: 1
        field: field\next
        while: field != 0 && l1_node_ignored(field\value)
            field: field\next
        if: field = 0 || field\value = 0 || field\value\kind != c.LM_P0_NODE_ATOM
            return: l1_error(path, node, "declaration expects a name")
        if: l1_write_ident(out, field\value\as\atom, path, field\value) != 0
            return: 1
        return: l1_write_cstr(out, ";\n")
    if: l1_is_type_name(head) = 0 && l1_hdr_type_has(head) = 0
        return: l1_error(path, node, "unsupported struct field")
    if: l1_write_type_spelling(out, head, path, node) != 0
        return: 1
    if: field = 0 || field\value = 0 || field\value\kind != c.LM_P0_NODE_ATOM
        return: l1_error(path, node, "declaration expects a name")
    name_node: field\value
    if: l1_write_cstr(out, " ") != 0
        return: 1
    if: l1_write_ident(out, name_node\as\atom, path, name_node) != 0
        return: 1
return: l1_write_cstr(out, ";\n")

fn: l1_emit_hdr_struct_def (@: FILE out; const: @(LmP0Frame frame); const: @(char path); const: @(LmP0Node node)) int
    const: @: LmP0Text name
    @: LmP0Structure fields
    @: LmP0Field field
    name: l1_hdr_frame_name(frame)
    if: name = 0
        return: l1_error(path, node, "struct missing name")
    if: l1_hdr_validate_end_name(frame, name, path, node) != 0
        return: 1
    fields: l1_hdr_fields_structure(frame)
    if: l1_write_cstr(out, "struct ") != 0
        return: 1
    if: l1_write_ident(out, name, path, node) != 0
        return: 1
    if: l1_write_cstr(out, " {\n") != 0
        return: 1
    if: fields != 0
        field: fields\first_field
        while: field != 0
            if: l1_node_ignored(field\value) = 0
                if: l1_emit_hdr_field_decl(out, field\value, path, 1, 0) != 0
                    return: 1
                ---
            ---
            field: field\next
        ---
    ---
return: l1_write_cstr(out, "};\n\n")










fn: l1_emit_hdr_prototype (@: FILE out; const: @(LmP0Node node); const: @(char path)) int
    @: LmP0Field field
    if: node = 0 || node\kind != c.LM_P0_NODE_FRAME
        return: 1
    if: node\as\frame\body = 0
        return: 0
    field: node\as\frame\body\first_field
    while: field != 0
        if: l1_node_ignored(field\value) = 0
            if: field\value = 0 || field\value\kind != c.LM_P0_NODE_FRAME
                return: l1_error(path, field\value, "prototype expects fn/sub")
            if: l1_text_eq(field\value\as\frame\head, "fn")
                if: l1_emit_fn(out, field\value\as\frame, path, 0) != 0
                    return: 1
                ---
            else:
                if: l1_text_eq(field\value\as\frame\head, "sub")
                    if: l1_emit_fn(out, field\value\as\frame, path, 1) != 0
                        return: 1
                    ---
                else:
                    return: l1_error(path, field\value, "prototype expects fn/sub")
                ---
            ---
        ---
        field: field\next
return: 0

fn: l1_hdr_emit_predef_includes (@: FILE out; const: @(LmP0Frame frame); const: @(char path)) int
    @: LmP0Field field
    const: @: LmP0Node node
    @: LmP0Text resolved 0
    @: char hdr_name 0
    size_t: capacity
    finally:
        l1_path_text_delete(resolved)
        c.free(hdr_name)
    if: frame = 0 || frame\body = 0
        return: l1_error(path, 0, "import without path")
    field: frame\body\first_field
    while: field != 0
        node: field\value
        if: l1_node_ignored(node) = 0
            if: node = 0 || node\kind != c.LM_P0_NODE_ATOM
                return: l1_error(path, node, "import expects a string path")
            l1_path_text_delete(resolved)
            resolved: l1_import_path_text(node\as\atom, path)
            if: resolved = 0
                return: l1_error(path, node, "cannot allocate import path")
            if: l1_path_is_h_lm1(resolved\data) = 0
                return: l1_error(path, node, "header unit predef expects a header source")
            capacity: l1_path_capacity(resolved\length, 0U)
            if: capacity = 0U
                return: l1_error(path, node, "path size overflow")
            c.free(hdr_name)
            hdr_name: (cast: (@: char) c.malloc(capacity))
            if: hdr_name = 0
                return: l1_error(path, node, "cannot allocate header path")
            if: l1_hdr_include_path(hdr_name, capacity, resolved\data, node) != 0
                return: 1
            if: l1_write_cstr(out, "#include \"") != 0
                return: 1
            if: l1_write_cstr(out, hdr_name) != 0
                return: 1
            if: l1_write_cstr(out, "\"\n") != 0
                return: 1
            ---
        ---
        field: field\next
return: 0

fn: l1_emit_header_unit (@: FILE out; const: @(LmP0Node root); const: @(char in_path); const: @(char unit_id)) int
    @: LmP0Field field
    const: @: LmP0Node node
    const: @: LmP0Frame frame
    const: @: LmP0Text name
    []: char nbuf 64
    int: progress 1
    int: remaining 0
    if: root = 0 || root\kind != c.LM_P0_NODE_STRUCTURE
        return: l1_error(in_path, root, "header unit expects a structure body")
    if: l1_fn_register_node(root, in_path) != 0
        return: 1
    l1_hdr_type_reset()
    l1_hdr_emitting: 1
    if: l1_imp_push(1, in_path) != 0
        return: l1_error(in_path, 0, "cannot store import path")
    if: l1_hdr_register_unit(root, in_path, 0) != 0
        l1_imp_pop()
        return: 1
    l1_imp_pop()
    if: l1_write_cstr(out, "/* generated by l1trans from ") != 0
        return: 1
    if: l1_write_cstr(out, unit_id) != 0
        return: 1
    if: l1_write_cstr(out, " */\n#ifndef LM_H_") != 0
        return: 1
    if: l1_write_guard_escape(out, unit_id) != 0
        return: 1
    if: l1_write_cstr(out, "\n#define LM_H_") != 0
        return: 1
    if: l1_write_guard_escape(out, unit_id) != 0
        return: 1
    if: l1_write_cstr(out, "\n\n") != 0
        return: 1
    field: root\as\structure\first_field
    while: field != 0
        node: field\value
        if: l1_node_ignored(node) = 0 && node != 0 && node\kind = c.LM_P0_NODE_FRAME
            if: l1_text_eq(node\as\frame\head, "include")
                if: l1_emit_include(out, node\as\frame, in_path) != 0
                    return: 1
                ---
            ---
            if: l1_text_eq(node\as\frame\head, "predef")
                if: l1_hdr_emit_predef_includes(out, node\as\frame, in_path) != 0
                    return: 1
                ---
            ---
            if: l1_head_is(node\as\frame\head, "define") || l1_head_is(node\as\frame\head, "ifndef-default")
                if: l1_emit_define(out, node\as\frame, in_path, node, l1_head_is(node\as\frame\head, "ifndef-default")) != 0
                    return: 1
                ---
            ---
        ---
        field: field\next
    field: root\as\structure\first_field
    while: field != 0
        node: field\value
        if: l1_node_ignored(node) = 0 && node != 0 && node\kind = c.LM_P0_NODE_FRAME && l1_text_eq(node\as\frame\head, "type")
            if: l1_emit_hdr_type_alias(out, node\as\frame, in_path, node) != 0
                return: 1
            ---
        ---
        field: field\next
    field: root\as\structure\first_field
    while: field != 0
        node: field\value
        if: l1_node_ignored(node) = 0 && node != 0 && node\kind = c.LM_P0_NODE_FRAME && l1_text_eq(node\as\frame\head, "struct")
            name: l1_hdr_frame_name(node\as\frame)
            if: name = 0
                return: l1_error(in_path, node, "struct missing name")
            if: l1_emit_hdr_struct_forward(out, name, in_path, node) != 0
                return: 1
            ---
        ---
        field: field\next
    if: l1_write_cstr(out, "\n") != 0
        return: 1
    field: root\as\structure\first_field
    while: field != 0
        node: field\value
        if: l1_node_ignored(node) = 0 && node != 0 && node\kind = c.LM_P0_NODE_FRAME && l1_text_eq(node\as\frame\head, "enum")
            name: l1_hdr_frame_name(node\as\frame)
            if: name = 0 || l1_ident_to_buf(nbuf, 64U, name) != 0
                return: l1_error(in_path, node, "enum missing name")
            if: l1_emit_hdr_enum(out, node\as\frame, in_path, node) != 0
                return: 1
            if: l1_hdr_name_list_add(l1_hdr_emitted, @ l1_hdr_emittedn, 2048U, nbuf) != 0
                return: l1_error(in_path, node, "too many header types")
            ---
        ---
        field: field\next
    progress: 1
    while: progress != 0
        progress: 0
        remaining: 0
        field: root\as\structure\first_field
        while: field != 0
            node: field\value
            if: l1_node_ignored(node) = 0 && node != 0 && node\kind = c.LM_P0_NODE_FRAME && l1_text_eq(node\as\frame\head, "struct")
                name: l1_hdr_frame_name(node\as\frame)
                if: name = 0 || l1_ident_to_buf(nbuf, 64U, name) != 0
                    return: l1_error(in_path, node, "struct missing name")
                if: l1_hdr_name_list_has(l1_hdr_emitted, l1_hdr_emittedn, nbuf) = 0
                    remaining: remaining + 1
                    if: l1_hdr_struct_deps_ready(node\as\frame, in_path) != 0
                        if: l1_emit_hdr_struct_def(out, node\as\frame, in_path, node) != 0
                            return: 1
                        if: l1_hdr_name_list_add(l1_hdr_emitted, @ l1_hdr_emittedn, 2048U, nbuf) != 0
                            return: l1_error(in_path, node, "too many structs")
                        progress: 1
                    ---
                ---
            ---
            if: l1_node_ignored(node) = 0 && node != 0 && node\kind = c.LM_P0_NODE_FRAME && l1_text_eq(node\as\frame\head, "fnptr")
                name: l1_hdr_frame_name(node\as\frame)
                if: name = 0 || l1_ident_to_buf(nbuf, 64U, name) != 0
                    return: l1_error(in_path, node, "fnptr missing name")
                if: l1_hdr_name_list_has(l1_hdr_emitted, l1_hdr_emittedn, nbuf) = 0
                    remaining: remaining + 1
                    if: l1_hdr_fnptr_deps_ready(node\as\frame, in_path) != 0
                        if: l1_emit_hdr_fnptr(out, node\as\frame, in_path, node) != 0
                            return: 1
                        if: l1_hdr_name_list_add(l1_hdr_emitted, @ l1_hdr_emittedn, 2048U, nbuf) != 0
                            return: l1_error(in_path, node, "too many header types")
                        progress: 1
                    ---
                ---
            ---
            field: field\next
        ---
    ---
    if: remaining != 0
        return: l1_hdr_diagnose_cycle(root, in_path)
    ---
    field: root\as\structure\first_field
    while: field != 0
        node: field\value
        if: l1_node_ignored(node) = 0 && node != 0 && node\kind = c.LM_P0_NODE_FRAME && l1_text_eq(node\as\frame\head, "prototype")
            if: l1_emit_hdr_prototype(out, node, in_path) != 0
                return: 1
            ---
        ---
        field: field\next
    field: root\as\structure\first_field
    while: field != 0
        node: field\value
        if: l1_node_ignored(node) = 0 && node != 0 && node\kind = c.LM_P0_NODE_FRAME
            if: l1_text_eq(node\as\frame\head, "fn") || l1_text_eq(node\as\frame\head, "sub")
                if: l1_text_eq(node\as\frame\head, "fn")
                    if: l1_emit_fn(out, node\as\frame, in_path, 0) != 0
                        return: 1
                    ---
                else:
                    if: l1_emit_fn(out, node\as\frame, in_path, 1) != 0
                        return: 1
                    ---
                ---
            ---
        ---
        field: field\next
    if: l1_write_cstr(out, "#endif\n") != 0
        return: 1
return: 0

fn: l1_translate_header (const: @(char in_path); const: @(char out_path)) int
    @: LmP0Document document 0
    const: @: LmP0Diagnostic diagnostic
    const: @: LmP0Node root
    @: FILE out 0
    int: status
    @: char tmp 0
    @: char unit_id 0
    size_t: tmp_cap 0U
    size_t: unit_cap 0U
    finally:
        c.free(tmp)
        c.free(unit_id)
    l1_imp_reset()
    l1_throw_reset()
    l1_hdr_type_reset()
    status: lm_p0_parse_file(in_path, @ document)
    if: status != 0
        diagnostic: lm_p0_document_diagnostic(document)
        if: diagnostic != 0
            c.fprintf(c.stderr, "l1trans parse error %d at %zu:%zu: %s\n", diagnostic\code, diagnostic\line, diagnostic\column, diagnostic\message)
        else:
            c.fprintf(c.stderr, "l1trans parse error: %s\n", in_path)
        lm_p0_document_destroy(document)
        return: 1
    root: lm_p0_document_root(document)
    if: root = 0
        lm_p0_document_destroy(document)
        c.fprintf(c.stderr, "l1trans error: %s:1:1: empty implicit L1 body\n", in_path)
        return: 1
    if: l1_validate_implicit_node(root, in_path, 1) != 0
        lm_p0_document_destroy(document)
        return: 1
    unit_cap: l1_path_capacity(c.strlen(in_path), 0U)
    if: unit_cap = 0
        lm_p0_document_destroy(document)
        return: l1_error(in_path, 0, "cannot allocate unit identifier")
    unit_id: (cast: (@: char) c.malloc(unit_cap))
    if: unit_id = 0
        lm_p0_document_destroy(document)
        return: l1_error(in_path, 0, "cannot allocate unit identifier")
    if: l1_unit_id_from_source(unit_id, unit_cap, in_path, in_path, root) != 0
        lm_p0_document_destroy(document)
        return: 1
    if: out_path = 0
        lm_p0_document_destroy(document)
        return: l1_error(in_path, 0, "missing output path")
    tmp_cap: l1_path_capacity(c.strlen(out_path), 3U)
    if: tmp_cap = 0
        lm_p0_document_destroy(document)
        return: l1_error(in_path, 0, "cannot allocate output path")
    tmp: (cast: (@: char) c.malloc(tmp_cap))
    if: tmp = 0
        lm_p0_document_destroy(document)
        return: l1_error(in_path, 0, "cannot allocate output path")
    c.snprintf(tmp, tmp_cap, "%s.tmp", out_path)
    out: c.fopen(tmp, "wb")
    if: out = 0
        c.fprintf(c.stderr, "l1trans error: cannot open %s\n", tmp)
        lm_p0_document_destroy(document)
        return: 1
    if: l1_src_load(in_path) != 0
        lm_p0_document_destroy(document)
        status: l1_discard_temp(out, tmp)
        return: status
    ---
    if: l1_emit_header_unit(out, root, in_path, unit_id) != 0
        l1_src_release()
        lm_p0_document_destroy(document)
        l1_hdr_type_reset()
        status: l1_discard_temp(out, tmp)
        return: status
    ---
    l1_src_release()
    lm_p0_document_destroy(document)
    l1_hdr_type_reset()
    status: l1_commit_temp(out, tmp, out_path)
return: status


fn: l1_translate_unit (const: @(char in_path); const: @(char out_path)) int
    @: LmP0Document document 0
    const: @: LmP0Diagnostic diagnostic
    const: @: LmP0Node root
    @: LmP0Field field
    @: FILE out 0
    int: status
    @: char tmp 0
    size_t: tmp_cap 0U
    finally:
        c.free(tmp)
    l1_imp_reset()
    l1_throw_reset()
    l1_hdr_type_reset()
    if: l1_path_is_h_lm1(in_path) != 0
        return: l1_translate_header(in_path, out_path)
    ---

    status: lm_p0_parse_file(in_path, @ document)
    if: status != 0
        diagnostic: lm_p0_document_diagnostic(document)
        if: diagnostic != 0
            c.fprintf(c.stderr, "l1trans parse error %d at %zu:%zu: %s\n", diagnostic\code, diagnostic\line, diagnostic\column, diagnostic\message)
        else:
            c.fprintf(c.stderr, "l1trans parse error: %s\n", in_path)
        lm_p0_document_destroy(document)
        return: 1

    root: lm_p0_document_root(document)
    if: l1_path_is_lm1(in_path) != 0
        if: root = 0
            lm_p0_document_destroy(document)
            c.fprintf(c.stderr, "l1trans error: %s:1:1: empty implicit L1 body\n", in_path)
            return: 1
        if: l1_validate_implicit_node(root, in_path, 1) != 0
            lm_p0_document_destroy(document)
            return: 1
        ---
    else:
        if: l1_path_is_lm2(in_path) = 0
            lm_p0_document_destroy(document)
            c.fprintf(c.stderr, "l1trans error: %s:1:1: l1trans expects a .lm1 or .lm2 source\n", in_path)
            return: 1
        if: root = 0 || l1_scan_l1(root) = 0
            lm_p0_document_destroy(document)
            c.fprintf(c.stderr, "l1trans error: %s:1:1: missing L1 body\n", in_path)
            return: 1
        ---
    ---

    if: out_path = 0
        lm_p0_document_destroy(document)
        return: l1_error(in_path, 0, "missing output path")
    tmp_cap: l1_path_capacity(c.strlen(out_path), 3U)
    if: tmp_cap = 0
        lm_p0_document_destroy(document)
        return: l1_error(in_path, 0, "cannot allocate output path")
    tmp: (cast: (@: char) c.malloc(tmp_cap))
    if: tmp = 0
        lm_p0_document_destroy(document)
        return: l1_error(in_path, 0, "cannot allocate output path")
    c.snprintf(tmp, tmp_cap, "%s.tmp", out_path)
    out: c.fopen(tmp, "wb")
    if: out = 0
        c.fprintf(c.stderr, "l1trans error: cannot open %s\n", tmp)
        lm_p0_document_destroy(document)
        return: 1

    if: l1_write_cstr(out, "/* generated by l1trans */\n") != 0
        lm_p0_document_destroy(document)
        status: l1_discard_temp(out, tmp)
        return: status

    if: l1_src_load(in_path) != 0
        lm_p0_document_destroy(document)
        status: l1_discard_temp(out, tmp)
        return: status
    ---
    if: l1_path_is_lm1(in_path) != 0
        if: l1_emit_implicit_l1(out, root, in_path, 0) != 0
            l1_src_release()
            lm_p0_document_destroy(document)
            status: l1_discard_temp(out, tmp)
            return: status
        ---
    else:
        if: root\kind = c.LM_P0_NODE_STRUCTURE
            field: root\as\structure\first_field
            while: field != 0
                if: l1_emit_item(out, field\value, in_path, 0, 0) != 0
                    l1_src_release()
                    lm_p0_document_destroy(document)
                    status: l1_discard_temp(out, tmp)
                    return: status
                field: field\next
            ---
        else:
            if: l1_emit_item(out, root, in_path, 0, 0) != 0
                l1_src_release()
                lm_p0_document_destroy(document)
                status: l1_discard_temp(out, tmp)
                return: status
            ---
        ---
    ---
    l1_src_release()
    lm_p0_document_destroy(document)
    status: l1_commit_temp(out, tmp, out_path)
return: status

fn: l1_translate (const: @(char in_path); const: @(char out_path)) int
    int: status l1_translate_unit(in_path, out_path)
    l1_imp_reset()
return: status

external:
    fn: main (int: argc; @@: char argv) int
        int: i 1
        int: npos 0
        @: char src_arg 0
        @: char out_arg 0
        immutable:
            @: char usage "usage: l1trans.exe [--unit-root DIR] <source.lm1> <output>\n"
            @: char unit_root_flag "--unit-root"
        c.setvbuf(c.stdout, 0, c._IONBF, 0)
        c.setvbuf(c.stderr, 0, c._IONBF, 0)
        l1_unit_root_set: 0
        l1_unit_root: 0
        src_arg: 0
        out_arg: 0
        while: i < argc
            if: c.strcmp(argv[i], unit_root_flag) = 0
                if: i + 1 >= argc
                    c.fputs(usage, c.stderr)
                    return: 1
                l1_unit_root: argv[i + 1]
                l1_unit_root_set: 1
                i: i + 2
            else:
                if: npos >= 2
                    c.fputs(usage, c.stderr)
                    return: 1
                if: npos = 0
                    src_arg: argv[i]
                else:
                    out_arg: argv[i]
                ---
                npos: npos + 1
                i: i + 1
            ---
        ---
        if: npos != 2
            c.fputs(usage, c.stderr)
            return: 1
    return: l1_translate(src_arg, out_arg)
end: external
