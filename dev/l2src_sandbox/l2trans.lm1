            else:
                if: oi < 0
                    oi: l2_own_visible(mi, fr\head)
            ---
        if: lm_compiler_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && lm_compiler_frame_head(stmt, "return") = 0 && oi >= 0 && l2_m_uses[l2_own_off(mi, oi)] = 0
            oi: -1
        if: lm_compiler_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && lm_compiler_frame_head(stmt, "return") = 0
            si: l2_slot_find(mi, fr\head)
        if: lm_compiler_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && lm_compiler_frame_head(stmt, "return") = 0
            fi: l2_param_find(mi, fr\head)
        if: lm_compiler_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && lm_compiler_frame_head(stmt, "return") = 0 && oi >= 0
            fi: l2_m_alias[l2_own_off(mi, oi)]
        # Known callable head: a nullary call, not a store into a same-spelled formal.
        # Unknown f() is a definition and l2_head_is_call leaves it here. An empty call
        # body is not an assignment value; storing it called l2_eval_fields with no fields
        # and failed without a located diagnostic.
        if: lm_compiler_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && lm_compiler_frame_head(stmt, "return") = 0 && l2_head_is_call(fr\head, fr\body, fr\flags, mi) != 0
            oi: 0 - 1
            si: 0 - 1
            fi: 0 - 1
        if: lm_compiler_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && lm_compiler_frame_head(stmt, "return") = 0 && oi >= 0 && l2_empty_pointer_assignment(stmt, mi) = oi
            if: l2_emit_empty_graph(l2_own_nsty_get(oi), mi, ind, l2_tok) != 0 || l2_own_store(mi, oi, ind, l2_tok\data) != 0
                return: 1
            field: lm_compiler_next_active(field\next)
            continue
        if: lm_compiler_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && lm_compiler_frame_head(stmt, "return") = 0 && oi >= 0 && l2_method_pointer_candidate(mi, oi, fr\body\first_field, lm_compiler_count_active(fr\body)) >= 0
            if: l2_cf_actual_emit(mi, fr\body\first_field, lm_compiler_count_active(fr\body), ind, l2_tok) != 0 || l2_own_store(mi, oi, ind, l2_tok\data) != 0
                return: 1
            field: lm_compiler_next_active(field\next)
            continue
        if: lm_compiler_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && lm_compiler_frame_head(stmt, "return") = 0 && oi >= 0 && lm_compiler_own_is_pointer(l2_own_ty[oi]) != 0 && l2_own_is_slot(oi) = 0
            if: l2_emit_reference_value_at_context(fr\body\first_field, lm_compiler_count_active(fr\body), lm_compiler_ft_of_own(l2_own_ty[oi]), l2_own_nsty_get(oi), -1, mi, ind, l2_tok, oi, 0, @ store_context) != 0 || l2_own_store_context(mi, oi, ind, l2_tok\data, store_context) != 0
                return: 1
            field: lm_compiler_next_active(field\next)
            continue
        cst: 0
        if: lm_compiler_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && lm_compiler_frame_head(stmt, "return") = 0 && oi >= 0
            cst: l2_convert_on_store(mi, oi, stmt, fr, ind)
        if: cst = 1
            return: 1
        if: cst = 2
            return: l2_error(l2_src, stmt, "mixed numeric types (a conversion)")
        if: lm_compiler_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && lm_compiler_frame_head(stmt, "return") = 0 && oi >= 0 && cst != 3 && l2_eval_fields(fr\body\first_field, lm_compiler_count_active(fr\body), mi, ind, l2_tok) != 0
            return: 1
        # An untyped graph into a Structure-typed own field (S3): admitted at run time, then
        # bound like receiveMessage and `Model: fresh`: its slot takes it (l2_own_store).
        rbadmit: 0
        if: oi >= 0 && l2_own_is_slot(oi) = 0 && l2_own_nsty_get(oi) >= 0
            rbadmit: 1
        if: lm_compiler_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && lm_compiler_frame_head(stmt, "return") = 0 && oi >= 0 && lm_compiler_count_active(fr\body) = 1 && lm_compiler_formal_find(mi, fr\head) < 0 && l2_graph_nsty(mi, fr\head) >= 0 && l2_untyped_graph(mi, lm_compiler_next_active(fr\body\first_field)\value) != 0
            rbadmit: 1
        # A letter is bound by its payload, admitted (D-57).
        if: rbadmit != 0 && l2_is_letter_value(mi, fr\body\first_field, lm_compiler_count_active(fr\body)) != 0 && l2_payload_expr(mi, fr\body\first_field, lm_compiler_count_active(fr\body), l2_tok) != 0
            return: 1
        if: rbadmit != 0 && l2_emit_admit(mi, l2_graph_nsty(mi, fr\head), l2_tok\data, ind) != 0
            return: 1
        # FABLE-SONNET-OWN-LOOKUP-AUDIT-20260923-131 (a): was a byte-identical
        # hand-inlined copy of l2_emit_own_from's own two branches (guard
        # included) -- consolidated onto the helper, already called a few
        # lines above for the rbadmit rebinding-store branch in this same
        # function. No generated-C change: the emitted text is the same
        # format string with the same arguments either way.
        if: lm_compiler_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && lm_compiler_frame_head(stmt, "return") = 0 && oi >= 0 && fi >= 0 && l2_emit_own_from(mi, oi, ind) != 0
            return: 1
        if: lm_compiler_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && lm_compiler_frame_head(stmt, "return") = 0 && oi >= 0 && l2_own_store(mi, oi, ind, l2_tok\data) != 0
            return: 1
        if: lm_compiler_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && lm_compiler_frame_head(stmt, "return") = 0 && oi >= 0
            field: lm_compiler_next_active(field\next)
        if: lm_compiler_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && lm_compiler_frame_head(stmt, "return") = 0 && oi < 0 && si >= 0 && l2_eval_fields(fr\body\first_field, lm_compiler_count_active(fr\body), mi, ind, l2_tok) != 0
            return: 1
        if: lm_compiler_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && lm_compiler_frame_head(stmt, "return") = 0 && oi < 0 && si >= 0 && (l2_tok_slot(mi, si, cs_name) != 0 || c.fprintf(l2_out, "%s%s: %s\n", ind, cs_name\data, l2_tok\data) < 0)
            return: 1
        if: lm_compiler_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && lm_compiler_frame_head(stmt, "return") = 0 && oi < 0 && si >= 0
            field: lm_compiler_next_active(field\next)
        if: lm_compiler_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && lm_compiler_frame_head(stmt, "return") = 0 && oi < 0 && si < 0 && fi >= 0
            if: lm_compiler_pointer_depth(lm_compiler_formal_raw(l2_input_ft(mi, fi))) > 0
                if: l2_emit_reference_value_at_context(fr\body\first_field, lm_compiler_count_active(fr\body), l2_input_ft(mi, fi), l2_input_model(mi, fi), -1, mi, ind, l2_tok, -1, 0, @ store_context) != 0
                    return: 1
                ---
            else:
                if: l2_eval_fields(fr\body\first_field, lm_compiler_count_active(fr\body), mi, ind, l2_tok) != 0
                    return: 1
                ---
            ---
            if: l2_formal_store_context(mi, fi, ind, l2_tok\data, store_context) != 0
                return: 1
            ---
        if: lm_compiler_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && lm_compiler_frame_head(stmt, "return") = 0 && oi < 0 && si < 0 && fi >= 0
            field: lm_compiler_next_active(field\next)
        if: lm_compiler_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && lm_compiler_frame_head(stmt, "return") = 0 && oi < 0 && si < 0 && fi < 0 && l2_head_is_call(fr\head, fr\body, fr\flags, mi) != 0 && l2_eval_discard(field, 1, mi, ind) != 0
            return: 1
        if: lm_compiler_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && lm_compiler_frame_head(stmt, "return") = 0 && oi < 0 && si < 0 && l2_head_is_call(fr\head, fr\body, fr\flags, mi) != 0
            field: lm_compiler_next_active(field\next)
        if: lm_compiler_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && lm_compiler_frame_head(stmt, "return") = 0 && oi < 0 && si < 0 && l2_head_is_call(fr\head, fr\body, fr\flags, mi) = 0 && l2_is_known(fr\head) != 0 && l2_eval_discard(field, 1, mi, ind) != 0
            return: 1
        if: lm_compiler_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && lm_compiler_frame_head(stmt, "return") = 0 && oi < 0 && si < 0 && l2_head_is_call(fr\head, fr\body, fr\flags, mi) = 0 && l2_is_known(fr\head) != 0
            field: lm_compiler_next_active(field\next)
        raw: 1
        if: lm_compiler_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && lm_compiler_frame_head(stmt, "return") = 0 && oi < 0 && si < 0 && l2_head_is_call(fr\head, fr\body, fr\flags, mi) = 0 && l2_is_known(fr\head) = 0
            raw: l2_native_member_path(stmt, mi, @ raw_member)
            if: raw = 1
                return: 1
            if: raw = 0
                raw_member_status: l2_eval_fields(fr\body\first_field, lm_compiler_count_active(fr\body), mi, ind, l2_tok)
                if: raw_member_status = 0
                    raw_member_status: l2_emit_raw_steps(@ raw_member, (raw_member.n), mi, ind, pdest, 0)
                lm_compiler_path_release(@ raw_member)
                if: raw_member_status != 0 || c.fprintf(l2_out, "%s%s: %s\n", ind, pdest\data, l2_tok\data) < 0
                    return: 1
                field: lm_compiler_next_active(field\next)
            ---
        ---
        # node/for's own single-hop write emission (l2_slash_own/l2_slash_for)
        # is removed (FABLE-SONNET-NODE-ROOT-20260923-121): the FIELD PATHS
        # branch above now claims every node/for-rooted write first (l2_is_
        # path_head recognizes them as ordinary roots), so the sl-based block
        # this used to be is gone. What remains is the general backstop: an
        # assignment target that resolved to none of own/slot/formal/call/
        # known/raw-dispatch by the time emission reaches it. l2_check_body
        # already refuses an unresolvable assignment target with a location
        # ("assignment target must be a declared typed mutable value") before
        # emission runs at all -- undeclared and declared-below both measured
        # refused there (FABLE-SONNET-UNIT-FIELD-WRITE-20260923-129). This was
        # a SILENT return: 1 regardless, reachable the moment check-time and
        # emit-time own-field lookup ever disagree (exactly what happened
        # here: l2_own_find_last lacked the same unit-field fallback
        # l2_own_find already had, so a name check_body accepted -- a
        # backward-visible unit field -- still fell all the way through
        # emission unresolved). Translation must never fail without a
        # located diagnostic; this is the same one check_body already gives,
        # as a backstop, not a new rule.
        if: lm_compiler_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && lm_compiler_frame_head(stmt, "return") = 0 && oi < 0 && si < 0 && fi < 0 && l2_head_is_call(fr\head, fr\body, fr\flags, mi) = 0 && l2_is_known(fr\head) = 0 && raw != 0
            return: l2_error(l2_src, stmt, "assignment target must be a declared typed mutable value")
        ---
    # A body ending in an if/else can leave the last emitted line multiple
    # levels deeper than its caller's next statement. Source cutters need
    # not be frame trailers, so close this body explicitly before returning
    # to the caller. This is L1 structure only; no loop action.
    if: need_cut != 0 && c.fprintf(l2_out, "%s---\n", ind) < 0
        return: 1
    if: empty_body != 0
        return: l2_emit_empty_body(emitted_from, ind)
return: 0

# A fresh typed cell for own row oi into `<slot>[0]`, at indent `ind`: the builder's cells.
# Every primitive gets an independent cell, checked, with `fail` (and `fail2`) when it could not be made. A type with
# no cell emits nothing, as the builder never did.
# A fresh typed cell of own storage type ty into `slot`[0] (an Array of n elements), with `fail`
# (and `fail2`) when it cannot be made: the one typed-cell emission, for an own field and a header
# part alike.
fn: l2_emit_cell_new_ty (int: ty; size_t: n; const: @(char owner); size_t: field; const: @(char place); const: @(char ind); const: @(char slot); const: @(char fail); const: @(char fail2)) int
    []: char pty 96
    []: char array_parent 192
    if: lm_compiler_own_is_array(ty) != 0
        if: place != 0
            if: c.sprintf(array_parent, "%s", place) < 0
                return: 1
            ---
        else:
            if: owner = 0 || c.sprintf(array_parent, "lmx_field_place_new(l2_program_arena, %s, %zuU)", owner, field) < 0
                return: 1
        ---
    ---
    if: ty = 1 && c.fprintf(l2_out, "%s%s[0]: lmx_char_new_profiled(l2_program_arena, lmx_range_profile(l2_program_arena, (cast: (@: void) %s)))\n", ind, slot, slot) < 0
        return: 1
    if: ty = 2 && c.fprintf(l2_out, "%s%s[0]: lmx_size_new_profiled(l2_program_arena, lmx_range_profile(l2_program_arena, (cast: (@: void) %s)))\n", ind, slot, slot) < 0
        return: 1
    if: ty = 0 && c.fprintf(l2_out, "%s%s[0]: lmx_int_new_profiled(l2_program_arena, lmx_range_profile(l2_program_arena, (cast: (@: void) %s)))\n", ind, slot, slot) < 0
        return: 1
    if: ty = 3 && c.fprintf(l2_out, "%s%s[0]: lmx_unsigned_new_profiled(l2_program_arena, lmx_range_profile(l2_program_arena, (cast: (@: void) %s)))\n", ind, slot, slot) < 0
        return: 1
    if: ty = 36 && c.fprintf(l2_out, "%s%s[0]: lmx_ulong_new_profiled(l2_program_arena, lmx_range_profile(l2_program_arena, (cast: (@: void) %s)))\n", ind, slot, slot) < 0
        return: 1
    if: lm_compiler_own_is_pointer(ty) != 0 && (lm_compiler_ptr_cell_type(lm_compiler_oc_ft(ty), pty) != 0 || c.fprintf(l2_out, "%s%s[0]: lmx_pointer_new_profiled(%s, l2_program_arena, lmx_range_profile(l2_program_arena, (cast: (@: void) %s)))\n", ind, slot, pty, slot) < 0)
        return: 1
    if: ty = 4 && c.fprintf(l2_out, "%s%s[0]: lmx_array_new_child_profiled(%s, c.LMX_TYPE_ARRAY_OF_INT, %zuU, l2_program_arena, lmx_range_profile(l2_program_arena, (cast: (@: void) %s)))\n", ind, slot, array_parent, n, slot) < 0
        return: 1
    if: ty = 5 && c.fprintf(l2_out, "%s%s[0]: lmx_array_new_child_profiled(%s, c.LMX_TYPE_ARRAY_OF_CHAR, %zuU, l2_program_arena, lmx_range_profile(l2_program_arena, (cast: (@: void) %s)))\n", ind, slot, array_parent, n, slot) < 0
        return: 1
    if: ty = 7 && c.fprintf(l2_out, "%s%s[0]: lmx_array_new_child_profiled(%s, c.LMX_TYPE_ARRAY_OF_SIZE_T, %zuU, l2_program_arena, lmx_range_profile(l2_program_arena, (cast: (@: void) %s)))\n", ind, slot, array_parent, n, slot) < 0
        return: 1
    if: ty = 37 && c.fprintf(l2_out, "%s%s[0]: lmx_array_new_child_profiled(%s, c.LMX_TYPE_ARRAY_OF_ULONG, %zuU, l2_program_arena, lmx_range_profile(l2_program_arena, (cast: (@: void) %s)))\n", ind, slot, array_parent, n, slot) < 0
        return: 1
    if: ty = 8 && c.fprintf(l2_out, "%s%s[0]: lmx_array_new_child_profiled(%s, c.LMX_TYPE_ARRAY_OF_UNSIGNED_CHAR, %zuU, l2_program_arena, lmx_range_profile(l2_program_arena, (cast: (@: void) %s)))\n", ind, slot, array_parent, n, slot) < 0
        return: 1
    if: lm_compiler_oc_is_parray(ty) != 0 && c.fprintf(l2_out, "%s%s[0]: l2_u%08X%08X_pa%d_new(%s, %zuU, l2_program_arena, lmx_range_profile(l2_program_arena, (cast: (@: void) %s)))\n", ind, slot, l2_module_hash_a, l2_module_hash_b, lm_compiler_oc_ft(ty), array_parent, n, slot) < 0
        return: 1
    if: ty = lm_compiler_oc_darray() && c.fprintf(l2_out, "%s%s[0]: lmx_array_ref_new_child_profiled(%s, c.LMX_TYPE_ARRAY_OF_DESC, %zuU, l2_program_arena, lmx_range_profile(l2_program_arena, (cast: (@: void) %s)))\n", ind, slot, array_parent, n, slot) < 0
        return: 1
    if: ty != 0 && ty != 1 && ty != 2 && ty != 3 && ty != 36 && lm_compiler_own_is_pointer(ty) = 0 && lm_compiler_own_is_array(ty) = 0
        return: 0
    if: c.fprintf(l2_out, "%sif: %s[0] = 0\n%s    %s\n", ind, slot, ind, fail) < 0
        return: 1
    if: fail2 != 0 && c.fprintf(l2_out, "%s    %s\n", ind, fail2) < 0
        return: 1
return: 0

# Own field oi's cell: an own Structure field is a direct slot, empty until it is bound (-189
# c3b-3): no cell; an Array has its declared length.
fn: l2_emit_cell_new (int: oi; const: @(char owner); size_t: field; const: @(char place); const: @(char ind); const: @(char slot); const: @(char fail); const: @(char fail2)) int
    size_t: n 0U
    []: char key 128
    if: l2_own_is_slot(oi) != 0
        return: 0
    if: lm_compiler_own_is_array(l2_own_ty[oi]) != 0
        n: lm_compiler_literal_value(l2_own_count[oi])
    if: l2_emit_cell_new_ty(l2_own_ty[oi], n, owner, field, place, ind, slot, fail, fail2) != 0
        return: 1
    # A number's cell is the field's place and carries its name. An Array's value is its header, not a cell, so its
    # owning slot is named as well, as a model's fields are (l2_emit_ns_names): an analytical admission finds a field
    # by its place's name (lmx_implements_place_name), never by a referent's.
    if: lm_compiler_own_is_array(l2_own_ty[oi]) != 0 && lm_compiler_emit_source_name(slot, l2_own_name[oi], ind, fail, fail2) != 0
        return: 1
    if: c.sprintf(key, "%s[0]", slot) < 0
        return: 1
return: lm_compiler_emit_source_name(key, l2_own_name[oi], ind, fail, fail2)

# The own storage type of method mi's result cell in its `return` part, or -1 for no cell: a
# number by the trampoline's class, a pointer by its return code (the table of l2_emit_sig).

# THE HEADER PARTS OF METHOD i (-189 c4; form A): its signature is an ordinary graph field.
# - args, slot 0: one child per declared formal, in order -- a typed cell of the formal's type
#   (the prototype's 0), a callable formal's contract occurrence, a Structure formal's named
#   Structure (its type); a type with no cell leaves its slot empty.
# - return, slot 1: no child for a `sub`, else one -- the result's typed cell, or empty when the
#   result type has no cell.  The walked root's CALL refers to that cell (l2_rw_call).
# Then `native`: the trampoline for a method with a native body, 0 otherwise.
# Does a method's header part hold a char cell -- a char formal in `args`, a char result in
# `return` (l2_emit_parts)? These cells are owned; the literal table is used only
# to transport a char actual's immutable value to the callable ABI.
fn: l2_parts_have_char () int
    int: i 0
    int: j
    while: i < l2_m_n
        j: 0
        while: i != l2_e && j < l2_m_arity[i]
            if: l2_cf_get(i, j) < 0 && l2_nsty_get(i, j) < 0 && lm_compiler_own_ty_of_param(lm_compiler_ft(i, j)) = 1
                return: 1
            j: j + 1
        ---
        j: 0
        while: i != l2_e && j < l2_m_dyn[i]
            if: lm_compiler_own_of_dt(l2_dt(i, j)) = 1
                return: 1
            j: j + 1
        ---
        if: i != l2_e && l2_m_ret[i] != 8 && lm_compiler_ret_cell_ty(i) = 1
            return: 1
        i: i + 1
    ---
return: 0

# Header parts are made by the shared counted constructor. Publication remains
# after source attachment, so a bodyless occurrence only receives its declared
# native provider, never an invented body or a body inferred from its header.
fn: l2_emit_parts (int: i) int
    if: fputs("        l2_entry_leaf: ", l2_out) < 0 || l2_emit_build_occ(i) != 0 || fputs("\n        if: l2_entry_leaf = 0\n            return: 1\n", l2_out) < 0
        return: 1
    if: i = l2_e || l2_m_nsof(i) >= 0
        return: l2_emit_native_word(i)
    if: lm_compiler_emit_method_part_name(0, "args") != 0 || lm_compiler_emit_method_part_name(1, "return") != 0
        return: 1
    if: lm_compiler_fn_parts_on(i) != 0 && (lm_compiler_emit_method_part_name(2, "var") != 0 || lm_compiler_emit_method_part_name(3, "body") != 0)
        return: 1
return: l2_emit_native_word(i)

# One native completion criterion for prototype, definition and publication.
# Descriptor-only contracts have no body. PAP body compilation is a separate
# existing implementation debt, not a hosted-method or language exception.
fn: l2_native_entry_ready (int: i) int
return: (cast: (int) ((l2_m_native(i) != 0 || l2_mad_on(i) != 0) && l2_pap_on(i) = 0))

# The native word of method i's occurrence, l2_entry_leaf: its trampoline, unless the method is walked.
fn: l2_emit_native_word (int: i) int
    # S8.1: a provided construction's descriptor has the provider's export as its native word (l2_m_provider).
    if: l2_m_provider(i) != 0
        if: fputs("        l2_entry_leaf\\native: (cast: (LmxEntry) ", l2_out) < 0 || fputs(l2_m_provider(i), l2_out) < 0 || fputs(")\n", l2_out) < 0
            return: 1
        return: 0
    ---
    # A T7 host's return is the signature frame's trailer, so the method body is
    # empty, but the native function still builds the node. It is not walked.
    if: l2_native_entry_ready(i) = 0
        return: 0
    ---
    # The test knob `--walk-methods` selects a completed portable source body,
    # including a zero-width body; -1 still means no completed lowering.
    if: i != l2_e && l2_walk_methods != 0 && l2_m_steps != 0 && l2_m_steps[i] >= 0 && l2_m_walkable[i] != 0
        return: 0
    if: fputs("        l2_entry_leaf\\native: (cast: (LmxEntry) ", l2_out) < 0 || l2_write_sym(l2_out, i) != 0 || fputs("_tr)\n", l2_out) < 0
        return: 1
return: 0

# A native pointer Array exposes T ** backing, including @element. Its
# physical cells must therefore be T * objects, not canonical void * cells
# viewed through a cast. Emit one exact C99 access contract per closed element
# type; the arena pool retains it and copy/walker use the same callbacks.
# These functions are backend spellings, not language types or graph fields.
# The native spelling of an already resolved pointer-value cell. The SAME
# kernel operation owns the physical write and CURRENT-state publication.
# A closed C type supplies only its exact unowned-object accessor,not a Model.
fn: l2_emit_pointer_cell_store (int: type; const: @(char ind); const: @(char cell); const: @(char owner); const: @(char value); int: context) int
    []: char current 64
    []: char accessor 96
    if: type < -1 || ind = 0 || cell = 0 || owner = 0 || value = 0 || c.sprintf(current, "0") < 0 || c.sprintf(accessor, "0") < 0
        return: 1
    if: type >= 0 && (l2_pointer_cell_needed(type) != 0 || c.snprintf(accessor, 96U, "l2_u%08X%08X_pc%d_write", l2_module_hash_a, l2_module_hash_b, type) < 0)
        return: 1
    if: context >= 0 && c.sprintf(current, "(@ l2_cv%d)", context) < 0
        return: 1
return: (cast: (int) (c.fprintf(l2_out, "%sif: lmx_value_cell_store(l2_program_arena, (cast: (@: void) (%s)), %s, (cast: (@: void) (%s)), %s, %s) != 0\n%s    lmx_call_note_walk_fail(c.LMX_WALK_INVALID)\n%s---\n", ind, cell, owner, value, current, accessor, ind, ind) < 0))

# Exact C storage projections share the existing typed-pool accessor ABI.
# No per-address table,receiver name or candidate layout participates here.
fn: l2_pointer_cell_needed (int: type) int
    int: i 0
    @: int grown
    while: i < l2_pointer_store_count
        if: l2_pointer_store_types[i] = type
            return: 0
        i: i + 1
    if: i = c.INT_MAX || lm_compiler_mul_ok((cast: (size_t) (i + 1)), c.sizeof(c.int)) = 0
        return: 1
    grown: (cast: (@: int) lm_compiler_xmalloc((cast: (size_t) (i + 1)) * c.sizeof(c.int)))
    if: grown = 0
        return: 1
    if: i > 0
        memcpy(grown, l2_pointer_store_types, (cast: (size_t) i) * c.sizeof(c.int))
    grown[i]: type
    lm_compiler_xfree(l2_pointer_store_types)
    l2_pointer_store_types: grown
    l2_pointer_store_count: i + 1
return: 0

# Prototypes use only the stable physical accessor ABI. A pseudo C callee
# interner entry is not a C type;emit bodies only for actually selected stores.
fn: l2_emit_pointer_cell_contracts () int
    int: ft 0
    if: fputs("prototype:\n", l2_out) < 0
        return: 1
    while: ft < 100 + l2_foreign_n
        if: c.fprintf(l2_out, "    fn: l2_u%08X%08X_pc%d_write (@: void cell; @: void value) int\n", l2_module_hash_a, l2_module_hash_b, ft) < 0
            return: 1
        ft: ft + 1
return: (cast: (int) (fputs("\n", l2_out) < 0))

fn: l2_emit_pointer_cell_definitions () int
    int: i 0
    int: ft 0
    []: char value_own 1024
    []: char cell_own 1024
    L2Tx: value_tx
    L2Tx: cell_tx
    @: L2Tx value lm_compiler_tx_local(@ value_tx, value_own, 1024U)
    @: L2Tx cell lm_compiler_tx_local(@ cell_tx, cell_own, 1024U)
    []: char name 96
    if: value = 0 || cell = 0
        return: 1
    while: i < l2_pointer_store_count
        ft: l2_pointer_store_types[i]
        if: lm_compiler_pointer_depth(lm_compiler_formal_raw(ft)) > 0
            if: c.snprintf(name, 96U, "l2_u%08X%08X_pc%d_write", l2_module_hash_a, l2_module_hash_b, ft) < 0 || lm_compiler_pointer_decl_text(lm_compiler_formal_raw(ft), 0, 0, value) != 0 || lm_compiler_pointer_decl_text(lm_compiler_formal_raw(ft), 1, 0, cell) != 0
                return: 1
            if: c.fprintf(l2_out, "\nfn: %s (@: void cell; @: void value) int\n    %s typed (cast: (%s) cell)\n    \\typed: (cast: (%s) value)\nreturn: 0\n", name, cell\data, cell\data, value\data) < 0
                return: 1
        ---
        i: i + 1
    ---
return: 0

fn: l2_emit_pointer_array_contracts () int
    int: oi 0
    int: prior
    int: ft
    int: ty
    []: char value_own 1024
    []: char cell_own 1024
    L2Tx: value_tx
    L2Tx: cell_tx
    @: L2Tx value lm_compiler_tx_local(@ value_tx, value_own, 1024U)
    @: L2Tx cell lm_compiler_tx_local(@ cell_tx, cell_own, 1024U)
    []: char name 96
    if: value = 0 || cell = 0
        return: 1
    while: oi < l2_own_n + l2_nsf_n
        ty: l2_array_type_at(oi)
        if: lm_compiler_oc_is_parray(ty) = 0
            oi: oi + 1
            continue
        ft: lm_compiler_oc_ft(ty)
        prior: 0
        while: prior < oi && l2_array_type_at(prior) != ty
            prior: prior + 1
        if: prior < oi
            oi: oi + 1
            continue
        if: c.snprintf(name, 96U, "l2_u%08X%08X_pa%d", l2_module_hash_a, l2_module_hash_b, ft) < 0 || lm_compiler_pointer_decl_text(ft, 0, 0, value) != 0 || lm_compiler_pointer_decl_text(ft, 1, 0, cell) != 0
            return: 1
        if: c.fprintf(l2_out, "\nfn: %s_read (@: void cell) @: void\n    %s typed (cast: (%s) cell)\nreturn: (cast: (@: void) \\typed)\n\nfn: %s_write (@: void cell; @: void value) int\n    %s typed (cast: (%s) cell)\n    \\typed: (cast: (%s) value)\nreturn: 0\n", name, cell\data, cell\data, name, cell\data, cell\data, value\data) < 0
            return: 1
        if: c.fprintf(l2_out, "\nfn: %s_new (@: Lmx parent; size_t: count; @: LmxArena arena; @: Lmx profile) @: LmxArray\nreturn: lmx_array_new_typed_child_profiled(parent, c.LMX_TYPE_ARRAY_OF_POINTER_BASE + %d, count, arena, profile, c.sizeof(%s), %s_read, %s_write)\n", name, ft, value\data, name, name) < 0
            return: 1
        oi: oi + 1
    ---
return: 0

# Publication, the transaction every emitter ends with: the written temporary l2_pub_tmp replaces out_path;
# an out_path that exists stays as a backup until that rename succeeded.
# The bytes of the file at path and a NUL, read whole, on the heap (their count in len[0]); 0 when it cannot be read
# or held.

# The snapshot's bytes of the file at path (Q-F): read on its first use, then the same bytes for every pass and
# query of the program; their count in len[0]. 0 when it cannot be read or held.
fn: l2_snap_bytes (const: @(char path); @: size_t len) const: @: char
    int: i 0
    int: cap
    size_t: n
    @: char data
    @: char name
    @@: char np
    @@: char nd
    @: size_t nl
    @@: LmP0Document nv
    if: path = 0 || len = 0
        return: 0
    while: i < l2_snap_n
        if: strcmp(l2_snap_path[i], path) = 0
            \len: l2_snap_len[i]
            return: l2_snap_data[i]
        i: i + 1
    ---
    if: l2_snap_n >= l2_snap_cap
        cap: l2_snap_cap
        if: cap < 1
            cap: 8
        while: cap <= l2_snap_n
            if: cap > c.INT_MAX / 2
                return: 0
            cap: cap * 2
        ---
        np: (cast: (@@: char) lm_compiler_xmalloc((cast: (size_t) cap) * c.sizeof(@: char)))
        nd: (cast: (@@: char) lm_compiler_xmalloc((cast: (size_t) cap) * c.sizeof(@: char)))
        nl: (cast: (@: size_t) lm_compiler_xmalloc((cast: (size_t) cap) * c.sizeof(c.size_t)))
        nv: (cast: (@@: LmP0Document) lm_compiler_xmalloc((cast: (size_t) cap) * c.sizeof(@: LmP0Document)))
        if: np = 0 || nd = 0 || nl = 0 || nv = 0
            if: np != 0
                lm_compiler_xfree((cast: (@: void) np))
            if: nd != 0
                lm_compiler_xfree((cast: (@: void) nd))
            if: nl != 0
                lm_compiler_xfree((cast: (@: void) nl))
            if: nv != 0
                lm_compiler_xfree((cast: (@: void) nv))
            return: 0
        ---
        i: 0
        while: i < l2_snap_n
            np[i]: l2_snap_path[i]
            nd[i]: l2_snap_data[i]
            nl[i]: l2_snap_len[i]
            nv[i]: l2_snap_doc[i]
            i: i + 1
        ---
        if: l2_snap_path != 0
            lm_compiler_xfree((cast: (@: void) l2_snap_path))
        if: l2_snap_data != 0
            lm_compiler_xfree((cast: (@: void) l2_snap_data))
        if: l2_snap_len != 0
            lm_compiler_xfree((cast: (@: void) l2_snap_len))
        if: l2_snap_doc != 0
            lm_compiler_xfree((cast: (@: void) l2_snap_doc))
        l2_snap_path: np
        l2_snap_data: nd
        l2_snap_len: nl
        l2_snap_doc: nv
        l2_snap_cap: cap
    ---
    data: lm_compiler_snap_read(path, len)
    if: data = 0
        return: 0
    n: strlen(path)
    name: (cast: (@: char) lm_compiler_xmalloc(n + 1U))
    if: name = 0
        lm_compiler_xfree((cast: (@: void) data))
        return: 0
    memcpy(name, path, n + 1U)
    l2_snap_path[l2_snap_n]: name
    l2_snap_data[l2_snap_n]: data
    l2_snap_len[l2_snap_n]: \len
    l2_snap_doc[l2_snap_n]: 0
    l2_snap_n: l2_snap_n + 1
return: data

# The P0 parse of the snapshot's bytes of the file at path, as lm_p0_parse_file of that file would give it.
fn: l2_snap_parse (const: @(char path); @@: LmP0Document document) int
    size_t: n 0U
    const: @: char data
    if: document = 0
        return: 1
    document[0]: 0
    data: l2_snap_bytes(path, @ n)
    if: data = 0
        return: 1
return: lm_p0_parse_bytes(data, n, document)

# The P0 document of the snapshot's bytes of the file at path, parsed on its first use and then the same document for
# every later query of the program: a predef file -- a header or a code module -- whose queries only read its tree
# (l2_predef_file_has_type, _define, _has_function, _result_ty). 0 when the file cannot be read or does not parse; such
# a parse is not kept. The snapshot owns the document: l2_snap_free destroys it.
fn: l2_snap_document (const: @(char path)) @: LmP0Document
    int: i 0
    size_t: n 0U
    const: @: char data
    @: LmP0Document document 0
    data: l2_snap_bytes(path, @ n)
    if: data = 0
        return: 0
    while: i < l2_snap_n && l2_snap_data[i] != data
        i: i + 1
    if: i >= l2_snap_n
        return: 0
    if: l2_snap_doc[i] = 0
        if: lm_p0_parse_bytes(data, n, @ document) != 0 || document = 0
            if: document != 0
                lm_p0_document_destroy(document)
            return: 0
        ---
        l2_snap_doc[i]: document
    ---
return: l2_snap_doc[i]

# Each file of the snapshot read again and compared with its snapshot bytes: 0 all the same; else 1, the first that
# changed (or cannot be read) said.
fn: l2_snap_verify () int
    int: i 0
    size_t: n 0U
    @: char now
    @: FILE touched
    int: same
    if: l2_snap_touch >= 1 && l2_snap_touch <= l2_snap_n
        touched: c.fopen(l2_snap_path[l2_snap_touch - 1], "ab")
        if: touched != 0
            fputc(10, touched)
            fclose(touched)
        ---
        l2_snap_touch: 0
    ---
    while: i < l2_snap_n
        now: lm_compiler_snap_read(l2_snap_path[i], @ n)
        same: 0
        if: now != 0 && n = l2_snap_len[i] && memcmp(now, l2_snap_data[i], n) = 0
            same: 1
        if: now != 0
            lm_compiler_xfree((cast: (@: void) now))
        if: same = 0
            return: l2_error(l2_snap_path[i], 0, "the file changed while the program was translated (its first reading is not its bytes now)")
        i: i + 1
    ---
return: 0

fn: l2_snap_free () int
    int: i 0
    while: i < l2_snap_n
        if: l2_snap_doc[i] != 0
            lm_p0_document_destroy(l2_snap_doc[i])
        lm_compiler_xfree((cast: (@: void) l2_snap_path[i]))
        lm_compiler_xfree((cast: (@: void) l2_snap_data[i]))
        i: i + 1
    ---
    if: l2_snap_path != 0
        lm_compiler_xfree((cast: (@: void) l2_snap_path))
    if: l2_snap_data != 0
        lm_compiler_xfree((cast: (@: void) l2_snap_data))
    if: l2_snap_len != 0
        lm_compiler_xfree((cast: (@: void) l2_snap_len))
    if: l2_snap_doc != 0
        lm_compiler_xfree((cast: (@: void) l2_snap_doc))
    l2_snap_path: 0
    l2_snap_data: 0
    l2_snap_len: 0
    l2_snap_doc: 0
    l2_snap_n: 0
    l2_snap_cap: 0
return: 0

fn: l2_pub_commit (const: @(char out_path)) int
    size_t: bseq 0U
    @: FILE chk
    int: had 0
    if: l2_snap_verify() != 0
        c.remove(l2_pub_tmp)
        return: 1
    chk: c.fopen(l2_pub_bak, "rb")
    while: chk != 0
        fclose(chk)
        if: bseq = (cast: (size_t) -1)
            c.remove(l2_pub_tmp)
            return: 1
        bseq: bseq + 1U
        if: c.snprintf(l2_pub_bak, l2_pub_bak_cap, "%s.bak.%zu", out_path, bseq) < 0
            c.remove(l2_pub_tmp)
            return: 1
        chk: c.fopen(l2_pub_bak, "rb")
    ---
    chk: c.fopen(out_path, "rb")
    if: chk != 0
        had: 1
        fclose(chk)
    if: had != 0 && c.rename(out_path, l2_pub_bak) != 0
        c.remove(l2_pub_tmp)
        return: 1
    if: c.rename(l2_pub_tmp, out_path) != 0
        if: had != 0 && c.rename(l2_pub_bak, out_path) != 0
            c.fprintf(l1_stderr(), "l2trans error: publication failed; dest unrestored; backup at %s\n", l2_pub_bak)
            return: 1
        return: 1
    if: had != 0
        c.remove(l2_pub_bak)
return: 0

fn: l2_emit_unit (const: @(char out_path)) int
    int: i 0
    int: k
    int: qn 0
    int: on 0
    int: oi
    @: L2GraphField init_field
    const: @(char array_place) 0
    []: char sx_own 192
    L2Tx: sx_tx
    @: L2Tx sx lm_compiler_tx_local(@ sx_tx, sx_own, 192U)
    []: char sx_name 48
    []: char cs_name_own 64
    L2Tx: cs_name_tx
    @: L2Tx cs_name lm_compiler_tx_local(@ cs_name_tx, cs_name_own, 64U)
    []: char cq_name_own 64
    L2Tx: cq_name_tx
    @: L2Tx cq_name lm_compiler_tx_local(@ cq_name_tx, cq_name_own, 64U)
    []: char pty 96
    unsigned: kids
    int: fx
    int: copy_header 0
    int: nref 0
    size_t: bline 1U
    size_t: bcol 1U
    if: out_path = 0 || l2_m_n = 0 || l2_e < 0
        return: 1
    # S8.2: a machine module has no graph to plan or build; it writes its machine functions alone.
    if: l2_machine_module() != 0
        return: l2_emit_machine_module(out_path)
    # Merge sites are scanned before output so locals and result slots have
    # their final sizes. Throw/Message dependency closure was computed during
    # analysis, before METHOD.sig interning.
    # The widest merge across methods (the entry is one) must be known before
    # the preamble and any callable-local operand array are written.
    l2_merge_max: 0
    l2_qmerge_n: 0
    i: 0
    while: i < l2_m_n
        l2_vis_method(i)
        if: l2_m_body[i] != 0 && l2_m_body[i]\as != 0
            if: l2_merge_scan(l2_m_body[i]\as\structure, i) != 0
                return: 1
            ---
        ---
        i: i + 1
    ---
    l2_vis_on: 0
    i: 0
    # Namespace references were resolved before semantic checking; emission
    # only sizes construction scratch for their already fixed operands.
    fx: 0
    l2_merge_build: 0
    l2_ns_payload_pass: 0
    while: fx < l2_nsf_n
        if: l2_nsf_kind[fx] = 3 && l2_nsf_ref[fx] >= 0 && l2_ns_eternal[l2_nsf_ref[fx]] < 0
            l2_merge_build: 1
            if: 1 > l2_merge_max
                l2_merge_max: 1
            ---
        ---
        fx: fx + 1
    ---
    if: l2_layout_owns() != 0
        return: 1
    if: l2_graph_places_seed() != 0
        return: 1
    # Native compilation does not erase the executable graph. All occurrences,
    # including the unit, use the common count/emission passes.
    l2_rw_emit: 0
    l2_rw_t: 0
    l2_rw_pn: 0
    l2_d105_n: 0
    l2_rw_mi: l2_e
    l2_source_plan_ready: 0
    # The methods' frames are counted too (-193 T4a), before the occurrences' widths are written.
    if: l2_rw_methods_count() != 0
        return: 1
    # A method the translation walks (steps/interpreter-throw-20261010.md item 2): its selected occurrence executes
    # through the walker and may raise the implicit statuses -- `interpreter` on a fault of its own body -- whatever
    # its signature declares, so it is on the status channel (l2_m_throws) as a method that merges or admits is, and
    # its callers close over it (l2_throws_close, run again here: the walked set is known only now, after the count,
    # and no ABI has been written yet; the same closure makes them receive and forward the Message).  A native caller
    # with no declared names then routes the status -- its own `catch: interpreter ()`, its caller, or the root's
    # stop -- where it aborted on the "callable that cannot throw" invariant; that invariant now guards native callees
    # only.  E is the root: no method ABI, it stops on an uncaught status as before.
    i: 0
    while: i < l2_m_n
        if: i != l2_e && l2_walk_methods != 0 && l2_m_steps != 0 && l2_m_steps[i] >= 0 && l2_m_walkable[i] != 0 && l2_m_throws != 0 && l2_m_throws[i] = 0
            l2_m_throws[i]: 1
        i: i + 1
    ---
    if: l2_walk_methods != 0 && l2_throws_close() != 0
        return: 1
    # Status-channel methods declare qualified-copy scratch even when this
    # particular body has no merge or qualified branch. Emit its type header
    # whenever that declaration can be written.
    i: 0
    while: i < l2_m_n
        if: (l2_m_throws != 0 && l2_m_throws[i] != 0) || l2_mad_on(i) != 0
            copy_header: 1
        i: i + 1
    ---
    # Accepted source producers are committed before final prefix/base sizes.
    # PLACE records actual constructor edges without emitting a second graph.
    if: l2_graph_places_seed() != 0 || l2_source_ownership_commit() != 0 || l2_mrs_rebuild_all() != 0 || l2_d105_close() != 0
        return: 1
    l2_unit_base: l2_m_width(l2_e)
    l2_ns_base: l2_unit_base + l2_occ_tail_rank(l2_m_n) + l2_ebr_tail_rank(l2_ebr_n)
    # Provisional source cardinalities feed one common address/schema closure.
    # No backend may emit while those inventories can still change its plan.
    if: l2_source_plan_close() != 0
        return: 1
    if: l2_translation_failed(l2_src, l2_here_node) != 0
        return: 1
    if: l2_expr_sites_dump(c.getenv("L2_EXPR_PLACES_OUT")) != 0
        return: l2_error(l2_src, 0, "internal: the expression place dump could not be written")
    if: l2_cfl_receiving_validate() != 0
        return: 1
    l2_unit_base: l2_m_width(l2_e)
    # Schemas, pairs, source coordinates and source cardinalities are closed
    # together above, not changed after the selected allocation plan.
    # The reserved unit-child bases must be known BEFORE any method body is
    # written: a field path inside a method addresses these same children
    # through the unit reference, and the entry is emitted last. They used to be
    # computed with the entry's child count, which left every in-method path
    # resolving to child 0.
    l2_ns_base: l2_unit_base + l2_occ_tail_rank(l2_m_n) + l2_ebr_tail_rank(l2_ebr_n)
    l2_nso_n: 0
    l2_pub_free()
    if: l2_pub_prepare(out_path) != 0
        return: l2_alloc_or(out_path, 0, "cannot prepare output path")
    l2_out: c.fopen(l2_pub_tmp, "wb")
    if: l2_out = 0
        c.fprintf(l1_stderr(), "l2trans error: cannot open %s\n", out_path)
        return: 1
    if: (l2_has_own_ty(4) != 0 || l2_has_own_ty(5) != 0 || l2_has_own_ty(7) != 0 || l2_has_own_ty(8) != 0 || l2_has_own_ty(37) != 0 || l2_has_pointer_array() != 0 || l2_ns_has_array != 0 || l2_library_mode = 0) && c.fprintf(l2_out, "predef: \"%slmx_array_owned.h.lm1\"\n", l2_rt_root) < 0
        fclose(l2_out)
        return: 1
    if: (l2_has_own_ty(1) != 0 || l2_ns_has_char != 0 || l2_parts_have_char() != 0) && c.fprintf(l2_out, "predef: \"%slmx_chars_owned.h.lm1\"\n", l2_rt_root) < 0
        fclose(l2_out)
        return: 1
    # WHAT STOOD HERE AND IS GONE (FABLE-SONNET-NAME-SPECIALS-20260924-155
    # commit 3): a literal prototype: block for the four lm_own_* names,
    # auto-injected by NAME (l2_need_own, set by l2_text_eq against each of
    # them) whenever any of the four was called, regardless of whether the
    # source unit predef'd them itself. That was a second, narrower name
    # special sitting right next to the one commit 2 deleted from
    # l2_is_known -- and since commit 2, admitting the call at all already
    # REQUIRES l2_predef_has_function(call\head) to be true (l2_check_fields
    # :13061 gates on l2_is_known, which for a non-c.* name is exactly that
    # check), so any unit whose code reaches this emitter for one of these
    # calls already carries a working predef chain for it. Measured
    # (unit_bad_sizeof.lm2, predef: "l1src/own.h.lm1"): the generated L1 had
    # BOTH this injected block and the unit's own predef line, declaring the
    # same four signatures twice: l1trans accepted the duplication (exit 0),
    # which is exactly the redundancy this deletion removes, not a
    # regression it introduces.
    # The root descriptor array is emitted unconditionally, so its constructor
    # is always needed.
    #
    # WHAT STOOD HERE AND IS GONE (48U): a second predef, lmx_owned_ranges.h.lm1,
    # emitted whenever l2_ebr_n was non-zero, justified as "the admitted eternal
    # set IS a range list".  That unit does not exist and never did in this
    # repository -- git knows the path at no commit, and
    # tests/lmx_merge_selftest.lm1:36 records absorbing the coverage of its
    # deleted selftest -- while this emitter went on naming it.  The effect was
    # that EVERY program with an eternal branch emitted L1 no translator could
    # read, which is why the gap was never measured rather than never hit.
    # Nothing generated here calls a symbol of it: qualification is answered by
    # the owner arena's exact profiled ranges, never by a per-program range list.
    if: c.fprintf(l2_out, "predef: \"%slmx_array_ref_owned.h.lm1\"\n", l2_rt_root) < 0
        fclose(l2_out)
        return: 1
    if: (l2_ebr_n > 0 || copy_header != 0) && c.fprintf(l2_out, "predef: \"%slmx_graph_copy_owned.h.lm1\"\n", l2_rt_root) < 0
        fclose(l2_out)
        return: 1
    if: c.fprintf(l2_out, "predef: \"%slmx_source_names.h.lm1\" \"%slmx_array_owned.h.lm1\" \"%slmx_chars.h.lm1\"\n", l2_rt_root, l2_rt_root, l2_rt_root) < 0
        fclose(l2_out)
        return: 1
    # Completed namespace constructors and receiving admissions publish through
