predef: "l2src/tests/fnptr_local_forms.h.lm1"

# GROKBOT-BATCHA-OPPOSITE-CONTROL-20260922-73 / COMPACT-RAWFIELD-BATCHA-72 opposite control.
# Colon `f: value` on a ty40 (fnptr) local must stay assignment/value semantics
# (COMPACT still required for fnptr call at checker/emitter ty40 legs, including
# shared :13082). Must never become a call. Debt pins assignment emit; Absent
# forbids the mis-call shape that dropping ty40 COMPACT would produce.
fn: probe (const: @(L2TestAllocVTable av)) int
    L2TestAllocFn: f
    f: av\alloc
    if: f = 0
        return: 1
    return: 0
end: probe

fn: main () int
    return: 0
end: main