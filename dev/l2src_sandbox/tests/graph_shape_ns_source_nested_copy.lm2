# The stored child and its node belong to the actual copied parent occurrence.
Outer: (int: pad 4; int: tag 9; in: (node\tag: node\tag + 1); in)
copied: merge Outer
copied
if: copied\tag != 10 || Outer\tag != 9
    sendMessage: exit(exit_code: 81; stdout: ""; stderr: "")
    return
Outer
if: copied\tag != 10 || Outer\tag != 10
    sendMessage: exit(exit_code: 82; stdout: ""; stderr: "")
    return
sendMessage: exit(exit_code: 7; stdout: ""; stderr: "")
return
