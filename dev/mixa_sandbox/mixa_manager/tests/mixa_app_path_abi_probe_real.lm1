# ABI parity guard — L1 port of mixa_app_path_abi_probe_real.c (ticket 20260918-082421).
# offsetof is a C macro with no L1 spelling (c. pastes a call, not a preprocessor
# name). Field offsets are computed at run time via pointer arithmetic on a local
# store (same pattern as l2src/lmx_message_selftest.lm1). Output format strings
# are kept byte-identical to the C probe so L2-vs-real parity still diffs stdout.
predef: "mixa_manager/mixa_app_path.h.lm1"
include: "<stdio.h>"

fn: main () int
    MixaAppPathFaultVTable: store0
    @: MixaAppPathFaultVTable p0
    p0: @ store0

    c.printf("MixaAppPathFaultVTable sizeof=%zu\n", c.sizeof(c.MixaAppPathFaultVTable))
    c.printf("MixaAppPathFaultVTable on_alloc=%zu\n", (cast: (size_t) @ p0\on_alloc) - (cast: (size_t) p0))
    c.printf("MixaAppPathFaultVTable ctx=%zu\n", (cast: (size_t) @ p0\ctx) - (cast: (size_t) p0))
    return: 0

