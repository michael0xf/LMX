# slot\in\x is read. Shell\in is a Structure that has no x (K03 NS-ROLES-2: each in is its holder's own nested
# Structure; `Inner: in` and `Bare: in` are calls now).
# Today, before this slice, the first segment `in` was enough and this translated.

Outer:
    in:
        size_t: x 0U
end: Outer

Shell:
    in:
        size_t: y 0U
end: Shell

fn: take (Outer: slot) int
    slot\in\x: 1U
return: 4

fn: go () int
return: take(Shell)
