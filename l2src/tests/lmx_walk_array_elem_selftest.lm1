predef: "l2src/lmx_walk.lm1"
predef: "l2src/lmx_pool.lm1"
predef: "l2src/lmx_arena.lm1"
predef: "l2src/lmx_arena_blocks.lm1"
predef: "l2src/lmx_implements.lm1"
predef: "l2src/lmx_chars.lm1"
predef: "l2src/lmx_chars_owned.lm1"
predef: "l2src/lmx_array_owned.lm1"
predef: "l2src/lmx_array_ref_owned.lm1"
predef: "l2src/lmx_value_owned.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdio.h>" "<stdlib.h>" "<string.h>"

# -170 c2: ELEM / ELEMPUT / LENGTH. Bounds by descriptor.len; char via lmx_char_cell;
# holder 0 = this activation data (K-OT2). Mutants (RED if broken): index==len accepted;
# ELEMPUT char into int array accepted; off-by-one write never read back.

@: LmxArena ga 0
@: Lmx groles 0
@: LmxWalkContext gctx 0
@: LmxWalkValue gv 0
int: broken 0
int: checks 0
int: failures 0

sub: check (int: ok; const: @(char label))
    checks: checks + 1
    if: ok = 0
        failures: failures + 1
        c.printf("FAIL %s\n", label)
    ---
end: check

fn: fr (@: Lmx parent; size_t: slot; int: op; size_t: children) @: Lmx
    @: Lmx n lmx_walk_frame(ga, groles, parent, op, children)
    if: n = 0 || lmx_arena_ref_store(parent, slot, (cast: (@: void) n)) != 0
        broken: broken + 1
        return: 0
    ---
return: n

fn: pl (@: Lmx parent; size_t: slot; size_t: children) @: Lmx
    @: Lmx n lmx_walk_plain(ga, parent, children)
    if: n = 0 || lmx_arena_ref_store(parent, slot, (cast: (@: void) n)) != 0
        broken: broken + 1
        return: 0
    ---
return: n

sub: ref (@: Lmx code; size_t: slot; @: Lmx target)
    if: code = 0 || target = 0 || lmx_arena_ref_store(code, slot, (cast: (@: void) target)) != 0
        broken: broken + 1
    ---
end: ref

sub: sz (@: Lmx code; size_t: slot; size_t: value)
    if: code = 0 || lmx_walk_store_size(ga, code, slot, value) != c.LMX_WALK_OK
        broken: broken + 1
    ---
end: sz

# D-39: the index child is a LIT size node, not a raw size cell in the slot.
fn: ix (@: Lmx op; size_t: value) int
    @: Lmx lit
    lit: fr(op, 2U, c.LMX_WALK_OP_LIT, 2U)
    if: lit = 0
        return: 1
    sz(lit, 1U, value)
return: 0

# -203: child 1 of an array op is an AT. holder 0 is this activation's data.
fn: atop (@: Lmx op; @: Lmx holder; size_t: slot) @: Lmx
    @: Lmx at
    at: fr(op, 1U, c.LMX_WALK_OP_AT, 3U)
    if: holder != 0
        ref(at, 1U, holder)
    ---
    sz(at, 2U, slot)
return: at

sub: lit_int (@: Lmx code; size_t: slot; int: value)
    if: code = 0 || lmx_walk_store_int(ga, code, slot, value) != c.LMX_WALK_OK
        broken: broken + 1
    ---
end: lit_int

sub: lit_char (@: Lmx code; size_t: slot; int: value)
    if: code = 0 || lmx_walk_store_char(ga, code, slot, value) != c.LMX_WALK_OK
        broken: broken + 1
    ---
end: lit_char

fn: mk_m (@: Lmx unit; size_t: slot; size_t: children) @: Lmx
return: pl(unit, slot, children)

fn: go (@: Lmx m) int
    if: m = 0 || gctx = 0 || gv = 0
        return: c.LMX_WALK_INVALID
return: lmx_walk_run(gctx, m, 0, 0U, gv)

fn: main () int
    LmxArena: arena
    LmxArena: context_arena
    LmxPool: context_cells
    LmxScratch: store
    LmxWalkContext: context
    @: Lmx unit 0
    @: Lmx data 0
    @: Lmx m 0
    @: Lmx n 0
    @: Lmx litn 0
    @: LmxArrayDesc desc 0
    @: LmxArrayDesc outer 0
    @: Lmx prof 0
    @: Lmx nest 0
    @: Lmx atn 0
    @: void idxcell 0
    @: void got 0
    int: st 0

    memset((cast: (@: void) (@ arena)), 0, c.sizeof(c.LmxArena))
    if: lmx_arena_open(@ arena) != 0
        return: 2
    ga: @ arena
    groles: lmx_walk_roles_open(ga)
    memset((cast: (@: void) (@ context_arena)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ context_cells)), 0, c.sizeof(c.LmxPool))
    memset((cast: (@: void) (@ store)), 0, c.sizeof(c.LmxScratch))
    if: lmx_arena_open(@ context_arena) != 0 || lmx_scratch_open(@ store, @ context_arena, @ context_cells, 16U) != c.LMX_SCRATCH_OK
        return: 2
    ---
    lmx_walk_program_bind(groles)
    context.arena: ga
    context.scratch: @ store
    context.roles: groles
    context.immutable_profile: 0
    context.classified: 0U
    gctx: @ context
    gv: (cast: (@: LmxWalkValue) calloc(1U, c.sizeof(c.LmxWalkValue)))
    if: gv = 0 || groles = 0
        return: 2
    ---

    unit: lmx_node_new_owned(ga)
    if: unit = 0 || lmx_arena_refs_open_owned(ga, unit, 32U) != 0
        return: 2
    ---

    # ---- int array: ELEMPUT then ELEM read-back (explicit holder) ----
    data: pl(unit, 0U, 2U)
    desc: lmx_array_new_owned(c.LMX_TYPE_ARRAY_OF_INT, 3U, ga)
    if: data = 0 || desc = 0 || lmx_arena_ref_store(data, 1U, (cast: (@: void) desc)) != 0
        return: 2
    ---
    m: mk_m(unit, 1U, 1U)
    n: fr(m, 0U, c.LMX_WALK_OP_ELEMPUT, 4U)
    atop(n, data, 1U)
    ix(n, 1U)
    litn: fr(n, 3U, c.LMX_WALK_OP_LIT, 2U)
    lit_int(litn, 1U, 9)
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_OK)), "ELEMPUT int[1]=9 OK")
    check((cast: (int) (lmx_int_value_known((cast: (@: void) ((cast: (@: char) desc\data) + 1U * c.sizeof(c.int)))) = 9)), "backing int[1]==9")

    m: mk_m(unit, 2U, 1U)
    n: fr(m, 0U, c.LMX_WALK_OP_ELEM, 3U)
    atop(n, data, 1U)
    ix(n, 1U)
    st: go(m)
    got: gv\ref
    check((cast: (int) (st = c.LMX_WALK_OK && got != 0 && lmx_int_value_known(got) = 9)), "ELEM int[1] -> 9")

    # D-39: the index is a size cell in the holder, read by AT, not a literal.
    # Mutant: treat child 2 as a raw size -> this read is not 9.
    idxcell: lmx_size_new_owned(ga)
    if: idxcell = 0 || lmx_size_store_known(idxcell, 1U) != 0 || lmx_arena_ref_store(data, 0U, idxcell) != 0
        return: 2
    ---
    m: mk_m(unit, 22U, 1U)
    n: fr(m, 0U, c.LMX_WALK_OP_ELEM, 3U)
    atop(n, data, 1U)
    atn: fr(n, 2U, c.LMX_WALK_OP_AT, 3U)
    ref(atn, 1U, data)
    sz(atn, 2U, 0U)
    st: go(m)
    got: gv\ref
    check((cast: (int) (st = c.LMX_WALK_OK && got != 0 && lmx_int_value_known(got) = 9)), "ELEM dynamic index AT -> 9")

    # ---- LENGTH ----
    m: mk_m(unit, 3U, 1U)
    n: fr(m, 0U, c.LMX_WALK_OP_LENGTH, 2U)
    atop(n, data, 1U)
    st: go(m)
    got: gv\ref
    check((cast: (int) (st = c.LMX_WALK_OK && got != 0 && lmx_size_value_known(got) = 3U)), "LENGTH -> 3")

    # ---- OOB: index == len -> INVALID (mutant: accept -> RED) ----
    m: mk_m(unit, 4U, 1U)
    n: fr(m, 0U, c.LMX_WALK_OP_ELEM, 3U)
    atop(n, data, 1U)
    ix(n, 3U)
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_INVALID)), "ELEM index==len -> INVALID")

    m: mk_m(unit, 5U, 1U)
    n: fr(m, 0U, c.LMX_WALK_OP_ELEMPUT, 4U)
    atop(n, data, 1U)
    ix(n, 3U)
    litn: fr(n, 3U, c.LMX_WALK_OP_LIT, 2U)
    lit_int(litn, 1U, 1)
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_INVALID)), "ELEMPUT index==len -> INVALID")

    # ---- off-by-one: last index OK ----
    m: mk_m(unit, 6U, 1U)
    n: fr(m, 0U, c.LMX_WALK_OP_ELEMPUT, 4U)
    atop(n, data, 1U)
    ix(n, 2U)
    litn: fr(n, 3U, c.LMX_WALK_OP_LIT, 2U)
    lit_int(litn, 1U, 42)
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_OK)), "ELEMPUT last index OK")

    # ---- char array via lmx_char_cell ----
    data: pl(unit, 7U, 2U)
    desc: lmx_array_new_owned(c.LMX_TYPE_ARRAY_OF_CHAR, 4U, ga)
    if: data = 0 || desc = 0 || lmx_arena_ref_store(data, 1U, (cast: (@: void) desc)) != 0
        return: 2
    ---
    m: mk_m(unit, 8U, 1U)
    n: fr(m, 0U, c.LMX_WALK_OP_ELEMPUT, 4U)
    atop(n, data, 1U)
    ix(n, 0U)
    litn: fr(n, 3U, c.LMX_WALK_OP_LIT, 2U)
    lit_char(litn, 1U, 65)
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_OK)), "ELEMPUT char[0]='A' OK")
    check((cast: (int) ((cast: (@: char) desc\data)[0] = 65)), "backing char[0]==65")

    m: mk_m(unit, 9U, 1U)
    n: fr(m, 0U, c.LMX_WALK_OP_ELEM, 3U)
    atop(n, data, 1U)
    ix(n, 0U)
    st: go(m)
    got: gv\ref
    check((cast: (int) (st = c.LMX_WALK_OK && got != 0 && got = lmx_char_cell(ga, 65))), "ELEM char -> interned 'A'")

    # ---- char vs int cell (mutant: accept -> RED) ----
    m: mk_m(unit, 10U, 1U)
    n: fr(m, 0U, c.LMX_WALK_OP_ELEMPUT, 4U)
    atop(n, data, 1U)
    ix(n, 1U)
    litn: fr(n, 3U, c.LMX_WALK_OP_LIT, 2U)
    lit_int(litn, 1U, 1)
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_INVALID)), "ELEMPUT int into char array -> INVALID")

    # int array + char value
    data: pl(unit, 11U, 2U)
    desc: lmx_array_new_owned(c.LMX_TYPE_ARRAY_OF_INT, 2U, ga)
    if: data = 0 || desc = 0 || lmx_arena_ref_store(data, 1U, (cast: (@: void) desc)) != 0
        return: 2
    ---
    m: mk_m(unit, 12U, 1U)
    n: fr(m, 0U, c.LMX_WALK_OP_ELEMPUT, 4U)
    atop(n, data, 1U)
    ix(n, 0U)
    litn: fr(n, 3U, c.LMX_WALK_OP_LIT, 2U)
    lit_char(litn, 1U, 7)
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_INVALID)), "ELEMPUT char into int array -> INVALID")

    # ---- holder 0 = this activation data (K-OT2) ----
    # m is both code and data: array at slot 1, ELEMPUT step at slot 0 with holder left 0.
    m: pl(unit, 13U, 2U)
    desc: lmx_array_new_owned(c.LMX_TYPE_ARRAY_OF_INT, 2U, ga)
    if: m = 0 || desc = 0 || lmx_arena_ref_store(m, 1U, (cast: (@: void) desc)) != 0
        return: 2
    ---
    n: fr(m, 0U, c.LMX_WALK_OP_ELEMPUT, 4U)
    # AT holder 0 -> K-OT2 this activation data
    atop(n, 0, 1U)
    ix(n, 0U)
    litn: fr(n, 3U, c.LMX_WALK_OP_LIT, 2U)
    lit_int(litn, 1U, 77)
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_OK)), "ELEMPUT holder0 OK")
    check((cast: (int) (lmx_int_value_known((cast: (@: void) ((cast: (@: char) desc\data) + 0U * c.sizeof(c.int)))) = 77)), "holder0 wrote int[0]==77")

    m: pl(unit, 14U, 2U)
    if: m = 0 || lmx_arena_ref_store(m, 1U, (cast: (@: void) desc)) != 0
        return: 2
    ---
    n: fr(m, 0U, c.LMX_WALK_OP_LENGTH, 2U)
    atop(n, 0, 1U)
    st: go(m)
    got: gv\ref
    check((cast: (int) (st = c.LMX_WALK_OK && got != 0 && lmx_size_value_known(got) = 2U)), "LENGTH holder0 -> 2")

    # A non-array operand is a refusal. Mutant: skip the kind test -> silent trash RED.
    m: mk_m(unit, 15U, 1U)
    n: fr(m, 0U, c.LMX_WALK_OP_ELEM, 3U)
    litn: fr(n, 1U, c.LMX_WALK_OP_LIT, 2U)
    lit_int(litn, 1U, 1)
    ix(n, 0U)
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_INVALID)), "ELEM non-array -> INVALID")

    # Nested descriptors: ELEM of an ARRAY_OF_DESC yields the inner descriptor
    # address, and a second ELEM reads that address. \out of the outer ELEM is
    # that address, not a numeric cell.
    data: pl(unit, 16U, 2U)
    desc: lmx_array_new_owned(c.LMX_TYPE_ARRAY_OF_INT, 2U, ga)
    if: data = 0 || desc = 0 || lmx_arena_ref_store(data, 1U, (cast: (@: void) desc)) != 0
        return: 2
    ---
    m: mk_m(unit, 17U, 1U)
    n: fr(m, 0U, c.LMX_WALK_OP_ELEMPUT, 4U)
    atop(n, data, 1U)
    ix(n, 0U)
    litn: fr(n, 3U, c.LMX_WALK_OP_LIT, 2U)
    lit_int(litn, 1U, 5)
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_OK)), "inner ELEMPUT 5 OK")
    outer: lmx_array_ref_new_owned(c.LMX_TYPE_ARRAY_OF_DESC, 1U, ga)
    m: pl(unit, 18U, 2U)
    if: outer = 0 || m = 0 || lmx_arena_ref_store(m, 1U, (cast: (@: void) outer)) != 0
        return: 2
    ---
    n: fr(m, 0U, c.LMX_WALK_OP_ELEMPUT, 4U)
    atop(n, m, 1U)
    ix(n, 0U)
    nest: fr(n, 3U, c.LMX_WALK_OP_AT, 3U)
    ref(nest, 1U, data)
    sz(nest, 2U, 1U)
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_OK)), "ELEMPUT inner desc into outer[0]")
    litn: m
    m: mk_m(unit, 19U, 1U)
    n: fr(m, 0U, c.LMX_WALK_OP_ELEM, 3U)
    nest: fr(n, 1U, c.LMX_WALK_OP_ELEM, 3U)
    atop(nest, litn, 1U)
    ix(nest, 0U)
    ix(n, 0U)
    st: go(m)
    got: gv\ref
    check((cast: (int) (st = c.LMX_WALK_OK && got != 0 && lmx_int_value_known(got) = 5)), "ELEM(ELEM(outer)) -> 5")

    # Immutable descriptor through the evaluated operand. Mutant: skip
    # lmx_walk_immutable on that address -> this ELEMPUT goes green, RED.
    prof: lmx_node_new_owned(ga)
    desc: (cast: (@: LmxArrayDesc) lmx_arena_take_profiled(ga, c.sizeof(c.LmxArrayDesc), c.LMX_KIND_ARRAY, c.LMX_TYPE_ARRAY_OF_INT, prof))
    if: prof = 0 || desc = 0
        return: 2
    desc\len: 1U
    desc\data: lmx_arena_take_n(ga, c.sizeof(c.int), c.LMX_KIND_PRIMITIVE, c.LMX_TYPE_INT, 1U)
    if: desc\data = 0
        return: 2
    ---
    data: pl(unit, 20U, 2U)
    if: data = 0 || lmx_arena_ref_store(data, 1U, (cast: (@: void) desc)) != 0
        return: 2
    ---
    context.immutable_profile: prof
    m: mk_m(unit, 21U, 1U)
    n: fr(m, 0U, c.LMX_WALK_OP_ELEMPUT, 4U)
    atop(n, data, 1U)
    ix(n, 0U)
    litn: fr(n, 3U, c.LMX_WALK_OP_LIT, 2U)
    lit_int(litn, 1U, 3)
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_INVALID)), "ELEMPUT immutable operand -> INVALID")
    context.immutable_profile: 0

    if: broken != 0
        c.printf("broken fixture %d\n", broken)
        return: 2
    ---
    if: failures != 0
        c.printf("lmx_walk_array_elem_selftest %d/%d FAILED\n", failures, checks)
        return: 1
    ---
    c.printf("OK %d checks\n", checks)
return: 0
