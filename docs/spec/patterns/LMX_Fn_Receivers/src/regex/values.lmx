# Ready Pattern values; none of these names invokes a nullary method.

RxReadyEmptyPatternConfig:
    @: probe RxEmptyProbe\probe
    @: payload 0

RxReadyEmptyPattern:
    Call:
        private:
            @RxPreparedSource: source
            int: position
            @: captures
        required: source position captures
        return: @
        open:
            return: RxPrimitiveOpen\open(config := RxReadyEmptyPatternConfig; source := source; position := position; captures := captures)

const: @: emptyPattern RxReadyEmptyPattern\Call\open

