# Self declarations keep physical occurrences; a bare name selects the formal.
sub: main () (
    Args:
        int: x 5
    Self:
        int: x 2
        int: x 3
        int: seen 0
        x := x + 1
        seen := x
)
    call(Args Self Self)
main()
int: args main\data\Args\x
int: first main\data\Self\[0]x
int: second main\data\Self\[1]x
int: seen main\data\Self\seen
