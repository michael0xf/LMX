---
    Observed:
        int: seen 6
        int: calls 0
    end: Observed
---
fn: producer () int
    @: shared (node [] 0)
    :=: ((shared \ Observed) \ calls) (((shared \ Observed) \ calls) + 1)
    return: 7
end: producer
Any:
end: Any
fn: h (@: a Any; int: b 6) int
    return: b
end: h
sub: main ()
    @: shared (node [] 0)
    :=: ((shared \ Observed) \ seen) (h (int b (producer)))
end: main
main:
