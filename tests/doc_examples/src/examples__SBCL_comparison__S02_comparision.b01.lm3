Example:
    int[]: items
    return: @
    run:
        int[]: result []
        int: used 0
        int: i 0
        while: i < length(items)
            if: items[i] > 0
                sys\resize(result; used + 1)
                result[used] := items[i]
                used += 1
            i += 1
        return: result
