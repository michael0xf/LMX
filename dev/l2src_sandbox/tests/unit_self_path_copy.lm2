# A copied callable uses its current occurrence for explicit M paths.
A:
    fn: M
end: A
fn: M () size_t
    size_t: hits
    M\hits: M\hits + 1U
return: M\hits

M\hits: 0U
R: merge: A
size_t: a1 A\M()
size_t: r1 R\M()
size_t: a2 A\M()
size_t: r2 R\M()
if: a1 != 1U || a2 != 2U || r1 != 1U || r2 != 2U
    sendMessage: exit(exit_code: 81; stdout: ""; stderr: "")
    return
sendMessage: exit(exit_code: 7; stdout: ""; stderr: "")
return
