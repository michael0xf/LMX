predef: "l2src/lmx_walk.lm1"
predef: "l2src/lmx_interp.lm1"
predef: "l2src/lmx_pool.lm1"
predef: "l2src/lmx_arena.lm1"
predef: "l2src/lmx_arena_blocks.lm1"
predef: "l2src/lmx_implements.lm1"
predef: "l2src/lmx_chars_owned.lm1"
predef: "l2src/lmx_array_owned.lm1"
predef: "l2src/lmx_array_ref_owned.lm1"
predef: "l2src/lmx_graph_copy_owned.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdio.h>" "<stdlib.h>" "<string.h>"

# The walk of a body tree, on graphs built by hand: no translator emits body nodes yet.
# Every program below is an ordinary callable occurrence M in one unit; its body is M
# after child[0], and every reference inside it is a position, never a name and never a
# pointer into M.

@: LmxArena ga 0
int: broken 0
int: checks 0
int: failures 0

sub: check (int: ok; const: @(char label))
    checks: checks + 1
    if: ok = 0
        failures: failures + 1
        c.printf("FAIL %s\n", label)
    ---
end: check

# A frame node under `parent`, stored into parent[slot].
fn: fr (@: Lmx parent; size_t: slot; int: op; size_t: children) @: Lmx
    @: Lmx n lmx_walk_frame(ga, parent, op, children)
    if: n = 0 || lmx_arena_ref_store(parent, slot, (cast: (@: void) n)) != 0
        broken: broken + 1
        return: 0
    ---
return: n

# A plain Structure (a body, a path) under `parent`, stored into parent[slot].
fn: pl (@: Lmx parent; size_t: slot; size_t: children) @: Lmx
    @: Lmx n lmx_walk_plain(ga, parent, children)
    if: n = 0 || lmx_arena_ref_store(parent, slot, (cast: (@: void) n)) != 0
        broken: broken + 1
        return: 0
    ---
return: n

sub: sz (@: Lmx code; size_t: slot; size_t: value)
    if: code = 0 || lmx_walk_store_size(ga, code, slot, value) != c.LMX_WALK_OK
        broken: broken + 1
    ---
end: sz

# An own int cell of `holder` at `slot`, with its initial value.
fn: icell (@: Lmx holder; size_t: slot; int: value) @: void
    if: holder = 0 || lmx_walk_store_int(ga, holder, slot, value) != c.LMX_WALK_OK
        broken: broken + 1
        return: 0
    ---
return: lmx_arena_ref_value(holder, slot)

fn: lit (@: Lmx parent; size_t: slot; int: value) @: Lmx
    @: Lmx n fr(parent, slot, c.LMX_WALK_OP_LIT, 2U)
    if: n != 0 && lmx_walk_store_int(ga, n, 1U, value) != c.LMX_WALK_OK
        broken: broken + 1
    ---
return: n

fn: own1 (@: Lmx parent; size_t: slot; size_t: i0) @: Lmx
    @: Lmx n fr(parent, slot, c.LMX_WALK_OP_OWN, 2U)
    sz(n, 1U, i0)
return: n

fn: own3 (@: Lmx parent; size_t: slot; size_t: i0; size_t: i1; size_t: i2) @: Lmx
    @: Lmx n fr(parent, slot, c.LMX_WALK_OP_OWN, 4U)
    sz(n, 1U, i0)
    sz(n, 2U, i1)
    sz(n, 3U, i2)
return: n

fn: argn (@: Lmx parent; size_t: slot; size_t: k) @: Lmx
    @: Lmx n fr(parent, slot, c.LMX_WALK_OP_ARG, 2U)
    sz(n, 1U, k)
return: n

# path [up, i0]: a child of a lexical ancestor.
fn: path2 (@: Lmx parent; size_t: slot; size_t: up; size_t: i0) @: Lmx
    @: Lmx n pl(parent, slot, 2U)
    sz(n, 0U, up)
    sz(n, 1U, i0)
return: n

# path [up, i0, i1]: a slot of a child of a lexical ancestor.
fn: path3 (@: Lmx parent; size_t: slot; size_t: up; size_t: i0; size_t: i1) @: Lmx
    @: Lmx n pl(parent, slot, 3U)
    sz(n, 0U, up)
    sz(n, 1U, i0)
    sz(n, 2U, i1)
return: n

# A callable occurrence under the unit: child[0] is a fresh LmxCallable, nothing native.
fn: mk_m (@: Lmx unit; size_t: slot; size_t: children) @: Lmx
    @: Lmx m pl(unit, slot, children)
    @: LmxCallable info lmx_callable_new_owned(ga)
    if: m = 0 || info = 0 || lmx_arena_ref_store(m, 0U, (cast: (@: void) info)) != 0
        broken: broken + 1
        return: 0
    ---
return: m

fn: main () int
    LmxArena: arena
    @: LmxArena pa 0
    @: Lmx unit 0
    @: Lmx m 0
    @: Lmx n 0
    @: Lmx b 0
    @: Lmx e 0
    @: Lmx counter 0
    @: Lmx outer 0
    @: Lmx summer 0
    @: Lmx looper 0
    @: Lmx bare 0
    @: Lmx faller 0
    @: Lmx direct 0
    @: Lmx stopper 0
    @: Lmx refuser 0
    @: Lmx orderer 0
    LmxWalkFrame: frame
    @: LmxWalkFrame pf 0
    @: LmxWalkOwn po 0
    @: Lmx copy 0
    @: void cell 0
    @: void xcell 0
    @: int args 0
    int: r 0
    int: st 0

    memset((cast: (@: void) (@ arena)), 0, c.sizeof(c.LmxArena))
    if: lmx_arena_open(@ arena) != 0
        fputs("lmx_walk: arena\n", l1_stdout())
        return: 2
    pa: @ arena
    ga: pa
    args: (cast: (@: int) calloc(1U, c.sizeof(int)))
    unit: lmx_node_new_owned(ga)
    if: args = 0 || unit = 0 || lmx_arena_refs_open_owned(ga, unit, 13U) != 0
        fputs("lmx_walk: unit\n", l1_stdout())
        return: 2
    ---

    # unit[0] counter:   own n 0;  n: n + 1;  return: n
    counter: mk_m(unit, 0U, 4U)
    cell: icell(counter, 1U, 0)
    n: fr(counter, 2U, c.LMX_WALK_OP_SET, 3U)
    own1(n, 1U, 1U)
    e: fr(n, 2U, c.LMX_WALK_OP_ADD, 3U)
    own1(e, 1U, 1U)
    lit(e, 2U, 1)
    n: fr(counter, 3U, c.LMX_WALK_OP_RET, 2U)
    own1(n, 1U, 1U)

    # unit[1] outer:     own x 1;  inner;  return: x          (21.6's worked case)
    # unit[2] inner:     outer\x: 2                           (explicit path, no cache)
    outer: mk_m(unit, 1U, 4U)
    xcell: icell(outer, 1U, 1)
    n: fr(outer, 2U, c.LMX_WALK_OP_CALL, 2U)
    path2(n, 1U, 1U, 2U)
    n: fr(outer, 3U, c.LMX_WALK_OP_RET, 2U)
    own1(n, 1U, 1U)
    m: mk_m(unit, 2U, 2U)
    n: fr(m, 1U, c.LMX_WALK_OP_PUT, 3U)
    path3(n, 1U, 1U, 1U, 1U)
    lit(n, 2U, 2)

    # unit[3] publisher: own y 0;  y: 5;  return: reader()    (dirty published before a call)
    # unit[4] reader:    return: publisher\y                  (reads the graph)
    m: mk_m(unit, 3U, 4U)
    icell(m, 1U, 0)
    n: fr(m, 2U, c.LMX_WALK_OP_SET, 3U)
    own1(n, 1U, 1U)
    lit(n, 2U, 5)
    n: fr(m, 3U, c.LMX_WALK_OP_RET, 2U)
    e: fr(n, 1U, c.LMX_WALK_OP_CALL, 2U)
    path2(e, 1U, 1U, 4U)
    m: mk_m(unit, 4U, 2U)
    n: fr(m, 1U, c.LMX_WALK_OP_RET, 2U)
    e: fr(n, 1U, c.LMX_WALK_OP_AT, 2U)
    path3(e, 1U, 1U, 3U, 1U)

    # unit[5] summer (k): if: k < 1 { return: 0 };  return: k + summer(k - 1)
    summer: mk_m(unit, 5U, 3U)
    n: fr(summer, 1U, c.LMX_WALK_OP_IF, 3U)
    e: fr(n, 1U, c.LMX_WALK_OP_LT, 3U)
    argn(e, 1U, 0U)
    lit(e, 2U, 1)
    b: pl(n, 2U, 1U)
    e: fr(b, 0U, c.LMX_WALK_OP_RET, 2U)
    lit(e, 1U, 0)
    n: fr(summer, 2U, c.LMX_WALK_OP_RET, 2U)
    e: fr(n, 1U, c.LMX_WALK_OP_ADD, 3U)
    argn(e, 1U, 0U)
    n: fr(e, 2U, c.LMX_WALK_OP_CALL, 3U)
    path2(n, 1U, 1U, 5U)
    e: fr(n, 2U, c.LMX_WALK_OP_SUB, 3U)
    argn(e, 1U, 0U)
    lit(e, 2U, 1)

    # unit[6] looper (k): own acc 0; own i 0
    #                     while: i < k { own t 0;  t: i + 1;  acc: acc + t;  i: t }
    #                     return: acc
    # `t` is a field of the loop's body: its path from the reserved node is 3, 2, 0.
    looper: mk_m(unit, 6U, 5U)
    icell(looper, 1U, 0)
    icell(looper, 2U, 0)
    n: fr(looper, 3U, c.LMX_WALK_OP_WHILE, 3U)
    e: fr(n, 1U, c.LMX_WALK_OP_LT, 3U)
    own1(e, 1U, 2U)
    argn(e, 2U, 0U)
    b: pl(n, 2U, 4U)
    icell(b, 0U, 0)
    n: fr(b, 1U, c.LMX_WALK_OP_SET, 3U)
    own3(n, 1U, 3U, 2U, 0U)
    e: fr(n, 2U, c.LMX_WALK_OP_ADD, 3U)
    own1(e, 1U, 2U)
    lit(e, 2U, 1)
    n: fr(b, 2U, c.LMX_WALK_OP_SET, 3U)
    own1(n, 1U, 1U)
    e: fr(n, 2U, c.LMX_WALK_OP_ADD, 3U)
    own1(e, 1U, 1U)
    own3(e, 2U, 3U, 2U, 0U)
    n: fr(b, 3U, c.LMX_WALK_OP_SET, 3U)
    own1(n, 1U, 2U)
    own3(n, 2U, 3U, 2U, 0U)
    n: fr(looper, 4U, c.LMX_WALK_OP_RET, 2U)
    own1(n, 1U, 1U)

    # unit[7] bare:      own q 3                              (no body node at all)
    bare: mk_m(unit, 7U, 2U)
    icell(bare, 1U, 3)

    # unit[8] faller:    own z 0;  z: 7                       (void: falls off the end)
    faller: mk_m(unit, 8U, 3U)
    icell(faller, 1U, 0)
    n: fr(faller, 2U, c.LMX_WALK_OP_SET, 3U)
    own1(n, 1U, 1U)
    lit(n, 2U, 7)

    # unit[9] direct:    return: counter()      the callee M stored in child 1 of the call,
    #                                           the form lmx_interp_exec reads
    direct: mk_m(unit, 9U, 2U)
    n: fr(direct, 1U, c.LMX_WALK_OP_RET, 2U)
    e: fr(n, 1U, c.LMX_WALK_OP_CALL, 2U)
    if: e = 0 || lmx_arena_ref_store(e, 1U, (cast: (@: void) counter)) != 0
        broken: broken + 1
    ---

    # unit[10] stopper:  own w 0;  w: 9;  return;  w: 11      a BARE LmxOp return
    stopper: mk_m(unit, 10U, 5U)
    icell(stopper, 1U, 0)
    n: fr(stopper, 2U, c.LMX_WALK_OP_SET, 3U)
    own1(n, 1U, 1U)
    lit(n, 2U, 9)
    if: stopper = 0 || lmx_arena_ref_store(stopper, 3U, (cast: (@: void) lmx_op_new_owned(ga, c.LMX_OP_RETURN))) != 0
        broken: broken + 1
    ---
    n: fr(stopper, 4U, c.LMX_WALK_OP_SET, 3U)
    own1(n, 1U, 1U)
    lit(n, 2U, 11)

    # unit[11] refuser:  own v 0;  v: 5;  if: 1 { } else { <a node with an op code nobody reads> }
    # The unsupported node sits in a branch that would never be taken.
    refuser: mk_m(unit, 11U, 4U)
    icell(refuser, 1U, 0)
    n: fr(refuser, 2U, c.LMX_WALK_OP_SET, 3U)
    own1(n, 1U, 1U)
    lit(n, 2U, 5)
    n: fr(refuser, 3U, c.LMX_WALK_OP_IF, 4U)
    lit(n, 1U, 1)
    pl(n, 2U, 0U)
    b: pl(n, 3U, 1U)
    e: pl(b, 0U, 1U)
    if: e = 0 || lmx_arena_ref_store(e, 0U, (cast: (@: void) lmx_op_new_owned(ga, 99))) != 0
        broken: broken + 1
    ---

    # unit[12] orderer:  own a 0; own b 0;  b: 2;  while: 0 { own t 0;  t: 3 };  a: 1
    # The body mentions b, then t, then a; lexically the fields stand a, b, t.
    orderer: mk_m(unit, 12U, 6U)
    icell(orderer, 1U, 0)
    icell(orderer, 2U, 0)
    n: fr(orderer, 3U, c.LMX_WALK_OP_SET, 3U)
    own1(n, 1U, 2U)
    lit(n, 2U, 2)
    n: fr(orderer, 4U, c.LMX_WALK_OP_WHILE, 3U)
    lit(n, 1U, 0)
    b: pl(n, 2U, 2U)
    icell(b, 0U, 0)
    e: fr(b, 1U, c.LMX_WALK_OP_SET, 3U)
    own3(e, 1U, 4U, 2U, 0U)
    lit(e, 2U, 3)
    n: fr(orderer, 5U, c.LMX_WALK_OP_SET, 3U)
    own1(n, 1U, 1U)
    lit(n, 2U, 1)

    check(c.LMX_WALK_OP_RET = c.LMX_OP_RETURN && c.LMX_WALK_OP_CALL = c.LMX_OP_CALL, "codes agree with lmx_interp.h")
    check(broken = 0, "construction")
    if: broken != 0
        c.printf("lmx_walk: %d construction steps failed\n", broken)
        return: 2
    ---

    # counter: the executed assignment is published at the return, and the next
    # activation starts from the published value.
    r: -1
    st: lmx_walk_run(ga, counter, 0, 0U, @ r)
    check(st = c.LMX_WALK_OK && r = 1, "counter first run returns 1")
    check(lmx_int_value_known(cell) = 1, "counter published n = 1")
    st: lmx_walk_run(ga, counter, 0, 0U, @ r)
    check(st = c.LMX_WALK_OK && r = 2, "counter second run returns 2")

    # 21.6: inner rewrote outer's graph field; outer's clean working value is neither
    # reloaded (it returns its entry snapshot) nor republished over the newer value.
    r: -1
    st: lmx_walk_run(ga, outer, 0, 0U, @ r)
    check(st = c.LMX_WALK_OK && r = 1, "outer returns its entry snapshot, no reload")
    check(lmx_int_value_known(xcell) = 2, "clean own value was not republished")

    # 21.6: a dirty value is published before the outbound call.
    r: -1
    st: lmx_walk_run(ga, lmx_arena_ref_struct(unit, 3U), 0, 0U, @ r)
    check(st = c.LMX_WALK_OK && r = 5, "dirty value published before the call")

    # Recursion is recursion of the C stack on one published M; an early return inside
    # a nested body ends the activation, the last return is never reached then.
    r: -1
    args[0]: 4
    st: lmx_walk_run(ga, summer, args, 1U, @ r)
    check(st = c.LMX_WALK_OK && r = 10, "summer(4) = 10")
    r: -1
    args[0]: 0
    st: lmx_walk_run(ga, summer, args, 1U, @ r)
    check(st = c.LMX_WALK_OK && r = 0, "summer(0) takes the early return")
    st: lmx_walk_run(ga, summer, 0, 0U, @ r)
    check(st = c.LMX_WALK_INVALID, "a missing declared input is refused")

    # A field of a nested body is reached by position through the body.
    r: -1
    args[0]: 4
    st: lmx_walk_run(ga, looper, args, 1U, @ r)
    check(st = c.LMX_WALK_OK && r = 10, "looper(4) = 10")
    check(lmx_int_value_known(lmx_arena_ref_value(looper, 1U)) = 10, "looper published acc")
    check(lmx_int_value_known(lmx_arena_ref_value(looper, 2U)) = 4, "looper published i")

    # No body node: nothing to walk, and nothing is invented.
    st: lmx_walk_run(ga, bare, 0, 0U, @ r)
    check(st = c.LMX_WALK_NO_GRAPH, "a callable without body nodes is NO_GRAPH")
    st: lmx_walk_run(ga, unit, 0, 0U, @ r)
    check(st = c.LMX_WALK_INVALID, "a Structure that is not a callable is refused")

    # Falling off the end is an exit: the dirty value is published, no result is written.
    r: -77
    st: lmx_walk_run(ga, faller, 0, 0U, @ r)
    check(st = c.LMX_WALK_OK && r = -77, "void fall-off leaves the result alone")
    check(lmx_int_value_known(lmx_arena_ref_value(faller, 1U)) = 7, "void fall-off published z")

    # Grok's forms are read as they are: a callee M stored directly in the call, and a
    # bare LmxOp return (it still publishes what is dirty, and ends the body there).
    r: -1
    st: lmx_walk_run(ga, direct, 0, 0U, @ r)
    check(st = c.LMX_WALK_OK && r = 3, "direct callee in child 1 of the call")
    st: lmx_walk_run(ga, stopper, 0, 0U, @ r)
    check(st = c.LMX_WALK_OK && lmx_int_value_known(lmx_arena_ref_value(stopper, 1U)) = 9, "bare return publishes and stops")

    # A node outside the slice is reported at entry, wherever it sits, and nothing of the
    # activation runs: the assignment before it is neither executed nor published.
    st: lmx_walk_run(ga, refuser, 0, 0U, @ r)
    check(st = c.LMX_WALK_UNSUPPORTED, "an unread op code is UNSUPPORTED, not skipped")
    check(lmx_int_value_known(lmx_arena_ref_value(refuser, 1U)) = 0, "nothing ran before the refusal")

    # Entry keeps the own records in the lexical order of the fields, which is the order
    # of every checkpoint -- not the order in which the body mentions them.
    pf: @ frame
    st: lmx_walk_enter(pf, ga, orderer, 0, 0U)
    check(st = c.LMX_WALK_OK && pf\nowns = 3U, "orderer loads three own fields")
    if: st = c.LMX_WALK_OK && pf\nowns = 3U
        po: pf\owns
        check(po\from = lmx_arena_ref_cell(orderer, 1U), "first record is field a")
        po: pf\owns + 1U
        check(po\from = lmx_arena_ref_cell(orderer, 2U), "second record is field b")
        po: pf\owns + 2U
        check(po\from = lmx_arena_ref_cell(lmx_arena_ref_struct(lmx_arena_ref_struct(orderer, 4U), 2U), 0U), "third record is the loop body's field t")
    ---
    lmx_walk_leave(pf)

    # A COPY of M runs unchanged on its own state: body nodes hold positions, so nothing
    # in them points back into the original; child[0] is shared by address.
    st: lmx_graph_copy_owned(counter, 0, ga, ga, @ copy)
    check(st = c.LMX_GRAPH_COPY_OK && copy != 0 && copy != counter, "counter copied")
    if: copy != 0
        check(lmx_arena_ref_value(copy, 0U) = lmx_arena_ref_value(counter, 0U), "copy shares child[0]")
        check(lmx_arena_ref_value(copy, 1U) != cell, "copy has its own n")
        r: -1
        st: lmx_walk_run(ga, copy, 0, 0U, @ r)
        check(st = c.LMX_WALK_OK && r = 4, "copy continues from the copied value")
        check(lmx_int_value_known(cell) = 3, "original n untouched by the copy's run")
        check(lmx_int_value_known(lmx_arena_ref_value(copy, 1U)) = 4, "copy published into its own n")
    ---

    free((cast: (@: void) args))
    if: failures != 0
        c.printf("lmx_walk: %d failed of %d\n", failures, checks)
        return: 1
    ---
    c.printf("lmx_walk: %d checks\n", checks)
return: 0
