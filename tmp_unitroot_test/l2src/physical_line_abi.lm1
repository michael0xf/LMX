# C ABI: frozen parser physical-line symbols -> their L2 callables.
predef: "l2src/lmx.h.lm1"
predef: "l2src/lmx_arena_refs.h.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stddef.h>" "<stdio.h>"

extern: @: Lmx l2_physical_unit

prototype:
    fn: l2_physical_boot () int
    fn: l2_physical_m2 (@: Lmx node; const: @(char text); size_t: index) int
    fn: l2_physical_m3 (@: Lmx node; const: @(char source); size_t: length; size_t: start) size_t
    fn: l2_physical_m4 (@: Lmx node; const: @(char source); size_t: start; size_t: end) int
    fn: l2_physical_m6 (@: Lmx node; const: @(char source); size_t: start; size_t: end) size_t
    fn: l2_physical_m7 (@: Lmx node; const: @(char text); size_t: length; size_t: index; size_t: base_line; size_t: base_column; @: size_t out_line; @: size_t out_column) void
    fn: l2_physical_m8 (@: Lmx node; size_t: column) size_t
    fn: l2_physical_m9 (@: Lmx node; const: @(char source); size_t: start; size_t: end) size_t
    fn: l2_physical_m10 (@: Lmx node; const: @(char source); size_t: start; size_t: end; @: size_t out_offset; @: size_t out_column) void
    fn: l2_physical_m11 (@: Lmx node; const: @(char source); size_t: length; size_t: line_start; size_t: line_end; @: size_t offset; @: size_t line) void
end: prototype

int: l2_physical_line_calls 0

fn: l2_physical_ensure () void
    if: l2_physical_unit = 0
        if: c.l2_physical_boot() != 0 || l2_physical_unit = 0
            fputs("l2_physical_boot failed\n", l1_stderr())
---

fn: lm_p0_index_is_line_start (const: @(char text); size_t: index) int
    l2_physical_ensure()
    l2_physical_line_calls: l2_physical_line_calls + 1
    return: c.l2_physical_m2(c.lmx_arena_ref_struct(l2_physical_unit, 2U), text, index)

fn: lm_p0_find_physical_line_end (const: @(char source); size_t: length; size_t: start) size_t
    l2_physical_ensure()
    l2_physical_line_calls: l2_physical_line_calls + 1
    return: c.l2_physical_m3(c.lmx_arena_ref_struct(l2_physical_unit, 3U), source, length, start)

fn: lm_p0_line_rest_is_horizontal_space (const: @(char source); size_t: start; size_t: end) int
    l2_physical_ensure()
    l2_physical_line_calls: l2_physical_line_calls + 1
    return: c.l2_physical_m4(c.lmx_arena_ref_struct(l2_physical_unit, 4U), source, start, end)

fn: lm_p0_count_line_breaks (const: @(char source); size_t: start; size_t: end) size_t
    l2_physical_ensure()
    l2_physical_line_calls: l2_physical_line_calls + 1
    return: c.l2_physical_m6(c.lmx_arena_ref_struct(l2_physical_unit, 6U), source, start, end)

fn: lm_p0_position_in_slice (const: @(char text); size_t: length; size_t: index; size_t: base_line; size_t: base_column; @: size_t out_line; @: size_t out_column) void
    l2_physical_ensure()
    l2_physical_line_calls: l2_physical_line_calls + 1
    c.l2_physical_m7(c.lmx_arena_ref_struct(l2_physical_unit, 7U), text, length, index, base_line, base_column, out_line, out_column)

fn: lm_p0_indent_tab_column (size_t: column) size_t
    l2_physical_ensure()
    l2_physical_line_calls: l2_physical_line_calls + 1
    return: c.l2_physical_m8(c.lmx_arena_ref_struct(l2_physical_unit, 8U), column)

fn: lm_p0_visual_column_between (const: @(char source); size_t: start; size_t: end) size_t
    l2_physical_ensure()
    l2_physical_line_calls: l2_physical_line_calls + 1
    return: c.l2_physical_m9(c.lmx_arena_ref_struct(l2_physical_unit, 9U), source, start, end)

fn: lm_p0_scan_indent_column (const: @(char source); size_t: start; size_t: end; @: size_t out_offset; @: size_t out_column) void
    l2_physical_ensure()
    l2_physical_line_calls: l2_physical_line_calls + 1
    c.l2_physical_m10(c.lmx_arena_ref_struct(l2_physical_unit, 10U), source, start, end, out_offset, out_column)

fn: lm_p0_advance_layout_line (const: @(char source); size_t: length; size_t: line_start; size_t: line_end; @: size_t offset; @: size_t line) void
    l2_physical_ensure()
    l2_physical_line_calls: l2_physical_line_calls + 1
    c.l2_physical_m11(c.lmx_arena_ref_struct(l2_physical_unit, 11U), source, length, line_start, line_end, offset, line)
