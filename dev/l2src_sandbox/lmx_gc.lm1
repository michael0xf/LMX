predef: "l2src/lmx_gc_graph.lm1"
predef: "l2src/lmx_post.lm1"

# lmx_gc.lm1 - the mark and the sweep.  See the header for what the model asks; what is worth
# spelling out here is the two directions of the pass:
#
#   the MARK never frees and never moves: it stamps chunks and follows words;
#   the SWEEP never guesses: a block stays unless the block list says the pass did not reach
#   it, and a block that leaves the list has its interval retired BEFORE its storage goes.
#
# A chunk's storage and its record are two blocks of the arena's list, so a chunk that the pass
# did not reach is released twice over: first it leaves its array's chain (so the array never
# hands out storage that is about to be freed), then its two blocks are dropped and disposed.
# lmx_arena_drop detaches a block WITHOUT freeing its payload (that is the block module's
# contract: disposal is dispose_all's act), so the sweep disposes it here -- a collection that
# detached without freeing would be a leak wearing the name of a collection.

fn: lmx_gc_mark (@: LmxArena arena; @: LmxThread t) unsigned
    @: LmxMsg message
    @: LmxThread child
    @: size_t inbox_values
    size_t: inbox_count
    size_t: inbox_index
    size_t: child_index
    unsigned: gen
    int: status
    int: inbox_status
    if: arena = 0 || t = 0
        return: 0U
    gen: lmx_arena_generation_next(arena)
    if: gen = 0U
        return: 0U
    ---
    # The Message's own cells.  A cell that is not in this arena (a runtime may keep its own
    # records in its frame) marks nothing and is not an error.
    status: c.LMX_GC_OK
    message: lmx_thread_message(t)
    status: lmx_gc_note(status, lmx_gc_mark_value(arena, (cast: (@: void) t), gen, 0))
    status: lmx_gc_note(status, lmx_gc_mark_value(arena, (cast: (@: void) message), gen, 0))
    status: lmx_gc_note(status, lmx_gc_mark_value(arena, (cast: (@: void) t\mail), gen, 0))
    status: lmx_gc_note(status, lmx_gc_mark_value(arena, (cast: (@: void) t\slot), gen, 0))
    # The Thread record may live outside this arena. Its sole membership List
    # is still an explicit runtime root; source code contains no hidden field.
    status: lmx_gc_note(status, lmx_gc_mark_value(arena, t\children, gen, 0))
    if: message != 0
        # The live graph: the one root a turn's work is all about.
        status: lmx_gc_note(status, lmx_gc_mark_value(arena, (cast: (@: void) message\graph), gen, 0))
    ---
    if: t\mail != 0
        # The mailbox's queue nodes are cells of one of this arena's arrays.  The queued targets
        # follow from the nodes themselves (target and next are pointer words of the kernel's
        # own domain), so a letter waiting for its receiver stays.  The OUTBOX and STAGED lanes
        # are the lanes that still hold nodes.
        status: lmx_gc_note(status, lmx_gc_mark_pool(arena, @ t\mail\nodes, gen))
        # The dynamic inbox backing is outside the arena and may move, so it is not an arena value.
        # lmx_post supplies a monitor-consistent snapshot; the collector never sees its backing or
        # acquires its monitor directly.
        inbox_values: 0
        inbox_count: 0U
        inbox_status: lmx_post_snapshot_inbox(t\mail, @ inbox_values, @ inbox_count)
        if: inbox_status != c.LMX_POST_OK
            status: lmx_gc_note(status, c.LMX_GC_INVALID)
        else:
            inbox_index: 0U
            while: inbox_index < inbox_count
                status: lmx_gc_note(status, lmx_gc_mark_value(arena, (cast: (@: void) inbox_values[inbox_index]), gen, 0))
                inbox_index: inbox_index + 1U
            ---
            free((cast: (@: void) inbox_values))
        ---
    ---
    # The one record-owned List is reachable through the explicit root above.
    # Walk its physical values as explicit roots too: a child arena is foreign to this arena, but
    # any parent-owned mechanism reached from the child value must not depend on a shadow chain.
    child_index: 0U
    while: child_index < lmx_thread_child_count(t)
        child: lmx_thread_child_at(t, child_index)
        status: lmx_gc_note(status, lmx_gc_mark_value(arena, (cast: (@: void) child), gen, 0))
        child_index: child_index + 1U
    ---
    if: status != c.LMX_GC_OK
        return: 0U
    ---
return: gen

fn: lmx_gc_collect (@: LmxArena arena; @: LmxThread t) int
    unsigned: gen
    if: arena = 0 || t = 0
        return: c.LMX_GC_INVALID
    # Letter-scale arenas skip the GC pass (simplified: no generation / sweep).
    if: arena\simple != 0U
        return: c.LMX_GC_OK
    ---
    # Sealed owner-arena pools are skipped per range. Imported sealed ranges are non-owning views
    # and never appear in arena\arrays, so neither mark nor sweep can adopt or free them.
    gen: lmx_gc_mark(arena, t)
    if: gen = 0U
        # The walk could not be completed: an object it never reached might be live, and a
        # partial sweep that reports success is worse than no sweep at all (model 24).
        return: c.LMX_GC_PARTIAL
    ---
    if: lmx_gc_sweep(arena, gen) != c.LMX_GC_OK
        return: c.LMX_GC_INVALID
    ---
return: c.LMX_GC_OK
