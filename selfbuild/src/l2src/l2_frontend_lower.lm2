        if: c.lm_compiler_nsty_get((cast: (int) (c.lm_compiler_mad_host_of(mi))), c.lm_compiler_formal_find(c.lm_compiler_mad_host_of(mi), t)) >= 0
            if: lm_compiler_mcap_add(mi, t, ty, (cast: (int) (c.lm_compiler_nsty_get((cast: (int) (c.lm_compiler_mad_host_of(mi))), c.lm_compiler_formal_find(c.lm_compiler_mad_host_of(mi), t))))) != 0
