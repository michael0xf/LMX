OldDifference:
    int: subtrahend
    int: minuend
    return: int
    calculate:
        return: minuend - subtrahend

Difference:
    int: minuend
    int: subtrahend
    return: int
    calculate:
        return: OldDifference\calculate(subtrahend; minuend)
    demo:
        int: adapted calculate(13; 5)
        int: direct OldDifference\calculate(13; 5)
        return: adapted * 10 + direct
