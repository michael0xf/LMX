# FIXED-BLOCKS-AUDIT: the words of a refusal name what they refuse in full.
# Two catches of one name of 300 bytes in one block (book §14): refused at
# the second, with the whole name in the words.  They were formatted into 160
# bytes without a bound: a name this long crashed the translator.
int: r 0
catch:  ()
    r: 1
catch:  ()
    r: 2
return: r
