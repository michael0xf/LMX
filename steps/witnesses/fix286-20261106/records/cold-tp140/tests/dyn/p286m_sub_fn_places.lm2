# Slice 286 probe: a sub written into a fn's place reads no result the call wants (the write's `implements`); a fn or a sub
# written into a sub's place takes that call (admitted), and the place is called as a statement.  Entry 7.
sub: s ()
    return
end: s
fn: u () int
    return: 9
end: u
Fns:
    fn: f () int
        return: 1
    end: f
end: Fns
Subs:
    sub: t ()
        return
    end: t
end: Subs
int: Hs 0
int: Hu 0
fn: sub_into_fn () int
    int: refused 0
    ---
        @: Fns\f Hs
        catch: implements ()
            refused: 1
    ---
    if: refused != 1
        return: 31
    return: Fns\f()
end: sub_into_fn
fn: into_sub () int
    int: refused 0
    ---
        @: Subs\t Hu
        catch: implements ()
            refused: 1
    ---
    if: refused != 0
        return: 32
    Subs\t()
    ---
        @: Subs\t Hs
        catch: implements ()
            refused: 2
    ---
    if: refused != 0
        return: 33
    Subs\t()
    return: 1
end: into_sub
fn: run () int
    @: Hs s s
    @: Hu u u
    int: a sub_into_fn()
    if: a != 1
        return: a
    return: into_sub()
end: run
int: code 7
int: got run()
if: got != 1
    code: got
---
sendMessage: exit(exit_code: code; stdout: ""; stderr: "")
return
