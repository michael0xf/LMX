predef: "l2src/tests/fnptr_local_forms.h.lm1"
fn: probe (const: @(c.L2TestAllocVTable av); size_t: n) @: void
    L2TestAllocFn: f av\alloc
    @: void a 0
    @: void b 0
    @: void c 0
    if: f = 0
        return: 0
    a: f(n)
    b: f: n
    c: f: (n)
    if: a != b
        return: 0
    if: b != c
        return: 0
    return: a
end: probe
sendMessage: exit(exit_code: 0; stdout: ""; stderr: "")
return
