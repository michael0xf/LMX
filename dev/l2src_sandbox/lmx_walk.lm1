# k.4 (author, next_core_tasks.md §3 item 8): dispatch is the word alone, non-null ->
# native, null -> walk; there is no separate "is this callable" question any more.
# Body moved to the ordinary machine module lmx_walk_values.lm2.

# lmx_walk.lm1 - one activation of the graph interpreter.  The contract, its sources and
# the limits of this slice are in lmx_walk.h.lm1.

# ---- construction of body nodes --------------------------------------------------------

# Plain nodes and the builder role vocabulary come from generated L2 values.

# Program roles supply the operation vocabulary while bodies are built. A copied
# body's typed OP records carry their own codes; dispatch does not compare their
# addresses with this table. Bind the vocabulary once per program for builders.
@: Lmx lmx_walk_program_roles_g 0
@@: Lmx lmx_walk_program_roots_g 0
size_t: lmx_walk_program_root_count_g 0U

fn: lmx_walk_program_bind (@: Lmx roles) void
    lmx_walk_program_roles_g: roles
    lmx_walk_program_roots_g: 0
    lmx_walk_program_root_count_g: 0U

fn: lmx_walk_program_roles () @: Lmx
return: lmx_walk_program_roles_g

fn: lmx_walk_program_qualify (@@: Lmx roots; size_t: count) void
    lmx_walk_program_roots_g: roots
    lmx_walk_program_root_count_g: count

# Nullary host transport: status return and an explicit activation-int output.
# Scratch remains activation-local; no installed hook or last-failure cell.
fn: lmx_walk_call0_dispatch (@: LmxArena arena; @: Lmx callable; @: int value) int
    LmxArena: sa
    LmxPool: cells
    LmxScratch: scratch
    LmxWalkContext: ctx
    LmxWalkValue: wv
    int: st
    if: arena = 0 || callable = 0 || value = 0
        return: c.LMX_CALL_NOT_CALLABLE
    \value: 0
    memset((cast: (@: void) (@ sa)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ cells)), 0, c.sizeof(c.LmxPool))
    memset((cast: (@: void) (@ scratch)), 0, c.sizeof(c.LmxScratch))
    memset((cast: (@: void) (@ ctx)), 0, c.sizeof(c.LmxWalkContext))
    memset((cast: (@: void) (@ wv)), 0, c.sizeof(c.LmxWalkValue))
    if: lmx_arena_open(@ sa) != 0
        return: c.LMX_CALL_NOT_CALLABLE
    if: lmx_scratch_open(@ scratch, @ sa, @ cells, 64U) != c.LMX_SCRATCH_OK
        lmx_arena_release(@ sa)
        return: c.LMX_CALL_NOT_CALLABLE
    ---
    ctx.arena: arena
    ctx.scratch: @ scratch
    ctx.immutable_roots: lmx_walk_program_roots_g
    ctx.immutable_root_count: lmx_walk_program_root_count_g
    st: lmx_walk_run(@ ctx, callable, 0, 0U, @ wv)
    lmx_scratch_close(@ scratch)
    lmx_arena_release(@ sa)
    if: st != c.LMX_WALK_OK
        # Errors abort; a throw is returned as the selected callee's ordinal.
        if: st >= c.LMX_WALK_THROWN
            st: lmx_walk_boundary_status(arena, 0, callable, st)
        return: lmx_call_note_walk_fail(st)
    ---
    if: wv.present = 0
        return: 0
    ---
    if: wv.kind = c.LMX_WALK_VALUE_NUMBER && wv.type = c.LMX_TYPE_INT
        \value: wv.number
    ---

return: 0

