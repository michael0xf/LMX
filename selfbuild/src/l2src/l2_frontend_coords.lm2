fn: lm_compiler_urm_find (const: (@: item c.LmP0Node)) int
    @: urm_n_cell int (cast: (@: int) (@ c.l2_urm_n))
    @@@: urm_at_cell c.LmP0Node (cast: (@@@: c.LmP0Node) (@ c.l2_urm_at))
    int: i 0
    while: i < urm_n_cell[0]
        if: urm_at_cell[0][i] = item
            return: (cast: (int) (i))
        i: i + 1
