fn: lm_compiler_declaration_initial_word (const: (@: declaration c.L2Declaration)) @: c.LmP0Text
    @: candidate c.LmP0Field
    @: requirement c.LmP0Field
    @: outer c.LmP0Frame
    @: inner c.LmP0Frame
    @: word c.LmP0Text
    int: depth
    int: qualified
    if: declaration = 0
        return: (cast: (@: c.LmP0Text) (0))
    if: declaration\candidate_count = 1
        candidate: c.lm_compiler_next_active(declaration\candidate)
        if: candidate != 0 && candidate\value != 0 && candidate\value\kind = c.LM_P0_NODE_ATOM && candidate\value\as != 0
            return: (cast: (@: c.LmP0Text) (candidate\value\as\atom))
        ---
        return: (cast: (@: c.LmP0Text) (0))
    if: declaration\candidate_count != 0
        return: (cast: (@: c.LmP0Text) (0))
    outer: c.lm_compiler_application(declaration\source)
    if: outer = 0
        return: (cast: (@: c.LmP0Text) (0))
    # A known Structure's one-name declaration has the same initial referent
    # as the general reference receiver.  The contract above already fixed
    # this source Frame's role, so no later name lookup can change it.
    if: declaration\contract != 0 && declaration\contract\kind = 2 && lm_compiler_ref_tail_atom(outer) != 0 && c.lm_compiler_text_same(c.lm_compiler_contract_leaf(declaration\contract, @ depth, @ qualified), outer\head) != 0
        return: (cast: (@: c.LmP0Text) (outer\head))
    if: c.lm_compiler_address_depth(outer\head) = 0
        return: (cast: (@: c.LmP0Text) (0))
    if: c.lm_compiler_count_active(outer\body) = 2
        candidate: c.lm_compiler_next_active(outer\body\first_field)
        if: candidate = 0
            return: (cast: (@: c.LmP0Text) (0))
        requirement: c.lm_compiler_next_active(candidate\next)
        word: c.lm_compiler_contract_leaf(declaration\contract, @ depth, @ qualified)
        if: depth = 1 && word != 0 && requirement != 0 && requirement\value != 0 && requirement\value\kind = c.LM_P0_NODE_ATOM && requirement\value\as != 0 && c.lm_compiler_text_same(word, requirement\value\as\atom) != 0
            return: (cast: (@: c.LmP0Text) (word))
        return: (cast: (@: c.LmP0Text) (0))
    if: c.lm_compiler_count_active(outer\body) != 1
        return: (cast: (@: c.LmP0Text) (0))
    candidate: c.lm_compiler_next_active(outer\body\first_field)
    if: candidate = 0 || candidate\value = 0
        return: (cast: (@: c.LmP0Text) (0))
    inner: c.lm_compiler_application(candidate\value)
    if: inner = 0 || inner\head = 0
        return: (cast: (@: c.LmP0Text) (0))
    word: c.lm_compiler_contract_leaf(declaration\contract, @ depth, @ qualified)
    if: depth != 1 || word = 0 || c.lm_compiler_text_same(word, inner\head) = 0
        return: (cast: (@: c.LmP0Text) (0))
    return: (cast: (@: c.LmP0Text) (word))
end: lm_compiler_declaration_initial_word

