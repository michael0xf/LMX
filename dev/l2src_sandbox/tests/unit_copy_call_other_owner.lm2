# A valid program: a method copies a unit-level Structure and calls its own
# copy. The copy's lexical parent is the method's occurrence, not the unit.
# OPEN positive: only a copy declared in the body that owns the copied
# Structure has a proved contract today. Entry 7.
A:
    int: last 0
    last: 17
fn: g () int
    x: merge A
    x
    return: x\last
int: k g()
int: result 81
if: k = 17 && A\last = 0
    result: 7
sendMessage: exit(exit_code: result; stdout: ""; stderr: "")
return
