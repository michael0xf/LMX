Log:
    int: made 2
    int: seen 7
    int: after 1
end: Log
Host:
    int: a 1
    return: int
    add:
        :=: (Log \ seen) a
        return: a
    end: add
end: Host
Pick:
    return: @
    Args:
        int: a 7
    end: Args
    PickCode:
        :=: (Log \ made) ((Log \ made) + 1)
        return: (Host \ add)
    end: PickCode
    PickArgs:
        :=: (Log \ made) ((Log \ made) + 1)
        return: (node \ Args)
    end: PickArgs
end: Pick
fn: main () int
    call: (:= args (Pick \ Args)) (:= code Pick\PickCode())
    call: (:= code (Host \ add)) (:= args Pick\PickArgs())
    return: 1
end: main
Main: (main) (:= (Log \ after) 1)
