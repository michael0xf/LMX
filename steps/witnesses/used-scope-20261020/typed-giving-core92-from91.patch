+        if: answer != c.LMX_IMPLEMENTS_YES
+            break
+        ---
+    ---
+    if: source_owned != 0 && normalized.map != 0
+        free((cast: (@: void) normalized.map))
+    if: answer != c.LMX_IMPLEMENTS_YES && owns != 0 && out\map != 0
+        free((cast: (@: void) out\map))
+        memset((cast: (@: void) out), 0, c.sizeof(c.LmxImplEntry))
+    ---
+return: answer
