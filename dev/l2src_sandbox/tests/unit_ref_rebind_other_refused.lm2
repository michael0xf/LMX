# A method's typed reference rebound to a Structure of another shape: `r: o` with o an Other (two ints) is not a Model
# (one size_t) -- the native admission before the binding refuses it, and the method's implicit throw `implements`,
# uncaught, stops R0.  It was a plain store.
Model:
    size_t: value 1U
end: Model
Other:
    int: a 1
    int: b 2
end: Other

fn: check () int
    o: merge Other
    @: Model r
    r: o
    return: 7
end: check

sendMessage: exit(exit_code: check(); stdout: ""; stderr: "")
return
