end: lm_p0_dump_append_cstr

# Original: parser.lm1:4555 lm_p0_dump_indent
sub: lm_p0_dump_indent (@: dump c.LmP0Dump; size_t: indent)
    size_t: i
    i: 0U
    while: (i < indent)
        lm_p0_dump_append_cstr(dump, "  ")
        i: i + 1U
    ---
end: lm_p0_dump_indent

# Original: parser.lm1:4564 lm_p0_dump_text
sub: lm_p0_dump_text (@: dump c.LmP0Dump; const: (@: text c.LmP0Text))
    lm_p0_dump_append_cstr(dump, "\"")
    if: (text != 0)
        lm_p0_dump_append(dump, (cast: (const: @: char) text\data), (cast: (size_t) text\length))
    ---
    lm_p0_dump_append_cstr(dump, "\"")
end: lm_p0_dump_text

