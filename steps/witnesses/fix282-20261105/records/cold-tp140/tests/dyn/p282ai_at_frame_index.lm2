# Slice 282 probe, a named limit: a run with a Frame in its index has no one text of a head, so `@:` keeps the refusal it had.
fn: first () int
    return: 0
end: first
Inner:
    int: q 2
end: Inner
[]: @(Inner) refs 2
@: refs[first()] Inner
sendMessage: exit(exit_code: 7; stdout: ""; stderr: "")
return
