            # update a separately loaded working value or substitute its cell.
            if: l2_pkind = 0 && l2_prhs_lit != 0 && c.fprintf(out_cell[0], "%sif: lmx_size_store_known(l2_pxp[0], %zuU) != 0\n", ind, l2_pv) < 0
                return: (cast: (int) (1))
            if: l2_pkind = 0 && l2_prhs_lit = 0 && c.fprintf(out_cell[0], "%sif: lmx_size_store_known(l2_pxp[0], %s) != 0\n", ind, tok_cell[0]\data) < 0
                return: (cast: (int) (1))
            if: l2_pkind = 1 && l2_prhs_lit != 0 && c.fprintf(out_cell[0], "%sif: lmx_char_store_known(l2_pxp[0], %d) != 0\n", ind, (cast: (int) l2_pv)) < 0
                return: (cast: (int) (1))
            if: l2_pkind = 1 && l2_prhs_lit = 0 && c.fprintf(out_cell[0], "%sif: lmx_char_store_known(l2_pxp[0], (cast: (int) %s)) != 0\n", ind, tok_cell[0]\data) < 0
                return: (cast: (int) (1))
            if: l2_pkind = 7 && l2_prhs_lit != 0 && c.fprintf(out_cell[0], "%sif: lmx_int_store_known(l2_pxp[0], %d) != 0\n", ind, (cast: (int) l2_pv)) < 0
                return: (cast: (int) (1))
            if: l2_pkind = 7 && l2_prhs_lit = 0 && c.fprintf(out_cell[0], "%sif: lmx_int_store_known(l2_pxp[0], %s) != 0\n", ind, tok_cell[0]\data) < 0
                return: (cast: (int) (1))
            if: l2_pkind = 8 && l2_prhs_lit != 0 && c.fprintf(out_cell[0], "%sif: lmx_unsigned_store_known(l2_pxp[0], %zuU) != 0\n", ind, l2_pv) < 0
                return: (cast: (int) (1))
            if: l2_pkind = 8 && l2_prhs_lit = 0 && c.fprintf(out_cell[0], "%sif: lmx_unsigned_store_known(l2_pxp[0], %s) != 0\n", ind, tok_cell[0]\data) < 0
                return: (cast: (int) (1))
            if: l2_pkind = 9 && l2_prhs_lit != 0 && c.fprintf(out_cell[0], "%sif: lmx_ulong_store_known(l2_pxp[0], %zuU) != 0\n", ind, l2_pv) < 0
                return: (cast: (int) (1))
            if: l2_pkind = 9 && l2_prhs_lit = 0 && c.fprintf(out_cell[0], "%sif: lmx_ulong_store_known(l2_pxp[0], %s) != 0\n", ind, tok_cell[0]\data) < 0
                return: (cast: (int) (1))
