Measurement:
    int: gain
    @: read
    return: int
    sample:
        return: read() * gain
    biased:
        return: read() * gain + 1
    reads_twice:
        int: discarded read()
        return: read() * gain

SamplingCheck:
    @: candidate
    int: calls 0
    return: int
    fixed_read:
        node\calls += 1
        return: 7
    check:
        node\calls := 0
        @: read fixed_read
        int: result candidate(gain := 4)
        return: result = 28 && node\calls = 1
