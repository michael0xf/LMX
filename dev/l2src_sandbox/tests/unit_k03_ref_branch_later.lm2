# K03 NS-ROLES-1 / NS-ROLES-VIS (the author, 2026-10-07; semantics #declaration-visibility): `b: A` binds b to an
# A visible where b stands; a qualified branch's root is visible from its place on only.
# A method above the branch: cfg is unknown there, so `b: cfg` defines b (with the free name cfg) and binds
# nothing -- b\e names no field of b: refused.
fn: go () int
    b: cfg
    if: b\e != 7U
        return: 81
    return: 7
end: go
independent:
    const:
        immutable:
            (): cfg
                size_t: e 7U
            end: cfg
        end: immutable
    end: const
end: independent
sendMessage: exit(exit_code: go(); stdout: ""; stderr: "")
return
