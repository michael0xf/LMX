            if: l2_check_qualified_existing(stmt, path) != 0
                return: 1
            return: l2_error(path, stmt, "unsupported body")
        if: lm_compiler_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0
            fr: stmt\as\frame
        if: lm_compiler_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && fr\trailer != 0
            return: l2_error(path, stmt, "unsupported trailer")
        if: lm_compiler_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && lm_compiler_frame_head(stmt, "return") = 0 && (fr\body = 0 || fr\body\trailer != 0)
            return: l2_error(path, stmt, "unsupported trailer")
        if: lm_compiler_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && lm_compiler_frame_head(stmt, "return") && fr\body != 0 && fr\body\trailer != 0
            return: l2_error(path, stmt, "unsupported trailer")
        # A `sub:`'s, and a named Structure's (its procedure's, §12): one refusal in any place of the body.
        if: lm_compiler_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && lm_compiler_frame_head(stmt, "return") && l2_m_ret[mi] = 8 && lm_compiler_count_active(fr\body) != 0
            return: l2_error(path, stmt, "return with a value in a callable that returns nothing")
        # FABLE-SONNET-DIAG-AND-INDEX-20260924-163 commit 1 (D-40): the same
        # "no result" refusal l2_check_value_call gives for a bare callable
        # atom, not the generic entry-signature text this branch used to
        # give for a call-shaped return whose callee is a sub.
        if: lm_compiler_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && lm_compiler_frame_head(stmt, "return") && lm_compiler_count_active(fr\body) = 1 && lm_compiler_next_active(fr\body\first_field)\value != 0 && lm_compiler_next_active(fr\body\first_field)\value\kind = c.LM_P0_NODE_FRAME && lm_compiler_find_method(lm_compiler_next_active(fr\body\first_field)\value\as\frame\head) >= 0 && l2_m_ret[lm_compiler_find_method(lm_compiler_next_active(fr\body\first_field)\value\as\frame\head)] = 8
            return: l2_error(path, stmt, "a callable without a result has no value")
        if: lm_compiler_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_head_is_call(fr\head, fr\body, fr\flags, mi) != 0 && l2_check_primary(stmt, mi, path) != 0
            return: 1
        if: lm_compiler_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && lm_compiler_frame_head(stmt, "return") = 0 && l2_head_is_call(fr\head, fr\body, fr\flags, mi) = 0 && l2_receiver_method_candidate(stmt, mi) = -1 && l2_check_fields(fr\body\first_field, lm_compiler_count_active(fr\body), mi, path, stmt) != 0
            return: 1
        if: lm_compiler_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && lm_compiler_frame_head(stmt, "return") && l2_check_return_literal(mi, fr\body, path, stmt) != 0
            return: 1
        if: lm_compiler_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && lm_compiler_frame_head(stmt, "return") && l2_check_ret_convert(mi, fr\body, path) != 0
            return: 1
        if: lm_compiler_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && lm_compiler_frame_head(stmt, "return") && l2_nsty_get(mi, 0 - 1) >= 0 && lm_compiler_count_active(fr\body) > 0
            if: l2_admit_return(mi, fr\body\first_field, lm_compiler_count_active(fr\body), path, stmt) != 0
                return: 1
            ---
        # The value of a `return:` is checked as any value is, a Structure result's too (the D-108 gate
        # for a return): a call in it records its edges and meets the static rule of §14.
        if: lm_compiler_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && lm_compiler_frame_head(stmt, "return") && lm_compiler_count_active(fr\body) != 0 && l2_head_is_call(fr\head, fr\body, fr\flags, mi) = 0 && l2_check_fields(fr\body\first_field, lm_compiler_count_active(fr\body), mi, path, stmt) != 0
            return: 1
        if: lm_compiler_frame_head(stmt, "return") != 0 && lm_compiler_count_active(fr\body) != 0 && l2_d105_note_return(mi, fr\body\first_field, lm_compiler_count_active(fr\body), stmt) != 0
            return: 1
        if: lm_compiler_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0
            field: lm_compiler_next_active(field\next)
return: 0

fn: l2_parse_unit (const: @(char path)) int
    int: i 0
    int: registered_methods
    int: registered_ns
    # Source declarations precede schema consumers. A merge can consume a
    # visible local definition exactly as it consumes a unit definition;
    # scanning its operands before collecting that source would hide it.
    if: l2_collect_asgn_binds(path) != 0
        return: 1
    # Finish all original local definitions before dynamic/signature/count
    # passes freeze method cardinality. Nested bodies are discovered by the
    # same exact-source collection, never by a lazy COUNT registration.
    registered_methods: -1
    registered_ns: -1
    while: registered_methods != l2_m_n || registered_ns != l2_ns_n
        registered_methods: l2_m_n
        registered_ns: l2_ns_n
        i: 0
        while: i < l2_ns_n
            if: l2_ns_local[i] >= 0 && l2_ns_original_body(i) != 0 && l2_local_ns_proc(i, path) != 0
                return: 1
            i: i + 1
        if: l2_collect_asgn_binds(path) != 0
            return: 1
    ---
    # Local original definitions are now registered. Re-run the same call
    # scan with complete source bindings before split-place preparation; the
    # early scan cannot classify a local body that did not yet exist.
    i: 0
    while: i < l2_m_n
        if: l2_m_body[i] != 0 && l2_m_body[i]\as != 0 && l2_m_body[i]\as\structure != 0
            l2_ns_exec_scan(l2_m_body[i]\as\structure\first_field, i)
        i: i + 1
    ---
    # Reference fields are source declarations too. Consumers of a local
    # definition's schema must see their resolved callable/model target,
    # not snapshot a still-unresolved row into the merge correspondence.
    l2_vis_on: 0
    if: l2_ns_resolve_refs(path, 0) != 0
        return: 1
    # Bind actuals only after every original callable body and reference is
    # registered. An earlier traversal could resolve a local scalar under
    # its parent's method or destructively bind the wrong callable's inputs.
    if: l2_bind_calls(path) != 0
        return: 1
    # Merge results get their schemas after all original definitions exist,
    # but still before any body checking or dynamic/signature sizing. Both
    # scans retain the ordinary source-site visibility rules.
    i: 0
    while: i < l2_m_n
        l2_vis_method(i)
        if: l2_m_body[i] != 0 && l2_m_body[i]\as != 0 && l2_merge_scan(l2_m_body[i]\as\structure, i) != 0
            return: 1
        i: i + 1
    l2_vis_on: 0
    if: l2_collect_asgn_binds(path) != 0
        return: 1
    # Resolve newly collected reference declarations before their consumers
    # are checked. Already resolved rows retain their established bindings.
    l2_vis_on: 0
    if: l2_ns_resolve_refs(path, 0) != 0
        return: 1
    i: 0
    if: l2_dyn_local(path) != 0
        return: 1
    l2_m_throws: (cast: (@: int) calloc((cast: (size_t) (l2_m_n + 1)), c.sizeof(c.int)))
    if: l2_m_throws = 0
        return: l2_error(path, 0, "out of memory")
    l2_d105_reset()
    i: 0
    while: i < l2_m_n
        l2_vis_method(i)
        if: l2_m_body[i] != 0 && l2_m_body[i]\as != 0
            l2_m_throws[i]: l2_body_throws(l2_m_body[i]\as\structure, i)
        if: l2_m_throws[i] = 0 && l2_trailer_throws(i) != 0
            l2_m_throws[i]: 1
        # S8.1: a provided descriptor's callee is the construction export, which returns its E's status; like a held
        # call's or a callable formal's contract, it is on the status channel (a conservative ABI).
        if: l2_m_throws[i] = 0 && l2_m_provider(i) != 0
            l2_m_throws[i]: 1
        i: i + 1
    ---
    # S8.2: a machine function (l2_m_machine) has no code graph, so no operator of it becomes another later, and its
    # operators keep C99's semantics (L2 sections 17, 21); a declared name is refused by its checks
    # (l2_machine_validate): it returns its value directly, as a C function does.
    i: 0
    while: i < l2_m_n
        if: l2_m_machine(i) != 0 && lm_compiler_throws_declared(i) = 0
            l2_m_throws[i]: 0
        i: i + 1
    ---
    if: l2_pap_prepare(path) != 0
        return: 1
    # v3 M2: every explicit call learns its actual body before CHECK fixes
    # call edges, hidden inputs, throws and frame sizes.
    if: l2_m2_close(path) != 0
        return: 1
    i: 0
    while: i < l2_m_n
        l2_vis_method(i)
        if: l2_m_body[i] != 0 && l2_m_body[i]\as != 0 && l2_ml_rebuild(l2_m_body[i]\as\structure, i, path) != 0
            return: 1
        l2_cur_mi: i
        # An entry with no statement is an empty program; nothing to check.
        if: l2_m_body[i] != 0 && l2_m_body[i]\as != 0 && (i != l2_e || l2_e_n != 0) && l2_check_body(l2_m_body[i]\as\structure, i, l2_method_src(i, path), 0) != 0
            return: 1
        if: l2_check_ret_tr(i, l2_method_src(i, path), l2_ret_tr(l2_callable_source_frame(i)), l2_callable_source_node(i)) != 0
            return: 1
        # A3 / item 738: the node method i's return builds admits the model's Structure captures (l2_mad_cap_emit); a
        # dynamic candidate among them makes i a site that can refuse an admission, as every such site (l2_admit_site).
        if: l2_mad_captures_dynamic(i) != 0 && l2_admit_site(i) != 0
            return: 1
        i: i + 1
    l2_cur_mi: 0 - 1
    l2_vis_on: 0
    if: l2_throws_close() != 0
        return: 1
    if: l2_dyn_close(path) != 0
        return: 1
    # steps/free-names.md M2/M3: the checks that waited for the dynamic inputs' types run now.
    if: l2_wait_run(path) != 0
        return: 1
    if: l2_split_close(path) != 0
        return: 1
    if: l2_copy_calls_verify(path) != 0
        return: 1
    if: l2_check_immutable_calls(path) != 0
        return: 1
    if: l2_collect_asgn_binds(path) != 0
        return: 1
    # The entry has no caller, so nothing can hand it a dynamic input: a name it
    # reads before anything above declares it is unresolved.
    if: l2_e >= 0 && l2_m_dyn[l2_e] != 0
        if: l2_dn(l2_e, 0) != 0
            c.fprintf(l1_stderr(), "l2trans detail: unresolved entry name=%.*s\n", (cast: (int) l2_dn(l2_e, 0)\length), l2_dn(l2_e, 0)\data)
        return: l2_error(path, l2_free_name_at(l2_e, 0, 0), "unresolved name")
    i: 0
    while: i < l2_m_n
        l2_m_sig[i]: l2_intern_mi(i)
        if: l2_m_sig[i] = 0U && l2_alloc_err = 2
            return: l2_error(path, l2_m_node[i], "size overflow")
        if: l2_m_sig[i] = 0U
            return: l2_error(path, l2_m_node[i], "out of memory")
        i: i + 1
    if: l2_m_n != 0 && l2_intern_prove(path, l2_m_node[0]) != 0
        return: 1
return: 0



# THE EXPRESSION TEXT (FIXED-BLOCKS-AUDIT; Codex 2026-10-06, OPUS-CODEX-20261005-01): one text the emitter builds,
# L2Tx -- `data` holding `len` bytes and a NUL in `cap` bytes, its owner's buffer while that suffices, then storage of
# the translation twice the room (l2_text_room, released by l2_release; a grown text's earlier storage stays until
# then, so no pointer into it dangles).  A text has no length but its own; a writer that formats into the text's
# room in place (l2_tok_tx) leaves the length to be taken from the NUL at the next write (len -1).  A reader takes
# `data` after the last write; no pointer into a text is held across a write to it.

# The length of t's text: after a writer on a fixed buffer, the bytes before its NUL.

# Room for `more` bytes after the text and its NUL: twice the room until it is enough, in storage of the
# translation, the text kept.  0, or 1 with l2_alloc_err said (2 when the size overflows).

# The n bytes at a after t's text.



# t's text replaced by the text at a (never t's own).

# t's text replaced by p1, p2, p3, p4 and p5 in order (0 for none; none of them t's own).

# t's text replaced by p0, the n bytes at a, and p1 (0 for none; none of them t's own).

# A text on its owner's buffer, opened (l2_tx_open): the text, or 0 when there is none to open.

# dest's text: `levels` indirections (`\`), the text at a, and the n bytes at b (a and b never dest's own).

# t's text is the name of temporary k (l2_tok_temp's spelling).
fn: l2_tx_temp (@: L2Tx t; int: k) int
    []: char nm 32
    if: c.snprintf(nm, 32U, "l2_t%d", k) < 0
        return: 1
return: lm_compiler_tx_set(t, nm)

# THE C NAME OF A SOURCE BINDING (the author, 2026-10-24, LMX_blog/2026-10-24.md; Codex
# CODEX-OPUS-C-NAMES-PLAN-20261024-A): the families of generated names whose index stands for a binding of the source --
# a method's formals and inputs (l2_p, with l2_pr and l2_fv derived from them), its own fields (l2_q, with its
# derived _from and _dirty, and l2_wv) and its slots (l2_s) -- keep their prefix and index, which alone make the name
# unique, and add `_` and the binding's name when it is an ordinary identifier of C's set (l2_ident_word); a derived
# name's tail comes after it: `l2_p0_0_var`, `l2_q0_log_from`. A binding of another spelling, an exact identifier, adds
# nothing: the decision is its source spelling's (none binds today, l2_bind_admit). The name is appended to t, of any
# length; only the index is formatted in a buffer, whose size two ints' digits bound. b < 0: one index. 0, or 1.
fn: l2_tx_cname (@: L2Tx t; const: @(char prefix); int: a; int: b; const: @(LmP0Text name); const: @(char tail)) int
    []: char num 48
    if: t = 0 || prefix = 0 || tail = 0
        return: 1
    if: b < 0 && c.snprintf(num, 48U, "%d", a) < 0
        return: 1
    if: b >= 0 && c.snprintf(num, 48U, "%d_%d", a, b) < 0
        return: 1
    if: lm_compiler_tx_cat(t, prefix) != 0 || lm_compiler_tx_cat(t, num) != 0
        return: 1
    if: lm_compiler_ident_word(name) != 0 && (lm_compiler_tx_cat(t, "_") != 0 || lm_compiler_tx_catn(t, name\data, name\length) != 0)
        return: 1
return: lm_compiler_tx_cat(t, tail)

# The C name of input fi of method mi (a formal, then a hidden input) in a family of prefix `prefix`.
fn: l2_tx_input_cname (@: L2Tx t; const: @(char prefix); int: mi; int: fi; const: @(char tail)) int
    const: @(LmP0Text name) 0
    if: mi >= 0 && mi < l2_m_n && fi >= 0 && fi < l2_m_arity[mi]
        name: lm_compiler_fn(mi, fi)
    if: mi >= 0 && mi < l2_m_n && fi >= l2_m_arity[mi] && fi < l2_m_arity[mi] + l2_m_dyn[mi]
        name: l2_dn(mi, fi - l2_m_arity[mi])
return: l2_tx_cname(t, prefix, mi, fi, name, tail)

# The C name of own field k in a family of prefix `prefix`.
fn: l2_tx_own_cname (@: L2Tx t; const: @(char prefix); int: k; const: @(char tail)) int
    const: @(LmP0Text name) 0
    if: k >= 0 && k < l2_own_n && l2_own_name != 0
        name: l2_own_name[k]
return: l2_tx_cname(t, prefix, k, -1, name, tail)

# The C name of slot j of method mi in a family of prefix `prefix`.
fn: l2_tx_slot_cname (@: L2Tx t; const: @(char prefix); int: mi; int: j; const: @(char tail)) int
    const: @(LmP0Text name) 0
    size_t: off l2_slot_off(mi, j)
    if: off != (cast: (size_t) -1) && l2_sn != 0
        name: l2_sn[off]
return: l2_tx_cname(t, prefix, mi, j, name, tail)

# An atom's text into t, as l2_tok_text writes it but of any length: a triple-quoted text as an L1 string (at
# most four bytes for each of its bytes, and its quotes).

# Declare temp t with the type of own storage code oty and load the value cell l2_xp[0] into it.
# One emission for every reader of a value cell; a type without one is refused here, by name.
fn: l2_emit_cell_load (int: oty; const: @(char ind); int: t; const: @(LmP0Node at)) int
    []: char pty 96
    if: ind = 0
        return: 1
    if: lm_compiler_own_store_helper(oty) = 0
        return: l2_error(l2_src, at, "type has no value cell to load from")
    # A number's cell is never empty where it is held: an empty one is a place a partial copy does not hold
    # (READ-FIELD-CLOSURE), and its read is refused, never read as nothing.
    if: (oty = 0 || oty = 1 || oty = 2 || oty = 3 || oty = 36) && (c.fprintf(l2_out, "%sif: l2_xp[0] = 0\n", ind) < 0 || lm_compiler_emit_invariant(ind, "a field reads an absent place") != 0)
        return: 1
    if: oty = 0 && c.fprintf(l2_out, "%sint: l2_t%d\n%sl2_t%d: lmx_int_value_known(l2_xp[0])\n", ind, t, ind, t) < 0
        return: 1
    if: oty = 1 && c.fprintf(l2_out, "%schar: l2_t%d\n%sl2_t%d: (cast: (char) lmx_char_value_known(l2_xp[0]))\n", ind, t, ind, t) < 0
        return: 1
    if: oty = 2 && c.fprintf(l2_out, "%ssize_t: l2_t%d\n%sl2_t%d: lmx_size_value_known(l2_xp[0])\n", ind, t, ind, t) < 0
        return: 1
    if: oty = 3 && c.fprintf(l2_out, "%sunsigned: l2_t%d\n%sl2_t%d: lmx_unsigned_value_known(l2_xp[0])\n", ind, t, ind, t) < 0
        return: 1
    if: oty = 36 && c.fprintf(l2_out, "%sulong: l2_t%d\n%sl2_t%d: lmx_ulong_value_known(l2_xp[0])\n", ind, t, ind, t) < 0
        return: 1
    if: lm_compiler_own_is_pointer(oty) != 0
        if: fputs(ind, l2_out) < 0 || l2_emit_own_pointer_type(l2_out, oty) != 0 || c.fprintf(l2_out, " l2_t%d\n%sl2_t%d: (cast: (", t, ind, t) < 0 || l2_emit_own_pointer_type(l2_out, oty) != 0 || lm_compiler_ptr_cell_type(lm_compiler_oc_ft(oty), pty) != 0 || c.fprintf(l2_out, ") lmx_pointer_value_promised(l2_program_arena, l2_xp[0], %s))\n", pty) < 0
            return: 1
    ---
return: 0

fn: l2_hidden_from (int: mi; int: callee; int: k; int: callee_self; const: @(char ind); @: L2Tx dest; const: @(LmP0Node at)) int
return: l2_hidden_from_context(mi, callee, k, callee_self, ind, dest, at, 0)

fn: l2_hidden_from_context (int: mi; int: callee; int: k; int: callee_self; const: @(char ind); @: L2Tx dest; const: @(LmP0Node at); @: int context) int
    @: LmP0Text nm
    int: ty
    int: pi
    int: oi
    int: fi
    int: ni
    []: char ref 64
    if: context != 0
        context[0]: -1
    if: dest = 0 || callee < 0 || k < 0 || k >= l2_m_dyn[callee] || lm_compiler_tx_clear(dest) != 0
        return: 1
    nm: l2_dn(callee, k)
    ty: l2_dt(callee, k)
    # A3 with item 738: a Structure capture, from its host -- the Structure the host's name holds.
    if: l2_mad_host_of(callee) = mi && lm_compiler_schema_kind(l2_cap_arg_ns(callee, l2_m_arity[callee] + k)) != 0
        return: l2_cap_host_src_context(mi, nm, ind, dest, context)
    pi: -1
    pi: l2_param_find(mi, nm)
    # K04 S2: an input this caller only forwards is its entry of refs, not a value (l2_hidden_forward), until a
    # field of that name declared in scope has bound it.
    if: pi >= l2_m_arity[mi] && l2_dyn_fwd(mi, pi - l2_m_arity[mi]) != 0 && l2_formal_row(mi, pi) < 0
        return: l2_hidden_forward_context(mi, pi, callee, k, callee_self, ind, dest, at, context)
    if: pi >= 0
        return: l2_tok_formal_context(mi, pi, ind, dest, context)
    oi: -1
    oi: l2_own_visible(mi, nm)
    fi: -1
    if: oi >= 0 && l2_m_uses[l2_own_off(mi, oi)] != 0
        fi: l2_m_alias[l2_own_off(mi, oi)]
    if: fi >= 0
        return: l2_tok_formal_context(mi, fi, ind, dest, context)
    if: oi >= 0 && l2_m_uses[l2_own_off(mi, oi)] != 0 && l2_own_load_context(oi, mi, ind, dest, context) != 0
        return: 1
    if: oi >= 0 && l2_m_uses[l2_own_off(mi, oi)] != 0
        return: 0
    # No caller binding: use the declaration in the selected callee's lexical
    # node.  This is deliberately after declared and inherited caller inputs,
    # and uses the captured occurrence rather than the translator-global unit.
    # Only the callee's eligible parent declaration supplies this fallback.
    # A future declaration in the callee body is not a visible source, and
    # the caller's position does not replace the callee's lexical context.
    ni: l2_ns_find(nm)
    if: ty = lm_compiler_graph_dt() && ni >= 0 && l2_ns_parent[ni] < 0 && callee_self >= 0
        if: c.snprintf(ref, 64U, "lmx_arena_ref_struct(l2_c%d\\parent, %uU)", callee_self, (cast: (unsigned) (l2_ns_unit_slot(ni)))) < 0
            return: 1
        return: lm_compiler_tx_set(dest, ref)
    # K04 S2: the caller has no binding of the name.  A callee that only forwards the input, or resolves it
    # itself, takes it absent; the lexical source read is then the reader's own.
    if: l2_hid_takes_absent(callee, k) != 0
        return: lm_compiler_tx_set(dest, "ABSENT")
return: l2_hidden_lex(mi, callee, k, callee_self, ind, dest, at)

# The callee's lexical cell of its number input k, read here in the caller: where the callee cannot take the
# input absent.
fn: l2_hidden_lex (int: mi; int: callee; int: k; int: callee_self; const: @(char ind); @: L2Tx dest; const: @(LmP0Node at)) int
    @: LmP0Text nm
    int: ty
    int: child
    int: t
    int: h
    []: char cur 64
    []: char cell 96
    []: char msg_own 128
    L2Tx: msg_tx
    @: L2Tx l2_hf_msg lm_compiler_tx_local(@ msg_tx, msg_own, 128U)
    if: mi < 0 || dest = 0 || callee < 0 || k < 0 || k >= l2_m_dyn[callee] || l2_hf_msg = 0 || lm_compiler_tx_clear(dest) != 0
        return: 1
    nm: l2_dn(callee, k)
    ty: l2_dt(callee, k)
    child: l2_own_lexical(callee, nm)
    if: child < 0
        return: l2_error_name(l2_src, at, "unbound dynamic input ", nm\data, nm\length, "")
    if: l2_graph_field_child(child) < 0 || l2_call_node = 0
        return: 1
    if: l2_own_from_expr(child, l2_hf_msg) != 0
        return: 1
    # The cell is reached in the lexical tree of the SELECTED occurrence (Codex, FABLE-CODEX-20261004-12): a
    # field of the unit through the parent of a unit method's occurrence, as the Structure above is.
    if: callee_self >= 0 && l2_m_unit_level(callee) != 0 && l2_own_mi[child] = l2_e && l2_graph_field(child) != 0 && l2_graph_field(child)\holder = 0
        if: c.snprintf(cell, 96U, "lmx_arena_ref_cell(l2_c%d\\parent, %zuU)", callee_self, l2_graph_field(child)\child) < 0 || lm_compiler_tx_set(l2_hf_msg, cell) != 0
            return: 1
    ---
    # A field held in a nested body of another occurrence has no alias in this activation: a method's aliases
    # are of its own places (l2_emit_graph_places).  Its holder is reached edge by edge from the occurrence that
    # owns it -- the unit through the selected occurrence's parent, as above, or as this method reaches that
    # owner (l2_own_ctr).
    if: l2_own_mi[child] != mi && l2_graph_field(child) != 0 && l2_graph_field(child)\holder != 0
        h: l2_tn
        l2_tn: l2_tn + 1
        if: c.sprintf(cur, "l2_lexh%d", h) < 0
            return: 1
        if: callee_self >= 0 && l2_m_unit_level(callee) != 0 && l2_own_mi[child] = l2_e
            if: c.fprintf(l2_out, "%s@: Lmx %s l2_c%d\\parent\n", ind, cur, callee_self) < 0
                return: 1
            ---
        else:
            if: c.fprintf(l2_out, "%s@: Lmx %s %s\n", ind, cur, l2_own_ctr(child)) < 0
                return: 1
            ---
        ---
        if: lm_compiler_emit_graph_holder(l2_graph_field(child)\holder, cur, ind) != 0 || c.snprintf(cell, 96U, "lmx_arena_ref_cell(%s, %zuU)", cur, l2_graph_field(child)\child) < 0 || lm_compiler_tx_set(l2_hf_msg, cell) != 0
            return: 1
    ---
    if: c.fprintf(l2_out, "%sl2_xp: %s\n%sif: l2_xp = 0\n", ind, l2_hf_msg\data, ind) < 0
        return: 1
    # A missing cell of a bound hidden input is a broken promise (D-87, as D-05 for a loaded own
    # field): X1, not a return of 0 that the caller would read as the callee's value.
    if: lm_compiler_emit_invariant(ind, "a dynamic input has no cell to read") != 0
        return: 1
    t: l2_tn
    l2_tn: l2_tn + 1
    if: l2_own_is_slot(child) != 0 && l2_emit_own_cell_load(child, ind, t, 0) != 0
        return: 1
    if: l2_own_is_slot(child) = 0 && l2_emit_cell_load(lm_compiler_own_of_dt(ty), ind, t, 0) != 0
        return: 1
return: l2_tx_temp(dest, t)

# The caller mi only forwards its input pi, a number, and the callee's input k takes that name.  Where the
# callee takes the input absent the entry goes on as it is.  Where it cannot, the entry goes on when present,
# and when absent the callee's lexical cell is read here into storage of the caller's activation.
fn: l2_hidden_forward (int: mi; int: pi; int: callee; int: k; int: callee_self; const: @(char ind); @: L2Tx dest; const: @(LmP0Node at)) int
return: l2_hidden_forward_context(mi, pi, callee, k, callee_self, ind, dest, at, 0)

fn: l2_hidden_forward_context (int: mi; int: pi; int: callee; int: k; int: callee_self; const: @(char ind); @: L2Tx dest; const: @(LmP0Node at); @: int context) int
    int: t
    int: pair
    @: char deep 0
    []: char lex_own 256
    L2Tx: lex_tx
    @: L2Tx lex lm_compiler_tx_local(@ lex_tx, lex_own, 256U)
    []: char decl_own 256
    L2Tx: decl_tx
    @: L2Tx decl lm_compiler_tx_local(@ decl_tx, decl_own, 256U)
    []: char name 64
    []: char cpr_name_own 64
    L2Tx: cpr_name_tx
    @: L2Tx cpr_name lm_compiler_tx_local(@ cpr_name_tx, cpr_name_own, 64U)
    if: lex = 0 || decl = 0 || l2_tx_input_cname(cpr_name, "l2_pr", mi, pi, "") != 0
        return: 1
    if: context != 0
        context[0]: -1
        # This source is forward-only and has no bound mutable formal row.
        # Its unchanged entry storage and explicit input record are the source;
        # a raw lexical fallback below does not acquire that source's pair.
        if: lm_compiler_pointer_depth(lm_compiler_formal_raw(l2_input_ft(mi, pi))) > 0
            pair: l2_tn
            l2_tn: l2_tn + 1
            if: c.fprintf(l2_out, "%sLmxWalkValue: l2_cv%d\n%slmx_walk_value_clear(@ l2_cv%d)\n%sif: l2_input_values != 0 && %s != 0 && l2_input_values[%d].present != 0\n%s    lmx_value_context_copy(@ l2_cv%d, l2_input_values + %d)\n%s---\n", ind, pair, ind, pair, ind, cpr_name\data, pi, ind, pair, pi, ind) < 0
                return: 1
            context[0]: pair
        ---
    ---
    if: l2_hid_takes_absent(callee, k) != 0
        return: lm_compiler_tx_join(dest, "REF:", cpr_name\data, 0, 0, 0)
    # A callee whose name has no lexical declaration has nothing to stand behind the entry: it is required of
    # the callers (l2_dyn_site refuses a chain no one supplies), and the entry goes on as it is.
    if: l2_own_lexical(callee, l2_dn(callee, k)) < 0
        return: lm_compiler_tx_join(dest, "REF:", cpr_name\data, 0, 0, 0)
    t: l2_tn
    l2_tn: l2_tn + 1
    if: l2_bump_ind(ind, @ deep) != 0
        return: 1
    if: c.snprintf(name, 64U, "l2_hfb%d", t) < 0 || lm_compiler_value_decl_text(l2_input_ft(callee, l2_m_arity[callee] + k), 0, name, decl) != 0
        return: 1
    if: c.fprintf(l2_out, "%s%s\n%s@: void l2_hfr%d %s\n%sif: l2_hfr%d = 0\n", ind, decl\data, ind, t, cpr_name\data, ind, t) < 0
        return: 1
    if: l2_hidden_lex(mi, callee, k, callee_self, deep, lex, at) != 0
        return: 1
    if: c.fprintf(l2_out, "%sl2_hfb%d: %s\n%sl2_hfr%d: (cast: (@: void) (@ l2_hfb%d))\n%s---\n", deep, t, lex\data, deep, t, t, ind) < 0
        return: 1
    if: c.snprintf(name, 64U, "REF:l2_hfr%d", t) < 0
        return: 1
return: lm_compiler_tx_set(dest, name)

# Formal (or dynamic input) fi of mi as its code reads it here: its bound field's cell once bound
# (l2_formal_row, -189 c3b-2), the machine argument before.
fn: l2_tok_formal (int: mi; int: fi; @: L2Tx dest) int
return: l2_tok_formal_context(mi, fi, 0, dest, 0)

fn: l2_tok_formal_context (int: mi; int: fi; const: @(char ind); @: L2Tx dest; @: int context) int
    int: k l2_formal_row(mi, fi)
    if: context != 0
        \context: -1
    if: dest = 0
        return: 1
    if: k >= 0
        return: l2_own_load_context(k, mi, ind, dest, context)
return: l2_tok_input_context(mi, fi, ind, dest, context)

# A resolved fi is already an input,not an invitation to search again for a
# newly same-named own row. Its current activation record is selected by fi.
fn: l2_tok_input_context (int: mi; int: fi; const: @(char ind); @: L2Tx dest; @: int context) int
return: l2_tok_input_type_context(mi, fi, l2_input_ft(mi, fi), ind, dest, context)

# The common root record supplies ft;this producer does not re-read the
# declaration table while projecting a held physical pointer Value.
fn: l2_tok_input_type_context (int: mi; int: fi; int: ft; const: @(char ind); @: L2Tx dest; @: int context) int
    []: char nm 48
    int: t
    []: char declaration_own 1024
    L2Tx: declaration_tx
    @: L2Tx declaration lm_compiler_tx_local(@ declaration_tx, declaration_own, 1024U)
    []: char fv_own 64
    L2Tx: fv_tx
    @: L2Tx fv lm_compiler_tx_local(@ fv_tx, fv_own, 64U)
    if: context != 0
        context[0]: -1
    if: dest = 0 || fv = 0
        return: 1
    if: lm_compiler_tx_clear(dest) != 0 || l2_tx_input_cname(dest, "l2_p", mi, fi, "") != 0
        return: 1
    if: context != 0 && lm_compiler_pointer_depth(lm_compiler_formal_raw(ft)) > 0 && l2_m_machine(mi) = 0
        t: l2_tn
        l2_tn: l2_tn + 1
        if: c.snprintf(nm, 48U, "l2_t%d", t) < 0 || l2_tx_input_cname(fv, "l2_fv", mi, fi, "") != 0 || lm_compiler_pointer_decl_text(lm_compiler_formal_raw(ft), 0, nm, declaration) != 0 || c.fprintf(l2_out, "%s%s %s\n%sLmxWalkValue: l2_cv%d\n%slmx_walk_value_clear(@ l2_cv%d)\n%slmx_value_context_copy(@ l2_cv%d, @ %s)\n", ind, declaration\data, dest\data, ind, t, ind, t, ind, t, fv\data) < 0
            return: 1
        context[0]: t
        return: l2_tx_temp(dest, t)
return: 0

# Input metadata belongs to this activation from entry onward. Never use the
# caller's immutable input snapshot as the mutable formal's later state.
fn: l2_emit_formal_contexts (int: mi) int
    int: k 0
    []: char fv_own 64
    L2Tx: fv_tx
    @: L2Tx fv lm_compiler_tx_local(@ fv_tx, fv_own, 64U)
    []: char pn_own 64
    L2Tx: pn_tx
    @: L2Tx pn lm_compiler_tx_local(@ pn_tx, pn_own, 64U)
    if: fv = 0 || pn = 0
        return: 1
    while: k < l2_m_arity[mi] + l2_m_dyn[mi]
        if: k >= l2_m_arity[mi] && l2_dyn_fwd(mi, k - l2_m_arity[mi]) != 0
            k: k + 1
            continue
        if: lm_compiler_pointer_depth(lm_compiler_formal_raw(l2_input_ft(mi, k))) > 0
            if: lm_compiler_tx_clear(fv) != 0 || l2_tx_input_cname(fv, "l2_fv", mi, k, "") != 0 || lm_compiler_tx_clear(pn) != 0 || l2_tx_input_cname(pn, "l2_p", mi, k, "") != 0
                return: 1
            if: c.fprintf(l2_out, "    LmxWalkValue: %s\n    lmx_walk_value_clear(@ %s)\n    if: l2_input_values != 0 && l2_input_values[%d].present != 0\n        if: l2_input_values[%d].kind != c.LMX_WALK_VALUE_REFERENCE || l2_input_values[%d].ref != (cast: (@: void) %s)\n            lmx_call_note_walk_fail(c.LMX_WALK_INVALID)\n        lmx_value_context_copy(@ %s, l2_input_values + %d)\n    ---\n", fv\data, fv\data, k, k, k, pn\data, fv\data, k) < 0
                return: 1
            ---
        ---
        k: k + 1
return: 0

fn: l2_formal_store_context (int: mi; int: fi; const: @(char ind); const: @(char value); int: context) int
    []: char nm_own 64
    L2Tx: nm_tx
    @: L2Tx nm lm_compiler_tx_local(@ nm_tx, nm_own, 64U)
    []: char cell_own 96
    L2Tx: cell_tx
    @: L2Tx cell lm_compiler_tx_local(@ cell_tx, cell_own, 96U)
    []: char owner_own 96
    L2Tx: owner_tx
    @: L2Tx owner lm_compiler_tx_local(@ owner_tx, owner_own, 96U)
    if: nm = 0 || cell = 0 || owner = 0 || l2_tx_input_cname(nm, "l2_p", mi, fi, "") != 0
        return: 1
    if: lm_compiler_pointer_depth(lm_compiler_formal_raw(l2_input_ft(mi, fi))) = 0 || l2_m_machine(mi) != 0
        return: (cast: (int) (c.fprintf(l2_out, "%s%s: %s\n", ind, nm\data, value) < 0))
    if: lm_compiler_tx_join(cell, "(@ ", nm\data, ")", 0, 0) != 0 || lm_compiler_tx_set(owner, "(@ ") != 0 || l2_tx_input_cname(owner, "l2_fv", mi, fi, ")") != 0
        return: 1
return: l2_emit_pointer_cell_store(l2_input_ft(mi, fi), ind, cell\data, owner\data, value, context)

fn: l2_tok_slot (int: mi; int: si; @: L2Tx dest) int
    if: dest = 0 || lm_compiler_tx_clear(dest) != 0
        return: 1
return: l2_tx_slot_cname(dest, "l2_s", mi, si, "")

# The logical value of a supported declared input, before machine ABI lowering.
# Signature descriptions do not create executable pointer-value bindings.
# Callable formals carry the whole occurrence; both structural signature
# spellings carry the same descriptor. Hidden inputs, however, are transported
# values: their witness is the exact closed pointer cell even when a source
# Structure supplies the value. Its Structure-to-reference projection is
# checked at the consuming boundary, and a present null keeps that cell type.
# The native ABI's pointer spelling does not determine a source expression's
# category. Array signature lowering remains separate work.
fn: l2_input_is_descriptor (int: mi; int: k) int
    if: mi < 0 || k < 0 || k >= l2_m_arity[mi] + l2_m_dyn[mi]
        return: 0
    # A hidden input is a transported value, not a signature description.
    # Its closed pointer type is needed even when the held address is null.
    if: k >= l2_m_arity[mi]
        return: 0
    if: l2_cf_get(mi, k) >= 0
        return: 1
return: (cast: (int) (l2_input_model(mi, k) >= 0))

# An Array value is its existing kernel descriptor, not its element backing.
# This projects the descriptor's actual C ABI through the ordinary type interner.


# Raw P0 entry:construct the ordinary operand once,then project its completed
# result. Prepared expression consumers call l2_address_span directly.
fn: l2_address_target (@: LmP0Field first; int: count; int: mi; @: L2Address out) int
    @: LmP0Field f lm_compiler_next_active(first)
    L2ValueSpan: span
    int: status
    if: f = 0 || f\value = 0 || f\value\as = 0
        return: 2
    if: count = 1 && f\value\kind = c.LM_P0_NODE_STRUCTURE && f\value\as\structure != 0
        return: l2_address_target(f\value\as\structure\first_field, lm_compiler_count_active(f\value\as\structure), mi, out)
    status: l2_value_span_prepare(first, count, @ span)
    if: status != count
        lm_compiler_value_span_release(@ span)
        return: 2
    status: l2_address_span(@ span, mi, out)
    lm_compiler_value_span_release(@ span)
return: status

fn: l2_address_span (@: L2ValueSpan span; int: mi; @: L2Address out) int
    @: L2Path path
    int: status
    @: LmP0Text symbol
    LmP0Text: cplace
    # The ordinary C door also names physical C storage. Keep that location
    # opaque: a C symbol is not an invented L2 local, int or void* cell. The
    # C compiler remains responsible for an undeclared/non-lvalue macro or
    # the actual external type; no header/name allowlist admits the symbol.
    if: out = 0
        return: 2
    if: span != 0 && span\values != 0 && span\node != 0 && span\node\kind = c.LM_P0_NODE_STRUCTURE
        if: span\value_n != 1
            return: 2
        return: l2_address_span(span\values, mi, out)
    if: span != 0 && span\count = 1 && span\node != 0 && span\node\kind = c.LM_P0_NODE_ATOM && span\node\as != 0
        symbol: span\node\as\atom
        if: lm_compiler_c_stmt_door(symbol) != 0
            cplace.data: symbol\data + 2U
            cplace.length: symbol\length - 2U
            if: lm_compiler_ident_word(@ cplace) = 0
                return: 1
            # A known callable is a value, not a reference-holding C object.
            if: l2_predef_has_function(@ cplace) != 0
                return: 1
            memset(out, 0, c.sizeof(c.L2Address))
            out\kind: 9
            out\index: -1
            out\type: -1
            out\model: -1
            out\target: span\first
            out\target_count: 1
            return: 0
    ---
    status: l2_address_target_record(span, mi, @ path)
    if: status = 3
        return: 3
    if: path = 0 || status = 1 || status = 4
        return: 2
return: l2_address_record(path, mi, out)

# The address representation and CHECK borrow one target selector. The
# original INDEX owners,not an address representation's copies,hold CHECK's
# completed child verdicts for subsequent native/retained projections.
fn: l2_address_target_record (@: L2ValueSpan span; int: mi; @@: L2Path out) int
    if: out = 0
        return: 2
    \out: 0
    if: span != 0 && span\values != 0 && span\node != 0 && span\node\kind = c.LM_P0_NODE_STRUCTURE
        if: span\value_n != 1
            return: 2
        return: l2_address_target_record(span\values, mi, out)
return: l2_value_span_path(span, mi, out)

# The sole address projector. Root coordinates,steps,types and maps are
# already selected;no branch below parses text or looks up a source name.
fn: l2_address_record (const: @(L2Path path); int: mi; @: L2Address out) int
    int: leaf
    int: model
    int: kind
    int: ft
    L2Address: raw
    @: L2TypeContract root_contract
    if: out = 0 || path = 0
        return: 2
    memset(out, 0, c.sizeof(c.L2Address))
    out\index: -1
    out\model: -1
    out\type: -1
    if: path\n = 0
        if: path\fail_why != 0
            return: 2
        return: l2_address_root(path, mi, out)
    if: lm_compiler_path_record_copy(path, @ out\path) != 0
        return: 3
    out\resolved: 1
    kind: (cast: (int) (path\fail_why != 0))
    # Opaque C is the selected root's representation,not an alternate
    # namespace lookup after a graph failure. Keep its original index spans.
    root_contract: path\root_level
    if: kind != 0 && path\n > path\indexed && (root_contract = 0 || root_contract\kind != 1) && lm_compiler_path_root_raw_c(path, mi) != 0
        out\kind: 6
        out\descriptor: 1
        out\target: path\source_first
        out\target_count: path\run_count
        return: 0
    if: path\indexed > 0 && (kind != 0 || lm_compiler_path_machine_index(path) != 0)
        kind: l2_raw_index_path(@ out\path, mi, @ raw)
        if: kind = 0
            raw.path.owned: out\path.owned
            out\path.owned: 0
        lm_compiler_path_release(@ out\path)
        out\resolved: 0
        if: kind != 0
            return: 2
        if: raw.type < 0
            lm_compiler_address_release(@ raw)
            return: 2
        raw.immutable: 0
        memcpy(out, @ raw, c.sizeof(c.L2Address))
        raw.resolved: 0
        out\target: path\source_first
        out\target_count: path\run_count
        return: 0
    if: kind != 0
        lm_compiler_address_release(out)
        return: 2
    kind: out\path.leaf_kind
    leaf: out\path.leaf_mi
    model: out\path.leaf_model
    out\immutable: out\path.in_eternal
    ft: lm_compiler_path_kind_ft(kind)
    if: kind = 10 || kind = 11
        ft: leaf
    if: kind = 13
        ft: lm_compiler_path_rec_leaf_ft(@ out\path)
    if: ft < 0
        lm_compiler_address_release(out)
        return: 2
    out\resolved: 1
    out\kind: 6
    out\index: kind
    out\descriptor: 0
    out\model: model
    out\type: l2_address_type(ft)
    out\target: path\source_first
    out\target_count: path\run_count
return: 0

# The record an address carries (kind 6: the target as one path, resolved once by l2_address_target) released; the
# scalars stay readable.  Every consumer that was answered 0 releases the address when it is done with it.

fn: l2_address_name (int: mi; const: @(LmP0Text name); @: L2Address out) int
    L2Path: path
    int: saved l2_cur_mi
    int: status
    if: name = 0 || lm_compiler_ident(name) = 0
        return: 1
    lm_compiler_path_init(name\data, name\length, @ path)
    path.run_count: 1
    path.names_run: 1
    l2_cur_mi: mi
    status: l2_path_root_resolve(@ path)
    if: status = 0
        status: l2_path_walk_selected(@ path)
    l2_cur_mi: saved
    if: status = 0
        status: l2_address_record(@ path, mi, out)
    lm_compiler_path_release(@ path)
return: (cast: (int) (status != 0))

# A zero-step address is a coordinate projection too. Its type/model come
# from the completed verdict,not from a second source-name/type selection.
fn: l2_address_root (const: @(L2Path path); int: mi; @: L2Address out) int
    int: own path\root_own
    int: i path\fi
    out\type: lm_compiler_path_rec_leaf_ft(path)
    out\model: path\leaf_model
    out\immutable: path\in_eternal
    if: own >= 0
        out\kind: 1
        out\index: own
        # N4 (plan A9, D12): the cell of a data place is the data's, not the code's; its address may write it.
        if: l2_split_data_row(own) != 0
            out\immutable: 0
            l2_split_written_add(own)
        out\descriptor: l2_own_is_slot(own)
        if: path\array_leaf != 0
            out\descriptor: 1
            out\model: -1
        ---
        if: l2_mres_addressed != 0 && l2_mres_of_own(own) >= 0
            l2_mres_addressed[l2_mres_of_own(own)]: 1
        if: l2_mres_of_own(own) < 0 && l2_own_addr_note(own) != 0
            return: 2
        ---
    else:
        if: i >= 0
            out\kind: 2
            out\index: i
            out\descriptor: l2_input_is_descriptor(mi, i)
        else:
            if: path\root_kind = 5
                out\kind: 3
                out\index: path\root
            else:
                if: path\root_kind = 4
                    out\kind: 4
                    out\index: path\root
                else:
                    if: path\ni >= 0
                        out\kind: 5
                        out\index: path\ni
                        out\descriptor: 1
                        out\model: path\ni
                        out\type: lm_compiler_graph_ft()
    ---
    if: out\kind = 0
        return: 2
    out\type: l2_address_type(out\type)
    # A known machine location can have an opaque C type which the old local
    # metadata does not retain. Keep its type unknown, never int or void*;
    # its address still uses that actual C location.
return: 0

# The two P0 representations of the same unary operation share the location
# resolver. 2 means a different expression; 1 means a bad name/location.
fn: l2_address_node (const: @(LmP0Node node); int: mi; @: L2Address out) int
    if: node = 0 || node\as = 0
        return: 2
    if: node\kind = c.LM_P0_NODE_STRUCTURE && node\as\structure != 0
        return: l2_address_operand(node\as\structure\first_field, lm_compiler_count_active(node\as\structure), mi, out)
    if: lm_compiler_frame_head(node, "@") = 0 || node\as\frame\body = 0
        return: 2
return: l2_address_target(node\as\frame\body\first_field, lm_compiler_count_active(node\as\frame\body), mi, out)

# No evaluation occurs while resolving this view. Every consumer receives the
# exact same source span and index, with the caller's remaining count as bound.


# An occurrence selector is written glued, `s\[N]name` (the book, L2 spec "paths"): the name's source span begins right
# after the `]`.  A name separated from the group -- `\[0], n`, the next actual of a C-door call, whose comma P0 drops --
# is no selector.  1 = `after` begins right after the one-byte atom `close`.

# Named field occurrences are no longer source paths.  Reject the old spelling
# before collecting declarations, in both a whole head (`s\[0]x`) and the P0
# atom sequence (`s`, `\`, `[`, `0`, `]`, `x`).  A bracket ending without a
# glued name remains an Array index, including `arr[i]\[j]`.

fn: l2_reject_named_selector_node (const: @(LmP0Node node); const: @(char path)) int
    const: @: LmP0Frame frame
    if: node = 0 || node\as = 0 || lm_compiler_ignored(node) != 0
        return: 0
    if: node\kind = c.LM_P0_NODE_ATOM
        if: lm_compiler_named_selector_in_text(node\as\atom) != 0
            return: l2_error(path, node, "named field occurrence selectors are removed")
        return: 0
    if: node\kind = c.LM_P0_NODE_STRUCTURE
        return: l2_reject_named_selector_body(node\as\structure, path)
    if: node\kind = c.LM_P0_NODE_FRAME
        frame: node\as\frame
        if: frame = 0
            return: 0
        if: lm_compiler_named_selector_in_text(frame\head) != 0
            return: l2_error(path, node, "named field occurrence selectors are removed")
        if: l2_reject_named_selector_body(frame\body, path) != 0
            return: 1
        if: frame\trailer != 0 && (frame\body = 0 || frame\trailer != frame\body\trailer)
            return: l2_reject_named_selector_body(frame\trailer\body, path)
        ---
    ---
return: 0

fn: l2_reject_named_selector_body (const: @(LmP0Structure body); const: @(char path)) int
    @: LmP0Field field
    @: LmP0Field close
    @: LmP0Field after
    L2ValueSpan: part
    int: group
    if: body = 0
        return: 0
    field: lm_compiler_next_active(body\first_field)
    while: field != 0
        if: field\value != 0 && field\value\as != 0 && field\value\kind = c.LM_P0_NODE_ATOM && lm_compiler_text_eq(field\value\as\atom, "[") != 0
            group: lm_compiler_field_index_group(field, c.INT_MAX, @ part, @ after)
            if: group != 0
                close: lm_compiler_skip_span((part.first), (part.count))
                if: after != 0 && after\value != 0 && after\value\as != 0 && after\value\kind = c.LM_P0_NODE_ATOM && lm_compiler_ident_word(after\value\as\atom) != 0 && lm_compiler_glued_after(close, after) != 0
                    return: l2_error(path, after\value, "named field occurrence selectors are removed")
                ---
            ---
        ---
        if: l2_reject_named_selector_node(field\value, path) != 0
            return: 1
        field: lm_compiler_next_active(field\next)
    ---
    if: body\trailer != 0
        return: l2_reject_named_selector_body(body\trailer\body, path)
return: 0

# Index k's span in the complete prepared sequence. Names and indices may
# alternate; do not infer the step's position from the name-prefix count.

# R5-3b: the located refusals of a place: 4 = an index step on a value that is no Array (`x[0]` on an int, a third
# index on a two-level Array), said at the index; 5 = a field step after an index step, said at the field -- the walk's
# own words where it refused the field (the element is no Structure, or has no such field), else R5-1's limit (the
# field resolves in an Array of Structure references; no backend reads an element's field yet, K07); 6 = an adjacent
# bracket group -- the flat rectangular index `a[i][j]` of one Array, whose construction is not built (Codex
# CODEX-ARRAY-GROUPS-20261011-184637): it never selects the inner Array; `a[i]\[j]` does.
fn: l2_place_refusal (const: @(char path); int: status; const: @(L2ArrayPlace place)) int
    if: status = 5 && place\path.fail_why != 0
        return: l2_path_seg_refusal_at(path, place\said, (place\path.fail_why))
    if: status = 5
        return: l2_error(path, place\said, "a field after an index needs an Array of Structure references")
    if: status = 6
        return: l2_error(path, place\said, "the flat index [i][j] addresses one rectangular Array, not built yet; [i]\\[j] indexes the selected Array")
return: l2_error(path, place\said, "an index needs an Array value")

# R5-3b: each index step of a place is a size_t value received as any size_t is (a literal, a size_t name, an
# expression; another number type is the conversion edge, "mixed numeric types").
fn: l2_check_place_steps (const: @(LmP0Node at); int: mi; const: @(char path); const: @(L2ArrayPlace place)) int
    if: place = 0 || place\steps != place\path.indexed
        return: l2_error(path, at, "internal: an Array place has inconsistent index geometry")
return: l2_check_resolved_indices(at, mi, path, @ place\path)

# Validate original index spans from the common completed record, for reads,
# stores and addresses alike. A machine pointer step keeps its already closed
# machine index contract; an Array step receives size_t by the ordinary rule.
# No path is parsed, rebound or shortened by this consumer.
fn: l2_check_resolved_indices (const: @(LmP0Node at); int: mi; const: @(char path); const: @(L2Path resolved)) int
    @: L2PathStep step
    @: LmP0Field pf
    int: pc
    int: k 0
    int: seen 0
    int: prefix
    if: resolved = 0 || resolved\n < 0 || resolved\n > resolved\cap || resolved\names < 0 || resolved\names > resolved\n || resolved\indexed < 0 || resolved\indexed > resolved\n - resolved\names || (resolved\n > 0 && resolved\steps = 0)
        return: l2_error(path, at, "internal: a prepared path has inconsistent index geometry")
    prefix: resolved\n
    while: k < resolved\n
        step: resolved\steps + k
        if: step\locus = 7
            if: seen = 0
                prefix: k
            seen: seen + 1
            pf: step\index.first
            pc: step\index.count
            if: pf = 0 || pc < 1
                return: l2_error(path, at, "internal: an index step of a place cannot be read")
            if: step\level != 0 && step\level\kind = 1
                if: l2_check_numeric_receive_span(@ step\index, 2, mi, path, at) != 0
                    return: 1
                ---
            else:
                if: l2_check_value_span(@ step\index, mi, path, at) != 0
                    return: 1
                ---
            ---
        ---
        k: k + 1
    ---
    if: seen != resolved\indexed || prefix != resolved\names
        return: l2_error(path, at, "internal: prepared path index counts differ from its steps")
return: 0

# P0 parses the original head bytes of a path head (`box\v: 5`,
# `row[i]: v`, `h\a[2]\[k]: v`, or names after an index).
# P0 and the common run adapter, not the last byte of the head, determine its shape. Cache topology only;
# each use resolves names/contracts afresh in its original source environment (l2_array_place). Deferred checks borrow
# this document until l2_application_free, never a temporary freed AST. A valid parsed head retains even the adapter's
# no-path verdict in path_status. 0 = no path expression (status 1), or a failure already said (status 2).
fn: l2_head_expression (const: @(LmP0Node stmt); @: int status) @: L2HeadExpression
    @: L2HeadExpression expression l2_head_expressions
    const: @: LmP0Diagnostic diagnostic
    @: LmP0Text head
    @: LmP0Node root
    @: L2Path probe
    int: shape
    \status: 1
    if: stmt = 0 || stmt\kind != c.LM_P0_NODE_FRAME || stmt\as = 0 || stmt\as\frame = 0
        return: 0
    head: stmt\as\frame\head
    if: head = 0 || head\data = 0 || head\length = 0U || (c.memchr(head\data, 91, head\length) = 0 && c.memchr(head\data, 92, head\length) = 0)
        return: 0
    while: expression != 0
        if: expression\source = stmt
            \status: 0
            return: expression
        expression: expression\allocated_next
    expression: (cast: (@: L2HeadExpression) lm_compiler_xmalloc(c.sizeof(c.L2HeadExpression)))
    if: expression = 0
        \status: 2
        l2_alloc_or(l2_src, stmt, "cannot allocate an indexed head")
        return: 0
    memset(expression, 0, c.sizeof(c.L2HeadExpression))
    probe: @ expression\prepared
    lm_compiler_path_init(0, 0U, probe)
    if: lm_p0_parse_bytes(head\data, head\length, @ expression\document) != 0
        \status: 2
        diagnostic: lm_p0_document_diagnostic(expression\document)
        if: diagnostic != 0
            if: diagnostic\code = 1
                l2_alloc_err: 1
            l2_alloc_or(l2_src, stmt, diagnostic\message)
        else:
            if: expression\document = 0
                l2_alloc_err: 1
            l2_alloc_or(l2_src, stmt, "cannot parse an indexed head")
        ---
        lm_compiler_head_expression_dispose(expression)
        return: 0
    root: lm_p0_document_mutable_root(expression\document)
    if: root = 0 || root\kind != c.LM_P0_NODE_STRUCTURE || root\as = 0 || root\as\structure = 0
        lm_compiler_head_expression_dispose(expression)
        return: 0
    expression\body: root\as\structure
    # Keep the adapter's entire prepared record. Later views resolve its steps,
    # never invoke the adapter again on the same head expression.
    shape: l2_path_steps_run(expression\body\first_field, lm_compiler_count_active(expression\body), probe)
    if: shape = 3
        lm_compiler_head_expression_dispose(expression)
        \status: 2
        l2_alloc_or(l2_src, stmt, "cannot allocate an indexed head")
        return: 0
    ---
    # Keep even a valid P0 expression that is not this path grammar. The
    # grammar verdict is retained, not a licence to try the parser again.
    expression\path_status: shape
    if: shape != 0 && lm_compiler_count_active(expression\body) > 0
        expression\values: l2_value_fields(expression\body\first_field, lm_compiler_count_active(expression\body), @ expression\value_n)
        if: expression\values = 0
            lm_compiler_head_expression_dispose(expression)
            \status: 2
            l2_alloc_or(l2_src, stmt, "cannot retain a non-path head's grammar")
            return: 0
        ---
    ---
    lm_compiler_head_rebase_node(root, stmt\span)
    expression\source: (cast: (@: LmP0Node) stmt)
    expression\allocated_next: l2_head_expressions
    l2_head_expressions: expression
    \status: 0
return: expression

# Compact heads already own their P0 and common grammar. This interface
# borrows that grammar and walks it in the CURRENT source context. Every
# result,including a grammar miss,is authoritative;no text parser follows.
# 2 not a complete path head;3 allocation failure;-1 semantic refusal;
# 0 one completed record for qualification,type,map and backend projection.
fn: l2_path_resolve_head (const: @(LmP0Node stmt); @: L2Path out) int
    int: status
    @: L2HeadExpression expression
    if: out = 0
        return: 2
    lm_compiler_path_init(0, 0U, out)
    expression: l2_head_expression(stmt, @ status)
    if: status = 2
        return: 3
    if: expression = 0
        return: 2
    if: expression\path_status != 0
        return: expression\path_status
    if: expression\prepared.run_count != lm_compiler_count_active(expression\body) && expression\prepared.flat = 0
        return: 2
    status: lm_compiler_path_prepared_view(@ expression\prepared, out)
    if: status != 0
        return: status
return: l2_path_walk(out)


# R5-3a: the formal type of an Array level's element description -- a numeric or pointer leaf as l2_contract_formal
# gives it; an Array description (`[]` over something, the next level) is the Array descriptor reference
# (l2_array_desc_ty): `a[i]` of an Array of Arrays is an Array value, stored and read as any reference.  0 = out_ty
# set, 1 = no type.
fn: l2_contract_element_ty (@: L2TypeContract element; @: int out_ty) int
    if: element = 0 || out_ty = 0
        return: 1
    if: element\kind = 1
        \out_ty: lm_compiler_array_desc_ty()
        return: (cast: (int) (\out_ty < 100))
return: l2_contract_formal(element, out_ty)

# Resolve one Array place written as a statement head (`a[i]: v`, `h\a[2]\[k]: v`), never a raw pointer or a new
# Array-rank construct: the head's parsed tree through the run adapter and the one walk, the place its view
# (l2_array_place_view).  1 is another head; 2 a resolved Array whose element contract the common value-contract
# producer does not support yet; 3 an already diagnosed failure; 4, 5, 6 the located refusals (l2_place_refusal).
# No physical slot is read here.
fn: l2_array_place (const: @(LmP0Node stmt); int: mi; @: L2ArrayPlace out) int
return: l2_index_head_place(stmt, mi, out, 0)

# One original head and one semantic resolution,then a representation view.
# 0 owns an Array result;7 owns a machine result in raw. Every other outcome
# releases the path. Legacy Array-only users pass no raw destination.
fn: l2_index_head_place (const: @(LmP0Node stmt); int: mi; @: L2ArrayPlace out; @: L2Address raw) int
    int: status
    int: count
    int: saved l2_cur_mi
    out\own: 0 - 1
    out\type: 0 - 1
    out\model: 0 - 1
    out\count: 0
    out\steps: 0
    out\said: 0
    out\expression: l2_head_expression(stmt, @ status)
    if: status = 2
        return: 3
    if: out\expression = 0
        return: 1
    if: out\expression\path_status != 0 || out\expression\prepared.indexed = 0
        return: 1
    count: lm_compiler_count_active(out\expression\body)
    l2_cur_mi: mi
    status: l2_path_resolve_head(stmt, @ out\path)
    l2_cur_mi: saved
    if: status = 3
        l2_alloc_or(l2_src, stmt, "cannot allocate a prepared head view")
        return: 3
    if: status = 2
        return: 1
    # The whole head is the place: a run that ends before the head does is no place (the flat form's group excepted).
    if: out\path.run_count != count && out\path.flat = 0
        lm_compiler_path_release(@ out\path)
        return: 1
    ---
return: l2_index_place_view(out, status, 0, mi, raw)

# Choose from the CURRENT common verdict. A machine place receives that
# complete record,not grammar for a second resolver invocation. The selected
# view takes ownership of run text before the temporary path is released.
fn: l2_index_place_view (@: L2ArrayPlace out; int: status; int: allow0; int: mi; @: L2Address raw) int
    @: L2Path path @ out\path
    int: projected
    if: raw != 0 && path\indexed > 0 && ((status = 0 && lm_compiler_path_machine_index(path) != 0) || (status != 0 && lm_compiler_path_root_raw_c(path, mi) != 0))
        projected: l2_raw_index_path(path, mi, raw)
        if: projected = 0
            raw\path.owned: path\owned
            path\owned: 0
            out\count: path\run_count
            out\steps: path\indexed
            out\type: raw\index
            out\model: raw\model
            lm_compiler_array_place_release(out)
            return: 7
        if: projected = 3
            lm_compiler_array_place_release(out)
            return: 3
    ---
return: l2_array_place_view(out, status, allow0)

# The Array-place VIEW of a resolved path (R5-3b): the record's name prefix is the base, its index steps the place's
# steps, its leaf the result.  Nothing is selected or typed here -- the walk did (the levels, the element, a field after
# an index); the view reads the record and says which of the place's outcomes it is.  0 = a place (`type`, `model`,
# `steps`, `count`, `own`, `base` set; released by the caller); every other outcome releases the record here: 1 = not
# an Array place (no index step and no Array value asked, a root or a field before the first index that resolves to
# nothing, an index on a value that is neither an Array nor a number -- a raw pointer keeps the machine index); 2 = the
# element has no supported value contract; 4 = an index on a value that is no Array (a number; any inner level), said
# at the index; 5 = a field step after an index step, said at the field; 6 = the flat `[i][j]` form on an Array base,
# said at its second group.
fn: l2_array_place_view (@: L2ArrayPlace out; int: status; int: allow0) int
    @: L2Path path @ out\path
    @: L2PathStep step 0
    @: L2PathStep first 0
    @: LmP0Field g
    int: at 0 - 1
    int: k
    int: ty 0
    out\base.data: (cast: (@: char) path\text)
    out\base.length: path\length
    out\count: path\run_count
    out\steps: path\indexed
    out\own: 0 - 1
    out\type: 0 - 1
    out\model: 0 - 1
    out\said: 0
    if: lm_compiler_path_machine_index(path) != 0
        lm_compiler_array_place_release(out)
        return: 1
    if: path\names = 0 && path\oi >= 0
        out\own: path\oi
    if: path\indexed > 0 && path\steps != 0
        first: path\steps + path\names
    if: status != 0
        step: lm_compiler_path_fail_step(path)
        if: step != 0
            at: path\fail_seg - 1
        ---
    ---
    # A field step after an index step, said at the field: the walk refused it there, or it resolved (R5-1's limit).
    if: step != 0 && first != 0 && at > path\names && step\locus != 7
        out\said: step\node
        lm_compiler_array_place_release(out)
        return: 5
    ---
    # The flat form: an adjacent group after an index step, on an Array base (the first index's level).
    if: path\flat != 0
        if: first = 0 || first\level = 0 || first\level\kind != 1
            lm_compiler_array_place_release(out)
            return: 1
        ---
        out\said: path\flat\value
        g: lm_compiler_next_active(path\flat\next)
        if: g != 0 && g\value != 0
            out\said: g\value
        lm_compiler_array_place_release(out)
        return: 6
    ---
    if: status != 0
        # An index on a value that is no Array: the first index on a number is refused; on anything else the run is not
        # a place (a raw pointer's machine index); an inner level that is no Array is refused at its index.
        if: path\fail_why = 5 && step != 0
            if: at > path\names || (step\level != 0 && step\level\kind != 1 && l2_contract_formal(step\level, @ ty) = 0 && lm_compiler_pointer_depth(ty) = 0 && lm_compiler_ty_number(ty) != 0)
                out\said: step\node
                lm_compiler_array_place_release(out)
                return: 4
            ---
        ---
        lm_compiler_array_place_release(out)
        if: path\fail_why = 6
            return: 2
        return: 1
    ---
    if: path\indexed = 0
        if: allow0 = 0 || path\array_leaf = 0
            lm_compiler_array_place_release(out)
            return: 1
        ---
        out\type: lm_compiler_array_desc_ty()
        out\model: 0 - 1
        return: 0
    ---
    out\type: lm_compiler_path_rec_leaf_ft(path)
    out\model: path\leaf_model
return: 0

# The very same place from an original expression span (R5-3b): the run adapter reads the names and the index groups
# (`[i]`, `[i]\[j]`, any number of steps), the one walk resolves them, l2_array_place_view says the outcome; with allow0
# a run with no group is the Array value itself (`length(h\a)`).  5 = a field step after an index, said at the field.
fn: l2_array_span (@: LmP0Field first; int: n; int: mi; @: L2ArrayPlace out) int
return: l2_array_span_mode(first, n, mi, out, 0)

# One Array place written as an operand run (`first` the root's field, `n` fields available): the run adapter reads the
# names and the groups; a run with no index step is no place unless the Array value itself is asked (allow0,
# `length(h\a)`) -- nothing is resolved for it, as before; else the one walk resolves it where `mi` stands and
# l2_array_place_view says which outcome it is.  3 = no memory, said.
fn: l2_array_span_mode (@: LmP0Field first; int: n; int: mi; @: L2ArrayPlace out; int: allow0) int
return: l2_index_run_place(first, n, mi, out, allow0, 0)

# Operand and head dispatch share the same completed-record chooser;the
# run adapter preserves each original index AST and all geometry together.
fn: l2_index_run_place (@: LmP0Field first; int: n; int: mi; @: L2ArrayPlace out; int: allow0; @: L2Address raw) int
    int: status
    int: saved l2_cur_mi
    @: LmP0Field root lm_compiler_next_active(first)
    out\own: 0 - 1
    out\type: 0 - 1
    out\model: 0 - 1
    out\expression: 0
    out\count: 0
    out\steps: 0
    out\said: 0
    lm_compiler_path_init(0, 0U, @ out\path)
    status: l2_path_steps_run(first, n, @ out\path)
    if: status = 2
        return: 1
    if: status = 3
        if: root != 0
            l2_alloc_or(l2_src, root\value, "cannot allocate an Array operand path")
        return: 3
    ---
    if: out\path.indexed = 0 && allow0 = 0
        lm_compiler_path_release(@ out\path)
        return: 1
    ---
    l2_cur_mi: mi
    status: l2_path_walk(@ out\path)
    l2_cur_mi: saved
return: l2_index_place_view(out, status, allow0, mi, raw)

# R5-3b: `length(P)` over a place whose value is an Array -- a path to an Array field with no index (its own
# descriptor), or the level any number of index steps selects (the place's type is the descriptor reference).
# 0 = it is (out filled, released by the caller); 1 = not this route's.
fn: l2_length_place (const: @(LmP0Node node); int: mi; @: L2ArrayPlace out) int
    int: n
    if: node = 0 || mi < 0 || out = 0 || lm_compiler_frame_head(node, "length") = 0 || node\as\frame\trailer != 0 || node\as\frame\body = 0 || node\as\frame\body\trailer != 0
        return: 1
    n: lm_compiler_count_active(node\as\frame\body)
    if: l2_array_span_mode(node\as\frame\body\first_field, n, mi, out, 1) != 0
        return: 1
    if: out\count != n || out\type != lm_compiler_array_desc_ty()
        lm_compiler_array_place_release(out)
        return: 1
return: 0

# The place's record (its steps and the text the run adapter joined) released.

fn: l2_check_array_place (const: @(LmP0Node stmt); int: mi; const: @(char path); const: @(L2ArrayPlace place)) int
    @: LmP0Frame frame stmt\as\frame
    @: LmP0Field first
    const: @: LmP0Node value_at stmt
    int: place_root 0 - 1
    if: frame\body = 0 || frame\trailer != 0 || frame\body\trailer != 0
        return: l2_error(path, stmt, "unsupported trailer")
    # The place's record says it: its root (in_eternal, oi) is the base's root.  The record's own is read into a
    # local first: a by-value member is no call argument in L1 (a sole parenthesized argument loses its parentheses,
    # and the call splits at the dot).
    place_root: place\path.oi
    if: place\path.in_eternal != 0
        return: l2_error(path, stmt, "an eternal branch field cannot be updated")
    if: (l2_own_qualified(place_root) & 4) != 0
        return: l2_error(path, stmt, "an immutable value cannot be written")
    if: l2_check_place_steps(stmt, mi, path, place) != 0
        return: 1
    if: l2_check_fields(frame\body\first_field, lm_compiler_count_active(frame\body), mi, path, stmt) != 0
        return: 1
    first: lm_compiler_next_active(frame\body\first_field)
    if: first != 0
        value_at: first\value
return: l2_check_receiving_value_at(value_at, frame\body\first_field, lm_compiler_count_active(frame\body), place\type, place\model, 0, mi, path, @ place\path)

# Receiving conversion over the same bounded span used by ordinary actuals.
# A receiving role closes over the same prepared value,not another source
# range. Transparent groups preserve literal context; a prefix/composite is
# an expression,not a newly guessed literal. Deferred C values keep their
# existing explicit machine role,never a fallback after a refused path.
fn: l2_numeric_receive_prepare (@: L2ValueSpan value; int: target; int: mi; const: @(char path); @: L2NumericReceive plan) int
    @: L2ValueSpan leaf value
    @: LmP0Node at
    int: exact -1
    int: neg
    int: uns
    int: ch
    int: compatible
    size_t: magnitude
    if: plan = 0 || value = 0 || value\grammar = 0 || value\node = 0
        return: l2_error_fatal(path, 0, "internal: a numeric receiver has no prepared value")
    memset(plan, 0, c.sizeof(c.L2NumericReceive))
    plan\value: value
    plan\target_ft: target
    plan\source_ft: -1
    plan\converter: -1
    if: target = 8 || lm_compiler_prim_code_name(target) = 0
        return: 2
    while: leaf\values != 0 && leaf\value_n = 1 && (leaf\grammar = 3 || leaf\node\kind = c.LM_P0_NODE_STRUCTURE)
        leaf: leaf\values
    ---
    at: leaf\node
    plan\kind: l2_value_span_type(value, mi, @ exact)
    plan\source_ft: exact
    if: exact = 8
        return: l2_error(path, at, "a callable without a result has no value")
    if: plan\kind = -5 || plan\kind = -15
        return: l2_error(path, at, "a reference where a number is asked")
    if: plan\kind = -6 || plan\kind = -16
        return: l2_error(path, at, "a text where a number is asked")
    if: plan\kind = -17
        return: l2_error(path, at, "a reference compared with a number other than 0")
    if: plan\kind = -3
        return: l2_error(path, at, "mixed numeric types (a conversion)")
    if: leaf\count = 1 && at != 0 && at\kind = c.LM_P0_NODE_ATOM && at\as != 0
        if: lm_compiler_rw_num_lit(at\as\atom, @ neg, @ magnitude, @ uns) != 0 || lm_compiler_rw_char_lit(at\as\atom, @ ch) != 0
            plan\literal: at
            plan\source_ft: -10
            return: 0
        ---
    ---
    if: plan\source_ft < 0 && plan\kind = -1
        plan\source_ft: 0
    if: plan\source_ft < 0 && plan\kind = -2
        plan\source_ft: 34
    if: plan\source_ft < 0 && lm_compiler_prim_code_name(plan\kind) != 0
        plan\source_ft: plan\kind
    if: plan\source_ft = -12
        return: 0
    if: plan\source_ft < 0
        return: l2_alloc_or(path, at, "assignment value has unknown type")
    # Numeric identity already has the exact selected primitive contract,
    # as at the ordinary conversion check. Do not reinterpret its type word
    # as a new source path or allocate a compatibility query for it.
    if: lm_compiler_formal_raw(target) = lm_compiler_formal_raw(plan\source_ft)
        return: 0
    compatible: l2_colon_types_compatible(target, plan\source_ft)
    if: compatible != 0 && lm_compiler_prim_code_name(plan\source_ft) != 0 && c.strcmp(lm_compiler_prim_code_name(target), lm_compiler_prim_code_name(plan\source_ft)) != 0 && l2_cv_used = 0
        compatible: l2_convert_hit(lm_compiler_prim_code_name(plan\source_ft), lm_compiler_prim_code_name(target))
        if: compatible != 0
            l2_cv_used: 1
        ---
    if: compatible = 0
        if: l2_alloc_err != 0
            return: l2_alloc_or(path, at, "out of memory")
        if: l2_cv_gap = 3
            return: l2_cv_refused(path, at, "internal: a conversion refused without its reason")
        if: l2_cv_gap = 5
            return: l2_error(path, at, "the program has no source table `primitive.convert`")
        if: l2_cv_gap = 2
            return: l2_convert_norecv(path, at)
        if: l2_cv_gap = 1
            return: l2_error(path, at, "mixed numeric types (a conversion)")
        return: l2_error(path, at, "assignment value has incompatible type")
    if: l2_cv_used != 0
        plan\converter: l2_convert_method()
        if: plan\converter < 0
            return: l2_error_fatal(path, at, "internal: a numeric conversion lost its selected receiver")
    ---
return: 0

fn: l2_check_numeric_receive_span (@: L2ValueSpan value; int: target; int: mi; const: @(char path); const: @(LmP0Node at)) int
    L2NumericReceive: plan
    int: status
    int: input
    int: source_type
    int: converter
    if: l2_check_value_span(value, mi, path, at) != 0
        return: 1
    status: l2_numeric_receive_prepare(value, target, mi, path, @ plan)
    if: status != 0
        return: status
    if: plan.literal != 0 && l2_check_literal_kind((plan.literal\as\atom), lm_compiler_lit_kind_from_ft(target), path, (plan.literal)) != 0
        return: 1
    converter: plan.converter
    source_type: plan.source_ft
    if: converter >= 0
        if: l2_m_arity[converter] != 1
            return: l2_error(path, at, "a numeric conversion receiver needs one declared input")
        input: lm_compiler_ft(converter, 0)
        if: lm_compiler_formal_raw(input) != lm_compiler_formal_raw(source_type)
            if: lm_compiler_foreign_value_ft(lm_compiler_formal_raw(input)) = 0
                if: lm_compiler_prim_code_name(input) = 0
                    return: l2_error(path, at, "a numeric conversion receiver's input does not receive a number")
                if: l2_check_numeric_receive_span(value, input, mi, path, at) != 0
                    return: 1
                ---
            ---
        ---
        return: l2_convert_edge_to(mi, converter, path, value\node)
return: 0

fn: l2_emit_numeric_receive (@: L2NumericReceive plan; int: mi; const: @(char ind); @: L2Tx dest) int
    int: self -1
    int: input
    []: char piece_own 1024
    L2Tx: piece_tx
    @: L2Tx piece lm_compiler_tx_local(@ piece_tx, piece_own, 1024U)
    if: plan = 0 || plan\value = 0 || piece = 0
        return: 1
    # The current callable value is read BEFORE any effects of the source.
    if: plan\converter >= 0 && l2_emit_convert_capture(plan\converter, ind, @ self) != 0
        return: 1
    if: plan\converter >= 0
        # An inserted conversion is an ordinary call. Admit its argument
        # to the receiver's actual formal through this SAME held value,
        # rather than narrowing it at the machine transport boundary.
        input: lm_compiler_ft(plan\converter, 0)
        if: lm_compiler_foreign_value_ft(lm_compiler_formal_raw(input)) != 0
            # An explicitly declared C ABI value is checked by its exact
            # typed call record,not by inventing a language numeric type.
            if: l2_emit_native_span(plan\value, mi, ind, piece, 0) != 0
                return: 1
            ---
        else:
            if: l2_emit_numeric_receive_span(plan\value, input, mi, ind, piece) != 0
                return: 1
            ---
        ---
        return: l2_emit_convert_apply(mi, plan\converter, self, piece\data, plan\value\node, ind, dest)
    if: l2_emit_native_span(plan\value, mi, ind, piece, 0) != 0
        return: 1
return: lm_compiler_tx_set(dest, piece\data)

fn: l2_emit_numeric_receive_span (@: L2ValueSpan value; int: target; int: mi; const: @(char ind); @: L2Tx dest) int
    L2NumericReceive: plan
    int: status l2_numeric_receive_prepare(value, target, mi, l2_src, @ plan)
    if: status != 0
        return: status
return: l2_emit_numeric_receive(@ plan, mi, ind, dest)

fn: l2_emit_received_span (@: LmP0Field first; int: n; int: ty; int: model; const: @(LmP0Node stmt); int: mi; const: @(char ind); @: L2Tx dest) int
    L2ValueSpan: value
    int: status
    if: ty != 8 && lm_compiler_prim_code_name(ty) != 0
        if: l2_value_expression_prepare(first, n, @ value) != 0
            return: l2_alloc_or(l2_src, stmt, "cannot prepare the received expression")
        status: l2_emit_numeric_receive_span(@ value, ty, mi, ind, dest)
        lm_compiler_value_span_release(@ value)
        return: status
return: l2_emit_reference_value(first, n, ty, model, mi, ind, dest)

# The physical Array selection is a kernel operation shared with ELEM and
# ELEMPUT. Native supplies only its already evaluated descriptor and index.
fn: l2_emit_array_cell (const: @(char descriptor); const: @(char index); int: mi; const: @(char ind); @: L2Tx place) int
    int: t l2_tn
    []: char name 96
    l2_tn: l2_tn + 1
    if: c.snprintf(name, 96U, "l2_array_place%d", t) < 0 || lm_compiler_tx_set(place, name) != 0
        return: 1
    if: c.fprintf(l2_out, "%sLmxWalkPlace: %s\n%sint: l2_array_status%d lmx_value_array_place(l2_program_arena, %s, %s, @ %s)\n%sif: l2_array_status%d = c.LMX_WALK_THROWN + c.LMX_WALK_NAME_INTERPRETER\n", ind, name, ind, t, descriptor, index, name, ind, t) < 0 || l2_emit_null_use(mi, ind) != 0
        return: 1
    if: c.fprintf(l2_out, "%s---\n%sif: l2_array_status%d != c.LMX_WALK_OK\n", ind, ind, t) < 0 || lm_compiler_emit_path_bail(mi, ind) != 0
        return: 1
return: (cast: (int) (c.fprintf(l2_out, "%s---\n", ind) < 0))

# A backend representation of the SAME ready place. The kernel owns the
# physical load;numeric widths and reference CURRENT context are not guessed
# from backing bytes or reconstructed by a second resolver.
fn: l2_emit_place_value (int: type; const: @(char place); const: @(char ind); @: L2Tx dest; @: int context) int
    int: t l2_tn
    LmP0Text: word
    int: depth
    int: qualified
    []: char declaration_own 1024
    []: char type_own 1024
    L2Tx: declaration_tx
    L2Tx: type_tx
    @: L2Tx declaration lm_compiler_tx_local(@ declaration_tx, declaration_own, 1024U)
    @: L2Tx type_text lm_compiler_tx_local(@ type_tx, type_own, 1024U)
    l2_tn: l2_tn + 1
    if: context != 0
        context[0]: -1
    if: l2_tx_temp(dest, t) != 0 || lm_compiler_value_decl_text(type, 0, dest\data, declaration) != 0
        return: 1
    if: c.fprintf(l2_out, "%sLmxWalkValue: l2_cv%d\n%sif: lmx_walk_place_load(l2_program_arena, @ %s, @ l2_cv%d) != c.LMX_WALK_OK\n%s    lmx_call_note_walk_fail(c.LMX_WALK_INVALID)\n%s---\n", ind, t, ind, place, t, ind, ind) < 0
        return: 1
    if: lm_compiler_pointer_depth(type) > 0
        if: lm_compiler_pointer_decl_text(type, 0, 0, type_text) != 0 || c.fprintf(l2_out, "%s%s (cast: (%s) (l2_cv%d.ref))\n", ind, declaration\data, type_text\data, t) < 0
            return: 1
        if: context != 0
            context[0]: t
        ---
    else:
        if: lm_compiler_type_parts(type, @ word, @ depth, @ qualified) != 0 || c.fprintf(l2_out, "%ssize_t: l2_array_number%d\n%sint: l2_array_type%d\n%sif: lmx_walk_value_number(@ l2_cv%d, @ l2_array_number%d, @ l2_array_type%d) != c.LMX_WALK_OK\n%s    lmx_call_note_walk_fail(c.LMX_WALK_INVALID)\n%s---\n%s%s (cast: (", ind, t, ind, t, ind, t, t, t, ind, ind, ind, declaration\data) < 0 || lm_compiler_write_text(l2_out, @ word) != 0 || c.fprintf(l2_out, ") l2_array_number%d)\n", t) < 0
            return: 1
        ---
    ---
return: 0

fn: l2_emit_array_place (const: @(LmP0Node stmt); int: mi; const: @(char ind); const: @(L2ArrayPlace place)) int
    []: char target_own 128
    []: char receiving_own 128
    []: char cell_own 256
    L2Tx: target_tx
    L2Tx: receiving_tx
    L2Tx: cell_tx
    @: L2Tx target lm_compiler_tx_local(@ target_tx, target_own, 128U)
    @: L2Tx receiving lm_compiler_tx_local(@ receiving_tx, receiving_own, 128U)
    @: L2Tx cell lm_compiler_tx_local(@ cell_tx, cell_own, 256U)
    int: kind
    int: context -1
    int: t l2_tn
    []: char current 64
    l2_tn: l2_tn + 1
    if: place\steps < 1 || l2_emit_path_cursor(@ place\path, mi, ind, stmt, @ kind, 1, receiving, 0, target) != 0
        return: 1
    # Preserve the common executable-write barrier on the SAME selected
    # physical cell. No lvalue reconstruction,second path search or RHS
    # evaluation may precede this check of its qualified storage domain.
    if: lm_compiler_tx_join(cell, "(", target\data, ".address)", 0, 0) != 0 || l2_emit_write_guard(mi, ind, cell\data) != 0
        return: 1
    if: lm_compiler_pointer_depth(place\type) > 0
        if: l2_emit_reference_value_at_context(stmt\as\frame\body\first_field, lm_compiler_count_active(stmt\as\frame\body), place\type, place\model, -1, mi, ind, l2_tok, -1, receiving\data, @ context) != 0 || c.sprintf(current, "0") < 0
            return: 1
        if: context >= 0 && c.sprintf(current, "(@ l2_cv%d)", context) < 0
            return: 1
        if: c.fprintf(l2_out, "%sLmxWalkValue: l2_array_giving%d\n%slmx_walk_value_ref_context(@ l2_array_giving%d, (%s.type), (cast: (@: void) (%s)), %s)\n", ind, t, ind, t, target\data, l2_tok\data, current) < 0
            return: 1
        ---
    else:
        if: l2_emit_received_span(stmt\as\frame\body\first_field, lm_compiler_count_active(stmt\as\frame\body), place\type, place\model, stmt, mi, ind, l2_tok) != 0 || c.fprintf(l2_out, "%sLmxWalkValue: l2_array_giving%d\n%slmx_walk_value_num(@ l2_array_giving%d, (%s.type), (cast: (size_t) (%s)))\n", ind, t, ind, t, target\data, l2_tok\data) < 0
            return: 1
        ---
    ---
return: (cast: (int) (c.fprintf(l2_out, "%sif: lmx_walk_value_store(l2_program_arena, @ %s, @ l2_array_giving%d) != c.LMX_WALK_OK\n%s    lmx_call_note_walk_fail(c.LMX_WALK_INVALID)\n%s---\n", ind, target\data, t, ind, ind) < 0))

# R5-3b: the place's descriptor (an own Array's or a binding's, l2_emit_array_desc; a field's cell through the path
# emitter), then each index step: the current level's backing cast by its element -- the descriptor reference above the
# last level (the resolver admitted it), the place's type at the last -- the step's index in a size_t temporary, the
# element `data[index]`; a selected level is the next step's descriptor, a null one the implicit `interpreter` throw
# (N1).  No step: the descriptor itself (an Array value).  The first step keeps the names l2_aiN_data / l2_aiN_index.
fn: l2_emit_array_place_operand (const: @(LmP0Node stmt); int: mi; const: @(char ind); const: @(L2ArrayPlace place); @: L2Tx dest) int
return: l2_emit_array_place_value(stmt, mi, ind, place, dest, 0)

fn: l2_emit_array_place_value (const: @(LmP0Node stmt); int: mi; const: @(char ind); const: @(L2ArrayPlace place); @: L2Tx dest; @: int context) int
    []: char name 96
    int: kind
    int: temp l2_tn
    l2_tn: l2_tn + 1
    if: place\steps = 0
        if: place\own >= 0
            return: l2_emit_array_desc(place\own, ind, dest)
        if: l2_emit_path_cursor(@ place\path, mi, ind, stmt, @ kind, 1, 0, 0, 0) != 0
            return: 1
        if: c.snprintf(name, 96U, "l2_array_value%d", temp) < 0 || c.fprintf(l2_out, "%s@: LmxArray %s (cast: (@: LmxArray) l2_pxp[0])\n", ind, name) < 0
            return: 1
        # Preserve the common constructed-field descriptor invariant at
        # whole-Array consumption too; this is not admission or projection.
        if: c.fprintf(l2_out, "%sif: %s = 0\n", ind, name) < 0 || lm_compiler_emit_path_bail(mi, ind) != 0
            return: 1
        return: lm_compiler_tx_set(dest, name)
    ---
return: l2_path_record_read_context(mi, @ place\path, ind, stmt, dest, context)

# R5-3b: the length of the Array a place selects: a selected level (one or more steps) is tested as any Array value
# used (N1: a null one is the implicit `interpreter` throw); a path's own descriptor was tested by the place emitter.
fn: l2_emit_place_length (const: @(LmP0Node node); int: mi; const: @(char ind); @: L2ArrayPlace place; @: L2Tx dest) int
    []: char elem_own 1024
    L2Tx: elem_tx
    @: L2Tx elem @ elem_tx
    int: t
    if: dest = 0 || lm_compiler_tx_open(elem, elem_own, 1024U) != 0 || l2_emit_array_place_operand(node, mi, ind, place, elem) != 0
        return: 1
    t: l2_tn
    l2_tn: l2_tn + 1
    if: place\steps = 0
        if: c.fprintf(l2_out, "%ssize_t: l2_t%d %s\\array.size\n", ind, t, elem\data) < 0
            return: 1
        return: l2_tx_temp(dest, t)
    if: c.fprintf(l2_out, "%s@: LmxArray l2_ad%d %s\n%sif: l2_ad%d = 0\n", ind, t, elem\data, ind, t) < 0
        return: 1
    if: l2_emit_null_use(mi, ind) != 0
        return: 1
    if: c.fprintf(l2_out, "%ssize_t: l2_t%d l2_ad%d\\array.size\n", ind, t, t) < 0
        return: 1
return: l2_tx_temp(dest, t)

fn: l2_rw_array_place (const: @(LmP0Node stmt); const: @(L2ArrayPlace place); int: into; @: int out) int
    int: child
    if: l2_rw_array_place_operand(stmt, place, "LMX_WALK_OP_ELEMPUT", 4, into, out) != 0
        return: 1
    if: l2_rw_reference_receive(stmt\as\frame\body\first_field, lm_compiler_count_active(stmt\as\frame\body), lm_compiler_own_ty_of_param(place\type), place\model, \out, @ child) != 0
        return: 1
return: l2_rw_put(\out, 3, child)

# R5-3b: the chain of element frames, one per index step -- the base value under the first, each frame the next one's
# Array operand, the last the caller's op (ELEM; ELEMPUT at a store) -- `ELEM(ELEM(AT(h, a), i), j)`; each step's index
# is its expression frame.  No step: the base value itself (`length(h\a)`).  Out of range, the walker's ELEM raises the
# implicit `interpreter` throw it already has.
fn: l2_rw_array_place_operand (const: @(LmP0Node stmt); const: @(L2ArrayPlace place); const: @(char op); int: width; int: into; @: int out) int
    @: int path 0
    int: capacity place\path.n
    int: status
    int: store (cast: (int) (c.strcmp(op, "LMX_WALK_OP_ELEMPUT") = 0))
    if: capacity = 0 && place\own >= 0
        return: l2_rw_own(into, place\own, out)
    if: capacity < 0 || capacity > (c.INT_MAX - 6) / 6 || lm_compiler_mul_ok((cast: (size_t) (6 + 6 * capacity)), c.sizeof(c.int)) = 0
        l2_alloc_err: 2
        return: l2_alloc_or(l2_src, stmt, "cannot allocate a prepared path operand")
    path: (cast: (@: int) lm_compiler_xmalloc((cast: (size_t) (6 + 6 * capacity)) * c.sizeof(c.int)))
    if: path = 0
        return: l2_alloc_or(l2_src, stmt, "cannot allocate a prepared path operand")
    status: l2_rw_path_records(stmt, @ place\path, 1, 1, capacity, path)
    if: status = 0
        status: l2_rw_path_value_full(path, @ place\path, store, path[2], into, out)
    lm_compiler_xfree((cast: (@: void) path))
return: status

# The address of an Array place's element: ADDRESS over the very ELEM operand a
# read of that place has, with the pointer type as its witness. Nothing is read.
fn: l2_rw_array_place_address (const: @(LmP0Node at); const: @(L2ArrayPlace place); int: parent; @: int out) int
    int: value
    int: ty l2_address_type(place\type)
    if: ty < 0
        return: l2_rw_refuse(at, "the address of this Array element")
    if: l2_rw_frame(parent, "LMX_WALK_OP_ADDRESS", 3, out) != 0 || l2_rw_witness(\out, 2, lm_compiler_own_ty_of_param(ty), 0) != 0
        return: 1
    if: l2_rw_array_place_operand(at, place, "LMX_WALK_OP_ELEM", 3, \out, @ value) != 0
        return: 1
return: l2_rw_put(\out, 1, value)


fn: l2_address_operand (@: LmP0Field first; int: count; int: mi; @: L2Address out) int
    @: LmP0Field f lm_compiler_next_active(first)
    if: f = 0 || f\value = 0
        return: 2
    if: count = 1
        return: l2_address_node(f\value, mi, out)
    if: count < 2 || f\value\kind != c.LM_P0_NODE_ATOM || f\value\as = 0 || lm_compiler_text_eq(f\value\as\atom, "@") = 0
        return: 2
return: l2_address_target(lm_compiler_next_active(f\next), count - 1, mi, out)

# Ordinary address VALUE dispatch. A prepared prefix borrows its existing
# child verdict. Raw P0 entry points construct that verdict once;neither a
# grammar nor a semantic refusal retries a different address classifier.
# 0 success,1 refused address,2 another value role,3 allocation refusal.

fn: l2_address_value_span (@: L2ValueSpan span; int: mi; @: L2Address out) int
    L2ValueSpan: operand
    int: status lm_compiler_address_operand_span(span, @ operand)
    if: status = 1
        return: 1
    if: status = 0
        if: operand.grammar != 0
            status: l2_address_span(@ operand, mi, out)
        else:
            status: l2_address_target((operand.first), (operand.count), mi, out)
        if: status = 2
            return: 1
        return: status
    if: span != 0 && span\count = 1 && span\node != 0
        status: l2_address_node(span\node, mi, out)
        if: status = 2 && lm_compiler_frame_head(span\node, "@") != 0
            return: 1
        return: status
return: 2

fn: l2_check_address_indices (@: L2ValueSpan span; int: mi; const: @(char path); const: @(LmP0Node at)) int
    L2ValueSpan: operand
    @: L2Path selected 0
    int: status lm_compiler_address_operand_span(span, @ operand)
    if: status != 0 || operand.grammar = 0
        return: l2_error_fatal(path, at, "internal: an address CHECK lost its prepared target")
    status: l2_address_target_record(@ operand, mi, @ selected)
    # Address admission has already accepted this SAME target. Its selected
    # machine representation may keep a member's type opaque (status2);that
    # is not a reason to discard its original INDEX owners or resolve again.
    if: status = 3
        return: l2_alloc_or(path, at, "out of memory")
    if: selected = 0 || (status != 0 && status != 2)
        return: l2_error_fatal(path, at, "internal: an address CHECK lost its completed path")
return: l2_check_resolved_indices(at, mi, path, selected)

fn: l2_emit_address (int: mi; const: @(L2Address address); const: @(char ind); @: L2Tx dest) int
return: l2_emit_address_context(mi, address, ind, dest, 0)

fn: l2_emit_address_context (int: mi; const: @(L2Address address); const: @(char ind); @: L2Tx dest; @: int context) int
    []: char type_text_own 256
    L2Tx: type_text_tx
    @: L2Tx type_text lm_compiler_tx_local(@ type_text_tx, type_text_own, 256U)
    []: char declaration_own 256
    L2Tx: declaration_tx
    @: L2Tx declaration lm_compiler_tx_local(@ declaration_tx, declaration_own, 256U)
    []: char physical_own 256
    L2Tx: physical_tx
    @: L2Tx physical lm_compiler_tx_local(@ physical_tx, physical_own, 256U)
    []: char name 48
    int: kind
    int: status
    int: temp
    int: own
    @: LmP0Field cplace
    @: LmP0Text symbol
    if: context != 0
        \context: -1
    if: address\kind = 8
        return: l2_emit_raw_index_location(address, mi, ind, dest, context)
    if: address\kind = 9
        cplace: lm_compiler_next_active(address\target)
        if: cplace = 0 || cplace\value = 0 || cplace\value\as = 0
            return: 1
        symbol: cplace\value\as\atom
        if: symbol = 0 || symbol\length < 3U
            return: 1
        # This is the selected physical C symbol, not a value temporary.
        # Its type stays opaque until the ordinary explicit C ABI boundary.
        return: lm_compiler_tx_wrapn(dest, "(@ ", symbol\data + 2U, symbol\length - 2U, ")")
    if: type_text = 0 || declaration = 0
        return: 1
    if: address\kind = 6
        if: address\descriptor != 0
            if: l2_emit_raw_steps(@ address\path, (address\path.n), mi, ind, physical, context) != 0
                return: 1
            return: lm_compiler_tx_wrapn(dest, "(@ ", physical\data, c.strlen(physical\data), ")")
        # the target as one path: the record the address carries, resolved once by l2_address_target (U7 D4: no second
        # resolution), emitted
        status: l2_emit_path_cursor(@ address\path, mi, ind, lm_compiler_next_active(address\target)\value, @ kind, 0, 0, physical, 0)
        if: status != 0 || lm_compiler_pointer_decl_text(address\type, 0, 0, type_text) != 0
            return: 1
        # A later actual/path reuses l2_pxp. Capture this address now, not
        # when the final call expression is printed after all its actuals.
        temp: l2_tn
        l2_tn: l2_tn + 1
        if: c.snprintf(name, 48U, "l2_t%d", temp) < 0 || lm_compiler_pointer_decl_text(address\type, 0, name, declaration) != 0
            return: 1
        if: c.fprintf(l2_out, "%s%s (cast: (%s) (%s))\n", ind, declaration\data, type_text\data, physical\data) < 0
            return: 1
        return: lm_compiler_tx_set(dest, name)
    if: address\kind = 1
        return: l2_own_addr(address\index, dest)
    if: address\kind = 2
        if: lm_compiler_tx_set(dest, "@ ") != 0
            return: 1
        return: l2_tx_input_cname(dest, "l2_p", mi, address\index, "")
    if: address\kind = 3
        if: lm_compiler_tx_set(dest, "@ ") != 0
            return: 1
        return: l2_tx_slot_cname(dest, "l2_s", mi, address\index, "")
    if: address\kind = 4
        return: lm_compiler_tx_wrapn(dest, "@ ", l2_ml_nm[address\index]\data, l2_ml_nm[address\index]\length, 0)
    if: address\kind = 5
        own: l2_model_root_own(address\index)
        if: own < 0
            return: 1
        return: l2_own_addr(own, dest)
return: 1

fn: l2_check_addr (const: @(LmP0Node node); int: mi; const: @(char path)) int
    L2Address: address_value
    @: L2Address address @ address_value
    int: status 0
    if: l2_address_node(node, mi, address) = 0
        if: address\immutable != 0
            status: l2_error(path, node, "the address of an eternal branch field cannot be taken")
        if: status = 0 && address\resolved != 0
            status: l2_check_resolved_indices(node, mi, path, @ address\path)
        lm_compiler_address_release(address)
        return: status
    if: l2_alloc_err != 0
        return: l2_alloc_or(path, node, "cannot prepare the address operand")
return: l2_error(path, node, "unresolved addressable name")

fn: l2_prep_addr (const: @(LmP0Node node); int: mi; const: @(char ind); @: L2Tx dest) int
return: l2_prep_addr_context(node, mi, ind, dest, 0)

fn: l2_prep_addr_context (const: @(LmP0Node node); int: mi; const: @(char ind); @: L2Tx dest; @: int context) int
    L2Address: address_value
    @: L2Address address @ address_value
    int: status
    if: node = 0 || dest = 0 || ind = 0 || node\as = 0 || node\as\frame = 0 || node\as\frame\body = 0
        return: 1
    if: l2_address_node(node, mi, address) = 0
        status: l2_emit_address_context(mi, address, ind, dest, context)
        lm_compiler_address_release(address)
        return: status
return: l2_error(l2_src, node, "unresolved addressable name")

# A word of a multi-word C type name in a cast: `unsigned long`, `long long`.

# Cast checking and emission project one source type contract. Foreign C types
# remain C ABI types; they do not become an invented numeric literal class.
fn: l2_cast_resolve (const: @(LmP0Node node); @: int out_ty; @: L2Tx dest) int
    @: L2TypeContract contract
    @: LmP0Text word
    @: LmP0Text saved
    @: LmP0Field f
    @: LmP0Field g
    int: depth
    int: qualified
    int: ty
    if: node = 0 || node\as = 0 || out_ty = 0
        return: 1
    contract: lm_compiler_contract_type(node)
    if: contract = 0
        # Existing multi-word raw C type syntax is checked by C, not an L2
        # primitive conversion. It has no inferred L2 value type.
        if: node\kind != c.LM_P0_NODE_STRUCTURE || node\as\structure = 0 || lm_compiler_count_active(node\as\structure) != 2
            return: 1
        f: lm_compiler_next_active(node\as\structure\first_field)
        g: lm_compiler_next_active(f\next)
        if: f\value = 0 || g = 0 || g\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM || g\value\kind != c.LM_P0_NODE_ATOM || lm_compiler_ctype_word(f\value\as\atom) = 0 || lm_compiler_ctype_word(g\value\as\atom) = 0
            return: 1
        \out_ty: -12
        if: dest != 0 && (lm_compiler_tx_wrapn(dest, 0, f\value\as\atom\data, f\value\as\atom\length, " ") != 0 || lm_compiler_tx_catn(dest, g\value\as\atom\data, g\value\as\atom\length) != 0)
            return: 1
        return: 0
    word: lm_compiler_contract_leaf(contract, @ depth, @ qualified)
    if: word = 0
        return: 1
    if: l2_contract_formal(contract, @ ty) != 0
        # A cast is an explicit machine type position. Preserve its existing
        # foreign ABI spelling, including a type supplied by a predef header.
        saved: (cast: (@: LmP0Text) word)
        if: saved = 0 || (lm_compiler_c_stmt_door(saved) = 0 && lm_compiler_ident(saved) = 0)
            return: 1
        ty: lm_compiler_foreign_intern(saved, depth, qualified)
        if: ty < 100
            return: 1
        ---
    \out_ty: ty
    if: dest = 0
        return: 0
    if: lm_compiler_pointer_depth(ty) > 0
        return: lm_compiler_pointer_decl_text(ty, 0, 0, dest)
    if: ty >= 100
        return: lm_compiler_tok_tx(dest, l2_foreign_name[ty - 100])
    if: lm_compiler_prim_code_name(ty) = 0
        return: 1
return: lm_compiler_tx_set(dest, lm_compiler_prim_code_name(ty))

fn: l2_cast_type (const: @(LmP0Node node); @: L2Tx dest) int
    int: ty
return: l2_cast_resolve(node, @ ty, dest)

# True when a names exactly the n bytes at d.

# Raw sizeof clients borrow an existing application or prepare it at this
# boundary. Every downstream reader uses the same storage query.
fn: l2_emit_sizeof (const: @(LmP0Node node); int: mi; const: @(char ind); @: L2Tx dest) int
    L2ValueSpan: temporary
    L2ValueSpan: operand
    @: L2ValueSpan value
    int: status l2_primary_use(node, mi, @ temporary, @ value)
    if: status = 0
        status: l2_primary_sizeof_value(value, mi, @ operand, dest)
    lm_compiler_value_span_release(@ temporary)
return: status

# Raw type-role boundary. Prepared lexical/deferred visitors use the same
# classifier directly on their owner; they never reconstruct a body here.
fn: l2_sizeof_is_type (const: @(LmP0Node node)) int
    L2ValueSpan: temporary
    @: L2ValueSpan value
    int: status
    int: result 0
    if: lm_compiler_frame_head(node, "sizeof") = 0
        return: 0
    status: l2_primary_use(node, l2_here_mi, @ temporary, @ value)
    if: status = 0
        result: l2_primary_sizeof_type(value)
    lm_compiler_value_span_release(@ temporary)
return: result

# The raw CHECK entry shares the prepared receiving contract as well.

fn: l2_check_sizeof (const: @(LmP0Node node); int: mi; const: @(char path)) int
    L2ValueSpan: temporary
    @: L2ValueSpan value
    int: status l2_primary_use(node, mi, @ temporary, @ value)
    if: status = 0
        status: l2_check_primary_value(value, mi, path)
    lm_compiler_value_span_release(@ temporary)
return: status

# Nullary invoke of METHOD idx (unit occurrence or formal occurrence self).
# call_sel 0 = unit method; 2 = callable formal at call_fi. Writes result token to dest.
# Structural METHOD signature equality for callable-formal admission.
fn: l2_cf_set (int: omi; int: fk; int: req) int
    int: i 0
    int: cap
    @: int nomi 0
    @: int nfk 0
    @: int nreq 0
    if: omi < 0 || fk < 0
        return: 1
    while: i < l2_cf_n
        if: l2_cf_omi[i] = omi && l2_cf_fk[i] = fk
            l2_cf_req[i]: req
            return: 0
        i: i + 1
    ---
    if: l2_cf_n >= l2_cf_cap
        cap: l2_cf_cap
        if: cap < 1
            cap: 8
        ---
        while: cap <= l2_cf_n
            if: cap > ((cast: (size_t) -1) / 2U)
                return: 1
            cap: cap * 2
        ---
        nomi: (cast: (@: int) lm_compiler_xmalloc((cast: (size_t) cap) * c.sizeof(c.int)))
        nfk: (cast: (@: int) lm_compiler_xmalloc((cast: (size_t) cap) * c.sizeof(c.int)))
        nreq: (cast: (@: int) lm_compiler_xmalloc((cast: (size_t) cap) * c.sizeof(c.int)))
        if: nomi = 0 || nfk = 0 || nreq = 0
            if: nomi != 0
                lm_compiler_xfree((cast: (@: void) nomi))
            ---
            if: nfk != 0
                lm_compiler_xfree((cast: (@: void) nfk))
            ---
            if: nreq != 0
                lm_compiler_xfree((cast: (@: void) nreq))
            ---
            return: 1
        ---
        if: l2_cf_n > 0
            memcpy((cast: (@: void) nomi), (cast: (@: void) l2_cf_omi), (cast: (size_t) l2_cf_n) * c.sizeof(c.int))
            memcpy((cast: (@: void) nfk), (cast: (@: void) l2_cf_fk), (cast: (size_t) l2_cf_n) * c.sizeof(c.int))
            memcpy((cast: (@: void) nreq), (cast: (@: void) l2_cf_req), (cast: (size_t) l2_cf_n) * c.sizeof(c.int))
        ---
        if: l2_cf_omi != 0
            lm_compiler_xfree((cast: (@: void) l2_cf_omi))
        ---
        if: l2_cf_fk != 0
            lm_compiler_xfree((cast: (@: void) l2_cf_fk))
        ---
        if: l2_cf_req != 0
            lm_compiler_xfree((cast: (@: void) l2_cf_req))
        ---
        l2_cf_omi: nomi
        l2_cf_fk: nfk
        l2_cf_req: nreq
        l2_cf_cap: cap
    ---
    l2_cf_omi[l2_cf_n]: omi
    l2_cf_fk[l2_cf_n]: fk
    l2_cf_req[l2_cf_n]: req
    l2_cf_n: l2_cf_n + 1
return: 0

# The callable occurrence a bare-reference actual denotes, resolved in the CALLER's lexical
# context (book #callables, M1: resolution starts from the actual's binding, not from l2_find_method of an atom). A bare
# method/path is the unit occurrence unless a value producer proves a formed
# occurrence; a held result and an inline merge have separate flow facts.
# `out_run` / `out_held`: a caller that emits the actual (l2_cf_actual_emit) hands the record a path actual is resolved
# into; it is left resolved there (out_held = 1) for that one emission, and that caller releases it -- the one
# resolution of the span (U7 D4: no second resolution).  Without them the record is released here (l2_cf_actual).
fn: l2_cf_actual_rec (int: mi; const: @(LmP0Field a0); int: actual_span; @: int out_kind; @: int out_fi; @: L2Path out_run; @: int out_held) int
    @: LmP0Text t
    @: LmP0Field first (cast: (@: LmP0Field) a0)
    L2Path: run_value
    @: L2Path run @ run_value
    int: rstatus
    int: saved_cur
    int: fi
    int: cand
    \out_kind: 0
    \out_fi: 0 - 1
    if: out_held != 0
        \out_held: 0
    if: out_run != 0 && out_held != 0
        run: out_run
    lm_compiler_reference_fields(@ first, @ actual_span)
    a0: first
    t: lm_compiler_reference_atom(first, actual_span)
    if: a0 = 0 || a0\value = 0 || a0\value\as = 0
        return: 0 - 1
    # Value position splits Holder\other into the atom, the separator, and the field: the span as one path -- the
    # run adapter's record, resolved once where mi stands, the callee it selects read from the record
    # (l2_path_callee_rec: the classification l2_head_method makes of a path head; U7 slice D3, no joined text, no
    # second resolution).  A head written as one atom enters the text classification once, at its source boundary.
    if: t = 0 && actual_span >= 3
        saved_cur: l2_cur_mi
        l2_cur_mi: mi
        rstatus: l2_path_resolve_whole((cast: (@: LmP0Field) a0), actual_span, run)
        l2_cur_mi: saved_cur
        if: rstatus != 0 && rstatus != 0 - 1
            return: 0 - 1
        cand: l2_path_callable_value_rec(run)
        if: cand >= 0 && run = out_run
            \out_held: 1
        else:
            lm_compiler_path_release(run)
        if: cand < 0
            return: -1
        \out_kind: 1
        return: cand
    ---
    if: t = 0
        return: 0 - 1
    # A bare reference supplied as one path text uses the same record as a path span: one resolution where mi stands, its callee
    # read from the record
    # (l2_path_callee_rec: the classification l2_head_method makes of a path head), the record left to the emitting caller
    # (out_held) -- the emitter no longer resolves the head text a second time (U7 D4 review, R2 (a)).
    if: lm_compiler_seg_count(t\data, t\length) >= 2
        saved_cur: l2_cur_mi
        l2_cur_mi: mi
        rstatus: l2_path_resolve(t\data, t\length, run)
        l2_cur_mi: saved_cur
        cand: 0 - 1
        if: rstatus = 0
            cand: l2_path_callable_value_rec(run)
        if: cand >= 0 && run = out_run
            \out_held: 1
        else:
            lm_compiler_path_release(run)
        if: cand < 0
            return: -1
        \out_kind: 1
        return: cand
    ---
    cand: l2_call_head_method(mi, t, @ fi)
    if: cand < 0
        return: -1
    if: fi >= 0
        \out_kind: 2
        \out_fi: fi
        return: cand
    # A bare method name, or a path whose leaf is a callable field. The field's
    # method is that occurrence, a shared terminal, not a second copy.
    if: cand >= 0
        \out_kind: 1
    return: cand

# Callable roles are projections of the same completed value as numeric
# roles. Composite expressions and explicit call Frames do not become a
# second attempted path. Whole own/formal/method roots use their retained
# coordinates;only the common root resolver selected their binding.
fn: l2_cf_value_rec (int: mi; @: L2ValueSpan value; @: int out_kind; @: int out_fi; @@: L2Path out_path) int
    @: L2Path selected
    int: status
    int: candidate -1
    int: own
    \out_kind: 0
    \out_fi: -1
    if: out_path != 0
        \out_path: 0
    if: value = 0
        return: -1
    if: value\values != 0 && value\value_n = 1 && (value\grammar = 3 || (value\node != 0 && value\node\kind = c.LM_P0_NODE_STRUCTURE))
        return: l2_cf_value_rec(mi, value\values, out_kind, out_fi, out_path)
    status: l2_value_span_path(value, mi, @ selected)
    if: status != 0 || selected = 0
        return: -1
    if: selected\n > 0
        candidate: l2_path_callable_value_rec(selected)
    else:
        if: selected\fi >= 0
            candidate: l2_cf_get(mi, selected\fi)
            if: candidate >= 0
                \out_kind: 2
                \out_fi: selected\fi
            ---
        else:
            if: selected\root_kind = 3
                candidate: selected\root
            else:
                own: selected\oi
                if: own >= 0
                    candidate: l2_rb_meth_of(l2_own_decl[own])
                    if: candidate < 0
                        candidate: l2_own_method_requirement(own)
                    ---
                ---
            ---
        ---
    ---
    if: candidate < 0 || candidate = l2_e
        return: -1
    if: \out_kind = 0
        \out_kind: 1
    if: out_path != 0
        \out_path: selected
return: candidate

fn: l2_cf_held_value (int: mi; @: L2ValueSpan value) int
    @: L2Path selected
    int: own
    if: value = 0
        return: -1
    if: value\values != 0 && value\value_n = 1 && (value\grammar = 3 || (value\node != 0 && value\node\kind = c.LM_P0_NODE_STRUCTURE))
        return: l2_cf_held_value(mi, value\values)
    if: l2_value_span_path(value, mi, @ selected) != 0 || selected = 0 || selected\n != 0
        return: -1
    # The common root closer retained the declared requirement separately
    # from the current input and from the optional physical lexical fallback.
    own: selected\root_contract_own
    if: own < 0 || l2_mad_held_model(own) < 0
        return: -1
return: own

fn: l2_occ_value (int: mi; @: L2ValueSpan value) int
    int: kind
    int: formal
    int: candidate l2_cf_value_rec(mi, value, @ kind, @ formal, 0)
    if: candidate < 0 || kind != 1 || l2_m_ret[candidate] != 8
        return: -1
return: candidate

# Callable receiving changes only the required role,not the source grammar
# or selected runtime value. The common value producer consumes the same
# root and per-step contract as CHECK. A hidden input remains the current
# activation's input; its declared held header never substitutes a lexical
# value. Transparent groups borrow their original single prepared child.
fn: l2_cf_value_emit (int: mi; @: L2ValueSpan value; const: @(char ind); @: L2Tx dest) int
    int: kind
    int: formal
    int: candidate
    if: value = 0
        return: 1
    if: value\values != 0 && value\value_n = 1 && (value\grammar = 3 || (value\node != 0 && value\node\kind = c.LM_P0_NODE_STRUCTURE))
        return: l2_cf_value_emit(mi, value\values, ind, dest)
    candidate: l2_cf_value_rec(mi, value, @ kind, @ formal, 0)
    if: l2_alloc_err != 0
        return: 1
    if: candidate < 0 && l2_cf_held_value(mi, value) < 0
        return: 1
    if: l2_alloc_err != 0
        return: 1
return: l2_emit_prepared_value(value, mi, ind, dest, 0)

# COUNT and EMIT project that same prepared value. Inline merge is an
# explicit value construction already recorded by CHECK,not a failed-path
# fallback. No borrowed path is released or reconstructed by this consumer.
fn: l2_rw_callable_value (@: L2ValueSpan value; int: parent; @: int out) int
    int: kind
    int: formal
    int: candidate
    if: value = 0
        return: 1
    if: value\values != 0 && value\value_n = 1 && (value\grammar = 3 || (value\node != 0 && value\node\kind = c.LM_P0_NODE_STRUCTURE))
        return: l2_rw_callable_value(value\values, parent, out)
    if: value\count = 1 && lm_compiler_frame_head(value\node, "merge") != 0 && l2_t7_actual_model(l2_rw_mi, value\node) >= 0
        return: l2_rw_merge_actual(value\node, parent, out)
    candidate: l2_cf_value_rec(l2_rw_mi, value, @ kind, @ formal, 0)
    if: l2_alloc_err != 0
        return: 1
    if: candidate < 0 && l2_cf_held_value(l2_rw_mi, value) < 0
        return: l2_rw_refuse(value\node, "an unresolved callable occurrence")
    if: l2_alloc_err != 0
        return: 1
return: l2_rw_prepared_value(value, parent, out)

# The same classification; a path actual's record is released here (the callers that emit nothing from it).
fn: l2_cf_actual (int: mi; const: @(LmP0Field a0); int: actual_span; @: int out_kind; @: int out_fi) int
return: l2_cf_actual_rec(mi, a0, actual_span, out_kind, out_fi, 0, 0)

# K04 S3: the actual of a callable formal that is a held name -- the node the name holds, of the model its
# store statement's method returns -- is handed as it is, as the occurrence a method's name is.  The held own,
# or -1.
fn: l2_cf_held (int: mi; const: @(LmP0Field a0); int: span) int
    int: oi
    @: LmP0Text name lm_compiler_reference_atom((cast: (@: LmP0Field) a0), span)
    if: name = 0
        return: 0 - 1
    oi: l2_call_head_held(mi, name)
    if: oi < 0 || l2_mad_held_model(oi) < 0
        return: 0 - 1
return: oi

# The same resolution, for the native emitter: the occurrence expression of the actual, in the
# caller's code.  A method's name is the occurrence the unit this method reads holds; a path is the
# occurrence the path selects -- its leaf, a copy's own occurrence where the path runs through a copy,
# reached as a path call's head is (l2_emit_path), held in a temporary of its own (COPIED-CALLABLE-ACTUAL;
# l2_rw_callable_actual walked); a forwarded formal is whatever value that formal holds (l2_tok_formal),
# so nothing is invented for it.
fn: l2_cf_actual_emit (int: mi; const: @(LmP0Field a0); int: actual_span; const: @(char ind); @: L2Tx dest) int
    int: kind 0
    int: fi 0 - 1
    int: cand
    int: pk 0
    int: st
    int: t
    int: held 0
    L2Path: run_value
    @: L2Path run @ run_value
    []: char nm 32
    cand: l2_cf_actual_rec(mi, a0, actual_span, @ kind, @ fi, run, @ held)
    if: cand < 0
        # A held name: the node it holds.  In a method the name is a hidden input (Q52).
        fi: l2_cf_held(mi, a0, actual_span)
        if: fi < 0
            return: 1
        if: l2_param_find(mi, l2_own_name[fi]) >= 0
            return: l2_tok_formal(mi, l2_param_find(mi, l2_own_name[fi]), dest)
        return: l2_own_load(fi, dest)
    ---
    if: kind = 2
        return: l2_tok_formal(mi, fi, dest)
    if: held != 0
        # The span as one path: the record the classification resolved it into (l2_cf_actual_rec), emitted -- the one
        # resolution (U7 D4: no second resolution); the occurrence the path selects, in a temporary of its own.
        st: l2_emit_path_resolved(run, mi, ind, a0\value, @ pk, 0, 0)
        lm_compiler_path_release(run)
        if: st != 0
            return: 1
        t: l2_tn
        l2_tn: l2_tn + 1
        if: c.fprintf(l2_out, "%s@: Lmx l2_ca%d l2_pst\n", ind, t) < 0 || c.snprintf(nm, 32U, "l2_ca%d", t) < 0
            return: 1
        return: lm_compiler_tx_set(dest, nm)
    ---
    # A bare text/span path is held above. Explicit call Frames are never converted back into occurrence references.
return: l2_tok_method_occ(cand, dest)

# A no-result unit-method occurrence supplied where a reference is received.
# Kind 2 is a forwarded formal: its value is not this method's own fields.
# A returning callable stays a call; its result is a different value.
fn: l2_occ_actual (int: mi; const: @(LmP0Field a0); int: span) int
    int: kind 0
    int: fi 0 - 1
    int: cand
    cand: l2_cf_actual(mi, a0, span, @ kind, @ fi)
    if: cand < 0 || kind != 1
        return: 0 - 1
    if: l2_m_ret[cand] != 8
        return: 0 - 1
return: cand

# Register the occurrence against the formal's model with the pair map built
# from the occurrence's own fields. The callee reads through that map.
fn: l2_emit_occ_admit (int: mi; int: req; int: cand; const: @(char value); const: @(char ind)) int
    int: p
    []: char rinst_own 320
    L2Tx: rinst_tx
    @: L2Tx rinst lm_compiler_tx_local(@ rinst_tx, rinst_own, 320U)
    []: char table 160
    # cand is the selected occurrence's existing schema. -1 alone is absent.
    if: req < 0 || cand = -1 || value = 0 || ind = 0
        return: 1
    if: l2_model_inst(mi, req, ind, rinst) != 0
        return: 1
    p: l2_d105_pair(cand, req)
    if: p < 0 || l2_d105_tnode(p, table) != 0
        return: 1
    if: c.fprintf(l2_out, "%sif: lmx_implements_register_map(l2_program_arena, (cast: (@: Lmx) %s), %s, %s, %uU, 0) != c.LMX_IMPLEMENTS_YES\n%s    c.fprintf(c.stderr, \"lmx: invariant: an occurrence was not admitted to its formal\\n\")\n%s    c.abort()\n", ind, value, rinst\data, table, (cast: (unsigned) l2_d105_width(req)), ind, ind) < 0
        return: 1
return: 0

# K09: a table of the flow grows by doubling; nothing about a program is counted against a fixed size.

# `used` entries of `esz` bytes carried into a block of `cap` entries; the old block is freed.  0 and the old
# block kept when there is no memory.

fn: l2_cfl_reserve () int
    int: cap
    size_t: isz
    size_t: psz
    @: void p
    if: l2_cfl_n < l2_cfl_cap
        return: 0
    cap: lm_compiler_cap_next(l2_cfl_cap, l2_cfl_n + 1)
    if: cap < 0
        l2_alloc_err: 2
        return: 1
    isz: c.sizeof(c.int)
    psz: c.sizeof(@: char)
    p: lm_compiler_vec_grow((cast: (@: void) l2_cfl_callee), l2_cfl_n, cap, isz)
    if: p = 0
        return: 1
    l2_cfl_callee: (cast: (@: int) p)
    p: lm_compiler_vec_grow((cast: (@: void) l2_cfl_via), l2_cfl_n, cap, isz)
    if: p = 0
        return: 1
    l2_cfl_via: (cast: (@: int) p)
    p: lm_compiler_vec_grow((cast: (@: void) l2_cfl_via_fi), l2_cfl_n, cap, isz)
    if: p = 0
        return: 1
    l2_cfl_via_fi: (cast: (@: int) p)
    p: lm_compiler_vec_grow((cast: (@: void) l2_cfl_t), l2_cfl_n, cap, isz)
    if: p = 0
        return: 1
    l2_cfl_t: (cast: (@: int) p)
    p: lm_compiler_vec_grow((cast: (@: void) l2_cfl_kind), l2_cfl_n, cap, isz)
    if: p = 0
        return: 1
    l2_cfl_kind: (cast: (@: int) p)
    p: lm_compiler_vec_grow((cast: (@: void) l2_cfl_a), l2_cfl_n, cap, isz)
    if: p = 0
        return: 1
    l2_cfl_a: (cast: (@: int) p)
    p: lm_compiler_vec_grow((cast: (@: void) l2_cfl_a_fi), l2_cfl_n, cap, isz)
    if: p = 0
        return: 1
    l2_cfl_a_fi: (cast: (@: int) p)
    p: lm_compiler_vec_grow((cast: (@: void) l2_cfl_node), l2_cfl_n, cap, psz)
    if: p = 0
        return: 1
    l2_cfl_node: (cast: (@@: LmP0Node) p)
    l2_cfl_cap: cap
return: 0

fn: l2_cfr_reserve () int
    int: cap
    size_t: isz
    size_t: psz
    @: void p
    if: l2_cfr_n < l2_cfr_cap
        return: 0
    cap: lm_compiler_cap_next(l2_cfr_cap, l2_cfr_n + 1)
    if: cap < 0
        l2_alloc_err: 2
        return: 1
    isz: c.sizeof(c.int)
    psz: c.sizeof(@: char)
    p: lm_compiler_vec_grow((cast: (@: void) l2_cfr_c), l2_cfr_n, cap, isz)
    if: p = 0
        return: 1
    l2_cfr_c: (cast: (@: int) p)
    p: lm_compiler_vec_grow((cast: (@: void) l2_cfr_t), l2_cfr_n, cap, isz)
    if: p = 0
        return: 1
    l2_cfr_t: (cast: (@: int) p)
    p: lm_compiler_vec_grow((cast: (@: void) l2_cfr_m), l2_cfr_n, cap, isz)
    if: p = 0
        return: 1
    l2_cfr_m: (cast: (@: int) p)
    p: lm_compiler_vec_grow((cast: (@: void) l2_cfr_origin), l2_cfr_n, cap, isz)
    if: p = 0
        return: 1
    l2_cfr_origin: (cast: (@: int) p)
    l2_cfr_cap: cap
return: 0

