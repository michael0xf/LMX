# Existing typed mutable graph references take the assignment role, but the
# assignment must not be admitted by the legacy positional RuntimeImplements
# walk.  Until the kernel exposes receiving-expression test execution, the
# translator must refuse this update without rebinding field.
fn: replace (@(Lmx field); @(Lmx env2)) int
    field: env2
    return: 0
end: replace

fn: main () int
    return: 0
end: main
